// ============================================================================
// engine/mac/m_d1 —— objc_msgSend：id(id, SEL, double)。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: float): usize from "/usr/lib/libobjc.A.dylib";

export function msgD(o: usize, s: string, a: float): usize {
    return objc_msgSend(o, sel_registerName(s), a);
}
