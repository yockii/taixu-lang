// catch (e) 块离开（return）不等于整条语句离开：成功路径照常往下走，函数漏写 return 须报 3012（原先漏报，运行时取到空值）。
function f(x: int): int | Error {
    if (x < 0) {
        return err("负");
    }
    return x * 2;
}

function g(x: int): int {
    const n: int = f(x) catch (e) {
        return 0;
    };
    print("n=" + toStr(n));
}

export function main(args: []string): int {
    args;
    const v: int = g(5);
    print("v=" + toStr(v + 1));
    return 0;
}
