// 31-hostface（V0.45-S2；BOOT-38）：listDir 目录枚举（字节序排序＝确定性）
// ＋eprint stderr 内建（e2e 面 stdout 主证；stderr 行手工分流亲录在册）。
function main(args: []string): int {
    const entries = listDir("hostface-fixture") catch (e) {
        print("listDir-failed");
        return 1;
    };
    let i: int = 0;
    while (i < listLen(entries)) {
        print(listGet(entries, i) catch "");
        i = i + 1;
    }
    eprint("hostface-eprint-stderr-line");
    const missing = listDir("hostface-fixture-missing") catch (e) {
        print("missing-ok");
        return 0;
    };
    print("unreachable");
    return 0;
}
