import { BrowserNavigation, navigationNew, navigationAddress, navigationOpen, navigationCommit, navigationFail, navigationStep, navigationStop, navigationReload, navigationLocal, navigationLink, navigationFragment } from "../examples/browser/navigation";
import { contentHtml } from "../examples/browser/content";

function commit(state: Ref<BrowserNavigation>, url: string, source: string): void {
    const page = contentHtml(url, source, 200) catch panic("page"); assert(navigationCommit(state, state.generation, page) catch panic("commit"), "current result committed");
}
function badAddress(url: string): bool { navigationAddress(url) catch (e) { return true; }; return false; }
function addressCase(): void {
    assert((navigationAddress(" EXAMPLE.test/a/../中文?q=a b#章节 ") catch panic("IRI")) == "https://example.test/%E4%B8%AD%E6%96%87?q=a%20b#%E7%AB%A0%E8%8A%82", "address normalization and raw Unicode");
    for (url in ["", "file:///tmp/a", "javascript:alert(1)", "https://user:pass@example.test/", "http://example.test/\r\nX:1"]) { assert(badAddress(url), "rejected address " + url); }
    const state = navigationNew() catch panic("new");
    navigationOpen(state, "https://example.test/dir/page") catch panic("open"); commit(state, "https://example.test/dir/page", "<base href='../assets/'><p id='章节'>text</p>");
    navigationLink(state, "下一页#章节") catch panic("link"); const request = state.pending; assert(request != None, "link pending");
    if (request != None) { assert(request.url == "https://example.test/assets/%E4%B8%8B%E4%B8%80%E9%A1%B5#%E7%AB%A0%E8%8A%82", "base and relative Unicode link"); }
}
function historyCase(): void {
    const state = navigationNew() catch panic("new");
    navigationOpen(state, "https://example.test/a") catch panic("a"); commit(state, "https://example.test/a", "A"); state.scroll = 123;
    navigationOpen(state, "https://example.test/b") catch panic("b"); commit(state, "https://example.test/final", "B"); state.scroll = 222;
    assert(listLen(state.history) == 3 && state.cursor == 2 && listGet(state.history, 2).url == "https://example.test/final", "redirect final identity stored");
    assert(navigationStep(state, -1) catch panic("back"), "back begins"); commit(state, "https://example.test/a", "A again");
    assert(state.scroll == 123 && state.cursor == 1 && listGet(state.history, 2).scroll == 222, "history restores page scroll");
    assert(navigationStep(state, 1) catch panic("forward"), "forward begins"); commit(state, "https://example.test/final", "B again"); assert(state.scroll == 222, "forward scroll");
    assert(!(navigationStep(state, 1) catch panic("forward bound")), "last boundary");
    assert(navigationStep(state, -1) catch panic("back"), "back again"); commit(state, "https://example.test/a", "A");
    navigationOpen(state, "https://example.test/c") catch panic("c"); commit(state, "https://example.test/c", "C");
    assert(listLen(state.history) == 3 && listGet(state.history, 2).url == "https://example.test/c", "new commit truncates forward history");
}
function generationCase(): void {
    const state = navigationNew() catch panic("new");
    navigationOpen(state, "https://example.test/old") catch panic("old"); const old = state.generation;
    navigationOpen(state, "https://example.test/latest") catch panic("latest"); const latest = state.generation;
    assert(!(navigationCommit(state, old, contentHtml("https://example.test/old", "OLD", 200) catch panic("old content")) catch panic("stale result")), "old result ignored");
    assert(!(navigationFail(state, old, "old failure") catch panic("stale failure")), "old failure ignored");
    assert(state.loading && state.content.url == "about:home" && state.generation == latest, "latest loading state preserved");
    assert(navigationFail(state, latest, "TLS rejected certificate") catch panic("failure"), "current failure commits");
    assert(state.content.url == "https://example.test/latest" && len(state.content.error) > 0 && state.content.title == "Navigation failed", "new address has its own error document");
    navigationReload(state) catch panic("reload"); assert(!(navigationLocal(state) catch panic("failed page cache")), "reload/error cannot reuse old document");
    navigationStop(state); assert(!state.loading && state.pending == None && !(navigationFail(state, latest, "late") catch panic("stopped")), "stopped result excluded");
}
function fragmentCase(): void {
    const state = navigationNew() catch panic("new");
    navigationOpen(state, "https://example.test/page") catch panic("page"); commit(state, "https://example.test/page", "<p id='章节'>section</p>");
    navigationLink(state, "#章节") catch panic("fragment"); assert(navigationLocal(state) catch panic("local"), "same-document link avoids network");
    assert(state.anchorPending && (navigationFragment(state) ?? "") == "章节" && listLen(state.history) == 3, "fragment decoded and committed to history");
    state.scroll = 200; state.anchorPending = false; assert(navigationStep(state, -1) catch panic("back"), "fragment back");
    assert(navigationLocal(state) catch panic("local back"), "local history reuses document"); assert(state.scroll == 0 && !state.anchorPending, "history scroll wins over anchor");
    navigationOpen(state, "https://example.test/pending") catch panic("pending"); assert(navigationStep(state, -1) catch panic("cancel pending"), "back during new load stops that load");
    assert(!state.loading && state.content.url == "https://example.test/page", "old committed page retained on stop");
}
test "Browser navigation: addresses, base and Unicode links" { addressCase(); }
test "Browser navigation: redirect identity, history and scroll" { historyCase(); }
test "Browser navigation: stale results, failures and stop" { generationCase(); }
test "Browser navigation: fragments, local history and pending back" { fragmentCase(); }
export function main(args: []string): int { addressCase(); historyCase(); generationCase(); fragmentCase(); print("browser navigation: history, generations, fragments and errors OK"); return 0; }
