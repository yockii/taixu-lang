// 线程第 3b 步：线程结果里经函数值带入的 Weak 在发送时核对（线程设计 §十八）。结果类型 Probe 静态可发送；新线程
// 返回的闭包捕获了 Weak，结果发送时 trap 4021（位置记在线程函数的开头）。
struct Node {
    v: int,
}

struct Probe {
    check: () => bool,
}

function main(args: []string): void {
    const t = threadSpawn((): Probe => {
            const n: Ref< Node> = new Node { v: 1 };
            const w: Weak< Node> = weak(n);
            return Probe { check: (): bool => w == w };
        });
    const p = threadJoin(t) catch Probe { check: (): bool => false };
    print(toStr(p.check()));
}
