import { LinkMapData, LinkMapFunction, linkMapIsa } from "./link_map_data";
import { nativeFrameDelta } from "./native_function_data";
import { mapHex, mapJoin } from "./link_map_format";
import { jsonQuote } from "./json_text";

function decimal(v: int): string { return jsonQuote(toStr(v)); }
function index(v: int): string { if (v < 0) { return "null"; } return toStr(v); }
function registerName(isa: string, reg: int): string {
    if (isa == "aarch64") { if (reg == 31) { return "sp"; } if (reg < 0 || reg > 30) { return "?"; } return "x" + toStr(reg); }
    const names = ["rax", "rcx", "rdx", "rbx", "rsp", "rbp", "rsi", "rdi", "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15"];
    if (reg < 0 || reg >= len(names)) { return "?"; } return names[reg];
}
// Register numbers are the ISA's GPR encodings. On entry x86-64 sp addresses the return address; aarch64 sp is the
// call site's sp and the return address is in x30.
function numbering(isa: string): string { if (isa == "aarch64") { return "aarch64-gpr"; } return "x86-64-gpr"; }
function entrySp(isa: string): string { if (isa == "aarch64") { return "call-site-sp"; } return "return-address-slot"; }
export function mapFunctionCoverage(d: Ref<LinkMapData>): string {
    let coverage = "null"; if (d.functionsPresent) { coverage = "\"producer-declared\""; }
    let frameCoverage = coverage; let framed = 0; let boundaries = 0;
    for (row in d.functions) { if (row.source.stackModel == "fixed-call") { framed = framed + 1; } else { boundaries = boundaries + 1; } }
    if (d.functionsPresent && boundaries > 0) { frameCoverage = "\"partial-producer-declared\""; }
    let frameCount = "null"; let boundaryCount = "null";
    if (d.functionsPresent) { frameCount = decimal(framed); boundaryCount = decimal(boundaries); }
    let origins = "";
    for (origin in ["tx-generated", "runtime-rtfn", "ffi-rtfn", "debug-rtfn", "tool-rtfn", "ffi-callback-shell", "process-thread-entry"]) {
        let present = false; for (row in d.functions) { if (row.source.origin == origin) { present = true; break; } }
        if (present) { if (len(origins) > 0) { origins = origins + ","; } origins = origins + jsonQuote(origin); }
    }
    return "\"function_ranges\":" + coverage + ",\"frame_events\":" + frameCoverage
    + ",\"frame_functions\":" + frameCount + ",\"boundary_functions\":" + boundaryCount
    + ",\"included_function_origins\":[" + origins + "]"
    + ",\"object_metadata\":{\"schema\":\"txfn/3\",\"present_objects\":" + toStr(d.metadataObjects) + ",\"absent_objects\":" + toStr(d.unknownObjects) + "}"
    + ",\"excluded_function_origins\":[\"runtime-manual\",\"linker-thunks\",\"external-objects-without-metadata\"]";
}
function functionJson(row: Ref<LinkMapFunction>, isa: string): string {
    const f = row.source; const parts: List<string> = listNew();
    let source = "null"; let recovery = "not-provided";
    if (f.origin == "tx-generated") { source = toStr(f.id); }
    if (f.origin == "tx-generated" || f.origin == "ffi-callback-shell") { recovery = "saved-gpr-events"; }
    let prologue = "null"; if (f.stackModel == "fixed-call") { prologue = decimal(f.prologueEnd - f.begin); }
    listPush(parts, "{\"id\":" + toStr(row.id) + ",\"source_id\":" + source + ",\"module\":" + jsonQuote(f.module) + ",\"name\":" + jsonQuote(f.name)
        + ",\"link_name\":" + jsonQuote(f.linkName) + ",\"origin\":" + jsonQuote(f.origin) + ",\"stack_model\":" + jsonQuote(f.stackModel) + ",\"object_index\":" + index(row.objectIndex)
        + ",\"input_section_index\":" + toStr(row.inputSection) + ",\"input_section_begin\":" + decimal(f.begin) + ",\"input_section_end\":" + decimal(f.end)
        + ",\"output_section\":" + toStr(row.outputSection) + ",\"link_va\":" + jsonQuote(mapHex(row.va))
        + ",\"link_va_end\":" + jsonQuote(mapHex(row.va + (f.end - f.begin))) + ",\"bytes\":" + decimal(f.end - f.begin)
        + ",\"file_offset\":" + decimal(row.fileOffset) + ",\"prologue_end_offset\":" + prologue
        + ",\"epilogues\":[");
    let first = true;
    for (ep in f.epilogues) {
        if (!first) { listPush(parts, ","); } first = false;
        listPush(parts, "{\"start_offset\":" + decimal(ep.begin - f.begin) + ",\"end_offset\":" + decimal(ep.end - f.begin) + "}");
    }
    if (f.stackModel != "fixed-call") { listPush(parts, "],\"frame\":null}"); return mapJoin(parts, 0, listLen(parts)); }
    listPush(parts, "],\"frame\":{\"offset_basis\":\"function-start\",\"effect_at\":\"instruction-end\",\"register_numbering\":" + jsonQuote(numbering(isa))
        + ",\"entry_sp\":" + jsonQuote(entrySp(isa)) + ",\"body_sp\":\"fixed\",\"register_recovery\":" + jsonQuote(recovery) + ",\"events\":[");
    first = true;
    for (e in f.events) {
        if (!first) { listPush(parts, ","); } first = false;
        listPush(parts, "{\"instruction_start_offset\":" + decimal(e.before - f.begin) + ",\"instruction_end_offset\":" + decimal(e.after - f.begin)
            + ",\"kind\":" + jsonQuote(e.kind) + ",\"register\":" + index(e.reg) + ",\"bytes\":" + decimal(e.bytes) + ",\"sp_delta\":" + decimal(nativeFrameDelta(e)) + "}");
    }
    listPush(parts, "]}}"); return mapJoin(parts, 0, listLen(parts));
}
export function mapFunctionsJson(d: Ref<LinkMapData>): string {
    const parts: List<string> = listNew(); let count = "null"; if (d.functionsPresent) { count = decimal(listLen(d.functions)); }
    listPush(parts, ",\"functions_total\":" + count + ",\"functions\":["); let first = true;
    const isa = linkMapIsa(d);
    for (f in d.functions) { if (!first) { listPush(parts, ","); } first = false; listPush(parts, functionJson(f, isa)); }
    listPush(parts, "]"); return mapJoin(parts, 0, listLen(parts));
}
export function mapFunctionsText(d: Ref<LinkMapData>): string {
    if (!d.functionsPresent) { return "函数范围／帧事件未知；本次输入未提供生产者函数目录。\n"; }
    const parts: List<string> = listNew(); const isa = linkMapIsa(d);
    listPush(parts, "生产者声明函数 " + toStr(listLen(d.functions)) + "（已提供目录完整、未截断；地址右端排他）\nID  来源  栈模型  起点..终点  大小 bytes  序言偏移/尾声数  固定栈 bytes  保存寄存器  名字  模块\n");
    for (row in d.functions) {
        const f = row.source; let saves = ""; let allocation = 0;
        for (e in f.events) {
            if (e.kind == "allocate-stack") { allocation = e.bytes; }
            if (e.kind == "push-nonvolatile") { if (len(saves) > 0) { saves = saves + ","; } saves = saves + registerName(isa, e.reg); }
        }
        let frameText = toStr(f.prologueEnd - f.begin) + "/" + toStr(listLen(f.epilogues)) + "  " + toStr(allocation) + "  [" + saves + "]";
        if (f.stackModel != "fixed-call") { frameText = "未知/未知  未知  未知（停止展开）"; }
        listPush(parts, toStr(row.id) + "  " + f.origin + "  " + f.stackModel + "  " + mapHex(row.va) + ".." + mapHex(row.va + (f.end - f.begin)) + "  " + toStr(f.end - f.begin)
            + "  " + frameText + "  " + jsonQuote(f.name) + "  " + jsonQuote(f.module) + "\n");
    }
    listPush(parts, "对象目录 " + toStr(d.metadataObjects) + "，缺失目录 " + toStr(d.unknownObjects) + "；RtFn 只声明固定的栈指针动作，不提供完整寄存器恢复。\n特殊入口只声明范围和栈边界，帧为未知，消费者须停止展开；不从 ret 或符号推断调用帧。其余手写运行时、链接跳板及无目录外部对象尚未覆盖。完整尾声与指令事件见 JSON，机器字段使用 " + numbering(isa) + " 编号。\n");
    return mapJoin(parts, 0, listLen(parts));
}
