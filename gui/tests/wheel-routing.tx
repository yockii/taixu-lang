import { setenv } from "std/os";
import { appNew, appClose, defaultSpec, hitZone, onEvent, pump, focusPushId, focusTopId } from "gui/app";
import { eventWindowPushMods } from "gui/surface";
import { EventRecord } from "std/events";
struct Seen { count: int, target: int, delta: int, mods: int }
export function main(args: []string): int {
    setenv("TAIXU_REPLAY", "tests/wheel-routing-script.txt") catch panic("replay");
    const app = appNew(defaultSpec("wheel routing", 300, 200)); assert(app.scripted, "explicit headless app");
    hitZone(app, 17, 10, 10, 100, 100); hitZone(app, 18, 120, 10, 100, 100);
    focusPushId(app, 99); app.drag_target = 98;
    const seen = new Seen { count: 0, target: 0, delta: 0, mods: 0 };
    for (id in [17, 18]) {
        onEvent(app, id, (r: EventRecord): void => { assert(r.kind == 9 && r.y == 0, "semantic wheel event"); seen.count = seen.count + 1; seen.target = r.target; seen.delta = r.x; seen.mods = r.mods; });
    }
    app.scripted = false; // Exercise the raw-platform conversion on a scripted window.
    assert(eventWindowPushMods(app.hwnd, 9, -13, 140, 20, 1) == 0, "inject raw record"); pump(app, 0);
    assert(seen.count == 1 && seen.target == 18 && seen.delta == -13 && seen.mods == 1, "under pointer rather than keyboard focus or drag target");
    assert(focusTopId(app) == 99 && app.drag_target == 98, "focus and drag unchanged");
    eventWindowPushMods(app.hwnd, 9, 40, 290, 180, 0); pump(app, 0); assert(seen.count == 1, "outside zones");
    app.modal.active = true; eventWindowPushMods(app.hwnd, 9, 40, 20, 20, 0); pump(app, 0); assert(seen.count == 1, "modal does not scroll background"); app.modal.active = false;
    app.popup.active = true; eventWindowPushMods(app.hwnd, 9, 40, 20, 20, 0); pump(app, 0); assert(seen.count == 1, "popup does not scroll background"); app.popup.active = false;
    app.scripted = true; eventWindowPushMods(app.hwnd, 9, 17, 7, 0, 4); pump(app, 0);
    assert(seen.count == 2 && seen.target == 17 && seen.delta == 7 && seen.mods == 4, "replay component semantics");
    appClose(app); print("wheel routing: pointer, focus, drag, modal and replay OK"); return 0;
}
