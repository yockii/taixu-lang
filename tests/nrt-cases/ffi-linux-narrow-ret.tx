// 定宽第二步 §七-2（Linux）：C 函数返回 64 位、声明成窄类型时，调用桩只取低位并按种类符号或零扩展
// ——寄存器高位是被调函数留下的值，不可信。每个窄类型借一个返回 64 位的 libc 函数，输入
// 1311768467463790208（0x123456789ABCDE80）；bool 只看低 8 位（256 得 false）。
declare function atoll(s: string): u8 from "libc.so.6";
declare function atol(s: string): i8 from "libc.so.6";
declare function strtoll(s: string, end: usize, base: i32): u16 from "libc.so.6";
declare function strtoull(s: string, end: usize, base: i32): i16 from "libc.so.6";
declare function strtol(s: string, end: usize, base: i32): u32 from "libc.so.6";
declare function llabs(x: int): i32 from "libc.so.6";
declare function strtoul(s: string, end: usize, base: i32): bool from "libc.so.6";

function main(args: []string): int {
    const s = "1311768467463790208";
    print("u8 " + toStr(atoll(s)) + " i8 " + toStr(atol(s)));
    print("u16 " + toStr(strtoll(s, 0, 10)) + " i16 " + toStr(strtoull(s, 0, 10)));
    print("u32 " + toStr(strtol(s, 0, 10)) + " i32 " + toStr(llabs(1311768467463790208)));
    print("bool " + toStr(strtoul("256", 0, 10)) + " " + toStr(strtoul("257", 0, 10)) + " " + toStr(strtoul("0", 0, 10)));
    const lo: u8 = atoll(s);
    print("arith " + toStr(lo as int + 1) + " " + toStr((atol(s) as int) - 1));
    return 0;
}
