// 09 工具链示例：test 块（taixu test 枚举运行）＋ 文档注释（taixu doc 消费）。

/// 两数相加（示例文档注释：/// 被 taixu doc 收集）。
function add(a: int, b: int): int {
    return a + b;
}

test "add 基本行为" {
    assert(add(2, 3) == 5, "2+3 应为 5");
    assert(add(-1, 1) == 0, "负数参与");
}

function main(args: []string): int {
    print("toolchain:" + toStr(add(20, 22)));
    return 0;
}
