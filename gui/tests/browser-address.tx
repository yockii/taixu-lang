import { addressSet, addressInsert, addressSelectAll, addressSelection, addressMove, addressDelete, addressCaretAt } from "../examples/browser/address";
import { input, inputValue } from "gui/components";

function unicodeCase(): void {
    const field = input(1, 0, 0, 100, ""); assert(addressSet(field, "A中文🙂Z") && listLen(field.chars) == 5, "initialize by codepoint");
    addressMove(field, 37, false); addressMove(field, 37, true); assert(addressSelection(field) == "🙂", "Unicode selection");
    assert(addressInsert(field, "链接"), "paste replacement"); assert(inputValue(field) == "A中文链接Z" && field.cursor == 5 && listLen(field.chars) == 6, "paste keeps individual characters");
    addressDelete(field, true, false); assert(inputValue(field) == "A中文链Z", "backspace removes one codepoint");
    addressDelete(field, false, false); assert(inputValue(field) == "A中文链", "delete removes next codepoint");
    addressSelectAll(field); assert(addressSelection(field) == "A中文链", "select all"); assert(addressInsert(field, "https://example.test/"), "replace all");
}
function limitsCase(): void {
    const field = input(1, 0, 0, 100, ""); let full = ""; let i = 0; while (i < 4096) { full = full + "a"; i = i + 1; }
    assert(addressSet(field, full), "maximum address accepted"); assert(!addressInsert(field, "🙂") && inputValue(field) == full, "oversize edit is atomic");
    addressSelectAll(field); assert(!addressInsert(field, "bad\r\nURL") && inputValue(field) == full, "control characters rejected before deleting selection");
    assert(addressInsert(field, "中"), "selected bytes excluded from limit"); assert(inputValue(field) == "中", "replacement succeeds");
    assert(addressSet(field, "https://example.test/path"), "URL"); addressDelete(field, true, true); assert(inputValue(field) == "https://example.test/", "word deletion");
}
function caretCase(): void {
    const field = input(1, 0, 0, 100, ""); addressSet(field, "A中🙂B");
    const measure = (text: string): int => { let width = 0; let i = 0; while (i < len(text)) { const b = byteAt(text, i); if (b < 128) { width = width + 5; i = i + 1; } else { width = width + 10; if (b < 224) { i = i + 2; } else if (b < 240) { i = i + 3; } else { i = i + 4; } } } return width; };
    assert(addressCaretAt(field, -1, measure) == 0 && addressCaretAt(field, 5, measure) == 1 && addressCaretAt(field, 24, measure) == 2 && addressCaretAt(field, 25, measure) == 3 && addressCaretAt(field, 100, measure) == 4, "prefix hit positions");
}
test "Browser address: Unicode editing, paste and selection" { unicodeCase(); }
test "Browser address: atomic limits and word deletion" { limitsCase(); }
test "Browser address: measured caret hit testing" { caretCase(); }
export function main(args: []string): int { unicodeCase(); limitsCase(); caretCase(); print("browser address: Unicode edits, limits and caret OK"); return 0; }
