// ============================================================================
// engine/mac/rt —— Objective-C 运行时（libobjc）与 id(id, SEL) 的消息发送。objc_msgSend 每种签名一个声明模块（同一模块里
// 一个 C 函数只能声明一次；它不是变参函数，不能声明成变参），本模块是无参、返回对象或整数的那种。
// ============================================================================

declare function objc_getClass(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_allocateClassPair(superclass: usize, name: string, extra: usize): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_registerClassPair(cls: usize): void from "/usr/lib/libobjc.A.dylib";
declare function objc_autoreleasePoolPush(): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_autoreleasePoolPop(pool: usize): void from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize): usize from "/usr/lib/libobjc.A.dylib";
declare function NSApplicationLoad(): u8 from "/System/Library/Frameworks/AppKit.framework/AppKit";

/// 装入 AppKit（之后 objc_getClass 才找得到 NSApplication 等类）；成功得 true。
export function appKitLoad(): bool {
    return NSApplicationLoad() != 0;
}

export function cls(name: string): usize {
    return objc_getClass(name);
}

export function sel(name: string): usize {
    return sel_registerName(name);
}

/// 新类（父类 superclass）；名字已被占用得 0。
export function classNew(superclass: usize, name: string): usize {
    return objc_allocateClassPair(superclass, name, 0);
}

export function classRegister(c: usize): void {
    objc_registerClassPair(c);
}

export function poolPush(): usize {
    return objc_autoreleasePoolPush();
}

export function poolPop(p: usize): void {
    objc_autoreleasePoolPop(p);
}

/// [o s]，返回对象或整数（NSInteger、NSUInteger、BOOL 都在整数寄存器）。
export function msg(o: usize, s: string): usize {
    return objc_msgSend(o, sel_registerName(s));
}
