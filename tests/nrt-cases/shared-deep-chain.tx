// 运行时加固 H4：嵌套 Shared 的归还不递归（nrt_send.tx 的 __tx_xblk_free 以待放链循环归还）。此前 6 万层的链在最后一份
// 放手时原生栈溢出（Windows 0xC00000FD、Linux SIGSEGV）。两条路径：主线程结束时放手；线程结束时经线程记录归还——
// 句柄在 launch 返回时已放掉，线程等放行后返回链头，记录与链由线程自己在结束时放手（那时它的堆已归还，归还路径不得用堆）。
struct Node {
    v: int,
    next: Shared < Ref< Node>>?,
}

function build(n: int, base: int): Shared < Ref< Node>> {
    let cur: Shared < Ref< Node>> = sharedNew(new Node { v: base, next: None });
    let i = 1;
    while (i < n) {
        cur = sharedNew(new Node { v: base + i, next: cur });
        i = i + 1;
    }
    return cur;
}

// 沿链走 k 步（到链尾即停），返回到达处的值（链按值递减）。
function walk(s: Shared < Ref< Node>>, k: int): int {
    let cur = s;
    let i = 0;
    while (i < k) {
        cur = sharedGet(cur).next catch cur;
        i = i + 1;
    }
    return sharedGet(cur).v;
}

function launch(flag: Shared < Atomic < int >>, n: int): void {
    const t = threadSpawn((): Shared < Ref< Node>> => {
            const a = sharedGet(flag);
            while (atomicLoad(a) == 0) {
            }
            return build(n, 1000000);
        });
}

function main(args: []string): int {
    const flag = sharedNew(atomicNew(0));
    launch(flag, 100000);
    const s = build(200000, 0);
    print("head " + toStr(sharedGet(s).v) + " step3 " + toStr(walk(s, 3)));
    atomicStore(sharedGet(flag), 1);
    print("done");
    return 0;
}
