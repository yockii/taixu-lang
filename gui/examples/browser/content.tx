// Page data returned by a worker. No font, surface or window objects.
import { BrowserPage } from "./fetch";
import { HtmlDocument, htmlParse } from "./html";
import { CssStyle, cssCompute } from "./css";
import { httpHeaderText } from "std/http_wire";
import { trim, toLower, replace } from "std/string";

export struct BrowserContent { url: string, status: int, title: string, document: Ref<HtmlDocument>, styles: List<CssStyle>, error: string }
export function contentEscape(text: string): string { return replace(replace(replace(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"); }
export function contentShort(text: string, maximum: int): string {
    if (maximum < 0) { return ""; }
    if (len(text) <= maximum) { return text; } let end = maximum;
    while (end > 0 && (byteAt(text, end) & 192) == 128) { end = end - 1; } return strSlice(text, 0, end);
}
function append(out: Bytes, codepoint: int): void | Error {
    let need = 1; if (codepoint >= 128) { need = 2; } if (codepoint >= 2048) { need = 3; }
    if (bytesLen(out) > 16777216 - need) { return err("browser content: decoded text limit"); }
    const list = bytesAsList(out);
    if (codepoint < 128) { listPush(list, codepoint as u8); }
    else if (codepoint < 2048) { listPush(list, (192 | (codepoint >> 6)) as u8); listPush(list, (128 | (codepoint & 63)) as u8); }
    else { listPush(list, (224 | (codepoint >> 12)) as u8); listPush(list, (128 | ((codepoint >> 6) & 63)) as u8); listPush(list, (128 | (codepoint & 63)) as u8); }
    return done();
}
// UTF-8 repair consumes each maximal valid prefix of a malformed sequence.
export function contentDecode(data: Bytes, charset: string): string | Error {
    if (bytesLen(data) > 16777216) { return err("browser content: input text limit"); }
    let encoding = toLower(trim(charset)); let at = 0;
    if (bytesLen(data) >= 3 && (bytesGet(data, 0) catch 0) == 239 && (bytesGet(data, 1) catch 0) == 187 && (bytesGet(data, 2) catch 0) == 191) { encoding = "utf-8"; at = 3; }
    const western = encoding == "windows-1252" || encoding == "iso-8859-1" || encoding == "latin1" || encoding == "us-ascii" || encoding == "ascii";
    if (!western && encoding != "" && encoding != "utf-8" && encoding != "utf8") { return err("browser content: unsupported charset " + contentShort(encoding, 80)); }
    const out = bytesNew(0);
    const c1: List<int> = [8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376];
    while (at < bytesLen(data)) {
        const b = bytesGet(data, at) catch 0;
        if (western) {
            let cp = b; if (b >= 128 && b < 160) { cp = listGet(c1, b - 128); } if (cp == 0) { cp = 65533; } append(out, cp)?; at = at + 1; continue;
        }
        if (b < 128) { let cp = b; if (cp == 0) { cp = 65533; } append(out, cp)?; at = at + 1; continue; }
        let count = 0; let lower = 128; let upper = 191;
        if (b >= 194 && b <= 223) { count = 2; }
        else if (b >= 224 && b <= 239) { count = 3; if (b == 224) { lower = 160; } if (b == 237) { upper = 159; } }
        else if (b >= 240 && b <= 244) { count = 4; if (b == 240) { lower = 144; } if (b == 244) { upper = 143; } }
        if (count == 0) { append(out, 65533)?; at = at + 1; continue; }
        let consumed = 1;
        while (consumed < count && at + consumed < bytesLen(data)) {
            const next = bytesGet(data, at + consumed) catch 0;
            if (next < lower || next > upper) { break; } consumed = consumed + 1; lower = 128; upper = 191;
        }
        if (consumed != count) { append(out, 65533)?; at = at + consumed; }
        else {
            if (bytesLen(out) > 16777216 - count) { return err("browser content: decoded text limit"); }
            let i = 0; while (i < count) { listPush(bytesAsList(out), (bytesGet(data, at + i) catch 0) as u8); i = i + 1; } at = at + count;
        }
    } return bytesToStr(out);
}
export function contentHtml(url: string, source: string, status: int): BrowserContent | Error {
    const document = htmlParse(source)?; const styles = cssCompute(document)?; let title = contentShort(document.title, 256);
    if (len(title) == 0) { title = contentShort(url, 256); }
    return BrowserContent { url: url, status: status, title: title, document: document, styles: styles, error: "" };
}
export function contentPage(page: BrowserPage): BrowserContent | Error {
    const header = httpHeaderText(page.response.head, "content-type")?; let media = "text/html"; let charset = "";
    if (header.present) {
        const parts = strSplit(header.value, ";"); media = toLower(trim(listGet(parts, 0))); let i = 1;
        while (i < listLen(parts)) {
            const part = trim(listGet(parts, i)); const equals = strFind(part, "=");
            if (equals >= 0 && toLower(trim(strSlice(part, 0, equals))) == "charset") {
                charset = trim(strSlice(part, equals + 1, len(part)));
                if (len(charset) >= 2 && ((byteAt(charset, 0) == 34 && byteAt(charset, len(charset) - 1) == 34) || (byteAt(charset, 0) == 39 && byteAt(charset, len(charset) - 1) == 39))) { charset = strSlice(charset, 1, len(charset) - 1); }
            } i = i + 1;
        }
    }
    if (media != "text/html" && media != "text/plain" && media != "application/xhtml+xml") { return err("browser content: unsupported media type " + contentShort(media, 80)); }
    let source = contentDecode(page.response.body, charset)?;
    if (media == "text/plain") { source = "<body><pre>" + escapedLimited(source, 16777192)? + "</pre></body>"; }
    return contentHtml(page.url, source, page.response.head.status);
}
function escapedLimited(text: string, maximum: int): string | Error {
    const out = bytesNew(0); const amp = bytesFromStr("&amp;"); const lt = bytesFromStr("&lt;"); const gt = bytesFromStr("&gt;"); let i = 0;
    while (i < len(text)) {
        const b = byteAt(text, i); let extra = 1; if (b == 38) { extra = 5; } else if (b == 60 || b == 62) { extra = 4; }
        if (bytesLen(out) > maximum - extra) { return err("browser content: escaped text limit"); }
        if (b == 38) { bytesAppend(out, amp); } else if (b == 60) { bytesAppend(out, lt); } else if (b == 62) { bytesAppend(out, gt); } else { listPush(bytesAsList(out), b as u8); } i = i + 1;
    } return bytesToStr(out);
}
export function contentHome(): BrowserContent | Error {
    return contentHtml("about:home", "<title>Taixu Browser</title><style>body{margin:0;padding:24px;color:#172033}h1{color:#263db4}a{color:#2563eb}</style><body><h1>Taixu Browser</h1><p>Enter an HTTP or HTTPS address to browse.</p><p><a href='https://example.com/'>Example Domain</a></p><p><a href='https://taixu.icu/'>太虚编程语言</a></p></body>", 0);
}
export function contentError(url: string, message: string): BrowserContent | Error {
    let content = contentHtml(url, "<title>Navigation failed</title><style>body{padding:20px}</style><body><h1>Navigation failed</h1><p>" + contentEscape(contentShort(message, 2048)) + "</p><p>" + contentEscape(contentShort(url, 4096)) + "</p></body>", 0)?;
    content.error = contentShort(message, 2048); return content;
}
function done(): void {}
