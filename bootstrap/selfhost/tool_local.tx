// 受信本地根的句柄式只读访问；根的挂载类型由服务启动策略核验。
// 不跟随链接／重解析点，不回退普通路径读取。系统不支持时返回 Error。
import { StructuredBuffer } from "./assemble";
import { RtFn, L, I } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtSyscall, rtRet, rtRetVoid } from "./rtfn";
import { callWinImport } from "./ffi_callbacks";
import { TAG_INT, TAG_ERR, TAG_STR, TAG_BYTES, toolCheck, toolArity, toolArgSpan, toolArgInt, toolTrap, xs0, xs1, xs2, xs3, xs4, xs5, xs7 } from "./tool_base";
import { emitLocalWindowsOpen } from "./tool_local_win_open";
import { tRawSyscall, tWindows, tUnix, tMacos } from "./target";
import { uxSys, uxMac, uxConst, uxStatMode } from "./unix_sys";

export function emitLocalFiles(b: Ref<StructuredBuffer>, t: int): void {
    emitLex(b, t);
    emitClose(b, t);
    if (tRawSyscall(t)) { emitLinuxOpen(b); } else if (tMacos(t)) { emitMacOpen(b, t); } else { emitLocalWindowsOpen(b); }
    emitAccess(b, t, 0); emitAccess(b, t, 1); emitAccess(b, t, 2);
    emitList(b, t);
}

function slots(prefix: string, count: int): string {
    let out = ""; let i = 0;
    while (i < count) { out = out + " " + prefix + toStr(i); i = i + 1; }
    return out;
}

// 一般组件检查：不允许 NUL、空组件、.、..；Windows 另拒绝 ADS、尾点／尾空格和设备命名空间。
function emitLex(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_local_lex", "p n root", "i c start size x", 0, "bootstrap/selfhost/tool_local.tx");
    rtSet(f, "i", I(0));
    rtIf(f, L("n"), "gt", I(32760), "bad");
    rtIf(f, L("root"), "eq", I(0), "relative");
    if (tUnix(t)) {
        rtIf(f, L("n"), "lt", I(1), "bad");
        rtLoad(f, "c", L("p"), 0, 1); rtIf(f, L("c"), "ne", I(47), "bad");
        rtSet(f, "i", I(1));
    } else {
        rtIf(f, L("n"), "lt", I(3), "bad");
        rtLoad(f, "c", L("p"), 0, 1);
        rtOp(f, "c", L("c"), "or", I(32));
        rtIf(f, L("c"), "lt", I(97), "bad"); rtIf(f, L("c"), "gt", I(122), "bad");
        rtLoad(f, "c", L("p"), 1, 1); rtIf(f, L("c"), "ne", I(58), "bad");
        rtLoad(f, "c", L("p"), 2, 1); rtIf(f, L("c"), "eq", I(47), "drive");
        rtIf(f, L("c"), "ne", I(92), "bad"); rtLabel(f, "drive"); rtSet(f, "i", I(3));
    }
    rtLabel(f, "relative"); rtSet(f, "start", L("i"));
    rtLabel(f, "loop"); rtIf(f, L("i"), "ge", L("n"), "end");
    rtOp(f, "x", L("p"), "add", L("i")); rtLoad(f, "c", L("x"), 0, 1);
    rtIf(f, L("c"), "eq", I(0), "bad"); rtIf(f, L("c"), "eq", I(47), "component");
    if (tWindows(t)) { rtIf(f, L("c"), "eq", I(92), "component"); rtIf(f, L("c"), "eq", I(58), "bad"); }
    rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "loop");
    rtLabel(f, "component"); rtIf(f, L("i"), "eq", L("start"), "bad"); rtJump(f, "check");
    rtLabel(f, "end"); rtIf(f, L("i"), "eq", L("start"), "ok");
    rtLabel(f, "check");
    rtOp(f, "size", L("i"), "sub", L("start")); rtOp(f, "x", L("p"), "add", L("start"));
    rtLoad(f, "c", L("x"), 0, 1); rtIf(f, L("c"), "ne", I(46), "ordinary");
    rtIf(f, L("size"), "eq", I(1), "bad"); rtIf(f, L("size"), "ne", I(2), "ordinary");
    rtLoad(f, "c", L("x"), 1, 1); rtIf(f, L("c"), "eq", I(46), "bad");
    rtLabel(f, "ordinary");
    if (tWindows(t)) {
        rtOp(f, "x", L("p"), "add", L("i")); rtLoad(f, "c", L("x"), -1, 1);
        rtIf(f, L("c"), "eq", I(46), "bad"); rtIf(f, L("c"), "eq", I(32), "bad");
    }
    rtIf(f, L("i"), "ge", L("n"), "ok"); rtOp(f, "i", L("i"), "add", I(1)); rtSet(f, "start", L("i")); rtJump(f, "loop");
    rtLabel(f, "ok"); rtRet(f, I(1)); rtLabel(f, "bad"); rtRet(f, I(0)); toolCheck(f);
}

// chain=[count, handle...]。保持所有 Windows 祖先句柄直至内容／元数据操作结束。
function emitClose(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_local_close", "chain", "n p h gp ef", 1, "bootstrap/selfhost/tool_local.tx");
    rtIf(f, L("chain"), "eq", I(0), "done"); rtLoad(f, "n", L("chain"), 0, 8);
    rtOp(f, "p", L("chain"), "add", I(8)); rtLabel(f, "loop"); rtIf(f, L("n"), "eq", I(0), "free");
    rtLoad(f, "h", L("p"), 0, 8);
    if (tUnix(t)) { uxSys(f, t, "", 3, xs1(L("h"))); } else { callWinImport(f, "", "CloseHandle", xs1(L("h"))); }
    rtOp(f, "p", L("p"), "add", I(8)); rtOp(f, "n", L("n"), "sub", I(1)); rtJump(f, "loop");
    rtLabel(f, "free"); rtCall1(f, "", "__tx_native_mem_free", L("chain")); rtLabel(f, "done"); rtRetVoid(f); toolCheck(f);
}

function emitLinuxOpen(b: Ref<StructuredBuffer>): void {
    const f = rtBegin(b, "__tx_local_open", "rp rn pp pn", "root rel chain h r flags how0 how1 how2 how", 4, "bootstrap/selfhost/tool_local.tx");
    rtCall2(f, "root", "__tx_tool_cstr", L("rp"), L("rn")); rtCall2(f, "rel", "__tx_tool_cstr", L("pp"), L("pn"));
    rtCall2(f, "chain", "__tx_native_mem_alloc", I(24), I(8)); rtIf(f, L("chain"), "eq", I(0), "oom"); rtStore(f, L("chain"), 0, I(0), 8);
    rtAddrOf(f, "how", "how0"); rtSet(f, "how0", I(2686976)); rtSet(f, "how1", I(0)); rtSet(f, "how2", I(6));
    // O_PATH | O_DIRECTORY | O_CLOEXEC；根允许跨显式受信的本地挂载，但拒绝所有符号链接。
    rtSyscall(f, "h", 437, xs4(I(-100), L("root"), L("how"), I(24)));
    rtIf(f, L("h"), "lt", I(0), "fail"); rtStore(f, L("chain"), 0, I(1), 8); rtStore(f, L("chain"), 8, L("h"), 8);
    rtIf(f, L("pn"), "eq", I(0), "done");
    rtSet(f, "how0", I(526336)); rtSet(f, "how2", I(15));
    // O_RDONLY | O_NONBLOCK | O_CLOEXEC；BENEATH | NO_SYMLINKS | NO_MAGICLINKS | NO_XDEV。
    rtSyscall(f, "h", 437, xs4(L("h"), L("rel"), L("how"), I(24)));
    rtIf(f, L("h"), "lt", I(0), "fail"); rtStore(f, L("chain"), 0, I(2), 8); rtStore(f, L("chain"), 16, L("h"), 8); rtJump(f, "done");
    rtLabel(f, "fail"); rtCall1(f, "", "__tx_local_close", L("chain")); rtSet(f, "chain", I(0));
    rtLabel(f, "done"); rtCall1(f, "", "__tx_native_mem_free", L("root")); rtCall1(f, "", "__tx_native_mem_free", L("rel")); rtRet(f, L("chain"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRet(f, I(0)); toolCheck(f);
}

// macOS（M3 设计 G6）：根 open(O_RDONLY|O_DIRECTORY|O_CLOEXEC|O_NOFOLLOW_ANY)，相对路径 openat(根, rel,
// O_RDONLY|O_NONBLOCK|O_CLOEXEC|O_NOFOLLOW_ANY)。对照 Linux 的 openat2：任一组件是链接即 ELOOP（NO_SYMLINKS）；词法检查已拒绝
// .. 与绝对路径，又不跟随链接，出不了根（BENEATH）；终点与根的 st_dev 不同即拒绝（NO_XDEV）；O_PATH 以 O_RDONLY 代替。
function emitMacOpen(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_local_open", "rp rn pp pn", "root rel chain h r d sp" + slots("st", 18), 4, "bootstrap/selfhost/tool_local.tx");
    const noFollowAny = 0x20000000;
    rtCall2(f, "root", "__tx_tool_cstr", L("rp"), L("rn")); rtCall2(f, "rel", "__tx_tool_cstr", L("pp"), L("pn"));
    rtCall2(f, "chain", "__tx_native_mem_alloc", I(24), I(8)); rtIf(f, L("chain"), "eq", I(0), "oom"); rtStore(f, L("chain"), 0, I(0), 8);
    uxSys(f, t, "h", 2, xs3(L("root"), I(uxConst(t, "O_DIRECTORY") | uxConst(t, "O_CLOEXEC") | noFollowAny), I(0)));
    rtIf(f, L("h"), "lt", I(0), "fail"); rtStore(f, L("chain"), 0, I(1), 8); rtStore(f, L("chain"), 8, L("h"), 8);
    rtIf(f, L("pn"), "eq", I(0), "done");
    rtAddrOf(f, "sp", "st0");
    uxSys(f, t, "r", 5, xs2(L("h"), L("sp"))); rtIf(f, L("r"), "ne", I(0), "fail"); rtLoad(f, "d", L("sp"), 0, 4);
    uxSys(f, t, "h", 257, xs4(L("h"), L("rel"), I(uxConst(t, "O_NONBLOCK") | uxConst(t, "O_CLOEXEC") | noFollowAny), I(0)));
    rtIf(f, L("h"), "lt", I(0), "fail"); rtStore(f, L("chain"), 0, I(2), 8); rtStore(f, L("chain"), 16, L("h"), 8);
    uxSys(f, t, "r", 5, xs2(L("h"), L("sp"))); rtIf(f, L("r"), "ne", I(0), "fail"); rtLoad(f, "r", L("sp"), 0, 4);
    rtIf(f, L("r"), "eq", L("d"), "done");
    rtLabel(f, "fail"); rtCall1(f, "", "__tx_local_close", L("chain")); rtSet(f, "chain", I(0));
    rtLabel(f, "done"); rtCall1(f, "", "__tx_native_mem_free", L("root")); rtCall1(f, "", "__tx_native_mem_free", L("rel")); rtRet(f, L("chain"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRet(f, I(0)); toolCheck(f);
}

function emitAccess(b: Ref<StructuredBuffer>, t: int, mode: int): void {
    let name = "read_local_file_bytes";
    if (mode == 1) { name = "local_entry_kind"; } else if (mode == 2) { name = "local_file_size"; }
    const f = rtBegin(b, "__tx_tool_" + name, "win fn pc a bi nargs", "s t o rp rn pp pn path max chain h p n x c r buf used size cap result tag gp ef got gotp" + slots("st", 18), 5, "bootstrap/selfhost/tool_local.tx");
    if (mode == 0) { toolArity(f, 3); } else { toolArity(f, 2); }
    toolArgSpan(f, 0, TAG_STR, "o", "rp", "rn", "type"); toolArgSpan(f, 1, TAG_STR, "o", "pp", "pn", "type"); rtSet(f, "path", L("t"));
    if (mode == 0) { toolArgInt(f, 2, "max", "type"); rtIf(f, L("max"), "lt", I(0), "invalid"); rtIf(f, L("max"), "gt", I(9223372036854775806), "invalid"); }
    rtCall3(f, "r", "__tx_local_lex", L("rp"), L("rn"), I(1)); rtIf(f, L("r"), "eq", I(0), "denied");
    rtCall3(f, "r", "__tx_local_lex", L("pp"), L("pn"), I(0)); rtIf(f, L("r"), "eq", I(0), "denied");
    rtCall4(f, "chain", "__tx_local_open", L("rp"), L("rn"), L("pp"), L("pn")); rtIf(f, L("chain"), "eq", I(0), "denied");
    rtSet(f, "buf", I(0)); rtSet(f, "tag", I(TAG_INT)); rtSet(f, "result", I(-1));
    rtLoad(f, "n", L("chain"), 0, 8); rtOp(f, "n", L("n"), "imul", I(8)); rtOp(f, "p", L("chain"), "add", L("n")); rtLoad(f, "h", L("p"), 0, 8);
    rtAddrOf(f, "p", "st0");
    if (tUnix(t)) {
        uxSys(f, t, "r", 5, xs2(L("h"), L("p"))); rtIf(f, L("r"), "ne", I(0), "cleanup");
        uxStatMode(f, t, "c", L("p")); rtOp(f, "c", L("c"), "and", I(61440)); rtLoad(f, "size", L("p"), uxConst(t, "ST_SIZE"), 8);
        rtIf(f, L("c"), "eq", I(16384), "directory"); rtIf(f, L("c"), "ne", I(32768), "cleanup");
    } else {
        callWinImport(f, "r", "GetFileType", xs1(L("h"))); rtIf32(f, L("r"), "ne", I(1), "cleanup");
        callWinImport(f, "r", "GetFileInformationByHandle", xs2(L("h"), L("p"))); rtIf32(f, L("r"), "eq", I(0), "cleanup");
        rtLoad(f, "c", L("p"), 0, 4); rtOp(f, "x", L("c"), "and", I(4461568)); rtIf(f, L("x"), "ne", I(0), "cleanup");
        rtOp(f, "c", L("c"), "and", I(16)); rtIf(f, L("c"), "ne", I(0), "directory");
        rtLoad(f, "size", L("p"), 32, 4); rtOp(f, "size", L("size"), "imul", I(4294967296)); rtLoad(f, "x", L("p"), 36, 4); rtOp(f, "size", L("size"), "or", L("x"));
    }
    if (mode == 1) { rtSet(f, "result", I(1)); rtJump(f, "cleanup"); }
    else if (mode == 2) { rtSet(f, "result", L("size")); rtJump(f, "cleanup"); }
    else {
        rtIf(f, L("size"), "lt", I(0), "cleanup"); rtIf(f, L("size"), "gt", L("max"), "cleanup");
        rtOp(f, "cap", L("size"), "add", I(1)); rtCall2(f, "buf", "__tx_native_mem_alloc", L("cap"), I(1)); rtIf(f, L("buf"), "eq", I(0), "oom"); rtSet(f, "used", I(0));
        rtLabel(f, "read"); rtOp(f, "p", L("buf"), "add", L("used")); rtOp(f, "n", L("cap"), "sub", L("used"));
        if (tUnix(t)) {
            uxSys(f, t, "r", 0, xs3(L("h"), L("p"), L("n"))); rtIf(f, L("r"), "eq", I(-4), "read"); rtIf(f, L("r"), "lt", I(0), "cleanup");
        } else {
            rtIf(f, L("n"), "le", I(1048576), "chunk"); rtSet(f, "n", I(1048576)); rtLabel(f, "chunk");
            rtSet(f, "got", I(0)); rtAddrOf(f, "gotp", "got"); callWinImport(f, "r", "ReadFile", xs5(L("h"), L("p"), L("n"), L("gotp"), I(0))); rtIf32(f, L("r"), "eq", I(0), "cleanup"); rtLoad(f, "r", L("gotp"), 0, 4);
        }
        rtIf(f, L("r"), "eq", I(0), "eof"); rtOp(f, "used", L("used"), "add", L("r")); rtIf(f, L("used"), "ge", L("cap"), "cleanup"); rtJump(f, "read");
        rtLabel(f, "eof");
        rtIf(f, L("used"), "ne", I(0), "take_bytes"); rtCall1(f, "", "__tx_native_mem_free", L("buf")); rtSet(f, "buf", I(0));
        rtLabel(f, "take_bytes");
        // ObjectSpec64：与 Bytes／紧凑 List<u8> 共用规范对象形态；仅调用已有内核导出。
        rtSet(f, "st0", I(10)); rtSet(f, "st1", I(30064771072)); rtSet(f, "st2", L("buf"));
        rtSet(f, "st3", L("used")); rtSet(f, "st4", L("used")); rtSet(f, "st5", I(12884901892)); rtSet(f, "st6", I(4)); rtSet(f, "st7", I(0));
        rtCall2(f, "r", "__tx_site_of", L("fn"), L("pc")); rtAddrOf(f, "p", "st0"); rtStore(f, L("p"), 8, L("r"), 4);
        rtCall1(f, "result", "__tx_native_object_create_v1", L("p")); rtSet(f, "buf", I(0));
        rtSet(f, "tag", I(TAG_BYTES)); rtJump(f, "cleanup");
    }
    rtLabel(f, "directory"); if (mode == 1) { rtSet(f, "result", I(2)); }
    rtLabel(f, "cleanup"); rtCall1(f, "", "__tx_local_close", L("chain")); rtCall1(f, "", "__tx_native_mem_free", L("buf")); rtIf(f, L("result"), "lt", I(0), "denied");
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("tag"), L("result")); rtRetVoid(f);
    rtLabel(f, "denied");
    if (mode == 1) { rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_INT), I(0)); rtRetVoid(f); }
    else { rtSet(f, "c", I(4)); rtJump(f, "error"); }
    rtLabel(f, "invalid"); rtSet(f, "c", I(1));
    rtLabel(f, "error"); rtCall4(f, "result", "__tx_store_file_err", L("c"), L("path"), L("fn"), L("pc")); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_ERR), L("result")); rtRetVoid(f);
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRetVoid(f);
    toolTrap(b, f, "arity", 4010, "本地文件内建实参数目错误"); toolTrap(b, f, "type", 4010, "本地文件内建实参类型错误"); rtRetVoid(f); toolCheck(f);
}

// localListDir(root, rel): List<string> | Error（D3 v0.35，macOS 适配 M0b §四-2）：与 readLocalFileBytes 同一受根约束的
// 打开（拒绝链接、重解析点与根外，不先检查再按路径重开），列出目录项名，按字节排序，不含 "." 与 ".."；rel 为空列根本身。
// 只给名字，不跟随其中的链接。Linux：O_PATH 的根句柄不能 getdents，rel 为空时经它再开 "."；Windows：目录句柄带
// LIST_DIRECTORY 与同步 I/O，用 GetFileInformationByHandleEx 的 FileFullDirectory(Restart)Info 列举（不是目录得错误值）。
function emitList(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_tool_local_list_dir", "win fn pc a bi nargs", "s t o rp rn pp pn path chain h x p n c r l buf m q e nm nl cap out gp ef rt rv", 8, "bootstrap/selfhost/tool_local.tx");
    toolArity(f, 2);
    toolArgSpan(f, 0, TAG_STR, "o", "rp", "rn", "type"); toolArgSpan(f, 1, TAG_STR, "o", "pp", "pn", "type"); rtSet(f, "path", L("t"));
    rtCall3(f, "r", "__tx_local_lex", L("rp"), L("rn"), I(1)); rtIf(f, L("r"), "eq", I(0), "denied");
    rtCall3(f, "r", "__tx_local_lex", L("pp"), L("pn"), I(0)); rtIf(f, L("r"), "eq", I(0), "denied");
    rtCall4(f, "chain", "__tx_local_open", L("rp"), L("rn"), L("pp"), L("pn")); rtIf(f, L("chain"), "eq", I(0), "denied");
    rtLoad(f, "n", L("chain"), 0, 8); rtOp(f, "n", L("n"), "imul", I(8)); rtOp(f, "p", L("chain"), "add", L("n")); rtLoad(f, "h", L("p"), 0, 8);
    rtSet(f, "x", I(-1)); rtSet(f, "buf", I(0)); rtSet(f, "out", I(0)); rtSet(f, "l", I(0));
    if (tRawSyscall(t)) {
        rtIf(f, L("pn"), "ne", I(0), "opened");
        // openat(根句柄, ".", O_RDONLY|O_DIRECTORY|O_CLOEXEC)。
        rtSet(f, "c", I(46)); rtAddrOf(f, "q", "c");
        rtSyscall(f, "x", 257, xs4(L("h"), L("q"), I(589824), I(0))); rtIf(f, L("x"), "lt", I(0), "cleanup"); rtSet(f, "h", L("x"));
        rtLabel(f, "opened");
        rtCall2(f, "buf", "__tx_native_mem_alloc", I(32768), I(8)); rtIf(f, L("buf"), "eq", I(0), "oom");
        rtCall0(f, "l", "__tx_nrt_list_make");
        rtLabel(f, "batch");
        rtSyscall(f, "m", 217, xs3(L("h"), L("buf"), I(32768)));
        rtIf(f, L("m"), "lt", I(0), "cleanup"); rtIf(f, L("m"), "eq", I(0), "listed");
        rtSet(f, "c", I(0));
        rtLabel(f, "entry"); rtIf(f, L("c"), "ge", L("m"), "batch");
        rtOp(f, "nm", L("buf"), "add", L("c")); rtOp(f, "nm", L("nm"), "add", I(19)); rtSet(f, "nl", I(0));
        rtLabel(f, "count"); rtOp(f, "q", L("nm"), "add", L("nl")); rtLoad(f, "e", L("q"), 0, 1);
        rtIf(f, L("e"), "eq", I(0), "counted"); rtOp(f, "nl", L("nl"), "add", I(1)); rtJump(f, "count");
        rtLabel(f, "counted");
        rtLoad(f, "e", L("nm"), 0, 1); rtIf(f, L("e"), "ne", I(46), "keep"); rtIf(f, L("nl"), "eq", I(1), "next");
        rtLoad(f, "e", L("nm"), 1, 1); rtIf(f, L("nl"), "ne", I(2), "keep"); rtIf(f, L("e"), "eq", I(46), "next");
        rtLabel(f, "keep");
        rtCall3(f, "q", "__tx_nrt_str_copy", L("nm"), L("nl"), I(1)); rtCall3(f, "", "__tx_nrt_list_add", L("l"), I(6), L("q"));
        rtLabel(f, "next");
        rtOp(f, "q", L("buf"), "add", L("c")); rtLoad(f, "e", L("q"), 16, 4); rtOp(f, "e", L("e"), "and", I(65535));
        rtOp(f, "c", L("c"), "add", L("e")); rtJump(f, "entry");
    } else if (tMacos(t)) {
        // dup 出的描述符交给 fdopendir（它接管描述符，closedir 时关闭），链上的句柄仍由 __tx_local_close 关；x 记 DIR*。
        // 名字在 d_name（偏移 21），长度为 d_namlen（偏移 18，u16）；readdir 出错（RET_PTR 为负）按失败报。
        uxSys(f, t, "c", 32, xs1(L("h"))); rtIf(f, L("c"), "lt", I(0), "cleanup");
        uxMac(f, "x", "fdopendir", xs1(L("c")));
        rtIf(f, L("x"), "gt", I(0), "opened");
        uxSys(f, t, "", 3, xs1(L("c"))); rtSet(f, "x", I(-1)); rtJump(f, "cleanup");
        rtLabel(f, "opened");
        rtCall0(f, "l", "__tx_nrt_list_make");
        rtLabel(f, "entry");
        uxMac(f, "nm", "readdir", xs1(L("x")));
