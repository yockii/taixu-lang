// 深链释放：释放递归超过深度护栏（8192 层）的对象链须正常释放（原生产物原先以“未实现 深链释放回退”退出 70）。
// 待释放表是每线程的：工作线程里同样建、放深链。
enum Chain {
    Nil,
    Cons(v: int, next: Ref< Chain>),
}

enum Tree {
    Leaf,
    Node(v: int, kids: List< Ref< Tree>>),
}

function chain(n: int): Ref< Chain> {
    let head: Ref< Chain> = new Chain.Nil();
    let i = 0;
    while (i < n) {
        head = new Chain.Cons(i, head);
        i = i + 1;
    }
    return head;
}

function first(c: Ref< Chain>): int {
    return switch (c) {
        case Cons(v, next) => v,
        else => -1,
    };
}

// 每层一个 List 装下一层：释放时链深是层数的两倍（节点、列表交替）。
function spine(n: int): Ref< Tree> {
    let t: Ref< Tree> = new Tree.Leaf();
    let i = 0;
    while (i < n) {
        const kids: List< Ref< Tree>> = listNew();
        listPush(kids, t);
        t = new Tree.Node(i, kids);
        i = i + 1;
    }
    return t;
}

function top(t: Ref< Tree>): int {
    return switch (t) {
        case Node(v, kids) => v,
        else => -1,
    };
}

// 工作线程里建、放深链（线程的待释放表在它自己的线程块里）。
function worker(): int {
    const c = chain(30000);
    return first(c);
}

function joinInt(t: Thread < int >): int {
    const v = threadJoin(t) catch (e) {
        print("join error: " + e.message);
        return -1;
    };
    return v;
}

export function main(args: []string): int {
    let total = 0;
    let round = 0;
    while (round < 3) {
        const c = chain(20000);
        total = total + first(c);
        round = round + 1;
    }
    print("chain " + toStr(total));
    const t = spine(15000);
    print("spine " + toStr(top(t)));
    const many: List< Ref< Chain>> = listNew();
    let k = 0;
    while (k < 5) {
        listPush(many, chain(10000 + k));
        k = k + 1;
    }
    let s = 0;
    k = 0;
    while (k < 5) {
        s = s + first(listGet(many, k) catch new Chain.Nil());
        k = k + 1;
    }
    print("many " + toStr(s));
    const w = threadSpawn(worker);
    print("thread " + toStr(joinInt(w)));
    return 0;
}
