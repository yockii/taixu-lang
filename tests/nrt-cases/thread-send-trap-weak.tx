// 线程第 3b 步：经函数值带入的 Weak 在发送时核对（线程设计 §十八）。外层闭包只捕获 List<() => bool>，静态可发送；
// List 里的闭包捕获了 Weak，它的环境类型在可发送表里标为 0，threadSpawn 时 trap 4021。
struct Node {
    v: int,
}

function main(args: []string): void {
    const n: Ref< Node> = new Node { v: 1 };
    const w: Weak< Node> = weak(n);
    const fs: List< () => bool> = listNew();
    listPush(fs, (): bool => w == w);
    const t = threadSpawn((): int => listLen(fs));
    print(toStr(threadJoin(t) catch -1));
}
