// D3 v0.36 C 变参（Linux，libc）：变参参数按 C 变参约定传——float、int、窄整数与 f32（C 的默认实参提升：i8 → int、
// f32 → double）、u32、字符串混排，核对 snprintf 的格式化结果与返回的字节数（SysV：变参浮点进 xmm 并计入 al）。
declare function snprintf(buf: Bytes, size: usize, format: string, ...e: float, ...a: int, ...b: i8, ...c: u32, ...d: f32, ...f: string): i32 from "libc.so.6";

function cText(b: Bytes): string {
    let n = 0;
    while (n < bytesLen(b) && (bytesGet(b, n) catch 0) != 0) { n = n + 1; }
    return bytesToStr(bytesSlice(b, 0, n)) catch "bad-utf8";
}

function main(args: []string): int {
    const buf = bytesNew(96);
    const small: i8 = -5;
    const wide: u32 = 4000000000;
    const single: f32 = 1.25;
    const n = snprintf(buf, 96, "%.3f %lld %d %u %.2f %s", 2.5, -9000000000, small, wide, single, "太虚");
    print("ret " + toStr(n as int) + " text " + cText(buf));
    return 0;
}
