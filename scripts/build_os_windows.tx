// 构建驱动的 Windows 系统原语（导出面同 build_os_linux.tx）：kernel32 的 W 版接口（同编译器的 mcp_scratch_os_windows.tx、
// 标准库的 file_sys_windows.tx）。路径经 wstr 转 UTF-16。
import { realPath } from "../bootstrap/selfhost/real_path";
declare type SECURITY_ATTRIBUTES;
declare type OVERLAPPED;
declare function CreateFileW(name: wstr, access: u32, share: u32, sa: SECURITY_ATTRIBUTES?, disposition: u32, flags: u32, template: isize): isize from "kernel32";
declare function WriteFile(h: isize, buf: Bytes, n: u32, put: Bytes, ov: OVERLAPPED?): i32 from "kernel32";
declare function CloseHandle(h: isize): i32 from "kernel32";
declare function RemoveDirectoryW(name: wstr): i32 from "kernel32";
declare function MoveFileExW(from: wstr, to: wstr, flags: u32): i32 from "kernel32";

// GENERIC_WRITE；FILE_SHARE_READ；CREATE_ALWAYS；FILE_ATTRIBUTE_NORMAL。
const ACCESS_WRITE: int = 1073741824;
const SHARE_READ: int = 1;
const CREATE_ALWAYS: int = 2;
const FILE_ATTRIBUTE_NORMAL: int = 128;
// MOVEFILE_REPLACE_EXISTING｜MOVEFILE_WRITE_THROUGH。
const MOVE_REPLACE: int = 9;
// 一次写出至多 16 MiB（只在不是整块时切出这一段）。
const CHUNK: int = 16777216;

// 删除空目录（不递归；目录联接只删联接本身）。
export function osRemoveDir(path: string): bool {
    return RemoveDirectoryW(path) != 0;
}

// 改名；目标已存在时替换它（同一卷内为原子改名）。
export function osRename(from: string, to: string): bool {
    return MoveFileExW(from, to, MOVE_REPLACE as u32) != 0;
}

// 真实路径：同编译器的 real_path 模块（服务信任根、MCP 暂存区共用一份实现）；local* 内建拒绝路径里的链接，解析不了时原样
// 返回，由随后的检查报错。
export function osRealPath(path: string): string {
    return realPath(path);
}

// 新建或截断 path 并写出 data 的全部内容；exec 在 Windows 上不起作用（可执行性由扩展名决定）。
export function osWriteFile(path: string, data: Bytes, exec: bool): bool {
    const h = CreateFileW(path, ACCESS_WRITE as u32, SHARE_READ as u32, None, CREATE_ALWAYS as u32, FILE_ATTRIBUTE_NORMAL as u32, 0);
    if (h == -1 || h == 0) {
        return false;
    }
    const total = bytesLen(data);
    const put = bytesNew(8);
    let off: int = 0;
    let ok: bool = true;
    while (off < total) {
        let n: int = total - off;
        if (n > CHUNK) {
            n = CHUNK;
        }
        let src: Bytes = data;
        if (off > 0 || n < total) {
            src = bytesSlice(data, off, n);
        }
        if (WriteFile(h, src, n as u32, put, None) == 0) {
            ok = false;
            break;
        }
        const w = bytesGetLE<int>(put, 0) ?? 0;
        if (w <= 0) {
            ok = false;
            break;
        }
        off = off + w;
    }
    if (CloseHandle(h) == 0) {
        ok = false;
    }
    return ok;
}
