// Windows 本地卷锚定＋逐组件相对句柄打开。禁止 reparse/offline/recall；不先检查再按路径重开。
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtRet } from "./rtfn";
import { callWinImport } from "./ffi_callbacks";
import { toolCheck, toolText, xs0, xs1, xs2, xs3, xs4, xs5, xs7 } from "./tool_base";

export function emitLocalWindowsOpen(b: Ref<StructuredBuffer>): void {
    emitDevice(b);
    emitNtOpen(b);
    const locals = "chain root rel phase p start n c h parent dir q count cap gp ef wh";
    const f = rtBegin(b, "__tx_local_open", "rp rn pp pn", locals, 4, "bootstrap/selfhost/tool_local_win_open.tx");
    rtSet(f, "rel", I(0)); rtSet(f, "root", I(0));
    rtOp(f, "cap", L("rn"), "add", L("pn")); rtOp(f, "cap", L("cap"), "add", I(8)); rtOp(f, "cap", L("cap"), "imul", I(8));
    rtCall2(f, "chain", "__tx_native_mem_alloc", L("cap"), I(8)); rtIf(f, L("chain"), "eq", I(0), "oom"); rtStore(f, L("chain"), 0, I(0), 8);
    rtCall1(f, "h", "__tx_local_device", L("rp")); rtIf(f, L("h"), "eq", I(0), "fail");
    rtStore(f, L("chain"), 0, I(1), 8); rtStore(f, L("chain"), 8, L("h"), 8);
    rtCall2(f, "root", "__tx_file_wpath", L("rp"), L("rn")); rtIf(f, L("root"), "eq", I(0), "oom");
    rtIf(f, L("pn"), "eq", I(0), "converted"); rtCall2(f, "rel", "__tx_file_wpath", L("pp"), L("pn")); rtIf(f, L("rel"), "eq", I(0), "oom");
    rtLabel(f, "converted"); rtSet(f, "phase", I(0)); rtOp(f, "p", L("root"), "add", I(6));
    rtLabel(f, "next"); rtSet(f, "start", L("p")); rtSet(f, "n", I(0));
    rtLabel(f, "scan"); wordLoad(f, "c", L("p"), 0); rtIf(f, L("c"), "eq", I(0), "component");
    rtIf(f, L("c"), "eq", I(47), "component"); rtIf(f, L("c"), "eq", I(92), "component");
    rtOp(f, "p", L("p"), "add", I(2)); rtOp(f, "n", L("n"), "add", I(2)); rtJump(f, "scan");
    rtLabel(f, "component"); rtIf(f, L("n"), "eq", I(0), "advance");
    rtSet(f, "dir", I(1)); rtIf(f, L("phase"), "eq", I(0), "open"); rtIf(f, L("c"), "ne", I(0), "open"); rtSet(f, "dir", I(0));
    rtLabel(f, "open"); rtLoad(f, "count", L("chain"), 0, 8); rtOp(f, "q", L("count"), "imul", I(8)); rtOp(f, "q", L("q"), "add", L("chain")); rtLoad(f, "parent", L("q"), 0, 8);
    rtCall4(f, "h", "__tx_local_ntopen", L("parent"), L("start"), L("n"), L("dir")); rtIf(f, L("h"), "eq", I(0), "fail");
    rtOp(f, "count", L("count"), "add", I(1)); rtStore(f, L("q"), 8, L("h"), 8); rtStore(f, L("chain"), 0, L("count"), 8);
    rtLabel(f, "advance"); rtIf(f, L("c"), "eq", I(0), "phase_done"); rtOp(f, "p", L("p"), "add", I(2)); rtJump(f, "next");
    rtLabel(f, "phase_done"); rtIf(f, L("phase"), "ne", I(0), "done"); rtIf(f, L("rel"), "eq", I(0), "done"); rtSet(f, "phase", I(1)); rtSet(f, "p", L("rel")); rtJump(f, "next");
    rtLabel(f, "fail"); rtCall1(f, "", "__tx_local_close", L("chain")); rtSet(f, "chain", I(0));
    rtLabel(f, "done"); rtCall1(f, "", "__tx_native_mem_free", L("root")); rtCall1(f, "", "__tx_native_mem_free", L("rel")); rtRet(f, L("chain"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRet(f, I(0)); toolCheck(f);
}

// QueryDosDevice 仅接受明确本地卷映射。拒绝 MUP/LanmanRedirector、SUBST、未知提供者；直接用设备名，避免再次解析盘符。
function emitDevice(b: Ref<StructuredBuffer>): void {
    const prefix = "\\Device\\HarddiskVolume";
    const text = toolText(b, prefix);
    const f = rtBegin(b, "__tx_local_device", "rp", "drive dp buf n r i c x h gp ef wh", 4, "bootstrap/selfhost/tool_local_win_open.tx");
    rtSet(f, "drive", I(0)); rtAddrOf(f, "dp", "drive"); rtLoad(f, "c", L("rp"), 0, 1); wordStore(f, L("dp"), 0, L("c")); wordStore(f, L("dp"), 2, I(58));
    rtCall2(f, "buf", "__tx_native_mem_alloc", I(2052), I(2)); rtIf(f, L("buf"), "eq", I(0), "oom");
    callWinImport(f, "r", "QueryDosDeviceW", xs3(L("dp"), L("buf"), I(1024))); rtIf32(f, L("r"), "eq", I(0), "bad");
    rtSet(f, "i", I(0));
    rtLabel(f, "prefix"); rtIf(f, L("i"), "ge", I(len(prefix)), "digits");
    rtOp(f, "x", L("i"), "imul", I(2)); rtOp(f, "x", L("x"), "add", L("buf")); wordLoad(f, "c", L("x"), 0);
    rtOp(f, "x", A(text), "add", L("i")); rtLoad(f, "x", L("x"), 0, 1); rtIf(f, L("c"), "ne", L("x"), "bad"); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "prefix");
    rtLabel(f, "digits"); rtSet(f, "n", L("i"));
    rtLabel(f, "digit"); rtIf(f, L("i"), "ge", I(1023), "bad");
    rtOp(f, "x", L("i"), "imul", I(2)); rtOp(f, "x", L("x"), "add", L("buf")); wordLoad(f, "c", L("x"), 0); rtIf(f, L("c"), "eq", I(0), "end");
    rtIf(f, L("c"), "lt", I(48), "bad"); rtIf(f, L("c"), "gt", I(57), "bad"); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "digit");
    rtLabel(f, "end"); rtIf(f, L("i"), "eq", L("n"), "bad");
    wordStore(f, L("x"), 0, I(92)); wordStore(f, L("x"), 2, I(0)); rtOp(f, "i", L("i"), "add", I(1)); rtOp(f, "n", L("i"), "imul", I(2));
    rtCall4(f, "h", "__tx_local_ntopen", I(0), L("buf"), L("n"), I(1)); rtJump(f, "done");
    rtLabel(f, "bad"); rtSet(f, "h", I(0)); rtLabel(f, "done"); rtCall1(f, "", "__tx_native_mem_free", L("buf")); rtRet(f, L("h"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRet(f, I(0)); toolCheck(f);
}

function emitNtOpen(b: Ref<StructuredBuffer>): void {
    const locals = "h hp r gp ef opts share ap up ip attr c oa0 oa1 oa2 oa3 oa4 oa5 us0 us1 io0 io1 fi0 fi1 fi2 fi3 fi4 fi5 fi6 fp wh";
    const f = rtBegin(b, "__tx_local_ntopen", "parent p n directory", locals, 11, "bootstrap/selfhost/tool_local_win_open.tx");
    rtSet(f, "h", I(0)); rtAddrOf(f, "hp", "h"); rtAddrOf(f, "ap", "oa0"); rtAddrOf(f, "up", "us0"); rtAddrOf(f, "ip", "io0");
    rtSet(f, "oa0", I(48)); rtSet(f, "oa1", L("parent")); rtSet(f, "oa2", L("up")); rtSet(f, "oa3", I(64)); rtSet(f, "oa4", I(0)); rtSet(f, "oa5", I(0));
    rtSet(f, "us0", I(0)); wordStore(f, L("up"), 0, L("n")); wordStore(f, L("up"), 2, L("n")); rtSet(f, "us1", L("p")); rtSet(f, "io0", I(0)); rtSet(f, "io1", I(0));
    rtOp(f, "opts", L("directory"), "or", I(2097184));
    // 共享方式：中间目录 READ|WRITE——不给 DELETE，持有期间祖先不能改名或删除（防换目录逃逸），但目录里照常建、删、
    // 原子替换文件（只给 READ 时编辑器安全保存与 git checkout 会撞上共享冲突）；末端 READ|WRITE|DELETE，读取期间
    // 别人可以写入或删除它，内容变化由读取方的长度检查发现。
    rtOp(f, "share", L("directory"), "imul", I(-4)); rtOp(f, "share", L("share"), "add", I(7));
    const args = xs7(L("hp"), I(1048705), L("ap"), L("ip"), I(0), I(0), L("share"));
    listPush(args, I(1)); listPush(args, L("opts")); listPush(args, I(0)); listPush(args, I(0));
    callWinImport(f, "r", "NtCreateFile", args); rtIf32(f, L("r"), "lt", I(0), "failed");
    rtAddrOf(f, "fp", "fi0"); callWinImport(f, "r", "GetFileInformationByHandle", xs2(L("h"), L("fp"))); rtIf32(f, L("r"), "eq", I(0), "close");
    rtLoad(f, "attr", L("fp"), 0, 4); rtOp(f, "attr", L("attr"), "and", I(4461568)); rtIf(f, L("attr"), "ne", I(0), "close"); rtRet(f, L("h"));
    rtLabel(f, "close"); callWinImport(f, "", "CloseHandle", xs1(L("h")));
    rtLabel(f, "failed"); rtRet(f, I(0)); toolCheck(f);
}

function wordLoad(f: Ref<RtFn>, dst: string, p: Ref<RtOp>, off: int): void {
    rtLoad(f, dst, p, off, 1); rtLoad(f, "wh", p, off + 1, 1);
    rtOp(f, "wh", L("wh"), "imul", I(256)); rtOp(f, dst, L(dst), "or", L("wh"));
}
function wordStore(f: Ref<RtFn>, p: Ref<RtOp>, off: int, value: Ref<RtOp>): void {
    rtStore(f, p, off, value, 1); rtShift(f, "wh", value, "shr", 8); rtStore(f, p, off + 1, L("wh"), 1);
}
