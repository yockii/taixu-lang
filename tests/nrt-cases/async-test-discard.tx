// 同步 test 不进调度泵，退出仍须放开任务和定时器的所有权。
struct Payload { text: string }

async function neverRun(p: Ref< Payload>): int {
    panic(p.text);
    return 0;
}

async function neverRunClosure(f: () => int): int {
    return f();
}

test "未启动的任务、闭包和定时器不泄漏，也不执行" {
    const p = new Payload { text: "任务体不应执行" };
    const job = neverRun(p);
    const captured = neverRunClosure((): int => {
            panic(p.text);
            return 0;
        });
    const timer = sleepMs(60000);
    const arrow = (async(): int => {
            panic(p.text);
            return 0;
        }) ();
    assert(true, "同步测试已返回");
}
