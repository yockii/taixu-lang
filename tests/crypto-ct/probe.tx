import { aes128Expand, aes128Block } from "std/crypto/aes_impl";
import { aes128GcmSeal, aes128GcmOpen } from "std/crypto/gcm";
import { constantTimeEqual } from "std/crypto/subtle";
import { hmacSha256 } from "std/crypto/hmac";
import { hkdfExpandSha256 } from "std/crypto/hkdf";
import { sha384Sum } from "std/crypto/sha384";
import { x25519PublicKey } from "std/crypto/ecdh";
import { p256PublicKey } from "std/crypto/p256";
import { tls13Wipe } from "std/tls13_state";

declare function tx_ct_running(): i32 from "libtaixu_ct.so";
declare function tx_ct_secret(data: Bytes, length: usize): void from "libtaixu_ct.so";
declare function tx_ct_public(data: Bytes, length: usize): void from "libtaixu_ct.so";
declare function tx_ct_tainted(data: Bytes, length: usize): i32 from "libtaixu_ct.so";
declare function tx_ct_public_bool(value: bool): i32 from "libtaixu_ct.so";

function secret(n: int, value: int): Bytes {
    const b = bytesNew(n); bytesFill(b, 0, n, value);
    tx_ct_secret(b, n as usize);
    assert(tx_ct_tainted(b, n as usize) == 1, "input must carry secret taint");
    return b;
}
function result(data: Bytes): void {
    assert(tx_ct_tainted(data, bytesLen(data) as usize) == 1, "output must retain secret taint");
    tx_ct_public(data, bytesLen(data) as usize);
    let sum = 0; for (b in bytesAsList(data)) { sum = sum + (b as int); }
    print(toStr(bytesLen(data)) + ":" + toStr(sum));
}
function main(args: []string): int {
    if (len(args) != 2 || tx_ct_running() != 1) { return 64; }
    const mode = args[0]; let value = 85;
    if (args[1] == "zero") { value = 0; }
    else if (args[1] == "ones") { value = 255; }
    else if (args[1] != "mixed") { return 64; }
    if (mode == "branch-negative") {
        const key = secret(16, value);
        if (((bytesGet(key, 0) catch 0) & 1) == 0) { print("even"); } else { print("odd"); }
    } else if (mode == "index-negative") {
        const key = secret(16, value); const table = bytesNew(256);
        bytesSet(table, 0, 13); bytesSet(table, 255, 29);
        const selected = bytesNew(1); bytesSet(selected, 0, bytesGet(table, bytesGet(key, 0) catch 0) catch 0);
        tx_ct_public(selected, 1); print(toStr(bytesGet(selected, 0) catch 0));
    } else if (mode == "aes") {
        result(aes128Block(aes128Expand(secret(16, value)), bytesNew(16)));
    } else if (mode == "gcm-seal") {
        result(aes128GcmSeal(secret(16, value), bytesNew(12), bytesNew(7), secret(33, value)) catch panic("gcm seal"));
    } else if (mode == "gcm-open") {
        const key = bytesNew(16); bytesFill(key, 0, 16, value);
        const plain = bytesNew(33); bytesFill(plain, 0, 33, value);
        const sealed = aes128GcmSeal(key, bytesNew(12), bytesNew(7), plain) catch panic("public setup");
        tx_ct_secret(key, 16);
        result(aes128GcmOpen(key, bytesNew(12), bytesNew(7), sealed) catch panic("gcm open"));
    } else if (mode == "hmac") {
        result(hmacSha256(secret(32, value), secret(55, value)));
    } else if (mode == "hmac-long") {
        result(hmacSha256(secret(131, value), secret(64, value)));
    } else if (mode == "hkdf") {
        result(hkdfExpandSha256(secret(32, value), bytesFromStr("audit"), 42) catch panic("hkdf"));
    } else if (mode == "sha384") {
        result(sha384Sum(secret(113, value)));
    } else if (mode == "x25519") {
        result(x25519PublicKey(secret(32, value)) catch panic("x25519"));
    } else if (mode == "p256") {
        const key = bytesNew(32); bytesFill(key, 1, 31, value); bytesSet(key, 0, 1);
        tx_ct_secret(key, 32); result(p256PublicKey(key) catch panic("p256"));
    } else if (mode == "subtle") {
        const a = secret(32, value); const b = bytesNew(32); bytesFill(b, 0, 32, value);
        assert(tx_ct_public_bool(constantTimeEqual(a, b)) == 1, "equal result declassified only after full comparison");
        for (at in [0, 16, 31]) {
            bytesSet(b, at, value ^ 1);
            assert(tx_ct_public_bool(constantTimeEqual(a, b)) == 0, "unequal result declassified after full comparison");
            bytesSet(b, at, value);
        }
        print("compared");
    } else if (mode == "wipe") {
        const data = secret(32, value); tls13Wipe(data);
        assert(tx_ct_tainted(data, 32) == 0 && bytesEqual(data, bytesNew(32)), "actual zero stores remove secret bytes and their taint");
        print("wiped");
    } else { return 64; }
    return 0;
}
