// ============================================================================
// engine/mac/m_b1 —— objc_msgSend：id(id, SEL, BOOL)。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: u8): usize from "/usr/lib/libobjc.A.dylib";

export function msgB(o: usize, s: string, a: bool): usize {
    let v: u8 = 0;
    if (a) {
        v = 1;
    }
    return objc_msgSend(o, sel_registerName(s), v);
}
