// ============================================================================
// stdlib 用例：Map／Set（V0.7-S3；D20 §四-1）
// 运行：taixu test tests/map-set.tx（依赖 TAIXU_STDLIB 或同级发现）
// 红线：迭代序＝插入序（禁哈希序）——覆盖扩容重排与覆写场景。
// ============================================================================

import { mapNew, mapSet, mapSetInt, mapGet, mapGetInt, mapHas, mapHasInt, mapLen, mapKeys, mapIntKeys } from "std/map_set";
import { setNew, setAdd, setHas, setLen, setToList } from "std/map_set";
import { Json } from "std/json";

function jint(n: int): Ref<Json> {
    return new Json.Int(n);
}

test "map：基本六件与插入序" {
    const m = mapNew();
    assert(mapLen(m) == 0, "新表应为空");
    mapSet(m, "a", jint(1));
    mapSet(m, "b", jint(2));
    mapSet(m, "c", jint(3));
    assert(mapLen(m) == 3, "长度应为 3");
    const got = mapGet(m, "b");
    assert(!(got == None), "b 应存在");
    const v = got catch new Json.Null();
    switch (v) {
        case Int(n) => assert(n == 2, "b 的值应为 2"),
        else => assert(false, "b 应为 Int"),
    };
    const ks = mapKeys(m);
    assert(listLen(ks) == 3, "键数应为 3");
    assert((listGet(ks, 0) catch "") == "a", "第 1 键应为 a（插入序）");
    assert((listGet(ks, 1) catch "") == "b", "第 2 键应为 b（插入序）");
    assert((listGet(ks, 2) catch "") == "c", "第 3 键应为 c（插入序）");
    assert(mapHas(m, "c"), "c 应存在");
    assert(!mapHas(m, "zz"), "zz 不应存在");
    assert(mapGet(m, "zz") == None, "缺失键应为 None");
}

test "map：覆写保持原插入位" {
    const m = mapNew();
    mapSet(m, "a", jint(1));
    mapSet(m, "b", jint(2));
    mapSet(m, "a", jint(9));
    assert(mapLen(m) == 2, "覆写不新增条目");
    const ks = mapKeys(m);
    assert((listGet(ks, 0) catch "") == "a", "a 仍应居首（原插入位）");
    const got = mapGet(m, "a");
    const v = got catch new Json.Null();
    switch (v) {
        case Int(n) => assert(n == 9, "a 的值应被覆写为 9"),
        else => assert(false, "a 应为 Int"),
    };
}

test "map：扩容重排后插入序不变（红线）" {
    const m = mapNew();
    let i: int = 0;
    while (i < 50) {
        mapSet(m, "k" + toStr(i), jint(i * i));
        i = i + 1;
    }
    assert(mapLen(m) == 50, "长度应为 50");
    const ks = mapKeys(m);
    assert(listLen(ks) == 50, "键数应为 50");
    i = 0;
    while (i < 50) {
        const k = listGet(ks, i) catch "";
        assert(k == "k" + toStr(i), "键序应＝插入序（扩容重排后）");
        const g = mapGet(m, k);
        const v = g catch new Json.Null();
        switch (v) {
            case Int(n) => assert(n == i * i, "值应一致"),
            else => assert(false, "应为 Int"),
        };
        i = i + 1;
    }
}

test "map：int 键族与 string 键互不相通" {
    const m = mapNew();
    mapSet(m, "7", jint(100));
    mapSetInt(m, 7, jint(200));
    assert(mapHas(m, "7"), "string 键 7 应存在");
    assert(mapHasInt(m, 7), "int 键 7 应存在");
    assert(mapLen(m) == 2, "两类键各占一条目");
    const ik = mapGetInt(m, 7);
    const iv = ik catch new Json.Null();
    switch (iv) {
        case Int(n) => assert(n == 200, "int 键 7 的值应为 200"),
        else => assert(false, "应为 Int"),
    };
    const iks = mapIntKeys(m);
    assert(listLen(iks) == 1 && (listGet(iks, 0) catch 0) == 7, "int 键列表应为 [7]");
}

test "set：五件与插入序" {
    const s = setNew();
    assert(setLen(s) == 0, "新集合应为空");
    assert(setAdd(s, "x"), "首次加入 x 应成功");
    assert(!setAdd(s, "x"), "重复加入 x 应不动作");
    setAdd(s, "a");
    setAdd(s, "m");
    assert(setLen(s) == 3, "长度应为 3");
    assert(setHas(s, "m"), "m 应存在");
    assert(!setHas(s, "zz"), "zz 不应存在");
    const l = setToList(s);
    assert((listGet(l, 0) catch "") == "x", "插入序首位应为 x");
    assert((listGet(l, 1) catch "") == "a", "插入序次位应为 a");
    assert((listGet(l, 2) catch "") == "m", "插入序末位应为 m");
}

test "set：扩容后插入序不变" {
    const s = setNew();
    let i: int = 0;
    while (i < 60) {
        setAdd(s, "e" + toStr(i));
        i = i + 1;
    }
    assert(setLen(s) == 60, "长度应为 60");
    const l = setToList(s);
    i = 0;
    while (i < 60) {
        assert((listGet(l, i) catch "") == "e" + toStr(i), "插入序应保持");
        i = i + 1;
    }
}
