// O4 第二步 2c：紧凑列表来自 Shared 时冻结（载荷借用共享块），读照常，listPush 即 trap 4022。
function main(args: []string): void {
    const xs: List< u8> = listNew();
    const a: u8 = 200;
    const b: u8 = 7;
    listPush(xs, a);
    listPush(xs, b);
    const s = sharedNew(xs);
    const ys = sharedGet(s);
    print(toStr(listLen(ys)) + " " + toStr(listGet(ys, 0) catch b) + " " + toStr(listGet(ys, 1) catch a));
    listPush(ys, a);
    print("unreachable");
}
