function outer(a: int): (int) => (int) => int {
    return (b: int): (int) => int => {
        return (c: int): int => a + b + c;
    };
}
export function main(args: []string): int {
    const f = outer(1);
    const g = f(2);
    print(toStr(g(3)));
    print(toStr(outer(10) (20) (30)));
    return 0;
}
