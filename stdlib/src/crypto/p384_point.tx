// Public verification points only. a=-3 Jacobian dbl-2001-b/add-2007-bl.
// Public scalar branches are intentional; do not use this module for ECDH/signing.
import { P384Field, p384PrimeBytes, p384Small as small, p384Decode as decode, p384Encode as encode,
    p384Add as add, p384Sub as sub, p384Mul as mul, p384Inverse as inverse, p384Zero as zero, p384Less } from "./p384_field";
import { p256Hex } from "./p256_field";

export struct P384Point { x: List<int>, y: List<int>, z: List<int> }
export struct P384Affine { x: Bytes, y: Bytes }
function square(f: Ref<P384Field>, a: List<int>): List<int> { return mul(f, a, a); }
function twice(f: Ref<P384Field>, a: List<int>): List<int> { return add(f, a, a); }
function four(f: Ref<P384Field>, a: List<int>): List<int> { return twice(f, twice(f, a)); }
function eight(f: Ref<P384Field>, a: List<int>): List<int> { return twice(f, four(f, a)); }
export function p384Infinity(f: Ref<P384Field>): Ref<P384Point> { return new P384Point { x: small(f, 1), y: small(f, 1), z: small(f, 0) }; }

export function p384Double(f: Ref<P384Field>, p: Ref<P384Point>): Ref<P384Point> {
    if (zero(p.z) || zero(p.y)) { return p384Infinity(f); }
    const delta = square(f, p.z); const gamma = square(f, p.y); const beta = mul(f, p.x, gamma);
    const a = mul(f, sub(f, p.x, delta), add(f, p.x, delta)); const alpha = add(f, a, twice(f, a));
    const x = sub(f, square(f, alpha), eight(f, beta));
    return new P384Point { x: x, y: sub(f, mul(f, alpha, sub(f, four(f, beta), x)), eight(f, square(f, gamma))),
        z: sub(f, sub(f, square(f, add(f, p.y, p.z)), gamma), delta) };
}
export function p384PointAdd(f: Ref<P384Field>, p: Ref<P384Point>, q: Ref<P384Point>): Ref<P384Point> {
    if (zero(p.z)) { return q; } if (zero(q.z)) { return p; }
    const z1 = square(f, p.z); const z2 = square(f, q.z); const u1 = mul(f, p.x, z2); const u2 = mul(f, q.x, z1);
    const s1 = mul(f, p.y, mul(f, q.z, z2)); const s2 = mul(f, q.y, mul(f, p.z, z1));
    const h = sub(f, u2, u1); const sdiff = sub(f, s2, s1);
    if (zero(h)) { if (zero(sdiff)) { return p384Double(f, p); } return p384Infinity(f); }
    const r = twice(f, sdiff); const i = four(f, square(f, h)); const j = mul(f, h, i); const v = mul(f, u1, i);
    const x = sub(f, sub(f, square(f, r), j), twice(f, v));
    return new P384Point { x: x, y: sub(f, mul(f, r, sub(f, v, x)), twice(f, mul(f, s1, j))), z: twice(f, mul(f, mul(f, p.z, q.z), h)) };
}
export function p384Base(f: Ref<P384Field>): Ref<P384Point> {
    return new P384Point {
        x: decode(f, p256Hex("aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7")),
        y: decode(f, p256Hex("3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")), z: small(f, 1) };
}
export function p384DecodePoint(f: Ref<P384Field>, peer: Bytes): Ref<P384Point> | Error {
    if (bytesLen(peer) != 97 || (bytesGet(peer, 0) catch 0) != 4) { return err("p384: requires uncompressed 97-byte point"); }
    const xb = bytesSlice(peer, 1, 48); const yb = bytesSlice(peer, 49, 48); const prime = p384PrimeBytes();
    if (!p384Less(xb, prime) || !p384Less(yb, prime)) { return err("p384: non-canonical coordinate"); }
    const x = decode(f, xb); const y = decode(f, yb);
    const b = decode(f, p256Hex("b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef"));
    const rhs = add(f, sub(f, mul(f, square(f, x), x), add(f, x, twice(f, x))), b);
    if (!zero(sub(f, square(f, y), rhs))) { return err("p384: point is not on curve"); }
    // P-384 has cofactor 1. A finite on-curve point is in the prime-order subgroup.
    return new P384Point { x: x, y: y, z: small(f, 1) };
}
export function p384Affine(f: Ref<P384Field>, point: Ref<P384Point>): P384Affine | Error {
    if (zero(point.z)) { return err("p384: point at infinity"); }
    const inv = inverse(f, point.z)?; const inv2 = square(f, inv);
    return P384Affine { x: encode(f, mul(f, point.x, inv2)), y: encode(f, mul(f, point.y, mul(f, inv2, inv))) };
}

// Shamir joint multiplication for two PUBLIC 48-byte scalars, no secret API.
export function p384Joint(f: Ref<P384Field>, p: Ref<P384Point>, a: Bytes, q: Ref<P384Point>, b: Bytes): Ref<P384Point> {
    if (bytesLen(a) != 48 || bytesLen(b) != 48) { panic("p384: public scalar width"); }
    const both = p384PointAdd(f, p, q); let out = p384Infinity(f); let bit = 383;
    while (bit >= 0) {
        out = p384Double(f, out);
        const av = ((bytesGet(a, 47 - bit / 8) catch 0) >> (bit % 8)) & 1;
        const bv = ((bytesGet(b, 47 - bit / 8) catch 0) >> (bit % 8)) & 1;
        if (av == 1 && bv == 1) { out = p384PointAdd(f, out, both); }
        else if (av == 1) { out = p384PointAdd(f, out, p); } else if (bv == 1) { out = p384PointAdd(f, out, q); }
        bit = bit - 1;
    }
    return out;
}
