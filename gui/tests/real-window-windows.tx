// real-window-windows —— Windows 真窗（GUI 原生引擎 G2）：开一个不显示的真窗（引擎旗标 16），经系统投递键鼠、字符（含
// UTF-16 代理对）、尺寸、菜单与关窗消息，核对窗口过程翻出的事件序列（移动洪泛合并、控制字符不发、坐标按 DPI 换成 DIP）；
// 程序化改客户区尺寸（经 WM_GETMINMAXINFO 写拖拽约束）、呈现、标题（含 NUL 不 trap）、菜单、光标的返回值。只在 Windows 上
// 跑（verify 按文件名的 -windows 后缀）；不读修饰键位（取决于跑测试时键盘的实际状态）。
// G5：系统交来的结构指针经外部内存区读写——程序化缩到最小尺寸以下被系统钳住（WM_GETMINMAXINFO 的读改写生效）；同步发
// WM_DPICHANGED 与 WM_GETMINMAXINFO（带指针的系统消息不许投递），lParam 指向本用例自己分配的页（建议矩形照办；MINMAXINFO 只改
// 两个拖拽尺寸、其余字段不动）、空地址、已释放的页、只读页（MINMAXINFO 要可写）——后三种不动窗口、不写内存、不崩溃。剪贴板写入后读回（含代理对、空串、NUL
// 截断），跑完把原有的文本放回（原来不是文本时剪贴板留下最后写的空串）。
// G5 第二部分：文件对话框能力 cap 7 在真窗会话里为 1（对话框本身会出现在屏幕上，不进自动用例，见可见冒烟）。
import { windowOpenEx, windowWaitEvent, windowPresent, windowClose, eventWindowTarget, eventWindowX, eventWindowY, windowScale, windowSetTitle, windowMenuAdd, windowSetCursor, windowSetMinMax, windowClientResize, surfaceOpen, surfaceClear, surfaceClose, guiQuery, eventWindowOpen, clipboardSetText, clipboardGetText } from "gui/surface";
import { platDebugPost, platDebugSend } from "gui/engine/platform";

declare struct RECT { left: i32, top: i32, right: i32, bottom: i32 }
declare struct POINT { x: i32, y: i32 }
declare struct MINMAXINFO { reserved: POINT, maxSize: POINT, maxPosition: POINT, minTrackSize: POINT, maxTrackSize: POINT }
declare function VirtualAlloc(addr: usize, size: usize, kind: u32, protect: u32): usize from "kernel32";
declare function VirtualProtect(addr: usize, size: usize, protect: u32, old: Bytes): i32 from "kernel32";
declare function VirtualFree(addr: usize, size: usize, kind: u32): i32 from "kernel32";

function dipToPx(v: int, k: int): int {
    if (k == 100) {
        return v;
    }
    return (v * k + 50) / 100;
}

function near(a: int, b: int): bool {
    return a - b <= 1 && b - a <= 1;
}

function page(): int {
    return VirtualAlloc(0, 4096, 12288, 4) as int;
}

function sentinel(): MINMAXINFO {
    return MINMAXINFO { reserved: POINT { x: 11, y: 12 }, maxSize: POINT { x: 13, y: 14 }, maxPosition: POINT { x: 15, y: 16 }, minTrackSize: POINT { x: 1, y: 1 }, maxTrackSize: POINT { x: 17, y: 18 } };
}

function othersKept(m: MINMAXINFO): bool {
    return m.reserved.x == 11 && m.reserved.y == 12 && m.maxSize.x == 13 && m.maxSize.y == 14 && m.maxPosition.x == 15 && m.maxPosition.y == 16;
}

function pxToDip(v: int, k: int): int {
    if (k == 100) {
        return v;
    }
    return (v * 100 + k / 2) / k;
}

function lp(x: int, y: int): int {
    return (y << 16) | x;
}

export function main(args: []string): int {
    args;
    const id: int = windowOpenEx("真窗探针", 240, 160, 16);
    const k: int = windowScale(id);
    print("real " + toStr(id > 0) + " scale-ok " + toStr(k >= 100 && k <= 500) + " cap " + toStr(guiQuery(0)) + " clip-cap " + toStr(guiQuery(5)) + " dialog-cap " + toStr(guiQuery(7)));
    const sid: int = eventWindowOpen("脚本窗", 10, 10);
    print("ids distinct " + toStr(sid != id));
    const surf: int = surfaceOpen(64, 32) catch (e) {
        print("surface failed");
        return 1;
    };
    surfaceClear(surf, 0x3366CC);
    print("present " + toStr(windowPresent(id, surf)) + " title " + toStr(windowSetTitle(id, "新标题")) + " nul-title " + toStr(windowSetTitle(id, "前" + (bytesToStr(bytesNew(1)) catch "") + "后")));
    print("menu " + toStr(windowMenuAdd(id, 120, "文件")) + " " + toStr(windowMenuAdd(id, 50, "x")) + " cursor " + toStr(windowSetCursor(id, 1)) + " " + toStr(windowSetCursor(id, 5)) + " minmax " + toStr(windowSetMinMax(id, 100, 80, 0, 0)));
    print("resize-api " + toStr(windowClientResize(id, 300, 200)));
    platDebugPost(id, 0x0201, 1, lp(40, 30));
    platDebugPost(id, 0x0200, 1, lp(41, 31));
    platDebugPost(id, 0x0200, 1, lp(42, 32));
    platDebugPost(id, 0x0202, 0, lp(43, 33));
    platDebugPost(id, 0x0100, 0x25, 0);
    platDebugPost(id, 0x0100, 0x2E, 0);
    platDebugPost(id, 0x0101, 0x25, 0);
    platDebugPost(id, 0x0100, 0x0D, 0);
    platDebugPost(id, 0x0102, 0x5A, 0);
    platDebugPost(id, 0x0102, 0xD83D, 0);
    platDebugPost(id, 0x0102, 0xDE00, 0);
    platDebugPost(id, 0x0102, 0x08, 0);
    platDebugPost(id, 0x0005, 0, lp(250, 150));
    platDebugPost(id, 0x0005, 1, 0);
    platDebugPost(id, 0x0111, 150, 0);
    platDebugPost(id, 0x0111, 50, 0);
    platDebugPost(id, 0x0010, 0, 0);
    let n: int = 0;
    while (n < 40) {
        const kind: int = windowWaitEvent(id, 0);
        if (kind == 0) {
            break;
        }
        const t: int = eventWindowTarget(id);
        const x: int = eventWindowX(id);
        const y: int = eventWindowY(id);
        if (kind == 3 || kind == 4 || kind == 5) {
            let px: int = 0;
            let py: int = 0;
            if (kind == 3) {
                px = 40;
                py = 30;
            } else if (kind == 5) {
                px = 42;
                py = 32;
            } else {
                px = 43;
                py = 33;
            }
            if (t >= 100) {
                print("ev " + toStr(kind) + " " + toStr(t));
            } else {
                print("ev " + toStr(kind) + " " + toStr(t) + " xy " + toStr(x == pxToDip(px, k) && y == pxToDip(py, k)));
            }
        } else if (kind == 7) {
            print("ev 7 api " + toStr(x == 300 && y == 200) + " posted " + toStr(x == pxToDip(250, k) && y == pxToDip(150, k)));
        } else {
            print("ev " + toStr(kind) + " " + toStr(t));
        }
        n = n + 1;
    }
    print("shrink-api " + toStr(windowClientResize(id, 50, 40)));
    const shrunk: int = windowWaitEvent(id, 0);
    print("ev " + toStr(shrunk) + " clamped " + toStr(eventWindowX(id) >= 100 && eventWindowY(id) >= 80));

    const pg: int = page();
    const ro: int = page();
    const gone: int = page();
    VirtualFree(gone as usize, 0, 32768);
    const raw = ffiMem(pg, 4096, true) catch (e) {
        print("page: " + e.message);
        return 1;
    };
    ffiMemSet<RECT>(raw, 0, RECT { left: 40, top: 50, right: 440, bottom: 350 });
    ffiMemSet<RECT>(raw, 16, RECT { left: 40, top: 50, right: 480, bottom: 380 });
    ffiMemSet<MINMAXINFO>(raw, 64, sentinel());
    const rom = ffiMem(ro, 4096, true) catch (e) {
        print("ro page: " + e.message);
        return 1;
    };
    ffiMemSet<MINMAXINFO>(rom, 0, sentinel());
    print("protect " + toStr(VirtualProtect(ro as usize, 4096, 2, bytesNew(4)) != 0));
    const dpi: int = k * 96 / 100;
    const dwp: int = dpi | (dpi << 16);
    platDebugSend(id, 0x02E0, dwp, pg);
    const e1: int = windowWaitEvent(id, 0);
    const w1: int = eventWindowX(id);
    const h1: int = eventWindowY(id);
    platDebugSend(id, 0x02E0, dwp, pg + 16);
    const e2: int = windowWaitEvent(id, 0);
    print("ev " + toStr(e1) + " " + toStr(e2) + " dpi-rect " + toStr(near(eventWindowX(id) - w1, pxToDip(40, k)) && near(eventWindowY(id) - h1, pxToDip(30, k))));
    platDebugSend(id, 0x02E0, dwp, 0);
    platDebugSend(id, 0x02E0, dwp, gone);
    platDebugSend(id, 0x0024, 0, 0);
    platDebugSend(id, 0x0024, 0, gone);
    platDebugSend(id, 0x0024, 0, ro);
    print("bad-addr ev " + toStr(windowWaitEvent(id, 0)));
    platDebugSend(id, 0x0024, 0, pg + 64);
    const mm = ffiMemGet<MINMAXINFO>(raw, 64);
    print("minmax kept " + toStr(othersKept(mm)) + " min " + toStr(mm.minTrackSize.x >= dipToPx(100, k) && mm.minTrackSize.y >= dipToPx(80, k)) + " max " + toStr(mm.maxTrackSize.x > 18 && mm.maxTrackSize.y > 18));
    const rov = ffiMem(ro, 4096, false) catch (e) {
        print("ro read: " + e.message);
        return 1;
    };
    const rm = ffiMemGet<MINMAXINFO>(rov, 0);
    print("readonly kept " + toStr(othersKept(rm) && rm.minTrackSize.x == 1 && rm.maxTrackSize.x == 17));
    ffiMemEnd(rov);
    ffiMemEnd(rom);
    ffiMemEnd(raw);
    VirtualFree(pg as usize, 0, 32768);
    VirtualFree(ro as usize, 0, 32768);

    const saved: string = clipboardGetText();
    const t1: string = "剪贴板：太虚 ✓ 😀";
    print("clip " + toStr(clipboardSetText(t1)) + " back " + toStr(clipboardGetText() == t1));
    print("clip-empty " + toStr(clipboardSetText("")) + " back " + toStr(clipboardGetText() == ""));
    print("clip-nul " + toStr(clipboardSetText("前" + (bytesToStr(bytesNew(1)) catch "") + "后")) + " back " + toStr(clipboardGetText() == "前"));
    if (saved != "") {
        clipboardSetText(saved);
    }

    windowClose(id);
    print("closed real " + toStr(windowSetTitle(id, "x")));
    windowClose(sid);
    surfaceClose(surf);
    return 0;
}
