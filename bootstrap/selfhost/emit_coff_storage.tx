// Native AMD64 COFF generation from the current assembler image.
// No external compiler, assembler or linker participates in this algorithm.
import { asImgText, asImgRdata, asImgData, asImgBssSize, asImgAlignPow, asStorageUsed, asSymCountL, asSymNameL, asSymSecL, asSymOffL, asFixCountL, asFixSecL, asFixAtL, asFixKindL, asFixSymL, asFixAddendL, asFailedAs } from "./assemble";
import { NativeFunctionImage } from "./native_function_data";
import { nativeFunctionEncode } from "./native_function_codec";

struct CoffImage {
    version: int, failed: int, text: List<int>, rdata: List<int>, data: List<int>, bssSize: int,
    textAlignPow: int, rdataAlignPow: int, dataAlignPow: int, bssAlignPow: int,
    symNames: List<string>, symSec: List<int>, symOff: List<int>,
    fixSec: List<int>, fixAt: List<int>, fixKind: List<int>, fixSym: List<string>, fixAddend: List<int>
}
struct CoffResult { ok: int, bytes: Bytes, error: string }
export function coffCaptureAssembler(): Ref<CoffImage> {
    const image = new CoffImage {
        version: 1, failed: asFailedAs(), text: listNew(), rdata: listNew(), data: listNew(), bssSize: 0, textAlignPow: asImgAlignPow(0), rdataAlignPow: asImgAlignPow(1), dataAlignPow: asImgAlignPow(2), bssAlignPow: asImgAlignPow(3),
        symNames: listNew(), symSec: listNew(), symOff: listNew(),
        fixSec: listNew(), fixAt: listNew(), fixKind: listNew(), fixSym: listNew(), fixAddend: listNew()
    };
    cfCopy(image.text, asImgText()); cfCopy(image.rdata, asImgRdata()); cfCopy(image.data, asImgData());
    image.bssSize = asImgBssSize(); if (asStorageUsed() == 1) { image.version = 2; }
    let i = 0;
    while (i < asSymCountL()) {
        listPush(image.symNames, asSymNameL(i)); listPush(image.symSec, asSymSecL(i)); listPush(image.symOff, asSymOffL(i)); i = i + 1;
    }
    i = 0;
    while (i < asFixCountL()) {
        listPush(image.fixSec, asFixSecL(i)); listPush(image.fixAt, asFixAtL(i)); listPush(image.fixKind, asFixKindL(i));
        listPush(image.fixSym, asFixSymL(i)); listPush(image.fixAddend, asFixAddendL(i)); i = i + 1;
    }
    return image;
}
export function coffResultOk(result: Ref<CoffResult>): int { return result.ok; }
export function coffResultBytes(result: Ref<CoffResult>): Bytes { return result.bytes; }
export function coffResultError(result: Ref<CoffResult>): string { return result.error; }
function cfFail(result: Ref<CoffResult>, message: string): void { if (len(result.error) == 0) { result.error = message; } }
function cfWord(out: Bytes, value: int, width: int): void {
    let k = 0;
    while (k < width) { bytesPush(out, (value >>> (k * 8)) & 255); k = k + 1; }
}
function cfPut(out: Bytes, at: int, value: int, width: int): void {
    let k = 0;
    while (k < width) { bytesSet(out, at + k, (value >>> (k * 8)) & 255); k = k + 1; }
}
function cfCopy(out: List<int>, source: Bytes): void {
    let k = 0;
    while (k < bytesLen(source)) { listPush(out, bytesGet(source, k) catch 0); k = k + 1; }
}
function cfNameValid(name: string): bool {
    if (len(name) == 0) { return false; }
    let k = 0;
    while (k < len(name)) { if ((byteAt(name, k) catch 0) == 0) { return false; } k = k + 1; }
    return true;
}
struct CoffIndex { heads: List<int>, names: List<string>, next: List<int> }
function cfIndex(): Ref<CoffIndex> {
    const index = new CoffIndex { heads: listNew(), names: listNew(), next: listNew() };
    let i = 0; while (i < 4096) { listPush(index.heads, -1); i = i + 1; }
    return index;
}
function cfHash(name: string): int {
    let h = 2166136261; let k = 0;
    while (k < len(name)) { h = ((h ^ (byteAt(name, k) catch 0)) * 16777619) & 4294967295; k = k + 1; }
    return h & 4095;
}
function cfFind(index: Ref<CoffIndex>, name: string): int {
    let k = listGet(index.heads, cfHash(name)) catch -1;
    while (k >= 0) {
        if ((listGet(index.names, k) catch "") == name) { return k; }
        k = listGet(index.next, k) catch -1;
    }
    return -1;
}
function cfInsert(index: Ref<CoffIndex>, name: string): void {
    const bucket = cfHash(name); const at = listLen(index.names);
    listPush(index.names, name); listPush(index.next, listGet(index.heads, bucket) catch -1); listSet(index.heads, bucket, at);
}
function cfName(out: Bytes, strings: Bytes, name: string): void {
    if (len(name) <= 8) {
        let k = 0;
        while (k < 8) {
            let b = 0;
            if (k < len(name)) { b = byteAt(name, k) catch 0; }
            bytesPush(out, b); k = k + 1;
        }
    } else {
        cfWord(out, 0, 4); cfWord(out, bytesLen(strings), 4);
        bytesAppend(strings, bytesFromStr(name));
        bytesPush(strings, 0);
    }
}
function cfSection(out: Bytes, strings: Bytes, name: string, size: int, raw: int, rel: int, nrel: int, flags: int): void {
    cfName(out, strings, name);
    cfWord(out, 0, 4); cfWord(out, 0, 4);
    cfWord(out, size, 4); cfWord(out, raw, 4); cfWord(out, rel, 4);
    cfWord(out, 0, 4); cfWord(out, nrel, 2); cfWord(out, 0, 2); cfWord(out, flags, 4);
}

export function coffWrite(image: Ref<CoffImage>, exports: List<string>): Ref<CoffResult> {
    return write(image, exports, new NativeFunctionImage { ok: false, error: "", isa: "", functions: listNew() });
}
export function coffWriteFunctions(image: Ref<CoffImage>, exports: List<string>, functions: Ref<NativeFunctionImage>): Ref<CoffResult> {
    assert(functions.ok, "object function collection failed:" + functions.error); return write(image, exports, functions);
}
function write(image: Ref<CoffImage>, exports: List<string>, functions: Ref<NativeFunctionImage>): Ref<CoffResult> {
    const result = new CoffResult { ok: 0, bytes: bytesNew(0), error: "" };
    if (image.version != 1 && image.version != 2) { cfFail(result, "UnsupportedImageVersion"); return result; }
    if (listLen(image.symNames) != listLen(image.symSec) || listLen(image.symNames) != listLen(image.symOff) || listLen(image.fixSec) != listLen(image.fixAt) || listLen(image.fixSec) != listLen(image.fixKind) || listLen(image.fixSec) != listLen(image.fixSym) || listLen(image.fixSec) != listLen(image.fixAddend)) { cfFail(result, "BadImageShape"); return result; }
    if (image.failed != 0) { cfFail(result, "AssemblerFailed"); return result; }
    if (image.bssSize < 0 || image.bssSize > 4294967295) { cfFail(result, "BadBssSize"); return result; }
    if (image.version == 1 && (listLen(image.data) != 0 || image.bssSize != 0)) { cfFail(result, "LegacyImageHasStorage"); return result; }
    let nsec = 2; let nraw = 2;
    if (image.version == 2) { nsec = 4; nraw = 3; }
    const empty: List<int> = listNew();
    const emptyBytes = bytesNew(0);
    const source: List<List<int>> = listNew();
    listPush(source, image.text); listPush(source, image.rdata); listPush(source, image.data);
    const bytes: List<Bytes> = listNew();
    const rels: List<Bytes> = listNew();
    const occupied: List<List<int>> = listNew();
    const sizes: List<int> = listNew();
    let i = 0;
    while (i < nraw) {
        const input = listGet(source, i) catch empty;
        const copy = bytesNew(0); const reloc = bytesNew(0); const bits: List<int> = listNew();
        let k = 0;
        while (k < listLen(input)) {
            const byte = listGet(input, k) catch -1;
            if (byte < 0 || byte > 255) { cfFail(result, "BadImageByte"); return result; }
            bytesPush(copy, byte); k = k + 1;
        }
        k = 0;
        while (k < (bytesLen(copy) + 63) / 64) { listPush(bits, 0); k = k + 1; }
        listPush(bytes, copy); listPush(rels, reloc); listPush(occupied, bits); listPush(sizes, bytesLen(copy));
        i = i + 1;
    }
    if (nsec == 4) { listPush(sizes, image.bssSize); }
    const alignments: List<int> = listNew();
    listPush(alignments, image.textAlignPow); listPush(alignments, image.rdataAlignPow);
    listPush(alignments, image.dataAlignPow); listPush(alignments, image.bssAlignPow);
    i = 0; while (i < nsec) {
        const power = listGet(alignments, i) catch -1;
        if (power < 0 || power > 13) { cfFail(result, "BadSectionAlignment"); return result; }
        i = i + 1;
    }
    const indexTable = cfIndex(); const names = indexTable.names;
    const secs: List<int> = listNew(); const values: List<int> = listNew(); const classes: List<int> = listNew();
    i = 0;
    while (i < listLen(image.symNames)) {
        const name = listGet(image.symNames, i) catch "";
        const sec = listGet(image.symSec, i) catch -1;
        const at = listGet(image.symOff, i) catch -1;
        if (!cfNameValid(name) || sec < 0 || sec >= nsec || at < 0 || at > (listGet(sizes, sec) catch -1) || cfFind(indexTable, name) >= 0) { cfFail(result, "BadSymbol"); return result; }
        cfInsert(indexTable, name); listPush(secs, sec + 1); listPush(values, at); listPush(classes, 3); i = i + 1;
    }
    i = 0;
    while (i < listLen(exports)) {
        const name = listGet(exports, i) catch ""; const index = cfFind(indexTable, name);
        if (!cfNameValid(name) || index < 0) { cfFail(result, "UndefinedExport"); return result; }
        if ((listGet(classes, index) catch 0) == 2) { cfFail(result, "DuplicateExport"); return result; }
        listSet(classes, index, 2); i = i + 1;
    }
    i = 0;
    while (i < listLen(image.fixSec)) {
        const sec = listGet(image.fixSec, i) catch -1; const at = listGet(image.fixAt, i) catch -1;
        const kind = listGet(image.fixKind, i) catch -1; const name = listGet(image.fixSym, i) catch "";
        const addend = listGet(image.fixAddend, i) catch 0;
        if (sec == 3 && nsec == 4) { cfFail(result, "BssRelocationUnsupported"); return result; }
        if (sec < 0 || sec >= nraw || (kind != 0 && kind != 1) || !cfNameValid(name)) { cfFail(result, "BadRelocation"); return result; }
        const buffer = listGet(bytes, sec) catch emptyBytes; const reloc = listGet(rels, sec) catch emptyBytes; const bits = listGet(occupied, sec) catch empty;
        let width = 4; let typ = 4;
        if (kind == 1) { width = 8; typ = 1; }
        if (at < 0 || at > bytesLen(buffer) - width) { cfFail(result, "RelocationOutOfBounds"); return result; }
        if (kind == 0 && (addend < -2147483648 || addend > 2147483647)) { cfFail(result, "RelocationAddendOverflow"); return result; }
        let k = 0;
        while (k < width) {
            const word = (at + k) / 64; const bit = 1 << ((at + k) % 64); const used = listGet(bits, word) catch -1;
            if ((used & bit) != 0) { cfFail(result, "OverlappingRelocation"); return result; }
            listSet(bits, word, used | bit); k = k + 1;
        }
        let index = cfFind(indexTable, name);
        if (index < 0) { index = listLen(names); cfInsert(indexTable, name); listPush(secs, 0); listPush(values, 0); listPush(classes, 2); }
        cfPut(buffer, at, addend, width); cfWord(reloc, at, 4); cfWord(reloc, index, 4); cfWord(reloc, typ, 2); i = i + 1;
    }
    const rawAt: List<int> = listNew(); const relAt: List<int> = listNew();
    let extra = 0; let metadata = bytesNew(0);
    if (functions.ok) { extra = 1; metadata = nativeFunctionEncode(functions, listGet(bytes, 0) catch emptyBytes, 0); }
    let cursor = 20 + (nsec + extra) * 40;
    i = 0;
    while (i < nraw) { listPush(rawAt, cursor); cursor = cursor + (listGet(sizes, i) catch 0); i = i + 1; }
    i = 0;
    while (i < nraw) {
        const reloc = listGet(rels, i) catch emptyBytes;
        if (bytesLen(reloc) / 10 > 65535) { cfFail(result, "ExtendedRelocationsRequired"); return result; }
        listPush(relAt, cursor); cursor = cursor + bytesLen(reloc); i = i + 1;
    }
    const metadataAt = cursor; const symAt = cursor + bytesLen(metadata);
    if (symAt + listLen(names) * 18 + 4 > 4294967295) { cfFail(result, "ObjectSizeOverflow"); return result; }
    const out = bytesNew(0); const strings = bytesNew(0); cfWord(strings, 0, 4);
    cfWord(out, 0x8664, 2); cfWord(out, nsec + extra, 2); cfWord(out, 0, 4); cfWord(out, symAt, 4); cfWord(out, listLen(names), 4); cfWord(out, 0, 2); cfWord(out, 0, 2);
    i = 0;
    while (i < nraw) {
        let name = ".text"; let flags = 0x60000020;
        if (i == 1) { name = ".rdata"; flags = 0x40000040; }
        if (i == 2) { name = ".data"; flags = 0xC0000040; }
        flags = flags | (((listGet(alignments, i) catch 4) + 1) << 20);
        const reloc = listGet(rels, i) catch emptyBytes; const count = bytesLen(reloc) / 10;
        let relocAt = listGet(relAt, i) catch 0;
        if (image.version == 2 && count == 0) { relocAt = 0; }
        cfSection(out, strings, name, listGet(sizes, i) catch 0, listGet(rawAt, i) catch 0, relocAt, count, flags); i = i + 1;
    }
    if (nsec == 4) { cfSection(out, strings, ".bss", image.bssSize, 0, 0, 0, 0xC0000080 | ((image.bssAlignPow + 1) << 20)); }
    if (extra != 0) { cfSection(out, strings, ".txfn", bytesLen(metadata), metadataAt, 0, 0, 0x100A00); }
    i = 0;
    while (i < nraw) { bytesAppend(out, listGet(bytes, i) catch emptyBytes); i = i + 1; }
    i = 0;
    while (i < nraw) { bytesAppend(out, listGet(rels, i) catch emptyBytes); i = i + 1; }
    bytesAppend(out, metadata);
    i = 0;
    while (i < listLen(names)) {
        cfName(out, strings, listGet(names, i) catch ""); cfWord(out, listGet(values, i) catch 0, 4); cfWord(out, listGet(secs, i) catch 0, 2);
        cfWord(out, 0, 2); cfWord(out, listGet(classes, i) catch 0, 1); cfWord(out, 0, 1); i = i + 1;
    }
    cfPut(strings, 0, bytesLen(strings), 4); bytesAppend(out, strings);
    if (bytesLen(out) > 4294967295) { cfFail(result, "ObjectSizeOverflow"); return result; }
    result.bytes = out; result.ok = 1; return result;
}
