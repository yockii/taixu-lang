import { PemLimits, pemDecode, pemDecodeLimit, pemDefaultLimits } from "std/pem";
import { sha256SumHex } from "std/hash";
import { parseInt } from "std/strconv";

function wrap(body: string): string { return "-----BEGIN CERTIFICATE-----\n" + body + "\n-----END CERTIFICATE-----\n"; }
function invalid(text: string): bool { pemDecode(text) catch (e) { return true; }; return false; }
function limited(text: string, limits: PemLimits): bool { pemDecodeLimit(text, limits) catch (e) { return true; }; return false; }

test "PEM：独立 base64 二进制向量与重复块" {
    const text = readFile("tests/vectors/pem.txt") catch panic("PEM fixture"); const blocks = pemDecode(text) catch panic("decode fixture");
    const expected = readFile("tests/vectors/pem-sha256.txt") catch panic("PEM hashes"); let count = 0;
    for (line in strSplit(expected, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const parts = strSplit(line, " "); const block = listGet(blocks, count);
        assert(block.label == listGet(parts, 0) && bytesLen(block.data) == (parseInt(listGet(parts, 1)) catch -1)
            && sha256SumHex(block.data) == listGet(parts, 2), "fixture " + toStr(count)); count = count + 1;
    }
    assert(count == 30 && listLen(blocks) == count, "complete fixture count");
    assert(listLen(pemDecode(wrap("AA==") + wrap("/w==")) catch panic("duplicates")) == 2, "duplicate labels preserved");
}

test "PEM：换行、空白、标签和块外文本" {
    const controls = (utf8Encode(11) catch "") + (utf8Encode(12) catch "");
    for (eol in ["\n", "\r", "\r\n"]) {
        const raw = "中文说明" + eol + "  -----BEGIN PUBLIC KEY----- \t" + eol + " \tAP/+" + eol + "AA==" + controls + eol + "-----END PUBLIC KEY-----";
        const blocks = pemDecode(raw) catch panic("whitespace"); const b = listGet(blocks, 0);
        assert(b.label == "PUBLIC KEY" && bytesLen(b.data) == 4 && (bytesGet(b.data, 0) catch -1) == 0 && (bytesGet(b.data, 1) catch -1) == 255
            && (bytesGet(b.data, 2) catch -1) == 254, "binary body with eol");
    }
    assert(listLen(pemDecode("plain text without blocks") catch panic("text")) == 0, "outside text ignored");
    const empty = pemDecode("-----BEGIN -----\n-----END -----") catch panic("empty label");
    assert(listGet(empty, 0).label == "" && bytesLen(listGet(empty, 0).data) == 0, "empty label allowed");
}

test "PEM：非法 base64、边界与资源上限" {
    for (body in ["A", "AA", "AA=", "AAA", "A===", "====", "=AAA", "AA=A", "AA===", "AAA==", "AB==", "AAB=", "Zg==YQ==", "AA!A", "中文"]) {
        assert(invalid(wrap(body)), "base64 " + body);
    }
    assert(invalid("-----BEGIN CERTIFICATE-----\nAA==\n") && invalid("-----BEGIN CERTIFICATE-----\nAA==\n-----END PUBLIC KEY-----"), "unclosed or mismatched");
    for (label in ["-A", "A-", "A--B", "A  B", "中文"]) {
        assert(invalid("-----BEGIN " + label + "-----\nAA==\n-----END " + label + "-----"), "label " + label);
    }
    let limits = pemDefaultLimits(); const text = wrap("AAAA");
    limits.maxInputBytes = len(text); limits.maxDecodedBytes = 3; limits.maxBlocks = 1;
    assert(bytesLen(listGet(pemDecodeLimit(text, limits) catch panic("exact limits"), 0).data) == 3, "exact limits");
    limits.maxInputBytes = len(text) - 1; assert(limited(text, limits), "input limit");
    limits.maxInputBytes = len(text); limits.maxDecodedBytes = 2; assert(limited(text, limits), "decoded limit");
    limits.maxDecodedBytes = 3; limits.maxBlocks = 0; assert(limited(text, limits), "block limit");
    limits = pemDefaultLimits(); limits.maxDecodedBytes = 1; assert(limited(wrap("AA==") + wrap("AA=="), limits), "aggregate decoded limit");
}
