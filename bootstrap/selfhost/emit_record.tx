// emit_record.tx —— EMITMIRROR v2 记录流构造的 .tx 承接（V0.50-S5-① 批 C；
// BOOT-47；D102 §一——src/tools/aot/emit_mirror.zig dumpRecords/dumpFunction
// ＋上游分析面的同构移植）。
//
// 职责（D102 冻结表：EMITMIRROR 记录构造）：
//   输入＝PROGDUMP v1 文本（bytecode.tx decodeToDump 同协议；自解析——跨模块
//   struct 签名禁令）＋配置旗标；输出＝EMITMIRROR v2 记录流文本。
//   锚＝对 zig 链 aot 产出的 <stem>.emitdump 逐字节恒等。
//
// 缺省旗标面（两臂同配置——emit_s.zig setAbFlagsFromEnv 有效缺省）：
//   typed_slots/paramsig/ir/esc/strbld/leafinl＝true；
//   lc/vh/rtsig/bce2＝false（缓存/视图提升 pad 恒 0）。不做向量化：SIMD 可识别的环照常出标量记录
//   （Zig 版的 AXPY 识别只为与当年的 SIMD 发射逐字节对齐而拒绝，E006，已删除）。也不做钉驻：Zig 版
//   把非 IR 函数里整型槽的回边环钉进 r12/r13，原生发射器从未实现，识别到就以 E007 整程序拒绝，已删除。
//
// 本件为 slice 1：PROGDUMP 解析＋computeSlotTypes＋buildFnIr＋全部 lop/run
// 记录形＋msg 首遇序；escape/strbld 计数面在册。
// 移植沉淀（批 A/B 执行发现照用）：Ref 列表＋dummy
// getter、new T{}、imul、无 var/_=/&local。

import { ProgramContext, programStringBytes } from "./program_context";
import { compileProfileActive, compileProfileClock, compileProfileDetail, compileProfileBridge, compileProfileRecord, compileProfileRecordTotal, compileProfileAnalysis } from "./compile_profile_data";
import { programContextValid } from "./bytecode";
import { RT_BI_BASE, RT_BI_COUNT, isDbgBi, isToolBi } from "./builtin_names";
import { isFwOp, fwOpType } from "./fw_ops";

import { planPayload } from "../regallocmirror";

// ============================================================================
// §0 interp.Tag 与常量
// ============================================================================

const TAG_INT: int = 1;
const TAG_FLOAT: int = 2;
const TAG_BOOL: int = 3;
const TAG_NONE: int = 4;
const TAG_ERR: int = 5;
const TAG_STR: int = 6;
const TAG_STRUCTV: int = 7;
const TAG_ENUMV: int = 8;
const TAG_REF: int = 9;
const TAG_ARR: int = 10;
const TAG_SLICE: int = 11;
const TAG_FNV: int = 12;
const TAG_WEAKBOX: int = 14;
const TAG_LIST: int = 15;
const TAG_FUTURE: int = 16;
const TAG_BYTES: int = 17; // D3 v0.18
const TAG_GEN: int = 18; // D3 v0.22 生成器句柄（仅原生链路）
const TAG_THREAD: int = 19; // 线程句柄（线程第 2 步，仅原生链路）
const TAG_SHARED: int = 20; // Shared<T> 句柄（线程第 4c 步，仅原生链路）
const TAG_ATOMIC: int = 21; // Atomic<int>（线程第 4c 步，仅原生链路）

const SLOT_BOTTOM: int = 255;
// 槽型格值“确定不是堆引用、具体标签未知”（泄漏检查设计 §六-A）：直接调用返回后实参之后的槽，以及
// 两个不同非堆标签在汇合处的合并。格序 底 < 具体标签 < NOHEAP < 0（未知），堆标签与 NOHEAP 合并为 0。
// 只有释放省略（norelAt）读得到它；其余消费者经 stateAt 一律读成 0，与引入前同判。
const SLOT_NOHEAP: int = 254;
// “无槽”哨兵（容量批 C3b）：单函数寄存器编号 0–65534，65535 表示无槽。原为 255——与真实的 R255 相撞
// （codegen 允许 R255）。SLOT_BOTTOM 是行内的类型标记“底”，不是寄存器号，不变。
const NO_SLOT: int = 65535;
// 分析规模护栏：指令数×寄存器数的上限（2^24 项，单表约 128 MB）。
export const ANALYSIS_BUDGET: int = 16777216;
// callbi 编号：内建 0..4095，外部函数从 4096 起（TXC v6；容量评估 §八）。
const EXTERN_ID_BASE: int = 4096;
// GETFLD/SETFLD 字段选择子（v6）：第 15 位为自动解引用或模块状态标志，0..14 位为字段号。
const FLD_FLAG: int = 0x8000;
const FLD_MASK: int = 0x7FFF;
const INVALID_ENTRY: int = 0xFFFFFFFF;
const MIN_RUN_LEN: int = 2;

const FRAME_PAD: int = 56; // emit_s.ccOf(.windows).frame_pad

// NativeKind（ir.zig——25 支持集＋none；字符串＝记录域名，与 zig @tagName 同文）。
const NK_NONE: int = 0;
const NK_MOVE: int = 1;
const NK_LOADK_INT: int = 2;
const NK_LOADK_FLOAT: int = 3;
const NK_LDBOOL: int = 4;
const NK_LDNONE: int = 5;
const NK_ADD_I: int = 6;
const NK_SUB_I: int = 7;
const NK_MUL_I: int = 8;
const NK_DIV_I: int = 9;
const NK_MOD_I: int = 10;
const NK_NEG_I: int = 11;
const NK_NEG_F: int = 12;
const NK_NOT_B: int = 13;
const NK_LT_I: int = 14;
const NK_LE_I: int = 15;
const NK_EQ_I: int = 16;
const NK_EQ_B: int = 17;
const NK_LT_F: int = 18;
const NK_LE_F: int = 19;
const NK_EQ_F: int = 20;
const NK_ADD_F: int = 21;
const NK_SUB_F: int = 22;
const NK_MUL_F: int = 23;
const NK_I2F_F: int = 24;
const NK_JF_B: int = 25;
const NK_JT_B: int = 26;

function nkName(k: int): string {
    if (k == NK_MOVE) { return "move"; }
    if (k == NK_LOADK_INT) { return "loadk_int"; }
    if (k == NK_LOADK_FLOAT) { return "loadk_float"; }
    if (k == NK_LDBOOL) { return "ldbool"; }
    if (k == NK_LDNONE) { return "ldnone"; }
    if (k == NK_ADD_I) { return "add_i"; }
    if (k == NK_SUB_I) { return "sub_i"; }
    if (k == NK_MUL_I) { return "mul_i"; }
    if (k == NK_DIV_I) { return "div_i"; }
    if (k == NK_MOD_I) { return "mod_i"; }
    if (k == NK_NEG_I) { return "neg_i"; }
    if (k == NK_NEG_F) { return "neg_f"; }
    if (k == NK_NOT_B) { return "not_b"; }
    if (k == NK_LT_I) { return "lt_i"; }
    if (k == NK_LE_I) { return "le_i"; }
    if (k == NK_EQ_I) { return "eq_i"; }
    if (k == NK_EQ_B) { return "eq_b"; }
    if (k == NK_LT_F) { return "lt_f"; }
    if (k == NK_LE_F) { return "le_f"; }
    if (k == NK_EQ_F) { return "eq_f"; }
    if (k == NK_ADD_F) { return "add_f"; }
    if (k == NK_SUB_F) { return "sub_f"; }
    if (k == NK_MUL_F) { return "mul_f"; }
    if (k == NK_I2F_F) { return "i2f_f"; }
    if (k == NK_JF_B) { return "jf_b"; }
    if (k == NK_JT_B) { return "jt_b"; }
    return "none";
}

// 支持集（emit_mirror kindSupported——批二值形 25 kind）。
function kindSupported(k: int): bool {
    if (k == NK_NONE) { return false; }
    return k <= NK_JT_B;
}

function nkIsBranch(k: int): bool {
    return k == NK_JF_B || k == NK_JT_B;
}

function nkIsCompare(k: int): bool {
    return (k >= NK_LT_I && k <= NK_EQ_I) || (k >= NK_LT_F && k <= NK_EQ_F) || k == NK_EQ_B;
}

// 指令字段（TXC v6，bytecode.tx 同构）：iABC＝op16|A16<<16|B16<<32|C16<<48；Bx＝[32..64)；sBx＝Bx−2^31。
function insOp(ins: int): int { return ins & 0xFFFF; }
function insA(ins: int): int { return (ins >>> 16) & 0xFFFF; }
function insB(ins: int): int { return (ins >>> 32) & 0xFFFF; }
function insC(ins: int): int { return (ins >>> 48) & 0xFFFF; }
function insBx(ins: int): int { return (ins >>> 32) & 0xFFFFFFFF; }
function insSbx(ins: int): int { return insBx(ins) - 2147483648; }

// ============================================================================
// §1 Program 视图（PROGDUMP v1 自解析——本件消费切面）
// ============================================================================

struct Ty {
    kind: int,
    a: int,
    b: int,
}

struct FieldDecl {
    name: int,
    ty: int,
}

struct VariantDecl {
    name: int,
    fields: List<Ref<FieldDecl>>,
}

struct TypeDecl {
    module: int,
    name: int,
    which: int,
    fields: List<Ref<FieldDecl>>,
    variants: List<Ref<VariantDecl>>,
}

struct LineCol {
    line: int,
    col: int,
}

struct Const {
    tag: int, // 1 int 2 float 3 str 4 fn_ref 5 jump_table 6 ty 7 variant 8 arr 9 slice
    i: int,
    fbits: int,
    vi: int,
    vlen: int,
    tbl: List<int>,
}

struct Fn {
    name: int,
    module: int,
    reg: int,
    nparams: int,
    code: List<int>,
    consts: List<Ref<Const>>,
    lines: List<Ref<LineCol>>,
    ptys: List<int>,
    ret: int,
    landings: List<int>, // 取消落点（扁平对：挂起点 pc、落点 pc；仅原生上下文）
}

struct ModuleInfo {
    path: int,
    state_ty: int,
    init_fn: int,
}

struct TestEntry {
    name: int,
    func: int,
}

struct ExternDecl {
    name: List<int>,
    tags: List<int>,
    ret: int,
}

struct FnSigDesc {
    ret: int,
    params: List<int>,
}

struct StrTab {
    bytes: List<int>,
    starts: List<int>,
}

struct Program {
    tys: List<Ref<Ty>>,
    decls: List<Ref<TypeDecl>>,
    funcs: List<Ref<Fn>>,
    modules: List<Ref<ModuleInfo>>,
    tests: List<Ref<TestEntry>>,
    externs: List<Ref<ExternDecl>>,
    sigs: List<Ref<FnSigDesc>>,
    st: Ref<StrTab>,
    entry: int,
}

function dummyTy(): Ref<Ty> { return new Ty { kind: 0, a: 0, b: 0 }; }
function dummyField(): Ref<FieldDecl> { return new FieldDecl { name: 0, ty: 0 }; }
function dummyVariant(): Ref<VariantDecl> { return new VariantDecl { name: 0, fields: listNew() }; }
function dummyDecl(): Ref<TypeDecl> { return new TypeDecl { module: 0, name: 0, which: 1, fields: listNew(), variants: listNew() }; }
function dummyLine(): Ref<LineCol> { return new LineCol { line: 0, col: 0 }; }
function dummyConst(): Ref<Const> { return new Const { tag: 0, i: 0, fbits: 0, vi: 0, vlen: 0, tbl: listNew() }; }
function dummyFn(): Ref<Fn> { return new Fn { name: 0, module: 0, reg: 0, nparams: 0, code: listNew(), consts: listNew(), lines: listNew(), ptys: listNew(), ret: 0, landings: listNew() }; }
function dummyModule(): Ref<ModuleInfo> { return new ModuleInfo { path: 0, state_ty: 0, init_fn: 0 }; }
function dummyTest(): Ref<TestEntry> { return new TestEntry { name: 0, func: 0 }; }
function dummyExtern(): Ref<ExternDecl> { return new ExternDecl { name: listNew(), tags: listNew(), ret: 0 }; }
function dummySig(): Ref<FnSigDesc> { return new FnSigDesc { ret: 0, params: listNew() }; }

// —— hex/文本工具（bytecode.tx 同构复制——自包含）——
function hexVal(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return -1;
}

function hexDecodeTo(s: string, out: List<int>): int {
    const n = len(s);
    if (n % 2 != 0) { return -1; }
    let i = 0;
    let count = 0;
    while (i < n) {
        const hi = hexVal(byteAt(s, i) catch 0);
        const lo = hexVal(byteAt(s, i + 1) catch 0);
        if (hi < 0 || lo < 0) { return -1; }
        listPush(out, (hi << 4) | lo);
        i = i + 2;
        count = count + 1;
    }
    return count;
}

const DEC_BAD: int = -9223372036854775807 - 1;

function parseIntTx(s: string): int {
    if (len(s) == 0) { return DEC_BAD; }
    let neg = false;
    let i = 0;
    const f = byteAt(s, 0) catch 48;
    if (f == 45) {
        neg = true;
        i = 1;
        if (len(s) == 1) { return DEC_BAD; }
    }
    let v: int = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 48;
        if (c < 48 || c > 57) { return DEC_BAD; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg) { return -v; }
    return v;
}

function dec(v: int): string {
    return toStr(v);
}

struct PdRdr {
    lines: List<string>,
    pos: int,
}

function pdOpen(dump: string): Ref<PdRdr> {
    return new PdRdr { lines: strSplit(dump, "\n"), pos: 0 };
}

function pdNext(r: Ref<PdRdr>): string {
    if (r.pos >= listLen(r.lines)) { return ""; }
    const l = listGet(r.lines, r.pos) catch "";
    r.pos = r.pos + 1;
    return l;
}

function pdFields(line: string): List<string> {
    return strSplit(line, " ");
}

function pdF(fields: List<string>, i: int): string {
    return listGet(fields, i) catch "";
}

function pdInt(fields: List<string>, i: int): int {
    return parseIntTx(pdF(fields, i));
}

// 数字密集的记录行直接按字节定位字段，保留split的空字段与坏值语义。
// 不创建字段List、子串或listGet结果盒；整数运算与parseIntTx相同。
function pdIntAt(line: string, field: int): int {
    if (field < 0) { return DEC_BAD; }
    let i = 0;
    let col = 0;
    while (col < field && i < len(line)) {
        if ((byteAt(line, i) catch 32) == 32) { col = col + 1; }
        i = i + 1;
    }
    if (col < field) { return DEC_BAD; }
    if (i >= len(line)) { return DEC_BAD; }
    let neg = false;
    if ((byteAt(line, i) catch 48) == 45) { neg = true; i = i + 1; }
    const begin = i;
    let v = 0;
    while (i < len(line)) {
        const c = byteAt(line, i) catch 48;
        if (c == 32) { break; }
        if (c < 48 || c > 57) { return DEC_BAD; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (i == begin) { return DEC_BAD; }
    if (neg) { return -v; }
    return v;
}

// parseDump：PROGDUMP v1 → Program（失败返回 errprog 标记——entry=-2 哨兵）。
function parseDump(dump: string): Ref<Program> {
    const st = new StrTab { bytes: listNew(), starts: listNew() };
    listPush(st.starts, 0);
    const prog = new Program {
        tys: listNew(), decls: listNew(), funcs: listNew(), modules: listNew(),
        tests: listNew(), externs: listNew(), sigs: listNew(), st: st, entry: -2,
    };
    const r = pdOpen(dump);
    const head = pdNext(r);
    if (head != "PROGDUMP v2") { return prog; }
    let fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "entry") { return prog; }
    prog.entry = pdInt(fields, 1);

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "tys") { return prog; }
    let n = pdInt(fields, 1);
    let i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        listPush(prog.tys, new Ty { kind: pdInt(f, 1), a: pdInt(f, 2), b: pdInt(f, 3) });
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "decls") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        let which = 2;
        if (pdF(f, 3) == "struct") { which = 1; }
        const d = new TypeDecl { module: pdInt(f, 1), name: pdInt(f, 2), which: which, fields: listNew(), variants: listNew() };
        if (d.which == 1) {
            const nf = pdInt(f, 4);
            let j = 0;
            while (j < nf) {
                const ff = pdFields(pdNext(r));
                listPush(d.fields, new FieldDecl { name: pdInt(ff, 1), ty: pdInt(ff, 2) });
                j = j + 1;
            }
        } else {
            const nv = pdInt(f, 4);
            let j = 0;
            while (j < nv) {
                const vf = pdFields(pdNext(r));
                const v = new VariantDecl { name: pdInt(vf, 1), fields: listNew() };
                const nff = pdInt(vf, 2);
                let k = 0;
                while (k < nff) {
                    const ff = pdFields(pdNext(r));
                    listPush(v.fields, new FieldDecl { name: pdInt(ff, 1), ty: pdInt(ff, 2) });
                    k = k + 1;
                }
                listPush(d.variants, v);
                j = j + 1;
            }
        }
        listPush(prog.decls, d);
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "funcs") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        const fny = new Fn {
            name: pdInt(f, 1), module: pdInt(f, 2), reg: pdInt(f, 3), nparams: pdInt(f, 4),
            code: listNew(), consts: listNew(), lines: listNew(), ptys: listNew(), ret: pdInt(f, 9), landings: listNew(),
        };
        const ncode = pdInt(f, 5);
        const nconst = pdInt(f, 6);
        const nline = pdInt(f, 7);
        const npty = pdInt(f, 8);
        let j = 0;
        while (j < ncode) {
            listPush(fny.code, pdIntAt(pdNext(r), 1));
            j = j + 1;
        }
        j = 0;
        while (j < nconst) {
            const cf = pdFields(pdNext(r));
            const tag = pdInt(cf, 1);
            const c = new Const { tag: tag, i: 0, fbits: 0, vi: 0, vlen: 0, tbl: listNew() };
            if (tag == 1 || tag == 3 || tag == 4 || tag == 6) {
                c.i = pdInt(cf, 2);
            } else if (tag == 2) {
                c.fbits = pdInt(cf, 2);
            } else if (tag == 5) {
                const nt = pdInt(cf, 2);
                c.vlen = nt;
                let k = 0;
                while (k < nt) {
                    listPush(c.tbl, pdIntAt(pdNext(r), 1));
                    k = k + 1;
                }
            } else if (tag == 7) {
                c.i = pdInt(cf, 2);
                c.vi = pdInt(cf, 3);
            } else if (tag == 8) {
                c.i = pdInt(cf, 2);
                c.vlen = pdInt(cf, 3);
            } else if (tag == 9) {
                c.i = pdInt(cf, 2);
            }
            listPush(fny.consts, c);
            j = j + 1;
        }
        j = 0;
        while (j < nline) {
            const lf = pdNext(r);
            listPush(fny.lines, new LineCol { line: pdIntAt(lf, 1), col: pdIntAt(lf, 2) });
            j = j + 1;
        }
        j = 0;
        while (j < npty) {
            listPush(fny.ptys, pdIntAt(pdNext(r), 1));
            j = j + 1;
        }
        listPush(prog.funcs, fny);
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "modules") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        listPush(prog.modules, new ModuleInfo { path: pdInt(f, 1), state_ty: pdInt(f, 2), init_fn: pdInt(f, 3) });
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "tests") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        listPush(prog.tests, new TestEntry { name: pdInt(f, 1), func: pdInt(f, 2) });
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "externs") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        const e = new ExternDecl { name: listNew(), tags: listNew(), ret: 0 };
        hexDecodeTo(pdF(f, 1), e.name);
        const nparams = pdInt(f, 2);
        let k = 0;
        while (k < nparams) {
            listPush(e.tags, pdInt(f, 3 + k));
            k = k + 1;
        }
        e.ret = pdInt(f, 3 + nparams);
        listPush(prog.externs, e);
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "sigs") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const f = pdFields(pdNext(r));
        const sg = new FnSigDesc { ret: pdInt(f, 1), params: listNew() };
        const np = pdInt(f, 2);
        let k = 0;
        while (k < np) {
            listPush(sg.params, pdInt(f, 3 + k));
            k = k + 1;
        }
        listPush(prog.sigs, sg);
        i = i + 1;
    }

    fields = pdFields(pdNext(r));
    if (pdF(fields, 0) != "strtab") { return prog; }
    n = pdInt(fields, 1);
    i = 0;
    while (i < n) {
        const line = pdNext(r);
        const ff = pdFields(line);
        if (pdF(ff, 0) != "h") { return prog; }
        let hexPart = "";
        if (len(line) >= 3) { hexPart = strSub(line, 2, len(line) - 2); }
        const tmp: List<int> = listNew();
        if (hexDecodeTo(hexPart, tmp) < 0) { return prog; }
        let bi = 0;
        while (bi < listLen(tmp)) {
            listPush(prog.st.bytes, listGet(tmp, bi) catch 0);
            bi = bi + 1;
        }
        listPush(prog.st.starts, listLen(prog.st.bytes));
        i = i + 1;
    }
    return prog;
}

// ============================================================================
// §2 槽位类型不动点（analysis.computeSlotTypes 同构——ptsig on / rtsig off）
// ============================================================================

function emptyIntList(): List<int> {
    return listNew();
}

function emptyStateList(): List<List<int>> {
    return listNew();
}

function mergeSlotState(dst: List<int>, src: List<int>): bool {
    let changed = false;
    let i = 0;
    while (i < listLen(dst)) {
        const s = listGet(src, i) catch SLOT_BOTTOM;
        if (s == SLOT_BOTTOM) {
            i = i + 1;
            continue;
        }
        const d = listGet(dst, i) catch SLOT_BOTTOM;
        if (d == SLOT_BOTTOM) {
            listSet(dst, i, s);
            changed = true;
        } else if (d != s) {
            if (d != 0) {
                listSet(dst, i, 0);
                changed = true;
            }
        }
        i = i + 1;
    }
    return changed;
}

function staticCalleeRetTy(prog: Ref<Program>, f: Ref<Fn>, callPc: int, aSlot: int): int {
    // rtsig 缺省关——本件按缺省面恒返回 -1（播种/计数面不参与）。
    return -1;
}

// computeSlotTypes：返回 ins_states（List<List<int>>——外层 n、内层 rc）。
// 失败（空函数）＝返回空外层（调用面按零 states 走通用形）。
// 求解图与发射IR分立：ret/tailcall/reterr无后继，switch保留fallthrough。
function analysisBlocks(f: Ref<Fn>): List<Ref<BlockTx>> {
    const n = listLen(f.code);
    const blocks: List<Ref<BlockTx>> = listNew();
    if (n == 0) { return blocks; }
    const leaders: List<int> = listNew();
    const owners: List<int> = listNew();
    let pc = 0;
    while (pc < n) { listPush(leaders, 0); listPush(owners, 0); pc = pc + 1; }
    listSet(leaders, 0, 1);
    pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(pc, ins);
            if (t >= 0 && t < n) { listSet(leaders, t, 1); }
        }
        if (op == 35) {
            const ct = listGet(f.consts, insBx(ins)) catch dummyConst();
            if (ct.tag == 5) {
                let i = 0;
                while (i < listLen(ct.tbl)) {
                    const t = listGet(ct.tbl, i) catch -1;
                    if (t >= 0 && t < n) { listSet(leaders, t, 1); }
                    i = i + 1;
                }
            }
        }
        if (op == 15 || op == 16 || op == 17 || op == 35 || op == 32 || op == 33 || op == 34) {
            if (pc + 1 < n) { listSet(leaders, pc + 1, 1); }
        }
        pc = pc + 1;
    }
    let start = 0;
    pc = 1;
    while (pc <= n) {
        if (pc == n || (listGet(leaders, pc) catch 0) == 1) {
            const bi = listLen(blocks);
            listPush(blocks, new BlockTx { start: start, end: pc - 1, succs: listNew() });
            let q = start;
            while (q < pc) { listSet(owners, q, bi); q = q + 1; }
            start = pc;
        }
        pc = pc + 1;
    }
    let bi = 0;
    while (bi < listLen(blocks)) {
        const b = listGet(blocks, bi) catch dummyBlock();
        const ins = listGet(f.code, b.end) catch 0;
        const op = insOp(ins);
        if (!(op == 15 || op == 32 || op == 33 || op == 34) && b.end + 1 < n) {
            listPush(b.succs, listGet(owners, b.end + 1) catch 0);
        }
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(b.end, ins);
            if (t >= 0 && t < n) { listPush(b.succs, listGet(owners, t) catch 0); }
        }
        if (op == 35) {
            const ct = listGet(f.consts, insBx(ins)) catch dummyConst();
            if (ct.tag == 5) {
                let i = 0;
                while (i < listLen(ct.tbl)) {
                    const t = listGet(ct.tbl, i) catch -1;
                    if (t >= 0 && t < n) { listPush(b.succs, listGet(owners, t) catch 0); }
                    i = i + 1;
                }
            }
        }
        bi = bi + 1;
    }
    return blocks;
}

function copyAnalysisRow(row: List<int>): List<int> {
    const out: List<int> = listNew();
    let r = 0;
    while (r < listLen(row)) { listPush(out, listGet(row, r) catch 0); r = r + 1; }
    return out;
}

// Incremental broadcast: exact changed slots, preserving full first contribution.
function analysisDeltaSlots(previous: List<int>, current: List<int>, previousMay: List<int>, currentMay: List<int>, first: bool, withMay: bool): List<int> {
    const slots: List<int> = listNew();
    let start = 0;
    while (start < listLen(current)) {
        let bits = 0; let offset = 0;
        while (offset < 64 && start + offset < listLen(current)) {
            const r = start + offset;
            const value = listGet(current, r) catch 0;
            let changed = first || (listGet(previous, r) catch 0) != value;
            if (withMay && (listGet(previousMay, r) catch 0) != (listGet(currentMay, r) catch 0)) { changed = true; }
            if (changed) {
                bits = bits | (1 << offset);
                listSet(previous, r, value);
                if (withMay) { listSet(previousMay, r, listGet(currentMay, r) catch 0); }
            }
            offset = offset + 1;
        }
        while (bits != 0) {
            listPush(slots, start + ctzTx(bits));
            if (bits == -9223372036854775807 - 1) { bits = 0; }
            else { bits = bits & (bits - 1); }
        }
        start = start + 64;
    }
    return slots;
}

function mergeSlotDelta(dst: List<int>, src: List<int>, changedSlots: List<int>): bool {
    let changed = false; let i = 0;
    while (i < listLen(changedSlots)) {
        const r = listGet(changedSlots, i) catch 0;
        const value = listGet(src, r) catch SLOT_BOTTOM;
        if (value != SLOT_BOTTOM) {
            const before = listGet(dst, r) catch SLOT_BOTTOM;
            if (before == SLOT_BOTTOM) { listSet(dst, r, value); changed = true; }
            else if (before != value && before != 0) {
                if (noHeapRef(before) && noHeapRef(value)) {
                    if (before != SLOT_NOHEAP) { listSet(dst, r, SLOT_NOHEAP); changed = true; }
                } else { listSet(dst, r, 0); changed = true; }
            }
        }
        i = i + 1;
    }
    return changed;
}

struct SlotFlow {
    prog: Ref<Program>, fn: Ref<Fn>, blocks: List<Ref<BlockTx>>,
    entries: List<List<int>>, reached: List<int>, owners: List<int>, delta: List<int>,
    cachedPc: int, cachedBlock: int, cachedRow: List<int>
}

function emptySlotFlow(prog: Ref<Program>, f: Ref<Fn>): Ref<SlotFlow> {
    return new SlotFlow { prog: prog, fn: f, blocks: listNew(), entries: listNew(),
        reached: listNew(), owners: listNew(), delta: listNew(), cachedPc: -1,
        cachedBlock: -1, cachedRow: listNew() };
}

function slotFlowLen(flow: Ref<SlotFlow>): int {
    if (listLen(flow.entries) == 0) { return 0; }
    return listLen(flow.fn.code);
}

// Borrowed scratch is valid until another PC query. Persistent consumers copy facts.
function slotRowAt(flow: Ref<SlotFlow>, pc: int): List<int> {
    if (pc < 0 || pc >= slotFlowLen(flow)) { return emptyIntList(); }
    if (flow.cachedPc == pc) { return flow.cachedRow; }
    const bi = listGet(flow.owners, pc) catch -1;
    const blk = listGet(flow.blocks, bi) catch dummyBlock();
    if (flow.cachedBlock != bi || flow.cachedPc > pc || flow.cachedPc < blk.start) {
        const input = listGet(flow.entries, bi) catch emptyIntList();
        const row: List<int> = listNew(); let r = 0;
        while (r < flow.fn.reg) {
            let value = listGet(input, r) catch 0;
            if (value == SLOT_BOTTOM) { value = 0; }
            listPush(row, value); r = r + 1;
        }
        flow.cachedRow = row; flow.cachedPc = blk.start; flow.cachedBlock = bi;
    }
    if ((listGet(flow.reached, bi) catch 0) == 1) {
        let q = flow.cachedPc;
        while (q < pc) {
            const change = listGet(flow.delta, q) catch -1;
            if (change >= 0) {
                const a = change & 65535;
                if ((change & 8589934592) != 0) {
                    applyTransfer(flow.prog, flow.fn, listGet(flow.fn.code, q) catch 0, flow.cachedRow);
                } else if ((change & 4294967296) != 0) {
                    let r = a;
                    while (r < flow.fn.reg) { listSet(flow.cachedRow, r, 0); r = r + 1; }
                } else if (a < flow.fn.reg) { listSet(flow.cachedRow, a, (change >>> 16) & 255); }
            }
            q = q + 1;
        }
    }
    flow.cachedPc = pc;
    return flow.cachedRow;
}

function computeSlotTypes(prog: Ref<Program>, f: Ref<Fn>): Ref<SlotFlow> {
    const n = listLen(f.code);
    const rc = f.reg;
    const flow = emptySlotFlow(prog, f);
    if (n == 0 || rc == 0) { return flow; }
    const blocks = analysisBlocks(f);
    const entries: List<List<int>> = listNew();
    const outputs: List<List<int>> = listNew();
    const broadcast: List<int> = listNew();
    const noMay: List<int> = listNew();
    const queued: List<int> = listNew();
    const reached: List<int> = listNew();
    const orow: List<int> = listNew();
    let r = 0;
    while (r < rc) { listPush(orow, 0); r = r + 1; }
    let bi = 0;
    while (bi < listLen(blocks)) {
        const row: List<int> = listNew();
        r = 0;
        while (r < rc) { listPush(row, SLOT_BOTTOM); r = r + 1; }
        listPush(entries, row); listPush(outputs, copyAnalysisRow(row)); listPush(broadcast, 0);
        listPush(queued, 0); listPush(reached, 0);
        bi = bi + 1;
    }
    // 入口态：R0＝ref；实参区 unknown；局部区 none；ptsig 播种。
    const row0 = listGet(entries, 0) catch emptyIntList();
    if (rc > 0) {
        listSet(row0, 0, TAG_REF);
        let np = f.nparams;
        if (np > rc - 1) { np = rc - 1; }
        let r = 1;
        while (r < rc) {
            if (r <= np) {
                listSet(row0, r, 0);
            } else {
                listSet(row0, r, TAG_NONE);
            }
            r = r + 1;
        }
        const ntys = listLen(f.ptys);
        if (ntys > 0) {
            const npTy = ntys;
            if (npTy > np) {}
            let pi = 0;
            while (pi < npTy && pi < np) {
                const ti = listGet(f.ptys, pi) catch -1;
                if (ti >= 0 && ti < listLen(prog.tys)) {
                    const t = runtimeTagOfKind((listGet(prog.tys, ti) catch dummyTy()).kind);
                    if (t >= 0) {
                        listSet(row0, pi + 1, t);
                    }
                }
                pi = pi + 1;
            }
        }
    }
    const work: List<int> = listNew();
    listPush(work, 0); listSet(queued, 0, 1); listSet(reached, 0, 1);
    while (listLen(work) > 0) {
        const cur = listGet(work, listLen(work) - 1) catch 0;
        listRemoveAt(work, listLen(work) - 1); listSet(queued, cur, 0);
        const blk = listGet(blocks, cur) catch dummyBlock();
        const input = listGet(entries, cur) catch emptyIntList();
        r = 0;
        while (r < rc) { listSet(orow, r, listGet(input, r) catch 0); r = r + 1; }
        let pc = blk.start;
        while (pc <= blk.end) { applyTransfer(prog, f, listGet(f.code, pc) catch 0, orow); pc = pc + 1; }
        const delta = analysisDeltaSlots(listGet(outputs, cur) catch emptyIntList(), orow, noMay, noMay, (listGet(broadcast, cur) catch 0) == 0, false);
        listSet(broadcast, cur, 1);
        let si = 0;
        while (si < listLen(blk.succs)) {
            const target = listGet(blk.succs, si) catch 0;
            if (mergeSlotDelta(listGet(entries, target) catch emptyIntList(), orow, delta)) {
                listSet(reached, target, 1);
                if ((listGet(queued, target) catch 0) == 0) {
                    listPush(work, target); listSet(queued, target, 1);
                }
            }
            si = si + 1;
        }
    }
    // Retain block entries and exact per-PC transfer deltas, never input matrices.
    flow.blocks = blocks; flow.entries = entries; flow.reached = reached;
    bi = 0;
    while (bi < listLen(blocks)) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        const input = listGet(entries, bi) catch emptyIntList();
        r = 0;
        while (r < rc) {
            let value = listGet(input, r) catch 0;
            if (value == SLOT_BOTTOM) { value = 0; }
            listSet(orow, r, value); r = r + 1;
        }
        let pc = blk.start;
        while (pc <= blk.end) {
            listPush(flow.owners, bi); let change = -1;
            if ((listGet(reached, bi) catch 0) == 1) {
                const ins = listGet(f.code, pc) catch 0;
                const op = insOp(ins); const a = insA(ins);
                if (op == 30) {
                    applyTransfer(prog, f, ins, orow);
                    change = 8589934592 | a; // 直接调用（标志第 33 位）：重放时照 applyTransfer
                } else if (op == 32 || op == 38 || op == 48) {
                    applyTransfer(prog, f, ins, orow);
                    change = 4294967296 | a; // 寄存器号 16 位，标志第 32 位（C3b）
                } else {
                    const tag = transferDestTag(f, ins, orow);
                    if (tag != -2 && a < rc) {
                        assert(tag >= 0 && tag < 256, "slot transfer tag outside frozen byte domain");
                        setArrTag(orow, a, tag); change = (tag << 16) | a;
                    }
                }
            }
            listPush(flow.delta, change); pc = pc + 1;
        }
        bi = bi + 1;
    }
    return flow;
}

function runtimeTagOfKind(k: int): int {
    if (k == 1) { return TAG_INT; }
    if (k == 2) { return TAG_FLOAT; }
    if (k == 3) { return TAG_BOOL; }
    if (k == 4) { return TAG_STR; }
    if (k == 6) { return TAG_ERR; }
    if (k == 9) { return TAG_REF; }
    if (k == 10) { return TAG_ARR; }
    if (k == 11) { return TAG_SLICE; }
    if (k == 12) { return TAG_STRUCTV; }
    if (k == 13) { return TAG_ENUMV; }
    if (k == 14) { return TAG_WEAKBOX; }
    if (k == 15) { return TAG_LIST; }
    if (k == 17) { return TAG_FUTURE; }
    if (k == 18) { return TAG_BYTES; }
    if (k == 19) { return TAG_GEN; }
    if (k == 20) { return TAG_THREAD; }
    if (k == 21) { return TAG_SHARED; }
    if (k == 22) { return TAG_ATOMIC; }
    return -1;
}

function jumpTargetTx(pc: int, ins: int): int {
    const t = pc + 1 + insSbx(ins);
    if (t < 0) { return -1; }
    return t;
}

function isHeapRefTag(t: int): bool {
    if (t == TAG_ERR) { return true; }
    if (t == TAG_STR) { return true; }
    if (t == TAG_STRUCTV) { return true; }
    if (t == TAG_ENUMV) { return true; }
    if (t == TAG_REF) { return true; }
    if (t == TAG_ARR) { return true; }
    if (t == TAG_SLICE) { return true; }
    if (t == TAG_WEAKBOX) { return true; }
    if (t == TAG_LIST) { return true; }
    if (t == TAG_FUTURE) { return true; }
    if (t == TAG_BYTES) { return true; }
    if (t == TAG_GEN) { return true; }
    if (t == TAG_THREAD) { return true; }
    if (t == TAG_SHARED) { return true; }
    if (t == TAG_ATOMIC) { return true; }
    return false;
}

function noHeapRef(t: int): bool {
    return t != 0 && !isHeapRefTag(t);
}

// stateAt：BOTTOM 归一读（tagAt 同构——行内槽读取统一入口）。
function typeRowSlots(row: List<int>): int {
    if ((listGet(row, 0) catch 0) == -2) { return listGet(row, 1) catch 0; }
    return listLen(row);
}

function stateAt(row: List<int>, r: int): int {
    const value = slotStateRaw(row, r);
    if (value == SLOT_NOHEAP) { return 0; }
    return value;
}

// 含 NOHEAP 的原始读（只供 norelAt）。
function slotStateRaw(row: List<int>, r: int): int {
    if (r < 0 || r >= typeRowSlots(row)) { return 0; }
    let value = 0;
    if ((listGet(row, 0) catch 0) == -2) {
        let i = 2; let found = false;
        while (i + 1 < listLen(row)) {
            if ((listGet(row, i) catch -1) == r) { value = listGet(row, i + 1) catch 0; found = true; break; }
            i = i + 2;
        }
        assert(found, "slot snapshot missing consumer fact");
    } else { value = listGet(row, r) catch 0; }
    if (value == SLOT_BOTTOM) { return 0; }
    return value;
}

function setArrTag(arr: List<int>, r: int, t: int): void {
    if (r >= 0 && r < listLen(arr)) { listSet(arr, r, t); }
}

// applyTransfer（analysis.zig 同构——写槽 transfer 全臂）。
// 单槽查询与完整transfer共享判定，不为IR节点物化整条输出状态行。
function transferInputTag(f: Ref<Fn>, arr: List<int>, r: int): int {
    if (r < 0 || r >= f.reg) { return 0; }
    return stateAt(arr, r);
}

function transferSlotTag(prog: Ref<Program>, f: Ref<Fn>, ins: int, arr: List<int>, r: int): int {
    if (r < 0 || r >= f.reg) { return 0; }
    const a = insA(ins);
    const op = insOp(ins);
    if (op == 30 || op == 32 || op == 38 || op == 48) {
        if (r >= a) { return 0; }
    } else if (r == a) {
        const t = transferDestTag(f, ins, arr);
        if (t != -2) { return t; }
    }
    return stateAt(arr, r);
}

function applyTransfer(prog: Ref<Program>, f: Ref<Fn>, ins: int, arr: List<int>): void {
    const op = insOp(ins);
    const a = insA(ins);
    if (op == 30) {
        // 直接调用返回后：结果槽与实参槽未知——借用约定的被调不放参数槽，调用方关闭借用（可挂起或保守发射）
        // 时没有调用后的借用清理，实参仍留在槽里，靠覆写时按标签释放。实参之后的槽在调用前经 dfree 释放清空
        // 或可证非堆，被调窗口、被调帧释放与更深的调用只往里填 None，所以确定非堆。
        const top = a + insB(ins);
        let r = a;
        while (r < listLen(arr)) {
            if (r < top) { listSet(arr, r, 0); } else { listSet(arr, r, SLOT_NOHEAP); }
            r = r + 1;
        }
    } else if (op == 32 || op == 38 || op == 48) {
        let r = a;
        while (r < listLen(arr)) { listSet(arr, r, 0); r = r + 1; }
    } else {
        const t = transferDestTag(f, ins, arr);
        if (t != -2) { setArrTag(arr, a, t); }
    }
}

function transferDestTag(f: Ref<Fn>, ins: int, arr: List<int>): int {
    const op = insOp(ins);
    const a = insA(ins);
    if (op == 1) { // loadk
        const bxi = insBx(ins);
        let t = 0;
        if (bxi < listLen(f.consts)) {
            const c = listGet(f.consts, bxi) catch dummyConst();
            if (c.tag == 1) { t = TAG_INT; }
            else if (c.tag == 2) { t = TAG_FLOAT; }
            else if (c.tag == 3) { t = TAG_STR; }
            else if (c.tag == 4) { t = TAG_FNV; }
            else { t = 0; }
        }
        return t;
    } else if (op == 2) { // ldbool
        return TAG_BOOL;
    } else if (op == 3) { // ldnone
        return TAG_NONE;
    } else if (op == 4) { // move
        return transferInputTag(f, arr, insB(ins));
    } else if (op >= 5 && op <= 10) { // add/sub/mul/div/mod/neg
        const tb = transferInputTag(f, arr, insB(ins));
        let t = 0;
        if (op == 10) {
            if (tb == TAG_INT || tb == TAG_FLOAT) { t = tb; } else { t = 0; }
        } else {
            const tc = transferInputTag(f, arr, insC(ins));
            if (op == 5) {
                if (tb == tc && (tb == TAG_INT || tb == TAG_FLOAT || tb == TAG_STR)) { t = tb; }
            } else if (op == 6 || op == 7 || op == 8) {
                if (tb == tc && (tb == TAG_INT || tb == TAG_FLOAT)) { t = tb; }
            } else if (op == 9) {
                if (tb == tc && tb == TAG_INT) { t = tb; }
            }
        }
        return t;
    } else if (op == 11) { // not
        return TAG_BOOL;
    } else if (op == 43) { // bnot
        if (transferInputTag(f, arr, insB(ins)) == TAG_INT) { return TAG_INT; } else { return 0; }
    } else if ((op >= 40 && op <= 42) || (op >= 44 && op <= 47)) { // band/bor/bxor/shl/shr/sar/imul
        const tb = transferInputTag(f, arr, insB(ins));
        const tc = transferInputTag(f, arr, insC(ins));
        if (tb == tc && tb == TAG_INT) { return TAG_INT; } else { return 0; }
    } else if (op == 12 || op == 13 || op == 14 || op == 18 || op == 19) { // lt/le/eq/iserr/isnone
        return TAG_BOOL;
    } else if (op == 36) { // i2f
        return TAG_FLOAT;
    } else if (op == 37) { // f2i
        return TAG_INT;
    } else if (op == 52) { // cvt（定宽数值转换）：种类 14..17 与 26（floatFromBits）得 float，其余得 int
        const ck = insC(ins);
        if ((ck >= 14 && ck <= 17) || ck == 26) { return TAG_FLOAT; }
        return TAG_INT;
    } else if (isFwOp(op)) { // 定宽数值运算族（O4 第二步）：f32 得 float，其余得 int
        if (fwOpType(op) == 10) { return TAG_FLOAT; }
        return TAG_INT;
    } else if (op == 25) { // newstruct
        return TAG_STRUCTV;
    } else if (op == 26) { // newenum
        return TAG_ENUMV;
    } else if (op == 27) { // newref
        return TAG_REF;
    } else if (op == 28) { // newarr
        return TAG_ARR;
    } else if (op == 29) { // newslice
        return TAG_SLICE;
    } else if (op == 20 || op == 22 || op == 24) { // getfld/getidx/clone
        return 0;
    } else if (op == 30 || op == 32) { // call/tailcall
        return 0;
    } else if (op == 31) { // callbi
        const id = insB(ins);
        if (id >= EXTERN_ID_BASE) {
            return 0;
        }
        if (id == 1 || id == 7 || id == 8 || id == 14 || id == 17 || id == 20 || id == 40 || id == 41 || id == 42 || id == 72 || id == 77 || id == 78 || id == 80 || isDbgBi(id)) {
            // print/assertf/panicf/list_push/list_set/task_cancel/bytes_set/bytes_push/bytes_append/紧凑 list_set/bytes_copy/bytes_fill/bytes_set_num/调试检查点：void 不写槽
        } else if (id == 18 || id == 4 || id == 24 || id == 73) {
            return TAG_INT; // list_len/len/now_ms
        } else if (id == 19 || id == 5) {
            return TAG_STR; // str_concat/to_str
        } else if (id == 21) {
            return TAG_BOOL; // task_cancelled
        } else if (id == 13 || id == 74) {
            return TAG_LIST; // list_new/bytes_as_list
        } else if (id == 37 || id == 43 || id == 45 || id == 75) {
            return TAG_BYTES; // bytes_new/bytes_slice/bytes_from_str/list_as_bytes
        } else if (id == 38) {
            return TAG_INT; // bytes_len
        } else if (id == 44) {
            return TAG_BOOL; // bytes_equal
        } else if (id == 9) {
            return TAG_WEAKBOX; // weak
        } else if (id == 2) {
            return TAG_ERR; // errf
        } else {
            return 0;
        }
    } else if (op == 39) { // await_fut
        return 0;
    } else if (op == 38) { // async_start
        return 0;
    } else if (op == 48 || op == 50) { // gen_new/gen_next（D3 v0.22）：取值结果为 T?，类型未知
        return 0;
    }
    // 其余 op（setfld/setidx/控制流/Tier1 特化）不写槽/不可达——保留旧 tag。
    return -2; // KEEP：不写槽，区别于BOTTOM与所有运行时tag。
}

// ============================================================================
// §3 IR 构建（ir.zig 同构：native 判定＋use/def＋块/活跃度/run 划分）
// ============================================================================

struct IrNode {
    ins: int,
    op: int,
    defInputTag: int, missingUseTag: int,
    outTag: int,
    uses: List<int>,
    nUses: int,
    def: int,
    defFrom: int,
    native: int,
    block: int,
}

function dummyNode(): Ref<IrNode> {
    return new IrNode { ins: 0, op: 0, defInputTag: 0, missingUseTag: 0, outTag: 0, uses: listNew(), nUses: 0, def: NO_SLOT, defFrom: NO_SLOT, native: 0, block: 0 };
}

struct RunTx {
    start: int,
    len: int,
    fused: int,
    fusedSlot: int,
}

struct BlockTx {
    start: int,
    end: int,
    succs: List<int>,
}

struct Ir {
    nodes: List<Ref<IrNode>>,
    runs: List<Ref<RunTx>>,
    runOfPc: List<int>,
    liveAfter: List<List<int>>,
    liveIn: List<List<int>>,
    reg: int,
    failed: int, // 0 ok／1 build 失败（BadJumpTarget 等）
}

// nativeKindOf（ir.zig :154-264 同构）。
function nativeKindOf(prog: Ref<Program>, f: Ref<Fn>, ins: int, inTags: List<int>, outTag: int): int {
    const op = insOp(ins);
    const a = insA(ins);
    const b = insB(ins);
    const c = insC(ins);
    if (op == 1) { // loadk
        const bxi = insBx(ins);
        if (bxi >= listLen(f.consts)) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        const ctag = (listGet(f.consts, bxi) catch dummyConst()).tag;
        if (ctag == 1) {
            if (outTag == TAG_INT) { return NK_LOADK_INT; }
            return NK_NONE;
        }
        if (ctag == 2) {
            if (outTag == TAG_FLOAT) { return NK_LOADK_FLOAT; }
            return NK_NONE;
        }
        return NK_NONE;
    }
    if (op == 2) { // ldbool
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag == TAG_BOOL) { return NK_LDBOOL; }
        return NK_NONE;
    }
    if (op == 3) { // ldnone
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag == TAG_NONE) { return NK_LDNONE; }
        return NK_NONE;
    }
    if (op == 4) { // move
        const tb = stateAt(inTags, b);
        if (!noHeapRef(tb)) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag == tb) { return NK_MOVE; }
        return NK_NONE;
    }
    if (op == 5 || op == 6 || op == 7) { // add/sub/mul
        const tb = stateAt(inTags, b);
        if (tb == 0 || tb != stateAt(inTags, c)) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag != tb) { return NK_NONE; }
        if (tb == TAG_INT) {
            if (op == 5) { return NK_ADD_I; }
            if (op == 6) { return NK_SUB_I; }
            return NK_MUL_I;
        }
        if (tb == TAG_FLOAT) {
            if (op == 5) { return NK_ADD_F; }
            if (op == 6) { return NK_SUB_F; }
            return NK_MUL_F;
        }
        return NK_NONE;
    }
    if (op == 8 || op == 9) { // div/mod
        const tb = stateAt(inTags, b);
        if (tb != TAG_INT || tb != stateAt(inTags, c)) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag != TAG_INT) { return NK_NONE; }
        if (op == 8) { return NK_DIV_I; }
        return NK_MOD_I;
    }
    if (op == 10) { // neg
        const tb = stateAt(inTags, b);
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag != tb) { return NK_NONE; }
        if (tb == TAG_INT) { return NK_NEG_I; }
        if (tb == TAG_FLOAT) { return NK_NEG_F; }
        return NK_NONE;
    }
    if (op == 11) { // not
        if (stateAt(inTags, b) != TAG_BOOL) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag == TAG_BOOL) { return NK_NOT_B; }
        return NK_NONE;
    }
    if (op == 13 || op == 14 || op == 12) { // lt/le/eq
        const tb = stateAt(inTags, b);
        if (tb == 0 || tb != stateAt(inTags, c)) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag != TAG_BOOL) { return NK_NONE; }
        if (tb == TAG_INT) {
            if (op == 13) { return NK_LT_I; }
            if (op == 14) { return NK_LE_I; }
            return NK_EQ_I;
        }
        if (tb == TAG_FLOAT) {
            if (op == 13) { return NK_LT_F; }
            if (op == 14) { return NK_LE_F; }
            return NK_EQ_F;
        }
        if (tb == TAG_BOOL) {
            if (op == 12) { return NK_EQ_B; }
        }
        return NK_NONE;
    }
    if (op == 17 || op == 16) { // jf/jt
        if (stateAt(inTags, a) != TAG_BOOL) { return NK_NONE; }
        if (op == 17) { return NK_JF_B; }
        return NK_JT_B;
    }
    if (op == 36) { // i2f
        if (stateAt(inTags, b) != TAG_INT) { return NK_NONE; }
        if (!noHeapRef(stateAt(inTags, a))) { return NK_NONE; }
        if (outTag != TAG_FLOAT) { return NK_NONE; }
        return NK_I2F_F;
    }
    return NK_NONE;
}

function writesDestBuiltin(bi: int): int {
    if (bi == 1 || bi == 14 || bi == 17 || bi == 26 || bi == 27 || bi == 20 || bi == 7 || bi == 8 || bi == 40 || bi == 41 || bi == 42 || bi == 72) { return 0; }
    if (isDbgBi(bi)) { return 0; } // 调试检查点（第 6 轮 6c）
    return 1;
}

// computeUseDef（ir.zig :275-343 同构）。
function computeUseDef(f: Ref<Fn>, ins: int, node: Ref<IrNode>): void {
    const op = insOp(ins);
    const a = insA(ins);
    const b = insB(ins);
    const c = insC(ins);
    if (op == 1 || op == 2 || op == 3) {
        node.def = a;
    } else if (op == 4 || op == 10 || op == 11 || op == 43 || op == 18 || op == 19 || op == 36 || op == 37 || op == 52 || op == 20 || op == 24) {
        listPush(node.uses, b);
        node.nUses = 1;
        node.def = a;
    } else if ((op >= 5 && op <= 9) || (op >= 12 && op <= 14) || op == 22 || (op >= 40 && op <= 42) || (op >= 44 && op <= 47) || isFwOp(op)) {
        listPush(node.uses, b);
        listPush(node.uses, c);
        node.nUses = 2;
        node.def = a;
    } else if (op == 16 || op == 17 || op == 33 || op == 34 || op == 35) {
        listPush(node.uses, a);
        node.nUses = 1;
    } else if (op == 21) { // setfld
        listPush(node.uses, b);
        listPush(node.uses, a);
        node.nUses = 2;
    } else if (op == 23) { // setidx
        listPush(node.uses, b);
        listPush(node.uses, c);
        listPush(node.uses, a);
        node.nUses = 3;
    } else if (op == 31) { // callbi
        const id = insB(ins);
        fillCallArgs(a, c, node);
        if (id < EXTERN_ID_BASE) {
            if (writesDestBuiltin(id) == 1) { node.def = a; }
        } else {
            node.def = a;
        }
    } else if (op == 30 || op == 32) { // call/tailcall
        fillCallArgs(a, b, node);
        node.defFrom = a;
    } else if (op == 38) { // async_start：被调值在 R[A]，实参在 A+1..A+B-1（B＝实参数+1）
        fillCallArgs(a, b - 1, node);
        node.defFrom = a;
    } else if (op == 39) { // await_fut：R[A] = await R[A]
        listPush(node.uses, a);
        node.nUses = 1;
        node.def = a;
    } else if (op == 48) { // gen_new（D3 v0.22）：同 async_start——被调值在 R[A]，实参在 A+1..A+B-1
        fillCallArgs(a, b - 1, node);
        node.defFrom = a;
    } else if (op == 49 || op == 51) { // yield/gen_close：读 R[A]，不写槽
        listPush(node.uses, a);
        node.nUses = 1;
    } else if (op == 50) { // gen_next：R[A] = genNext(R[B])
        listPush(node.uses, b);
        node.nUses = 1;
        node.def = a;
    } else {
        listPush(node.uses, a);
        listPush(node.uses, b);
        listPush(node.uses, c);
        node.nUses = 3;
    }
}

function fillCallArgs(a: int, nargs: int, node: Ref<IrNode>): void {
    let i = 1;
    while (i <= nargs && (i - 1) < 3) {
        listPush(node.uses, a + i);
        node.nUses = i;
        i = i + 1;
    }
}

// 调用类指令（callbi、call、tailcall、async_start、gen_new）在 node.uses 之外读的槽：node.uses 只放前 3 个实参
// （fillCallArgs），被调值 R[A] 与全部实参在这里给出。逐 pc 的 usesInto 与块级 gen 共用这一份——两份列表曾经分叉，
// 块级漏了 async_start（op38）：被调值与第 4 个起的实参不进块的活跃集合，前一块的寄存器段在段末不写回它们，
// async_start 读到槽里的旧值（实参经 &&、??、catch 跨块求值时可见）。
function callExtraUses(node: Ref<IrNode>, rc: int): List<int> {
    const out: List<int> = listNew();
    const op = node.op;
    if (op != 31 && op != 30 && op != 32 && op != 38 && op != 48) { return out; }
    const a = insA(node.ins);
    if (op != 31 && a < rc) { listPush(out, a); }
    let nargs = insB(node.ins);
    if (op == 31) { nargs = insC(node.ins); }
    if (op == 38 || op == 48) { nargs = insB(node.ins) - 1; }
    let i = 1;
    while (i <= nargs) {
        const s = a + i;
        if (s < rc) { listPush(out, s); }
        i = i + 1;
    }
    return out;
}

// usesInto（ir.zig :363-381 同构）——mask 写全量 use 槽。
function usesInto(node: Ref<IrNode>, rc: int, mask: List<int>): void {
    let ui = 0;
    while (ui < node.nUses) {
        const s = listGet(node.uses, ui) catch NO_SLOT;
        if (s != NO_SLOT && s < rc) { listSet(mask, s, 1); }
        ui = ui + 1;
    }
    for (s in callExtraUses(node, rc)) { listSet(mask, s, 1); }
}

// Uses prefix is immutable after computeUseDef; tail owns corresponding facts.
function retainNodeTags(node: Ref<IrNode>, row: List<int>, rc: int): void {
    assert(listLen(node.uses) == node.nUses, "IR use prefix changed before retaining facts");
    let i = 0;
    while (i < node.nUses) {
        const slot = listGet(node.uses, i) catch NO_SLOT;
        listPush(node.uses, stateAt(row, slot)); i = i + 1;
    }
    node.defInputTag = stateAt(row, node.def);
    node.missingUseTag = stateAt(row, NO_SLOT);
}

function nodeUseTag(node: Ref<IrNode>, index: int): int {
    if (index < 0 || index >= node.nUses) { return node.missingUseTag; }
    assert(listLen(node.uses) == node.nUses * 2, "slot snapshot missing consumer fact");
    return listGet(node.uses, node.nUses + index) catch 0;
}

// buildFnIr（ir.zig :384-730 同构）。
function buildFnIr(prog: Ref<Program>, f: Ref<Fn>, states: Ref<SlotFlow>): Ref<Ir> {
    const n = listLen(f.code);
    const rc = f.reg;
    const ir = new Ir { nodes: listNew(), runs: listNew(), runOfPc: listNew(), liveAfter: listNew(), liveIn: listNew(), reg: rc, failed: 0 };
    if (n == 0) {
        ir.failed = 1;
        return ir;
    }
    // 节点构建。
    let pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const inTags = slotRowAt(states, pc);
        const outTag = transferSlotTag(prog, f, ins, inTags, insA(ins));
        const node = new IrNode { ins: ins, op: insOp(ins), defInputTag: 0, missingUseTag: 0, outTag: 0, uses: listNew(), nUses: 0, def: NO_SLOT, defFrom: NO_SLOT, native: NK_NONE, block: 0 };
        computeUseDef(f, ins, node);
        node.outTag = transferSlotTag(prog, f, ins, inTags, node.def);
        node.native = nativeKindOf(prog, f, ins, inTags, outTag);
        retainNodeTags(node, inTags, rc);
        listPush(ir.nodes, node);
        pc = pc + 1;
    }
    // 块划分。
    const isLeader: List<int> = listNew();
    pc = 0;
    while (pc < n) {
        listPush(isLeader, 0);
        pc = pc + 1;
    }
    listSet(isLeader, 0, 1);
    pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(pc, ins);
            if (t >= 0 && t < n) { listSet(isLeader, t, 1); }
            if (op != 15 && pc + 1 < n) { listSet(isLeader, pc + 1, 1); }
        } else if (op == 35) {
            const bxi = insBx(ins);
            if (bxi < listLen(f.consts)) {
                const ct = listGet(f.consts, bxi) catch dummyConst();
                if (ct.tag == 5) {
                    let k = 0;
                    while (k < listLen(ct.tbl)) {
                        const t = listGet(ct.tbl, k) catch -1;
                        if (t >= 0 && t < n) { listSet(isLeader, t, 1); }
                        k = k + 1;
                    }
                }
            }
            if (pc + 1 < n) { listSet(isLeader, pc + 1, 1); }
        }
        pc = pc + 1;
    }
    const blocks: List<Ref<BlockTx>> = listNew();
    let start = 0;
    pc = 0;
    while (pc < n) {
        const op = insOp(listGet(f.code, pc) catch 0);
        const terminal = (op == 15 || op == 16 || op == 17 || op == 33 || op == 34 || op == 32 || op == 35);
        if (terminal || pc + 1 == n) {
            listPush(blocks, new BlockTx { start: start, end: pc, succs: listNew() });
            if (pc + 1 < n) { start = pc + 1; } else { break; }
        } else if ((listGet(isLeader, pc + 1) catch 0) == 1) {
            listPush(blocks, new BlockTx { start: start, end: pc, succs: listNew() });
            start = pc + 1;
        }
        pc = pc + 1;
    }
    const blockOfPc: List<int> = listNew();
    pc = 0;
    while (pc < n) {
        listPush(blockOfPc, 0);
        pc = pc + 1;
    }
    let bi = 0;
    while (bi < listLen(blocks)) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        let p = blk.start;
        while (p <= blk.end) {
            listSet(blockOfPc, p, bi);
            const ndPc = listGet(ir.nodes, p) catch dummyNode();
            ndPc.block = bi;
            p = p + 1;
        }
        bi = bi + 1;
    }
    // 后继边。
    bi = 0;
    while (bi < listLen(blocks)) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        const tail = listGet(f.code, blk.end) catch 0;
        const top = insOp(tail);
        if (top == 15) {
            const t = jumpTargetTx(blk.end, tail);
            if (t >= 0 && t < n) { listPush(blk.succs, listGet(blockOfPc, t) catch 0); }
        } else if (top == 16 || top == 17) {
            const t = jumpTargetTx(blk.end, tail);
            if (t >= 0 && t < n) { listPush(blk.succs, listGet(blockOfPc, t) catch 0); }
            if (blk.end + 1 < n) { listPush(blk.succs, listGet(blockOfPc, blk.end + 1) catch 0); }
        } else if (top == 35) {
            const bxi = insBx(tail);
            if (bxi < listLen(f.consts)) {
                const ct = listGet(f.consts, bxi) catch dummyConst();
                if (ct.tag == 5) {
                    let k = 0;
                    while (k < listLen(ct.tbl)) {
                        const t = listGet(ct.tbl, k) catch -1;
                        if (t >= 0 && t < n) { listPush(blk.succs, listGet(blockOfPc, t) catch 0); }
                        k = k + 1;
                    }
                }
            }
            if (blk.end + 1 < n) { listPush(blk.succs, listGet(blockOfPc, blk.end + 1) catch 0); }
        } else {
            if (blk.end + 1 < n) { listPush(blk.succs, listGet(blockOfPc, blk.end + 1) catch 0); }
        }
        bi = bi + 1;
    }
    // 块级活跃度。
    const nb = listLen(blocks);
    let zero = 0;
    bi = 0;
    while (bi < nb) {
        const li: List<int> = listNew();
        const lo: List<int> = listNew();
        let r = 0;
        while (r < rc) { listPush(li, 0); listPush(lo, 0); r = r + 1; }
        listPush(ir.liveIn, li);
        listPush(ir.liveAfter, lo); // liveAfter 暂存 live_out（后段重写为逐 pc）
        bi = bi + 1;
    }
    const genSets: List<List<int>> = listNew();
    const killSets: List<List<int>> = listNew();
    bi = 0;
    while (bi < nb) {
        const g: List<int> = listNew();
        const k: List<int> = listNew();
        let r = 0;
        while (r < rc) { listPush(g, 0); listPush(k, 0); r = r + 1; }
        listPush(genSets, g);
        listPush(killSets, k);
        bi = bi + 1;
    }
    bi = 0;
    while (bi < nb) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        const g = listGet(genSets, bi) catch emptyIntList();
        const k = listGet(killSets, bi) catch emptyIntList();
        let p = blk.start;
        while (p <= blk.end) {
            const node = listGet(ir.nodes, p) catch dummyNode();
            let ui = 0;
            while (ui < node.nUses) {
                const us = listGet(node.uses, ui) catch NO_SLOT;
                if (us != NO_SLOT && us < rc && (listGet(k, us) catch 0) == 0) { listSet(g, us, 1); }
                ui = ui + 1;
            }
            for (us in callExtraUses(node, rc)) {
                if ((listGet(k, us) catch 0) == 0) { listSet(g, us, 1); }
            }
            if (node.def != NO_SLOT && node.def < rc) { listSet(k, node.def, 1); }
            if (node.defFrom != NO_SLOT) {
                let s = node.defFrom;
                while (s < rc) { listSet(k, s, 1); s = s + 1; }
            }
            p = p + 1;
        }
        bi = bi + 1;
    }
    // 不动点。
    const liveOut: List<List<int>> = listNew();
    bi = 0;
    while (bi < nb) {
        const lo: List<int> = listNew();
        let r = 0;
        while (r < rc) { listPush(lo, 0); r = r + 1; }
        listPush(liveOut, lo);
        bi = bi + 1;
    }
    let changed = true;
    while (changed) {
        changed = false;
        bi = nb;
        while (bi > 0) {
            bi = bi - 1;
            const blk = listGet(blocks, bi) catch dummyBlock();
            const lo = listGet(liveOut, bi) catch emptyIntList();
            let r = 0;
            while (r < rc) { listSet(lo, r, 0); r = r + 1; }
            let si = 0;
            while (si < listLen(blk.succs)) {
                const sc = listGet(blk.succs, si) catch 0;
                const lin = listGet(ir.liveIn, sc) catch emptyIntList();
                r = 0;
                while (r < rc) {
                    if ((listGet(lin, r) catch 0) != 0) { listSet(lo, r, 1); }
                    r = r + 1;
                }
                si = si + 1;
            }
            const gin = listGet(ir.liveIn, bi) catch emptyIntList();
            const g = listGet(genSets, bi) catch emptyIntList();
            const k = listGet(killSets, bi) catch emptyIntList();
            r = 0;
            while (r < rc) {
                let nv = 0;
                if ((listGet(g, r) catch 0) != 0 || ((listGet(lo, r) catch 0) != 0 && (listGet(k, r) catch 0) == 0)) { nv = 1; }
                if ((listGet(gin, r) catch 0) != nv) {
                    listSet(gin, r, nv);
                    changed = true;
                }
                r = r + 1;
            }
        }
    }
    // 逐 pc live_after（块尾＝live_out；后向回退）。
    let tmp: List<List<int>> = listNew();
    let z = 0;
    while (z < n) {
        const row: List<int> = listNew();
        let r = 0;
        while (r < rc) { listPush(row, 0); r = r + 1; }
        listPush(tmp, row);
        z = z + 1;
    }
    ir.liveAfter = tmp;
    bi = nb;
    while (bi > 0) {
        bi = bi - 1;
        const blk = listGet(blocks, bi) catch dummyBlock();
        const after: List<int> = listNew();
        const lo = listGet(liveOut, bi) catch emptyIntList();
        let r = 0;
        while (r < rc) { listPush(after, listGet(lo, r) catch 0); r = r + 1; }
        let p = blk.end + 1;
        while (p > blk.start) {
            p = p - 1;
            const la = listGet(ir.liveAfter, p) catch emptyIntList();
            r = 0;
            while (r < rc) { listSet(la, r, listGet(after, r) catch 0); r = r + 1; }
            const node = listGet(ir.nodes, p) catch dummyNode();
            r = 0;
            while (r < rc) {
                if ((listGet(after, r) catch 0) != 0 && ((node.def != NO_SLOT && node.def == r) || (node.defFrom != NO_SLOT && r >= node.defFrom))) {
                    listSet(after, r, 0);
                }
                r = r + 1;
            }
            const um: List<int> = listNew();
            r = 0;
            while (r < rc) { listPush(um, 0); r = r + 1; }
            usesInto(node, rc, um);
            r = 0;
            while (r < rc) {
                if ((listGet(um, r) catch 0) != 0) { listSet(after, r, 1); }
                r = r + 1;
            }
        }
    }
    // run 划分＋融合检测。
    let runVec: List<Ref<RunTx>> = listNew();
    pc = 0;
    while (pc < n) { listPush(ir.runOfPc, -1); pc = pc + 1; }
    bi = 0;
    while (bi < listLen(blocks)) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        pc = blk.start;
        while (pc <= blk.end) {
            if ((listGet(ir.nodes, pc) catch dummyNode()).native == NK_NONE) {
                pc = pc + 1;
                continue;
            }
            let end = pc;
            while (end + 1 <= blk.end && (listGet(ir.nodes, end + 1) catch dummyNode()).native != NK_NONE) { end = end + 1; }
            const runLen = end - pc + 1;
            if (runLen < MIN_RUN_LEN) {
                pc = end + 1;
                continue;
            }
            const run = new RunTx { start: pc, len: runLen, fused: 0, fusedSlot: NO_SLOT };
            const tailKind = (listGet(ir.nodes, end) catch dummyNode()).native;
            if (runLen >= 2 && nkIsBranch(tailKind)) {
                const cmpI = end - 1;
                const ck = (listGet(ir.nodes, cmpI) catch dummyNode()).native;
                const cond = insA((listGet(ir.nodes, end) catch dummyNode()).ins);
                if (nkIsCompare(ck) && insA((listGet(ir.nodes, cmpI) catch dummyNode()).ins) == cond) {
                    let usedAfter = false;
                    let q2 = cmpI + 1;
                    while (q2 < end) {
                        const qn = listGet(ir.nodes, q2) catch dummyNode();
                        let ui = 0;
                        while (ui < qn.nUses) {
                            if ((listGet(qn.uses, ui) catch NO_SLOT) == cond) { usedAfter = true; }
                            ui = ui + 1;
                        }
                        q2 = q2 + 1;
                    }
                    let liveSomewhere = false;
                    const blkI = (listGet(ir.nodes, end) catch dummyNode()).block;
                    const blkS = listGet(blocks, blkI) catch dummyBlock();
                    let si = 0;
                    while (si < listLen(blkS.succs)) {
                        const sc = listGet(blkS.succs, si) catch 0;
                        const lin = listGet(ir.liveIn, sc) catch emptyIntList();
                        if (cond < listLen(lin) && (listGet(lin, cond) catch 0) != 0) { liveSomewhere = true; }
                        si = si + 1;
                    }
                    if (!usedAfter && !liveSomewhere) {
                        run.fused = 1;
                        run.fusedSlot = cond;
                    }
                }
            }
            const ri = listLen(runVec);
            let q3 = pc;
            while (q3 <= end) {
                listSet(ir.runOfPc, q3, ri);
                q3 = q3 + 1;
            }
            listPush(runVec, run);
            pc = end + 1;
        }
        bi = bi + 1;
    }
    ir.runs = runVec;
    return ir;
}

function dummyBlock(): Ref<BlockTx> {
    return new BlockTx { start: 0, end: 0, succs: listNew() };
}
function dummyRun(): Ref<RunTx> {
    return new RunTx { start: 0, len: 0, fused: 0, fusedSlot: NO_SLOT };
}

// ============================================================================
// §4 记录发射（emit_mirror.zig dumpRecords/dumpFunction 同构）
// ============================================================================

// MsgRegistry：首遇序＝发射序。
function msgIdxOf(reg: Ref<MsgReg>, msg: string): int {
    let i = 0;
    while (i < listLen(reg.list)) {
        if ((listGet(reg.list, i) catch "") == msg) { return i; }
        i = i + 1;
    }
    listPush(reg.list, msg);
    return listLen(reg.list) - 1;
}

struct MsgReg {
    list: List<string>,
}

function ovfMsgOf(kind: int): string {
    if (kind == NK_ADD_I) { return "int 加法溢出"; }
    if (kind == NK_SUB_I) { return "int 减法溢出"; }
    if (kind == NK_NEG_I) { return "int 取负溢出"; }
    return "int 乘法溢出";
}

function divZeroMsg(kind: int): string {
    if (kind == NK_DIV_I) { return "除数为零"; }
    return "模运算除数为零";
}

const DIV_OVF_MSG: string = "int 除法溢出";
const CALL_STACK_MSG: string = "调用栈深度超限";

// norelAt（destGuardElidable 镜像）：槽位可证非堆引用——覆写或清空它时免释放（含 dfree 与 retx 掩码）。
// 认 NOHEAP；带取消落点的函数不认（落点处槽型不可信，泄漏检查设计 §六-E）。误判只会漏放，不会多放。
function norelAt(states: Ref<SlotFlow>, pc: int, slot: int): int {
    if (pc >= slotFlowLen(states)) { return 0; }
    const t = slotStateRaw(slotRowAt(states, pc), slot);
    if (t == SLOT_NOHEAP) {
        if (listLen(states.fn.landings) > 0) { return 0; }
        return 1;
    }
    if (t != 0 && !isHeapRefTag(t)) { return 1; }
    return 0;
}

// 源槽判定：标签确切已知且非堆（move 记录把它当立即数写进目标标签，借用与字段读融合以它为前提），不认 NOHEAP。
function srcNoHeapAt(states: Ref<SlotFlow>, pc: int, slot: int): int {
    if (pc >= slotFlowLen(states)) { return 0; }
    if (noHeapRef(stateAt(slotRowAt(states, pc), slot))) { return 1; }
    return 0;
}

// devirtTarget（emit_mirror.zig :95-130 同构）。
function devirtTarget(prog: Ref<Program>, f: Ref<Fn>, jt: List<int>, ins: int, pc: int): int {
    const slot = insA(ins);
    const code = f.code;
    let p = pc;
    while (p > 0) {
        p = p - 1;
        const ins2 = listGet(code, p) catch 0;
        const op2 = insOp(ins2);
        let d = -1;
        if (!(op2 == 21 || op2 == 23 || op2 == 15 || op2 == 16 || op2 == 17 || op2 == 35 || op2 == 33 || op2 == 34)) {
            d = insA(ins2);
        }
        if (d < 0) { continue; }
        if (d != slot) { continue; }
        if (op2 != 1) { return -1; }
        const bxi = insBx(ins2);
        if (bxi >= listLen(f.consts)) { return -1; }
        const c = listGet(f.consts, bxi) catch dummyConst();
        if (c.tag != 4) { return -1; }
        const fidx = c.i;
        if (fidx < 0 || fidx >= listLen(prog.funcs)) { return -1; }
        let qi = 0;
        let into = false;
        while (qi < listLen(jt)) {
            const t = listGet(jt, qi) catch -1;
            if (t > p && t <= pc) { into = true; }
            qi = qi + 1;
        }
        if (into) { return -1; }
        return fidx;
    }
    return -1;
}

// opName：opcode → 记录域名（@tagName 同文）。
function opName(op: int): string {
    if (op == 1) { return "loadk"; }
    if (op == 2) { return "ldbool"; }
    if (op == 3) { return "ldnone"; }
    if (op == 4) { return "move"; }
    if (op == 5) { return "add"; }
    if (op == 6) { return "sub"; }
    if (op == 7) { return "mul"; }
    if (op == 8) { return "div"; }
    if (op == 9) { return "mod"; }
    if (op == 10) { return "neg"; }
    if (op == 11) { return "not"; }
    if (op == 12) { return "eq"; }
    if (op == 13) { return "lt"; }
    if (op == 14) { return "le"; }
    if (op == 15) { return "jmp"; }
    if (op == 16) { return "jt"; }
    if (op == 17) { return "jf"; }
    if (op == 18) { return "iserr"; }
    if (op == 19) { return "isnone"; }
    if (op == 20) { return "getfld"; }
    if (op == 21) { return "setfld"; }
    if (op == 22) { return "getidx"; }
    if (op == 23) { return "setidx"; }
    if (op == 24) { return "clone"; }
    if (op == 25) { return "newstruct"; }
    if (op == 26) { return "newenum"; }
    if (op == 27) { return "newref"; }
    if (op == 28) { return "newarr"; }
    if (op == 29) { return "newslice"; }
    if (op == 30) { return "call"; }
    if (op == 31) { return "callbi"; }
    if (op == 32) { return "tailcall"; }
    if (op == 33) { return "ret"; }
    if (op == 34) { return "reterr"; }
    if (op == 35) { return "switch_op"; }
    if (op == 36) { return "i2f"; }
    if (op == 37) { return "f2i"; }
    if (op == 52) { return "cvt"; }
    if (isFwOp(op)) { return "fwop"; }
    if (op == 38) { return "async_start"; }
    if (op == 39) { return "await_fut"; }
    if (op == 48) { return "gen_new"; }
    if (op == 49) { return "yield"; }
    if (op == 50) { return "gen_next"; }
    if (op == 51) { return "gen_close"; }
    if (op == 40) { return "band"; }
    if (op == 41) { return "bor"; }
    if (op == 42) { return "bxor"; }
    if (op == 43) { return "bnot"; }
    if (op == 44) { return "shl"; }
    if (op == 45) { return "shr"; }
    if (op == 46) { return "sar"; }
    if (op == 47) { return "imul"; }
    return "?";
}

// —— callbi 面分类（emit_mirror.zig 同表）——
function callbiFaceSupported(id: int): int {
    if (id >= EXTERN_ID_BASE) { return 1; }
    // 串子面五＋通用 List 三＋IO 面（print/err/panic/assert/readFile/writeFile/
    // writeFileBytes）＋list_dir/entry_kind/weak/deref/unref/list_pop/eprint/
    // utf8_encode/str_split/task_cancel/cancelled/await_any/now_ms/sleep_ms/
    // list_remove_at/list_insert/str_sub/str_index_of（白名单全集——D96 v0.4）。
    if (id == 1) { return 1; } // print
    if (id == 2) { return 1; } // errf
    if (id == 3) { return 1; } // read_file
    if (id == 5) { return 1; } // to_str
    if (id == 7) { return 1; } // assertf
    if (id == 8) { return 1; } // panicf
    if (id == 9) { return 1; } // weak
    if (id == 10) { return 1; } // deref
    if (id == 6) { return 1; } // unref
    if (id == 12) { return 1; } // utf8_encode
    if (id == 13) { return 1; } // list_new
    if (id == 15) { return 1; } // list_pop
    if (id == 19) { return 1; } // str_concat
    if (id == 20) { return 1; } // task_cancel
    if (id == 21) { return 1; } // task_cancelled
    if (id == 22) { return 1; } // task_await_any
    if (id == 23) { return 1; } // write_file
    if (id == 24) { return 1; } // now_ms
    if (id == 25) { return 1; } // sleep_ms
    if (id == 26) { return 1; } // list_remove_at
    if (id == 27) { return 1; } // list_insert
    if (id == 28) { return 1; } // str_sub
    if (id == 29) { return 1; } // str_index_of
    if (id == 30) { return 1; } // str_split
    if (id == 31) { return 1; } // eprint
    if (id == 32) { return 1; } // list_dir
    if (id == 33) { return 1; } // entry_kind
    if (id == 34) { return 1; } // write_file_bytes
    if (id == 35) { return 1; } // make_dir
    if (id == 36) { return 1; } // write_executable
    // D3 v0.18 Bytes（bytes_new..read_file_bytes）；38..41（len/get/set/push）走 inlineFaceOk 带静态 tag。
    if (id == 37 || (id >= 42 && id <= 47)) { return 1; }
    // D3 v0.19 结构化错误（err_as/err_wrap/err_rich/err_payload/err_cause）。
    if (id >= 48 && id <= 52) { return 1; }
    // D3 v0.21 工具链系统内建（host_target..mono_ns）；60＝ffi_last_error（D3 v0.23）。
    if (id >= 53 && id <= 60) { return 1; }
    // 线程第 2 步：thread_spawn/thread_join。
    if (id == 61 || id == 62) { return 1; }
    // 线程第 4c 步：shared_new..atomic_cas。
    if (id >= 63 && id <= 69) { return 1; }
    // O4 第二步：f32_str（toStr(f32)）。
    if (id == 70) { return 1; }
    // O4 第二步 2c2：bytes_as_list/list_as_bytes。
    if (id == 74 || id == 75) { return 1; }
    // macOS 适配 M0b：host_arch（工具链内建）。
    if (id == 76) { return 1; }
    // D3 v0.37 Bytes 批量操作：bytes_copy、bytes_fill、bytes_get_num、bytes_set_num。
    if (id >= 77 && id <= 80) { return 1; }
    // D3 v0.42：set_env（工具链内建）。
    if (id == 81) { return 1; }
    // __rt 内部内建（线程设计 §十六）。
    if (id >= RT_BI_BASE && id < RT_BI_BASE + RT_BI_COUNT) { return 1; }
    // 调试检查点（第 6 轮 6c，调试实施设计 §四-2）：只在 --debug 构建里出现。
    if (isDbgBi(id)) { return 1; }
    // 工具链进程与标准输入内建（第 6 轮 6c-3，TOOL-103）：直调程序对象里的例程，参数同 __tx_callbi。
    if (isToolBi(id)) { return 1; }
    return 0;
}

function inlineFaceOk(id: int): int {
    // list_len/list_push/byte_at/len（emit_mirror.zig inlineFaceOk——list_push
    // 8 域形在 dispatchV2 有臂；此处按 zig 白名单）。
    if (id == 18 || id == 14 || id == 11 || id == 4) { return 1; }
    if (id == 73) { return 1; } // 紧凑列表 list_len（O4 第二步 2c1b）
    if (id >= 38 && id <= 41) { return 1; } // Bytes len/get/set/push（D3 v0.18，原生内联快路径）
    return 0;
}

function inlineFaceGetSetOk(id: int): int {
    if (id == 16 || id == 17) { return 1; }
    if (id == 71 || id == 72) { return 1; } // 紧凑列表 list_get/list_set（O4 第二步 2c1b）
    return 0;
}

// 平衡拼接（O(总长×log 段数)）：s = s + t 逐段累加在原生运行时每次整串复制，
// 单函数大基本块的载荷为平方级（C3c：1 万语句循环体 20 秒）。
function recCat(parts: List<string>, lo: int, hi: int): string {
    if (hi <= lo) { return ""; }
    if (hi - lo == 1) { return listGet(parts, lo) catch ""; }
    const mid = lo + (hi - lo) / 2;
    return recCat(parts, lo, mid) + recCat(parts, mid, hi);
}

// —— planPayload 调用（regalloc_bridge plansViaMirror 同构）——
// 返回 0＝成功（plansOut＝逐 run E 行原文 List<string>；r12r13 事实写出）；
// -1＝失败（结构化拒绝）。载荷先按片段收集，末尾一次平衡拼接。
function plansViaMirror(ir: Ref<Ir>, runsOf: List<Ref<RunTx>>, liveEnd: List<List<int>>): List<string> {
    const out: List<string> = listNew();
    const payload: List<string> = listNew();
    listPush(payload, "V 3\n"); // 载荷版本：“无槽”哨兵为 65535（C3b；冻结 Zig 桥的载荷无此行，仍按 255）
    let id = 0;
    let rri = 0;
    while (rri < listLen(runsOf)) {
        const run = listGet(runsOf, rri) catch dummyRun();
        const rcnt = ir.reg;
        const live = listGet(liveEnd, rri) catch emptyIntList();
        listPush(payload, "I " + dec(id) + " " + dec(rcnt) + " " + dec(run.fused) + " " + dec(run.len) + " ");
        let s = 0;
        while (s < rcnt) {
            const b = listGet(live, s) catch 0;
            listPush(payload, dec(if1(b != 0)));
            s = s + 1;
        }
        listPush(payload, "\n");
        let p = 0;
        while (p < run.len) {
            const node = listGet(ir.nodes, run.start + p) catch dummyNode();
            if (node.nUses > 2) { return out; } // 协议封顶外
            listPush(payload, "K " + dec(node.native) + " " + dec(node.nUses));
            let ui = 0;
            while (ui < node.nUses) {
                listPush(payload, " " + dec(listGet(node.uses, ui) catch NO_SLOT));
                ui = ui + 1;
            }
            if (node.def != NO_SLOT) {
                listPush(payload, " " + dec(node.def) + " " + dec(node.outTag));
            } else {
                listPush(payload, " " + dec(NO_SLOT) + " 0");
            }
            let np = 0;
            ui = 0;
            while (ui < node.nUses) {
                const sl = listGet(node.uses, ui) catch NO_SLOT;
                let seen = false;
                let v = 0;
                while (v < ui) {
                    if ((listGet(node.uses, v) catch NO_SLOT) == sl) { seen = true; }
                    v = v + 1;
                }
                if (!seen) { np = np + 1; }
                ui = ui + 1;
            }
            listPush(payload, " " + dec(np));
            ui = 0;
            while (ui < node.nUses) {
                const sl = listGet(node.uses, ui) catch NO_SLOT;
                let seen = false;
                let v = 0;
                while (v < ui) {
                    if ((listGet(node.uses, v) catch NO_SLOT) == sl) { seen = true; }
                    v = v + 1;
                }
                if (!seen) { listPush(payload, " " + dec(sl) + " " + dec(nodeUseTag(node, ui))); }
                ui = ui + 1;
            }
            listPush(payload, "\n");
            p = p + 1;
        }
        id = id + 1;
        rri = rri + 1;
    }
    const result: string = planPayload(recCat(payload, 0, listLen(payload)));
    const lines = strSplit(result, "\n");
    rri = 0;
    while (rri < listLen(lines)) {
        const line = listGet(lines, rri) catch "";
        if (len(line) == 0) { rri = rri + 1; continue; }
        const toks = pdFields(line);
        if (pdF(toks, 0) != "E") { return listNew(); }
        const want = dec(rri);
        if (pdF(toks, 1) != want) { return listNew(); }
        // E 行原文留存＋r12r13 扫描（loc gN，N>=4）。
        listPush(out, line);
        let ti = 2;
        while (ti < listLen(toks)) {
            const tok = pdF(toks, ti);
            if (len(tok) >= 2) {
                const h = byteAt(tok, 0) catch 0;
                if (h == 103) { // 'g'
                    const g = parseIntTx(strSub(tok, 1, len(tok) - 1));
                    if (g >= 4) { g_r13 = 1; }
                }
            }
            ti = ti + 1;
        }
        rri = rri + 1;
    }
    if (listLen(out) != listLen(runsOf)) { return listNew(); }
    return out;
}

function if1(b: bool): int {
    if (b) { return 1; }
    return 0;
}

// ============================================================================
// §5 dumpFunction 主体（emit_mirror.zig :268-1095 同构）
// ============================================================================

let g_r13: int = 0;

// ============================================================================
// §5a 借用参数（+0，仅 NRT；docs/design/v052-nrt-performance-v0.1-20261013.md）
// ============================================================================
// 合格被调函数的参数槽是借用的：调用方以不 retain 的 move 填参，被调方退出
// 不释放参数槽（返回参数本身时先 retain），调用方返回后对借用槽只清空、
// 对自有临时槽释放再清空。调用期间调用方源槽一直持有对象，死亡时点不变。

let recBorrowOn: bool = false;
let recBorrowElig: List<int> = listNew();

export function recordSetBorrow(on: bool): void { recBorrowOn = on; }

// 保守的“写槽”判定：调用/异步/内建窗口覆盖 a 及以上；控制流与写入对象的指令不写槽。
function borrowDefines(ins: int, slot: int): bool {
    const op = insOp(ins);
    const a = insA(ins);
    if (op == 30 || op == 31 || op == 32 || op == 38 || op == 48) { return slot >= a; }
    if (op == 15 || op == 16 || op == 17 || op == 21 || op == 23 || op == 33 || op == 34 || op == 35 || op == 49 || op == 51) { return false; }
    return slot == a;
}

function borrowUses(ins: int, slot: int): bool {
    const count = escUseCount(ins);
    let i = 0;
    while (i < count) {
        if (escUseSlotAt(ins, i) == slot) { return true; }
        i = i + 1;
    }
    return false;
}

function borrowJumpTargets(f: Ref<Fn>): List<int> {
    const jt: List<int> = listNew();
    const n = listLen(f.code);
    let pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(pc, ins);
            if (t >= 0) { listPush(jt, t); }
        } else if (op == 35) {
            const bxi = insBx(ins);
            if (bxi < listLen(f.consts)) {
                const ct = listGet(f.consts, bxi) catch dummyConst();
                if (ct.tag == 5) {
                    let k = 0;
                    while (k < listLen(ct.tbl)) { listPush(jt, listGet(ct.tbl, k) catch -1); k = k + 1; }
                }
            }
        }
        pc = pc + 1;
    }
    return jt;
}

// 程序级资格：入口/模块初始化/测试函数、地址被取用（函数常量除直接调用外另有
// 用途）、改写 R0 或参数槽、含尾调用/异步、存在实参数不等于形参数的直接调用者，
// 均不合格。
function borrowEligible(prog: Ref<Program>): List<int> {
    const nf = listLen(prog.funcs);
    const elig: List<int> = listNew();
    let k = 0;
    while (k < nf) { listPush(elig, 1); k = k + 1; }
    if (prog.entry >= 0 && prog.entry < nf) { listSet(elig, prog.entry, 0); }
    k = 0;
    while (k < listLen(prog.modules)) {
        const m = listGet(prog.modules, k) catch new ModuleInfo { path: 0, state_ty: 0, init_fn: -1 };
        if (m.init_fn >= 0 && m.init_fn < nf) { listSet(elig, m.init_fn, 0); }
        k = k + 1;
    }
    k = 0;
    while (k < listLen(prog.tests)) {
        const t = listGet(prog.tests, k) catch new TestEntry { name: 0, func: -1 };
        if (t.func >= 0 && t.func < nf) { listSet(elig, t.func, 0); }
        k = k + 1;
    }
    let g = 0;
    while (g < nf) {
        const f = listGet(prog.funcs, g) catch dummyFn();
        const n = listLen(f.code);
        const jt = borrowJumpTargets(f);
        let pc = 0;
        while (pc < n) {
            const ins = listGet(f.code, pc) catch 0;
            const op = insOp(ins);
            const a = insA(ins);
            if (op == 32 || op == 38 || op == 39 || (op == 31 && insB(ins) == 22) || (op >= 48 && op <= 51)) { listSet(elig, g, 0); }
            if (a <= f.nparams && borrowDefines(ins, a) && op != 15 && op != 16 && op != 17) { listSet(elig, g, 0); }
            if (op == 30) {
                const target = devirtTarget(prog, f, jt, ins, pc);
                if (target >= 0) {
                    const callee = listGet(prog.funcs, target) catch dummyFn();
                    if (insB(ins) - 1 != callee.nparams) { listSet(elig, target, 0); }
                }
            }
            if (op == 1) {
                const bxi = insBx(ins);
                const c = listGet(f.consts, bxi) catch dummyConst();
                if (bxi < listLen(f.consts) && c.tag == 4 && c.i >= 0 && c.i < nf) {
                    if (!borrowCallOnly(prog, f, jt, pc, a, c.i)) { listSet(elig, c.i, 0); }
                }
            }
            pc = pc + 1;
        }
        g = g + 1;
    }
    return elig;
}

// 函数常量装入 slot 后，直线前行遇到的第一次使用必须是解析到同一函数的直接调用。
function borrowCallOnly(prog: Ref<Program>, f: Ref<Fn>, jt: List<int>, from: int, slot: int, fidx: int): bool {
    const n = listLen(f.code);
    let pc = from + 1;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 30 && insA(ins) == slot) { return devirtTarget(prog, f, jt, ins, pc) == fidx; }
        if (borrowUses(ins, slot)) { return false; }
        if (op == 15 || op == 16 || op == 17 || op == 33 || op == 34 || op == 35) { return false; }
        if (borrowDefines(ins, slot)) { return true; }
        pc = pc + 1;
    }
    return true;
}

// 单函数：合格直接调用的借用掩码（-1＝非借用调用）与可改为借用 move 的 pc。
struct BorrowPlan { moves: List<int>, masks: List<int>, gets: List<int> }

function borrowPlan(prog: Ref<Program>, f: Ref<Fn>, jt: List<int>, states: Ref<SlotFlow>, irActive: int, fri: Ref<Ir>): Ref<BorrowPlan> {
    const n = listLen(f.code);
    const plan = new BorrowPlan { moves: listNew(), masks: listNew(), gets: listNew() };
    const isTarget: List<int> = listNew();
    let pc = 0;
    while (pc < n) { listPush(plan.moves, 0); listPush(plan.masks, -1); listPush(plan.gets, 0); listPush(isTarget, 0); pc = pc + 1; }
    if (!recBorrowOn) { return plan; }
    let q = 0;
    while (q < listLen(jt)) {
        const t = listGet(jt, q) catch -1;
        if (t >= 0 && t < n) { listSet(isTarget, t, 1); }
        q = q + 1;
    }
    const visited: List<int> = listNew();
    let qid = 0;
    pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        if (insOp(ins) == 30) {
            const k = devirtTarget(prog, f, jt, ins, pc);
            if (k >= 0 && (listGet(recBorrowElig, k) catch 0) == 1) {
                const callA = insA(ins);
                let mask = 0;
                let j = 1;
                while (j < insB(ins) && j <= 60) {
                    const t = callA + j;
                    const p = borrowDefAt(f, isTarget, pc, t);
                    if (p >= 0) {
                        const mv = listGet(f.code, p) catch 0;
                        const b = insB(mv);
                        let inRun = false;
                        if (irActive == 1) { inRun = (listGet(fri.runOfPc, p) catch -1) >= 0; }
                        if (insOp(mv) == 4 && insA(mv) == t && b < callA && !inRun && srcNoHeapAt(states, p, b) == 0 && borrowSrcStable(f, p, pc, b)) {
                            listSet(plan.moves, p, 1);
                            mask = mask | (1 << (j - 1));
                        }
                    }
                    j = j + 1;
                }
                listSet(plan.masks, pc, mask);
            }
        }
        // 内建调用（宿主 extern 与 str_concat 除外）：同样以借用 move 填参，
        // 调用后由 bclear 记录清空借用槽；内建自身不持有实参槽。
        if (insOp(ins) == 31 && insB(ins) < EXTERN_ID_BASE && insB(ins) != 19) {
            const callA = insA(ins);
            let inRunC = false;
            if (irActive == 1) { inRunC = (listGet(fri.runOfPc, pc) catch -1) >= 0; }
            let mask = 0;
            let j = 1;
            while (!inRunC && j <= insC(ins) && j <= 60) {
                const t = callA + j;
                const p = borrowDefAt(f, isTarget, pc, t);
                if (p >= 0) {
                    const mv = listGet(f.code, p) catch 0;
                    const b = insB(mv);
                    let inRun = false;
                    if (irActive == 1) { inRun = (listGet(fri.runOfPc, p) catch -1) >= 0; }
                    if (insOp(mv) == 4 && insA(mv) == t && b < callA && !inRun && srcNoHeapAt(states, p, b) == 0 && borrowSrcStable(f, p, pc, b)) {
                        if (listLen(visited) == 0) { let v = 0; while (v < n) { listPush(visited, 0); v = v + 1; } }
                        qid = qid + 1;
                        if (borrowTempQuiet(f, visited, qid, pc, t)) {
                            listSet(plan.moves, p, 1);
                            mask = mask | (1 << (j - 1));
                        }
                    }
                }
                j = j + 1;
            }
            if (mask != 0) { listSet(plan.masks, pc, mask); }
        }
        pc = pc + 1;
    }
    return plan;
}

// 转移 move（字符串原地追加，docs/design/v052-string-append-v0.1-20261016.md §四-B）：
// codegen 把 `x = x + e` 编成 `move T←X; …（求 e 到 U）; add T,T,U; move X←T`，把 `x = x + a + b`
// 编成 `move T←X; …（其余叶装入 T+1..）; callbi A,str_concat,n（T＝A+1）; move X←A`。T 是 X 的第二个
// 引用，内核复用判据（rc==1）永不成立。满足下列条件时首个 move 改为转移——T 取得 X 的引用而
// 不 retain，X 清为非引用值、不 release：直线段（段内无跳入点、无控制流与挂起点）；段内不读写
// X、T（调用窗口覆盖也算写）；add 的右操作数不是 X、T；add 之后紧跟 move X←T；不在 strbld 环内；
// X 的类型状态为字符串或未知（调用方判定——数值代码不受影响）。
// 逃逸分析给出帧缓冲的拼接点照样转移：NRT 内核没有帧字符串区，__tx_str_concat_fr 直接转调
// __tx_str_concat，复用判据相同。X 在 add 后即被重新定义，转移不可观察；陷阱即终止进程。扫描窗口
// 限 64 条，判定代价与函数长度无关。
function transferMoveOk(f: Ref<Fn>, isTarget: List<int>, pc: int, sblLoops: List<Ref<AccLoop>>): bool {
    const n = listLen(f.code);
    const ins = listGet(f.code, pc) catch 0;
    const t = insA(ins);
    const x = insB(ins);
    if (t == x) { return false; }
    let li = 0;
    while (li < listLen(sblLoops)) {
        const lp = listGet(sblLoops, li) catch dummyLoop();
        if (pc >= lp.header && pc <= lp.exitPc) { return false; }
        li = li + 1;
    }
    let q = pc + 1;
    while (q + 1 < n && q <= pc + 64) {
        if ((listGet(isTarget, q) catch 1) == 1) { return false; }
        const qi = listGet(f.code, q) catch 0;
        const op = insOp(qi);
        if (op == 5 && insA(qi) == t && insB(qi) == t) {
            const u = insC(qi);
            if (u == x || u == t) { return false; }
            const nx = listGet(f.code, q + 1) catch 0;
            if (insOp(nx) != 4 || insA(nx) != x || insB(nx) != t) { return false; }
            if (sbiOf(sblLoops, q) >= 0) { return false; }
            return true;
        }
        if (op == 31 && insB(qi) == 19 && insA(qi) + 1 == t) {
            const wa = insA(qi);
            const nargs = insC(qi);
            if (nargs < 2 || x == wa || (x > wa && x <= wa + nargs)) { return false; }
            const nx = listGet(f.code, q + 1) catch 0;
            return insOp(nx) == 4 && insA(nx) == x && insB(nx) == wa;
        }
        if (op == 15 || op == 16 || op == 17 || op == 33 || op == 34 || op == 35 || isSuspendPoint(qi)) { return false; }
        if (borrowUses(qi, x) || borrowDefines(qi, x) || borrowUses(qi, t) || borrowDefines(qi, t)) { return false; }
        q = q + 1;
    }
    return false;
}

// 调用前同一直线段内 slot 的定义 pc（遇控制流或跳入点即止，-1＝无）。
function borrowDefAt(f: Ref<Fn>, isTarget: List<int>, callPc: int, slot: int): int {
    let p = callPc - 1;
    while (p >= 0) {
        if ((listGet(isTarget, p + 1) catch 0) == 1) { return -1; }
        const ins = listGet(f.code, p) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17 || op == 33 || op == 34 || op == 35) { return -1; }
        if (borrowDefines(ins, slot)) { return p; }
        p = p - 1;
    }
    return -1;
}

// 内建调用不清空实参槽：原语义下实参槽在调用后仍持有对象，直到该槽被覆写或
// 函数退出；借用后调用一返回就清空。两者死亡时点一致的条件（沿 CFG 前向，
// 按查询号复用访问表）：每条路径上该槽先被非调用指令覆写或函数返回，期间
// 既不读它，也没有任何调用/内建调用——只有调用能经 Weak deref 观察到死亡。
function borrowTempQuiet(f: Ref<Fn>, visited: List<int>, qid: int, callPc: int, slot: int): bool {
    const n = listLen(f.code);
    const work: List<int> = listNew();
    listPush(work, callPc + 1);
    while (listLen(work) > 0) {
        const p = listPop(work) catch -1;
        if (p < 0 || p >= n) { continue; }
        if ((listGet(visited, p) catch 0) == qid) { continue; }
        listSet(visited, p, qid);
        const ins = listGet(f.code, p) catch 0;
        const op = insOp(ins);
        if (borrowUses(ins, slot)) { return false; }
        if (op == 30 || op == 31 || op == 32 || op == 38 || op == 39 || (op >= 48 && op <= 51)) { return false; }
        if (op == 33 || op == 34) { continue; }
        if (borrowDefines(ins, slot)) { continue; }
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(p, ins);
            if (t < 0) { return false; }
            listPush(work, t);
            if (op == 15) { continue; }
        }
        if (op == 35) {
            const bxi = insBx(ins);
            const ct = listGet(f.consts, bxi) catch dummyConst();
            if (bxi >= listLen(f.consts) || ct.tag != 5) { return false; }
            let k = 0;
            while (k < listLen(ct.tbl)) { listPush(work, listGet(ct.tbl, k) catch -1); k = k + 1; }
        }
        listPush(work, p + 1);
    }
    return true;
}

function borrowSrcStable(f: Ref<Fn>, from: int, callPc: int, slot: int): bool {
    let q = from + 1;
    while (q < callPc) {
        if (borrowDefines(listGet(f.code, q) catch 0, slot)) { return false; }
        q = q + 1;
    }
    return true;
}

// 字段借用（仅 NRT）：getfld 的结果只作内建调用的实参时不 retain，调用后与借用
// move 一样由 bclear 清空。字段值由对象持有，对象由源槽 s 持有，所以借用期间
// 字段值一直存活，前提是：s 在 getfld 与调用之间不变；两者之间只有不调用、
// 不写对象字段的指令（白名单）；静态类型为 struct/enum/Ref 且走内联快路径
// （慢路径对这三类只会 trap，不产生新值）；该槽满足 borrowTempQuiet（调用后
// 先被覆写或返回、期间无调用，死亡时点不可区分）。内建调用排除宿主 extern
// 与 str_concat（唯一按 rc==1 原地复用的入口，与借用 move 同口径）。
function fieldBorrowQuietOp(op: int): bool {
    if (op >= 1 && op <= 14) { return true; }
    if (op == 18 || op == 19 || op == 20 || op == 22 || op == 36 || op == 37 || op == 52 || isFwOp(op)) { return true; }
    return op >= 40 && op <= 47;
}

function fieldBorrowPlan(f: Ref<Fn>, jt: List<int>, states: Ref<SlotFlow>, fe: Ref<EscResult>, sblLoops: List<Ref<AccLoop>>, irActive: int, fri: Ref<Ir>, bp: Ref<BorrowPlan>): void {
    if (!recBorrowOn) { return; }
    const n = listLen(f.code);
    const isTarget: List<int> = listNew();
    let pc = 0;
    while (pc < n) { listPush(isTarget, 0); pc = pc + 1; }
    let q = 0;
    while (q < listLen(jt)) {
        const t = listGet(jt, q) catch -1;
        if (t >= 0 && t < n) { listSet(isTarget, t, 1); }
        q = q + 1;
    }
    const visited: List<int> = listNew();
    let qid = 0;
    pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        let inRunC = false;
        if (irActive == 1) { inRunC = (listGet(fri.runOfPc, pc) catch -1) >= 0; }
        if (insOp(ins) == 31 && insB(ins) < EXTERN_ID_BASE && insB(ins) != 19 && !inRunC) {
            const callA = insA(ins);
            let mask = listGet(bp.masks, pc) catch -1;
            if (mask < 0) { mask = 0; }
            let j = 1;
            while (j <= insC(ins) && j <= 60) {
                const t = callA + j;
                const p = borrowDefAt(f, isTarget, pc, t);
                if (p >= 0 && (mask & (1 << (j - 1))) == 0 && fieldBorrowAt(f, jt, states, fe, sblLoops, irActive, fri, bp, p, pc, t, callA) == 1) {
                    if (listLen(visited) == 0) { let v = 0; while (v < n) { listPush(visited, 0); v = v + 1; } }
                    qid = qid + 1;
                    if (borrowTempQuiet(f, visited, qid, pc, t)) {
                        listSet(bp.gets, p, 1);
                        mask = mask | (1 << (j - 1));
                    }
                }
                j = j + 1;
            }
            if (mask != 0) { listSet(bp.masks, pc, mask); }
        }
        pc = pc + 1;
    }
}

function fieldBorrowAt(f: Ref<Fn>, jt: List<int>, states: Ref<SlotFlow>, fe: Ref<EscResult>, sblLoops: List<Ref<AccLoop>>, irActive: int, fri: Ref<Ir>, bp: Ref<BorrowPlan>, p: int, callPc: int, t: int, callA: int): int {
    const g = listGet(f.code, p) catch 0;
    if (insOp(g) != 20 || insA(g) != t) { return 0; }
    if (irActive == 1 && (listGet(fri.runOfPc, p) catch -1) >= 0) { return 0; }
    let src = insB(g);
    if (p >= 1 && fieldReadFusable(f, p - 1, jt, states, fe, sblLoops, irActive, fri, bp) == 1) {
        src = insB(listGet(f.code, p - 1) catch 0);
    }
    if (src == t || src >= callA) { return 0; }
    if (!borrowSrcStable(f, p, callPc, src)) { return 0; }
    let k = 0;
    while (k < listLen(sblLoops)) {
        const lp = listGet(sblLoops, k) catch dummyLoop();
        if (lp.header == p || lp.condPc == p || lp.exitPc == p || lp.addPc == p) { return 0; }
        k = k + 1;
    }
    let q = p + 1;
    while (q < callPc) {
        if (!fieldBorrowQuietOp(insOp(listGet(f.code, q) catch 0))) { return 0; }
        q = q + 1;
    }
    if (escDefIdxOf(fe, p, src) >= 0) { return 0; }
    const row = slotRowAt(states, p);
    let rt = 0;
    if (src < typeRowSlots(row)) { rt = stateAt(row, src); }
    if (rt != TAG_STRUCTV && rt != TAG_ENUMV && rt != TAG_REF) { return 0; }
    let autoDeref = 0;
    if ((insC(g) & FLD_FLAG) != 0) { autoDeref = 1; }
    if (fieldInlineTagOkTx(rt, autoDeref) == 0) { return 0; }
    return 1;
}

// 小帧返回内联帧释放的掩码（仅 NRT）：[from, rc) 不超过 32 槽时，第 k 位＝槽
// from+k 在返回点可能持有堆值（类型分析未证非堆；与 releaseOld 免释放同一
// 依据 norelAt）。超限返回 -1，照旧调用内核 __tx_frame_release(_from)。
function retInlineMask(states: Ref<SlotFlow>, pc: int, a: int, rc: int, fnBorrow: bool, np: int): int {
    // 带取消落点的函数（defer 与可取消的挂起点）：槽型分析没有“挂起点→落点”的边，落点处的槽型不可信，
    // 照旧调用内核帧释放（逐槽按标签判断，泄漏检查设计 §六-E）。
    if (listLen(states.fn.landings) > 0) { return -1; }
    let from = 0;
    if (fnBorrow) { from = np + 1; }
    if (rc - from > 16) { return -1; }
    let mask = 0;
    let i = from;
    while (i < rc) {
        if (i != a && norelAt(states, pc, i) == 0) { mask = mask | (1 << (i - from)); }
        i = i + 1;
    }
    return mask;
}

// 可挂起函数（原生异步，docs/design/v052-native-run-test-async-v0.1-20261014.md §4.2）：
// 含 await_fut（Op 39）或 taskAwaitAny（callbi 22）。挂起时内核把本帧值槽整块移入
// 任务快照、函数直接返回调度器；恢复时调度器移回槽区并经入口分派跳到挂起点重新
// 执行。所以挂起点上所有活值都必须在帧槽里、且不借用帧外对象：这类函数关闭帧内
// 对象分配（D59）、拼接帧缓冲（strbld）、借用约定与叶内联（叶内联会扩大值槽区，
// 与映像登记的槽数不一致）。IR 段不跨 lop，挂起点前已落槽，不受影响。
// 生成器体（D3 v0.22）的 yield（Op 49）同为挂起点：取值方 gen_next 开窗调用、yield 把窗口移入生成器快照。
function isSuspendPoint(ins: int): bool {
    const op = insOp(ins);
    return op == 39 || op == 49 || (op == 31 && insB(ins) == 22);
}

// 一遍扫描：0＝普通；1＝只含生成器操作码 gen_new/gen_next/gen_close（D3 v0.22）；2＝可挂起。
// 可挂起函数与 1 类函数都走保守发射（关帧内分配、拼接帧缓冲、借用约定与叶内联）——取值时内核
// 在本帧之上开窗运行生成器体，这些优化对它们没有收益面，按可挂起函数同样处理，免得逐项论证。
function fnSuspendClass(f: Ref<Fn>): int {
    let cls = 0;
    let pc = 0;
    const n = listLen(f.code);
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 39 || op == 49 || (op == 31 && insB(ins) == 22)) { return 2; }
        if (op == 48 || op == 50 || op == 51 || op == 52 || isFwOp(op)) { cls = 1; } // 52＝cvt 与定宽运算族：先求正确，走运行时例程
        pc = pc + 1;
    }
    return cls;
}

function fnConservative(f: Ref<Fn>): bool { return fnSuspendClass(f) != 0; }

// 调试构建：函数里有调试检查点（只在 --debug 构建里出现）。
function fnHasDbgCheckpoint(f: Ref<Fn>): bool {
    for (ins in f.code) {
        if (insOp(ins) == 31 && isDbgBi(insB(ins))) { return true; }
    }
    return false;
}

// 运算段出口写回集（调试保真）：正常构建＝段末 pc 的 liveAfter；调试构建另加本段定义的标量槽（融合比较的结果不落槽，
// 除外），让检查点读到的具名变量是真值——同可移植渲染器逐定义写回、VM 参照，主流 -O0 下具名变量都可见。段只含标量运算，
// 旧值在定义处已按 defMark 释放并写好标签，写回不涉释放，释放时点与正常构建相同。不改 liveAfter 本身（借用与移动分析也读它）。
function runWriteback(ir: Ref<Ir>, run: Ref<RunTx>, dbg: bool): List<int> {
    const base = listGet(ir.liveAfter, run.start + run.len - 1) catch emptyIntList();
    if (!dbg) { return base; }
    const out: List<int> = listNew();
    for (b in base) { listPush(out, b); }
    while (listLen(out) < ir.reg) { listPush(out, 0); }
    let p = 0;
    while (p < run.len) {
        const node = listGet(ir.nodes, run.start + p) catch dummyNode();
        const t = node.outTag;
        const fusedCmp = run.fused == 1 && p == run.len - 2;
        if (!fusedCmp && node.def != NO_SLOT && node.def < ir.reg && (t == TAG_INT || t == TAG_FLOAT || t == TAG_BOOL || t == TAG_NONE)) {
            listSet(out, node.def, 1);
        }
        p = p + 1;
    }
    return out;
}

// dumpFunction：逐函数记录发射（追加到 out）。
// 字段读融合（仅 NRT）：`move t,s` 紧跟 `getfld t,t,f` 时，t 只为读字段临时
// 持有对象（retain 一次、读完即在 getfld 覆写时 release）。源槽 s 在这两条
// 指令间不变且一直持有该对象，所以直接从 s 读字段，省掉这对原子 RC：对象
// 的死亡时点不变（s 持有），t 的旧值仍由 getfld 的 releaseOld 释放，字段值
// 照常 retain，trap 的 pc 与消息不变。下列任一不成立即不融合：getfld 不是
// 跳转目标；t≠s；s 不是标量可证槽（norel）；该 move 不是借用 move；两条都
// 不在 IR 段、strbld 关键位或 esc 帧对象上；s 在 pc 的类型与 t 在 pc+1 的
// 类型相同。
function fieldReadFusable(f: Ref<Fn>, pc: int, jt: List<int>, states: Ref<SlotFlow>, fe: Ref<EscResult>, sblLoops: List<Ref<AccLoop>>, irActive: int, fri: Ref<Ir>, bp: Ref<BorrowPlan>): int {
    if (!recBorrowOn) { return 0; }
    const n = listLen(f.code);
    if (pc + 1 >= n) { return 0; }
    const ins = listGet(f.code, pc) catch 0;
    const nx = listGet(f.code, pc + 1) catch 0;
    const t = insA(ins);
    const s = insB(ins);
    if (insOp(nx) != 20 || insA(nx) != t || insB(nx) != t || s == t) { return 0; }
    let k = 0;
    while (k < listLen(jt)) {
        if ((listGet(jt, k) catch -1) == pc + 1) { return 0; }
        k = k + 1;
    }
    if (srcNoHeapAt(states, pc, s) == 1) { return 0; }
    if ((listGet(bp.moves, pc) catch 0) == 1) { return 0; }
    if (irActive == 1 && (listGet(fri.runOfPc, pc + 1) catch -1) >= 0) { return 0; }
    k = 0;
    while (k < listLen(sblLoops)) {
        const lp = listGet(sblLoops, k) catch dummyLoop();
        if (lp.header == pc || lp.header == pc + 1 || lp.condPc == pc || lp.condPc == pc + 1) { return 0; }
        if (lp.exitPc == pc || lp.exitPc == pc + 1 || lp.addPc == pc || lp.addPc == pc + 1) { return 0; }
        k = k + 1;
    }
    if (escDefIdxOf(fe, pc, s) >= 0 || escDefIdxOf(fe, pc + 1, t) >= 0) { return 0; }
    const r0 = slotRowAt(states, pc);
    const r1 = slotRowAt(states, pc + 1);
    let ts = 0;
    if (s < typeRowSlots(r0)) { ts = stateAt(r0, s); }
    let tt = 0;
    if (t < typeRowSlots(r1)) { tt = stateAt(r1, t); }
    if (ts != tt) { return 0; }
    return 1;
}

function dumpFunction(prog: Ref<Program>, fnIdx: int, cfgTyped: int, out: List<string>, msgs: Ref<MsgReg>): int {
    const f = listGet(prog.funcs, fnIdx) catch dummyFn();
    const n = listLen(f.code);
    const rc = f.reg;
    // 跳转目标集（devirt 单态性）。
    const jt: List<int> = listNew();
    let pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const t = jumpTargetTx(pc, ins);
            if (t >= 0) { listPush(jt, t); }
        } else if (op == 35) {
            const bxi = insBx(ins);
            if (bxi < listLen(f.consts)) {
                const ct = listGet(f.consts, bxi) catch dummyConst();
                if (ct.tag == 5) {
                    let k = 0;
                    while (k < listLen(ct.tbl)) {
                        listPush(jt, listGet(ct.tbl, k) catch -1);
                        k = k + 1;
                    }
                }
            }
        }
        pc = pc + 1;
    }
    // 槽位类型状态。分析规模护栏（容量批 C3b）：槽类型、逃逸与 IR 分析建有按块或按 pc、每项一行寄存器宽的
    // 稠密表（IR 的逐 pc 活跃表即“指令数×寄存器数”），寄存器放宽到 65535 后大函数可达数十 GB。超过
    // ANALYSIS_BUDGET 时本函数不做这些分析，按无类型事实保守发射（语义不变，只少优化）；稀疏化另行。
    let typed = cfgTyped;
    const cells = listLen(f.code) * f.reg;
    if (typed == 1 && cells > ANALYSIS_BUDGET) { typed = 0; }
    if (compileProfileActive()) { compileProfileAnalysis(fnIdx, cells, cfgTyped == 1 && typed == 0); }
    let states: Ref<SlotFlow> = emptySlotFlow(prog, f);
    if (typed == 1) {
        states = computeSlotTypes(prog, f);
    }
    // 可挂起函数与生成器取值方走保守发射（见 fnSuspendable、fnConservative）。
    const suspClass = fnSuspendClass(f);
    const susp = suspClass != 0;
    const hasResumes = suspClass == 2;
    // escape 事实（esc_on＋typed＋states 非空——缺省面全真）。
    let fe = new EscResult { sites: listNew(), flow: emptyDfResult(), escPad: 0, ok: 0 };
    if (!susp && typed == 1) { fe = escapeAnalyze(prog, f, states); }
    const escPad = fe.escPad;
    const cachePad = 0;
    // strbld 环识别（strbld_on 缺省真）。
    let sblLoops: List<Ref<AccLoop>> = listNew();
    if (!susp) { sblLoops = strbldAnalyzeFn(f); }
    const strbldPad = (listLen(sblLoops) * STRBLD_STATE_BYTES + 15) & ~15;
    const vhPad = 0;
    // IR 构建＋逐段 plan 成功位。
    let irActive = 0;
    let irUses13 = 0;
    let fri: Ref<Ir> = dummyIr();
    let planLines: List<string> = listNew();
    const dbgFn = fnHasDbgCheckpoint(f);
    if (slotFlowLen(states) > 0) {
        const built = buildFnIr(prog, f, states);
        if (built.failed == 0 && listLen(built.runs) > 0) {
            // 逐 run 出口写回集（runWriteback：正常构建即出口活跃集）。
            const liveEnd: List<List<int>> = listNew();
            let rri = 0;
            while (rri < listLen(built.runs)) {
                const run = listGet(built.runs, rri) catch dummyRun();
                listPush(liveEnd, runWriteback(built, run, dbgFn));
                rri = rri + 1;
            }
            g_r13 = 0;
            planLines = plansViaMirror(built, built.runs, liveEnd);
            if (listLen(planLines) == listLen(built.runs)) {
                irActive = 1;
                fri = built;
                irUses13 = g_r13;
            }
        }
    }
    let bp = new BorrowPlan { moves: listNew(), masks: listNew(), gets: listNew() };
    if (susp) {
        let q = 0;
        while (q < n) { listPush(bp.moves, 0); listPush(bp.masks, -1); listPush(bp.gets, 0); q = q + 1; }
    } else {
        bp = borrowPlan(prog, f, jt, states, irActive, fri);
        fieldBorrowPlan(f, jt, states, fe, sblLoops, irActive, fri, bp);
    }
    const fnBorrow = recBorrowOn && (listGet(recBorrowElig, fnIdx) catch 0) == 1;

    // fn 记录第 3 域原为 need_pin（钉驻与 E007 已删除），恒写 0 占位，记录形不变。
    listPush(out, "fn " + dec(fnIdx) + " " + dec(rc) + " 0 " + dec(escPad) + " " + dec(cachePad) + " " + dec(strbldPad) + " " + dec(vhPad) + " 0 " + dec(irActive) + " " + dec(irUses13));
    // strbld 环事实（base＝56+padEsc+padCache）。
    if (listLen(sblLoops) > 0) {
        const sblBase = FRAME_PAD + escPad + cachePad;
        let sbi = 0;
        while (sbi < listLen(sblLoops)) {
            const lp = listGet(sblLoops, sbi) catch dummyLoop();
            listPush(out, "sbl " + dec(sbi) + " " + dec(lp.header) + " " + dec(lp.condPc) + " " + dec(lp.exitPc) + " " + dec(lp.addPc) + " " + dec(lp.sRoot) + " " + dec(lp.bSlot) + " " + dec(lp.prepend) + " " + dec(sblBase));
            sbi = sbi + 1;
        }
    }
    // esc 站点事实（buf_len>0 全量）。
    emitEscRecords(fe, out);
    // 恢复点（可挂起函数）：await_fut 与 taskAwaitAny 的 pc，入口分派按它跳回；第二
    // 字段是该点的取消落点（无已登记 defer 为 -1，取消时直接返回、由内核释放槽区）。
    if (hasResumes) {
        let rp = 0;
        while (rp < n) {
            const ri = listGet(f.code, rp) catch 0;
            if (isSuspendPoint(ri)) {
                let land = -1;
                let li = 0;
                while (li + 1 < listLen(f.landings)) {
                    if ((listGet(f.landings, li) catch -1) == rp) { land = listGet(f.landings, li + 1) catch -1; }
                    li = li + 2;
                }
                listPush(out, "resume " + dec(rp) + " " + dec(land));
            }
            rp = rp + 1;
        }
    }
    // fn 级拒绝。
    if (cachePad > 0) { listPush(out, "rej 0 E005 cache_pad"); }
    if (vhPad > 0) { listPush(out, "rej 0 E005 vh_pad"); }

    // 跳入点表（转移 move 判定用）。
    const tmTarget: List<int> = listNew();
    pc = 0;
    while (pc < n) { listPush(tmTarget, 0); pc = pc + 1; }
    let tq = 0;
    while (tq < listLen(jt)) {
        const tt = listGet(jt, tq) catch -1;
        if (tt >= 0 && tt < n) { listSet(tmTarget, tt, 1); }
        tq = tq + 1;
    }
    let curRun = -1;
    let fuseAt = -1;
    let fuseSrc = -1;
    pc = 0;
    while (pc < n) {
        listPush(out, "lbl " + dec(pc));
        const ins = listGet(f.code, pc) catch 0;
        if (irActive == 1) {
            const rri = listGet(fri.runOfPc, pc) catch -1;
            if (rri >= 0) {
                if (curRun != rri) {
                    curRun = rri;
                    const run = listGet(fri.runs, rri) catch dummyRun();
                    listPush(out, "run " + dec(run.len) + " " + dec(run.fused) + " " + dec(run.fusedSlot));
                }
                const run = listGet(fri.runs, rri) catch dummyRun();
                const pos = pc - run.start;
                const node = listGet(fri.nodes, pc) catch dummyNode();
                const kind = node.native;
                if (run.fused == 1 && (pos + 2 == run.len || pos + 1 == run.len) && !kindSupported(kind)) {
                    listPush(out, "rej " + dec(pc) + " E003 fused_" + nkName(kind));
                    pc = pc + 1;
                    continue;
                }
                const uu0: int = firstUse(node, 0);
                const uu1: int = firstUse(node, 1);
                let lastField = dec(insBx(ins));
                if (kind == NK_JF_B || kind == NK_JT_B) {
                    const tgt = jumpTargetTx(pc, ins);
                    if (tgt < 0) {
                        listPush(out, "rej " + dec(pc) + " E009 jump_target");
                        pc = pc + 1;
                        continue;
                    }
                    lastField = dec(tgt);
                }
                const line = "op " + dec(pc) + " " + nkName(kind) + " " + dec(uu0) + " " + dec(nodeUseTag(node, 0)) + " " + dec(uu1) + " " + dec(nodeUseTag(node, 1)) + " " + dec(node.def) + " " + dec(node.defInputTag) + " " + dec(node.outTag) + " " + lastField;
                listPush(out, line);
                if (kind == NK_LOADK_INT) {
                    const bxi = insBx(ins);
                    let v = 0;
                    if (bxi < listLen(f.consts)) {
                        const c = listGet(f.consts, bxi) catch dummyConst();
                        if (c.tag == 1) { v = c.i; }
                    }
                    listPush(out, "val " + dec(v));
                }
                if (kind == NK_ADD_I || kind == NK_SUB_I || kind == NK_MUL_I || kind == NK_NEG_I) {
                    const msg = ovfMsgOf(kind);
                    const midx = msgIdxOf(msgs, msg);
                    listPush(out, "msg " + dec(midx) + " " + dec(len(msg)));
                }
                if (kind == NK_DIV_I || kind == NK_MOD_I) {
                    // 注册序＝zig 首遇序：溢出消息仅 div 注册（mod 恒 0——A10）。
                    let ovfIdx = 0;
                    if (kind == NK_DIV_I) { ovfIdx = msgIdxOf(msgs, DIV_OVF_MSG); }
                    const zeroMsg = divZeroMsg(kind);
                    const zeroIdx = msgIdxOf(msgs, zeroMsg);
                    listPush(out, "msg " + dec(zeroIdx) + " " + dec(len(zeroMsg)));
                    if (kind == NK_DIV_I) {
                        listPush(out, "msg " + dec(ovfIdx) + " " + dec(len(DIV_OVF_MSG)));
                    }
                }
                if (kind == NK_LOADK_FLOAT) {
                    const bxi = insBx(ins);
                    let bits = 0;
                    if (bxi < listLen(f.consts)) {
                        const c = listGet(f.consts, bxi) catch dummyConst();
                        if (c.tag == 2) { bits = c.fbits; }
                    }
                    listPush(out, "fval " + dec(bits));
                }
                if (pos == run.len - 1) {
                    const live = runWriteback(fri, run, dbgFn);
                    let cnt = 0;
                    let si = 0;
                    while (si < listLen(live)) {
                        if ((listGet(live, si) catch 0) != 0) { cnt = cnt + 1; }
                        si = si + 1;
                    }
                    listPush(out, "live " + dec(cnt));
                    si = 0;
                    while (si < listLen(live)) {
                        if ((listGet(live, si) catch 0) != 0) { listPush(out, "liveslot " + dec(si)); }
                        si = si + 1;
                    }
                }
                pc = pc + 1;
                continue;
            }
            curRun = -1;
        }
        // —— legacy lop 分类 ——
        const op = insOp(ins);
        const aSlot = insA(ins);
        if (op == 1) { // loadk
            const bxi = insBx(ins);
            if (bxi >= listLen(f.consts)) {
                listPush(out, "rej " + dec(pc) + " E002 loadk_oob");
                pc = pc + 1;
                continue;
            }
            const c = listGet(f.consts, bxi) catch dummyConst();
            if (c.tag == 4) {
                listPush(out, "lop " + dec(pc) + " loadk_fnv " + dec(aSlot) + " " + dec(c.i) + " " + dec(norelAt(states, pc, aSlot)));
            } else if (c.tag == 1) {
                listPush(out, "lop " + dec(pc) + " loadk_int " + dec(aSlot) + " " + dec(c.i) + " " + dec(norelAt(states, pc, aSlot)));
            } else if (c.tag == 2) {
                const bits = c.fbits;
                listPush(out, "lop " + dec(pc) + " loadk_float " + dec(aSlot) + " " + dec(bits & 0xFFFFFFFF) + " " + dec((bits >>> 32) & 0xFFFFFFFF) + " " + dec(norelAt(states, pc, aSlot)));
            } else if (c.tag == 3) {
                listPush(out, "lop " + dec(pc) + " loadk_str " + dec(aSlot) + " " + dec(c.i) + " " + dec(norelAt(states, pc, aSlot)));
            } else {
                listPush(out, "rej " + dec(pc) + " E002 loadk_other");
            }
        } else if (op == 3) { // ldnone
            listPush(out, "lop " + dec(pc) + " ldnone " + dec(aSlot) + " " + dec(norelAt(states, pc, aSlot)));
        } else if (op == 2) { // ldbool
            let v = 0;
            if (insB(ins) != 0) { v = 1; }
            listPush(out, "lop " + dec(pc) + " ldbool " + dec(aSlot) + " " + dec(v) + " " + dec(norelAt(states, pc, aSlot)));
        } else if (op >= 40 && op <= 42 || op == 44 || op == 45 || op == 46 || op == 47) { // 位运算族双目
            const bSlot = insB(ins);
            const cSlot = insC(ins);
            if (op == 44 || op == 45 || op == 46) {
                const msg = "移位计数越界（须 0..63）";
                const midx = msgIdxOf(msgs, msg);
                listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cSlot) + " " + dec(midx) + " " + dec(len(msg)));
            } else {
                listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cSlot));
            }
        } else if (op == 43) { // bnot
            const msg = "bnot 的操作数不是 int";
            const midx = msgIdxOf(msgs, msg);
            listPush(out, "lop " + dec(pc) + " bnot " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(midx) + " " + dec(len(msg)));
        } else if (op == 30) { // call
            // 被调窗口与更深的调用把调用者帧里实参之后的槽直接填 None、不释放（emitCallTail2／dfill），
            // 其中仍持有堆引用的死临时会丢掉一份计数（泄漏检查设计 §六-A）。调用前先释放并清空；
            // 槽型可证非堆的跳过。实参之后的槽在调用点都已死（被调帧与更深调用总会覆盖它们）。
            let ds = aSlot + insB(ins);
            while (ds < f.reg) {
                if (norelAt(states, pc, ds) == 0) { listPush(out, "lop " + dec(pc) + " dfree " + dec(ds)); }
                ds = ds + 1;
            }
            const k = devirtTarget(prog, f, jt, ins, pc);
            if (k >= 0) {
                const callee = listGet(prog.funcs, k) catch dummyFn();
                const midx = msgIdxOf(msgs, CALL_STACK_MSG);
                const mask = listGet(bp.masks, pc) catch -1;
                if (mask >= 0) {
                    listPush(out, "lop " + dec(pc) + " call_direct_b " + dec(aSlot) + " " + dec(k) + " " + dec(callee.reg) + " " + dec(insB(ins)) + " " + dec(midx) + " " + dec(len(CALL_STACK_MSG)) + " " + dec(mask));
                } else {
                    listPush(out, "lop " + dec(pc) + " call_direct " + dec(aSlot) + " " + dec(k) + " " + dec(callee.reg) + " " + dec(insB(ins)) + " " + dec(midx) + " " + dec(len(CALL_STACK_MSG)));
                }
            } else {
                const oobMsg = "函数索引越界";
                const soMsg = CALL_STACK_MSG;
                const bcMsg = "调用目标不是函数";
                const oobIdx = msgIdxOf(msgs, oobMsg);
                const soIdx = msgIdxOf(msgs, soMsg);
                const bcIdx = msgIdxOf(msgs, bcMsg);
                listPush(out, "lop " + dec(pc) + " call_indirect " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(oobIdx) + " " + dec(len(oobMsg)) + " " + dec(soIdx) + " " + dec(len(soMsg)) + " " + dec(bcIdx) + " " + dec(len(bcMsg)) + " " + dec(insC(ins)));
            }
        } else if (op == 31) { // callbi
            const biId = insB(ins);
            if (biId >= EXTERN_ID_BASE) {
                // 外部函数：程序有回调时，桩把回调窗口登记在实参之后（ffi_stubs.tx 的 cbWindowEnter），回调帧同样
                // 直接填 None——先释放其中可能持有堆引用的死临时（泄漏检查设计 §六-A）。
                let ds = aSlot + insC(ins) + 1;
                while (ds < f.reg) {
                    if (norelAt(states, pc, ds) == 0) { listPush(out, "lop " + dec(pc) + " dfree " + dec(ds)); }
                    ds = ds + 1;
                }
            }
            if (callbiFaceSupported(biId) == 1) {
                listPush(out, "lop " + dec(pc) + " callbi " + dec(aSlot) + " " + dec(biId) + " " + dec(insC(ins)));
            } else if (biId < EXTERN_ID_BASE && inlineFaceGetSetOk(biId) == 1) {
                const stRow = slotRowAt(states, pc);
                const t1 = stateAt(stRow, aSlot + 1);
                const t2 = stateAt(stRow, aSlot + 2);
                const fast = 0; // bce2 缺省关
                const lcE = -1; // lc 缺省关
                listPush(out, "lop " + dec(pc) + " callbi " + dec(aSlot) + " " + dec(biId) + " " + dec(insC(ins)) + " " + dec(t1) + " " + dec(t2) + " " + dec(fast) + " " + dec(lcE));
            } else if (biId < EXTERN_ID_BASE && inlineFaceOk(biId) == 1) {
                const stRow = slotRowAt(states, pc);
                const t1 = stateAt(stRow, aSlot + 1);
                const t2 = stateAt(stRow, aSlot + 2);
                listPush(out, "lop " + dec(pc) + " callbi " + dec(aSlot) + " " + dec(biId) + " " + dec(insC(ins)) + " " + dec(t1) + " " + dec(t2));
            } else {
                listPush(out, "rej " + dec(pc) + " E002 callbi");
            }
            const bmask = listGet(bp.masks, pc) catch -1;
            if (bmask > 0) { listPush(out, "lop " + dec(pc) + " bclear " + dec(aSlot) + " " + dec(insC(ins)) + " " + dec(bmask)); }
            // taskAwaitAny 全未决时内核已把本帧移入快照：直接返回调度器。
            if (biId == 22) { listPush(out, "lop " + dec(pc) + " susp_check"); }
        } else if (op == 38) { // async_start：建任务与 Future，惰性入就绪队
            listPush(out, "lop " + dec(pc) + " async_start " + dec(aSlot) + " " + dec(insB(ins) - 1));
        } else if (op == 39) { // await_fut：完成即取结果；未决则挂起（恢复后重执行本条）
            listPush(out, "lop " + dec(pc) + " await " + dec(aSlot));
        } else if (op == 48) { // gen_new（D3 v0.22）：建生成器对象（实参快照 retain），R[A] 改写为生成器
            listPush(out, "lop " + dec(pc) + " gen_new " + dec(aSlot) + " " + dec(insB(ins) - 1));
        } else if (op == 49) { // yield：产出 R[A] 并挂起（窗口移入生成器快照）；恢复后重执行本条即继续
            listPush(out, "lop " + dec(pc) + " yield " + dec(aSlot));
        } else if (op == 50) { // gen_next：在本帧之上开窗运行生成器体，R[A] 得产出值或 None
            listPush(out, "lop " + dec(pc) + " gen_next " + dec(aSlot) + " " + dec(insB(ins)));
        } else if (op == 51) { // gen_close：关闭生成器（释放快照）
            listPush(out, "lop " + dec(pc) + " gen_close " + dec(aSlot));
        } else if ((op == 33 || op == 34) && recBorrowOn && retInlineMask(states, pc, aSlot, rc, fnBorrow, f.nparams) != -1) {
            let from = 0;
            if (fnBorrow) { from = f.nparams + 1; }
            listPush(out, "lop " + dec(pc) + " retx " + dec(aSlot) + " " + dec(rc) + " " + dec(from) + " " + dec(f.nparams) + " " + dec(retInlineMask(states, pc, aSlot, rc, fnBorrow, f.nparams)));
        } else if (op == 33) { // ret
            if (fnBorrow) { listPush(out, "lop " + dec(pc) + " ret_b " + dec(aSlot) + " " + dec(rc) + " " + dec(f.nparams)); }
            else { listPush(out, "lop " + dec(pc) + " ret " + dec(aSlot) + " " + dec(rc)); }
        } else if (op == 11 || op == 18 || op == 19) { // not/iserr/isnone
            if (op == 11) {
                const msg = "not 的操作数不是 bool";
                const midx = msgIdxOf(msgs, msg);
                listPush(out, "lop " + dec(pc) + " not " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(midx) + " " + dec(len(msg)));
            } else {
                listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(insB(ins)));
            }
        } else if (op == 13 || op == 14 || op == 12) { // lt/le/eq
            const bSlot = insB(ins);
            const cSlot = insC(ins);
            const stRow = slotRowAt(states, pc);
            const t1 = stateAt(stRow, bSlot);
            const t2 = stateAt(stRow, cSlot);
            listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cSlot) + " " + dec(t1) + " " + dec(t2) + " " + dec(norelAt(states, pc, aSlot)));
        } else if (op == 8 || op == 9) { // div/mod
            const bSlot = insB(ins);
            const cSlot = insC(ins);
            const stRow = slotRowAt(states, pc);
            const t1 = stateAt(stRow, bSlot);
            const t2 = stateAt(stRow, cSlot);
            let zmsg = "除数为零";
            if (op == 9) { zmsg = "模运算除数为零"; }
            let om = 0;
            if (op == 8) { om = msgIdxOf(msgs, DIV_OVF_MSG); }
            const zm = msgIdxOf(msgs, zmsg);
            listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cSlot) + " " + dec(t1) + " " + dec(t2) + " " + dec(norelAt(states, pc, aSlot)) + " " + dec(zm) + " " + dec(len(zmsg)) + " " + dec(om) + " " + dec(len(DIV_OVF_MSG)));
        } else if (op == 5 || op == 6 || op == 7) { // add/sub/mul
            const bSlot = insB(ins);
            const cSlot = insC(ins);
            const stRow = slotRowAt(states, pc);
            const t1 = stateAt(stRow, bSlot);
            const t2 = stateAt(stRow, cSlot);
            let ovfMsg = "int 加法溢出";
            if (op == 6) { ovfMsg = "int 减法溢出"; }
            if (op == 7) { ovfMsg = "int 乘法溢出"; }
            const sbi = sbiOf(sblLoops, pc);
            let noIntTrap = 0;
            if (typed == 1 && sbi < 0 && t1 == t2 && (t1 == TAG_FLOAT || (op == 5 && t1 == TAG_STR))) { noIntTrap = 1; }
            let midx = 0;
            if (noIntTrap == 0) { midx = msgIdxOf(msgs, ovfMsg); }
            const escBuf = escBufOf(fe, pc);
            listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cSlot) + " " + dec(t1) + " " + dec(t2) + " " + dec(norelAt(states, pc, aSlot)) + " " + dec(midx) + " " + dec(len(ovfMsg)) + " " + dec(sbi) + " " + dec(if1(sbi >= 0)) + " " + dec(escBuf) + " " + dec(if1(escBuf >= 0)));
        } else if (op == 25 || op == 26) { // newstruct/newenum
            const site = escSiteIdxOf(fe, pc);
            listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(insBx(ins)) + " " + dec(site.site) + " " + dec(site.scalar));
        } else if (op == 27) { // newref
            const site = escSiteIdxOf(fe, pc);
            listPush(out, "lop " + dec(pc) + " newref " + dec(aSlot) + " " + dec(insBx(ins)) + " " + dec(site.site) + " " + dec(site.scalar));
        } else if (op == 28) { // newarr
            const site = escSiteIdxOf(fe, pc);
            listPush(out, "lop " + dec(pc) + " newarr " + dec(aSlot) + " " + dec(insBx(ins)) + " " + dec(site.site));
        } else if (op == 29) { // newslice
            listPush(out, "lop " + dec(pc) + " newslice " + dec(aSlot) + " " + dec(insBx(ins)));
        } else if (op == 23) { // setidx
            listPush(out, "lop " + dec(pc) + " setidx " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(insC(ins)));
        } else if (op == 36 || op == 37) { // i2f/f2i
            listPush(out, "lop " + dec(pc) + " " + opName(op) + " " + dec(aSlot) + " " + dec(insB(ins)));
        } else if (op == 52) { // cvt：转换种类随记录（运行时例程 __tx_cvt<种类>）
            listPush(out, "lop " + dec(pc) + " cvt " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(insC(ins)));
        } else if (isFwOp(op)) { // 定宽数值运算族（O4 第二步）：内联快路径＋冷路径 __tx_fw_slow；两侧静态标签与目的槽免释放随记录
            const fwRow = slotRowAt(states, pc);
            listPush(out, "lop " + dec(pc) + " fwop " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(insC(ins)) + " " + dec(op) + " " + dec(stateAt(fwRow, insB(ins))) + " " + dec(stateAt(fwRow, insC(ins))) + " " + dec(norelAt(states, pc, aSlot)));
        } else if (op == 22) { // getidx
            listPush(out, "lop " + dec(pc) + " getidx " + dec(aSlot) + " " + dec(insB(ins)) + " " + dec(insC(ins)));
        } else if (op == 10) { // neg
            listPush(out, "lop " + dec(pc) + " neg " + dec(aSlot) + " " + dec(insB(ins)));
        } else if (op == 34) { // reterr
            if (fnBorrow) { listPush(out, "lop " + dec(pc) + " reterr_b " + dec(aSlot) + " " + dec(f.nparams)); }
            else { listPush(out, "lop " + dec(pc) + " reterr " + dec(aSlot)); }
        } else if (op == 24) { // clone
            listPush(out, "lop " + dec(pc) + " clone " + dec(aSlot) + " " + dec(insB(ins)));
        } else if (op == 20 || op == 21) { // getfld/setfld
            let bSlot = insB(ins);
            if (pc == fuseAt) { bSlot = fuseSrc; }
            const cfield = insC(ins);
            let autoDeref = 0;
            if ((cfield & FLD_FLAG) != 0) { autoDeref = 1; }
            const stRow = slotRowAt(states, pc);
            let rt = 0;
            if (bSlot < typeRowSlots(stRow)) { rt = stateAt(stRow, bSlot); }
            let fire = 1;
            if (rt != 0 && fieldInlineTagOkTx(rt, autoDeref) == 0) { fire = 0; }
            const site = escDefIdxOf(fe, pc, bSlot);
            if (site >= 0) { fire = 0; }
            let form = opName(op);
            if (op == 20 && (listGet(bp.gets, pc) catch 0) == 1) { form = "getfldb"; }
            listPush(out, "lop " + dec(pc) + " " + form + " " + dec(aSlot) + " " + dec(bSlot) + " " + dec(cfield) + " " + dec(rt) + " " + dec(fire) + " " + dec(site));
        } else if (op == 4) { // move 三分
            const bSlot = insB(ins);
            const stRow = slotRowAt(states, pc);
            const ts = stateAt(stRow, bSlot);
            if (!susp && fieldReadFusable(f, pc, jt, states, fe, sblLoops, irActive, fri, bp) == 1) {
                // move t,s; getfld t,t,f → getfld t,s,f（仅 NRT，见 fieldReadFusable）。
                fuseAt = pc + 1;
                fuseSrc = bSlot;
            } else if (srcNoHeapAt(states, pc, bSlot) == 1) {
                if (norelAt(states, pc, aSlot) == 1) {
                    listPush(out, "lop " + dec(pc) + " move " + dec(aSlot) + " " + dec(bSlot) + " " + dec(ts));
                } else {
                    listPush(out, "lop " + dec(pc) + " moverl " + dec(aSlot) + " " + dec(bSlot) + " " + dec(ts));
                }
            } else if ((listGet(bp.moves, pc) catch 0) == 1) {
                listPush(out, "lop " + dec(pc) + " moveb " + dec(aSlot) + " " + dec(bSlot));
            } else if (!susp && (ts == TAG_STR || ts == 0) && transferMoveOk(f, tmTarget, pc, sblLoops)) {
                listPush(out, "lop " + dec(pc) + " movet " + dec(aSlot) + " " + dec(bSlot));
            } else {
                listPush(out, "lop " + dec(pc) + " moverc " + dec(aSlot) + " " + dec(bSlot));
            }
        } else if (op == 35) { // switch_op
            const bxi = insBx(ins);
            if (bxi >= listLen(f.consts)) {
                listPush(out, "rej " + dec(pc) + " E002 switch_const");
            } else {
                const c = listGet(f.consts, bxi) catch dummyConst();
                if (c.tag == 5) {
                    let line = "lop " + dec(pc) + " switch_op " + dec(aSlot) + " " + dec(bxi) + " " + dec(listLen(c.tbl));
                    let k = 0;
                    while (k < listLen(c.tbl)) {
                        line = line + " " + dec(listGet(c.tbl, k) catch 0);
                        k = k + 1;
                    }
                    listPush(out, line);
                } else {
                    listPush(out, "rej " + dec(pc) + " E002 switch_const");
                }
            }
        } else if (op == 16 || op == 17) { // jt/jf
            const target = jumpTargetTx(pc, ins);
            if (target < 0) {
                listPush(out, "rej " + dec(pc) + " E009 jcc_target");
                pc = pc + 1;
                continue;
            }
            const stRow = slotRowAt(states, pc);
            if (pc < slotFlowLen(states) && stateAt(stRow, aSlot) == TAG_BOOL) {
                let isJt = 0;
                if (op == 16) { isJt = 1; }
                listPush(out, "lop " + dec(pc) + " jcc " + dec(aSlot) + " " + dec(isJt) + " " + dec(target));
            } else {
                const msg = "条件跳转的操作数不是 bool";
                const midx = msgIdxOf(msgs, msg);
                let isJt = 0;
                if (op == 16) { isJt = 1; }
                listPush(out, "lop " + dec(pc) + " jcc_u " + dec(aSlot) + " " + dec(isJt) + " " + dec(target) + " " + dec(midx) + " " + dec(len(msg)));
            }
        } else if (op == 15) { // jmp
            const target = jumpTargetTx(pc, ins);
            if (target < 0) {
                listPush(out, "rej " + dec(pc) + " E009 jmp_target");
                pc = pc + 1;
                continue;
            }
            listPush(out, "lop " + dec(pc) + " jmp " + dec(target));
        } else {
            listPush(out, "rej " + dec(pc) + " E002 " + opName(op));
        }
        pc = pc + 1;
    }
    listPush(out, "endf");
    return 0;
}

function firstUse(node: Ref<IrNode>, i: int): int {
    if (node.nUses > i) {
        return listGet(node.uses, i) catch NO_SLOT;
    }
    return NO_SLOT;
}

function tagAtRow(row: List<int>, r: int): int {
    return stateAt(row, r);
}

function fieldInlineTagOkTx(t: int, autoDeref: int): int {
    if (autoDeref == 1) {
        if (t == TAG_REF) { return 1; }
        return 0;
    }
    if (t == TAG_STRUCTV || t == TAG_REF || t == TAG_ENUMV) { return 1; }
    return 0;
}

function dummyIr(): Ref<Ir> {
    return new Ir { nodes: listNew(), runs: listNew(), runOfPc: listNew(), liveAfter: listNew(), liveIn: listNew(), reg: 0, failed: 1 };
}

// escape port (escape.zig analyze + dataflow + markEscapes + scalar + layout)
// appended section for emit_record.tx — slice 2

const STR_BUF_CAP: int = 64;
const MAX_ESC_PAD: int = 4096;
const MAX_MAY_SITES: int = 64;
const DEF_BOTTOM: int = -2;
const DEF_TOP: int = -1;

// Site kind ids: 0 struct_v / 1 enum_v / 2 ref_v / 3 arr_v / 4 str_concat
struct EscSite {
    pc: int,
    kind: int,
    dest: int,
    units: int,
    scalar: int,
    bufOff: int,
    bufLen: int,
    fieldTags: List<int>,
}

function dummySite(): Ref<EscSite> {
    return new EscSite { pc: 0, kind: 0, dest: 0, units: 0, scalar: 0, bufOff: 0, bufLen: 0, fieldTags: listNew() };
}

struct EscResult {
    sites: List<Ref<EscSite>>,
    flow: Ref<DfResult>, // block facts and bounded replay scratch
    escPad: int,
    ok: int, // 0 = empty / 1 = has sites
}

function callbiReadOnly(id: int): int {
    if (id >= EXTERN_ID_BASE) { return 0; }
    if (id == 1 || id == 2 || id == 4 || id == 5 || id == 7 || id == 8) { return 1; }
    if (id == 6 || id == 10 || id == 11 || id == 12) { return 1; }
    if (id == 13 || id == 16 || id == 18 || id == 26 || id == 71 || id == 73) { return 1; }
    if (id == 19 || id == 28 || id == 29 || id == 30) { return 1; }
    if (id == 20 || id == 21 || id == 24 || id == 25) { return 1; }
    if (id == 3 || id == 23) { return 1; }
    if (isDbgBi(id)) { return 1; }
    return 0;
}

// tyIdxFields：named_struct 字段表 → (decl idx in prog.decls, fields)；不可解析＝null。
function tyIdxFieldsOk(prog: Ref<Program>, tyIdx: int, outFields: List<Ref<FieldDecl>>): int {
    if (tyIdx < 0 || tyIdx >= listLen(prog.tys)) { return -1; }
    const t = listGet(prog.tys, tyIdx) catch dummyTy();
    if (t.kind != 12) { return -1; } // named_struct
    if (t.a < 0 || t.a >= listLen(prog.decls)) { return -1; }
    const d = listGet(prog.decls, t.a) catch dummyDecl();
    if (d.which != 1) { return -1; }
    let i = 0;
    while (i < listLen(d.fields)) {
        listPush(outFields, listGet(d.fields, i) catch dummyField());
        i = i + 1;
    }
    return t.a;
}

function variantFieldsOk(prog: Ref<Program>, declIdx: int, variantIdx: int, outFields: List<Ref<FieldDecl>>): int {
    if (declIdx < 0 || declIdx >= listLen(prog.decls)) { return -1; }
    const d = listGet(prog.decls, declIdx) catch dummyDecl();
    if (d.which != 2) { return -1; }
    if (variantIdx < 0 || variantIdx >= listLen(d.variants)) { return -1; }
    const v = listGet(d.variants, variantIdx) catch dummyVariant();
    let i = 0;
    while (i < listLen(v.fields)) {
        listPush(outFields, listGet(v.fields, i) catch dummyField());
        i = i + 1;
    }
    return declIdx;
}

function fieldTagsOf(prog: Ref<Program>, fields: List<Ref<FieldDecl>>): List<int> {
    const tags: List<int> = listNew();
    let i = 0;
    while (i < listLen(fields)) {
        let t = 0;
        const fd = listGet(fields, i) catch dummyField();
        if (fd.ty >= 0 && fd.ty < listLen(prog.tys)) {
            const k = (listGet(prog.tys, fd.ty) catch dummyTy()).kind;
            if (k == 1) { t = TAG_INT; }
            else if (k == 2) { t = TAG_FLOAT; }
            else if (k == 3) { t = TAG_BOOL; }
        }
        listPush(tags, t);
        i = i + 1;
    }
    return tags;
}

function allPrimitive(fieldTags: List<int>): int {
    let i = 0;
    while (i < listLen(fieldTags)) {
        const t = listGet(fieldTags, i) catch 0;
        if (t != TAG_INT && t != TAG_FLOAT && t != TAG_BOOL) { return 0; }
        i = i + 1;
    }
    return 1;
}

function mayBit(s: int): int {
    if (s >= 64) { return 0; }
    return shl1(s);
}

function shl1(n: int): int {
    let v = 1;
    let i = 0;
    while (i < n) {
        v = imul(v, 2);
        i = i + 1;
    }
    return v;
}

function escTagAt(row: List<int>, r: int): int {
    return stateAt(row, r);
}

// useCount/useSlotAt（escape.zig :721-756 同构——精确面）。
function escUseCount(ins: int): int {
    const op = insOp(ins);
    if (op == 1 || op == 2 || op == 3 || op == 25 || op == 26 || op == 27 || op == 28 || op == 29 || op == 15) { return 0; }
    if (op == 33 || op == 34 || op == 16 || op == 17 || op == 35) { return 1; }
    if (op == 4 || op == 10 || op == 11 || op == 43 || op == 18 || op == 19 || op == 36 || op == 37 || op == 52 || op == 20 || op == 24 || op == 39) { return 1; }
    if ((op >= 5 && op <= 9) || (op >= 12 && op <= 14) || op == 22 || (op >= 40 && op <= 47) || isFwOp(op)) { return 2; }
    if (op == 21) { return 2; }
    if (op == 23) { return 3; }
    if (op == 30 || op == 32) { return insB(ins); }
    if (op == 31) { return insC(ins); }
    if (op == 38 || op == 48) { return insB(ins); } // async_start/gen_new：被调值 R[A]＋B-1 个实参（均被任务/生成器持有）
    if (op == 49 || op == 50 || op == 51) { return 1; } // yield/gen_close 读 A，gen_next 读 B
    return 3;
}

function escUseSlotAt(ins: int, i: int): int {
    const op = insOp(ins);
    const a = insA(ins);
    const b = insB(ins);
    const c = insC(ins);
    if (op == 33 || op == 34 || op == 16 || op == 17 || op == 35 || op == 39 || op == 49 || op == 51) { return a; }
    if (op == 38 || op == 48) { return a + i; }
    if (op == 50) { return b; }
    if (op == 4 || op == 10 || op == 11 || op == 43 || op == 18 || op == 19 || op == 36 || op == 37 || op == 52 || op == 20 || op == 24) { return b; }
    if ((op >= 5 && op <= 9) || (op >= 12 && op <= 14) || op == 22 || (op >= 40 && op <= 47) || isFwOp(op)) {
        if (i == 0) { return b; }
        return c;
    }
    if (op == 21) {
        if (i == 0) { return b; }
        return a;
    }
    if (op == 23) {
        if (i == 0) { return b; }
        if (i == 1) { return c; }
        return a;
    }
    if (op == 30 || op == 32 || op == 31) { return a + 1 + i; }
    if (i == 0) { return a; }
    if (i == 1) { return b; }
    return c;
}

function isAuditedReadOnly(op: int): int {
    if (op == 1 || op == 2 || op == 3 || op == 4 || (op >= 5 && op <= 14) || op == 18 || op == 19 || op == 20 || op == 22 || op == 24 || op == 36 || op == 37 || op == 52) { return 1; }
    if (op == 15 || op == 16 || op == 17 || op == 35) { return 1; }
    if (op >= 200 && op <= 210) { return 1; }
    if (op >= 40 && op <= 47) { return 1; }
    if (isFwOp(op)) { return 1; }
    if (op >= 25 && op <= 29) { return 1; }
    return 0;
}

function opDefsSlotEsc(f: Ref<Fn>, pc: int): int {
    const ins = listGet(f.code, pc) catch 0;
    const op = insOp(ins);
    if ((op >= 1 && op <= 14) || op == 18 || op == 19 || op == 20 || op == 22 || op == 24 || op == 36 || op == 37 || op == 52 || op == 39 || op == 29 || op == 50) { return 1; }
    if (op >= 200 && op <= 210) { return 1; }
    if (op >= 40 && op <= 47) { return 1; }
    if (isFwOp(op)) { return 1; }
    if (op == 31) {
        const id = insB(ins);
        if (id >= EXTERN_ID_BASE) { return 1; }
        if (id == 1 || id == 7 || id == 8 || id == 14 || id == 17 || id == 20 || id == 26 || id == 27 || id == 40 || id == 41 || id == 42 || id == 72) { return 0; }
        if (isDbgBi(id)) { return 0; }
        return 1;
    }
    return 0;
}

// —— 数据流（escape.zig dataflow :398-495 同构）——
struct DfResult {
    def: List<List<int>>, // block entry facts
    may: List<List<int>>,
    fn: Ref<Fn>,
    blocks: List<Ref<BlockTx>>,
    owners: List<int>,
    reached: List<int>,
    siteOfPc: List<int>,
    cachedPc: int,
    cachedBlock: int,
    cachedDef: List<int>,
    cachedMay: List<int>,
}

function emptyDfResult(): Ref<DfResult> {
    return new DfResult { def: listNew(), may: listNew(), fn: dummyFn(),
        blocks: listNew(), owners: listNew(), reached: listNew(), siteOfPc: listNew(),
        cachedPc: -1, cachedBlock: -1, cachedDef: listNew(), cachedMay: listNew() };
}

// Cached rows are private scratch. Consumers finish reading before another PC.
function escReplayAt(res: Ref<DfResult>, pc: int): void {
    if (pc < 0 || pc >= listLen(res.fn.code)) { return; }
    if (res.cachedPc == pc) { return; }
    const bi = listGet(res.owners, pc) catch -1;
    const blk = listGet(res.blocks, bi) catch dummyBlock();
    if (res.cachedBlock != bi || res.cachedPc > pc || res.cachedPc < blk.start) {
        res.cachedDef = copyAnalysisRow(listGet(res.def, bi) catch emptyIntList());
        res.cachedMay = copyAnalysisRow(listGet(res.may, bi) catch emptyIntList());
        res.cachedPc = blk.start;
        res.cachedBlock = bi;
    }
    if ((listGet(res.reached, bi) catch 0) == 1) {
        let q = res.cachedPc;
        while (q < pc) {
            escTransfer(res.fn, q, res.siteOfPc, res.cachedDef, res.cachedMay);
            q = q + 1;
        }
    }
    res.cachedPc = pc;
}

function escDefAt(res: Ref<DfResult>, pc: int, slot: int): int {
    if (pc < 0 || pc >= listLen(res.fn.code) || slot < 0 || slot >= res.fn.reg) { return DEF_TOP; }
    escReplayAt(res, pc);
    return listGet(res.cachedDef, slot) catch DEF_TOP;
}

function escMayAt(res: Ref<DfResult>, pc: int, slot: int): int {
    if (pc < 0 || pc >= listLen(res.fn.code) || slot < 0 || slot >= res.fn.reg) { return 0; }
    escReplayAt(res, pc);
    return listGet(res.cachedMay, slot) catch 0;
}

function escTransfer(f: Ref<Fn>, pc: int, siteOfPc: List<int>, d: List<int>, m: List<int>): void {
    const ins = listGet(f.code, pc) catch 0;
    const op = insOp(ins);
    const a = insA(ins);
    const b = insB(ins);
    const rc = listLen(d);
    if ((op >= 25 && op <= 28) || op == 5) {
        // 构造族＋add（拼接站址同面——V0.23 执行发现）
        const si = listGet(siteOfPc, pc) catch -1;
        if (a < rc) {
            if (si >= 0) {
                listSet(d, a, si);
                listSet(m, a, mayBit(si));
            } else {
                listSet(d, a, DEF_TOP);
                listSet(m, a, 0);
            }
        }
        return;
    }
    if (op == 29) { // newslice
        if (a < rc) { listSet(d, a, DEF_TOP); listSet(m, a, 0); }
        return;
    }
    if (op == 4) { // move
        if (a < rc) {
            if (b < rc) {
                listSet(d, a, listGet(d, b) catch DEF_TOP);
                listSet(m, a, listGet(m, b) catch 0);
            } else {
                listSet(d, a, DEF_TOP);
                listSet(m, a, 0);
            }
        }
        return;
    }
    if (op == 30 || op == 32 || op == 38 || op == 48) {
        if (a < rc) {
            let r = a;
            while (r < rc) { listSet(d, r, DEF_TOP); listSet(m, r, 0); r = r + 1; }
        }
        return;
    }
    if (opDefsSlotEsc(f, pc) == 1) {
        if (a < rc) { listSet(d, a, DEF_TOP); listSet(m, a, 0); }
    }
}

function escBlockBits(rc: int): List<int> {
    const bits: List<int> = listNew(); let r = 0;
    while (r < rc) { listPush(bits, 0); r = r + 64; }
    return bits;
}
function escMarkSlot(bits: List<int>, slot: int): void {
    const word = slot >>> 6;
    listSet(bits, word, (listGet(bits, word) catch 0) | (1 << (slot & 63)));
}
function escDataflow(f: Ref<Fn>, rc: int, sites: List<Ref<EscSite>>, escaping: List<int>): Ref<DfResult> {
    const n = listLen(f.code);
    const siteOfPc: List<int> = listNew();
    let pc = 0;
    while (pc < n) {
        listPush(siteOfPc, -1);
        pc = pc + 1;
    }
    let i = 0;
    while (i < listLen(sites)) {
        if ((listGet(escaping, i) catch 0) == 0) {
            const s = listGet(sites, i) catch dummySite();
            listSet(siteOfPc, s.pc, i);
        }
        i = i + 1;
    }
    const blocks = analysisBlocks(f);
    const defEntries: List<List<int>> = listNew();
    const mayEntries: List<List<int>> = listNew();
    const defOutputs: List<List<int>> = listNew();
    const mayOutputs: List<List<int>> = listNew();
    const broadcast: List<int> = listNew();
    const writeBits: List<List<int>> = listNew();
    const pendingBits: List<List<int>> = listNew();
    const queued: List<int> = listNew();
    const reached: List<int> = listNew();
    let bi = 0;
    while (bi < listLen(blocks)) {
        const d: List<int> = listNew(); const m: List<int> = listNew();
        let r = 0;
        while (r < rc) { listPush(d, DEF_BOTTOM); listPush(m, 0); r = r + 1; }
        listPush(defEntries, d); listPush(mayEntries, m);
        listPush(defOutputs, copyAnalysisRow(d)); listPush(mayOutputs, copyAnalysisRow(m)); listPush(broadcast, 0);
        const writes = escBlockBits(rc);
        const block = listGet(blocks, bi) catch dummyBlock();
        let q = block.start;
        while (q <= block.end) {
            const ins = listGet(f.code, q) catch 0;
            const op = insOp(ins); const a = insA(ins);
            if (a < rc) {
                if (op == 30 || op == 32 || op == 38 || op == 48) {
                    let w = a; while (w < rc) { escMarkSlot(writes, w); w = w + 1; }
                } else if ((op >= 25 && op <= 29) || op == 5 || op == 4 || opDefsSlotEsc(f, q) == 1) {
                    escMarkSlot(writes, a);
                }
            }
            q = q + 1;
        }
        listPush(writeBits, writes); listPush(pendingBits, escBlockBits(rc));
        listPush(queued, 0); listPush(reached, 0); bi = bi + 1;
    }
    const row0 = listGet(defEntries, 0) catch emptyIntList();
    let r = 0;
    while (r < rc) { listSet(row0, r, DEF_TOP); r = r + 1; }
    const oldDef: List<int> = listNew(); const oldMay: List<int> = listNew();
    const work: List<int> = listNew();
    if (n > 0) { listPush(work, 0); listSet(queued, 0, 1); listSet(reached, 0, 1); }
    while (listLen(work) > 0) {
        const cur = listGet(work, listLen(work) - 1) catch 0;
        listRemoveAt(work, listLen(work) - 1); listSet(queued, cur, 0);
        const blk = listGet(blocks, cur) catch dummyBlock();
        const din = listGet(defEntries, cur) catch emptyIntList();
        const min = listGet(mayEntries, cur) catch emptyIntList();
        const dout = listGet(defOutputs, cur) catch emptyIntList();
        const mout = listGet(mayOutputs, cur) catch emptyIntList();
        const first = (listGet(broadcast, cur) catch 0) == 0;
        const candidates: List<int> = listNew();
        const pending = listGet(pendingBits, cur) catch emptyIntList();
        const writes = listGet(writeBits, cur) catch emptyIntList();
        if (first) {
            r = 0; while (r < rc) { listPush(candidates, r); r = r + 1; }
        } else {
            let wi = 0;
            while (wi < listLen(pending)) {
                let bits = (listGet(pending, wi) catch 0) | (listGet(writes, wi) catch 0);
                while (bits != 0) {
                    const slot = wi * 64 + ctzTx(bits);
                    assert(slot < rc, "escape reset slot invariant");
                    listPush(candidates, slot);
                    if (bits == -9223372036854775807 - 1) { bits = 0; }
                    else { bits = bits & (bits - 1); }
                }
                wi = wi + 1;
            }
        }
        let wi = 0;
        while (wi < listLen(pending)) { listSet(pending, wi, 0); wi = wi + 1; }
        let ci = 0;
        while (ci < listLen(candidates)) {
            r = listGet(candidates, ci) catch 0;
            if (!first) {
                if (ci >= listLen(oldDef)) { listPush(oldDef, listGet(dout, r) catch DEF_BOTTOM); listPush(oldMay, listGet(mout, r) catch 0); }
                else { listSet(oldDef, ci, listGet(dout, r) catch DEF_BOTTOM); listSet(oldMay, ci, listGet(mout, r) catch 0); }
            }
            listSet(dout, r, listGet(din, r) catch DEF_BOTTOM);
            listSet(mout, r, listGet(min, r) catch 0); ci = ci + 1;
        }
        pc = blk.start;
        while (pc <= blk.end) { escTransfer(f, pc, siteOfPc, dout, mout); pc = pc + 1; }
        let delta: List<int> = candidates;
        if (!first) {
            delta = listNew(); ci = 0;
            while (ci < listLen(candidates)) {
                r = listGet(candidates, ci) catch 0;
                if ((listGet(oldDef, ci) catch DEF_BOTTOM) != (listGet(dout, r) catch DEF_BOTTOM) || (listGet(oldMay, ci) catch 0) != (listGet(mout, r) catch 0)) { listPush(delta, r); }
                ci = ci + 1;
            }
        }
        listSet(broadcast, cur, 1);
        let si = 0;
        while (si < listLen(blk.succs)) {
            const target = listGet(blk.succs, si) catch 0;
            const drow = listGet(defEntries, target) catch emptyIntList();
            const mrow = listGet(mayEntries, target) catch emptyIntList();
            let merged = false;
            let di = 0;
            while (di < listLen(delta)) {
                r = listGet(delta, di) catch 0;
                const dOld = listGet(drow, r) catch DEF_BOTTOM;
                const nv = listGet(dout, r) catch DEF_BOTTOM;
                let mv = dOld;
                if (dOld == DEF_BOTTOM) { mv = nv; }
                else if (nv == DEF_BOTTOM) { mv = dOld; }
                else if (dOld != nv) { mv = DEF_TOP; }
                if (dOld != mv) { listSet(drow, r, mv); escMarkSlot(listGet(pendingBits, target) catch emptyIntList(), r); merged = true; }
                const mOld = listGet(mrow, r) catch 0;
                const mmv = mOld | (listGet(mout, r) catch 0);
                if (mOld != mmv) { listSet(mrow, r, mmv); escMarkSlot(listGet(pendingBits, target) catch emptyIntList(), r); merged = true; }
                di = di + 1;
            }
            if (merged) {
                listSet(reached, target, 1);
                if ((listGet(queued, target) catch 0) == 0) { listPush(work, target); listSet(queued, target, 1); }
            }
            si = si + 1;
        }
    }
    const owners: List<int> = listNew();
    bi = 0;
    while (bi < listLen(blocks)) {
        const blk = listGet(blocks, bi) catch dummyBlock();
        pc = blk.start;
        while (pc <= blk.end) { listPush(owners, bi); pc = pc + 1; }
        bi = bi + 1;
    }
    return new DfResult { def: defEntries, may: mayEntries, fn: f,
        blocks: blocks, owners: owners, reached: reached, siteOfPc: siteOfPc,
        cachedPc: -1, cachedBlock: -1, cachedDef: listNew(), cachedMay: listNew() };
}

// markEscapes（escape.zig :594-656 同构）。
function markSlotEsc(res: Ref<DfResult>, pc: int, u: int, sites: List<Ref<EscSite>>, marks: List<int>): void {
    const d = escDefAt(res, pc, u);
    if (d >= 0 && d < listLen(sites)) { listSet(marks, d, 1); }
    let bits = escMayAt(res, pc, u);
    while (bits != 0) {
        const low = ctzTx(bits);
        if (low < listLen(sites)) { listSet(marks, low, 1); }
        // 清最低位（符号位特判——bits-1 在 INT_MIN 上溢出陷阱）。
        if (bits == -9223372036854775807 - 1) {
            bits = 0;
        } else {
            bits = bits & (bits - 1);
        }
    }
}

function ctzTx(v: int): int {
    let n = 0;
    let x = v;
    while ((x & 1) == 0) {
        n = n + 1;
        x = x >>> 1;
    }
    return n;
}

function markEscapesTx(prog: Ref<Program>, f: Ref<Fn>, rc: int, res: Ref<DfResult>, sites: List<Ref<EscSite>>, marks: List<int>): void {
    let pc = 0;
    const n = listLen(f.code);
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        const a = insA(ins);
        const b = insB(ins);
        const c = insC(ins);
        if (op == 33 || op == 34) {
            markSlotEsc(res, pc, a, sites, marks);
        } else if (op == 30 || op == 32) {
            let i = 1;
            while (i <= b) {
                if (a + i < rc) { markSlotEsc(res, pc, a + i, sites, marks); }
                i = i + 1;
            }
        } else if (op == 38 || op == 48) {
            // 被调值（闭包 env）与全部实参都被新任务／生成器持有，越过本帧存活。
            let i = 0;
            while (i < b) {
                if (a + i < rc) { markSlotEsc(res, pc, a + i, sites, marks); }
                i = i + 1;
            }
        } else if (op == 31) {
            if (callbiReadOnly(b) == 0) {
                let i = 1;
                while (i <= c) {
                    if (a + i < rc) { markSlotEsc(res, pc, a + i, sites, marks); }
                    i = i + 1;
                }
            }
        } else if (op == 21 || op == 23) {
            markSlotEsc(res, pc, a, sites, marks);
        } else if (op == 39 || op == 49) {
            markSlotEsc(res, pc, a, sites, marks);
        } else {
            if (isAuditedReadOnly(op) == 0) {
                markSlotEsc(res, pc, a, sites, marks);
                markSlotEsc(res, pc, b, sites, marks);
                markSlotEsc(res, pc, c, sites, marks);
            }
        }
        pc = pc + 1;
    }

}

// liveBefore（escape.zig :501-592 同构——逐 pc 进入前活集）。
// 内部每64槽一字，保持原反向不动点顺序；出口仍物化为逐槽0/1矩阵。
function escBitsSet(bits: List<int>, slot: int): void {
    const word = slot >>> 6;
    listSet(bits, word, (listGet(bits, word) catch 0) | (1 << (slot & 63)));
}

function escBitsMerge(dst: List<int>, src: List<int>): void {
    let i = 0;
    while (i < listLen(dst)) {
        listSet(dst, i, (listGet(dst, i) catch 0) | (listGet(src, i) catch 0));
        i = i + 1;
    }
}

function escLiveBefore(f: Ref<Fn>, rc: int): List<List<int>> {
    const n = listLen(f.code);
    const words = (rc + 63) / 64;
    const liveBits: List<List<int>> = listNew();
    const useBits: List<List<int>> = listNew();
    const defBits: List<List<int>> = listNew();
    const acc: List<int> = listNew();
    let w = 0;
    while (w < words) { listPush(acc, 0); w = w + 1; }
    let pc = 0;
    while (pc < n) {
        const row: List<int> = listNew();
        const uses: List<int> = listNew();
        const defs: List<int> = listNew();
        w = 0;
        while (w < words) { listPush(row, 0); listPush(uses, 0); listPush(defs, 0); w = w + 1; }
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        const a = insA(ins);
        const count = escUseCount(ins);
        let ui = 0;
        while (ui < count) {
            const u = escUseSlotAt(ins, ui);
            if (u < rc) { escBitsSet(uses, u); }
            ui = ui + 1;
        }
        if (op == 30 || op == 32 || op == 38 || op == 48) {
            let r = a;
            while (r < rc) { escBitsSet(defs, r); r = r + 1; }
        } else if (opDefsSlotEsc(f, pc) == 1 || op == 25 || op == 26 || op == 27 || op == 28) {
            if (a < rc) { escBitsSet(defs, a); }
        }
        listPush(liveBits, row); listPush(useBits, uses); listPush(defBits, defs);
        pc = pc + 1;
    }
    let changed = true;
    while (changed) {
        changed = false;
        let p = n;
        while (p > 0) {
            p = p - 1;
            const ins = listGet(f.code, p) catch 0;
            const op = insOp(ins);
            w = 0;
            while (w < words) { listSet(acc, w, 0); w = w + 1; }
            const fallOk = !(op == 15 || op == 33 || op == 34 || op == 32);
            if (fallOk && p + 1 < n) { escBitsMerge(acc, listGet(liveBits, p + 1) catch emptyIntList()); }
            if (op == 15 || op == 16 || op == 17) {
                const t = jumpTargetTx(p, ins);
                if (t >= 0 && t < n) { escBitsMerge(acc, listGet(liveBits, t) catch emptyIntList()); }
            }
            if (op == 35) {
                const bxi = insBx(ins);
                if (bxi < listLen(f.consts)) {
                    const ct = listGet(f.consts, bxi) catch dummyConst();
                    if (ct.tag == 5) {
                        let k = 0;
                        while (k < listLen(ct.tbl)) {
                            const t = listGet(ct.tbl, k) catch -1;
                            if (t >= 0 && t < n) { escBitsMerge(acc, listGet(liveBits, t) catch emptyIntList()); }
                            k = k + 1;
                        }
                    }
                }
                if (p + 1 < n) { escBitsMerge(acc, listGet(liveBits, p + 1) catch emptyIntList()); }
            }
            const row = listGet(liveBits, p) catch emptyIntList();
            const uses = listGet(useBits, p) catch emptyIntList();
            const defs = listGet(defBits, p) catch emptyIntList();
            w = 0;
            while (w < words) {
                const nv = (listGet(uses, w) catch 0) | ((listGet(acc, w) catch 0) & ~(listGet(defs, w) catch 0));
                if ((listGet(row, w) catch 0) != nv) { listSet(row, w, nv); changed = true; }
                w = w + 1;
            }
        }
    }
    const liveIn: List<List<int>> = listNew();
    pc = 0;
    while (pc < n) {
        const bits = listGet(liveBits, pc) catch emptyIntList();
        const row: List<int> = listNew();
        let r = 0;
        while (r < rc) {
            listPush(row, ((listGet(bits, r >>> 6) catch 0) >>> (r & 63)) & 1);
            r = r + 1;
        }
        listPush(liveIn, row); pc = pc + 1;
    }
    return liveIn;
}

// scalarEligible（escape.zig :342-379 同构）。
function scalarEligible(res: Ref<DfResult>, f: Ref<Fn>, si: int, kind: int, rc: int): int {
    const bit = mayBit(si);
    const n = listLen(f.code);
    let pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        const b = insB(ins);
        if (op == 4) { // move
            if (kind == 2) { pc = pc + 1; continue; } // ref_v 放行
            if ((escMayAt(res, pc, b) & bit) != 0) { return 0; }
        } else if (op == 20 || op == 21) { // getfld/setfld
            if (escDefAt(res, pc, b) == si) {
                // 容器位确定为 s——成立
            } else {
                if ((escMayAt(res, pc, b) & bit) != 0) { return 0; }
            }
        } else {
            const cnt = escUseCount(ins);
            let ui = 0;
            while (ui < cnt) {
                const u = escUseSlotAt(ins, ui);
                if (u >= rc) { ui = ui + 1; continue; }
                if ((escMayAt(res, pc, u) & bit) != 0) { return 0; }
                ui = ui + 1;
            }
        }
        pc = pc + 1;
    }
    return 1;
}

// escapeAnalyze（escape.zig analyze :124-321 同构）。
function escMarkCount(marks: List<int>): int {
    let count = 0;
    let i = 0;
    while (i < listLen(marks)) { count = count + (listGet(marks, i) catch 0); i = i + 1; }
    return count;
}

function escapeAnalyze(prog: Ref<Program>, f: Ref<Fn>, states: Ref<SlotFlow>): Ref<EscResult> {
    const n = listLen(f.code);
    const rc = f.reg;
    const empty = new EscResult { sites: listNew(), flow: emptyDfResult(), escPad: 0, ok: 0 };
    if (n == 0 || rc == 0) { return empty; }
    // 站址收集。
    const sites: List<Ref<EscSite>> = listNew();
    let pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 25 || op == 26 || op == 27 || op == 28) {
            const bxi = insBx(ins);
            if (bxi < listLen(f.consts)) {
                const c = listGet(f.consts, bxi) catch dummyConst();
                let kind = 0;
                if (op == 25) { kind = 0; }
                else if (op == 26) { kind = 1; }
                else if (op == 27) { kind = 2; }
                else { kind = 3; }
                let units = 0;
                let fieldTags: List<int> = listNew();
                let resolvable = 0;
                const fields: List<Ref<FieldDecl>> = listNew();
                if (c.tag == 6) {
                    if (tyIdxFieldsOk(prog, c.i, fields) >= 0) {
                        units = listLen(fields);
                        fieldTags = fieldTagsOf(prog, fields);
                        resolvable = 1;
                    }
                } else if (c.tag == 7) {
                    if (variantFieldsOk(prog, c.i, c.vi, fields) >= 0) {
                        units = listLen(fields);
                        fieldTags = fieldTagsOf(prog, fields);
                        resolvable = 1;
                    }
                } else if (c.tag == 8) {
                    if (c.vlen <= MAX_ESC_PAD / 16) {
                        units = c.vlen;
                        resolvable = 1;
                    }
                }
                if (resolvable == 1) {
                    listPush(sites, new EscSite { pc: pc, kind: kind, dest: insA(ins), units: units, scalar: 0, bufOff: 0, bufLen: 0, fieldTags: fieldTags });
                }
            }
        } else if (op == 5) { // add 拼接候选
            const st = slotRowAt(states, pc);
            const b = insB(ins);
            const c2 = insC(ins);
            if (escTagAt(st, b) != TAG_STR || escTagAt(st, c2) != TAG_STR) {
                pc = pc + 1;
                continue;
            }
            listPush(sites, new EscSite { pc: pc, kind: 4, dest: insA(ins), units: STR_BUF_CAP, scalar: 0, bufOff: 0, bufLen: 0, fieldTags: listNew() });
        }
        pc = pc + 1;
    }
    if (listLen(sites) == 0) { return empty; }
    // 逃逸标记（两轮）。
    const escaping: List<int> = listNew();
    let i = 0;
    while (i < listLen(sites)) { listPush(escaping, 0); i = i + 1; }
    let round = 0;
    let dirty = true;
    let final: Ref<DfResult> = emptyDfResult();
    while (round < 2) {
        if (dirty) {
            const res = escDataflow(f, rc, sites, escaping);
            final = res;
        }
        const before = escMarkCount(escaping);
        markEscapesTx(prog, f, rc, final, sites, escaping);
        // 标记仅0→1；数量未变就意味着整个输入标记面未变。
        dirty = escMarkCount(escaping) != before;
        round = round + 1;
    }
    // 保留两轮标记合同；只在第二轮改变输入时重算终态。
    if (dirty) {
        const finalFresh = escDataflow(f, rc, sites, escaping);
        final = finalFresh;
    }
    const live = escLiveBefore(f, rc);
    // 多实例检测。
    const multi: List<int> = listNew();
    i = 0;
    while (i < listLen(sites)) { listPush(multi, 0); i = i + 1; }
    i = 0;
    while (i < listLen(sites)) {
        if ((listGet(escaping, i) catch 0) == 1) { i = i + 1; continue; }
        const s = listGet(sites, i) catch dummySite();
        const bit = mayBit(i);
        escReplayAt(final, s.pc);
        const inDef = final.cachedDef;
        const inMay = final.cachedMay;
        let u = 0;
        while (u < listLen(inMay)) {
            if (u == s.dest) { u = u + 1; continue; }
            const mv = listGet(inMay, u) catch 0;
            const dv = listGet(inDef, u) catch DEF_TOP;
            const mayHit = ((mv & bit) != 0) || (i == dv);
            if (mayHit) {
                listSet(multi, i, 1);
                break;
            }
            u = u + 1;
        }
        i = i + 1;
    }
    // 标量资格。
    i = 0;
    while (i < listLen(sites)) {
        if ((listGet(escaping, i) catch 0) == 1) { i = i + 1; continue; }
        const site = listGet(sites, i) catch dummySite();
        if (site.kind != 0 && site.kind != 2) { i = i + 1; continue; }
        if (allPrimitive(site.fieldTags) == 0) { i = i + 1; continue; }
        if (i >= MAX_MAY_SITES) { i = i + 1; continue; }
        const bit = mayBit(i);
        escReplayAt(final, site.pc);
        const inDef = final.cachedDef;
        const inMay = final.cachedMay;
        const inLive = listGet(live, site.pc) catch emptyIntList();
        let liveAlias = false;
        let u = 0;
        while (u < listLen(inMay)) {
            if (u == site.dest) { u = u + 1; continue; }
            const mv = listGet(inMay, u) catch 0;
            const dv = listGet(inDef, u) catch DEF_TOP;
            const mayHit = ((mv & bit) != 0) || (i == dv);
            const lv = listGet(inLive, u) catch 0;
            if (mayHit && u < listLen(inLive) && lv != 0) {
                liveAlias = true;
                break;
            }
            u = u + 1;
        }
        if (liveAlias) { i = i + 1; continue; }
        site.scalar = scalarEligible(final, f, i, site.kind, rc);
        i = i + 1;
    }
    // 帧区布局。
    let pad = 0;
    i = 0;
    while (i < listLen(sites)) {
        const site = listGet(sites, i) catch dummySite();
        if ((listGet(escaping, i) catch 0) == 1) { i = i + 1; continue; }
        const isMulti = listGet(multi, i) catch 0;
        if (isMulti == 1 && site.scalar == 0) { i = i + 1; continue; }
        let sz = 0;
        if (site.kind == 0 || site.kind == 1 || site.kind == 2) {
            if (site.scalar == 1) {
                sz = site.units * 8;
                if (sz < 8) { sz = 8; }
            } else {
                sz = site.units * 16;
                if (sz < 16) { sz = 16; }
            }
        } else if (site.kind == 3) {
            sz = site.units * 16;
        } else {
            sz = STR_BUF_CAP;
        }
        if (pad + sz > MAX_ESC_PAD) { i = i + 1; continue; }
        site.bufOff = pad;
        site.bufLen = sz;
        pad = pad + sz;
        i = i + 1;
    }
    const escPad = (pad + 15) & ~15;
    return new EscResult { sites: sites, flow: final, escPad: escPad, ok: 1 };
}

// —— esc 站点解析（emit_mirror.zig escSiteIdxOf/escDefIdxOf 同构）——
function escSiteIdxOf(fe: Ref<EscResult>, pc: int): Ref<SiteRef> {
    if (fe.ok == 0) { return new SiteRef { site: -1, scalar: 0 }; }
    let i = 0;
    while (i < listLen(fe.sites)) {
        const s = listGet(fe.sites, i) catch dummySite();
        if (s.pc == pc && s.bufLen > 0) {
            return new SiteRef { site: i, scalar: s.scalar };
        }
        i = i + 1;
    }
    return new SiteRef { site: -1, scalar: 0 };
}

function escDefIdxOf(fe: Ref<EscResult>, pc: int, slot: int): int {
    if (fe.ok == 0) { return -1; }
    const d = escDefAt(fe.flow, pc, slot);
    if (d < 0) { return -1; }
    const s = listGet(fe.sites, d) catch dummySite();
    if (s.bufLen == 0) { return -1; }
    return d;
}

struct SiteRef {
    site: int,
    scalar: int,
}

// esc 记录发射（buf_len>0 站点全量——kind 编码 0-4）。
function emitEscRecords(fe: Ref<EscResult>, out: List<string>): void {
    if (fe.ok == 0) { return; }
    let si = 0;
    while (si < listLen(fe.sites)) {
        const s = listGet(fe.sites, si) catch dummySite();
        if (s.bufLen == 0) { si = si + 1; continue; }
        listPush(out, "esc " + dec(si) + " " + dec(s.kind) + " " + dec(s.dest) + " " + dec(s.units) + " " + dec(s.scalar) + " " + dec(s.bufOff) + " " + dec(s.bufLen) + " " + dec(listLen(s.fieldTags)));
        let k = 0;
        while (k < listLen(s.fieldTags)) {
            listPush(out, "etag " + dec(listGet(s.fieldTags, k) catch 0));
            k = k + 1;
        }
        si = si + 1;
    }
}

// add 的 str_concat esc 缓冲事实（56+buf_off）。
function escBufOf(fe: Ref<EscResult>, pc: int): int {
    if (fe.ok == 0) { return -1; }
    let i = 0;
    while (i < listLen(fe.sites)) {
        const s = listGet(fe.sites, i) catch dummySite();
        if (s.pc == pc && s.bufLen > 0 && s.kind == 4) {
            return FRAME_PAD + s.bufOff;
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================================
// §7 strbld 拼接累加环识别（strbld.zig 同构；state_bytes=48）
// ============================================================================

const STRBLD_STATE_BYTES: int = 48;

struct AccLoop {
    header: int,
    condPc: int,
    exitPc: int,
    addPc: int,
    sRoot: int,
    bSlot: int,
    tSlot: int,
    prepend: int,
}

function dummyLoop(): Ref<AccLoop> {
    return new AccLoop { header: -1, condPc: 0, exitPc: 0, addPc: 0, sRoot: 0, bSlot: 0, tSlot: 0, prepend: 0 };
}

function sblDestOf(ins: int): int {
    const op = insOp(ins);
    if ((op >= 1 && op <= 4) || (op >= 10 && op <= 14) || op == 18 || op == 19 || op == 24 || op == 36 || op == 37 || op == 52 || op == 20) { return insA(ins); }
    if ((op >= 5 && op <= 9) || isFwOp(op)) { return insA(ins); }
    if (op == 31 || op == 30 || op == 48 || op == 50) { return insA(ins); }
    return NO_SLOT;
}

function sblJumpTgt(f: Ref<Fn>, pc: int): int {
    const ins = listGet(f.code, pc) catch 0;
    return jumpTargetTx(pc, ins);
}

// strbldAnalyzeFn（strbld.zig analyzeFn :76-113 同构——≤4 环）。
function strbldAnalyzeFn(f: Ref<Fn>): List<Ref<AccLoop>> {
    const n = listLen(f.code);
    const out: List<Ref<AccLoop>> = listNew();
    if (n < 8) { return out; }
    let pcL = 0;
    while (pcL < n) {
        const ins = listGet(f.code, pcL) catch 0;
        if (insOp(ins) != 15) { pcL = pcL + 1; continue; }
        const pcH = sblJumpTgt(f, pcL);
        if (pcH < 0 || pcH >= pcL) { pcL = pcL + 1; continue; }
        // while 形状：环头→条件块→体→回边。
        let pcC = -1;
        let q = pcH;
        while (q < pcL) {
            const o = insOp(listGet(f.code, q) catch 0);
            if (o == 17 || o == 16) {
                pcC = q;
                break;
            }
            q = q + 1;
        }
        if (pcC < 0) { pcL = pcL + 1; continue; }
        if (pcC < pcH + 1) { pcL = pcL + 1; continue; }
        const exitPc = sblJumpTgt(f, pcC);
        if (exitPc != pcL + 1) { pcL = pcL + 1; continue; }
        const bodyLo = pcC + 1;
        const bodyHi = pcL;
        if (bodyLo >= bodyHi) { pcL = pcL + 1; continue; }
        const lp = strbldRecognizeLoop(f, pcH, pcC, exitPc, bodyLo, bodyHi);
        if (lp.header != -1) {
            listPush(out, lp);
            if (listLen(out) >= 4) { break; }
        }
        pcL = pcL + 1;
    }
    return out;
}

// [lo, hi] 内是否有指令读写 s。按各操作码的操作数布局判定（同 computeUseDef）：立即数
// （loadk 常量号、getfld/setfld 字段号、调用的内建号与实参数）不参与比较；带槽窗口的
// new*（25..29）与 switch_op 直接视为触及（环头里极少见，放弃只损失优化）；未列出的
// 操作码按 A/B/C 全查。
function sblTouches(f: Ref<Fn>, lo: int, hi: int, s: int): bool {
    let q = lo;
    while (q <= hi) {
        const ins = listGet(f.code, q) catch 0;
        const op = insOp(ins);
        if (op == 15) { q = q + 1; continue; }
        if ((op >= 25 && op <= 29) || op == 35) { return true; }
        if (insA(ins) == s) { return true; }
        if (op == 30 || op == 31 || op == 32 || op == 38 || op == 48) {
            let nargs = insB(ins);
            if (op == 31) { nargs = insC(ins); }
            if (s > insA(ins) && s <= insA(ins) + nargs) { return true; }
        } else if (op == 4 || op == 10 || op == 11 || op == 18 || op == 19 || op == 20 || op == 21 || op == 24 || op == 36 || op == 37 || op == 52 || op == 43 || op == 50) {
            if (insB(ins) == s) { return true; }
        } else if (!(op == 1 || op == 2 || op == 3 || op == 16 || op == 17 || op == 33 || op == 34 || op == 39 || op == 49 || op == 51)) {
            if (insB(ins) == s || insC(ins) == s) { return true; }
        }
        q = q + 1;
    }
    return false;
}

// [lo, hi] 内以 s 为目的槽的指令数。
function sblDefs(f: Ref<Fn>, lo: int, hi: int, s: int): int {
    let n = 0;
    let q = lo;
    while (q <= hi) {
        if (sblDestOf(listGet(f.code, q) catch 0) == s) { n = n + 1; }
        q = q + 1;
    }
    return n;
}

// [lo, hi] 内读 s 的次数（strbld.zig 体扫描的使用计数同构）。
function sblUses(f: Ref<Fn>, lo: int, hi: int, s: int): int {
    let sUses = 0;
    let q2 = lo;
    while (q2 <= hi) {
        const ins = listGet(f.code, q2) catch 0;
        const op = insOp(ins);
        if (op == 4) {
            if (insB(ins) == s) { sUses = sUses + 1; }
        } else if ((op >= 5 && op <= 9) || (op >= 12 && op <= 14) || isFwOp(op)) {
            if (insB(ins) == s || insC(ins) == s) { sUses = sUses + 1; }
        } else if (op == 31 || op == 30) {
            const a0 = insA(ins);
            let nargs = insC(ins);
            if (op == 30) { nargs = insB(ins); }
            let ai = 1;
            while (ai <= nargs) {
                if (a0 + ai == s) { sUses = sUses + 1; }
                ai = ai + 1;
            }
        } else if (op == 20 || op == 22 || op == 21 || op == 23 || op == 36 || op == 37 || op == 52 || op == 10 || op == 11 || op == 24 || op == 19 || op == 18) {
            if (insB(ins) == s) { sUses = sUses + 1; }
            if (op == 22 || op == 23 || op == 12 || op == 14 || op == 13) {
                if (insC(ins) == s) { sUses = sUses + 1; }
            }
            if (op == 21) {
                if (insA(ins) == s) { sUses = sUses + 1; }
            }
        } else if (op == 33 || op == 34) {
            if (insA(ins) == s) { sUses = sUses + 1; }
        } else if (op == 16 || op == 17) {
            if (insA(ins) == s) { sUses = sUses + 1; }
        } else if (op == 35) {
            if (insA(ins) == s) { sUses = sUses + 1; }
        }
        q2 = q2 + 1;
    }
    return sUses;
}

function strbldRecognizeLoop(f: Ref<Fn>, pcH: int, cPc: int, exitPc: int, bodyLo: int, bodyHi: int): Ref<AccLoop> {
    // 体扫描：s 判定＝体内唯一 `MOVE s ← d`（d＝add dest 紧邻）形。
    let sCand = NO_SLOT;
    let addPc = 0;
    let q = bodyLo;
    while (q <= bodyHi) {
        if (insOp(listGet(f.code, q) catch 0) == 5) {
            const d = insA(listGet(f.code, q) catch 0);
            if (q + 1 <= bodyHi) {
                if (insOp(listGet(f.code, q + 1) catch 0) == 4) {
                    if (insB(listGet(f.code, q + 1) catch 0) == d) {
                        const sTry = insA(listGet(f.code, q + 1) catch 0);
                        if (sTry != d) {
                            sCand = sTry;
                            addPc = q;
                            break;
                        }
                    }
                }
            }
        }
        q = q + 1;
    }
    if (sCand == NO_SLOT) { return dummyLoop(); }
    const s = sCand;
    // s 单 def／单使用。
    const sDefs = sblDefs(f, bodyLo, bodyHi, s);
    const sUses = sblUses(f, bodyLo, bodyHi, s);
    if (sDefs != 1 || sUses != 1) { return dummyLoop(); }
    // 环头到条件跳转之间不得读写 s：环内 s 留在帧缓冲、出口才物化，条件里读到的
    // 是进环前的旧值（`while (len(fill) < w) { fill = fill + p; }` 会死循环）。
    if (sblTouches(f, pcH, cPc, s)) { return dummyLoop(); }
    // add 的 s 侧操作数：后置形 b 位／前置形 c 位（def 导向）。
    const addIns = listGet(f.code, addPc) catch 0;
    const ab = insB(addIns);
    const ac = insC(addIns);
    let bSlot = NO_SLOT;
    let tSlot = NO_SLOT;
    let prepend = 0;
    let p = addPc;
    while (p > 0) {
        p = p - 1;
        const ins2 = listGet(f.code, p) catch 0;
        if (sblDestOf(ins2) == ab) {
            if (insOp(ins2) == 4 && insB(ins2) == s) {
                bSlot = ab;
                tSlot = ac;
            }
            break;
        }
    }
    if (bSlot == NO_SLOT) {
        let p2 = addPc;
        while (p2 > 0) {
            p2 = p2 - 1;
            const ins3 = listGet(f.code, p2) catch 0;
            if (sblDestOf(ins3) == ac) {
                if (insOp(ins3) == 4 && insB(ins3) == s) {
                    bSlot = ac;
                    tSlot = ab;
                    prepend = 1;
                }
                break;
            }
        }
    }
    if (bSlot == NO_SLOT) { return dummyLoop(); }
    // t 侧不得依赖 s。
    let p4 = addPc;
    while (p4 > 0) {
        p4 = p4 - 1;
        const ins4 = listGet(f.code, p4) catch 0;
        if (sblDestOf(ins4) == tSlot) {
            if (insOp(ins4) == 4 && insB(ins4) == s) { return dummyLoop(); }
            break;
        }
    }
    // 出口完备性。
    let q3 = bodyLo;
    while (q3 <= bodyHi) {
        const op = insOp(listGet(f.code, q3) catch 0);
        if (op == 33 || op == 34 || op == 38 || op == 39 || op == 32 || (op >= 48 && op <= 51)) { return dummyLoop(); }
        if (op == 15) {
            const t = sblJumpTgt(f, q3);
            if (t < 0) { return dummyLoop(); }
            if (!(t == pcH || (t >= bodyLo && t <= bodyHi))) { return dummyLoop(); }
        }
        if (op == 16 || op == 17) {
            const t = sblJumpTgt(f, q3);
            if (t < bodyLo || t > bodyHi) { return dummyLoop(); }
        }
        q3 = q3 + 1;
    }
    return new AccLoop { header: pcH, condPc: cPc, exitPc: exitPc, addPc: addPc, sRoot: s, bSlot: bSlot, tSlot: tSlot, prepend: prepend };
}

function sbiOf(loops: List<Ref<AccLoop>>, pc: int): int {
    let i = 0;
    while (i < listLen(loops)) {
        const lp = listGet(loops, i) catch dummyLoop();
        if (lp.addPc == pc) { return i; }
        i = i + 1;
    }
    return -1;
}

// ============================================================================
// §8 leafinl 静态小叶内联（pgospec.transformLeafInline 同构——缺省开）
// ============================================================================

const SBX_MIN: int = -2147483648;
const SBX_MAX: int = 2147483647;
const MAX_CALLEE_INS: int = 64;
const MAX_FN_EXPANSIONS: int = 64;

// v6 编码（codegen.tx 同构；叶内联只搬运已校验过的字段，越界由调用方的 SBX_MIN/MAX 与寄存器守卫拦下）。
function encABC(op: int, a: int, b: int, c: int): int {
    return (op & 0xFFFF) | ((a & 0xFFFF) << 16) | ((b & 0xFFFF) << 32) | ((c & 0xFFFF) << 48);
}

function encABx(op: int, a: int, bx: int): int {
    return (op & 0xFFFF) | ((a & 0xFFFF) << 16) | ((bx & 0xFFFFFFFF) << 32);
}

function encAsBx(op: int, a: int, sbx: int): int {
    return encABx(op, a, sbx + 2147483648);
}

function leafMapSlot(newbase: int, s: int): int {
    if (s == 0) { return 0; }
    return newbase + s;
}

function leafDstRegOf(ins: int): int {
    const op = insOp(ins);
    if (op == 21 || op == 23 || op == 15 || op == 16 || op == 17 || op == 35 || op == 33 || op == 34) { return -1; }
    return insA(ins);
}

function leafJumpTgt(pc: int, ins: int): int {
    return jumpTargetTx(pc, ins);
}

function if1int(b: bool): int {
    if (b) { return 1; }
    return 0;
}

function pureOp(op: int): int {
    if (op == 1 || op == 2 || op == 3 || op == 4) { return 1; }
    if (op >= 5 && op <= 14) { return 1; }
    if (op == 15 || op == 16 || op == 17 || op == 33 || op == 36 || op == 37 || op == 52 || op == 20) { return 1; }
    return 0;
}

function stateFieldScalar(prog: Ref<Program>, m: int, fld: int): int {
    if (m < 0 || m >= listLen(prog.modules)) { return 0; }
    const st = (listGet(prog.modules, m) catch dummyModule()).state_ty;
    if (st < 0 || st >= listLen(prog.tys)) { return 0; }
    const sty = listGet(prog.tys, st) catch dummyTy();
    if (sty.kind != 12) { return 0; }
    if (sty.a < 0 || sty.a >= listLen(prog.decls)) { return 0; }
    const d = listGet(prog.decls, sty.a) catch dummyDecl();
    if (d.which != 1) { return 0; }
    if (fld < 0 || fld >= listLen(d.fields)) { return 0; }
    const ft = (listGet(d.fields, fld) catch dummyField()).ty;
    if (ft < 0 || ft >= listLen(prog.tys)) { return 0; }
    const k = (listGet(prog.tys, ft) catch dummyTy()).kind;
    if (k == 1 || k == 2 || k == 3) { return 1; }
    return 0;
}

function calleePure(prog: Ref<Program>, g: Ref<Fn>, sameModule: int): int {
    const glen = listLen(g.code);
    if (glen == 0 || glen > MAX_CALLEE_INS) { return 0; }
    let j = 0;
    while (j < glen) {
        const ins = listGet(g.code, j) catch 0;
        const op = insOp(ins);
        if (pureOp(op) == 0) { return 0; }
        const a = insA(ins);
        const b = insB(ins);
        if (op == 1) {
            const bxi = insBx(ins);
            if (bxi >= listLen(g.consts)) { return 0; }
            const ctag = (listGet(g.consts, bxi) catch dummyConst()).tag;
            if (ctag != 1 && ctag != 2) { return 0; }
        } else if (op == 20) { // getfld
            if (a == 0 || b > 0 || sameModule == 0) { return 0; }
            if (stateFieldScalar(prog, g.module, insC(ins) & FLD_MASK) == 0) { return 0; }
        } else if ((op >= 5 && op <= 14)) {
            if (a == 0 || b == 0 || insC(ins) == 0) { return 0; }
        } else if (op == 4 || op == 10 || op == 11 || op == 36 || op == 37 || op == 52) {
            if (a == 0 || b == 0) { return 0; }
        } else if (op == 16 || op == 17) {
            if (a == 0) { return 0; }
        } else if (op == 33) {
            if (a == 0) { return 0; }
        }
        if (op == 15 || op == 16 || op == 17) {
            const t = leafJumpTgt(j, ins);
            if (t < 0 || t >= glen) { return 0; }
        }
        j = j + 1;
    }
    return 1;
}

function staticMonoTarget(prog: Ref<Program>, f: Ref<Fn>, sitePc: int, jumpInto: List<int>): int {
    const slot = insA(listGet(f.code, sitePc) catch 0);
    let p = sitePc;
    while (p > 0) {
        p = p - 1;
        const ins2 = listGet(f.code, p) catch 0;
        const d = leafDstRegOf(ins2);
        if (d < 0) { continue; }
        if (d != slot) { continue; }
        if (insOp(ins2) != 1) { return -1; }
        const bxi = insBx(ins2);
        if (bxi >= listLen(f.consts)) { return -1; }
        const c = listGet(f.consts, bxi) catch dummyConst();
        if (c.tag != 4) { return -1; }
        const fidx = c.i;
        if (fidx < 0 || fidx >= listLen(prog.funcs)) { return -1; }
        let q = p + 1;
        while (q <= sitePc) {
            if (q < listLen(jumpInto) && (listGet(jumpInto, q) catch 0) == 1) { return -1; }
            q = q + 1;
        }
        return fidx;
    }
    return -1;
}

function computeJumpInto(f: Ref<Fn>): List<int> {
    const n = listLen(f.code);
    const t: List<int> = listNew();
    let pc = 0;
    while (pc < n) { listPush(t, 0); pc = pc + 1; }
    pc = 0;
    while (pc < n) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const tg = leafJumpTgt(pc, ins);
            if (tg >= 0 && tg < n) { listSet(t, tg, 1); }
        } else if (op == 35) {
            const bxi = insBx(ins);
            if (bxi < listLen(f.consts)) {
                const ct = listGet(f.consts, bxi) catch dummyConst();
                if (ct.tag == 5) {
                    let k = 0;
                    while (k < listLen(ct.tbl)) {
                        const tg = listGet(ct.tbl, k) catch -1;
                        if (tg >= 0 && tg < n) { listSet(t, tg, 1); }
                        k = k + 1;
                    }
                }
            }
        }
        pc = pc + 1;
    }
    return t;
}

function calleeHasBackedge(g: Ref<Fn>): int {
    const n = listLen(g.code);
    let pc = 0;
    while (pc < n) {
        const ins = listGet(g.code, pc) catch 0;
        if (insOp(ins) == 15) {
            const t = leafJumpTgt(pc, ins);
            if (t >= 0 && t <= pc) { return 1; }
        }
        pc = pc + 1;
    }
    return 0;
}

// expandCallSite（pgospec.zig :590-827 同构；leaf_expansion 表不建——lc 缺省关）。
function expandCallSite(prog: Ref<Program>, fi: int, sitePc: int, gIdx: int): int {
    const f = listGet(prog.funcs, fi) catch dummyFn();
    const g = listGet(prog.funcs, gIdx) catch dummyFn();
    const callIns = listGet(f.code, sitePc) catch 0;
    const aSlot = insA(callIns);
    const nargs = insB(callIns) - 1;
    if (insC(callIns) != 1) { return 0; }
    if (g.nparams != nargs) { return 0; }
    if (listLen(f.code) != listLen(f.lines) || sitePc >= listLen(f.lines)) { return 0; }

    const newbase = f.reg;
    if (newbase + g.reg > 65534) { return 0; } // 内联后寄存器编号仍须 ≤65534（C3b；原为 255）
    let nRets = 0;
    let gi = 0;
    while (gi < listLen(g.code)) {
        if (insOp(listGet(g.code, gi) catch 0) == 33) { nRets = nRets + 1; }
        gi = gi + 1;
    }
    let initCount = g.reg - 1 - nargs;
    if (initCount < 0) { initCount = 0; }
    const preLen = nargs + initCount;
    const bodyIns = listLen(g.code) + nRets;
    const totalIns = preLen + bodyIns;
    const delta = totalIns - 1;
    const newLen = listLen(f.code) - 1 + totalIns;
    // sBx 域预检。
    let maxFwd = 0;
    let maxBwd = 0;
    let pc = 0;
    while (pc < listLen(f.code)) {
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        if (op == 15 || op == 16 || op == 17) {
            const t = leafJumpTgt(pc, ins);
            if (t >= 0) {
                const sbx = t - pc - 1;
                if (sbx > maxFwd) { maxFwd = sbx; }
                if (sbx < maxBwd) { maxBwd = sbx; }
            }
        }
        pc = pc + 1;
    }
    if (maxFwd + delta > SBX_MAX || maxBwd - delta < SBX_MIN) { return 0; }

    // loadk 常量并入（映射：被调 code 下标 → 新池索引）。
    const constMapK: List<int> = listNew(); // 被调 gj
    const constMapV: List<int> = listNew(); // 新池 idx
    const newConsts: List<Ref<Const>> = listNew();
    let ci = 0;
    while (ci < listLen(f.consts)) {
        listPush(newConsts, listGet(f.consts, ci) catch dummyConst());
        ci = ci + 1;
    }
    gi = 0;
    while (gi < listLen(g.code)) {
        if (insOp(listGet(g.code, gi) catch 0) != 1) { gi = gi + 1; continue; }
        let found = -1;
        let ki = 0;
        while (ki < listLen(constMapK)) {
            if ((listGet(constMapK, ki) catch -1) == gi) { found = ki; break; }
            ki = ki + 1;
        }
        if (found < 0) {
            listPush(constMapK, gi);
            listPush(constMapV, listLen(newConsts));
            listPush(newConsts, listGet(g.consts, insBx(listGet(g.code, gi) catch 0)) catch dummyConst());
        }
        gi = gi + 1;
    }

    // 被调 pc → body 偏移（ret 2 条前缀和；[n]＝续体）。
    const gOff: List<int> = listNew();
    let acc = 0;
    gi = 0;
    while (gi < listLen(g.code)) {
        listPush(gOff, acc);
        if (insOp(listGet(g.code, gi) catch 0) == 33) { acc = acc + 2; } else { acc = acc + 1; }
        gi = gi + 1;
    }
    listPush(gOff, acc);
    const bodyBase = sitePc + preLen;
    const contNew = bodyBase + bodyIns;

    // 新 code/lines 组装。
    const newCode: List<int> = listNew();
    const newLines: List<Ref<LineCol>> = listNew();
    const siteLine = listGet(f.lines, sitePc) catch dummyLine();
    pc = 0;
    while (pc < listLen(f.code)) {
        if (pc == sitePc) {
            let i = 1;
            while (i <= nargs) {
                listPush(newCode, encABC(4, newbase + i, aSlot + i, 0)); // move
                listPush(newLines, siteLine);
                i = i + 1;
            }
            let j = nargs + 1;
            while (j < g.reg) {
                listPush(newCode, encABC(3, newbase + j, 0, 0)); // ldnone
                listPush(newLines, siteLine);
                j = j + 1;
            }
            gi = 0;
            while (gi < listLen(g.code)) {
                const gins = listGet(g.code, gi) catch 0;
                const gop = insOp(gins);
                const ga = insA(gins);
                const gb = insB(gins);
                const gc = insC(gins);
                let gline = siteLine;
                if (gi < listLen(g.lines)) { gline = listGet(g.lines, gi) catch siteLine; }
                if (gop == 33) { // ret 桥接
                    listPush(newCode, encABC(4, aSlot, newbase + ga, 0));
                    listPush(newLines, gline);
                    const cur = bodyBase + (listGet(gOff, gi) catch 0) + 1;
                    const sbx = contNew - cur - 1;
                    listPush(newCode, encAsBx(15, 0, sbx));
                    listPush(newLines, gline);
                } else if (gop == 15 || gop == 16 || gop == 17) {
                    const t = leafJumpTgt(gi, gins);
                    const newT = bodyBase + (listGet(gOff, t) catch 0);
                    const cur = bodyBase + (listGet(gOff, gi) catch 0);
                    const sbx = newT - cur - 1;
                    let slotOp = 0;
                    if (gop != 15) { slotOp = newbase + ga; }
                    listPush(newCode, encAsBx(gop, slotOp, sbx));
                    listPush(newLines, gline);
                } else if (gop == 1) { // loadk
                    let mapped = 0;
                    let ki = 0;
                    while (ki < listLen(constMapK)) {
                        if ((listGet(constMapK, ki) catch -1) == gi) { mapped = listGet(constMapV, ki) catch 0; break; }
                        ki = ki + 1;
                    }
                    listPush(newCode, encABx(1, newbase + ga, mapped));
                    listPush(newLines, gline);
                } else if (gop == 2) { // ldbool
                    listPush(newCode, encABC(2, newbase + ga, gb, 0));
                    listPush(newLines, gline);
                } else if (gop == 3) { // ldnone
                    listPush(newCode, encABC(3, newbase + ga, 0, 0));
                    listPush(newLines, gline);
                } else if ((gop >= 5 && gop <= 9) || (gop >= 12 && gop <= 14)) {
                    listPush(newCode, encABC(gop, leafMapSlot(newbase, ga), leafMapSlot(newbase, gb), leafMapSlot(newbase, gc)));
                    listPush(newLines, gline);
                } else {
                    listPush(newCode, encABC(gop, leafMapSlot(newbase, ga), leafMapSlot(newbase, gb), gc));
                    listPush(newLines, gline);
                }
                gi = gi + 1;
            }
            pc = pc + 1;
            continue;
        }
        const ins = listGet(f.code, pc) catch 0;
        const op = insOp(ins);
        let outIns = ins;
        if (op == 15 || op == 16 || op == 17) {
            const t = leafJumpTgt(pc, ins);
            const after = pc > sitePc;
            const tgtAfter = t > sitePc;
            if (!after && tgtAfter) {
                outIns = encAsBx(op, insA(ins), insSbx(ins) + delta);
            } else if (after && !tgtAfter) {
                outIns = encAsBx(op, insA(ins), insSbx(ins) - delta);
            }
        }
        listPush(newCode, outIns);
        listPush(newLines, listGet(f.lines, pc) catch siteLine);
        pc = pc + 1;
    }
    // switch jump_table 绝对目标重算。
    ci = 0;
    while (ci < listLen(newCode)) {
        const ins = listGet(newCode, ci) catch 0;
        if (insOp(ins) != 35) { ci = ci + 1; continue; }
        const bxi = insBx(ins);
        if (bxi >= listLen(f.consts)) { ci = ci + 1; continue; }
        const srcC = listGet(f.consts, bxi) catch dummyConst();
        if (srcC.tag != 5) { ci = ci + 1; continue; }
        const nt: List<int> = listNew();
        let ti = 0;
        while (ti < listLen(srcC.tbl)) {
            const t = listGet(srcC.tbl, ti) catch 0;
            let nt2 = t;
            if (t > sitePc) { nt2 = t + delta; }
            listPush(nt, nt2);
            ti = ti + 1;
        }
        listSet(newConsts, bxi, new Const { tag: 5, i: 0, fbits: 0, vi: 0, vlen: listLen(nt), tbl: nt });
        ci = ci + 1;
    }
    // 落位。
    f.code = newCode;
    f.lines = newLines;
    f.consts = newConsts;
    f.reg = newbase + g.reg;
    return 1;
}

// transformLeafInline（pgospec.zig :445-544 同构；维度 A/E 缺省开、C 关）。
function transformLeafInline(prog: Ref<Program>): void {
    let fi = 0;
    while (fi < listLen(prog.funcs)) {
        const f = listGet(prog.funcs, fi) catch dummyFn();
        if (listLen(f.code) == 0 || fnConservative(f)) { fi = fi + 1; continue; }
        const jumpInto = computeJumpInto(f);
        // 回边区域集。
        const loopRanges: List<List<int>> = listNew();
        let pc = 0;
        while (pc < listLen(f.code)) {
            const ins = listGet(f.code, pc) catch 0;
            if (insOp(ins) == 15) {
                const t = leafJumpTgt(pc, ins);
                if (t >= 0 && t <= pc) {
                    const rng: List<int> = listNew();
                    listPush(rng, t);
                    listPush(rng, pc);
                    listPush(loopRanges, rng);
                }
            }
            pc = pc + 1;
        }
        const candSite: List<int> = listNew();
        const candCallee: List<int> = listNew();
        pc = 0;
        while (pc < listLen(f.code)) {
            const ins = listGet(f.code, pc) catch 0;
            if (insOp(ins) != 30) { pc = pc + 1; continue; } // call
            const t = staticMonoTarget(prog, f, pc, jumpInto);
            if (t < 0) { pc = pc + 1; continue; }
            let inLoop = false;
            let ri = 0;
            while (ri < listLen(loopRanges)) {
                const rng = listGet(loopRanges, ri) catch emptyIntList();
                if (pc >= (listGet(rng, 0) catch 0) && pc <= (listGet(rng, 1) catch 0)) { inLoop = true; break; }
                ri = ri + 1;
            }
            if (!inLoop) { pc = pc + 1; continue; }
            const callee = listGet(prog.funcs, t) catch dummyFn();
            const sameModule = callee.module == f.module;
            if (calleePure(prog, callee, if1int(sameModule)) == 0) { pc = pc + 1; continue; }
            listPush(candSite, pc);
            listPush(candCallee, t);
            pc = pc + 1;
        }
        if (listLen(candSite) > 0) {
            // 维度记账：be_map（callee→回边）／per_callee／per_callee_range。
            const beK: List<int> = listNew();
            const beV: List<int> = listNew();
            const pcK: List<int> = listNew();
            const pcV: List<int> = listNew();
            const totK: List<int> = listNew();
            const totV: List<int> = listNew();
            let ci = 0;
            while (ci < listLen(candSite)) {
                const callee = listGet(candCallee, ci) catch 0;
                let rangeOf = -1;
                let ri = 0;
                while (ri < listLen(loopRanges)) {
                    const rng = listGet(loopRanges, ri) catch emptyIntList();
                    if ((listGet(candSite, ci) catch 0) >= (listGet(rng, 0) catch 0) && (listGet(candSite, ci) catch 0) <= (listGet(rng, 1) catch 0)) {
                        rangeOf = ri;
                        break;
                    }
                    ri = ri + 1;
                }
                // 维度 A：被调回边记账。
                let beFound = -1;
                let ki = 0;
                while (ki < listLen(beK)) {
                    if ((listGet(beK, ki) catch -1) == callee) { beFound = ki; break; }
                    ki = ki + 1;
                }
                if (beFound < 0) {
                    listPush(beK, callee);
                    listPush(beV, calleeHasBackedge(listGet(prog.funcs, callee) catch dummyFn()));
                }
                // per_callee_range 记账（key＝callee*2^32＋(rangeIdx&0xFFFFFFFF)）。
                let rangeBits = rangeOf;
                if (rangeBits < 0) { rangeBits = -1; }
                const key = callee * 4294967296 + (rangeBits & 0xFFFFFFFF);
                let kFound = -1;
                ki = 0;
                while (ki < listLen(pcK)) {
                    if ((listGet(pcK, ki) catch -1) == key) { kFound = ki; break; }
                    ki = ki + 1;
                }
                if (kFound < 0) {
                    listPush(pcK, key);
                    listPush(pcV, 1);
                } else {
                    listSet(pcV, kFound, (listGet(pcV, kFound) catch 0) + 1);
                }
                let tFound = -1;
                ki = 0;
                while (ki < listLen(totK)) {
                    if ((listGet(totK, ki) catch -1) == callee) { tFound = ki; break; }
                    ki = ki + 1;
                }
                if (tFound < 0) {
                    listPush(totK, callee);
                    listPush(totV, 1);
                } else {
                    listSet(totV, tFound, (listGet(totV, tFound) catch 0) + 1);
                }
                ci = ci + 1;
            }
            // 维度过滤＋展开（site 降序）。
            const keepSite: List<int> = listNew();
            const keepCallee: List<int> = listNew();
            ci = 0;
            while (ci < listLen(candSite)) {
                const callee = listGet(candCallee, ci) catch 0;
                let rangeOf = -1;
                let ri = 0;
                while (ri < listLen(loopRanges)) {
                    const rng = listGet(loopRanges, ri) catch emptyIntList();
                    if ((listGet(candSite, ci) catch 0) >= (listGet(rng, 0) catch 0) && (listGet(candSite, ci) catch 0) <= (listGet(rng, 1) catch 0)) { rangeOf = ri; break; }
                    ri = ri + 1;
                }
                // 维度 A：被调含回边即拒。
                let beV2 = 0;
                let ki = 0;
                while (ki < listLen(beK)) {
                    if ((listGet(beK, ki) catch -1) == callee) { beV2 = listGet(beV, ki) catch 0; break; }
                    ki = ki + 1;
                }
                if (beV2 == 1) { ci = ci + 1; continue; }
                // 维度 E：同被调同环站址 ≥2。
                const key = callee * 4294967296 + (rangeOf & 0xFFFFFFFF);
                let cnt = 0;
                ki = 0;
                while (ki < listLen(pcK)) {
                    if ((listGet(pcK, ki) catch -1) == key) { cnt = listGet(pcV, ki) catch 0; break; }
                    ki = ki + 1;
                }
                if (cnt < 2) { ci = ci + 1; continue; }
                listPush(keepSite, listGet(candSite, ci) catch 0);
                listPush(keepCallee, callee);
                ci = ci + 1;
            }
            if (listLen(keepSite) > 0 && listLen(keepSite) <= MAX_FN_EXPANSIONS) {
                // site 降序排序（简单选择排序——规模小）。
                let i = 0;
                while (i < listLen(keepSite)) {
                    let mx = i;
                    let j = i + 1;
                    while (j < listLen(keepSite)) {
                        if ((listGet(keepSite, j) catch 0) > (listGet(keepSite, mx) catch 0)) { mx = j; }
                        j = j + 1;
                    }
                    if (mx != i) {
                        const ts = listGet(keepSite, i) catch 0;
                        listSet(keepSite, i, listGet(keepSite, mx) catch 0);
                        listSet(keepSite, mx, ts);
                        const tc = listGet(keepCallee, i) catch 0;
                        listSet(keepCallee, i, listGet(keepCallee, mx) catch 0);
                        listSet(keepCallee, mx, tc);
                    }
                    i = i + 1;
                }
                ci = 0;
                while (ci < listLen(keepSite)) {
                    expandCallSite(prog, fi, listGet(keepSite, ci) catch 0, listGet(keepCallee, ci) catch 0);
                    ci = ci + 1;
                }
            }
        }
        fi = fi + 1;
    }
}

// ============================================================================
// §6 入口：recordDump（PROGDUMP → EMITMIRROR v2 记录流文本）
// ============================================================================

// msgs 模块态（recordDump 登记序导出面——S5-③ 批 E 尾：native 驱动数据段
// 消费 .Lmsg 标签文本；len 前缀协议 "n l1 m1 l2 m2 ..."）。
let recMsgs: List<string> = listNew();

export function recordMsgCount(): int { return listLen(recMsgs); }

// 第 i 条 trap 消息原文（len 为字节、byteAt 为字节——driver .byte 面直配）。
export function recordMsgAt(i: int): string {
    return listGet(recMsgs, i) catch "";
}

export function recordDump(dump: string): string {
    const prog = parseDump(dump);
    if (prog.entry == -2) { return "EMITMIRROR-REJECT E009 progdump"; }
    return recordOwnedProgram(prog);
}

function recordOwnedProgram(prog: Ref<Program>): string {
    const profiling = compileProfileActive();
    let started = 0; if (profiling) { started = compileProfileClock(); }
    transformLeafInline(prog); // leafinl 缺省开——zig 链发射前同序前置
    if (recBorrowOn) { recBorrowElig = borrowEligible(prog); } else { recBorrowElig = listNew(); }
    if (profiling) { compileProfileDetail("record-preparation", compileProfileClock() - started); }
    const msgs = new MsgReg { list: listNew() };
    const out: List<string> = listNew();
    // v3＝原生链记录：callbi 外部函数编号从 4096 起、getfld/setfld 字段选择子标志在第 15 位（TXC v6）。
    listPush(out, "emitmirror_v3");
    listPush(out, "target win64");
    listPush(out, "frame_pad " + dec(FRAME_PAD));
    listPush(out, "entry " + dec(prog.entry));
    let fi = 0;
    while (fi < listLen(prog.funcs)) {
        let first = 0; let t0 = 0;
        if (profiling) { first = listLen(out); t0 = compileProfileClock(); }
        dumpFunction(prog, fi, 1, out, msgs);
        if (profiling) {
            const ns = compileProfileClock() - t0;
            const f = listGet(prog.funcs, fi) catch dummyFn();
            compileProfileRecord(fi, out, first, listLen(f.code), ns);
        }
        fi = fi + 1;
    }
    recMsgs = msgs.list;
    // 分块均衡拼接（O(total×log n)——逐段全量拷贝为 O(n²)，taixu 规模
    // 50 万记录段下 AOT commit 爆——批 E 尾 3 执行发现；parser.tx 同构）。
    const n2 = listLen(out);
    if (n2 == 0) { return ""; }
    if (profiling) { started = compileProfileClock(); }
    const text = recJoinRange(out, 0, n2);
    if (profiling) {
        compileProfileDetail("record-join", compileProfileClock() - started);
        compileProfileRecordTotal(n2, len(text));
    }
    return text;
}

function recJoinRange(parts: List<string>, lo: int, hi: int): string {
    if (hi - lo == 1) {
        return (listGet(parts, lo) catch "") + "\n";
    }
    const mid = lo + (hi - lo) / 2;
    return recJoinRange(parts, lo, mid) + recJoinRange(parts, mid, hi);
}

// Context input; numeric facts never format/parse PROGDUMP here.
function ctxIntCopy(xs: List<int>): List<int> {
    const out: List<int> = listNew(); let i = 0;
    while (i < listLen(xs)) { listPush(out, listGet(xs, i) catch 0); i = i + 1; }
    return out;
}
function ctxStringBytes(s: string): List<int> {
    const out: List<int> = listNew(); let i = 0;
    while (i < len(s)) { listPush(out, byteAt(s, i) catch 0); i = i + 1; } return out;
}
function contextOwnedProgram(p: Ref<ProgramContext>): Ref<Program> {
    const st = new StrTab { bytes: listNew(), starts: listNew() }; listPush(st.starts, 0);
    const prog = new Program { tys: listNew(), decls: listNew(), funcs: listNew(), modules: listNew(), tests: listNew(), externs: listNew(), sigs: listNew(), st: st, entry: p.entry };
    let i = 0;
    while (i < listLen(p.cgStrings)) {
        const data = programStringBytes(p, i); let j = 0;
        while (j < bytesLen(data)) { listPush(st.bytes, bytesGet(data, j) catch 0); j = j + 1; }
        listPush(st.starts, listLen(st.bytes)); i = i + 1;
    }
    i = 0; while (i < listLen(p.cgTysK)) {
        listPush(prog.tys, new Ty { kind: listGet(p.cgTysK, i) catch 0, a: listGet(p.cgTysA, i) catch 0, b: listGet(p.cgTysB, i) catch 0 }); i = i + 1;
    }
    i = 0; let variantStart = 0;
    while (i < listLen(p.declMods)) {
        const d = new TypeDecl { module: listGet(p.declMods, i) catch 0, name: listGet(p.declNameIdx, i) catch 0, which: 1, fields: listNew(), variants: listNew() };
        if ((listGet(p.declIsEnum, i) catch 0) == 0) {
            const names = listGet(p.declFieldNames, i) catch emptyIntList(); const tys = listGet(p.declFieldTys, i) catch emptyIntList(); let j = 0;
            while (j < listLen(names)) { listPush(d.fields, new FieldDecl { name: listGet(names, j) catch 0, ty: listGet(tys, j) catch 0 }); j = j + 1; }
        } else {
            d.which = 2; const names = listGet(p.declVariantNames, i) catch emptyIntList(); const fns = listGet(p.declVarFNames, i) catch emptyIntList(); const tys = listGet(p.declVarFTys, i) catch emptyIntList(); let j = 0; let at = 0;
            while (j < listLen(names)) {
                const v = new VariantDecl { name: listGet(names, j) catch 0, fields: listNew() }; const nf = listGet(p.declVarFCnt, variantStart + j) catch 0; let k = 0;
                while (k < nf) { listPush(v.fields, new FieldDecl { name: listGet(fns, at) catch 0, ty: listGet(tys, at) catch 0 }); at = at + 1; k = k + 1; }
                listPush(d.variants, v); j = j + 1;
            }
            variantStart = variantStart + listLen(names);
        }
        listPush(prog.decls, d); i = i + 1;
    }
    i = 0; while (i < listLen(p.fnNameIdx)) {
        const f = new Fn { name: listGet(p.fnNameIdx, i) catch 0, module: listGet(p.fnModule, i) catch 0, reg: listGet(p.fnReg, i) catch 0, nparams: listGet(p.fnNparams, i) catch 0, code: ctxIntCopy(listGet(p.fnCode, i) catch emptyIntList()), consts: listNew(), lines: listNew(), ptys: ctxIntCopy(listGet(p.fnPtys, i) catch emptyIntList()), ret: listGet(p.fnRet, i) catch 0, landings: ctxIntCopy(listGet(p.fnLandings, i) catch emptyIntList()) };
        const ks = listGet(p.fnConstsK, i) catch emptyIntList(); const vs = listGet(p.fnConstsI, i) catch emptyIntList(); const tb = listGet(p.fnConstsTbl, i) catch emptyIntList(); const sz = listGet(p.fnConstsTblLen, i) catch emptyIntList(); let j = 0; let at = 0;
        while (j < listLen(ks)) {
            const tag = listGet(ks, j) catch 0; const value = listGet(vs, j) catch 0; const size = listGet(sz, j) catch 0;
            const c = new Const { tag: tag, i: 0, fbits: 0, vi: 0, vlen: 0, tbl: listNew() };
            if (tag == 2) { c.fbits = value; }
            else if (tag == 5) { c.vlen = size; let k = 0; while (k < size) { listPush(c.tbl, listGet(tb, at + k) catch 0); k = k + 1; } }
            else { c.i = value; if (tag == 7) { c.vi = listGet(tb, at + 1) catch 0; } else if (tag == 8) { c.vlen = listGet(tb, at + 1) catch 0; } }
            listPush(f.consts, c); at = at + size; j = j + 1;
        }
        const ll = listGet(p.fnLinesL, i) catch emptyIntList(); const lc = listGet(p.fnLinesC, i) catch emptyIntList(); j = 0;
        while (j < listLen(ll)) { listPush(f.lines, new LineCol { line: listGet(ll, j) catch 0, col: listGet(lc, j) catch 0 }); j = j + 1; }
        if (compileProfileActive()) { compileProfileBridge(i, listLen(f.code), listLen(f.consts), listLen(f.lines)); }
        listPush(prog.funcs, f); i = i + 1;
    }
    i = 0; while (i < listLen(p.modOutPath)) { listPush(prog.modules, new ModuleInfo { path: listGet(p.modOutPath, i) catch 0, state_ty: listGet(p.modOutState, i) catch 0, init_fn: listGet(p.modOutInit, i) catch 0 }); i = i + 1; }
    i = 0; while (i < listLen(p.testOutName)) { listPush(prog.tests, new TestEntry { name: listGet(p.testOutName, i) catch 0, func: listGet(p.testOutFunc, i) catch 0 }); i = i + 1; }
    i = 0; while (i < listLen(p.extNames)) { listPush(prog.externs, new ExternDecl { name: ctxStringBytes(listGet(p.extNames, i) catch ""), tags: ctxIntCopy(listGet(p.extTags, i) catch emptyIntList()), ret: listGet(p.extRets, i) catch 0 }); i = i + 1; }
    i = 0; while (i < listLen(p.fnSigDescs)) {
        const vals = listGet(p.fnSigDescs, i) catch emptyIntList(); const params: List<int> = listNew(); let j = 0;
        while (j + 1 < listLen(vals)) { listPush(params, listGet(vals, j) catch 0); j = j + 1; }
        listPush(prog.sigs, new FnSigDesc { ret: listGet(vals, j) catch 0, params: params }); i = i + 1;
    }
    return prog;
}
export function recordProgramContext(p: Ref<ProgramContext>): string {
    recMsgs = listNew();
    if (!programContextValid(p)) { return "EMITMIRROR-REJECT E009 progdump"; }
    let t0 = 0; if (compileProfileActive()) { t0 = compileProfileClock(); }
    const owned = contextOwnedProgram(p);
    if (compileProfileActive()) { compileProfileDetail("record-bridge", compileProfileClock() - t0); }
    return recordOwnedProgram(owned);
}
