// Numeric/bit/unary algorithms; status and diagnostics are separate.
import { StructuredBuffer, asStructuredMissing } from "./assemble";
import { nr, nd, nb, nx, ni, nm, nmd, nmb, nt, nmov, nl, nj, nret, no } from "./native_emit";
import { fwOpsEmit } from "./scalar_fw";
export function scalarOpsEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_sb";
    nl(b, "__tx_native_scalar_binary_v1");
    nmov(b, nd(1), nd(1)); nt(b, "movzx", nd(10), nmb(2, 0)); nt(b, "movzx", nd(11), nmb(8, 0));
    nt(b, "cmp", nd(10), nd(11)); nj(b, "jne", p + "_type");
    nt(b, "cmp", nd(10), ni(2)); nj(b, "je", p + "_float");
    nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type");
    nmov(b, nr(10), nm(2, 8)); nmov(b, nr(11), nm(8, 8));
    // All input bytes needed later are snapshotted before any output write.
    nt(b, "cmp", nd(1), ni(5)); nj(b, "je", p + "_add");
    nt(b, "cmp", nd(1), ni(6)); nj(b, "je", p + "_sub");
    nt(b, "cmp", nd(1), ni(7)); nj(b, "je", p + "_mul");
    nt(b, "cmp", nd(1), ni(8)); nj(b, "je", p + "_div");
    nt(b, "cmp", nd(1), ni(9)); nj(b, "je", p + "_mod");
    nt(b, "cmp", nd(1), ni(12)); nj(b, "je", p + "_eq");
    nt(b, "cmp", nd(1), ni(13)); nj(b, "je", p + "_lt");
    nt(b, "cmp", nd(1), ni(14)); nj(b, "je", p + "_le");
    nt(b, "cmp", nd(1), ni(40)); nj(b, "je", p + "_and");
    nt(b, "cmp", nd(1), ni(41)); nj(b, "je", p + "_or");
    nt(b, "cmp", nd(1), ni(42)); nj(b, "je", p + "_xor");
    nt(b, "cmp", nd(1), ni(44)); nj(b, "je", p + "_shl");
    nt(b, "cmp", nd(1), ni(45)); nj(b, "je", p + "_shr");
    nt(b, "cmp", nd(1), ni(46)); nj(b, "je", p + "_sar");
    nt(b, "cmp", nd(1), ni(47)); nj(b, "je", p + "_imul");
    nj(b, "jmp", p + "_unsupported");
    nl(b, p + "_add"); nt(b, "add", nr(10), nr(11)); nj(b, "jo", p + "_overflow"); nj(b, "jmp", p + "_int");
    nl(b, p + "_sub"); nt(b, "sub", nr(10), nr(11)); nj(b, "jo", p + "_overflow"); nj(b, "jmp", p + "_int");
    nl(b, p + "_mul"); nt(b, "imul", nr(10), nr(11)); nj(b, "jo", p + "_overflow"); nj(b, "jmp", p + "_int");
    nl(b, p + "_and"); nt(b, "and", nr(10), nr(11)); nj(b, "jmp", p + "_int");
    nl(b, p + "_or"); nt(b, "or", nr(10), nr(11)); nj(b, "jmp", p + "_int");
    nl(b, p + "_xor"); nt(b, "xor", nr(10), nr(11)); nj(b, "jmp", p + "_int");
    nl(b, p + "_imul"); nt(b, "imul", nr(10), nr(11)); nj(b, "jmp", p + "_int");
    nl(b, p + "_shl"); nt(b, "cmp", nr(11), ni(63)); nj(b, "ja", p + "_shift"); nmov(b, nd(1), nd(11)); nt(b, "shl", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    nl(b, p + "_shr"); nt(b, "cmp", nr(11), ni(63)); nj(b, "ja", p + "_shift"); nmov(b, nd(1), nd(11)); nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    nl(b, p + "_sar"); nt(b, "cmp", nr(11), ni(63)); nj(b, "ja", p + "_shift"); nmov(b, nd(1), nd(11)); nt(b, "sar", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    nl(b, p + "_div"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_zero");
    nt(b, "movabs", nr(0), ni(-9223372036854775807 - 1)); nt(b, "cmp", nr(10), nr(0)); nj(b, "jne", p + "_div_do"); nt(b, "cmp", nr(11), ni(-1)); nj(b, "jne", p + "_div_do");
    nj(b, "jmp", p + "_overflow");
    nl(b, p + "_div_do"); nmov(b, nr(0), nr(10)); no(b, "cqo", 0, asStructuredMissing(), asStructuredMissing()); no(b, "idiv", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(0)); nj(b, "jmp", p + "_int");
    nl(b, p + "_mod"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_zero");
    nt(b, "movabs", nr(0), ni(-9223372036854775807 - 1)); nt(b, "cmp", nr(10), nr(0)); nj(b, "jne", p + "_mod_do"); nt(b, "cmp", nr(11), ni(-1)); nj(b, "jne", p + "_mod_do");
    nmov(b, nr(10), ni(0)); nj(b, "jmp", p + "_int");
    nl(b, p + "_mod_do"); nmov(b, nr(0), nr(10)); no(b, "cqo", 0, asStructuredMissing(), asStructuredMissing()); no(b, "idiv", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(2)); nj(b, "jmp", p + "_int");
    nl(b, p + "_eq"); nt(b, "cmp", nr(10), nr(11)); no(b, "sete", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_lt"); nt(b, "cmp", nr(10), nr(11)); no(b, "setl", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_le"); nt(b, "cmp", nr(10), nr(11)); no(b, "setle", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_float"); nt(b, "movsd", nx(0), nm(2, 8)); nt(b, "movsd", nx(1), nm(8, 8));
    nt(b, "cmp", nd(1), ni(5)); nj(b, "je", p + "_fadd");
    nt(b, "cmp", nd(1), ni(6)); nj(b, "je", p + "_fsub");
    nt(b, "cmp", nd(1), ni(7)); nj(b, "je", p + "_fmul");
    nt(b, "cmp", nd(1), ni(8)); nj(b, "je", p + "_fdiv");
    nt(b, "cmp", nd(1), ni(12)); nj(b, "je", p + "_feq");
    nt(b, "cmp", nd(1), ni(13)); nj(b, "je", p + "_flt");
    nt(b, "cmp", nd(1), ni(14)); nj(b, "je", p + "_fle");
    nj(b, "jmp", p + "_type");
    nl(b, p + "_fadd"); nt(b, "addsd", nx(0), nx(1)); nt(b, "movq", nr(10), nx(0)); nmov(b, nr(0), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_fsub"); nt(b, "subsd", nx(0), nx(1)); nt(b, "movq", nr(10), nx(0)); nmov(b, nr(0), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_fmul"); nt(b, "mulsd", nx(0), nx(1)); nt(b, "movq", nr(10), nx(0)); nmov(b, nr(0), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_fdiv"); nt(b, "divsd", nx(0), nx(1)); nt(b, "movq", nr(10), nx(0)); nmov(b, nr(0), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_feq"); nt(b, "ucomisd", nx(0), nx(1)); nj(b, "jp", p + "_false"); no(b, "sete", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_flt"); nt(b, "ucomisd", nx(0), nx(1)); nj(b, "jp", p + "_false"); no(b, "setb", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_fle"); nt(b, "ucomisd", nx(0), nx(1)); nj(b, "jp", p + "_false"); no(b, "setbe", 1, nb(10), asStructuredMissing()); nt(b, "movzx", nd(10), nb(10)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_false"); nmov(b, nr(10), ni(0)); nj(b, "jmp", p + "_bool");
    nl(b, p + "_int"); nmov(b, nr(0), ni(1)); nj(b, "jmp", p + "_write");
    nl(b, p + "_bool"); nmov(b, nr(0), ni(3));
    nl(b, p + "_write"); nmov(b, nm(9, 0), nr(0)); nmov(b, nm(9, 8), nr(10)); nmov(b, nr(0), ni(0)); nret(b);
    nl(b, p + "_type"); nmov(b, nr(0), ni(1)); nret(b);
    nl(b, p + "_overflow"); nmov(b, nr(0), ni(2)); nret(b);
    nl(b, p + "_zero"); nmov(b, nr(0), ni(3)); nret(b);
    nl(b, p + "_shift"); nmov(b, nr(0), ni(4)); nret(b);
    nl(b, p + "_unsupported"); nmov(b, nr(0), ni(5)); nret(b);
    p = "__tx_su"; nl(b, "__tx_native_scalar_unary_v1"); nmov(b, nd(1), nd(1)); nt(b, "movzx", nd(10), nmb(2, 0)); nmov(b, nr(11), nm(2, 8));
    nt(b, "cmp", nd(1), ni(100)); nj(b, "jae", p + "_cvt"); // 定宽数值转换（op＝100＋种类，见 cvtOpsEmit）
    nt(b, "cmp", nd(1), ni(36)); nj(b, "je", p + "_i2f"); nt(b, "cmp", nd(1), ni(37)); nj(b, "je", p + "_f2i");
    nt(b, "cmp", nd(1), ni(11)); nj(b, "je", p + "_not"); nt(b, "cmp", nd(1), ni(43)); nj(b, "je", p + "_bnot"); nt(b, "cmp", nd(1), ni(10)); nj(b, "jne", p + "_type");
    nt(b, "cmp", nd(10), ni(2)); nj(b, "je", p + "_fneg"); nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type"); no(b, "neg", 1, nr(11), asStructuredMissing()); nj(b, "jo", p + "_overflow"); nj(b, "jmp", p + "_write");
    nl(b, p + "_fneg"); nt(b, "movabs", nr(0), ni(-9223372036854775807 - 1)); nt(b, "xor", nr(11), nr(0)); nj(b, "jmp", p + "_write");
    nl(b, p + "_not"); nt(b, "cmp", nd(10), ni(3)); nj(b, "jne", p + "_type"); nt(b, "test", nr(11), nr(11)); no(b, "sete", 1, nb(11), asStructuredMissing()); nt(b, "movzx", nd(11), nb(11)); nj(b, "jmp", p + "_write");
    nl(b, p + "_bnot"); nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type"); no(b, "not", 1, nr(11), asStructuredMissing());
    nl(b, p + "_write"); nmov(b, nm(8, 0), nr(10)); nmov(b, nm(8, 8), nr(11)); nmov(b, nr(0), ni(0)); nret(b);
    // IEEE binary64 decomposition avoids conversion UB and any extra ISA requirement.
    nl(b, p + "_i2f"); nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type"); nt(b, "cvtsi2sd", nx(0), nr(11)); nt(b, "movq", nr(11), nx(0)); nmov(b, nd(10), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_f2i"); nt(b, "cmp", nd(10), ni(2)); nj(b, "jne", p + "_type");
    nmov(b, nr(0), nr(11)); nt(b, "shr", nr(0), ni(52)); nt(b, "and", nd(0), ni(2047));
    nt(b, "cmp", nd(0), ni(1023)); nj(b, "jb", p + "_fzero");
    nt(b, "cmp", nd(0), ni(1086)); nj(b, "ja", p + "_convert_overflow"); nj(b, "je", p + "_min");
    nmov(b, nr(2), nr(11)); nt(b, "shr", nr(2), ni(63));
    nt(b, "movabs", nr(1), ni(4503599627370495)); nt(b, "and", nr(11), nr(1)); nt(b, "movabs", nr(1), ni(4503599627370496)); nt(b, "or", nr(11), nr(1));
    nt(b, "cmp", nd(0), ni(1075)); nj(b, "jae", p + "_fleft");
    nmov(b, nd(1), ni(1075)); nt(b, "sub", nd(1), nd(0)); nt(b, "shr", nr(11), nb(1)); nj(b, "jmp", p + "_fsign");
    nl(b, p + "_fleft"); nmov(b, nd(1), nd(0)); nt(b, "sub", nd(1), ni(1075)); nt(b, "shl", nr(11), nb(1));
    nl(b, p + "_fsign"); nt(b, "test", nr(2), nr(2)); nj(b, "jz", p + "_fint"); no(b, "neg", 1, nr(11), asStructuredMissing()); nj(b, "jmp", p + "_fint");
    nl(b, p + "_min"); nt(b, "movabs", nr(0), ni(-4332462841530417152)); nt(b, "cmp", nr(11), nr(0)); nj(b, "jne", p + "_convert_overflow"); nt(b, "movabs", nr(11), ni(-9223372036854775807 - 1)); nj(b, "jmp", p + "_fint");
    nl(b, p + "_fzero"); nmov(b, nr(11), ni(0));
    nl(b, p + "_fint"); nmov(b, nd(10), ni(1)); nj(b, "jmp", p + "_write");
    nl(b, p + "_convert_overflow"); nmov(b, nr(0), ni(6)); nret(b);
    nl(b, p + "_overflow"); nmov(b, nr(0), ni(2)); nret(b); nl(b, p + "_type"); nmov(b, nr(0), ni(1)); nret(b);
    cvtOpsEmit(b, p);
    fwOpsEmit(b);
}

// 定宽数值转换（docs/design/v052-fixed-width-numerics-v0.1-20261015.md §五-3；字节码 cvt＝52，C＝种类）。
// 入口同一元：ecx＝100＋种类，r10d＝源标签，r11＝源载荷，r8＝出口槽；成功经 _write 写回。
// 种类：1..6 收窄检查到 i8/i16/i32/u8/u16/u32，7 非负检查（int 与 u64/usize 互转），越界状态 9；
// 8..13 wrapTo 截断到同序六种；14 整数→f32，15 u64→float，16 u64→f32；17 float→f32（有限值溢出状态 9）；
// 18..23 同 1..6 但用于浮点转来的值（越界状态 6，同 f2i）；24 float→u64（越界、NaN 状态 6）；
// 25 floatToBits（float 的位模式作 int）、26 floatFromBits（int 的位模式作 float）——只换标签。
function cvtOpsEmit(b: Ref<StructuredBuffer>, p: string): void {
    nl(b, p + "_cvt"); nt(b, "sub", nd(1), ni(100));
    nt(b, "cmp", nd(1), ni(25)); nj(b, "je", p + "_c_fbits");
    nt(b, "cmp", nd(1), ni(26)); nj(b, "je", p + "_c_bitsf");
    nt(b, "cmp", nd(1), ni(17)); nj(b, "je", p + "_c_f2f32");
    nt(b, "cmp", nd(1), ni(24)); nj(b, "je", p + "_c_f2u");
    nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type");
    nmov(b, nd(2), ni(9));
    nt(b, "cmp", nd(1), ni(7)); nj(b, "je", p + "_c_nonneg");
    nt(b, "cmp", nd(1), ni(14)); nj(b, "je", p + "_c_i2f32");
    nt(b, "cmp", nd(1), ni(15)); nj(b, "je", p + "_c_u2f");
    nt(b, "cmp", nd(1), ni(16)); nj(b, "je", p + "_c_u2f32");
    nt(b, "cmp", nd(1), ni(8)); nj(b, "je", p + "_c_w8");
    nt(b, "cmp", nd(1), ni(9)); nj(b, "je", p + "_c_w16");
    nt(b, "cmp", nd(1), ni(10)); nj(b, "je", p + "_c_w32");
    nt(b, "cmp", nd(1), ni(11)); nj(b, "je", p + "_c_wu8");
    nt(b, "cmp", nd(1), ni(12)); nj(b, "je", p + "_c_wu16");
    nt(b, "cmp", nd(1), ni(13)); nj(b, "je", p + "_c_wu32");
    nt(b, "cmp", nd(1), ni(18)); nj(b, "jb", p + "_c_rng");
    nmov(b, nd(2), ni(6)); nt(b, "sub", nd(1), ni(17));
    nl(b, p + "_c_rng");
    cvtRange(b, p, 1, -128, 127); cvtRange(b, p, 2, -32768, 32767); cvtRange(b, p, 3, -2147483647 - 1, 2147483647);
    cvtRange(b, p, 4, 0, 255); cvtRange(b, p, 5, 0, 65535); cvtRange(b, p, 6, 0, 4294967295);
    nj(b, "jmp", p + "_type");
    nl(b, p + "_c_nonneg"); nt(b, "test", nr(11), nr(11)); nj(b, "js", p + "_c_fail"); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_w8"); nt(b, "shl", nr(11), ni(56)); nt(b, "sar", nr(11), ni(56)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_w16"); nt(b, "shl", nr(11), ni(48)); nt(b, "sar", nr(11), ni(48)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_w32"); nt(b, "shl", nr(11), ni(32)); nt(b, "sar", nr(11), ni(32)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_wu8"); nt(b, "and", nr(11), ni(255)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_wu16"); nt(b, "and", nr(11), ni(65535)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_wu32"); nmov(b, nd(11), nd(11)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_i2f32"); nt(b, "cvtsi2ss", nx(0), nr(11)); nt(b, "cvtss2sd", nx(0), nx(0)); nj(b, "jmp", p + "_c_float");
    // 无符号 64 位：最高位为 0 直接转；否则取半（保留最低位防双重舍入）转后加倍。
    nl(b, p + "_c_u2f"); nt(b, "test", nr(11), nr(11)); nj(b, "js", p + "_c_u2f_hi"); nt(b, "cvtsi2sd", nx(0), nr(11)); nj(b, "jmp", p + "_c_float");
    nl(b, p + "_c_u2f_hi"); cvtHalve(b); nt(b, "cvtsi2sd", nx(0), nr(0)); nt(b, "addsd", nx(0), nx(0)); nj(b, "jmp", p + "_c_float");
    nl(b, p + "_c_u2f32"); nt(b, "test", nr(11), nr(11)); nj(b, "js", p + "_c_u2f32_hi"); nt(b, "cvtsi2ss", nx(0), nr(11)); nt(b, "cvtss2sd", nx(0), nx(0)); nj(b, "jmp", p + "_c_float");
    nl(b, p + "_c_u2f32_hi"); cvtHalve(b); nt(b, "cvtsi2ss", nx(0), nr(0)); nt(b, "addss", nx(0), nx(0)); nt(b, "cvtss2sd", nx(0), nx(0)); nj(b, "jmp", p + "_c_float");
    // float→f32：结果为 ±inf/NaN 而源有限即溢出（状态 9）；源本身为 inf/NaN 原样通过。
    nl(b, p + "_c_f2f32"); nt(b, "cmp", nd(10), ni(2)); nj(b, "jne", p + "_type");
    nt(b, "movq", nx(0), nr(11)); nt(b, "cvtsd2ss", nx(1), nx(0)); nt(b, "cvtss2sd", nx(1), nx(1)); nt(b, "movq", nr(0), nx(1));
    nmov(b, nr(1), nr(0)); nt(b, "shr", nr(1), ni(52)); nt(b, "and", nd(1), ni(2047)); nt(b, "cmp", nd(1), ni(2047)); nj(b, "jne", p + "_c_f2f32_ok");
    nmov(b, nr(1), nr(11)); nt(b, "shr", nr(1), ni(52)); nt(b, "and", nd(1), ni(2047)); nt(b, "cmp", nd(1), ni(2047)); nj(b, "je", p + "_c_f2f32_ok");
    nmov(b, nd(2), ni(9)); nj(b, "jmp", p + "_c_fail");
    nl(b, p + "_c_f2f32_ok"); nmov(b, nr(11), nr(0)); nmov(b, nd(10), ni(2)); nj(b, "jmp", p + "_write");
    // float→u64：|x|<1 得 0；负数、NaN、≥2^64 状态 6；其余按 IEEE 分解移位（同 f2i，不依赖截断指令）。
    nl(b, p + "_c_f2u"); nt(b, "cmp", nd(10), ni(2)); nj(b, "jne", p + "_type"); nmov(b, nd(2), ni(6));
    nmov(b, nr(0), nr(11)); nt(b, "shr", nr(0), ni(52)); nt(b, "and", nd(0), ni(2047));
    nt(b, "cmp", nd(0), ni(1023)); nj(b, "jb", p + "_c_f2u_zero");
    nt(b, "test", nr(11), nr(11)); nj(b, "js", p + "_c_fail");
    nt(b, "cmp", nd(0), ni(1086)); nj(b, "ja", p + "_c_fail");
    nt(b, "movabs", nr(1), ni(4503599627370495)); nt(b, "and", nr(11), nr(1)); nt(b, "movabs", nr(1), ni(4503599627370496)); nt(b, "or", nr(11), nr(1));
    nt(b, "cmp", nd(0), ni(1075)); nj(b, "jae", p + "_c_f2u_left");
    nmov(b, nd(1), ni(1075)); nt(b, "sub", nd(1), nd(0)); nt(b, "shr", nr(11), nb(1)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_f2u_left"); nmov(b, nd(1), nd(0)); nt(b, "sub", nd(1), ni(1075)); nt(b, "shl", nr(11), nb(1)); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_f2u_zero"); nmov(b, nr(11), ni(0));
    nl(b, p + "_c_fbits"); nt(b, "cmp", nd(10), ni(2)); nj(b, "jne", p + "_type"); nj(b, "jmp", p + "_c_int");
    nl(b, p + "_c_bitsf"); nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type"); nmov(b, nd(10), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_c_int"); nmov(b, nd(10), ni(1)); nj(b, "jmp", p + "_write");
    nl(b, p + "_c_float"); nt(b, "movq", nr(11), nx(0)); nmov(b, nd(10), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_c_fail"); nmov(b, nd(0), nd(2)); nret(b);
}

// 范围检查一臂：种类为 kind 时检查 r11 ∈ [lo, hi]（有符号比较），越界走 _c_fail（状态在 edx）。
function cvtRange(b: Ref<StructuredBuffer>, p: string, kind: int, lo: int, hi: int): void {
    const skip = p + "_c_r" + toStr(kind);
    nt(b, "cmp", nd(1), ni(kind)); nj(b, "jne", skip);
    nt(b, "movabs", nr(0), ni(lo)); nt(b, "cmp", nr(11), nr(0)); nj(b, "jl", p + "_c_fail");
    nt(b, "movabs", nr(0), ni(hi)); nt(b, "cmp", nr(11), nr(0)); nj(b, "jg", p + "_c_fail");
    nj(b, "jmp", p + "_c_int");
    nl(b, skip);
}

// r0 ← (r11 >>> 1) | (r11 & 1)：无符号值取半且保留粘滞位，转浮点后加倍得正确舍入。
function cvtHalve(b: Ref<StructuredBuffer>): void {
    nmov(b, nr(0), nr(11)); nt(b, "shr", nr(0), ni(1)); nmov(b, nr(1), nr(11)); nt(b, "and", nr(1), ni(1)); nt(b, "or", nr(0), nr(1));
}
