import { DerValue, derRead, derContents, derChildren, derPositiveInteger, derBitString } from "std/crypto/der";
import { p256Hex } from "std/crypto/p256_field";
import { constantTimeEqual } from "std/crypto/subtle";

function rejected(text: string): bool { const b = p256Hex(text); derRead(b, 0, bytesLen(b)) catch (e) { return true; }; return false; }
function prefixFails(b: Bytes): bool { derRead(b, 0, bytesLen(b)) catch (e) { return true; }; return false; }
function integerFails(text: string, limit: int): bool {
    const b = p256Hex(text); const v = derRead(b, 0, bytesLen(b)) catch panic("integer fixture");
    derPositiveInteger(b, v, limit) catch (e) { return true; }; return false;
}
function bitsFail(text: string): bool {
    const b = p256Hex(text); const v = derRead(b, 0, bytesLen(b)) catch panic("bits fixture"); derBitString(b, v) catch (e) { return true; }; return false;
}

test "DER：定长、子节点、内容与余量" {
    const raw = p256Hex("300602010002017f0500"); const outer = derRead(raw, 0, bytesLen(raw)) catch panic("outer");
    assert(outer.tag == 48 && outer.start == 0 && outer.content == 2 && outer.end == 8, "node range");
    const children = derChildren(raw, outer, 2) catch panic("children"); assert(listLen(children) == 2, "child count");
    assert(constantTimeEqual(derPositiveInteger(raw, listGet(children, 0), 1) catch panic("zero"), bytesNew(1)), "integer zero");
    assert(constantTimeEqual(derContents(raw, outer) catch panic("contents"), p256Hex("02010002017f")), "raw content");
    assert((derRead(raw, outer.end, bytesLen(raw)) catch panic("next")).tag == 5, "next node remains");
    const large = bytesNew(131); bytesSet(large, 0, 4); bytesSet(large, 1, 129); bytesSet(large, 2, 128);
    const v = derRead(large, 0, bytesLen(large)) catch panic("long length"); assert(v.content == 3 && v.end == 131, "minimal long length");
    let i = 0;
    while (i < bytesLen(large)) {
        const prefix = bytesSlice(large, 0, i);
        assert(prefixFails(prefix), "truncation " + toStr(i)); i = i + 1;
    }
}

function childLimitFails(): bool {
    const raw = p256Hex("3006020101020102"); const v = derRead(raw, 0, bytesLen(raw)) catch panic("node");
    derChildren(raw, v, 1) catch (e) { return true; }; return false;
}

test "DER：非法长度、范围与整数拒绝" {
    for (text in ["", "04", "0000", "2000", "1f00", "04800000", "048100", "04817f", "04820080", "0489010000000000000000", "0488ffffffffffffffff", "0402ff"]) {
        assert(rejected(text), "bad DER " + text);
    }
    assert(childLimitFails(), "children limit");
    for (text in ["0200", "020180", "0201ff", "0202007f", "02020000", "220100", "040101"]) { assert(integerFails(text, 32), "bad integer " + text); }
    assert(integerFails("02020100", 1) && integerFails("020101", 0), "integer limit");
    const positive = p256Hex("02020080");
    assert(constantTimeEqual(derPositiveInteger(positive, derRead(positive, 0, 4) catch panic("node"), 1) catch panic("positive"), p256Hex("80")), "required sign zero trimmed");
}

test "DER：BIT STRING 的未用位" {
    const raw = p256Hex("030203a8"); const b = derBitString(raw, derRead(raw, 0, 4) catch panic("node")) catch panic("bits");
    assert(b.unused == 3 && constantTimeEqual(b.data, p256Hex("a8")), "valid bits");
    assert(bitsFail("0300") && bitsFail("030108") && bitsFail("030103") && bitsFail("030203a9") && bitsFail("040100"), "invalid bits");
}
