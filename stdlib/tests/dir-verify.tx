// ============================================================================
// stdlib 验证：std/dir makeDirAll（D3 v0.17 makeDir 递归层；verify ⑤ 段——
// 落盘产物 taixu-dir.tmp 由 verify 收尾清理）。
// ============================================================================

import { makeDirAll } from "std/dir";

function main(args: []string): int {
    makeDirAll("taixu-dir.tmp/a/b/c") catch (e) {
        print("deep-failed:" + e.message);
        return 1;
    };
    print("deep:" + toStr(entryKind("taixu-dir.tmp/a/b/c")));
    // 幂等：再建一次（带尾分隔符）。
    makeDirAll("taixu-dir.tmp/a/b/c/") catch (e) {
        print("again-failed:" + e.message);
        return 1;
    };
    // 非目录占位：在文件之下建目录得 Error。
    writeFile("taixu-dir.tmp/file", "x") catch (e) {
        print("write-failed:" + e.message);
        return 1;
    };
    makeDirAll("taixu-dir.tmp/file/sub") catch (e) {
        print("under-file:error");
        return 0;
    };
    print("under-file:unexpected-success");
    return 1;
}
