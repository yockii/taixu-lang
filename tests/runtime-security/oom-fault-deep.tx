// 取页失败注入扫描的第二个负载（docs/design/v052-oom-fault-v0.1-20261025.md）：oom-sweep.tx 走不到的取页点——值槽栈按需提交
// （深递归，主线程与新线程各一次）、大块分配与大块缓存、跨线程发送（闭包捕获的列表深拷贝进新线程、字符串结果拷回）。
// 结局合同同 oom-sweep.tx：完整跑完并打印同一校验和，或按既定的致命 OOM 退出（退出码 3、“taixu: 内存不足”）。
function depth(n: int): int {
    if (n == 0) {
        return 0;
    }
    return depth(n - 1) + 1;
}

function weigh(items: List<string>): int {
    let total = 0;
    for (x in items) {
        total = total + len(x);
    }
    return total;
}

function main(args: []string): int {
    let total = depth(30000);
    let round = 0;
    while (round < 3) {
        const big = bytesNew(3145728 + round * 65536);
        bytesSet(big, bytesLen(big) - 1, 7);
        total = total + bytesLen(big) + (bytesGet(big, bytesLen(big) - 1) ?? 0);
        round = round + 1;
    }
    const items: List<string> = listNew();
    let i = 0;
    while (i < 300) {
        listPush(items, "item-" + toStr(i));
        i = i + 1;
    }
    const worker = threadSpawn((): string => {
            return toStr(weigh(items)) + "/" + toStr(depth(30000));
        });
    // 线程建不起来（系统层或新线程的区域分配失败）时 threadJoin 得错误值（附录 A）：换本线程算同一个值，校验和不变。
    let part = threadJoin(worker) catch "";
    if (len(part) == 0) {
        print("JOIN_FAILED");
        part = toStr(weigh(items)) + "/" + toStr(depth(30000));
    }
    print("PASS_OOM_DEEP " + toStr(total) + " " + part);
    return 0;
}
