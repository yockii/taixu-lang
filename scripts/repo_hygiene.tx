// 原生仓库的行尾、行数、导入边界，编译器、预置库与标准库只含太虚源码，以及编译器嵌入的内核名单与目标表一致的检查。另有导入边界规则
// 与内核名单核对的自检。
// 用法：taixu run --toolchain scripts/repo_hygiene.tx [--root <仓库>] [--only eol|linecount|edges|independent|pure|kernels|selftest|all]
import { READ_MAX, deleteTree, findInPath, kindOf, mkdirs, nat, onWindows } from "./build_lib";
import { osRealPath } from "./build_os";
import { captureRaw } from "./test_lib";
import { slashes } from "./test_text";
import { kernelFile } from "./targets";
import { tElfObjects, targetName } from "../bootstrap/selfhost/target";

const SEC: int = 1000000000;
// 不带 Git 时遍历跳过的目录。
const IGNORED: []string = [".git", ".tools", "work", ".tmp", "__pycache__", "node_modules", "dist"];
// 只许太虚源码的目录（标准库在公开仓里位于 stdlib/）。
const PURE: []string = ["bootstrap/", "prelude/", "stdlib/src/"];
// 独立判定器：判定器连同传递导入都不得进 bootstrap/——编译器的错
// 不能同时出现在被测物与判定器两边。
// 太虚门步读编译器输出所用的 JSON 解析与文本工具（test_json.tx、test_text.tx）同样不得借编译器自己的实现。
// 协议端到端的客户端（test_proto.tx、test_lsp_session.tx）解析服务的回复，同样不得与服务端共用 json_parse.tx；复现 Python 随机
// 序列的 test_random.tx 也是判定一侧的件。链接映射、函数范围与对象 fuzz 的独立结构（check_obj.tx 夹具与映像布局、check_frames.tx 帧解码、
// check_txfn.tx 函数目录、check_macho_pair.tx 的 Mach-O 与 ELF 对照）同属判定器。
const INDEPENDENT: []string = ["scripts/check_lib.tx", "scripts/macho_check.tx", "scripts/pe_arm64_check.tx", "scripts/test_json.tx",
    "scripts/test_text.tx", "scripts/test_proto.tx", "scripts/test_jv.tx", "scripts/test_lsp_session.tx", "scripts/test_random.tx",
    "scripts/check_obj.tx", "scripts/check_frames.tx", "scripts/check_txfn.tx", "scripts/check_macho_pair.tx"];
const BASIC: []string = ["lexer.tx", "parser.tx", "semamirror.tx", "runtime_memory_gen.tx"];
const COMMANDS: []string = ["taixu.tx", "driver.tx", "lsp.tx", "dap.tx", "mcp.tx", "init.tx", "ana_dev.tx"];

// ---- 路径（一律 / 分隔；Windows 上为 E:/… 形态）----

// s 里 from 起的 n 个字节。
function piece(s: string, from: int, n: int): string {
    return strSlice(s, from, from + n);
}

function strs(a: []string): List<string> {
    const out: List<string> = listNew();
    for (x in a) {
        listPush(out, x);
    }
    return out;
}

function has(xs: []string, x: string): bool {
    for (y in xs) {
        if (y == x) {
            return true;
        }
    }
    return false;
}

function startsWith(s: string, prefix: string): bool {
    return len(s) >= len(prefix) && piece(s, 0, len(prefix)) == prefix;
}

function endsWith(s: string, suffix: string): bool {
    return len(s) >= len(suffix) && piece(s, len(s) - len(suffix), len(suffix)) == suffix;
}

function lastSlash(p: string): int {
    let i = len(p) - 1;
    while (i >= 0) {
        if ((byteAt(p, i) ?? 0) == 47) {
            return i;
        }
        i = i - 1;
    }
    return -1;
}

function parentOf(p: string): string {
    const i = lastSlash(p);
    if (i < 0) {
        return "";
    }
    return piece(p, 0, i);
}

function nameOf(p: string): string {
    const i = lastSlash(p);
    return piece(p, i + 1, len(p) - i - 1);
}

// 同 Python 的 PurePath.suffix：最后一个点不在开头、也不在结尾时取点起的部分。
function suffixOf(name: string): string {
    let i = len(name) - 1;
    while (i >= 0 && (byteAt(name, i) ?? 0) != 46) {
        i = i - 1;
    }
    if (i > 0 && i < len(name) - 1) {
        return piece(name, i, len(name) - i);
    }
    return "";
}

function stemOf(name: string): string {
    return piece(name, 0, len(name) - len(suffixOf(name)));
}

// 按字面合并 . 与 ..（路径都从取过真实路径的根拼出，仓库里不跟链接）。
function normPath(p: string): string {
    const parts: List<string> = listNew();
    let start = 0;
    let i = 0;
    while (i <= len(p)) {
        if (i == len(p) || (byteAt(p, i) ?? 0) == 47) {
            const seg = piece(p, start, i - start);
            if (seg == "..") {
                if (listLen(parts) > 1) {
                    const dropped = listPop(parts) ?? "";
                }
            } else if (seg != "." && !(seg == "" && listLen(parts) > 0)) {
                listPush(parts, seg);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let out = "";
    let k = 0;
    while (k < listLen(parts)) {
        if (k > 0) {
            out = out + "/";
        }
        out = out + (listGet(parts, k) ?? "");
        k = k + 1;
    }
    if (out == "") {
        return "/";
    }
    return out;
}

function relativeTo(p: string, base: string): string? {
    if (p == base) {
        return ".";
    }
    if (startsWith(p, base + "/")) {
        return piece(p, len(base) + 1, len(p) - len(base) - 1);
    }
    return None;
}

// 显示用的相对路径：同 Python 打印 Path（Windows 上为反斜杠）。
function shown(rel: string): string {
    if (!onWindows()) {
        return rel;
    }
    const b = bytesFromStr(rel);
    let i = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) ?? 0) == 47) {
            bytesSet(b, i, 92);
        }
        i = i + 1;
    }
    return bytesToStr(b) catch rel;
}

function isFile(p: string): bool {
    return kindOf(nat(p)) == 1;
}

function readAll(p: string): Bytes {
    return readLocalFileBytes(nat(parentOf(p)), nameOf(p), READ_MAX) catch bytesNew(0);
}

// ---- 排序（归并；同 Python 的 sorted，Path 在 Windows 上按小写、反斜杠比较）----

function lowerKey(s: string): string {
    const b = bytesFromStr(s);
    let i = 0;
    while (i < bytesLen(b)) {
        const c = bytesGet(b, i) ?? 0;
        if (c >= 65 && c <= 90) {
            bytesSet(b, i, c + 32);
        } else if (c == 47) {
            bytesSet(b, i, 92);
        }
        i = i + 1;
    }
    return bytesToStr(b) catch s;
}

function less(a: string, b: string): bool {
    return strCompare(a, b) < 0;
}

function pathKey(p: string): string {
    if (onWindows()) {
        return lowerKey(p);
    }
    return p;
}

// 按 pathKey 排（键与原值以换行相连后按字节排，再取回原值；路径里没有换行）。
function sortPaths(xs: List<string>): List<string> {
    const pairs: List<string> = listNew();
    for (x in xs) {
        listPush(pairs, pathKey(x) + "\n" + x);
    }
    const out: List<string> = listNew();
    for (pair in sortPlain(pairs)) {
        const cut = strFind(pair, "\n");
        listPush(out, piece(pair, cut + 1, len(pair) - cut - 1));
    }
    return out;
}

function sortPlain(xs: List<string>): List<string> {
    const n = listLen(xs);
    if (n <= 1) {
        return xs;
    }
    const l: List<string> = listNew();
    const r: List<string> = listNew();
    let i = 0;
    while (i < n) {
        if (i < n / 2) {
            listPush(l, listGet(xs, i) ?? "");
        } else {
            listPush(r, listGet(xs, i) ?? "");
        }
        i = i + 1;
    }
    const a = sortPlain(l);
    const b = sortPlain(r);
    const out: List<string> = listNew();
    let p = 0;
    let q = 0;
    while (p < listLen(a) || q < listLen(b)) {
        if (q >= listLen(b) || (p < listLen(a) && !less(listGet(b, q) ?? "", listGet(a, p) ?? ""))) {
            listPush(out, listGet(a, p) ?? "");
            p = p + 1;
        } else {
            listPush(out, listGet(b, q) ?? "");
            q = q + 1;
        }
    }
    return out;
}

// ---- 文件清单 ----

// 仓库里的文件（相对根、/ 分隔）：根是 Git 工作树顶层时取 git ls-files（已跟踪与未忽略的未跟踪文件），否则遍历目录（跳过 IGNORED、
// 符号链接与目录联接；.tools/bench 下的基准源码照收）。
function sourceFiles(root: string): List<string> {
    const out: List<string> = listNew();
    const fromGit = gitFiles(root);
    if (fromGit != None) {
        return fromGit ?? out;
    }
    walk(root, "", out, false);
    if (kindOf(nat(root + "/.tools/bench")) == 2) {
        walk(root, ".tools/bench", out, true);
    }
    return sortPaths(out);
}

function gitFiles(root: string): List<string>? {
    const git = findInPath("git");
    if (len(git) == 0) {
        return None;
    }
    const top = captureRaw(git, strs(["rev-parse", "--show-toplevel"]), nat(root), 60 * SEC, 10 * SEC, 1048576) catch (e) {
        return None;
    };
    if (top.code != 0) {
        return None;
    }
    const line = bytesToStr(top.out) catch "";
    let n = len(line);
    while (n > 0 && ((byteAt(line, n - 1) ?? 0) == 10 || (byteAt(line, n - 1) ?? 0) == 13)) {
        n = n - 1;
    }
    if (pathKey(slashes(osRealPath(nat(piece(line, 0, n))))) != pathKey(root)) {
        return None;
    }
    const listed = captureRaw(git, strs(["ls-files", "--cached", "--others", "--exclude-standard", "-z"]), nat(root), 300 * SEC, 10 * SEC,
        268435456) catch (e) {
        return None;
    };
    if (listed.code != 0) {
        return None;
    }
    const seen: Map<string, int> = mapNew();
    const out: List<string> = listNew();
    let start = 0;
    let i = 0;
    while (i < bytesLen(listed.out)) {
        if ((bytesGet(listed.out, i) ?? 0) == 0) {
            if (i > start) {
                const name = bytesToStr(bytesSlice(listed.out, start, i - start)) catch "";
                if (len(name) > 0 && mapGet(seen, name) == None && isFile(root + "/" + name)) {
                    mapSet(seen, name, 1);
                    listPush(out, name);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return sortPaths(out);
}

// rel 下的文件；bench 为真时只收 .s，以及 .tools/bench 本层的 .py、.sh、.ps1、.mjs。
function walk(root: string, rel: string, out: List<string>, bench: bool): void {
    let dir = root;
    if (len(rel) > 0) {
        dir = root + "/" + rel;
    }
    const none: List<string> = listNew();
    const names = localListDir(nat(dir), "") catch none;
    for (n in names) {
        let child = n;
        if (len(rel) > 0) {
            child = rel + "/" + n;
        }
        const k = localEntryKind(nat(dir), n);
        if (k == 2) {
            if (!has(IGNORED, n)) {
                walk(root, child, out, bench);
            }
        } else if (k == 1) {
            const sfx = suffixOf(n);
            if (!bench || sfx == ".s" || (rel == ".tools/bench" && (sfx == ".py" || sfx == ".sh" || sfx == ".ps1" || sfx == ".mjs"))) {
                listPush(out, child);
            }
        }
    }
}

// ---- 行尾 ----

// .gitattributes 里标 -text 或 binary 的模式。
function binaryPatterns(root: string): List<string> {
    const out: List<string> = listNew();
    const text = bytesToStr(readAll(root + "/.gitattributes")) catch "";
    for (line in splitLines(text)) {
        const fields = fieldsOf(line);
        if (listLen(fields) > 0 && !startsWith(listGet(fields, 0) ?? "", "#")) {
            let mark = false;
            let k = 1;
            while (k < listLen(fields)) {
                const f = listGet(fields, k) ?? "";
                if (f == "-text" || f == "binary") {
                    mark = true;
                }
                k = k + 1;
            }
            if (mark) {
                listPush(out, listGet(fields, 0) ?? "");
            }
        }
    }
    return out;
}

function splitLines(text: string): List<string> {
    const out: List<string> = listNew();
    let start = 0;
    let i = 0;
    while (i < len(text)) {
        const c = byteAt(text, i) ?? 0;
        if (c == 10 || c == 13) {
            listPush(out, piece(text, start, i - start));
            if (c == 13 && (byteAt(text, i + 1) ?? 0) == 10) {
                i = i + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if (start < len(text)) {
        listPush(out, piece(text, start, len(text) - start));
    }
    return out;
}

function isWs(c: int): bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
}

function fieldsOf(line: string): List<string> {
    const out: List<string> = listNew();
    let i = 0;
    while (i < len(line)) {
        while (i < len(line) && isWs(byteAt(line, i) ?? 0)) {
            i = i + 1;
        }
        const start = i;
        while (i < len(line) && !isWs(byteAt(line, i) ?? 0)) {
            i = i + 1;
        }
        if (i > start) {
            listPush(out, piece(line, start, i - start));
        }
    }
    return out;
}

// 同 Python 的 fnmatch.fnmatchcase：* 配任意串（含 /），? 配一个字符，[…]／[!…] 配字符集；没有配对的 [ 按字面。
function globMatch(pat: Bytes, pi: int, s: Bytes, si: int): bool {
    let p = pi;
    let i = si;
    while (p < bytesLen(pat)) {
        const c = bytesGet(pat, p) ?? 0;
        if (c == 42) {
            while (p < bytesLen(pat) && (bytesGet(pat, p) ?? 0) == 42) {
                p = p + 1;
            }
            if (p == bytesLen(pat)) {
                return true;
            }
            let k = i;
            while (k <= bytesLen(s)) {
                if (globMatch(pat, p, s, k)) {
                    return true;
                }
                k = k + 1;
            }
            return false;
        }
        if (i >= bytesLen(s)) {
            return false;
        }
        if (c == 63) {
            i = i + charLen(s, i);
            p = p + 1;
        } else if (c == 91 && setEnd(pat, p) > 0) {
            const end = setEnd(pat, p);
            const n = charLen(s, i);
            if (!inSet(pat, p + 1, end, bytesSlice(s, i, n))) {
                return false;
            }
            i = i + n;
            p = end + 1;
        } else {
            if ((bytesGet(s, i) ?? 0) != c) {
                return false;
            }
            i = i + 1;
            p = p + 1;
        }
    }
    return i == bytesLen(s);
}

// UTF-8 首字节起的字符长度。
function charLen(s: Bytes, i: int): int {
    const c = bytesGet(s, i) ?? 0;
    let n = 1;
    if (c >= 240) {
        n = 4;
    } else if (c >= 224) {
        n = 3;
    } else if (c >= 192) {
        n = 2;
    }
    if (i + n > bytesLen(s)) {
        return bytesLen(s) - i;
    }
    return n;
}

// pat[p] 为 [ 时配对的 ] 的位置（同 fnmatch：开头的 ! 与紧随的 ] 算集合内容）；没有得 0。
function setEnd(pat: Bytes, p: int): int {
    let j = p + 1;
    if (j < bytesLen(pat) && (bytesGet(pat, j) ?? 0) == 33) {
        j = j + 1;
    }
    if (j < bytesLen(pat) && (bytesGet(pat, j) ?? 0) == 93) {
        j = j + 1;
    }
    while (j < bytesLen(pat) && (bytesGet(pat, j) ?? 0) != 93) {
        j = j + 1;
    }
    if (j >= bytesLen(pat)) {
        return 0;
    }
    return j;
}

function inSet(pat: Bytes, from: int, end: int, ch: Bytes): bool {
    let j = from;
    let negate = false;
    if ((bytesGet(pat, j) ?? 0) == 33) {
        negate = true;
        j = j + 1;
    }
    const v = codeOf(ch, 0);
    let hit = false;
    while (j < end) {
        const lo = codeOf(pat, j);
        const loLen = charLen(pat, j);
        if (j + loLen + 1 < end && (bytesGet(pat, j + loLen) ?? 0) == 45) {
            const hi = codeOf(pat, j + loLen + 1);
            if (lo <= v && v <= hi) {
                hit = true;
            }
            j = j + loLen + 1 + charLen(pat, j + loLen + 1);
        } else {
            if (lo == v) {
                hit = true;
            }
            j = j + loLen;
        }
    }
    return hit != negate;
}

function codeOf(b: Bytes, i: int): int {
    const n = charLen(b, i);
    const c = bytesGet(b, i) ?? 0;
    if (n == 1) {
        return c;
    }
    let v = c & (127 >> n);
    let k = 1;
    while (k < n) {
        v = (v << 6) | ((bytesGet(b, i + k) ?? 0) & 63);
        k = k + 1;
    }
    return v;
}

// 8 字节一组找某个字节（SWAR：x 里有零字节当且仅当 (x − 0x01…01) & ~x & 0x80…80 不为 0）。
const LOW: int = 72340172838076673;
const HIGH: int = -9187201950435737472;

function hasByte(d: Bytes, value: int): bool {
    const n = bytesLen(d);
    const pattern = wrapMul(value, LOW);
    let i = 0;
    while (i + 8 <= n) {
        const x = (bytesGetLE<int>(d, i) ?? 0) ^ pattern;
        if ((wrapSub(x, LOW) & (x ^ -1) & HIGH) != 0) {
            return true;
        }
        i = i + 8;
    }
    while (i < n) {
        if ((bytesGet(d, i) ?? 0) == value) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function countByte(d: Bytes, value: int): int {
    let count = 0;
    let i = 0;
    while (i < bytesLen(d)) {
        if ((bytesGet(d, i) ?? 0) == value) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

function checkEol(root: string, files: List<string>): bool {
    const patterns: List<Bytes> = listNew();
    const plain: List<bool> = listNew();
    for (p in binaryPatterns(root)) {
        listPush(patterns, bytesFromStr(p));
        listPush(plain, lastSlash(p) < 0);
    }
    let count = 0;
    const bad: List<string> = listNew();
    for (name in files) {
        const nb = bytesFromStr(name);
        const base = bytesFromStr(nameOf(name));
        let skip = false;
        let k = 0;
        while (k < listLen(patterns) && !skip) {
            const pat = listGet(patterns, k) ?? bytesNew(0);
            if (globMatch(pat, 0, nb, 0) || ((listGet(plain, k) ?? false) && globMatch(pat, 0, base, 0))) {
                skip = true;
            }
            k = k + 1;
        }
        if (!skip) {
            const data = readAll(root + "/" + name);
            // text=auto：含 NUL 的文件为二进制。
            if (!hasByte(data, 0)) {
                count = count + 1;
                if (hasByte(data, 13)) {
                    listPush(bad, name);
                }
            }
        }
    }
    for (name in bad) {
        print("FAIL CR " + name);
    }
    print("eol: " + toStr(count) + " text files, " + toStr(listLen(bad)) + " with CR");
    return listLen(bad) == 0;
}

// ---- 行数（只报告）----

function linecount(root: string, files: List<string>): void {
    const counts: List<int> = listNew();
    const names: List<string> = listNew();
    for (name in files) {
        if (suffixOf(nameOf(name)) == ".tx" && startsWith(name, "bootstrap/")) {
            const data = readAll(root + "/" + name);
            let n = countByte(data, 10);
            if (bytesLen(data) > 0 && (bytesGet(data, bytesLen(data) - 1) ?? 0) != 10) {
                n = n + 1;
            }
            listPush(counts, n);
            listPush(names, name);
        }
    }
    print("linecount: report-only; new .tx files soft limit 1000");
    // 同 Python 的 rows.sort(reverse=True)：先按行数、再按名字，都从大到小；取前 10。
    const taken: List<bool> = listNew();
    for (x in counts) {
        listPush(taken, false);
    }
    let shownRows = 0;
    while (shownRows < 10 && shownRows < listLen(counts)) {
        let best = -1;
        let i = 0;
        while (i < listLen(counts)) {
            if (!(listGet(taken, i) ?? true)) {
                if (best < 0 || (listGet(counts, i) ?? 0) > (listGet(counts, best) ?? 0)
                    || ((listGet(counts, i) ?? 0) == (listGet(counts, best) ?? 0) && less(listGet(names, best) ?? "", listGet(names, i) ?? ""))) {
                    best = i;
                }
            }
            i = i + 1;
        }
        listSet(taken, best, true);
        print(toStr(listGet(counts, best) ?? 0) + " " + (listGet(names, best) ?? ""));
        shownRows = shownRows + 1;
    }
    let over = 0;
    for (n in counts) {
        if (n > 1000) {
            over = over + 1;
        }
    }
    print("linecount: " + toStr(listLen(counts)) + " files, " + toStr(over) + " over soft limit");
}

// ---- 导入 ----

// 顶层 import 声明的路径（保留字符串、注释换成空白，再按 ^\s*import\s+[^;]*?\sfrom\s+"([^"\n]+)"\s*; 逐行取）。
function imports(src: Bytes): List<string> {
    const t = blankComments(src);
    const out: List<string> = listNew();
    const n = bytesLen(t);
    let p = 0;
    while (p < n) {
        // 只在行首起配。
        if (p == 0 || (bytesGet(t, p - 1) ?? 0) == 10) {
            const end = importAt(t, p, out);
            if (end > p) {
                p = end;
                continue;
            }
        }
        p = p + 1;
    }
    return out;
}

// 从行首 p 起配一条 import 声明：配上时把路径记进 out，返回声明之后的位置；配不上返回 p。
function importAt(t: Bytes, p: int, out: List<string>): int {
    const n = bytesLen(t);
    let q = p;
    while (q < n && isWs(bytesGet(t, q) ?? 0)) {
        q = q + 1;
    }
    if (!wordAt(t, q, "import") || !isWs(bytesGet(t, q + 6) ?? 0)) {
        return p;
    }
    // 最短的 [^;]*?：从左到右找“空白＋from＋空白…"路径"…;”，碰到 ; 即放弃。
    let k = q + 7;
    while (k < n) {
        const c = bytesGet(t, k) ?? 0;
        if (c == 59) {
            return p;
        }
        if (isWs(c) && wordAt(t, k + 1, "from")) {
            let r = k + 5;
            if (r < n && isWs(bytesGet(t, r) ?? 0)) {
                while (r < n && isWs(bytesGet(t, r) ?? 0)) {
                    r = r + 1;
                }
                if ((bytesGet(t, r) ?? 0) == 34) {
                    let e = r + 1;
                    while (e < n && (bytesGet(t, e) ?? 0) != 34 && (bytesGet(t, e) ?? 0) != 10) {
                        e = e + 1;
                    }
                    if (e < n && (bytesGet(t, e) ?? 0) == 34 && e > r + 1) {
                        let s = e + 1;
                        while (s < n && isWs(bytesGet(t, s) ?? 0)) {
                            s = s + 1;
                        }
                        if ((bytesGet(t, s) ?? 0) == 59) {
                            listPush(out, bytesToStr(bytesSlice(t, r + 1, e - r - 1)) catch "");
                            return s + 1;
                        }
                    }
                }
            }
        }
        k = k + 1;
    }
    return p;
}

function wordAt(t: Bytes, at: int, w: string): bool {
    if (at + len(w) > bytesLen(t)) {
        return false;
    }
    let i = 0;
    while (i < len(w)) {
        if ((bytesGet(t, at + i) ?? 0) != (byteAt(w, i) ?? 0)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 字符串原样保留（"…" 内可有转义）；// 到行尾与 /* … */ 换成空白（换行保留）。
function blankComments(src: Bytes): Bytes {
    const t = bytesSlice(src, 0, bytesLen(src));
    const n = bytesLen(t);
    let i = 0;
    while (i < n) {
        const c = bytesGet(t, i) ?? 0;
        if (c == 34) {
            let j = i + 1;
            let closed = -1;
            while (j < n && closed < 0) {
                const d = bytesGet(t, j) ?? 0;
                if (d == 92) {
                    j = j + 2;
                } else if (d == 34) {
                    closed = j;
                } else {
                    j = j + 1;
                }
            }
            if (closed >= 0) {
                i = closed + 1;
            } else {
                i = i + 1;
            }
        } else if (c == 47 && (bytesGet(t, i + 1) ?? 0) == 47) {
            while (i < n && (bytesGet(t, i) ?? 0) != 10) {
                bytesSet(t, i, 32);
                i = i + 1;
            }
        } else if (c == 47 && (bytesGet(t, i + 1) ?? 0) == 42 && closeOf(t, i + 2) >= 0) {
            const end = closeOf(t, i + 2) + 2;
            while (i < end) {
                if ((bytesGet(t, i) ?? 0) != 10) {
                    bytesSet(t, i, 32);
                }
                i = i + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return t;
}

function closeOf(t: Bytes, from: int): int {
    let j = from;
    while (j + 1 < bytesLen(t)) {
        if ((bytesGet(t, j) ?? 0) == 42 && (bytesGet(t, j + 1) ?? 0) == 47) {
            return j;
        }
        j = j + 1;
    }
    return -1;
}

// ---- 导入边界 ----

// 按目标选文件（D3 v0.35，同 bootstrap/selfhost/target.tx 的 targetFileSuffixes／targetFileSuffixesAll）：编译器自身要编成的各目标的
// 后缀链（windows、aarch64-windows、linux、aarch64-macos、aarch64-linux、loongarch64-linux、riscv64-linux），与同组兄弟文件的全部后缀。
function targetChains(): List<List<string>> {
    const out: List<List<string>> = listNew();
    listPush(out, strs(["windows_x86_64", "windows"]));
    listPush(out, strs(["windows_aarch64", "windows"]));
    listPush(out, strs(["linux_x86_64", "linux", "unix"]));
    listPush(out, strs(["macos_aarch64", "macos", "unix"]));
    listPush(out, strs(["linux_aarch64", "linux", "unix"]));
    listPush(out, strs(["linux_loongarch64", "linux", "unix"]));
    listPush(out, strs(["linux_riscv64", "linux", "unix"]));
    return out;
}

function allSuffixes(): List<string> {
    const out = strs(["windows", "linux", "macos", "unix"]);
    for (o in ["windows", "linux", "macos"]) {
        for (a in ["x86_64", "aarch64", "loongarch64", "riscv64"]) {
            listPush(out, o + "_" + a);
        }
    }
    return out;
}

function listHas(xs: List<string>, x: string): bool {
    for (y in xs) {
        if (y == x) {
            return true;
        }
    }
    return false;
}

// 带目标后缀的文件只在后缀链含该后缀的目标上入选（取最长的后缀），它的导入也只需在这些目标上解析得到；不带后缀的文件各目标都入选。
function selectingChains(path: string): List<List<string>> {
    const stem = stemOf(nameOf(path));
    let sfx = "";
    for (s in allSuffixes()) {
        if (endsWith(stem, "_" + s) && len(s) > len(sfx)) {
            sfx = s;
        }
    }
    const out: List<List<string>> = listNew();
    for (chain in targetChains()) {
        if (len(sfx) == 0 || listHas(chain, sfx)) {
            listPush(out, chain);
        }
    }
    return out;
}

function variant(target: string, sfx: string): string {
    return parentOf(target) + "/" + stemOf(nameOf(target)) + "_" + sfx + ".tx";
}

function importTarget(path: string, spec: string): string {
    let rel = spec;
    if (!endsWith(spec, ".tx")) {
        rel = spec + ".tx";
    }
    return normPath(parentOf(path) + "/" + rel);
}

function checkEdges(root: string, files: List<string>, quiet: bool): bool {
    const boot = root + "/bootstrap";
    const nodeSet: Map<string, int> = mapNew();
    const nodeList: List<string> = listNew();
    for (f in files) {
        const p = normPath(f);
        if (suffixOf(nameOf(p)) == ".tx" && relativeTo(p, boot) != None && mapGet(nodeSet, p) == None) {
            mapSet(nodeSet, p, 1);
            listPush(nodeList, p);
        }
    }
    const nodes = sortPaths(nodeList);
    const graph: Map<string, List<string>> = mapNew();
    const bad: List<string> = listNew();
    const matrix: Map<string, int> = mapNew();
    const sfxs = allSuffixes();
    let total = 0;
    for (path in nodes) {
        const deps: List<string> = listNew();
        for (spec in imports(readAll(path))) {
            if (!startsWith(spec, "./") && !startsWith(spec, "../")) {
                listPush(bad, path + "\n" + "compiler import must be relative: " + spec);
                continue;
            }
            const target = importTarget(path, spec);
            const targets: List<string> = listNew();
            if (mapGet(nodeSet, target) != None) {
                listPush(targets, target);
            }
            for (s in sfxs) {
                if (mapGet(nodeSet, variant(target, s)) != None) {
                    listPush(targets, variant(target, s));
                }
            }
            // 与原生目标选择一致：选中本文件的每个目标沿自己的后缀链都要解析得到；依赖取同组全部现存文件。
            let resolved = listLen(targets) > 0;
            for (chain in selectingChains(path)) {
                let any = mapGet(nodeSet, target) != None;
                for (s in chain) {
                    if (mapGet(nodeSet, variant(target, s)) != None) {
                        any = true;
                    }
                }
                if (!any) {
                    resolved = false;
                }
            }
            if (!resolved) {
                listPush(bad, path + "\n" + "missing or outside compiler source: " + spec);
                continue;
            }
            for (t in targets) {
                if (has(BASIC, nameOf(path)) && has(COMMANDS, nameOf(t))) {
                    listPush(bad, path + "\n" + "foundation imports command/orchestrator: " + spec);
                }
                if (!endsWith(stemOf(nameOf(path)), "-probe") && endsWith(stemOf(nameOf(t)), "-probe")) {
                    listPush(bad, path + "\n" + "production imports development probe: " + spec);
                }
                listPush(deps, t);
                const key = (relativeTo(parentOf(path), boot) ?? "?") + " -> " + (relativeTo(parentOf(t), boot) ?? "?");
                mapSet(matrix, key, (mapGet(matrix, key) ?? 0) + 1);
            }
        }
        total = total + listLen(deps);
        mapSet(graph, path, deps);
    }
    const seen: Map<string, int> = mapNew();
    const active: Map<string, int> = mapNew();
    for (path in nodes) {
        visit(path, graph, seen, active, bad);
    }
    if (!quiet) {
        for (row in bad) {
            const cut = strFind(row, "\n");
            print("FAIL edge " + shown(relativeTo(piece(row, 0, cut), root) ?? "?") + " " + piece(row, cut + 1, len(row) - cut - 1));
        }
        print("edges: " + toStr(listLen(nodes)) + " modules, " + toStr(total) + " imports, " + toStr(listLen(bad)) + " violations");
        for (key in sortPlain(mapKeys(matrix))) {
            print("matrix: " + key + " " + toStr(mapGet(matrix, key) ?? 0));
        }
    }
    return listLen(bad) == 0;
}

function visit(path: string, graph: Map<string, List<string>>, seen: Map<string, int>, active: Map<string, int>, bad: List<string>): void {
    if (mapGet(active, path) != None) {
        listPush(bad, path + "\n" + "import cycle");
        return;
    }
    if (mapGet(seen, path) != None) {
        return;
    }
    mapSet(active, path, 1);
    const none: List<string> = listNew();
    for (t in mapGet(graph, path) ?? none) {
        visit(t, graph, seen, active, bad);
    }
    mapRemove(active, path);
    mapSet(seen, path, 1);
}

// ---- 独立判定器 ----

function checkIndependent(root: string): bool {
    const boot = root + "/bootstrap";
    const sfxs = allSuffixes();
    const bad: List<string> = listNew();
    for (rel in INDEPENDENT) {
        const start = normPath(root + "/" + rel);
        if (!isFile(start)) {
            listPush(bad, rel + " missing");
            continue;
        }
        const todo = strs([start]);
        const seen: Map<string, int> = mapNew();
        while (listLen(todo) > 0) {
            const path = listPop(todo) ?? "";
            if (mapGet(seen, path) != None) {
                continue;
            }
            mapSet(seen, path, 1);
            for (spec in imports(readAll(path))) {
                const target = importTarget(path, spec);
                // 按目标选文件的导入（./build_os → build_os_windows.tx 等）连同各后缀的兄弟文件一起查。
                const group = strs([target]);
                for (s in sfxs) {
                    listPush(group, variant(target, s));
                }
                for (t in group) {
                    if (relativeTo(t, boot) != None) {
                        listPush(bad, rel + " imports compiler source via " + (relativeTo(path, root) ?? path) + ": " + spec);
                        break;
                    }
                    if (isFile(t)) {
                        listPush(todo, t);
                    }
                }
            }
        }
    }
    for (row in bad) {
        print("FAIL independent " + row);
    }
    print("independent: " + toStr(len(INDEPENDENT)) + " judges, " + toStr(listLen(bad)) + " violations");
    return listLen(bad) == 0;
}

// ---- 纯太虚 ----

// 编译器、预置库与标准库只含太虚源码：PURE 下只许 .tx；bootstrap/ 下另许无扩展名、内容为一个提交号的固定阶段文件。
function checkPure(root: string, files: List<string>): bool {
    const bad: List<string> = listNew();
    for (rel in files) {
        let pure = false;
        for (p in PURE) {
            if (startsWith(rel, p)) {
                pure = true;
            }
        }
        if (!pure || suffixOf(nameOf(rel)) == ".tx") {
            continue;
        }
        if (startsWith(rel, "bootstrap/") && lastSlash(rel) == 9 && suffixOf(nameOf(rel)) == "" && isCommit(readAll(root + "/" + rel))) {
            continue;
        }
        listPush(bad, rel);
    }
    for (rel in bad) {
        print("FAIL not Taixu source " + rel);
    }
    print("pure: " + toStr(listLen(bad)) + " non-Taixu files under bootstrap/, prelude/, stdlib/src/");
    return listLen(bad) == 0;
}

// 去掉首尾空白后恰为 40 位小写十六进制。
function isCommit(d: Bytes): bool {
    let a = 0;
    let b = bytesLen(d);
    while (a < b && isWs(bytesGet(d, a) ?? 0)) {
        a = a + 1;
    }
    while (b > a && isWs(bytesGet(d, b - 1) ?? 0)) {
        b = b - 1;
    }
    if (b - a != 40) {
        return false;
    }
    let i = a;
    while (i < b) {
        const c = bytesGet(d, i) ?? 0;
        if (!((c >= 48 && c <= 57) || (c >= 97 && c <= 102))) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ---- 内嵌内核与目标表 ----

// bootstrap/taixu.tx 的 embeddedKernel、embeddedHeapKernel 各为每个目标嵌入一个内核。embedBytes 的实参须是字面量，这两份名单只能手写，
// 这里核对它们与编译器的目标表（bootstrap/selfhost/target.tx）一致：每个 `if (t == T_<名>) { return embedBytes("nrt-kernel/<文件>"); }`
// 的文件是常量 T_<名> 那个目标按规则（scripts/targets.tx 的 kernelFile）的内核名；不带条件的 `return embedBytes(…)` 至多一行，是没有
// if 行的那一个目标的内核名；目标表里的每个目标恰好出现一次。

// 嵌入函数里的一行：if 行的目标常量名（不带条件的那行为空串）与内核文件名。
struct EmbedLine {
    constant: string,
    file: string,
}

// target.tx 里 `export const T_<名>: int = <编号>;` 的常量名与编号。
struct TargetConsts {
    names: List<string>,
    ids: List<int>,
}

// 全由十进制数字组成得其值，否则得 -1。
function digitsValue(s: string): int {
    if (len(s) == 0) {
        return -1;
    }
    let v = 0;
    let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) ?? 0;
        if (c < 48 || c > 57) {
            return -1;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v;
}

function targetConsts(text: string): TargetConsts {
    const out = TargetConsts { names: listNew(), ids: listNew() };
    for (line in splitLines(text)) {
        const f = fieldsOf(line);
        if (listLen(f) != 6 || (listGet(f, 0) catch "") != "export" || (listGet(f, 1) catch "") != "const" || (listGet(f, 3) catch "") != "int"
            || (listGet(f, 4) catch "") != "=") {
            continue;
        }
        const name = listGet(f, 2) catch "";
        const value = listGet(f, 5) catch "";
        if (!startsWith(name, "T_") || !endsWith(name, ":") || !endsWith(value, ";")) {
            continue;
        }
        listPush(out.names, piece(name, 0, len(name) - 1));
        listPush(out.ids, digitsValue(piece(value, 0, len(value) - 1)));
    }
    return out;
}

// 嵌入的内核名：`embedBytes("nrt-kernel/<文件>");` 形态得 <文件>，否则得空串。
function embeddedFile(field: string): string {
    const head = "embedBytes(\"nrt-kernel/";
    const tail = "\");";
    if (!startsWith(field, head) || !endsWith(field, tail) || len(field) <= len(head) + len(tail)) {
        return "";
    }
    return piece(field, len(head), len(field) - len(head) - len(tail));
}

// 函数 fn 体内的嵌入行；体内有别的行、或找不到函数，记进 problems。
function embedLines(text: string, fn: string, problems: List<string>): List<EmbedLine> {
    const out: List<EmbedLine> = listNew();
    const header = "function " + fn + "(t: int): Bytes {";
    let inside = false;
    let found = false;
    for (line in splitLines(text)) {
        if (!inside) {
            if (line == header) {
                inside = true;
                found = true;
            }
            continue;
        }
        if (line == "}") {
            break;
        }
        const f = fieldsOf(line);
        if (listLen(f) == 0 || startsWith(listGet(f, 0) catch "", "//")) {
            continue;
        }
        if (listLen(f) == 8 && (listGet(f, 0) catch "") == "if" && (listGet(f, 1) catch "") == "(t" && (listGet(f, 2) catch "") == "=="
            && endsWith(listGet(f, 3) catch "", ")") && (listGet(f, 4) catch "") == "{" && (listGet(f, 5) catch "") == "return"
            && len(embeddedFile(listGet(f, 6) catch "")) > 0 && (listGet(f, 7) catch "") == "}") {
            const c = listGet(f, 3) catch "";
            listPush(out, EmbedLine { constant: piece(c, 0, len(c) - 1), file: embeddedFile(listGet(f, 6) catch "") });
        } else if (listLen(f) == 2 && (listGet(f, 0) catch "") == "return" && len(embeddedFile(listGet(f, 1) catch "")) > 0) {
            listPush(out, EmbedLine { constant: "", file: embeddedFile(listGet(f, 1) catch "") });
        } else {
            listPush(problems, fn + " 里有嵌入行以外的行：" + line);
        }
    }
    if (!found) {
        listPush(problems, "找不到 " + header);
    }
    return out;
}

// 编号 → 常量名（没有得空串）。
function constName(k: TargetConsts, id: int): string {
    let i = 0;
    while (i < listLen(k.names)) {
        if ((listGet(k.ids, i) catch -1) == id) {
            return listGet(k.names, i) catch "";
        }
        i = i + 1;
    }
    return "";
}

// 一个嵌入函数的问题（空表即一致）；heap 为真是检测内核。
function embedProblems(consts: TargetConsts, text: string, fn: string, heap: bool): List<string> {
    const problems: List<string> = listNew();
    const lines = embedLines(text, fn, problems);
    let count = 0;
    while (len(targetName(count)) > 0) {
        count = count + 1;
    }
    const seen: List<bool> = listNew();
    let k = 0;
    while (k < count) {
        listPush(seen, false);
        k = k + 1;
    }
    const defaults: List<string> = listNew();
    for (l in lines) {
        if (len(l.constant) == 0) {
            listPush(defaults, l.file);
            continue;
        }
        let id = -1;
        let i = 0;
        while (i < listLen(consts.names)) {
            if ((listGet(consts.names, i) catch "") == l.constant) {
                id = listGet(consts.ids, i) catch -1;
            }
            i = i + 1;
        }
        if (id < 0 || id >= count) {
            listPush(problems, fn + "：" + l.constant + " 不是目标表里的目标");
            continue;
        }
        if (listGet(seen, id) catch false) {
            listPush(problems, fn + "：" + l.constant + " 出现不止一次");
            continue;
        }
        listSet(seen, id, true);
        const want = kernelFile(targetName(id), !tElfObjects(id), heap);
        if (l.file != want) {
            listPush(problems, fn + "：" + l.constant + "（" + targetName(id) + "）嵌入 " + l.file + "，应为 " + want);
        }
    }
    const rest: List<int> = listNew();
    k = 0;
    while (k < count) {
        if (!(listGet(seen, k) catch true)) {
            listPush(rest, k);
        }
        k = k + 1;
    }
    if (listLen(defaults) > 1) {
        listPush(problems, fn + "：不带条件的嵌入行有 " + toStr(listLen(defaults)) + " 行");
    } else if (listLen(rest) != listLen(defaults)) {
        for (id in rest) {
            listPush(problems, fn + "：没有嵌入 " + targetName(id) + "（" + constName(consts, id) + "）的内核");
        }
        for (file in defaults) {
            listPush(problems, fn + "：不带条件的那行嵌入 " + file + "，可目标都已有 if 行");
        }
    } else if (listLen(rest) == 1) {
        const id = listGet(rest, 0) catch 0;
        const want = kernelFile(targetName(id), !tElfObjects(id), heap);
        const file = listGet(defaults, 0) catch "";
        if (file != want) {
            listPush(problems, fn + "：不带条件的那行（" + targetName(id) + "）嵌入 " + file + "，应为 " + want);
        }
    }
    return problems;
}

function kernelProblems(targetText: string, taixuText: string): List<string> {
    const consts = targetConsts(targetText);
    const out = embedProblems(consts, taixuText, "embeddedKernel", false);
    for (p in embedProblems(consts, taixuText, "embeddedHeapKernel", true)) {
        listPush(out, p);
    }
    return out;
}

function checkKernels(root: string): bool {
    const targetText = bytesToStr(readAll(root + "/bootstrap/selfhost/target.tx")) catch "";
    const taixuText = bytesToStr(readAll(root + "/bootstrap/taixu.tx")) catch "";
    const problems = kernelProblems(targetText, taixuText);
    for (p in problems) {
        print("FAIL kernels " + p);
    }
    print("kernels: " + toStr(listLen(problems)) + " problems in the embedded kernel lists of bootstrap/taixu.tx");
    return listLen(problems) == 0;
}

// 自检用的嵌入函数文本：目标 0 走不带条件的末行，其余各一行 if；常量名为 T_K<编号>。swap 非负时对调目标 swap 与 swap+1 的文件，
// drop 非负时去掉目标 drop 的行，dup 非负时把目标 dup 的行写两遍。
function embedFixture(fn: string, heap: bool, swap: int, drop: int, dup: int): string {
    let count = 0;
    while (len(targetName(count)) > 0) {
        count = count + 1;
    }
    let s = "function " + fn + "(t: int): Bytes {\n";
    let id = 1;
    while (id < count) {
        let file = id;
        if (id == swap) {
            file = id + 1;
        } else if (id == swap + 1) {
            file = swap;
        }
        const line = "    if (t == T_K" + toStr(id) + ") { return embedBytes(\"nrt-kernel/" + kernelFile(targetName(file), !tElfObjects(file), heap)
        + "\"); }\n";
        if (id != drop) {
            s = s + line;
        }
        if (id == dup) {
            s = s + line;
        }
        id = id + 1;
    }
    return s + "    return embedBytes(\"nrt-kernel/" + kernelFile(targetName(0), !tElfObjects(0), heap) + "\");\n}\n";
}

function kernelsSelftest(t: Ref<Self>): void {
    let consts = "";
    let id = 0;
    while (len(targetName(id)) > 0) {
        consts = consts + "export const T_K" + toStr(id) + ": int = " + toStr(id) + ";\n";
        id = id + 1;
    }
    const heapOk = embedFixture("embeddedHeapKernel", true, -1, -1, -1);
    expect(t, "kernels: consistent lists", true, listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, -1, -1, -1) + heapOk)) == 0);
    expect(t, "kernels: two targets swapped", false, listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, 1, -1, -1) + heapOk)) == 0);
    expect(t, "kernels: target missing", false, listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, -1, 2, -1) + heapOk)) == 0);
    expect(t, "kernels: target twice", false, listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, -1, -1, 2) + heapOk)) == 0);
    expect(t, "kernels: heap list uses standard names", false,
        listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, -1, -1, -1) + embedFixture("embeddedHeapKernel", false, -1, -1, -1))) == 0);
    expect(t, "kernels: unknown constant", false,
        listLen(kernelProblems("export const T_K0: int = 0;\n", embedFixture("embeddedKernel", false, -1, -1, -1) + heapOk)) == 0);
    expect(t, "kernels: heap function missing", false, listLen(kernelProblems(consts, embedFixture("embeddedKernel", false, -1, -1, -1))) == 0);
}

// ---- 导入边界规则的自检 ----

struct Self {
    total: int,
    failed: int,
}

function expect(t: Ref<Self>, name: string, want: bool, got: bool): void {
    t.total = t.total + 1;
    if (want != got) {
        t.failed = t.failed + 1;
        print("FAIL selftest " + name);
    }
}

function put(path: string, text: string): void {
    writeFile(nat(path), text) catch (e) {
        eprint("写不了 " + path + "：" + e.message);
    };
}

function selftest(): bool {
    const t = new Self { total: 0, failed: 0 };
    const root = slashes(osRealPath(tempDir())) + "/taixu-edge-test-" + toStr(monoNs());
    const boot = root + "/bootstrap";
    mkdirs(nat(boot));
    const entry = "bootstrap/entry.tx";
    const windows = "bootstrap/platform_windows.tx";
    const linux = "bootstrap/platform_linux.tx";
    const macos = "bootstrap/platform_macos.tx";
    put(root + "/" + entry, "import { value } from \"./platform\";\n");
    for (p in [windows, linux, macos]) {
        put(root + "/" + p, "export function value(): int { return 1; }\n");
    }
    const r = slashes(osRealPath(nat(root)));
    // 编译器自身要编成的每个目标（Windows、Linux 两端 x86_64，M1 原生自举的 aarch64-macos，交叉编的 aarch64-linux）沿自己的后缀链都要
    // 解析得到：缺 macOS 一端或 Linux 一端都不够。
    expect(t, "all three hosts resolve", true, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + linux, r + "/" + macos]), true));
    expect(t, "macOS side missing", false, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + linux]), true));
    expect(t, "Linux side missing", false, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + macos]), true));
    expect(t, "Windows side missing", false, checkEdges(r, strs([r + "/" + entry, r + "/" + linux, r + "/" + macos]), true));
    put(root + "/" + linux, "import { bad } from \"../outside\";\n");
    expect(t, "import outside compiler source", false, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + linux, r + "/" + macos]), true));
    put(root + "/" + linux, "import { value } from \"./entry\";\n");
    expect(t, "import cycle", false, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + linux, r + "/" + macos]), true));
    // 类 Unix 的 _unix 同时满足 Linux 与 macOS 两端。
    const unix = "bootstrap/platform_unix.tx";
    put(root + "/" + unix, "export function value(): int { return 2; }\n");
    expect(t, "unix suffix serves Linux and macOS", true, checkEdges(r, strs([r + "/" + entry, r + "/" + windows, r + "/" + unix]), true));
    // 带目标后缀的文件只在选中它的目标上要求解析：x_linux 导入只有 y_linux 的 ./y 成立（只有 Linux 目标选中 x_linux）；x_unix 导入同样的
    // ./y 不成立（aarch64-macos 也选中它，那里解析不到）。
    put(root + "/bootstrap/y_linux.tx", "export function y(): int { return 3; }\n");
    put(root + "/bootstrap/x_linux.tx", "import { y } from \"./y\";\n");
    put(root + "/bootstrap/x_unix.tx", "import { y } from \"./y\";\n");
    expect(t, "linux-only importer resolves linux-only target", true, checkEdges(r, strs([r + "/bootstrap/x_linux.tx", r + "/bootstrap/y_linux.tx"]), true));
    expect(t, "unix importer needs macOS target", false, checkEdges(r, strs([r + "/bootstrap/x_unix.tx", r + "/bootstrap/y_linux.tx"]), true));
    deleteTree(root);
    kernelsSelftest(t);
    print("selftest: " + toStr(t.total) + " cases, " + toStr(t.failed) + " failed");
    return t.failed == 0;
}

// ---- 入口 ----

function run(argv: []string): int | Error {
    let root = "";
    let only = "all";
    let i = 0;
    while (i + 1 < len(argv)) {
        if (argv[i] == "--root") {
            root = argv[i + 1];
        } else if (argv[i] == "--only") {
            only = argv[i + 1];
        } else {
            return err("未知参数：" + argv[i]);
        }
        i = i + 2;
    }
    if (i != len(argv) || !(only == "eol" || only == "linecount" || only == "edges" || only == "independent" || only == "pure"
            || only == "kernels" || only == "selftest" || only == "all")) {
        return err("用法：taixu run --toolchain scripts/repo_hygiene.tx [--root <仓库>] [--only eol|linecount|edges|independent|pure|kernels|selftest|all]");
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = slashes(osRealPath(nat(root)));
    const files = sourceFiles(root);
    let ok = true;
    if (only == "all" || only == "eol") {
        ok = checkEol(root, files) && ok;
    }
    if (only == "all" || only == "linecount") {
        linecount(root, files);
    }
    if (only == "all" || only == "edges") {
        const abs: List<string> = listNew();
        for (f in files) {
            listPush(abs, root + "/" + f);
        }
        ok = checkEdges(root, abs, false) && ok;
    }
    if (only == "all" || only == "independent") {
        ok = checkIndependent(root) && ok;
    }
    if (only == "all" || only == "pure") {
        ok = checkPure(root, files) && ok;
    }
    if (only == "all" || only == "kernels") {
        ok = checkKernels(root) && ok;
    }
    if (only == "all" || only == "selftest") {
        ok = selftest() && ok;
    }
    if (ok) {
        return 0;
    }
    return 1;
}

function main(argv: []string): int {
    return run(argv) catch (e) {
        eprint("repo_hygiene: " + e.message);
        return 2;
    };
}
