// D3 v0.51 §6.2-1：struct 更新表达式 T { ...t, f: v }——展开写在最前、与目标同一 struct；未列出的字段
// 取自 t（值类型字段——struct、定长数组——是拷贝，List 等句柄字段与 t 共享），显式字段按书写序覆盖；期望类型已知或可由展开源
// 推出时可省类型名；new T { ...t } 得 Ref<T>。
struct In { v: int }
struct T { id: int, name: string, done: bool, tags: List<string>, at: [2]int, inner: In }

function mk(): T {
    return T { id: 1, name: "a", done: false, tags: ["x"], at: [3, 4], inner: In { v: 1 } };
}

function rename(t: T, n: string): T {
    return { ...t, name: n };
}

export function main(args: []string): int {
    const t = mk();
    const u = T { ...t, done: true, name: "b" };
    const v: T = { ...u, id: 9 };
    const w = { ...v };
    const r = new T { ...t, id: 5 };
    listPush(u.tags, "shared");
    let m = T { ...t };
    m.at[0] = 30;
    m.inner.v = 10;
    const z = rename(t, "z");
    print(toStr(u.done) + u.name + toStr(u.id) + " " + toStr(v.id) + v.name + toStr(v.done) + " " + toStr(w.id) + " " + toStr(r.id) + toStr(r.done));
    print(toStr(listLen(t.tags)) + " " + toStr(m.at[0]) + "/" + toStr(t.at[0]) + " " + toStr(m.inner.v) + "/" + toStr(t.inner.v) + " " + z.name + t.name);
    return 0;
}
