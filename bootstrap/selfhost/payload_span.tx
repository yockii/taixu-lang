// Private Value16 spans; no Zig union offsets or OS dependencies.
import { PAYLOAD_OFF_KIND, PAYLOAD_OFF_BACKING, PAYLOAD_OFF_LIST } from "./payload_abi";
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function d(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function m(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
function md(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { op(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
function call(b: Ref<StructuredBuffer>, name: string): void { jump(b, "call", name); }
function ret(b: Ref<StructuredBuffer>): void { op(b, "ret", 0, asStructuredMissing(), asStructuredMissing()); }
// rcx=base, rdx=count; r10=end-exclusive; zero count permits any pointer.
function checked(b: Ref<StructuredBuffer>, p: string): void {
    two(b, "movabs", r(10), i(1152921504606846975)); two(b, "cmp", r(2), r(10)); jump(b, "ja", p + "_bad");
    two(b, "test", r(2), r(2)); jump(b, "jz", p + "_empty");
    two(b, "test", r(1), r(1)); jump(b, "jz", p + "_bad");
    mov(b, r(10), r(2)); two(b, "shl", r(10), i(4)); two(b, "add", r(10), r(1)); jump(b, "jb", p + "_bad");
}
export function payloadSpanEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_vs_alloc";
    lab(b, "__tx_native_values_alloc_v1");
    two(b, "movabs", r(10), i(1152921504606846975)); two(b, "cmp", r(1), r(10)); jump(b, "ja", p + "_bad");
    two(b, "test", r(1), r(1)); jump(b, "jz", p + "_empty");
    two(b, "sub", r(4), i(56)); mov(b, m(4, 32), r(1)); two(b, "shl", r(1), i(4)); mov(b, d(2), i(8)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", p + "_return");
    mov(b, m(4, 40), r(0)); mov(b, r(1), r(0)); mov(b, r(2), m(4, 32)); call(b, "__tx_native_values_init_v1"); mov(b, r(0), m(4, 40));
    lab(b, p + "_return"); two(b, "add", r(4), i(56)); ret(b);
    lab(b, p + "_empty"); mov(b, r(0), i(8)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_vs_init"; lab(b, "__tx_native_values_init_v1"); checked(b, p);
    lab(b, p + "_loop"); mov(b, m(1, 0), i(4)); mov(b, m(1, 8), i(0)); two(b, "add", r(1), i(16)); two(b, "cmp", r(1), r(10)); jump(b, "jb", p + "_loop");
    lab(b, p + "_empty"); mov(b, r(0), i(1)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_vs_read"; lab(b, "__tx_native_values_read_v1"); checked(b, p);
    two(b, "cmp", r(8), r(2)); jump(b, "jae", p + "_bad"); two(b, "test", r(9), r(9)); jump(b, "jz", p + "_bad");
    two(b, "shl", r(8), i(4)); two(b, "add", r(1), r(8)); mov(b, r(10), m(1, 0)); mov(b, r(11), m(1, 8)); mov(b, m(9, 0), r(10)); mov(b, m(9, 8), r(11)); mov(b, r(0), i(1)); ret(b);
    lab(b, p + "_empty"); lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_vs_free"; lab(b, "__tx_native_values_free_v1"); checked(b, p); jump(b, "jmp", "__tx_native_mem_free");
    lab(b, p + "_empty"); lab(b, p + "_bad"); ret(b);

    // Snapshot both Values before either RC call; caller owns a valid live slot.
    lab(b, "__tx_native_value_replace_v1"); two(b, "sub", r(4), i(72)); mov(b, m(4, 64), r(1));
    mov(b, r(10), m(2, 0)); mov(b, r(11), m(2, 8)); mov(b, m(4, 32), r(10)); mov(b, m(4, 40), r(11));
    mov(b, r(10), m(1, 0)); mov(b, r(11), m(1, 8)); mov(b, m(4, 48), r(10)); mov(b, m(4, 56), r(11));
    mov(b, r(1), r(4)); two(b, "add", r(1), i(32)); call(b, "__tx_retain");
    mov(b, r(1), r(4)); two(b, "add", r(1), i(48)); call(b, "__tx_release");
    mov(b, r(1), m(4, 64)); mov(b, r(10), m(4, 32)); mov(b, r(11), m(4, 40)); mov(b, m(1, 0), r(10)); mov(b, m(1, 8), r(11)); two(b, "add", r(4), i(72)); ret(b);

    p = "__tx_vs_dispose"; lab(b, "__tx_native_payload_dispose_v1");
    two(b, "cmp", md(1, PAYLOAD_OFF_KIND), i(2)); jump(b, "je", p + "_list");
    two(b, "cmp", md(1, PAYLOAD_OFF_KIND), i(1)); jump(b, "jne", p + "_return");
    mov(b, r(1), m(1, PAYLOAD_OFF_BACKING)); two(b, "test", r(1), r(1)); jump(b, "jz", p + "_return"); jump(b, "jmp", "__tx_native_mem_free");
    lab(b, p + "_list"); two(b, "add", r(1), i(PAYLOAD_OFF_LIST)); jump(b, "jmp", "__tx_native_list_destroy_v1");
    lab(b, p + "_return"); ret(b);
}
