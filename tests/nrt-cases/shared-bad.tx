// 线程第 4c 步：Shared 与 Atomic 的静态检查（线程设计 §二十一-5）。
struct Holder {
    a: Atomic< int>,
}

struct Watch {
    w: Weak< Holder>,
}

function main(args: []string): void {
    const h: Ref< Holder> = new Holder { a: atomicNew(1) };
    const t = threadSpawn((): int => atomicLoad(h.a));
    const w: Weak< Holder> = weak(h);
    const s = sharedNew(new Watch { w: w });
    const s2 = sharedNew(h);
    print(toStr(s2 == s2));
    print(toStr(sharedGet(h)));
    atomicStore(h.a, "x");
    print(toStr(atomicNew(1) == atomicNew(1)));
    const fx: Atomic< float> = atomicNew(1);
}
