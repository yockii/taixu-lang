// ============================================================================
// engine/mac/m_size —— objc_msgSend：id(id, SEL, NSSize)（如 setContentSize:、setContentMinSize:）。
// ============================================================================

import { NSSIZE } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: NSSIZE): usize from "/usr/lib/libobjc.A.dylib";

export function msgSize(o: usize, s: string, w: float, h: float): usize {
    return objc_msgSend(o, sel_registerName(s), NSSIZE { w: w, h: h });
}
