    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 4), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 4), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 5), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 5), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 6), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 6), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 7), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 7), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 8), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 8), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 9), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 9), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 10), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 10), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 11), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 11), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 12), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 12), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 13), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 13), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 14), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 14), asStructuredMissing(), 1);
    asBufferInstruction(buf, "test", 2, asStructuredReg(2, 15), asStructuredReg(2, 15), asStructuredMissing(), 1);
    asBufferInstruction(buf, "and", 2, asStructuredReg(2, 15), asStructuredReg(2, 15), asStructuredMissing(), 1);
    asBufferInstruction(buf, "sete", 1, asStructuredReg(2, 15), asStructuredMissing(), asStructuredMissing(), 1);
    asBufferInstruction(buf, "setb", 1, asStructuredReg(2, 15), asStructuredMissing(), asStructuredMissing(), 1);
    asBufferInstruction(buf, "setnp", 1, asStructuredReg(2, 15), asStructuredMissing(), asStructuredMissing(), 1);
    asStructuredBegin(); asBufferSubmit(buf);
    assert(asFailedAs() == 0, asLastErrAs());
    const structured = asImgText();
    assert(bytesLen(text) == bytesLen(structured), "text/structured lengths differ");
    let i = 0;
    while (i < bytesLen(text)) {
        assert((bytesGet(text, i) catch -1) == (bytesGet(structured, i) catch -2), "text/structured bytes differ");
        i = i + 1;
    }
    writeFileBytes(args[2], structured) catch (e) { eprint(e.message); return 1; };
    const invalid: List<string> = listNew();
    listPush(invalid, "mov r11b, qword ptr [r11]"); listPush(invalid, "mov dword ptr [r10], r11b");
    listPush(invalid, "test xmm0, xmm0"); listPush(invalid, "mov ah, byte ptr [rax]");
    listPush(invalid, "mov r16b, byte ptr [rax]");
    i = 0;
    while (i < listLen(invalid)) {
        assembleText(".text\n" + (listGet(invalid, i) catch "") + "\n");
        assert(asFailedAs() == 1 && asLastErrAs() == "BadOperand", "invalid byte operand accepted");
        i = i + 1;
    }
    print("PASS_ALL_LOW_BYTE_REGISTERS_TEXT_STRUCTURED_AND_REJECTIONS"); return 0;
}
