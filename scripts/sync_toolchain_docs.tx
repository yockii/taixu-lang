// 只同步派生文档 docs/ai/toolchain-changes.md，不重建编译器（build.tx 的 --sync-docs 在整轮构建之后做同一件事；核对与渲染见
// toolchain_docs.tx）。产品版本只在 bootstrap/selfhost/toolchain.tx 修改。
// 运行（仓根）：taixu run --toolchain scripts/sync_toolchain_docs.tx --compiler <由当前源码构建的原生 taixu> [--check] [--root <仓库>]
// --check 只检查、不写入。成功退出码 0；核对不过、文档不一致（--check）或读写失败时 1，参数不对时 2。
import { absolute, isAbs, nat } from "./build_lib";
import { osRealPath } from "./build_os";
import { CHANGES_DOC, syncDocs } from "./toolchain_docs";

const USAGE: string = "用法：taixu run --toolchain scripts/sync_toolchain_docs.tx --compiler <由当前源码构建的原生 taixu> [--check] [--root <仓库>]";

function main(argv: []string): int {
    let compiler = "";
    let root = "";
    let check = false;
    let i: int = 0;
    while (i < len(argv)) {
        const a = argv[i];
        if (a == "--check") {
            check = true;
            i = i + 1;
        } else if ((a == "--compiler" || a == "--root") && i + 1 < len(argv)) {
            if (a == "--compiler") {
                compiler = argv[i + 1];
            } else {
                root = argv[i + 1];
            }
            i = i + 2;
        } else {
            eprint(USAGE);
            return 2;
        }
    }
    if (len(compiler) == 0) {
        eprint(USAGE);
        return 2;
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = osRealPath(nat(root));
    if (!isAbs(compiler)) {
        compiler = absolute(compiler);
    }
    const changed = syncDocs(compiler, root, check) catch (e) {
        eprint("同步失败：" + e.message);
        return 1;
    };
    if (changed) {
        print("PASS 已同步 " + CHANGES_DOC);
    } else {
        print("PASS 已一致 " + CHANGES_DOC);
    }
    return 0;
}
