// V0.9-A2 e2e：嵌套 TaskGroup limit 窗口（std/task；D26 §四）——外层 drain
// 期间内层任务自建组并以 limit=2 批环收割；完成序＝裁决序（FIFO＋插入序）。
import { taskGroupNew, taskGroupAdd, taskGroupDrain, taskGroupFailed } from "std/task";

async function inner(n: int): int {
    return n * 100;
}

async function outerJob(): int {
    return 7;
}

// 内层批环任务：自建组（3 任务，limit=2）→ 收割后把结果和写入 probe。
async function innerBatch(probe: Ref<Probe>): int {
    const g = taskGroupNew();
    taskGroupAdd(g, inner(1));
    taskGroupAdd(g, inner(2));
    taskGroupAdd(g, inner(3));
    const rs = taskGroupDrain(g, 2);
    const xs = (await rs catch err("inner drain failed"))?;
    let acc: int = 0;
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch -1;
        print("inner:" + toStr(v));
        acc = acc + v;
        i = i + 1;
    }
    probe.innerSum = acc;
    return acc;
}

struct Probe {
    innerSum: int,
}

// 外层收割观察者：外层 drain 完成后逐项打印＋内层探针断言。
async function reporter(rs: Future<List<int>>, probe: Ref<Probe>): void {
    const xs = (await rs catch err("outer drain failed"))?;
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch -1;
        print("outer:" + toStr(v));
        i = i + 1;
    }
    print("inner-sum:" + toStr(probe.innerSum));
    print("probe-ok:" + toStr(probe.innerSum / 600));
}

function main(args: []string): int {
    const probe = new Probe { innerSum: 0 };
    const outer = taskGroupNew();
    taskGroupAdd(outer, innerBatch(probe));
    taskGroupAdd(outer, outerJob());
    const rs = taskGroupDrain(outer, 2);
    reporter(rs, probe);
    print("main-done");
    return 0;
}
