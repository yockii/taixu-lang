// D3 v0.19：defer——块作用域、后进先出、循环内逐轮执行、各出口（块尾/return/break/continue/?/catch 内 return）均执行。
struct Box { v: int }

function log(s: string): void { print(s); }

function order(): void {
    defer log("order: 3");
    defer { log("order: 2"); }
    log("order: 1");
}

function loops(): void {
    let i = 0;
    while (i < 3) {
        defer log("while end " + toStr(i));
        i = i + 1;
        if (i == 2) { continue; }
        log("while body " + toStr(i));
    }
    for (let j = 0; j < 4; j = j + 1) {
        defer log("for defer " + toStr(j));
        if (j == 2) { break; }
        log("for body " + toStr(j));
    }
    const xs: List< int> = listNew();
    listPush(xs, 10);
    listPush(xs, 20);
    for (x in xs) {
        defer log("forin defer " + toStr(x));
        log("forin " + toStr(x));
    }
    log("loops done");
}

function retTiming(): int {
    let n = 1;
    defer { n = 100; log("defer sees n=" + toStr(n)); }
    n = 5;
    return n * 2;
}

function retStruct(): Box {
    let b = Box { v: 1 };
    defer { b.v = 99; }
    return b;
}

function retRef(): Ref< Box> {
    const r = new Box { v: 1 };
    defer { r.v = 42; }
    return r;
}

function mayFail(ok: bool): int | Error {
    if (ok) { return 7; }
    return err("boom");
}

function propagate(ok: bool): int | Error {
    defer log("propagate defer ok=" + toStr(ok));
    const v = mayFail(ok)?;
    log("propagate got " + toStr(v));
    return v + 1;
}

function handler(): int {
    defer log("handler outer defer");
    const v = mayFail(false) catch (e) {
        defer log("handler inner defer");
        log("handler caught " + e.message);
        return -5;
    };
    return v;
}

function nested(): void {
    defer log("nested outer");
    if (true) {
        defer log("nested inner");
        log("nested body");
    }
    log("nested after if");
}

function deferInDefer(): void {
    defer {
        defer log("inner of defer");
        log("outer defer body");
    }
    log("deferInDefer body");
}

function earlyReturn(): int {
    defer log("early fn defer");
    let i = 0;
    while (true) {
        defer log("early loop defer " + toStr(i));
        if (i == 1) { return i * 10; }
        i = i + 1;
    }
    return -1;
}

function assignForm(): int {
    let x = 1;
    defer x = 5;
    x = 2;
    return x;
}

export function main(args: []string): int {
    order();
    loops();
    print("retTiming=" + toStr(retTiming()));
    print("retStruct=" + toStr(retStruct().v));
    print("retRef=" + toStr(retRef().v));
    const a = propagate(true) catch -1;
    print("a=" + toStr(a));
    const b = propagate(false) catch -1;
    print("b=" + toStr(b));
    print("handler=" + toStr(handler()));
    nested();
    deferInDefer();
    print("early=" + toStr(earlyReturn()));
    print("assignForm=" + toStr(assignForm()));
    return 0;
}
