// V0.9-A1 e2e：取消即确定性清理——被取消任务与全部 future 释放后滞留为零
//（原生 --leak-check 退出扫描，D26 §三-6）。
function main(args: []string): int {
    const slow = slowJob(3);
    const watcher = watch(slow);
    taskCancel(slow);
    print("spawned");
    return 0;
}

async function slowJob(n: int): int {
    let i: int = 0;
    while (i < n) {
        i = i + 1;
    }
    return 100;
}

async function watch(f: Future<int>): int {
    const v = await f catch (e) {
        return 0;
    };
    return v;
}
