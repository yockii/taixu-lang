// V0.9-A1 e2e：taskAwaitAny 插入序裁决——首个完成者下标；taskCancelled 查询面。
function main(args: []string): int {
    const a = job(1);
    const b = slow(2);
    const r = referee(a, b);
    print("spawned");
    return 0;
}

async function job(n: int): int {
    if (taskCancelled()) {
        print("cancelled");
        return -1;
    }
    print("not-cancelled");
    return n;
}

async function slow(n: int): int {
    let i: int = 0;
    let s: int = 0;
    while (i < n * 100) {
        s = s + i;
        i = i + 1;
    }
    return s;
}

async function referee(a: Future<int>, b: Future<int>): int {
    const l: List<Future<int>> = listNew();
    listPush(l, a);
    listPush(l, b);
    const i = taskAwaitAny(l) catch -1;
    print("first-done-index");
    print(toStr(i));
    const v = await a catch 0;
    print("a-value");
    print(toStr(v));
    return v;
}
