// O4 第二步 2b：定宽运算的内联快路径（设计 §七-4）——操作数来自函数参数、列表元素与循环，
// 以及只在冷路径上完成、不 trap 的运算（isize 的 / -1 与 % -1）。
// 期望值由 scripts/fixtures/fw2-oracle.py 按数学定义与 numpy.float32 独立计算，不由被测实现生成。

function ops_i8(a: i8, b: i8, n: int): void {
    print("i8 " + toStr(a) + " " + toStr(b) + " | " + toStr(a + b) + " " + toStr(a - b) + " " + toStr(a * b) + " " + toStr(a / b) + " " + toStr(a % b));
    print("  bit " + toStr(a & b) + " " + toStr(a | b) + " " + toStr(a ^ b) + " " + toStr(~a) + " " + toStr(a << n) + " " + toStr(a >> n) + " " + toStr(a >>> n));
    print("  wrap " + toStr(wrapAdd(a, b)) + " " + toStr(wrapSub(a, b)) + " " + toStr(wrapMul(a, b)) + " " + toStr(-a));
}

