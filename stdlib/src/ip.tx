// 严格 IPv4 / IPv6 字面量到网络顺序的 4 / 16 字节；不包含 zone、端口和 URI 括号。
function v4(text: string): Bytes | Error {
    const parts = strSplit(text, ".");
    if (listLen(parts) != 4) { return err("ip: invalid IPv4 component count"); }
    const out = bytesNew(4); let i = 0;
    for (part in parts) {
        if (len(part) == 0 || len(part) > 3 || (len(part) > 1 && byteAt(part, 0) == 48)) { return err("ip: invalid IPv4 octet"); }
        let n = 0;
        for (c in part) { if (c < 48 || c > 57) { return err("ip: non-decimal IPv4 octet"); } n = n * 10 + c - 48; }
        if (n > 255) { return err("ip: IPv4 octet out of range"); } bytesSet(out, i, n); i = i + 1;
    }
    return out;
}

function nibble(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; } if (c >= 65 && c <= 70) { return c - 55; } if (c >= 97 && c <= 102) { return c - 87; } return -1;
}

function words(text: string, allowV4: bool): List<int> | Error {
    const out: List<int> = listNew();
    if (len(text) == 0) { return out; }
    const parts = strSplit(text, ":"); let i = 0;
    for (part in parts) {
        if (strFind(part, ".") >= 0) {
            if (!allowV4 || i + 1 != listLen(parts)) { return err("ip: embedded IPv4 must end IPv6"); }
            const address = v4(part)?;
            listPush(out, (bytesGet(address, 0) catch 0) * 256 + (bytesGet(address, 1) catch 0));
            listPush(out, (bytesGet(address, 2) catch 0) * 256 + (bytesGet(address, 3) catch 0));
        } else {
            if (len(part) == 0 || len(part) > 4) { return err("ip: invalid IPv6 group"); }
            let n = 0;
            for (c in part) { const v = nibble(c); if (v < 0) { return err("ip: non-hex IPv6 group"); } n = n * 16 + v; }
            listPush(out, n);
        }
        i = i + 1;
    }
    return out;
}

export function parseIp(text: string): Bytes | Error {
    if (len(text) == 0 || len(text) > 45) { return err("ip: invalid address length"); }
    if (strFind(text, ":") < 0) { return v4(text); }
    const split = strFind(text, "::"); let left: List<int> = listNew(); let right: List<int> = listNew(); let zeros = 0;
    if (split < 0) {
        left = words(text, true)?;
        if (listLen(left) != 8) { return err("ip: IPv6 requires eight groups"); }
    } else {
        const a = strSlice(text, 0, split); const b = strSlice(text, split + 2, len(text));
        if (strFind(b, "::") >= 0) { return err("ip: repeated IPv6 compression"); }
        left = words(a, false)?; right = words(b, true)?; zeros = 8 - listLen(left) - listLen(right);
        if (zeros < 1) { return err("ip: IPv6 compression must omit a group"); }
    }
    const all: List<int> = listNew();
    for (n in left) { listPush(all, n); } let i = 0;
    while (i < zeros) { listPush(all, 0); i = i + 1; } for (n in right) { listPush(all, n); }
    const out = bytesNew(16); i = 0;
    for (n in all) { bytesSet(out, i, n >> 8); bytesSet(out, i + 1, n & 255); i = i + 2; }
    return out;
}
