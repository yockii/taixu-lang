// 文件访问边界（docs/design/v052-path-canonical-v0.1-20261025.md）：驱动内部路径以 / 分隔；Windows 宿主上把 \ 也换成 /（Win32
// 两者都认，下游按 / 切），类 Unix 上原样——\ 是名字里的普通字符。
import { pathOnWindows } from "./path_sep";

export function filePath(path: string): string {
    if (!pathOnWindows() || strIndexOf(path, "\\") < 0) { return path; }
    let out = "";
    let bytePos = 0;
    let cpPos = 0;
    while (bytePos < len(path)) {
        const c = byteAt(path, bytePos) catch 0;
        if (c == 92) { out = out + "/"; }
        else { out = out + strSub(path, cpPos, 1); }
        if (c >= 240) { bytePos = bytePos + 4; }
        else if (c >= 224) { bytePos = bytePos + 3; }
        else if (c >= 192) { bytePos = bytePos + 2; }
        else { bytePos = bytePos + 1; }
        cpPos = cpPos + 1;
    }
    return out;
}
