// M6 字段借用回归：字段值直接作内建实参时 NRT 不 retain（调用后清空）。
// 覆盖：字段在调用后被改写再经 Weak 观察、List 字段句柄修改、Ref 自动解引用、
// 循环内重复读取、字段串参与拼接；期望与 VM 逐字节一致。
struct Node { name: string }
struct Holder { name: string, items: List<int>, child: Ref<Node>, tag: string }
function total(h: Ref<Holder>): int {
    let s = 0;
    let i = 0;
    while (i < listLen(h.items)) {
        s = s + (listGet(h.items, i) catch 0);
        i = i + 1;
    }
    return s;
}
function firstByte(h: Ref<Holder>): int {
    return byteAt(h.name, 0) catch -1;
}
export function main(args: []string): int {
    const h = new Holder { name: "holder", items: listNew(), child: new Node { name: "A" }, tag: "t" };
    listPush(h.items, 3);
    listPush(h.items, 4);
    print(toStr(len(h.name)) + " " + toStr(total(h)) + " " + toStr(firstByte(h)));
    const w = weak(h.child);
    h.child = new Node { name: "B" };
    print((deref(w) catch Node { name: "DEAD" }).name);
    const w2 = weak(h.child);
    print(toStr(len(h.child.name)));
    h.child = new Node { name: "C" };
    print((deref(w2) catch Node { name: "DEAD" }).name);
    let k = 0;
    while (k < 3) {
        h.tag = h.tag + toStr(len(h.name) + k);
        listPush(h.items, len(h.tag));
        k = k + 1;
    }
    print(h.tag + " " + toStr(total(h)) + " " + toStr(listLen(h.items)));
    const parts = strSplit(h.name + "-" + h.tag, "-");
    print(toStr(listLen(parts)) + " " + (listGet(parts, 1) catch "?"));
    const old = h.items;
    h.items = listNew();
    listPush(old, 100);
    print(toStr(listLen(old)) + " " + toStr(listLen(h.items)));
    return 0;
}
