// ? 只允许同种传播或放宽为 Error；跨错误种类须 catch 显式转换（3028）。
enum A extends Error {
    X = "x",
}

enum B extends Error {
    Y = "y",
}

function fa(): int | A {
    return A.X;
}

function fb(): int | B {
    const v = fa()?;
    return v;
}

export function main(args: []string): int {
    const v = fb() catch 0;
    return v;
}
