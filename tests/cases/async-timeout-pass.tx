// V0.10-A1 e2e：timeout 不命中（D29 §二）——f 先完成透传；60s 定时器
// 排水收割为空操作（pump 出口，mem-report 零滞留面）。
import { timeout } from "std/task";

function main(args: []string): int {
    const t = runner();
    print("spawned");
    return 0;
}

async function runner(): int {
    const fast = quick(42);
    const v = await timeout(fast, 60000) catch (e) {
        print("err: " + e.message);
        return 0;
    };
    print("passthrough: " + toStr(v));
    return 0;
}

async function quick(n: int): int {
    return n;
}
