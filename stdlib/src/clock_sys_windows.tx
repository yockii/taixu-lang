declare function QueryPerformanceCounter(value: Bytes): i32 from "kernel32";
declare function QueryPerformanceFrequency(value: Bytes): i32 from "kernel32";

export function sysMonotonicNs(): int {
    const ticks = bytesNew(8); const frequency = bytesNew(8);
    if (QueryPerformanceCounter(ticks) == 0 || QueryPerformanceFrequency(frequency) == 0) { return -1; }
    const t = bytesGetLE<i64>(ticks, 0) catch -1; const f = bytesGetLE<i64>(frequency, 0) catch -1;
    if (t < 0 || f <= 0 || t / f > 9223372036) { return -1; }
    // 商与余数分开，避免高频计数器的 ticks * 10^9 溢出。
    const nanos = ((t % f) as float / (f as float) * 1000000000.0) as int;
    const whole = (t / f) * 1000000000;
    if (whole > 9223372036854775807 - nanos) { return -1; } return whole + nanos;
}
