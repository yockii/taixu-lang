// O4 第二步 2c2：Bytes 与 List<u8> 零拷贝互转（设计 §五-4、§七-1）——bytesAsList/listAsBytes 返回同一个对象：
// 两侧交替推入并跨过扩容、同时作为参数传入、释放一侧后用另一侧、listPop 缩短后 Bytes 一侧再推入、空对象互转、
// 发送与 Shared，以及 20 万次互转的循环（峰值内存另测）。期望值由 Python bytearray 逐步模拟。
function both(b: Bytes, l: List< u8>): void {
    bytesPush(b, 1);
    const two: u8 = 2;
    listPush(l, two);
    print("both " + toStr(bytesLen(b)) + " " + toStr(listLen(l)));
}

function sumBytes(b: Bytes): int {
    let s = 0;
    let i = 0;
    while (i < bytesLen(b)) {
        s = s + (bytesGet(b, i) catch 0);
        i = i + 1;
    }
    return s;
}

function main(args: []string): int {
    const b = bytesNew(0);
    const l = bytesAsList(b);
    let i = 0;
    while (i < 100) {
        if (i % 2 == 0) {
            bytesPush(b, i);
        } else {
            listPush(l, i as u8);
        }
        i = i + 1;
    }
    print("alt " + toStr(bytesLen(b)) + " " + toStr(listLen(l)) + " " + toStr(sumBytes(b)) + " " + toStr(listGet(l, 99) catch 0));
    both(b, l);
    const z: u8 = 0;
    const p = listPop(l) catch z;
    print("pop " + toStr(p) + " " + toStr(bytesLen(b)));
    bytesPush(b, 255);
    print("push " + toStr(listLen(l)) + " " + toStr(listGet(l, 101) catch z));
    listRemoveAt(l, 0);
    print("rm " + toStr(bytesGet(b, 0) catch -1) + " " + toStr(bytesLen(b)));
    const v200: u8 = 200;
    listSet(l, 0, v200);
    bytesSet(b, 1, 77);
    listInsert(l, 2, v200);
    print("set " + toStr(bytesGet(b, 0) catch -1) + " " + toStr(listGet(l, 1) catch z) + " " + toStr(bytesGet(b, 2) catch -1) + " " + toStr(bytesLen(b)));
    const l2 = bytesAsList(bytesFromStr("hello"));
    listPush(l2, 33 as u8);
    const b2 = listAsBytes(l2);
    print("str " + (bytesToStr(b2) catch "?") + " " + toStr(listLen(l2)));
    const nums: List< u8> = listNew();
    listPush(nums, 72 as u8);
    listPush(nums, 105 as u8);
    const nb = listAsBytes(nums);
    print("lab " + (bytesToStr(nb) catch "?") + " " + toStr(bytesEqual(nb, bytesFromStr("Hi"))));
    bytesAppend(nb, nb);
    print("app " + toStr(listLen(nums)) + " " + (bytesToStr(listAsBytes(nums)) catch "?"));
    const sl = bytesSlice(nb, 1, 2);
    print("slice " + (bytesToStr(sl) catch "?") + " " + toStr(listLen(bytesAsList(sl))));
    const e: List< u8> = listNew();
    const eb = listAsBytes(e);
    print("empty " + toStr(bytesLen(eb)) + "|" + (bytesToStr(eb) catch "?") + "|");
    bytesPush(eb, 65);
    print("grow " + toStr(listLen(e)) + " " + toStr(listGet(e, 0) catch z));
    const t = threadSpawn((): int => sumBytes(b));
    print("thread " + toStr(threadJoin(t) catch -1) + " " + toStr(sumBytes(b)));
    const sh = sharedNew(b);
    const sb = sharedGet(sh);
    const sl2 = bytesAsList(sb);
    print("shared " + toStr(bytesLen(sb)) + " " + toStr(listLen(sl2)) + " " + toStr(listGet(sl2, 2) catch z));
    let k = 0;
    let acc = 0;
    while (k < 200000) {
        const x = bytesFromStr("abcdefghij");
        const xl = bytesAsList(x);
        listPush(xl, 107 as u8);
        const xb = listAsBytes(xl);
        acc = acc + bytesLen(xb);
        k = k + 1;
    }
    print("loop " + toStr(acc));
    return 0;
}
