// bench/algo/nbody —— N 体引力模拟（5 体 × 200,000 步；确定性初值与牛顿
// 迭代 sqrt 近似——校验和跨执行/跨执行引擎逐字节一致）。
function sqrtApprox(v: float): float {
    let g: float = v;
    let it: int = 0;
    while (it < 8) {
        g = 0.5 * (g + v / g);
        it = it + 1;
    }
    return g;
}

struct Body {
    x: float,
    y: float,
    z: float,
    vx: float,
    vy: float,
    vz: float,
}

const DT: float = 0.01;

function advance(bs: List< Ref<Body>>, steps: int): void {
    let s: int = 0;
    const n: int = listLen(bs);
    while (s < steps) {
        let i: int = 0;
        while (i < n) {
            const bi: Ref<Body> = listGet(bs, i) catch new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
            let j: int = 0;
            while (j < n) {
                if (i != j) {
                    const bj: Ref<Body> = listGet(bs, j) catch new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
                    const dx: float = bj.x - bi.x;
                    const dy: float = bj.y - bi.y;
                    const dz: float = bj.z - bi.z;
                    const d2: float = dx * dx + dy * dy + dz * dz + 0.01;
                    const inv: float = 1.0 / (d2 * sqrtApprox(d2));
                    bi.vx = bi.vx + dx * inv * DT;
                    bi.vy = bi.vy + dy * inv * DT;
                    bi.vz = bi.vz + dz * inv * DT;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        let k: int = 0;
        while (k < n) {
            const bk: Ref<Body> = listGet(bs, k) catch new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
            bk.x = bk.x + bk.vx * DT;
            bk.y = bk.y + bk.vy * DT;
            bk.z = bk.z + bk.vz * DT;
            k = k + 1;
        }
        s = s + 1;
    }
}

export function main(args: []string): int {
    const bs: List< Ref<Body>> = listNew();
    listPush(bs, new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.5, vy: 0.2, vz: 0.1 });
    listPush(bs, new Body { x: 1.0, y: 0.5, z: 0.0, vx: -0.3, vy: 0.4, vz: 0.2 });
    listPush(bs, new Body { x: -0.5, y: 1.0, z: 0.5, vx: 0.2, vy: -0.5, vz: 0.3 });
    listPush(bs, new Body { x: 2.0, y: -1.0, z: 1.0, vx: 0.1, vy: 0.1, vz: -0.2 });
    listPush(bs, new Body { x: -1.0, y: -0.5, z: -1.0, vx: -0.2, vy: 0.3, vz: 0.0 });
    advance(bs, 200000);
    let kinetic: float = 0.0;
    let k: int = 0;
    while (k < listLen(bs)) {
        const b: Ref<Body> = listGet(bs, k) catch new Body { x: 0.0, y: 0.0, z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0 };
        kinetic = kinetic + 0.5 * (b.vx * b.vx + b.vy * b.vy + b.vz * b.vz);
        k = k + 1;
    }
    print(toStr((kinetic * 1000000.0) as int));
    return 0;
}
