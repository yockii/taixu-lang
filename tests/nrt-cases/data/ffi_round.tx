// ffi-win-struct 与 ffi-linux-struct 共用的往返结构体：覆盖全部字段种类（窄整数的符号与零扩展、
// 64 位整数、f32、句柄、[1]u8 与多元素定长数组、按值嵌套），C 布局 104 字节（见 ROUND_SIZE）。
export declare type H;
export declare struct INNER { a: i8, b: i16, c: [3]u8, d: f32 }
export declare struct ROUND { i8v: i8, u16v: u16, i32v: i32, u32v: u32, u64v: u64, isz: isize, usz: usize, f32v: f32, fv: float, iv: int, h: H, one: [1]u8, inner: INNER, inner2: INNER, tail: u8 }

// i8@0 u16@2 i32@4 u32@8 u64@16 isize@24 usize@32 f32@40 float@48 int@56 H@64 [1]u8@72
// INNER@76（a@0 b@2 c@4..6 d@8，大小 12、对齐 4）INNER@88 u8@100，按 8 对齐到 104。
export const ROUND_SIZE: int = 104;

export function filled(): Ref< ROUND> {
    const i1 = INNER { a: -128, b: -32768, c: [1, 2, 255], d: 1.5 };
    const i2 = INNER { a: 127, b: 32767, c: [9, 8, 7], d: -0.25 };
    return new ROUND { i8v: -5, u16v: 65000, i32v: -7, u32v: 4000000000, u64v: 12345678901234, isz: -9, usz: 77, f32v: 0.1, fv: -2.5, iv: -1234567890123, h: handleFromBits < H > (4096), one: [200], inner: i1, inner2: i2, tail: 255 };
}

export function empty(): Ref< ROUND> {
    const z = INNER { a: 0, b: 0, c: [0, 0, 0], d: 0.0 };
    return new ROUND { i8v: 0, u16v: 0, i32v: 0, u32v: 0, u64v: 0, isz: 0, usz: 0, f32v: 0.0, fv: 0.0, iv: 0, h: handleFromBits < H > (0), one: [0], inner: z, inner2: z, tail: 0 };
}

function showInner(x: INNER): string {
    return toStr(x.a) + "/" + toStr(x.b) + "/" + toStr(x.c[0]) + "," + toStr(x.c[1]) + "," + toStr(x.c[2]) + "/" + toStr(x.d as float);
}

export function show(r: Ref< ROUND>): string {
    return toStr(r.i8v) + " " + toStr(r.u16v) + " " + toStr(r.i32v) + " " + toStr(r.u32v) + " " + toStr(r.u64v) + " " + toStr(r.isz) + " " + toStr(r.usz) + " " + toStr(r.f32v as float) + " " + toStr(r.fv) + " " + toStr(r.iv) + " " + toStr(handleBits(r.h)) + " " + toStr(r.one[0]) + " [" + showInner(r.inner) + "] [" + showInner(r.inner2) + "] " + toStr(r.tail);
}
