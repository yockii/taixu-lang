// 标准输出读端已关闭时：stdoutWrite 得 −1 而不结束进程；之后的 print 与 Linux 缺省一样按 SIGPIPE 结束（macOS 上
// stdoutWrite 已给 SIGPIPE 装了空处理函数，内核遇 EPIPE 复位后重发，M3 设计 G5）。父进程交下 SIG_IGN 时 print 只得
// EPIPE、继续执行；Windows 没有 SIGPIPE，同样继续。运行方先关标准输出的读端、再关标准输入，本程序读到流尾才写。
function main(args: []string): int {
    const b = bytesNew(64);
    while (stdinRead(b, -1) >= 0) {}
    const w = stdoutWrite(bytesFromStr("x"));
    eprint("stdoutWrite " + toStr(w));
    print("after");
    eprint("PASS_PRINT_PIPE_SURVIVED");
    return 0;
}
