// D3 v0.50 修正：块形 catch (e) 之后在同一块里声明的名字只在本块可见——块外再声明同名的绑定不报重复（原先误报 3003）。
function parse(s: string): int | Error {
    if (len(s) == 0) { return err("空"); }
    return len(s);
}

function twice(a: string, b: string): int {
    if (true) {
        const n = parse(a) catch (e) { return -1; };
        const total = n * 10;
        print(toStr(total));
    }
    const total = parse(b) catch (e) { return -2; };
    return total;
}

function main(args: []string): void {
    print(toStr(twice("abc", "de")));
    print(toStr(twice("", "de")));
    print(toStr(twice("abc", "")));
}
