// 有界 DER 低标签节点；不代替 ASN.1 schema。所有范围均为 Bytes 的字节偏移，end 为开区间。
export struct DerValue { tag: int, start: int, content: int, end: int }
export struct DerBits { unused: int, data: Bytes }

function at(data: Bytes, i: int): int { return bytesGet(data, i) catch panic("der: internal bounds"); }

export function derRead(data: Bytes, start: int, end: int): DerValue | Error {
    if (start < 0 || end < start || end > bytesLen(data) || end - start < 2) { return err("der: invalid or truncated range"); }
    const tag = at(data, start);
    if ((tag & 31) == 31 || ((tag & 31) == 0 && (tag & 192) == 0)) { return err("der: unsupported high tag or end-of-contents"); }
    const first = at(data, start + 1); let content = start + 2; let length = first;
    if ((first & 128) != 0) {
        const count = first & 127;
        if (count == 0 || count > 8 || count > end - content) { return err("der: indefinite or oversized length"); }
        if (at(data, content) == 0) { return err("der: redundant length octet"); }
        length = 0; let i = 0;
        while (i < count) {
            const b = at(data, content + i);
            if (length > (9223372036854775807 - b) / 256) { return err("der: length overflow"); }
            length = length * 256 + b; i = i + 1;
        }
        if (length < 128) { return err("der: non-minimal long length"); }
        content = content + count;
    }
    if (length > end - content) { return err("der: truncated value"); }
    return DerValue { tag: tag, start: start, content: content, end: content + length };
}

function valid(data: Bytes, value: DerValue): bool {
    return value.tag >= 0 && value.tag <= 255 && value.start >= 0 && value.content >= value.start && value.end >= value.content
    && value.end <= bytesLen(data) && value.content - value.start >= 2;
}

export function derContents(data: Bytes, value: DerValue): Bytes | Error {
    if (!valid(data, value)) { return err("der: invalid node range"); }
    return bytesSlice(data, value.content, value.end - value.content);
}

export function derChildren(data: Bytes, value: DerValue, maxCount: int): List<DerValue> | Error {
    if (!valid(data, value) || (value.tag & 32) == 0 || maxCount < 0) { return err("der: invalid constructed node or limit"); }
    const out: List<DerValue> = listNew(); let offset = value.content;
    while (offset < value.end) {
        if (listLen(out) >= maxCount) { return err("der: child count limit"); }
        const child = derRead(data, offset, value.end)?; listPush(out, child); offset = child.end;
    }
    return out;
}

// 非负的最短 INTEGER，结果为无符号大端值；零保留一个 00 字节。
export function derPositiveInteger(data: Bytes, value: DerValue, maxBytes: int): Bytes | Error {
    if (!valid(data, value) || value.tag != 2 || value.end == value.content || maxBytes < 1) { return err("der: invalid positive INTEGER"); }
    let start = value.content; const first = at(data, start);
    if (first >= 128) { return err("der: negative INTEGER"); }
    if (value.end - start > 1 && first == 0) {
        if (at(data, start + 1) < 128) { return err("der: redundant INTEGER zero"); }
        start = start + 1;
    }
    if (value.end - start > maxBytes) { return err("der: INTEGER size limit"); }
    return bytesSlice(data, start, value.end - start);
}

export function derBitString(data: Bytes, value: DerValue): DerBits | Error {
    if (!valid(data, value) || value.tag != 3 || value.end == value.content) { return err("der: invalid BIT STRING"); }
    const unused = at(data, value.content); const count = value.end - value.content - 1;
    if (unused > 7 || (count == 0 && unused != 0)) { return err("der: invalid unused bit count"); }
    if (count > 0 && (at(data, value.end - 1) & ((1 << unused) - 1)) != 0) { return err("der: nonzero unused bits"); }
    return DerBits { unused: unused, data: bytesSlice(data, value.content + 1, count) };
}
