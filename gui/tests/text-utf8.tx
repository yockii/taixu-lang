// text-utf8 —— 多字节文字的编辑与折行（2026-10-26：示例改真字后发现 TextArea 与 wrapText
// 把每个字节当成一个码位再编码，中文输入与折行都被写成乱码）。TextArea 的列是字节偏移，
// 恒落在字符边界上：左右移动、退格按整个码位走，上下移动吸附到边界；wrapText 按码位折行。
// 纯无头面（占位块轨度量：每字节 8 像素）。
import { canvasNew, textArea, taText, taInsert, taBackspace, taMove, wrapText } from "gui/components";
import { surfaceOpen, surfaceClose } from "gui/surface";

export function main(args: []string): int {
    args;
    const ta = textArea(1, 0, 0, 200, 100, "中文ab\nx");
    taMove(ta, 39, false); // RIGHT：越过“中”整个码位
    print("right cc=" + toStr(ta.cc));
    taMove(ta, 39, false);
    taMove(ta, 37, false); // LEFT：退回“文”的起点
    print("left cc=" + toStr(ta.cc));
    taInsert(ta, "太虚");
    print("insert " + taText(ta) + " cc=" + toStr(ta.cc));
    taBackspace(ta); // 删整个“虚”
    print("back " + taText(ta) + " cc=" + toStr(ta.cc));
    taMove(ta, 40, false); // DOWN：第二行只有 1 字节，列钳到行尾
    print("down cl=" + toStr(ta.cl) + " cc=" + toStr(ta.cc));
    taMove(ta, 39, false);
    taMove(ta, 38, false); // UP：列 1 落在“中”的中间，吸附到 0
    print("up cl=" + toStr(ta.cl) + " cc=" + toStr(ta.cc));
    taMove(ta, 35, true); // shift END：选到行尾
    taInsert(ta, "好");
    print("replace " + taText(ta));

    const s = surfaceOpen(100, 40) catch (e) {
        print("surface open failed: " + e.message);
        return 1;
    };
    const cv = canvasNew(s, 100, 40);
    // 每个汉字 3 字节 × 8 像素 = 24 像素；宽 60 一行放两个汉字。
    for (line in wrapText(cv, "你好世界ab", 60)) {
        print("wrap [" + line + "]");
    }
    surfaceClose(s);
    return 0;
}
