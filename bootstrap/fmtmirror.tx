// bootstrap/fmtmirror —— 编译器工具 taixu fmt 的镜像入口（BOOT-33 工具链自举小闭环；
// V0.44-S1；盘点文书 docs/build/boot33-inventory-v044.md）。
//
// 名称消歧（红线 3）：本件是编译器工具 `taixu fmt`（src/tools/fmt.zig）的 .tx 面，
// 不是 taixu-stdlib 的 std/fmt。去 Zig 第 4 轮第 4 步起，格式化核心与 CLI 移入
// bootstrap/selfhost/fmt.tx，原生编译器的 `taixu fmt` 与本件共用；本件只保留经 Zig VM
// 运行的入口（scripts/fmtmirror-probe.sh 对拍 Zig fmt）与自测块。诊断与 Zig CLI 一样
// 走 stderr（V0.45 起有 eprint 内建）；退出码 0/1/64。
//
// §9 自测（test 块）：`taixu test bootstrap/fmtmirror.tx`。

import { FmtRes, formatSource, fmtCommand } from "./selfhost/fmt";

export function main(args: []string): int {
    const list: List<string> = listNew();
    let i: int = 0;
    while (i < len(args)) {
        listPush(list, args[i]);
        i = i + 1;
    }
    const rc: int = fmtCommand(list);
    if (rc == -64) {
        eprint("fmtmirror: 用法 fmtmirror [--write|--check] <file.tx|目录>...");
        return 64;
    }
    return rc;
}

// ============================================================================
// §9 自测（test 块——经现役 test 驱动 `taixu test bootstrap/fmtmirror.tx` 自证）
// ============================================================================

test "fmt：缩进深度与分号补齐" {
    const r: Ref<FmtRes> = formatSource("function f(): int {\nlet x = 1\nreturn x\n}\nexport function main(args: []string): int { return f(); }\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "    let x = 1;\n") >= 0, "缩进 4 空格＋分号补齐");
    assert(strIndexOf(r.text, "    return x;\n") >= 0, "return 行补齐");
    assert(strIndexOf(r.text, "}\nexport function main") >= 0, "顶层不缩进");
}

test "fmt：字面量构造、点紧贴、Ref 尖括号（quirk 如实锁定）" {
    const r: Ref<FmtRes> = formatSource("const p = {x:1,y:2};\nconst r:Ref<Point> = new Point{x:p.x,y:p.y};\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "{ x: 1, y: 2 }") >= 0, "字面量构造规范化");
    // V0.40-D1 断言对齐：现行类型尖括号启发式呈现 "Ref< Point>"——quirk 锁定
    // （修呈现需重验 fmt-check/golden，非本闭环面）。
    assert(strIndexOf(r.text, "Ref< Point>") >= 0, "类型尖括号 quirk 形态");
    assert(strIndexOf(r.text, "p.x") >= 0, "点紧贴");
    assert(strIndexOf(r.text, "= new Point { x: p.x, y: p.y };") >= 0, "构造调用量规范化");
}

test "fmt：比较运算两侧空格（非类型尖括号）" {
    const r: Ref<FmtRes> = formatSource("if (a<b && c>=d) { return 1; }\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "a < b") >= 0, "比较运算空格");
    assert(strIndexOf(r.text, "c >= d") >= 0, "比较运算空格（≥）");
}

test "fmt：注释保留、连续空行压缩、行间注释不阻断分号补齐" {
    const r: Ref<FmtRes> = formatSource("// header\nlet a = 1\n// note\nlet b = 2;\n\n\n\nconst c = 3;\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "// header\nlet a = 1;\n// note;\nlet b = 2;\n\nconst c = 3;\n") >= 0, "注释保留＋空行压缩＋分号补在注释行之前");
}

test "fmt：一元负号紧贴、双目减号空格" {
    const r: Ref<FmtRes> = formatSource("let a = -1;\nlet b = a - 2;\nlet c = f(-a)-2;\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "= -1;") >= 0, "一元负号紧贴");
    assert(strIndexOf(r.text, "a - 2;") >= 0, "双目减号空格");
    assert(strIndexOf(r.text, "f(-a) - 2;") >= 0, "调用实参一元负号");
}

test "fmt：下标紧贴与 and/or 运算空格" {
    const r: Ref<FmtRes> = formatSource("const a = args[0];\nconst b = true and (1 > 0);\nconst c = false or(2 > 1);\nif (a or (b and true)) { return 1; }\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "args[0];") >= 0, "下标紧贴");
    assert(strIndexOf(r.text, "and (1 > 0);") >= 0, "and 后空格");
    assert(strIndexOf(r.text, "or (2 > 1);") >= 0, "or 后空格");
    assert(strIndexOf(r.text, "a or (b and true)") >= 0, "逻辑运算空格");
}

test "fmt：幂等 fmt(fmt(x)) == fmt(x)" {
    const src: string = "function f(a:int):int{let s=\"x\"+\"y\";return len(s)}\nfunction main(args:[]string):int{return f(\"ab\")}\n";
    const once: Ref<FmtRes> = formatSource(src);
    assert(!once.rejected, "合法源不应拒绝");
    const twice: Ref<FmtRes> = formatSource(once.text);
    assert(!twice.rejected, "fmt 产物应仍合法");
    assert(once.text == twice.text, "幂等不变式");
}

test "fmt：词法错误拒绝格式化（诊断面非空）" {
    const r: Ref<FmtRes> = formatSource("let x = 1 @ 2;\n");
    assert(r.rejected, "词法非法应拒绝");
    assert(r.msg != "", "诊断面应携首错消息");
}

test "fmt：字符串字面量逐字还原（raw 语义——转义不重写）" {
    const r: Ref<FmtRes> = formatSource("const s = \"a\\nb\";\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "const s = \"a\\nb\";") >= 0, "转义序列逐字保留");
}

test "fmt：缺尾逗号的构造记录与声明容器不补分号且幂等" {
    const srcs: List<string> = listNew();
    listPush(srcs, "struct Pair {\nx: int,\ny: int\n}\nfunction make(): Ref<Pair> {\nreturn new Pair {\nx: 1,\n// final field\ny: 2\n};\n}\n");
    listPush(srcs, "const record = {\nfirst: 1,\nlast: call(\n2\n)\n};\n");
    listPush(srcs, "enum Choice {\nFirst,\nLast\n}\n");
    listPush(srcs, "function grouped(): int {\nreturn (\n42\n);\n}\n");
    let i: int = 0;
    while (i < listLen(srcs)) {
        const once: Ref<FmtRes> = formatSource((listGet(srcs, i) catch ""));
        assert(!once.rejected, "合法源不应拒绝");
        assert(strIndexOf(once.text, "y: int;") < 0 && strIndexOf(once.text, "y: 2;") < 0, "字段容器内不补分号");
        assert(strIndexOf(once.text, "Last;") < 0 && strIndexOf(once.text, "42;") < 0, "枚举体与括号内不补分号");
        const twice: Ref<FmtRes> = formatSource(once.text);
        assert(once.text == twice.text, "幂等不变式");
        i = i + 1;
    }
}

test "fmt：字段容器闭合后恢复块内分号补齐" {
    const r: Ref<FmtRes> = formatSource("struct Cell { value: int }\nfunction f(): int {\nconst cell = new Cell {\nvalue: 7\n};\nreturn cell.value\n}\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "value: 7;\n") < 0, "字段记录内不补分号");
    assert(strIndexOf(r.text, "return cell.value;\n") >= 0, "闭合后恢复补齐");
}

test "fmt：defer、interface 行首同样补齐上一行分号（lexer.tx 关键字）" {
    const r: Ref<FmtRes> = formatSource("function f(): void {\nlet x = 1\ndefer print(x)\nlet z = x\n}\nlet y = 2\ninterface Shape {\narea(): int;\n}\n");
    assert(!r.rejected, "合法源不应拒绝");
    assert(strIndexOf(r.text, "    let x = 1;\n    defer print(x);\n    let z = x;\n") >= 0, "defer 前补分号");
    assert(strIndexOf(r.text, "let y = 2;\ninterface Shape {\n") >= 0, "interface 前补分号");
}
