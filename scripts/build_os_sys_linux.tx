// build_os_linux.tx 用的系统调用（x86_64 的号）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux 与 _linux_aarch64
// 两个文件（导出面相同）；种子换代后改成 from syscall "名字" 合成一份。
declare function sysLxOpenat(dir: int, path: string, flags: int, mode: int): int from syscall 257;
declare function sysLxWrite(fd: int, buf: Bytes, n: int): int from syscall 1;
declare function sysLxClose(fd: int): int from syscall 3;
declare function sysLxUnlinkat(dir: int, path: string, flags: int): int from syscall 263;
declare function sysLxRenameat(olddir: int, oldpath: string, newdir: int, newpath: string): int from syscall 264;

export function lxOpenat(dir: int, path: string, flags: int, mode: int): int { return sysLxOpenat(dir, path, flags, mode); }
export function lxWrite(fd: int, buf: Bytes, n: int): int { return sysLxWrite(fd, buf, n); }
export function lxClose(fd: int): int { return sysLxClose(fd); }
export function lxUnlinkat(dir: int, path: string, flags: int): int { return sysLxUnlinkat(dir, path, flags); }
export function lxRenameat(olddir: int, oldpath: string, newdir: int, newpath: string): int { return sysLxRenameat(olddir, oldpath, newdir, newpath); }
