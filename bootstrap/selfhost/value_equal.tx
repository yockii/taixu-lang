// Recursive value equality, descriptors contain only immutable layout facts.
import { StructuredBuffer, asStructuredMissing } from "./assemble";
import { nr, nd, nb, nx, ni, nm, nmd, nmb, nt, nmov, nl, nj, nc, nret, no } from "./native_emit";
export function valueEqualEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_ve";
    nl(b, "__tx_native_equal_v1"); nt(b, "cmp", nd(8), ni(1024)); nj(b, "ja", p + "_depth");
    nt(b, "movzx", nd(10), nmb(1, 0)); nt(b, "movzx", nd(11), nmb(2, 0)); nt(b, "cmp", nd(10), nd(11)); nj(b, "jne", p + "_false");
    nt(b, "cmp", nd(10), ni(4)); nj(b, "je", p + "_true");
    nt(b, "cmp", nd(10), ni(1)); nj(b, "je", p + "_int");
    nt(b, "cmp", nd(10), ni(2)); nj(b, "je", p + "_float");
    nt(b, "cmp", nd(10), ni(3)); nj(b, "je", p + "_bool");
    nt(b, "cmp", nd(10), ni(9)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(11)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(12)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(13)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(14)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(15)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(16)); nj(b, "je", p + "_identity");
    nt(b, "cmp", nd(10), ni(17)); nj(b, "je", p + "_identity"); // Bytes（D3 v0.18：句柄同一性）
    nt(b, "cmp", nd(10), ni(5)); nj(b, "je", p + "_container");
    nt(b, "cmp", nd(10), ni(6)); nj(b, "je", p + "_container");
    nt(b, "cmp", nd(10), ni(7)); nj(b, "je", p + "_container");
    nt(b, "cmp", nd(10), ni(8)); nj(b, "je", p + "_container");
    nt(b, "cmp", nd(10), ni(10)); nj(b, "je", p + "_container");
    nj(b, "jmp", p + "_false");
    nl(b, p + "_int"); nmov(b, nr(10), nm(1, 8)); nt(b, "cmp", nr(10), nm(2, 8)); nj(b, "je", p + "_true"); nj(b, "jmp", p + "_false");
    nl(b, p + "_identity"); nmov(b, nd(10), nmd(1, 8)); nt(b, "cmp", nd(10), nmd(2, 8)); nj(b, "je", p + "_true"); nj(b, "jmp", p + "_false");
    nl(b, p + "_float"); nt(b, "movsd", nx(0), nm(1, 8)); nt(b, "movsd", nx(1), nm(2, 8)); nt(b, "ucomisd", nx(0), nx(1)); nj(b, "jp", p + "_false"); nj(b, "je", p + "_true"); nj(b, "jmp", p + "_false");
    nl(b, p + "_bool"); nmov(b, nr(10), nm(1, 8)); nmov(b, nr(11), nm(2, 8)); nt(b, "test", nr(10), nr(10)); nj(b, "jz", p + "_bool_zero"); nt(b, "test", nr(11), nr(11)); nj(b, "jne", p + "_true"); nj(b, "jmp", p + "_false");
    nl(b, p + "_bool_zero"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_true"); nj(b, "jmp", p + "_false");

    nl(b, p + "_container"); nt(b, "sub", nr(4), ni(152)); nmov(b, nmd(4, 64), nd(8));
    nmov(b, nr(10), nm(1, 0)); nmov(b, nr(11), nm(1, 8)); nmov(b, nm(4, 32), nr(10)); nmov(b, nm(4, 40), nr(11));
    nmov(b, nr(10), nm(2, 0)); nmov(b, nr(11), nm(2, 8)); nmov(b, nm(4, 48), nr(10)); nmov(b, nm(4, 56), nr(11));
    nt(b, "lea", nr(1), nm(4, 32)); nt(b, "lea", nr(2), nm(4, 72)); nc(b, "__tx_store_equal_view_v1");
    nt(b, "lea", nr(1), nm(4, 48)); nt(b, "lea", nr(2), nm(4, 104)); nc(b, "__tx_store_equal_view_v1");
    nmov(b, nd(10), nmd(4, 72)); nt(b, "test", nd(10), nd(10)); nj(b, "jz", p + "_not_equal"); nt(b, "cmp", nd(10), nmd(4, 104)); nj(b, "jne", p + "_not_equal");
    nmov(b, nr(10), nm(4, 80)); nt(b, "cmp", nr(10), nm(4, 112)); nj(b, "jne", p + "_not_equal");
    nmov(b, nd(10), nmd(4, 76)); nt(b, "cmp", nd(10), nmd(4, 108)); nj(b, "jne", p + "_not_equal");
    nmov(b, nr(10), nm(4, 96)); nt(b, "cmp", nr(10), nm(4, 128)); nj(b, "jne", p + "_not_equal");
    nt(b, "cmp", nmd(4, 72), ni(1)); nj(b, "je", p + "_bytes");
    nmov(b, nm(4, 136), ni(0));
    nl(b, p + "_loop"); nmov(b, nr(0), nm(4, 136)); nt(b, "cmp", nr(0), nm(4, 96)); nj(b, "jae", p + "_equal");
    nt(b, "shl", nr(0), ni(4)); nmov(b, nr(1), nm(4, 88)); nt(b, "add", nr(1), nr(0)); nmov(b, nr(2), nm(4, 120)); nt(b, "add", nr(2), nr(0));
    nmov(b, nd(8), nmd(4, 64)); nt(b, "add", nd(8), ni(1)); nc(b, "__tx_native_equal_v1"); nt(b, "cmp", nd(0), ni(1)); nj(b, "jne", p + "_return");
    nmov(b, nr(0), nm(4, 136)); nt(b, "add", nr(0), ni(1)); nmov(b, nm(4, 136), nr(0)); nj(b, "jmp", p + "_loop");
    nl(b, p + "_bytes"); nmov(b, nr(1), nm(4, 88)); nmov(b, nr(2), nm(4, 120)); nmov(b, nr(8), nm(4, 96));
    nl(b, p + "_byte_loop"); nt(b, "test", nr(8), nr(8)); nj(b, "jz", p + "_equal"); nt(b, "movzx", nd(10), nmb(1, 0)); nt(b, "movzx", nd(11), nmb(2, 0)); nt(b, "cmp", nd(10), nd(11)); nj(b, "jne", p + "_not_equal"); nt(b, "add", nr(1), ni(1)); nt(b, "add", nr(2), ni(1)); nt(b, "sub", nr(8), ni(1)); nj(b, "jmp", p + "_byte_loop");
    nl(b, p + "_not_equal"); nmov(b, nr(0), ni(0)); nj(b, "jmp", p + "_return"); nl(b, p + "_equal"); nmov(b, nr(0), ni(1));
    nl(b, p + "_return"); nt(b, "add", nr(4), ni(152)); nret(b);
    nl(b, p + "_false"); nmov(b, nr(0), ni(0)); nret(b); nl(b, p + "_true"); nmov(b, nr(0), ni(1)); nret(b); nl(b, p + "_depth"); nmov(b, nr(0), ni(2)); nret(b);
}
