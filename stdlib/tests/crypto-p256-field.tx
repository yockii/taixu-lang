import { p256Hex, p256Prime, p256Order, p256Small, p256Decode, p256Encode, p256Add, p256Sub, p256Mul, p256Inverse, p256Zero, p256Select, p256Swap } from "std/crypto/p256_field";
import { constantTimeEqual } from "std/crypto/subtle";

test "P-256 域：独立大整数、进借位及幂逆" {
    const fixture = readFile("tests/vectors/crypto-p256-field.txt") catch panic("field fixture");
    const prime = p256Prime(); const order = p256Order(); let fields = 0; let inverses = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); let f = prime;
        if (listGet(p, 1) == "n") { f = order; } else { assert(listGet(p, 1) == "p", "modulus kind"); }
        const a = p256Decode(f, p256Hex(listGet(p, 2)));
        if (listGet(p, 0) == "inverse") {
            assert(constantTimeEqual(p256Encode(f, p256Inverse(f, a)), p256Hex(listGet(p, 3))), "inverse " + toStr(inverses)); inverses = inverses + 1;
        } else {
            assert(listGet(p, 0) == "field", "operation kind"); const b = p256Decode(f, p256Hex(listGet(p, 3)));
            assert(constantTimeEqual(p256Encode(f, p256Add(f, a, b)), p256Hex(listGet(p, 4))), "add " + toStr(fields));
            assert(constantTimeEqual(p256Encode(f, p256Sub(f, a, b)), p256Hex(listGet(p, 5))), "sub " + toStr(fields));
            assert(constantTimeEqual(p256Encode(f, p256Mul(f, a, b)), p256Hex(listGet(p, 6))), "mul " + toStr(fields)); fields = fields + 1;
        }
    }
    assert(fields == 256 && inverses == 8, "complete vectors");
}

test "P-256 域：选择、交换、零判定与输入不变" {
    const f = p256Prime(); const one = p256Small(f, 1); const zero = p256Small(f, 0);
    const encoded = p256Encode(f, one);
    assert(p256Zero(one) == 0 && p256Zero(zero) == 1, "zero predicate");
    assert(constantTimeEqual(p256Encode(f, p256Select(1, one, zero)), encoded), "select true");
    assert(p256Zero(p256Select(0, one, zero)) == 1, "select false");
    assert(constantTimeEqual(p256Encode(f, one), encoded) && p256Zero(zero) == 1, "inputs unchanged");
    p256Swap(one, zero, 0); assert(p256Zero(one) == 0 && p256Zero(zero) == 1, "no swap");
    p256Swap(one, zero, 1); assert(p256Zero(one) == 1 && constantTimeEqual(p256Encode(f, zero), encoded), "swap");
}
