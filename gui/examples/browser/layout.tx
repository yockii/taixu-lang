// Small block/inline page layout. Geometry is in page DIP; no window/font handles.
import { HtmlDocument } from "./html";
import { CssStyle } from "./css";
import { parseInt } from "std/strconv";

export struct PageCommand { kind: int, node: int, x: int, y: int, width: int, height: int, text: string, size: int, color: int, background: int, bold: bool, italic: bool, underline: bool, href: string, linkNode: int }
export struct PageLayout { commands: List<Ref<PageCommand>>, anchors: Map<string, int>, width: int, height: int }
export struct PageLink { href: string, node: int }
struct Flow { page: Ref<PageLayout>, left: int, right: int, x: int, y: int, lineHeight: int, line: List<int>, pendingSpace: bool, align: string, href: string, linkNode: int, background: int, work: int, measure: (string, int) => int }
struct Frame { node: int, exit: bool, block: bool, left: int, right: int, align: string, href: string, linkNode: int, background: int, box: int, padding: int, bottom: int }

function next(text: string, at: int): int {
    const c = byteAt(text, at); if (c < 128) { return at + 1; } if (c < 224) { return at + 2; } if (c < 240) { return at + 3; } return at + 4;
}
function space(c: int): bool { return c == 9 || c == 10 || c == 12 || c == 13 || c == 32; }
function measured(flow: Ref<Flow>, text: string, size: int): int | Error {
    if (len(text) > 8388608 - flow.work) { return err("browser layout: measurement work limit"); } flow.work = flow.work + len(text);
    const width = flow.measure(text, size);
    if (width < 0 || width > 1000000) { return err("browser layout: invalid font measurement"); } return width;
}
function push(flow: Ref<Flow>, command: Ref<PageCommand>): int | Error {
    if (listLen(flow.page.commands) >= 100000) { return err("browser layout: command count limit"); }
    const index = listLen(flow.page.commands); listPush(flow.page.commands, command); return index;
}
function command(node: int, x: int, y: int, width: int, height: int, color: int): Ref<PageCommand> {
    return new PageCommand { kind: 0, node: node, x: x, y: y, width: width, height: height, text: "", size: 0, color: color, background: -1, bold: false, italic: false, underline: false, href: "", linkNode: -1 };
}
function bounds(flow: Ref<Flow>): void | Error {
    if (flow.y < -10000 || flow.y > 10000000 || flow.left < -100000 || flow.right > 100000 || flow.right <= flow.left) { return err("browser layout: page geometry limit"); } return done();
}
function flush(flow: Ref<Flow>, force: bool, size: int): void | Error {
    let height = flow.lineHeight; if (height == 0 && force) { height = size * 5 / 4; }
    let extra = flow.right - flow.x; if (extra < 0) { extra = 0; } let shift = 0;
    if (flow.align == "center") { shift = extra / 2; } else if (flow.align == "right") { shift = extra; }
    for (index in flow.line) {
        const c = listGet(flow.page.commands, index); c.x = c.x + shift; c.y = c.y + height - c.height;
    }
    flow.y = flow.y + height; flow.x = flow.left; flow.lineHeight = 0; flow.pendingSpace = false;
    while (listLen(flow.line) > 0) { listPop(flow.line); } return bounds(flow);
}
function emit(flow: Ref<Flow>, text: string, width: int, style: CssStyle, node: int): void | Error {
    if (len(text) == 0) { return done(); }
    const c = command(node, flow.x, flow.y, width, style.fontSize * 5 / 4, style.color);
    c.kind = 1; c.text = text; c.size = style.fontSize; c.bold = style.bold; c.italic = style.italic; c.underline = style.underline;
    c.href = flow.href; c.linkNode = flow.linkNode; c.background = flow.background;
    const index = push(flow, c)?; listPush(flow.line, index); flow.x = flow.x + width;
    if (c.height > flow.lineHeight) { flow.lineHeight = c.height; } return done();
}
// Select a UTF-8 boundary with bounded binary searches, rather than cutting bytes.
function fitting(flow: Ref<Flow>, text: string, size: int, available: int): int | Error {
    if (len(text) > 8388608 - flow.work) { return err("browser layout: word scan limit"); } flow.work = flow.work + len(text);
    const offsets: List<int> = listNew(); listPush(offsets, 0); let at = 0;
    while (at < len(text)) { at = next(text, at); listPush(offsets, at); }
    let low = 0; let high = listLen(offsets) - 1;
    while (low < high) {
        const middle = (low + high + 1) / 2; const width = measured(flow, strSlice(text, 0, listGet(offsets, middle)), size)?;
        if (width <= available) { low = middle; } else { high = middle - 1; }
    }
    if (low == 0) { return listGet(offsets, 1); } return listGet(offsets, low);
}
function word(flow: Ref<Flow>, text: string, style: CssStyle, node: int): void | Error {
    const width = measured(flow, text, style.fontSize)?; let gap = 0;
    if (flow.pendingSpace && listLen(flow.line) > 0) { gap = measured(flow, " ", style.fontSize)?; } flow.pendingSpace = false;
    if (listLen(flow.line) > 0 && width + gap > flow.right - flow.x) { flush(flow, false, style.fontSize)?; gap = 0; }
    flow.x = flow.x + gap;
    if (width <= flow.right - flow.x) { return emit(flow, text, width, style, node); }
    let at = 0;
    while (at < len(text)) {
        const remaining = strSlice(text, at, len(text)); const count = fitting(flow, remaining, style.fontSize, flow.right - flow.x)?;
        const part = strSlice(remaining, 0, count); emit(flow, part, measured(flow, part, style.fontSize)?, style, node)?; at = at + count;
        if (at < len(text)) { flush(flow, false, style.fontSize)?; }
    } return done();
}
function text(flow: Ref<Flow>, value: string, style: CssStyle, node: int): void | Error {
    let at = 0;
    while (at < len(value)) {
        const c = byteAt(value, at);
        if (style.pre) {
            if (c == 10 || c == 13) { flush(flow, true, style.fontSize)?; at = at + 1; if (c == 13 && at < len(value) && byteAt(value, at) == 10) { at = at + 1; } }
            else if (c == 9) { emit(flow, "    ", measured(flow, "    ", style.fontSize)?, style, node)?; at = at + 1; }
            else {
                const start = at; while (at < len(value) && byteAt(value, at) != 10 && byteAt(value, at) != 13 && byteAt(value, at) != 9) { at = next(value, at); }
                const part = strSlice(value, start, at); emit(flow, part, measured(flow, part, style.fontSize)?, style, node)?;
            }
        } else if (space(c)) { flow.pendingSpace = true; at = at + 1; }
        else {
            const start = at;
            if (c >= 128) { at = next(value, at); }
            else { while (at < len(value) && byteAt(value, at) < 128 && !space(byteAt(value, at)) && at - start < 4096) { at = at + 1; } }
            word(flow, strSlice(value, start, at), style, node)?;
        }
    } return done();
}
function frame(flow: Ref<Flow>, node: int, exit: bool): Ref<Frame> {
    return new Frame { node: node, exit: exit, block: false, left: flow.left, right: flow.right, align: flow.align, href: flow.href, linkNode: flow.linkNode, background: flow.background, box: -1, padding: 0, bottom: 0 };
}
function marker(document: Ref<HtmlDocument>, node: int, counts: Map<int, int>): string {
    const item = listGet(document.nodes, node); const parent = item.parent;
    if (parent < 0 || parent >= listLen(document.nodes)) { return "• "; } const list = listGet(document.nodes, parent);
    if (list.tag != "ol") { return "• "; }
    let count = mapGet(counts, parent) ?? (parseInt(mapGet(list.attributes, "start") ?? "1") catch 1);
    const value = mapGet(item.attributes, "value"); if (value != None) { count = parseInt(value) catch count; }
    if (count < -100000 || count > 100000) { count = 1; } mapSet(counts, parent, count + 1); return toStr(count) + ". ";
}

export function pageLayout(document: Ref<HtmlDocument>, styles: List<CssStyle>, width: int, measure: (string, int) => int): Ref<PageLayout> | Error {
    const count = listLen(document.nodes);
    if (width < 16 || width > 32768 || count < 1 || count > 50000 || listLen(styles) != count) { return err("browser layout: invalid viewport or document"); }
    const page = new PageLayout { commands: listNew(), anchors: mapNew(), width: width, height: 0 };
    const flow = new Flow { page: page, left: 0, right: width, x: 0, y: 0, lineHeight: 0, line: listNew(), pendingSpace: false, align: "left", href: "", linkNode: -1, background: -1, work: 0, measure: measure };
    const stack: List<Ref<Frame>> = listNew(); listPush(stack, frame(flow, 0, false)); const seen: Map<int, bool> = mapNew(); const counts: Map<int, int> = mapNew();
    while (listLen(stack) > 0) {
        const step = listPop(stack); const node = listGet(document.nodes, step.node); const style = listGet(styles, step.node);
        if (step.exit) {
            if (step.block) {
                flush(flow, false, style.fontSize)?; flow.y = flow.y + step.padding;
                if (step.box >= 0) { const box = listGet(page.commands, step.box); box.height = flow.y - box.y; if (box.height < 0) { box.height = 0; } }
                flow.y = flow.y + step.bottom; flow.left = step.left; flow.right = step.right; flow.x = flow.left; flow.align = step.align; bounds(flow)?;
            }
            flow.href = step.href; flow.linkNode = step.linkNode; flow.background = step.background; continue;
        }
        if (mapHas(seen, step.node)) { return err("browser layout: repeated or cyclic node"); } mapSet(seen, step.node, true);
        if (style.fontSize < 1 || style.fontSize > 256 || style.padding < 0 || style.padding > 10000 || style.width < -1 || style.width > 32768
            || style.marginLeft < -10000 || style.marginLeft > 10000 || style.marginRight < -10000 || style.marginRight > 10000
            || style.marginTop < -10000 || style.marginTop > 10000 || style.marginBottom < -10000 || style.marginBottom > 10000) { return err("browser layout: invalid style geometry"); }
        if (style.display == "none") { continue; }
        const saved = frame(flow, step.node, true); saved.block = style.display == "block";
        if (saved.block) {
            flush(flow, false, style.fontSize)?; flow.y = flow.y + style.marginTop;
            const left = flow.left + style.marginLeft; let available = flow.right - style.marginRight - left;
            if (available < 1) { available = 1; } let content = available - style.padding * 2; if (content < 1) { content = 1; }
            if (style.width >= 0 && style.width < content) { content = style.width; if (content < 1) { content = 1; } }
            if (style.background >= 0) { saved.box = push(flow, command(step.node, left, flow.y, content + style.padding * 2, 0, style.background))?; }
            flow.left = left + style.padding; flow.right = flow.left + content; flow.x = flow.left; flow.y = flow.y + style.padding; flow.align = style.align;
            flow.background = -1; saved.padding = style.padding; saved.bottom = style.marginBottom; bounds(flow)?;
        } else if (style.background >= 0) { flow.background = style.background; }
        if (node.tag == "a" && mapHas(node.attributes, "href")) { flow.href = mapGet(node.attributes, "href") ?? ""; flow.linkNode = step.node; }
        const id = mapGet(node.attributes, "id"); if (id != None && !mapHas(page.anchors, id)) { mapSet(page.anchors, id, flow.y); }
        const name = mapGet(node.attributes, "name"); if (node.tag == "a" && name != None && !mapHas(page.anchors, name)) { mapSet(page.anchors, name, flow.y); }
        listPush(stack, saved);
        if (node.tag == "#text") { text(flow, node.text, style, step.node)?; }
        else if (node.tag == "br") { flush(flow, true, style.fontSize)?; }
        else if (node.tag == "img") { text(flow, mapGet(node.attributes, "alt") ?? "[image]", style, step.node)?; }
        else if (node.tag == "hr") { flush(flow, false, style.fontSize)?; push(flow, command(step.node, flow.left, flow.y + 3, flow.right - flow.left, 1, style.color))?; flow.y = flow.y + 8; }
        else if (node.tag == "li") { text(flow, marker(document, step.node, counts), style, step.node)?; }
        if (listLen(node.children) > count) { return err("browser layout: child count limit"); }
        let i = listLen(node.children) - 1;
        while (i >= 0) {
            const child = listGet(node.children, i);
            if (child < 0 || child >= count || listGet(document.nodes, child).parent != step.node) { return err("browser layout: invalid child index"); }
            if (listLen(stack) >= 100000) { return err("browser layout: traversal stack limit"); }
            listPush(stack, frame(flow, child, false)); i = i - 1;
        }
    }
    flush(flow, false, 16)?; page.height = flow.y; if (page.height < 1) { page.height = 1; } return page;
}

export function pageLinkAt(page: Ref<PageLayout>, x: int, y: int): PageLink? {
    let i = listLen(page.commands) - 1;
    while (i >= 0) {
        const c = listGet(page.commands, i);
        if (c.kind == 1 && c.linkNode >= 0 && x >= c.x && y >= c.y && x - c.x < c.width && y - c.y < c.height) { return PageLink { href: c.href, node: c.linkNode }; } i = i - 1;
    } return None;
}
function done(): void {}
