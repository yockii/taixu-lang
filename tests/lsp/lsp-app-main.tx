// lsp-app-main.tx —— LSP 二期多模块 fixture·入口模块（TOOL-47）。
// 伴本 scripts/lsp-e2e.py 消费：以本模块为根的模块图覆盖依赖模块 lsp-geom.tx。
import { Rect, area, UNIT } from "./lsp-geom";

export function main(args: []string): int {
    const r: Ref<Rect> = new Rect { w: 3, h: UNIT + 3 };
    const s = area(r);
    const parts = strSplit(toStr(s), "|");
    print(listLen(parts));
    return 0;
}
