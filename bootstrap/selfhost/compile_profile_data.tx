// Shared facts for compiler profiling. No CLI, rendering or driver dependency.
import { ProgramContext } from "./program_context";

export struct CompileProfileFn {
    id: int, module: string, name: string,
    inputIr: int, copiedIr: int, fnNodes: int, constNodes: int, lineNodes: int,
    recordIr: int, recordParts: int, recordBytes: int, recordNs: int,
    instructions: int, operands: int, immediates: int, zeroImmediates: int, memories: int,
    analysisCells: int, analysisSkipped: bool,
}
export struct CompileProfilePhase { name: string, ns: int }
export struct CompileProfileTotals {
    inputIr: int, copiedIr: int, fnNodes: int, constNodes: int, lineNodes: int,
    instructions: int, operands: int, immediates: int, zeroImmediates: int, memories: int,
    recordParts: int, recordBytes: int, analysisSkipped: int, analysisMaxCells: int,
}
export struct CompileProfileData {
    start: int, mark: int, totalNs: int,
    recordParts: int, recordBytes: int, seb1Bytes: int, fab1Bytes: int,
    phases: List<Ref<CompileProfilePhase>>,
    details: List<Ref<CompileProfilePhase>>,
    codegenDetails: List<Ref<CompileProfilePhase>>,
    functions: List<Ref<CompileProfileFn>>,
}
function emptyData(): Ref<CompileProfileData> {
    return new CompileProfileData { start: 0, mark: 0, totalNs: 0,
        recordParts: 0, recordBytes: 0, seb1Bytes: 0, fab1Bytes: 0, phases: listNew(), details: listNew(),
        codegenDetails: listNew(), functions: listNew() };
}
function newFn(id: int, module: string, name: string, ir: int): Ref<CompileProfileFn> {
    return new CompileProfileFn { id: id, module: module, name: name,
        inputIr: ir, copiedIr: 0, fnNodes: 0, constNodes: 0, lineNodes: 0,
        recordIr: 0, recordParts: 0, recordBytes: 0, recordNs: 0,
        instructions: 0, operands: 0, immediates: 0, zeroImmediates: 0, memories: 0,
        analysisCells: 0, analysisSkipped: false };
}
let active: bool = false;
let data: Ref<CompileProfileData> = emptyData();
function noClock(): int { return 0; }
let clock: () => int = noClock;
const invalidFn: Ref<CompileProfileFn> = newFn(-1, "", "", 0);
export function compileProfileActive(): bool { return active; }
export function compileProfileData(): Ref<CompileProfileData> { return data; }
export function compileProfileClock(): int { return clock(); }
export function compileProfileBegin(source: () => int): void {
    data = emptyData();
    clock = source;
    data.start = clock(); data.mark = data.start; active = true;
}
export function compileProfileEnd(): void {
    data.totalNs = clock() - data.start; active = false;
}
export function compileProfileClear(): void { active = false; clock = noClock; data = emptyData(); }
export function compileProfilePhase(name: string): void {
    const now = clock();
    listPush(data.phases, new CompileProfilePhase { name: name, ns: now - data.mark });
    data.mark = now;
}
export function compileProfileDetail(name: string, ns: int): void {
    listPush(data.details, new CompileProfilePhase { name: name, ns: ns });
}
// codegen 阶段的子项（SEB1／FAB1 文本中转的解析与生成）：包含在 codegen 阶段内。
export function compileProfileCodegenDetail(name: string, ns: int): void {
    listPush(data.codegenDetails, new CompileProfilePhase { name: name, ns: ns });
}
// 语义分析交给代码生成的两段文本（SEB1、FAB1）的 UTF-8 字节数。
export function compileProfileTextHop(seb1: int, fab1: int): void { data.seb1Bytes = seb1; data.fab1Bytes = fab1; }
function ints(): List<int> { return listNew(); }
function strAt(xs: List<string>, i: int): string { return listGet(xs, i) catch ""; }
export function compileProfileProgram(ctx: Ref<ProgramContext>): void {
    let i = 0;
    while (i < listLen(ctx.fnCode)) {
        const moduleId = listGet(ctx.fnModule, i) catch -1;
        const moduleName = strAt(ctx.cgStrings, listGet(ctx.modOutPath, moduleId) catch -1);
        const name = strAt(ctx.cgStrings, listGet(ctx.fnNameIdx, i) catch -1);
        listPush(data.functions, newFn(i, moduleName, name, listLen(listGet(ctx.fnCode, i) catch ints())));
        i = i + 1;
    }
}
function fnAt(i: int): Ref<CompileProfileFn> {
    const f = listGet(data.functions, i) catch invalidFn;
    assert(f.id == i && i >= 0, "compile profile function index invariant");
    return f;
}
// Called after the actual contextOwnedProgram constructor/copy loops.
export function compileProfileBridge(i: int, ir: int, constants: int, lines: int): void {
    const f = fnAt(i);
    f.copiedIr = ir; f.fnNodes = 1; f.constNodes = constants; f.lineNodes = lines;
}
// Each retained string piece gains exactly one LF in recJoinRange.
export function compileProfileRecord(i: int, parts: List<string>, first: int, ir: int, ns: int): void {
    const f = fnAt(i); f.recordParts = listLen(parts) - first;
    f.recordIr = ir; f.recordNs = ns;
    let p = first; let size = 0;
    while (p < listLen(parts)) { size = size + len(strAt(parts, p)) + 1; p = p + 1; }
    f.recordBytes = size;
}
export function compileProfileRecordTotal(parts: int, size: int): void {
    data.recordParts = parts; data.recordBytes = size;
}
// 分析规模（指令数×寄存器数，即逐 pc 稠密表的项数）与是否因超过分析预算而整段跳过分析。
export function compileProfileAnalysis(i: int, cells: int, skipped: bool): void {
    const f = fnAt(i); f.analysisCells = cells; f.analysisSkipped = skipped;
}
// Observed native instruction/operand uses, never runtime call frequencies.
export function compileProfileInstruction(i: int, nops: int, imm: int, zeros: int, mem: int): void {
    const f = fnAt(i);
    f.instructions = f.instructions + 1; f.operands = f.operands + nops;
    f.immediates = f.immediates + imm; f.zeroImmediates = f.zeroImmediates + zeros;
    f.memories = f.memories + mem;
}

function metric(f: Ref<CompileProfileFn>, sort: int): int {
    if (sort == 1) { return f.instructions; }
    if (sort == 2) { return f.recordNs; }
    return f.recordParts;
}
function precedes(a: Ref<CompileProfileFn>, b: Ref<CompileProfileFn>, sort: int): bool {
    const av = metric(a, sort); const bv = metric(b, sort);
    return av > bv || (av == bv && a.id < b.id);
}
function mergeRows(xs: List<Ref<CompileProfileFn>>, lo: int, hi: int, sort: int): List<Ref<CompileProfileFn>> {
    const out: List<Ref<CompileProfileFn>> = listNew();
    if (hi - lo <= 1) { if (hi > lo) { listPush(out, listGet(xs, lo) catch invalidFn); } return out; }
    const mid = lo + (hi - lo) / 2;
    const a = mergeRows(xs, lo, mid, sort); const b = mergeRows(xs, mid, hi, sort);
    let i = 0; let j = 0;
    while (i < listLen(a) || j < listLen(b)) {
        if (j >= listLen(b)) { listPush(out, listGet(a, i) catch invalidFn); i = i + 1; }
        else if (i >= listLen(a)) { listPush(out, listGet(b, j) catch invalidFn); j = j + 1; }
        else if (precedes(listGet(a, i) catch invalidFn, listGet(b, j) catch invalidFn, sort)) {
            listPush(out, listGet(a, i) catch invalidFn); i = i + 1;
        } else { listPush(out, listGet(b, j) catch invalidFn); j = j + 1; }
    }
    return out;
}
export function compileProfileSortRows(rows: List<Ref<CompileProfileFn>>, sort: int): List<Ref<CompileProfileFn>> {
    return mergeRows(rows, 0, listLen(rows), sort);
}
export function compileProfileTotals(d: Ref<CompileProfileData>): Ref<CompileProfileTotals> {
    const t = new CompileProfileTotals { inputIr: 0, copiedIr: 0, fnNodes: 0, constNodes: 0, lineNodes: 0,
        instructions: 0, operands: 0, immediates: 0, zeroImmediates: 0, memories: 0, recordParts: 0, recordBytes: 0,
        analysisSkipped: 0, analysisMaxCells: 0 };
    for (f in d.functions) {
        t.inputIr = t.inputIr + f.inputIr; t.copiedIr = t.copiedIr + f.copiedIr; t.fnNodes = t.fnNodes + f.fnNodes;
        t.constNodes = t.constNodes + f.constNodes; t.lineNodes = t.lineNodes + f.lineNodes;
        t.instructions = t.instructions + f.instructions; t.operands = t.operands + f.operands;
        t.immediates = t.immediates + f.immediates; t.zeroImmediates = t.zeroImmediates + f.zeroImmediates;
        t.memories = t.memories + f.memories; t.recordParts = t.recordParts + f.recordParts; t.recordBytes = t.recordBytes + f.recordBytes;
        if (f.analysisSkipped) { t.analysisSkipped = t.analysisSkipped + 1; }
        if (f.analysisCells > t.analysisMaxCells) { t.analysisMaxCells = f.analysisCells; }
    }
    return t;
}
