// —— 断言助手 ——

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    return -1;
}

function hx(s: string): List<int> {
    const t: List<int> = listNew();
    const n: int = len(s);
    let i: int = 0;
    while (i + 1 < n) {
        const hi: int = hexVal(byteAt(s, i) catch -1);
        const lo: int = hexVal(byteAt(s, i + 1) catch -1);
        if (hi < 0 || lo < 0) {
            panic("向量十六进制非法");
        }
        listPush(t, hi * 16 + lo);
        i = i + 2;
    }
    return t;
}

function listsEq(a: List<int>, b: List<int>): bool {
    if (listLen(a) != listLen(b)) {
        return false;
    }
    let i: int = 0;
    while (i < listLen(a)) {
        if ((listGet(a, i) catch -1) != (listGet(b, i) catch -2)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 错误哨兵（-1 非合法字节——expectErr 的命中标记）。
function errMark(): List<int> {
    const t: List<int> = listNew();
    listPush(t, -1);
    return t;
}

function fnv64(data: List<int>): int {
    // 0xCBF29CE484222325 的二补码形态（>i64.max——imul 64 位环绕下等价）。
    let h: int = -3750763034362895579;
    for (b in data) {
        h = imul(h ^ b, 1099511628211);
    }
    return h;
}

function expectInflate(streamHex: string, wantHex: string, label: string): void {
    const got: List<int> = inflate(hx(streamHex)) catch panic(label + "：解压失败");
    assert(listsEq(got, hx(wantHex)), label);
}

function expectZlib(streamHex: string, wantHex: string, label: string): void {
    const got: List<int> = zlibDecompress(hx(streamHex)) catch panic(label + "：解压失败");
    assert(listsEq(got, hx(wantHex)), label);
}

function expectGzip(streamHex: string, wantHex: string, label: string): void {
    const got: List<int> = gzipDecompress(hx(streamHex)) catch panic(label + "：解压失败");
    assert(listsEq(got, hx(wantHex)), label);
}

function expectErrRaw(streamHex: string, label: string): void {
    const out: List<int> = inflate(hx(streamHex)) catch errMark();
    assert((listGet(out, 0) catch 0) == -1, label);
}

function expectErrZlib(streamHex: string, label: string): void {
    const out: List<int> = zlibDecompress(hx(streamHex)) catch errMark();
    assert((listGet(out, 0) catch 0) == -1, label);
}

function expectErrGzip(streamHex: string, label: string): void {
    const out: List<int> = gzipDecompress(hx(streamHex)) catch errMark();
    assert((listGet(out, 0) catch 0) == -1, label);
}

// —— inflate：raw deflate 向量（l1/l6/l9；stored/fixed/dynamic 覆盖）——

test "compress：inflate raw 向量逐位（l1/l6/l9 × 5 载荷）" {
    expectInflate(RAW_L1_P_EMPTY, V_P_EMPTY, "raw p_empty");
    expectInflate(RAW_L1_P_SHORT, V_P_SHORT, "raw p_short");
    expectInflate(RAW_L1_P_REP, V_P_REP, "raw p_rep");
    expectInflate(RAW_L1_P_FIPS, V_P_FIPS, "raw p_fips");
    expectInflate(RAW_L1_P_DYN, V_P_DYN, "raw p_dyn");
    expectInflate(RAW_L6_P_EMPTY, V_P_EMPTY, "raw p_empty");
    expectInflate(RAW_L6_P_SHORT, V_P_SHORT, "raw p_short");
    expectInflate(RAW_L6_P_REP, V_P_REP, "raw p_rep");
    expectInflate(RAW_L6_P_FIPS, V_P_FIPS, "raw p_fips");
    expectInflate(RAW_L6_P_DYN, V_P_DYN, "raw p_dyn");
    expectInflate(RAW_L9_P_EMPTY, V_P_EMPTY, "raw p_empty");
    expectInflate(RAW_L9_P_SHORT, V_P_SHORT, "raw p_short");
    expectInflate(RAW_L9_P_REP, V_P_REP, "raw p_rep");
    expectInflate(RAW_L9_P_FIPS, V_P_FIPS, "raw p_fips");
    expectInflate(RAW_L9_P_DYN, V_P_DYN, "raw p_dyn");
}

// —— zlib 包装（RFC 1950：头校验＋adler32 尾）——

test "compress：zlibDecompress 向量（l1/l6/l9＋stored；adler32 校验）" {
    expectZlib(ZLIB_L1_P_EMPTY, V_P_EMPTY, "zlib p_empty");
    expectZlib(ZLIB_L6_P_EMPTY, V_P_EMPTY, "zlib p_empty");
    expectZlib(ZLIB_L9_P_EMPTY, V_P_EMPTY, "zlib p_empty");
    expectZlib(ZLIB_L1_P_SHORT, V_P_SHORT, "zlib p_short");
    expectZlib(ZLIB_L6_P_SHORT, V_P_SHORT, "zlib p_short");
    expectZlib(ZLIB_L9_P_SHORT, V_P_SHORT, "zlib p_short");
    expectZlib(ZLIB_L1_P_REP, V_P_REP, "zlib p_rep");
    expectZlib(ZLIB_L6_P_REP, V_P_REP, "zlib p_rep");
    expectZlib(ZLIB_L9_P_REP, V_P_REP, "zlib p_rep");
    expectZlib(ZLIB_L1_P_FIPS, V_P_FIPS, "zlib p_fips");
    expectZlib(ZLIB_L6_P_FIPS, V_P_FIPS, "zlib p_fips");
    expectZlib(ZLIB_L9_P_FIPS, V_P_FIPS, "zlib p_fips");
    expectZlib(ZLIB_L1_P_DYN, V_P_DYN, "zlib p_dyn");
    expectZlib(ZLIB_L6_P_DYN, V_P_DYN, "zlib p_dyn");
    expectZlib(ZLIB_L9_P_DYN, V_P_DYN, "zlib p_dyn");
    expectZlib(W_Z0_P_SHORT, V_P_SHORT, "zlib_store0 p_short");
    expectZlib(W_Z0_P_REP, V_P_REP, "zlib_store0 p_rep");
    expectZlib(W_Z0_P_FIPS, V_P_FIPS, "zlib_store0 p_fips");
    expectZlib(W_Z0_P_DYN, V_P_DYN, "zlib_store0 p_dyn");
}

// —— gzip 包装（RFC 1952：可选域跳过＋CRC32＋ISIZE）——

test "compress：gzipDecompress 向量（Python gzip.compress mtime=0）" {
    expectGzip(GZIP_P_EMPTY, V_P_EMPTY, "gzip p_empty");
    expectGzip(GZIP_P_SHORT, V_P_SHORT, "gzip p_short");
    expectGzip(GZIP_P_REP, V_P_REP, "gzip p_rep");
    expectGzip(GZIP_P_FIPS, V_P_FIPS, "gzip p_fips");
    expectGzip(GZIP_P_DYN, V_P_DYN, "gzip p_dyn");
    expectGzip(W_GZ_P_SHORT, V_P_SHORT, "gzip_store p_short");
    expectGzip(W_GZ_P_REP, V_P_REP, "gzip_store p_rep");
    expectGzip(W_GZ_P_FIPS, V_P_FIPS, "gzip_store p_fips");
    expectGzip(W_GZ_P_DYN, V_P_DYN, "gzip_store p_dyn");
}

// —— 校验和锚 ——

test "compress：adler32/crc32 官方值（十进制冻结）" {
    assert(adler32(hx(V_P_EMPTY)) == 1, "adler32 p_empty");
    assert(crc32(hx(V_P_EMPTY)) == 0, "crc32 p_empty");
    assert(adler32(hx(V_P_SHORT)) == 433194080, "adler32 p_short");
    assert(crc32(hx(V_P_SHORT)) == 4267222864, "crc32 p_short");
    assert(adler32(hx(V_P_REP)) == 1825576444, "adler32 p_rep");
    assert(crc32(hx(V_P_REP)) == 3342231005, "crc32 p_rep");
    assert(adler32(hx(V_P_FIPS)) == 2155091705, "adler32 p_fips");
    assert(crc32(hx(V_P_FIPS)) == 387596127, "crc32 p_fips");
    assert(adler32(hx(V_P_DYN)) == 3811790399, "adler32 p_dyn");
    assert(crc32(hx(V_P_DYN)) == 3144124682, "crc32 p_dyn");
}

test "compress：fnv1a64 助手锚（image 像素面 golden 同法）" {
    assert(fnv64(hx(V_P_EMPTY)) == -3750763034362895579, "fnv p_empty");
    assert(fnv64(hx(V_P_SHORT)) == 6718357463004296034, "fnv p_short");
    assert(fnv64(hx(V_P_REP)) == -2230723990234968910, "fnv p_rep");
    assert(fnv64(hx(V_P_FIPS)) == -2508413712349243595, "fnv p_fips");
    assert(fnv64(hx(V_P_DYN)) == 7897188491833474325, "fnv p_dyn");
}

// —— stored 写入器 golden（单块载荷＝Python level-0 逐字节）——

test "compress：stored 写入器 golden（zlibCompressStore ＝ Python zlib level-0 逐字节）" {
    assert(listsEq(zlibCompressStore(hx(V_P_SHORT)), hx(W_Z0_P_SHORT)), "zlib_store0 p_short");
    assert(listsEq(zlibCompressStore(hx(V_P_REP)), hx(W_Z0_P_REP)), "zlib_store0 p_rep");
    assert(listsEq(zlibCompressStore(hx(V_P_FIPS)), hx(W_Z0_P_FIPS)), "zlib_store0 p_fips");
}

test "compress：gzip stored 写入器 golden（canonical 头——生成期 Python gzip.decompress 官方侧解压证明）" {
    assert(listsEq(gzipCompressStore(hx(V_P_SHORT)), hx(W_GZ_P_SHORT)), "gzip_store p_short");
    assert(listsEq(gzipCompressStore(hx(V_P_REP)), hx(W_GZ_P_REP)), "gzip_store p_rep");
    assert(listsEq(gzipCompressStore(hx(V_P_FIPS)), hx(W_GZ_P_FIPS)), "gzip_store p_fips");
}

function roundtrip(payloadHex: string, label: string): void {
    const p: List<int> = hx(payloadHex);
    assert(listsEq(inflate(deflateStore(p)) catch errMark(), p), label + " deflateStore");
    assert(listsEq(zlibDecompress(zlibCompressStore(p)) catch errMark(), p), label + " zlibCompressStore");
    assert(listsEq(gzipDecompress(gzipCompressStore(p)) catch errMark(), p), label + " gzipCompressStore");
}

test "compress：三写入器 roundtrip（五载荷全谱——含空输入与分块 stored）" {
    roundtrip(V_P_EMPTY, "p_empty");
    roundtrip(V_P_SHORT, "p_short");
    roundtrip(V_P_REP, "p_rep");
    roundtrip(V_P_FIPS, "p_fips");
    roundtrip(V_P_DYN, "p_dyn");
}

// —— 负例（结构化 Error；errMark 哨兵命中断言）——

test "compress：负例结构化拒绝（坏头/坏校验/截断/非法形态）" {
    expectErrZlib(N_ZLIB_BAD_HDR, "zlib_bad_hdr");
    expectErrZlib(N_ZLIB_BAD_ADLER, "zlib_bad_adler");
    expectErrZlib(N_ZLIB_FDICT, "zlib_fdict");
    expectErrZlib(N_ZLIB_TRUNC, "zlib_trunc");
    expectErrZlib(N_ZLIB_STORED_LENBAD, "zlib_stored_lenbad");
    expectErrGzip(N_GZIP_BAD_MAGIC, "gzip_bad_magic");
    expectErrGzip(N_GZIP_BAD_CRC, "gzip_bad_crc");
    expectErrGzip(N_GZIP_BAD_ISIZE, "gzip_bad_isize");
    expectErrGzip(N_GZIP_TRUNC, "gzip_trunc");
    expectErrRaw(N_RAW_BTYPE3, "raw_btype3");
    expectErrRaw(N_RAW_DYN_EMPTY_CLEN, "raw_dyn_empty_clen");
}
