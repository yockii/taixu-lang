        wantArgsEmit(s, args, 1, atLine, atCol, "sleepMs(int)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.tInt);
        if (!intArg(t)) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "sleepMs 需要 int 毫秒（得到 " + typeNameOf(s, t) + "）"); }
        return tFuture(s, s.tVoid);
    }
    return s.tInt;
}

function checkField(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const fbase = e.a catch s.dummyE;
    if (fbase.tag == 31) {
        const ename = fbase.s0;
        const symO = modSymGet(s.curMod, ename);
        const sym = symO catch s.dummySym;
        if (sym.kind == 4) {
            const ei = sym.ei catch s.dummyEi;
            let i: int = 0;
            const n = listLen(ei.vars);
            while (i < n) {
                const v = listGet(ei.vars, i) catch s.dVarT;
                if (v.name != e.s0) {
                    i = i + 1;
                    continue;
                }
                if (listLen(v.fnames) != 0) {
                    emitDiag(s, 3011, e.i1, e.i2, "变体 " + ename + "." + e.s0 + " 带字段，须以 " + ename + "." + e.s0 + "(…) 构造");
                }
                listPush(s.tFieldRes, mkRow(e.id, 1, ei.serial, i, 0, 0, 0));
                anaVariant(s, ei, fbase.line, fbase.col, ANA_AT_EXACT, ename, e.i1, e.i2, e.s0);
                return tEnum(s, ei);
            }
            emitDiag(s, 3019, e.i1, e.i2, "enum " + ename + " 没有变体 '" + e.s0 + "'");
            return s.tInt;
        }
    }
    const baseTy = checkExpr(s, fbase, s.dT);
    let ty = baseTy;
    let throughRef: bool = false;
    while (ty.tag == 8) {
        ty = ty.inner catch ty;
        throughRef = true;
    }
    if (ty.tag == 5 && e.s0 == "message") {
        listPush(s.tFieldRes, mkRow(e.id, 2, 0, 0, 0, 0, 0));
        anaTint(s, e.i1, e.i2, ANA_TT_PROP, e.s0);
        return s.tString;
    }
    if (ty.tag == 13) {
        const info = ty.si catch s.dummySi;
        let i: int = 0;
        const n = listLen(info.fnames);
        while (i < n) {
            if ((listGet(info.fnames, i) catch "") == e.s0) {
                listPush(s.tFieldRes, mkRow(e.id, 0, info.serial, i, b2i(throughRef), 0, 0));
                if (anaOn) { anaUse(s, e.i1, e.i2, ANA_AT_EXACT, e.s0, anaStKey(info, ANA_AT_FIELD, ANA_TT_PROP)); }
                return listGet(info.ftys, i) catch s.dT;
            }
            i = i + 1;
        }
        emitDiag(s, 3015, e.i1, e.i2, "struct " + info.name + " 没有字段 '" + e.s0 + "'");
        return s.tInt;
    }
    // D3 v0.19：错误 enum 值同样有 message；cause（原因链，Error 与错误 enum 皆可取）为 Error?。
    if (ty.tag == 14 && e.s0 == "message" && isErrEnumTy(s, ty)) {
        listPush(s.tFieldRes, mkRow(e.id, 2, 0, 0, 0, 0, 0));
        anaTint(s, e.i1, e.i2, ANA_TT_PROP, e.s0);
        return s.tString;
    }
    if ((ty.tag == 5 || ty.tag == 14) && e.s0 == "cause" && isErrLike(s, ty)) {
        listPush(s.tFieldRes, mkRow(e.id, 3, 0, 0, 0, 0, 0));
        anaTint(s, e.i1, e.i2, ANA_TT_PROP, e.s0);
        return tOpt(s, s.tErr);
    }
    emitDiag(s, 3015, e.i1, e.i2, "对 " + typeNameOf(s, baseTy) + " 取字段 '" + e.s0 + "'（自动解引用后非 struct/Error）");
    return s.tInt;
}

function checkCatch(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const c = e.cb catch s.dCatch;
    const operandTy = checkExpr(s, c.operand, s.dT);
    if (!c.isBlock) {
        const def = c.hExpr catch s.dummyE;
        if (def.tag == 30) {
            if (operandTy.tag == 7) {
                const ok = operandTy.inner catch s.dT;
                checkExpr(s, def, tOpt(s, ok));
                return tOpt(s, ok);
            }
            if (operandTy.tag == 6) {
                checkExpr(s, def, operandTy);
                return operandTy;
            }
        }
        const savedDiv = s.stmtDiverged;
        s.stmtDiverged = false;
        // 定宽数值（O4）：成功侧为定宽类型时默认值按它取型（字面量 0 即该类型），并接受无损扩宽。
        let defWant: Ref<Ty> = s.dT;
        if (operandTy.tag == 6 || operandTy.tag == 7) {
            const succ = operandTy.inner catch s.dT;
            if (succ.tag == 21) { defWant = succ; }
        }
        const defTy = checkExpr(s, def, defWant);
        const defDiverged = s.stmtDiverged;
        s.stmtDiverged = savedDiv;
        if (operandTy.tag == 7) {
            const ok = operandTy.inner catch s.dT;
            if (defDiverged) { return ok; }
            if (defTy.tag == 5) {
                if (operandTy.ei == None) { return operandTy; }
                return tErrunion(s, ok);
            }
            if (defTy.tag == 14 && isErrEnumTy(s, defTy)) { return tErrunionE(s, ok, defTy.ei catch s.dummyEi); }
            if (defTy.tag == 6) { return tOpt(s, ok); }
            if (!tyEq(s, defTy, ok) && !fwWidensTy(defTy, ok)) {
                emitDiag(s, 3002, e.line, e.col, "catch 默认值类型 " + typeNameOf(s, defTy) + " 与成功侧 " + typeNameOf(s, ok) + " 不一致");
            }
            return ok;
        }
        if (operandTy.tag == 6) {
            const inner = operandTy.inner catch s.dT;
            if (defDiverged) { return inner; }
            if (defTy.tag == 5) { return tErrunion(s, inner); }
            if (defTy.tag == 14 && isErrEnumTy(s, defTy) && !tyEq(s, defTy, inner)) { return tErrunionE(s, inner, defTy.ei catch s.dummyEi); }
            if (defTy.tag == 6) { return operandTy; }
            if (fwWidensTy(defTy, inner)) { return inner; }
            if (!tyEq(s, defTy, inner)) {
                emitDiag(s, 3002, e.line, e.col, "catch 默认值类型 " + typeNameOf(s, defTy) + " 与成功侧 " + typeNameOf(s, inner) + " 不一致");
            }
            return defTy;
        }
        emitDiag(s, 3002, e.line, e.col, "catch 的操作数须为 T? 或 T | Error（得到 " + typeNameOf(s, operandTy) + "）");
        return operandTy;
    }
    if (operandTy.tag != 7) {
        emitDiag(s, 3006, e.line, e.col, "catch (e) 绑定块仅作用于 T | Error（得到 " + typeNameOf(s, operandTy) + "）");
    }
    scopePush(s);
    if (c.hasBinding) {
        const bslot = allocSlot(s);
        // D3 v0.19：T | 错误enum 的 catch (e) 中 e 为该错误 enum。
        let bty: Ref<Ty> = s.tErr;
        if (operandTy.tag == 7 && operandTy.ei != None) { bty = tEnum(s, operandTy.ei catch s.dummyEi); }
        genKwCheck(s, c.binding, e.line, e.col);
        declareLocal(s, c.binding, bslot, bty, true, anaDecl(s.curMod.idx, e.line, e.col, ANA_AT_CATCH, ANA_TT_VAR, c.binding));
        anaTyDetail(s, ANA_AT_CATCH, e.line, e.col, c.binding, bty);
        listPush(s.tCatchBind, mkRow(e.id, bslot, 0, 0, 0, 0, 0));
        if (smDebug) { listPush(smDbgRows, mkRow(DBG_KEY_CATCH + e.id, bty.serial, 0, 0, 0, 0, 0)); }
    }
    const diverges = checkBlock(s, c.hBlock catch s.dummyB);
    if (diverges) { s.stmtDiverged = true; }
    let okSide: Ref<Ty> = s.tVoid;
    if (operandTy.tag == 7) {
        okSide = operandTy.inner catch s.tVoid;
    }
    if (okSide.tag != 4 && !diverges) {
        emitDiag(s, 3002, e.line, e.col, "catch (e) 块必须经 return/panic 发散（成功侧 " + typeNameOf(s, okSide) + " 非 void；S1 无隐式块值）");
    }
    return okSide;
}

// structLitInfo 失败臂（zig bad.fail 镜像——诊断后返回占位 struct）。
function structLitFail(s: Ref<Sm>, code: int, line: int, col: int, msg: string): Ref<StructT> {
    emitDiag(s, code, line, col, msg);
    return newStructT(s, s.curMod.idx, "<error>");
}

function structLitInfo(s: Ref<Sm>, lit: Ref<StructLitX>, expected: Ref<Ty>): Ref<StructT> {
    if (listLen(lit.targs) > 0) {
        const symO = modSymGet(s.curMod, lit.hint);
        const sym = symO catch s.dummySym;
        if (sym.kind == -1) {
            return structLitFail(s, 3001, lit.hintLine, lit.hintCol, "未定义类型 '" + lit.hint + "'");
        }
        if (sym.kind != 7) {
            return structLitFail(s, 3002, lit.hintLine, lit.hintCol, "'" + lit.hint + "' 不是泛型 struct 类型");
        }
        const gs = sym.gst catch s.dGs;
        const decl = gs.decl;
        if (listLen(decl.tps) != listLen(lit.targs)) {
            return structLitFail(s, 3020, lit.hintLine, lit.hintCol, "泛型 " + lit.hint + " 需要 " + toStr(listLen(decl.tps)) + " 个类型实参，得到 " + toStr(listLen(lit.targs)));
        }
        const argTys: List<Ref<Ty>> = listNew();
        let i: int = 0;
        const n = listLen(lit.targs);
        while (i < n) {
            listPush(argTys, resolveType(s, listGet(lit.targs, i) catch s.dummyTe));
            i = i + 1;
        }
        const it = instantiateStruct(s, gs, argTys);
        return it.si catch s.dummySi;
    }
    if (lit.hasHint) {
        const symO = modSymGet(s.curMod, lit.hint);
        const sym = symO catch s.dummySym;
        if (sym.kind == 3) { return sym.si catch s.dummySi; }
        if (sym.kind == -1) {
            return structLitFail(s, 3001, lit.hintLine, lit.hintCol, "未定义类型 '" + lit.hint + "'");
        }
        return structLitFail(s, 3002, lit.hintLine, lit.hintCol, "'" + lit.hint + "' 不是 struct 类型");
    }
    let want: Ref<Ty> = expected;
    if (want != s.dT && want.tag == 8) {
        want = want.inner catch s.dT;
    }
    if (want != s.dT && want.tag == 13) {
        return want.si catch s.dummySi;
    }
    return structLitFail(s, 3002, lit.hintLine, lit.hintCol, "对象字面量需要上下文类型或类型名前缀（如 Point { x: 1, y: 2 }）");
}

function checkStructLit(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const lit = e.lit catch s.dLit;
    const info = structLitInfo(s, lit, expected);
    if (anaOn && lit.hasHint) { anaUse(s, lit.hintLine, lit.hintCol, ANA_AT_EXACT, lit.hint, anaStKey(info, ANA_AT_EXACT, ANA_TT_STRUCT)); }
    const fieldIdx: List<int> = listNew();
    const seen: List<int> = listNew();
    let si: int = 0;
    const sn = listLen(info.fnames);
    while (si < sn) {
        listPush(seen, 0);
        si = si + 1;
    }
    let bad: bool = false;
    let i: int = 0;
    const n = listLen(lit.fnames);
    while (i < n) {
        const fname = listGet(lit.fnames, i) catch "";
        const fval = listGet(lit.fvals, i) catch s.dummyE;
        let found: int = -1;
        let j: int = 0;
        const m = listLen(info.fnames);
        while (j < m) {
            if ((listGet(info.fnames, j) catch "") == fname) {
                found = j;
                break;
            }
            j = j + 1;
        }
        if (found < 0) {
            bad = true;
            emitDiag(s, 3015, fval.line, fval.col, "struct " + info.name + " 没有字段 '" + fname + "'");
            listPush(fieldIdx, 0);
            checkExpr(s, fval, s.dT);
            i = i + 1;
            continue;
        }
        if ((listGet(seen, found) catch 0) != 0) {
            emitDiag(s, 3017, fval.line, fval.col, "字段 '" + fname + "' 重复初始化");
        }
        listSet(seen, found, 1);
        listPush(fieldIdx, found);
        if (anaOn) { anaUse(s, fval.line, fval.col, ANA_AT_LITKEY, fname, anaStKey(info, ANA_AT_FIELD, ANA_TT_PROP)); }
        const fty = listGet(info.ftys, found) catch s.dT;
        const vt = checkExpr(s, fval, fty);
        if (!assignableE(s, fval, vt, fty)) {
            emitDiag(s, 3002, fval.line, fval.col, "字段 '" + fname + "' 为 " + typeNameOf(s, fty) + "，初值为 " + typeNameOf(s, vt));
        }
        i = i + 1;
    }
    if (!bad) {
        let j: int = 0;
        const m = listLen(info.fnames);
        while (j < m) {
            if ((listGet(seen, j) catch 0) == 0) {
                emitDiag(s, 3017, lit.hintLine, lit.hintCol, "struct " + info.name + " 缺字段 '" + (listGet(info.fnames, j) catch "") + "'（字段必须全量初始化）");
            }
            j = j + 1;
        }
    }
    const off: int = listLen(s.slFlat);
    let fi: int = 0;
    const fn2 = listLen(fieldIdx);
    while (fi < fn2) {
        listPush(s.slFlat, listGet(fieldIdx, fi) catch 0);
        fi = fi + 1;
    }
    listPush(s.tStructLit, mkRow(e.id, info.serial, off, fn2, 0, 0, 0));
    return tStruct(s, info);
}

function checkArrayLit(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const elems = e.list;
    let elemExpected: Ref<Ty> = s.dT;
    let asSlice: bool = false;
    let fixedLen: int = -1;
    if (expected != s.dT) {
        if (expected.tag == 11) {
            elemExpected = expected.elem catch s.dT;
            fixedLen = expected.alen;
        } else if (expected.tag == 12) {
            // slice 载荷在 elem 位（tSlice 构造——tyEq/typeNameOf 同读 elem）；
            // 误读 inner 时空字面量元素期望落空→元素默认 int→假阳性 3002 且
            // array_lit_res 静默错型（V0.42 验收发现 A/B 同根）。
            elemExpected = expected.elem catch s.dT;
            asSlice = true;
        }
    }
    let unified: Ref<Ty> = s.dT;
    let i: int = 0;
    const n = listLen(elems);
    while (i < n) {
        const el = listGet(elems, i) catch s.dummyE;
        const et = checkExpr(s, el, elemExpected);
        if (elemExpected == s.dT) {
            if (unified != s.dT) {
                if (!tyEq(s, unified, et)) {
                    emitDiag(s, 3002, el.line, el.col, "数组字面量元素类型不一致（" + typeNameOf(s, unified) + " 与 " + typeNameOf(s, et) + "）");
                }
            } else {
                unified = et;
            }
        }
        i = i + 1;
    }
    let elemTy: Ref<Ty> = s.tInt;
    if (elemExpected != s.dT) { elemTy = elemExpected; }
    else if (unified != s.dT) { elemTy = unified; }
    if (fixedLen >= 0) {
        if (n != fixedLen) {
            emitDiag(s, 3011, e.line, e.col, "定宽数组期望 " + toStr(fixedLen) + " 个元素，得到 " + toStr(n));
        }
    }
    listPush(s.tArrayLit, mkRow(e.id, b2i(asSlice), elemTy.serial, n, 0, 0, 0));
    if (asSlice) {
        return tSlice(s, elemTy);
    }
    return tArr(s, elemTy, n);
}

function checkNew(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const nx = e.nb catch s.dNew;
    if (!nx.isVariant) {
        const inner = checkExpr(s, nx.lit catch s.dummyE, s.dT);
        if (inner.tag != 13) {
            emitDiag(s, 3002, e.line, e.col, "new 需要 struct 字面量或变体构造");
            return s.tInt;
        }
        return tRef(s, inner);
    }
    const symO = modSymGet(s.curMod, nx.enumName);
    const sym = symO catch s.dummySym;
    if (sym.kind == 4) {
        if ((sym.ei catch s.dummyEi).isErr) {
            emitDiag(s, 3027, nx.vline, nx.vcol, "错误 enum 不能用 new 构造（直接写 " + nx.enumName + "." + nx.varName + "(…)）");
        }
        anaVariant(s, sym.ei catch s.dummyEi, nx.vline, nx.vcol, ANA_AT_ENUMPRE, nx.enumName, nx.vline, nx.vcol, nx.varName);
        const ety = checkVariantCtor(s, e, sym.ei catch s.dummyEi, nx.enumName, nx.varName, nx.args, nx.vline, nx.vcol);
        if (ety.tag != 14) { return s.tInt; }
        return tRef(s, ety);
    }
    emitDiag(s, 3001, nx.vline, nx.vcol, "未定义 enum 类型 '" + nx.enumName + "'");
    return s.tInt;
}

function checkSwitch(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const sw = e;
    const scrutTy = checkExpr(s, e.a catch s.dummyE, s.dT);
    let ty = scrutTy;
    while (ty.tag == 8) {
        ty = ty.inner catch ty;
    }
    if (ty.tag != 14) {
        emitDiag(s, 3002, (e.a catch s.dummyE).line, (e.a catch s.dummyE).col, "switch 的 scrutinee 须为 enum 或 Ref<enum>（得到 " + typeNameOf(s, scrutTy) + "）");
        return s.tInt;
    }
    const ei = ty.ei catch s.dummyEi;
    if (ei.isErr && scrutTy.tag == 8) {
        emitDiag(s, 3027, (e.a catch s.dummyE).line, (e.a catch s.dummyE).col, "不能对 Ref<错误 enum> 使用 switch");
    }
    listPush(s.tSwitchEnum, mkRow(e.id, ei.serial, 0, 0, 0, 0, 0));
    const covered: List<int> = listNew();
    let ci0: int = 0;
    const cn0 = listLen(ei.vars);
    while (ci0 < cn0) {
        listPush(covered, 0);
        ci0 = ci0 + 1;
    }
    let hasElse: bool = false;
    let armTy: Ref<Ty> = s.dT;
    let ai: int = 0;
    const an = listLen(sw.arms);
    while (ai < an) {
        const arm = listGet(sw.arms, ai) catch s.dArm;
        let vidx: int = -1;
        if (arm.isElse) {
            if (hasElse) {
                emitDiag(s, 3003, arm.line, arm.col, "switch 重复的 else 臂");
            }
            hasElse = true;
        } else {
            let i: int = 0;
            const n = listLen(ei.vars);
            while (i < n) {
                if ((listGet(ei.vars, i) catch s.dVarT).name == arm.vname) {
                    vidx = i;
                    break;
                }
                i = i + 1;
            }
            if (vidx < 0) {
                emitDiag(s, 3019, arm.line, arm.col, "enum " + ei.name + " 没有变体 '" + arm.vname + "'");
                ai = ai + 1;
                continue;
            }
            if ((listGet(covered, vidx) catch 0) != 0) {
                emitDiag(s, 3003, arm.line, arm.col, "变体 '" + arm.vname + "' 的臂重复");
            }
            listSet(covered, vidx, 1);
            if (anaOn) { anaUse(s, arm.line, arm.col, ANA_AT_EXACT, arm.vname, anaEnKey(ei, ANA_AT_VARIANT, ANA_TT_MEMBER)); }
            const variant = listGet(ei.vars, vidx) catch s.dVarT;
            if (listLen(arm.patfs) != listLen(variant.fnames)) {
                emitDiag(s, 3011, arm.line, arm.col, "模式 " + arm.vname + " 须绑定全部 " + toStr(listLen(variant.fnames)) + " 个字段（写了 " + toStr(listLen(arm.patfs)) + "）");
            }
        }
        scopePush(s);
        const off: int = listLen(s.arNames);
        let bindN: int = 0;
        if (vidx >= 0) {
            const variant = listGet(ei.vars, vidx) catch s.dVarT;
            const n = minInt(listLen(arm.patfs), listLen(variant.fnames));
            let k: int = 0;
            while (k < n) {
                const slot = allocSlot(s);
                const pf = listGet(arm.patfs, k) catch "";
                const fty = listGet(variant.ftys, k) catch s.dT;
                genKwCheck(s, pf, arm.line, arm.col);
                declareLocal(s, pf, slot, fty, true, anaDecl(s.curMod.idx, arm.line, arm.col, ANA_AT_PAT, ANA_TT_VAR, pf));
                anaTyDetail(s, ANA_AT_PAT, arm.line, arm.col, pf, fty);
                listPush(s.arNames, pf);
                listPush(s.arSlots, slot);
                if (smDebug) { listPush(smDbgRows, mkRow(DBG_KEY_ARM + arm.id * 65536 + k, fty.serial, 0, 0, 0, 0, 0)); }
                bindN = bindN + 1;
                k = k + 1;
            }
        }
        const bt = checkExpr(s, arm.body, armTy);
        if (armTy != s.dT) {
            if (!tyEq(s, armTy, bt)) {
                emitDiag(s, 3018, arm.line, arm.col, "switch 臂类型不一致（" + typeNameOf(s, armTy) + " 与 " + typeNameOf(s, bt) + "）");
            }
        } else {
            armTy = bt;
        }
        listPush(s.tArmRes, mkRow(arm.id, ei.serial, b2i(vidx >= 0), vidx, off, bindN, 0));
        scopePop(s);
        ai = ai + 1;
    }
    if (!hasElse) {
        let i: int = 0;
        const n = listLen(ei.vars);
        while (i < n) {
            const v = listGet(ei.vars, i) catch s.dVarT;
            let covered: bool = false;
            let k: int = 0;
            while (k < an) {
                const arm = listGet(sw.arms, k) catch s.dArm;
                if (!arm.isElse && arm.vname == v.name) { covered = true; }
                k = k + 1;
            }
            if (!covered) {
                emitDiag(s, 3007, e.line, e.col, "switch 不穷尽：缺少变体 '" + v.name + "'（或补 else => 臂）");
                break;
            }
            i = i + 1;
        }
    }
    if (armTy != s.dT) { return armTy; }
    return s.tVoid;
}

// ============================================================================
// §5.9 泛型实例深拷贝（copy 族——synAlloc 分配点逐一镜像 sema.zig）
// ============================================================================

function copyFnDecl(s: Ref<Sm>, d: Ref<FnDecl>, params: List<string>, argTys: List<Ref<Ty>>): Ref<FnDecl> {
    const ps: List<Ref<Param>> = listNew();
    let i: int = 0;
    const n = listLen(d.params);
    while (i < n) {
        const p = listGet(d.params, i) catch s.dummyParam;
        listPush(ps, new Param { name: p.name, ty: substType(s, p.ty, params, argTys), col: p.col });
        i = i + 1;
    }
    const body = copyBlock(s, d.body, params, argTys);
    let dR: Ref<Te>? = None;
    if (d.ret != None) {
        dR = substType(s, d.ret catch s.dummyTe, params, argTys);
    }
    const out = new FnDecl { id: smCopyNodeId(s, d.id), name: d.name, params: ps, ret: dR, body: body, exported: d.exported, isAsync: d.isAsync, isGen: d.isGen, line: d.line, col: d.col, tps: listNew(), tcs: listNew() };
    return out;
}

function copyBlock(s: Ref<Sm>, b: Ref<Block>, params: List<string>, argTys: List<Ref<Ty>>): Ref<Block> {
    const ss: List<Ref<Stmt>> = listNew();
    let i: int = 0;
    const n = listLen(b.stmts);
    while (i < n) {
        listPush(ss, copyStmt(s, listGet(b.stmts, i) catch s.dStmt, params, argTys));
        i = i + 1;
    }
    return new Block { id: smCopyNodeId(s, b.id), stmts: ss };
}

function copyStmt(s: Ref<Sm>, st: Ref<Stmt>, params: List<string>, argTys: List<Ref<Ty>>): Ref<Stmt> {
    const out = copyStmtInner(s, st, params, argTys);
    if (smCopyIds) { out.line = st.line; out.col = st.col; }
    return out;
}

function copyStmtInner(s: Ref<Sm>, st: Ref<Stmt>, params: List<string>, argTys: List<Ref<Ty>>): Ref<Stmt> {
    const tag = st.tag;
    if (tag == 11 || tag == 12) {
        const b = st.binding catch s.dBd;
        const init = copyExpr(s, b.init, params, argTys);
        let dR: Ref<Te>? = None;
        if (b.ty != None) {
            dR = substType(s, b.ty catch s.dummyTe, params, argTys);
        }
        const outb = new Binding { id: smCopyNodeId(s, b.id), isConst: b.isConst, name: b.name, ty: dR, init: init, exported: b.exported, line: b.line, col: b.col };
        const out = new Stmt { df: None, ret: None, tag: tag, binding: outb, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
        return out;
    }
    if (tag == 14) {
        const a = st.assign catch s.dAssign;
        const out = new Stmt { df: None, ret: None, tag: tag, binding: None, assign: new AssignX { target: copyExpr(s, a.target, params, argTys), value: copyExpr(s, a.value, params, argTys), line: a.line, col: a.col }, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
        return out;
    }
    if (tag == 0) {
        const out = new Stmt { df: None, ret: None, tag: 0, binding: None, assign: None, expr: copyExpr(s, st.expr catch s.dummyE, params, argTys), ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
        return out;
    }
    if (tag == 71) {
        return new Stmt { df: None, ret: None, tag: 71, binding: None, assign: None, expr: copyExpr(s, st.expr catch s.dummyE, params, argTys), ifd: None, wh: None, fo: None, fi: None, line: st.line, col: st.col };
    }
    if (tag == 15) {
        const f = st.ifd catch s.dIf;
        const cond = copyExpr(s, f.cond, params, argTys);
        const thenB = copyBlock(s, f.thenB, params, argTys);
        const out2 = new IfX { cond: cond, thenB: thenB, elseTag: 0, elseB: None, elseI: None, line: f.line, col: f.col };
        if (f.elseTag == 1) {
            out2.elseTag = 1;
            out2.elseB = copyBlock(s, f.elseB catch s.dummyB, params, argTys);
        } else if (f.elseTag == 2) {
            out2.elseTag = 2;
            out2.elseI = copyIf(s, f.elseI catch s.dIf, params, argTys);
        }
        return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: out2, wh: None, fo: None, fi: None, line: 0, col: 0 };
    }
    if (tag == 17) {
        const w = st.wh catch s.dWhile;
        return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: new WhileX { cond: copyExpr(s, w.cond, params, argTys), body: copyBlock(s, w.body, params, argTys) }, fo: None, fi: None, line: st.line, col: st.col };
    }
    if (tag == 18) {
        const f = st.fo catch s.dFor;
        const fo = new ForX { initTag: 0, initB: None, initA: None, cond: None, updTag: 0, updA: None, updE: None, body: s.dummyB };
        if (f.initTag == 1) {
            fo.initTag = 1;
            const b = f.initB catch s.dBd;
            const init = copyExpr(s, b.init, params, argTys);
            let dR: Ref<Te>? = None;
            if (b.ty != None) {
                dR = substType(s, b.ty catch s.dummyTe, params, argTys);
            }
            fo.initB = new Binding { id: smCopyNodeId(s, b.id), isConst: b.isConst, name: b.name, ty: dR, init: init, exported: b.exported, line: b.line, col: b.col };
        } else if (f.initTag == 2) {
            fo.initTag = 2;
            fo.initA = copyAssign(s, f.initA catch s.dAssign, params, argTys);
        }
        if (f.cond != None) {
            fo.cond = copyExpr(s, f.cond catch s.dummyE, params, argTys);
        }
        if (f.updTag == 1) {
            fo.updTag = 1;
            fo.updA = copyAssign(s, f.updA catch s.dAssign, params, argTys);
        } else if (f.updTag == 2) {
            fo.updTag = 2;
            fo.updE = copyExpr(s, f.updE catch s.dummyE, params, argTys);
        }
        fo.body = copyBlock(s, f.body, params, argTys);
        return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: fo, fi: None, line: st.line, col: st.col };
    }
    if (tag == 23) {
        const r = st.ret catch s.dRet;
        let dV: Ref<Expr>? = None;
        if (r.value != None) {
            dV = copyExpr(s, r.value catch s.dummyE, params, argTys);
        }
        return new Stmt { df: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, ret: new RetX { value: dV }, line: st.line, col: st.col };
    }
    if (tag == 24 || tag == 25) {
        return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: st.line, col: st.col };
    }
    if (tag == 65) {
        return new Stmt { df: copyBlock(s, st.df catch s.dummyB, params, argTys), ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: st.line, col: st.col };
    }
    if (tag == 22) {
        // for-in 在检查期才解糖（解糖会改写所在块），模板体里的 for-in 必须深拷贝，
        // 否则各实例与定义处检查共用同一批节点（D3 v0.20 定义处检查暴露的 v0.13 缺陷）。
        const f = st.fi catch s.dFi;
        const vs: List<string> = listNew();
        let vi: int = 0;
        while (vi < listLen(f.vars)) {
            listPush(vs, listGet(f.vars, vi) catch "");
            vi = vi + 1;
        }
        const nfi = new ForInX { vars: vs, vline: f.vline, vcol: f.vcol, iterable: copyExpr(s, f.iterable, params, argTys), body: copyBlock(s, f.body, params, argTys), line: f.line, col: f.col };
        return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: nfi, line: st.line, col: st.col };
    }
    return st;
}

function copyAssign(s: Ref<Sm>, a: Ref<AssignX>, params: List<string>, argTys: List<Ref<Ty>>): Ref<AssignX> {
    return new AssignX { target: copyExpr(s, a.target, params, argTys), value: copyExpr(s, a.value, params, argTys), line: a.line, col: a.col };
}

function copyIf(s: Ref<Sm>, f: Ref<IfX>, params: List<string>, argTys: List<Ref<Ty>>): Ref<IfX> {
    const cond = copyExpr(s, f.cond, params, argTys);
    const thenB = copyBlock(s, f.thenB, params, argTys);
    const out = new IfX { cond: cond, thenB: thenB, elseTag: 0, elseB: None, elseI: None, line: f.line, col: f.col };
    if (f.elseTag == 1) {
        out.elseTag = 1;
        out.elseB = copyBlock(s, f.elseB catch s.dummyB, params, argTys);
    } else if (f.elseTag == 2) {
        out.elseTag = 2;
        out.elseI = copyIf(s, f.elseI catch s.dIf, params, argTys);
    }
    return out;
}

function copyExpr(s: Ref<Sm>, x: Ref<Expr>, params: List<string>, argTys: List<Ref<Ty>>): Ref<Expr> {
    const out = new Expr { id: smCopyNodeId(s, x.id), tag: x.tag, line: x.line, col: x.col, s0: x.s0, s1: x.s1, i0: x.i0, i1: x.i1, i2: x.i2, a: None, b: None, list: listNew(), targs: listNew(), lit: None, arms: listNew(), af: None, nb: None, cb: None, ty: None };
    const tag = x.tag;
    if (tag == 26 || tag == 27 || tag == 28 || tag == 29 || tag == 30 || tag == 31) {
        out.i0 = x.i0;
        return out;
    }
    if (tag == 32 || tag == 33) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        if (tag == 32) {
            out.b = copyExpr(s, x.b catch s.dummyE, params, argTys);
        }
        return out;
    }
    if (tag == 34) {
        if (listLen(x.targs) > 0) {
            let ti: int = 0;
            const tn = listLen(x.targs);
            while (ti < tn) {
                listPush(out.targs, substType(s, listGet(x.targs, ti) catch s.dummyTe, params, argTys));
                ti = ti + 1;
            }
        }
        // 合成节点分配序与 zig copyExpr 一致：先实参、后被调者（原先被调者在前，泛型体内
        // 带实参的调用会与 zig 的节点编号错位——semamirror-probe 自载对账发现）。
        let i: int = 0;
        const n = listLen(x.list);
        while (i < n) {
            listPush(out.list, copyExpr(s, listGet(x.list, i) catch s.dummyE, params, argTys));
            i = i + 1;
        }
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        return out;
    }
    if (tag == 35) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        out.b = copyExpr(s, x.b catch s.dummyE, params, argTys);
        return out;
    }
    if (tag == 36) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        return out;
    }
    if (tag == 37 || tag == 51) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        return out;
    }
    if (tag == 38) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        out.ty = substType(s, x.ty catch s.dummyTe, params, argTys);
        return out;
    }
    if (tag == 39) {
        const c = x.cb catch s.dCatch;
        const cx = new CatchX { operand: copyExpr(s, c.operand, params, argTys), hasBinding: c.hasBinding, binding: c.binding, isBlock: c.isBlock, hExpr: None, hBlock: None };
        if (c.isBlock) {
            cx.hBlock = copyBlock(s, c.hBlock catch s.dummyB, params, argTys);
        } else {
            cx.hExpr = copyExpr(s, c.hExpr catch s.dummyE, params, argTys);
        }
        out.cb = cx;
        return out;
    }
    if (tag == 41) {
        const sl = x.lit catch s.dLit;
        const lit = new StructLitX { hint: sl.hint, hasHint: sl.hasHint, targs: listNew(), fnames: sl.fnames, fvals: listNew(), hintLine: sl.hintLine, hintCol: sl.hintCol };
        if (listLen(sl.targs) > 0) {
            let ti: int = 0;
            const tn = listLen(sl.targs);
            while (ti < tn) {
                listPush(lit.targs, substType(s, listGet(sl.targs, ti) catch s.dummyTe, params, argTys));
                ti = ti + 1;
            }
        }
        let i: int = 0;
        const n = listLen(sl.fvals);
        while (i < n) {
            listPush(lit.fvals, copyExpr(s, listGet(sl.fvals, i) catch s.dummyE, params, argTys));
            i = i + 1;
        }
        out.lit = lit;
        return out;
    }
    if (tag == 43) {
        let i: int = 0;
        const n = listLen(x.list);
        while (i < n) {
            listPush(out.list, copyExpr(s, listGet(x.list, i) catch s.dummyE, params, argTys));
            i = i + 1;
        }
        return out;
    }
    if (tag == 44) {
        const nx = x.nb catch s.dNew;
        const nn = new NewX { isVariant: nx.isVariant, lit: None, enumName: nx.enumName, varName: nx.varName, args: listNew(), vline: nx.vline, vcol: nx.vcol };
        if (!nx.isVariant) {
            nn.lit = copyExpr(s, nx.lit catch s.dummyE, params, argTys);
        } else {
            let i: int = 0;
            const n = listLen(nx.args);
            while (i < n) {
                listPush(nn.args, copyExpr(s, listGet(nx.args, i) catch s.dummyE, params, argTys));
                i = i + 1;
            }
        }
        out.nb = nn;
        return out;
    }
    if (tag == 46) {
        out.a = copyExpr(s, x.a catch s.dummyE, params, argTys);
        let i: int = 0;
        const n = listLen(x.arms);
        while (i < n) {
            const arm = listGet(x.arms, i) catch s.dArm;
            const body = copyExpr(s, arm.body, params, argTys);
            const na = new Arm { id: smCopyNodeId(s, arm.id), isElse: arm.isElse, vname: arm.vname, patfs: arm.patfs, body: body, line: arm.line, col: arm.col };
            listPush(out.arms, na);
            i = i + 1;
        }
        return out;
    }
    if (tag == 49) {
        const af = x.af catch s.dArrow;
        const ps: List<Ref<Param>> = listNew();
        let i: int = 0;
        const n = listLen(af.params);
        while (i < n) {
            const p = listGet(af.params, i) catch s.dummyParam;
            listPush(ps, new Param { name: p.name, ty: substType(s, p.ty, params, argTys), col: p.col });
            i = i + 1;
        }
        const naf = new ArrowX { params: ps, ret: substType(s, af.ret, params, argTys), isBlock: af.isBlock, bodyExpr: None, bodyBlock: None, line: af.line, col: af.col, isAsync: af.isAsync };
        if (af.isBlock) {
            naf.bodyBlock = copyBlock(s, af.bodyBlock catch s.dummyB, params, argTys);
        } else {
            naf.bodyExpr = copyExpr(s, af.bodyExpr catch s.dummyE, params, argTys);
        }
        out.af = naf;
        return out;
    }
    return out;
}

// ============================================================================
// §5.10 合成节点基元＋for-in 解糖（rewriteForIn——创建序逐一镜像）
// ============================================================================

function synMake(s: Ref<Sm>, tag: int, line: int, col: int): Ref<Expr> {
    return new Expr { id: synAlloc(s), tag: tag, line: line, col: col, s0: "", s1: "", i0: 0, i1: 0, i2: 0, a: None, b: None, list: listNew(), targs: listNew(), lit: None, arms: listNew(), af: None, nb: None, cb: None, ty: None };
}

function synIdent(s: Ref<Sm>, name: string, line: int, col: int): Ref<Expr> {
    const e = synMake(s, 31, line, col);
    e.s0 = name;
    return e;
}

function synIntLit(s: Ref<Sm>, val: int, raw: string, line: int, col: int): Ref<Expr> {
    const e = synMake(s, 26, line, col);
    e.s0 = raw;
    e.i0 = val;
    return e;
}

function synStrLit(s: Ref<Sm>, val: string, raw: string, line: int, col: int): Ref<Expr> {
    const e = synMake(s, 28, line, col);
    // s0＝raw（解析节点同惯例——V0.42-B1-④ FAB1 原子面依赖：字符串原子
    // 发射走 s0；原形 s0=val/s1=raw 与解析节点相反，FAB1 双侧恒等即破）。
    e.s0 = raw;
    e.s1 = val;
    return e;
}

function synCall(s: Ref<Sm>, name: string, line: int, col: int, args: List<Ref<Expr>>): Ref<Expr> {
    const callee = synIdent(s, name, line, col);
    const e = synMake(s, 34, line, col);
    e.a = callee;
    e.list = args;
    return e;
}

function synBinary(s: Ref<Sm>, op: int, lhs: Ref<Expr>, rhs: Ref<Expr>, line: int, col: int): Ref<Expr> {
    const e = synMake(s, 32, line, col);
    e.i0 = op;
    e.a = lhs;
    e.b = rhs;
    return e;
}

function synCatchPanic(s: Ref<Sm>, operand: Ref<Expr>, line: int, col: int): Ref<Expr> {
    const msg = synStrLit(s, "for-in 越界（不可达）", "\"for-in 越界（不可达）\"", line, col);
    const panicArgs: List<Ref<Expr>> = listNew();
    listPush(panicArgs, msg);
    const pan = synCall(s, "panic", line, col, panicArgs);
    const cx = new CatchX { operand: operand, hasBinding: false, binding: "", isBlock: false, hExpr: pan, hBlock: None };
    const e = synMake(s, 39, line, col);
    e.cb = cx;
    return e;
}

function synBinding(s: Ref<Sm>, isConst: bool, name: string, init: Ref<Expr>, line: int, col: int): Ref<Binding> {
    return new Binding { id: synAlloc(s), isConst: isConst, name: name, ty: None, init: init, exported: false, line: line, col: col };
}

function stmtOfBinding(s: Ref<Sm>, b: Ref<Binding>): Ref<Stmt> {
    let tag: int = 11;
    if (b.isConst) { tag = 12; }
    return new Stmt { df: None, ret: None, tag: tag, binding: b, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
}

// for-in 检查期解糖（sema.zig rewriteForIn 镜像——合成节点创建序＝分配序）。
function rewriteForIn(s: Ref<Sm>, fi: Ref<ForInX>): List<Ref<Stmt>> {
    const out: List<Ref<Stmt>> = listNew();
    const atLine = fi.line;
    const atCol = fi.col;
    const n = s.forinN;
    s.forinN = s.forinN + 1;
    const itName: string = "#it" + toStr(n);
    const iName: string = "#i" + toStr(n);

    const itTy = checkExpr(s, fi.iterable, s.dT);
    let base = itTy;
    while (base.tag == 8) {
        base = base.inner catch base;
    }
    const two: bool = listLen(fi.vars) == 2;
    if (itTy.tag == 20 && !two) {
        return rewriteForInGen(s, fi, itName, n);
    }

    // Map/Set 按模板名认（泛型实例名带 # 后缀；stdlib 的非泛型 Map 同名）。
    let stn: string = "";
    if (base.tag == 13) { stn = structTname(s, base.si catch s.dummySi); }
    const kindOk: bool = base.tag == 10 || base.tag == 3 || base.tag == 11 || base.tag == 12 || (base.tag == 13 && (stn == "Map" || stn == "Set"));
    if (!kindOk || (two && base.tag != 13) || (two && stn == "Set")) {
        if (two) {
            emitDiag(s, 3022, fi.vline, fi.vcol, "双变量 for-in 仅支持 Map（得到 " + typeNameOf(s, itTy) + "）");
        } else {
            emitDiag(s, 3022, fi.vline, fi.vcol, "类型 " + typeNameOf(s, itTy) + " 不可迭代（for-in 可迭代面：List/string/数组/切片/Map）");
        }
        return out;
    }

    let srcId: Ref<Expr> = s.dummyE;
    if (base.tag == 13 && stn == "Set") {
        const stO = lookupSC(s, "setToList");
        if ((stO catch s.dummySym).kind == -1) {
            emitDiag(s, 3001, fi.vline, fi.vcol, "for-in 迭代 Set 需要 setToList");
            return out;
        }
    } else if (base.tag == 13) {
        const mkO = lookupSC(s, "mapKeys");
        const mgO = lookupSC(s, "mapGet");
        const mk = mkO catch s.dummySym;
        const mg = mgO catch s.dummySym;
        if (mk.kind == -1 || mg.kind == -1) {
            emitDiag(s, 3001, fi.vline, fi.vcol, "for-in 迭代 Map 需要 mapKeys/mapGet（import { mapKeys, mapGet } from \"std/map_set\"）");
            return out;
        }
    }
    if (base.tag == 13) {
        const keysName: string = "#keys" + toStr(n);
        const itBind = synBinding(s, true, itName, fi.iterable, atLine, atCol);
        listPush(out, stmtOfBinding(s, itBind));
        const itId = synIdent(s, itName, atLine, atCol);
        const mkArgs: List<Ref<Expr>> = listNew();
        listPush(mkArgs, itId);
        let keysFn: string = "mapKeys";
        if (stn == "Set") { keysFn = "setToList"; }
        const keysBind = synBinding(s, true, keysName, synCall(s, keysFn, atLine, atCol, mkArgs), atLine, atCol);
        listPush(out, stmtOfBinding(s, keysBind));
        srcId = synIdent(s, keysName, atLine, atCol);
    } else {
        const itBind = synBinding(s, true, itName, fi.iterable, atLine, atCol);
        listPush(out, stmtOfBinding(s, itBind));
        srcId = synIdent(s, itName, atLine, atCol);
    }

    const iId = synIdent(s, iName, atLine, atCol);
    const zero = synIntLit(s, 0, "0", atLine, atCol);
    const iBind = synBinding(s, false, iName, zero, atLine, atCol);
    const useListLen: bool = base.tag == 10 || base.tag == 13;
    const lenArgs: List<Ref<Expr>> = listNew();
    listPush(lenArgs, srcId);
    let lenCall: Ref<Expr> = s.dummyE;
    if (useListLen) {
        lenCall = synCall(s, "listLen", atLine, atCol, lenArgs);
    } else {
        lenCall = synCall(s, "len", atLine, atCol, lenArgs);
    }
    const cond = synBinary(s, 7, iId, lenCall, atLine, atCol);
    const one = synIntLit(s, 1, "1", atLine, atCol);
    const updAssign = new AssignX { target: iId, value: synBinary(s, 0, iId, one, atLine, atCol), line: atLine, col: atCol };

    const bodyStmts: List<Ref<Stmt>> = listNew();
    let elemExpr: Ref<Expr> = s.dummyE;
    if (base.tag == 10 || base.tag == 13) {
        const getArgs: List<Ref<Expr>> = listNew();
        listPush(getArgs, srcId);
        listPush(getArgs, iId);
        const get = synCall(s, "listGet", atLine, atCol, getArgs);
        elemExpr = synCatchPanic(s, get, atLine, atCol);
    } else if (base.tag == 3) {
        const getArgs: List<Ref<Expr>> = listNew();
        listPush(getArgs, srcId);
        listPush(getArgs, iId);
        const get = synCall(s, "byteAt", atLine, atCol, getArgs);
        elemExpr = synCatchPanic(s, get, atLine, atCol);
    } else {
        elemExpr = synMake(s, 35, atLine, atCol);
        elemExpr.a = srcId;
        elemExpr.b = iId;
    }
    const elemBind = synBinding(s, true, listGet(fi.vars, 0) catch "", elemExpr, atLine, atCol);
    listPush(bodyStmts, stmtOfBinding(s, elemBind));
    if (two) {
        const getArgs: List<Ref<Expr>> = listNew();
        listPush(getArgs, synIdent(s, itName, atLine, atCol));
        listPush(getArgs, synIdent(s, listGet(fi.vars, 0) catch "", atLine, atCol));
        const get = synCall(s, "mapGet", atLine, atCol, getArgs);
        const valExpr = synCatchPanic(s, get, atLine, atCol);
        const valBind = synBinding(s, true, listGet(fi.vars, 1) catch "", valExpr, atLine, atCol);
        listPush(bodyStmts, stmtOfBinding(s, valBind));
    }
    let bi: int = 0;
    const bn = listLen(fi.body.stmts);
    while (bi < bn) {
        listPush(bodyStmts, listGet(fi.body.stmts, bi) catch s.dStmt);
        bi = bi + 1;
    }
    fi.body.stmts = bodyStmts;

    const fo = new ForX { initTag: 1, initB: iBind, initA: None, cond: cond, updTag: 1, updA: updAssign, updE: None, body: fi.body };
    const fs = new Stmt { df: None, ret: None, tag: 18, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: fo, fi: None, line: atLine, col: atCol };
    listPush(out, fs);
    return out;
}

// for-in 迭代 Gen<T>（D3 v0.22）：
//   if (true) { const #itN = e; defer #genClose(#itN);
//     while (true) { const #nvN = #genNext(#itN); if (#nvN == None) { break; } const x = #nvN catch panic(…); 体 } }
// 外包一层块：离开循环即关闭生成器（break、return、? 与 async 取消都经 defer 的出口展开），
// 不等到离开外层块；正常取完时关闭已结束的生成器是空操作。
function rewriteForInGen(s: Ref<Sm>, fi: Ref<ForInX>, itName: string, n: int): List<Ref<Stmt>> {
    const atLine = fi.line;
    const atCol = fi.col;
    const nvName: string = "#nv" + toStr(n);
    const inner: List<Ref<Stmt>> = listNew();
    listPush(inner, stmtOfBinding(s, synBinding(s, true, itName, fi.iterable, atLine, atCol)));
    const clArgs: List<Ref<Expr>> = listNew();
    listPush(clArgs, synIdent(s, itName, atLine, atCol));
    const clBlock = new Block { id: synAlloc(s), stmts: listNew() };
    listPush(clBlock.stmts, new Stmt { df: None, ret: None, tag: 0, binding: None, assign: None, expr: synCall(s, "#genClose", atLine, atCol, clArgs), ifd: None, wh: None, fo: None, fi: None, line: atLine, col: atCol });
    listPush(inner, new Stmt { df: clBlock, ret: None, tag: 65, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: atLine, col: atCol });

    const bodyStmts: List<Ref<Stmt>> = listNew();
    const nxArgs: List<Ref<Expr>> = listNew();
    listPush(nxArgs, synIdent(s, itName, atLine, atCol));
    listPush(bodyStmts, stmtOfBinding(s, synBinding(s, true, nvName, synCall(s, "#genNext", atLine, atCol, nxArgs), atLine, atCol)));
    const isNone = synBinary(s, 5, synIdent(s, nvName, atLine, atCol), synMake(s, 30, atLine, atCol), atLine, atCol);
    const brkBlock = new Block { id: synAlloc(s), stmts: listNew() };
    listPush(brkBlock.stmts, new Stmt { df: None, ret: None, tag: 24, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: atLine, col: atCol });
    const ifNone = new IfX { cond: isNone, thenB: brkBlock, elseTag: 0, elseB: None, elseI: None, line: atLine, col: atCol };
    listPush(bodyStmts, new Stmt { df: None, ret: None, tag: 15, binding: None, assign: None, expr: None, ifd: ifNone, wh: None, fo: None, fi: None, line: atLine, col: atCol });
    const elemExpr = synCatchPanic(s, synIdent(s, nvName, atLine, atCol), atLine, atCol);
    listPush(bodyStmts, stmtOfBinding(s, synBinding(s, true, listGet(fi.vars, 0) catch "", elemExpr, atLine, atCol)));
    let bi: int = 0;
    const bn = listLen(fi.body.stmts);
    while (bi < bn) {
        listPush(bodyStmts, listGet(fi.body.stmts, bi) catch s.dStmt);
        bi = bi + 1;
    }
    fi.body.stmts = bodyStmts;
    const wTrue = synMake(s, 29, atLine, atCol);
    wTrue.i0 = 1;
    listPush(inner, new Stmt { df: None, ret: None, tag: 17, binding: None, assign: None, expr: None, ifd: None, wh: new WhileX { cond: wTrue, body: fi.body }, fo: None, fi: None, line: atLine, col: atCol });

    const oTrue = synMake(s, 29, atLine, atCol);
    oTrue.i0 = 1;
    const outerBlock = new Block { id: synAlloc(s), stmts: inner };
    const outer = new IfX { cond: oTrue, thenB: outerBlock, elseTag: 0, elseB: None, elseI: None, line: atLine, col: atCol };
    const out: List<Ref<Stmt>> = listNew();
    listPush(out, new Stmt { df: None, ret: None, tag: 15, binding: None, assign: None, expr: None, ifd: outer, wh: None, fo: None, fi: None, line: atLine, col: atCol });
    return out;
}

// ============================================================================
// §5.7 闭包综合（checkArrow——捕获表/基座槽/fn_table 尾段登记序全镜像）
// ============================================================================

function checkArrow(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const af = e.af catch s.dArrow;
    if (listLen(af.params) > smParamMax()) {
        emitDiag(s, 3011, af.line, af.col, "箭头函数参数超过 " + toStr(smParamMax()) + "（CALL 实参上限）");
    }
    const anames: List<string> = listNew();
    let ai0: int = 0;
    const an0 = listLen(af.params);
    while (ai0 < an0) {
        listPush(anames, (listGet(af.params, ai0) catch s.dummyParam).name);
        ai0 = ai0 + 1;
    }
    const dupa = hasDupName(anames);
    if (dupa) { emitDiag(s, 3003, af.line, af.col, "箭头函数存在重名参数"); }
    const params: List<Ref<Ty>> = listNew();
    let i: int = 0;
    const pn = listLen(af.params);
    while (i < pn) {
        const ap = listGet(af.params, i) catch s.dummyParam;
        const apt = resolveType(s, ap.ty);
        listPush(params, apt);
        if (apt.tag == 4) { emitDiag(s, 3020, af.line, af.col, "参数 " + ap.name + " 不能为 void"); }
        i = i + 1;
    }
    const ret = resolveType(s, af.ret);
    const sig = newSig(s, params, ret, af.isAsync);
    const fnTy = tFn(s, sig);
    if (expected != s.dT) {
        if (expected.tag == 15 && !tyEq(s, fnTy, expected)) {
            emitDiag(s, 3002, e.line, e.col, "闭包类型 " + typeNameOf(s, fnTy) + " 与期望 " + typeNameOf(s, expected) + " 不一致");
        }
    }
    // 2) 综合闭包体函数（#closure@<module>:<line>:<col>；oracle 侧为
    // module.path＝绝对路径——机器相关，本镜像以 display 承载，差异见缺口注记）。
    const cname: string = "#closure@" + s.curMod.display + ":" + toStr(af.line) + ":" + toStr(af.col);
    const bodyBlock = new Block { id: synAlloc(s), stmts: listNew() };
    if (!af.isBlock) {
        const x = af.bodyExpr catch s.dummyE;
        const rs = new RetX { value: x };
        const st0 = new Stmt { df: None, tag: 23, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, ret: rs, line: x.line, col: x.col };
        listPush(bodyBlock.stmts, st0);
    } else {
        bodyBlock.stmts = (af.bodyBlock catch s.dummyB).stmts;
    }
    const decl = new FnDecl { id: synAlloc(s), name: cname, params: af.params, ret: af.ret, body: bodyBlock, exported: false, isAsync: false, isGen: false, line: af.line, col: af.col, tps: listNew(), tcs: listNew() };
    // 3) 体检查（捕获上下文开启；外层检查状态保存/恢复）。
    const savedRet = s.curRet;
    const savedSlot = s.nextSlot;
    const savedLoop = s.inLoop;
    const savedCap = s.curCap;
    const savedDefer = s.deferDepth;
    const savedScopesLen = listLen(s.scopes);
    const savedGenDirect = s.iv.genDirect;
    s.iv.genDirect = false;
    s.curRet = effectiveAsyncRet(s, sig);
    s.nextSlot = 1;
    s.inLoop = 0;
    s.deferDepth = 0;
    const ctx = new CapCtx { floor: 0, names: listNew(), idxs: listNew(), caps: listNew() };
    s.curCap = ctx;
    scopePush(s);
    ctx.floor = listLen(s.scopes) - 1;
    let pi: int = 0;
    while (pi < pn) {
        const p = listGet(af.params, pi) catch s.dummyParam;
        genKwCheck(s, p.name, af.line, af.col);
        declareLocal(s, p.name, pi + 1, listGet(params, pi) catch s.dT, true, anaDecl(s.curMod.idx, af.line, af.col, ANA_AT_PARAM, ANA_TT_PARAM, p.name));
        if (p.ty.tag != 0) {
            anaDet(s.curMod.idx, af.line, af.col, ANA_AT_PARAM, false, p.name, p.name + ": " + teText(p.ty));
        } else {
            anaTyDetail(s, ANA_AT_PARAM, af.line, af.col, p.name, listGet(params, pi) catch s.dT);
        }
        if (s.nextSlot < pi + 2) { s.nextSlot = pi + 2; }
        pi = pi + 1;
    }
    s.asyncDepth = s.asyncDepth + b2i(sig.isAsync);
    const baseSlot = allocSlot(s);
    let diverges: bool = false;
    const effRet = effectiveAsyncRet(s, sig);
    if (!af.isBlock) {
        const xt = checkExpr(s, af.bodyExpr catch s.dummyE, effRet);
        if (!assignableE(s, af.bodyExpr catch s.dummyE, xt, sig.ret)) {
            emitDiag(s, 3002, (af.bodyExpr catch s.dummyE).line, (af.bodyExpr catch s.dummyE).col, "闭包体为 " + typeNameOf(s, xt) + "，声明返回 " + typeNameOf(s, sig.ret));
        }
        diverges = true;
    } else {
        diverges = checkBlock(s, bodyBlock);
    }
    putBodySlot(s, bodyBlock, s.nextSlot);
    s.asyncDepth = s.asyncDepth - b2i(sig.isAsync);
    s.iv.genDirect = savedGenDirect;
    if (sig.ret.tag != 4 && !diverges) {
        emitDiag(s, 3012, af.line, af.col, "闭包声明返回 " + typeNameOf(s, sig.ret) + "，但存在未 return 的路径");
    }
    if (listLen(ctx.caps) > smFieldMax() - 2) {
        emitDiag(s, 3020, af.line, af.col, "闭包捕获数超过 " + toStr(smFieldMax() - 2) + "（GETFLD " + smFieldBits() + " 位字段上限）");
    }
    // 4) 登记：fn_table 追加＋三侧表。
    const fnIdx: int = listLen(s.fns);
    listPush(s.fns, new FnEntry { module_idx: s.curMod.idx, decl: decl, sig: sig });
    listPush(s.closureIdx, fnIdx);
    listPush(s.tClosureMeta, mkRow(decl.id, e.id, 0, 0, 0, 0, 0));
    const capOff: int = listLen(s.crNames);
    let ci: int = 0;
    const cn = listLen(ctx.caps);
    while (ci < cn) {
        const cap = listGet(ctx.caps, ci) catch s.dummyCap;
        listPush(s.crNames, cap.name);
        listPush(s.crInts, cap.tySer);
        listPush(s.crInts, cap.slot);
        listPush(s.crInts, cap.srcTag);
        listPush(s.crInts, cap.p0);
        listPush(s.crInts, cap.p1);
        ci = ci + 1;
    }
    listPush(s.tClosureRes, mkRow(e.id, fnIdx, sig.serial, capOff, cn, baseSlot, 0));
    // 5) 检查期状态恢复。
    while (listLen(s.scopes) > savedScopesLen) {
        scopePop(s);
    }
    s.curRet = savedRet;
    s.nextSlot = savedSlot;
    s.inLoop = savedLoop;
    s.curCap = savedCap;
    s.deferDepth = savedDefer;
    return fnTy;
}

// ============================================================================
// §5.8 泛型单态化（instantiateStruct/checkCallGeneric/copy 族——分配序镜像）
// ============================================================================

function isTypeParam(params: List<string>, n: string): bool {
    let i: int = 0;
    const c = listLen(params);
    while (i < c) {
        if ((listGet(params, i) catch "") == n) { return true; }
        i = i + 1;
    }
    return false;
}

function instKey(s: Ref<Sm>, module_idx: int, name: string, argTys: List<Ref<Ty>>): string {
    return toStr(module_idx) + ":" + instArgsKey(s, name, argTys);
}

// 实例记忆键（泛型 struct／函数实例、接口实例）：实例名之后按出现序附上实参里每个 struct/enum
// 的类型序号——不同模块的同名类型不撞键。实例名（mangledName）不变，既有产物字节不变。
function instArgsKey(s: Ref<Sm>, name: string, argTys: List<Ref<Ty>>): string {
    let acc: string = mangledName(s, name, argTys) + "|";
    let i: int = 0;
    const n = listLen(argTys);
    while (i < n) {
        acc = tyIdsKey(s, listGet(argTys, i) catch s.dT, acc);
        i = i + 1;
    }
    return acc;
}

function tyIdsKey(s: Ref<Sm>, t: Ref<Ty>, acc: string): string {
    const tag = t.tag;
    if (tag == 13) { return acc + "s" + toStr((t.si catch s.dummySi).serial) + ";"; }
    if (tag == 14) { return acc + "e" + toStr((t.ei catch s.dummyEi).serial) + ";"; }
    if (tag == 11 || tag == 12) { return tyIdsKey(s, t.elem catch s.dT, acc); }
    if (tag == 15) {
        const sig = t.sig catch s.dummySig;
        let a: string = acc;
        let i: int = 0;
        const n = listLen(sig.params);
        while (i < n) {
            a = tyIdsKey(s, listGet(sig.params, i) catch s.dT, a);
            i = i + 1;
        }
        return tyIdsKey(s, sig.ret, a);
    }
    if (tag == 7) {
        const a7 = tyIdsKey(s, t.inner catch s.dT, acc);
        if (t.ei != None) { return a7 + "e" + toStr((t.ei catch s.dummyEi).serial) + ";"; }
        return a7;
    }
    if (t.inner != None) { return tyIdsKey(s, t.inner catch s.dT, acc); }
    return acc;
}

function instFnMemoGet(s: Ref<Sm>, key: string): int {
    let i: int = 0;
    const n = listLen(s.instFnKeys);
    while (i < n) {
        if ((listGet(s.instFnKeys, i) catch "") == key) {
            return listGet(s.instFnIdx, i) catch -1;
        }
        i = i + 1;
    }
    return -1;
}

function instStMemoGet(s: Ref<Sm>, key: string): Ref<StructT>? {
    let i: int = 0;
    const n = listLen(s.instStKeys);
    while (i < n) {
        if ((listGet(s.instStKeys, i) catch "") == key) {
            return listGet(s.instStVals, i);
        }
        i = i + 1;
    }
    return None;
}

function iaGet(s: Ref<Sm>, siSerial: int): int {
    let i: int = 0;
    const n = listLen(s.iaSt);
    while (i < n) {
        if ((listGet(s.iaSt, i) catch -1) == siSerial) { return i; }
        i = i + 1;
    }
    return -1;
}

function envPut(envN: List<string>, envT: List<Ref<Ty>>, name: string, ty: Ref<Ty>): void {
    listPush(envN, name);
    listPush(envT, ty);
}

function envHas(envN: List<string>, name: string): bool {
    let i: int = 0;
    const n = listLen(envN);
    while (i < n) {
        if ((listGet(envN, i) catch "") == name) { return true; }
        i = i + 1;
    }
    return false;
}

function envGetIdx(envN: List<string>, name: string): int {
    let i: int = 0;
    const n = listLen(envN);
    while (i < n) {
        if ((listGet(envN, i) catch "") == name) { return i; }
        i = i + 1;
    }
    return -1;
}

// Ty → TypeExpr 重建（实例 AST 替换用；struct/enum 以名承载）。
function tyToTypeExpr(s: Ref<Sm>, src: Ref<Ty>): Ref<Te> {
    const tag = src.tag;
    const out = new Te { tag: 52, name: "", a: None, alen: 0, ls: listNew() };
    // D3 v0.20：struct/enum、不透明类型参数、接口按类型序号直接引用（Te 70）——实例副本在
    // 模板模块里解析，按名字找不到别的模块的类型（prelude 里以用户 struct 为键的映射即此情形）。
    if (tag == 18 || tag == 19 || tag == 13 || tag == 14 || tag == 20 || tag == 22 || tag == 23 || tag == 24 || tag == 25) {
        out.tag = 70;
        out.alen = src.serial;
        return out;
    }
    if (tag == 0) { out.name = "int"; return out; }
    if (tag == 1) { out.name = "float"; return out; }
    if (tag == 2) { out.name = "bool"; return out; }
    if (tag == 3) { out.name = "string"; return out; }
    if (tag == 4) { out.name = "void"; return out; }
    if (tag == 5) { out.name = "Error"; return out; }
    if (tag == 17) { out.name = "Bytes"; return out; }
    if (tag == 21) { out.name = fwName(src.alen); return out; }
    if (tag == 13) { out.name = (src.si catch s.dummySi).name; return out; }
    if (tag == 14) { out.name = (src.ei catch s.dummyEi).name; return out; }
    if (tag == 6) {
        out.tag = 56;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 7) {
        out.tag = 59;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        if (src.ei != None) {
            out.tag = 67;
            listPush(out.ls, new Te { tag: 70, name: "", a: None, alen: tEnum(s, src.ei catch s.dummyEi).serial, ls: listNew() });
        }
        return out;
    }
    if (tag == 8) {
        out.tag = 53;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 9) {
        out.tag = 54;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 10) {
        out.tag = 55;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 16) {
        out.tag = 61;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 12) {
        out.tag = 57;
        out.a = tyToTypeExpr(s, src.inner catch s.dT);
        return out;
    }
    if (tag == 11) {
        out.tag = 58;
        out.alen = src.alen;
        out.a = tyToTypeExpr(s, src.elem catch s.dT);
        return out;
    }
    if (tag == 15) {
        out.tag = 60;
        const sig = src.sig catch s.dummySig;
        let i: int = 0;
        const n = listLen(sig.params);
        while (i < n) {
            listPush(out.ls, tyToTypeExpr(s, listGet(sig.params, i) catch s.dT));
            i = i + 1;
        }
        out.a = tyToTypeExpr(s, sig.ret);
        return out;
    }
    out.name = "int";
    return out;
}

// 模板 TypeExpr → 实例 TypeExpr（深替换；新节点）。
function substType(s: Ref<Sm>, te: Ref<Te>, params: List<string>, argTys: List<Ref<Ty>>): Ref<Te> {
    const tag = te.tag;
    if (tag == 52) {
        let i: int = 0;
        const n = listLen(params);
        while (i < n) {
            if ((listGet(params, i) catch "") == te.name) {
                return tyToTypeExpr(s, listGet(argTys, i) catch s.dT);
            }
            i = i + 1;
        }
        const out = new Te { tag: tag, name: te.name, a: None, alen: 0, ls: listNew() };
        return out;
    }
    const out = new Te { tag: tag, name: te.name, a: None, alen: te.alen, ls: listNew() };
    if (tag == 53 || tag == 54 || tag == 55 || tag == 56 || tag == 59 || tag == 57 || tag == 61) {
        out.a = substType(s, te.a catch s.dummyTe, params, argTys);
        return out;
    }
    if (tag == 58) {
        out.a = substType(s, te.a catch s.dummyTe, params, argTys);
        return out;
    }
    if (tag == 60 || tag == 67) {
        let i: int = 0;
        const n = listLen(te.ls);
        while (i < n) {
            listPush(out.ls, substType(s, listGet(te.ls, i) catch s.dummyTe, params, argTys));
            i = i + 1;
        }
        out.a = substType(s, te.a catch s.dummyTe, params, argTys);
        return out;
    }
    if (tag == 62) {
        let i: int = 0;
        const n = listLen(te.ls);
        while (i < n) {
            listPush(out.ls, substType(s, listGet(te.ls, i) catch s.dummyTe, params, argTys));
            i = i + 1;
        }
        return out;
    }
    return out;
}

// 泛型实例护栏（容量与编码上限评估 §七-4，D3 v0.24）：实例化嵌套不超过 256 层；单个实例的类型参数
// 按展开树计节点不超过 2^20（防类型规模指数膨胀——实例键与改编名都是展开串，须在建键之前拦下）；
// 不限每程序实例总数。struct 实例的展开规模在创建时按 struct 序号记下，计算时直接取用，走树越限即停。
const SM_INST_NEST_MAX: int = 256;
const SM_INST_SIZE_MAX: int = 1048576;
let smInstNest: int = 0;
let smStSize: List<int> = listNew();

// 每次 mirrorSein 从空表起（第 6 轮 6d-1：LSP 等常驻进程里多次分析，struct 序号每次重编）。
function smStSizeReset(): void {
    smStSize = listNew();
}

function smStSizeGet(serial: int): int {
    if (serial < 0 || serial >= listLen(smStSize)) { return 1; }
    return listGet(smStSize, serial) catch 1;
}

function smStSizeSet(serial: int, n: int): void {
    while (listLen(smStSize) <= serial) { listPush(smStSize, 1); }
    listSet(smStSize, serial, n);
}

function smTySize(s: Ref<Sm>, t: Ref<Ty>, budget: int): int {
    let n: int = 1;
    if (t.si != None) { n = smStSizeGet((t.si catch s.dummySi).serial); }
    if (n <= budget && t.inner != None) { n = n + smTySize(s, t.inner catch s.dT, budget - n); }
    if (n <= budget && t.elem != None) { n = n + smTySize(s, t.elem catch s.dT, budget - n); }
    if (n <= budget && t.sig != None) {
        const sg = t.sig catch s.dummySig;
        let i: int = 0;
        while (i < listLen(sg.params) && n <= budget) {
            n = n + smTySize(s, listGet(sg.params, i) catch s.dT, budget - n);
            i = i + 1;
        }
        if (n <= budget) { n = n + smTySize(s, sg.ret, budget - n); }
    }
    return n;
}

// 类型参数的展开规模（越限即返回大于 SM_INST_SIZE_MAX 的值）。
function smArgsSize(s: Ref<Sm>, argTys: List<Ref<Ty>>): int {
    let n: int = 0;
    let i: int = 0;
    while (i < listLen(argTys) && n <= SM_INST_SIZE_MAX) {
        n = n + smTySize(s, listGet(argTys, i) catch s.dT, SM_INST_SIZE_MAX - n);
        i = i + 1;
    }
    return n;
}

function smInstSizeDiag(s: Ref<Sm>, line: int, col: int, name: string): void {
    emitDiag(s, 3020, line, col, "泛型实例 " + name + " 的类型参数规模超过 2^20 个类型节点（实例爆炸护栏）");
}

function smInstNestDiag(s: Ref<Sm>, line: int, col: int, name: string): void {
    emitDiag(s, 3020, line, col, "泛型实例化嵌套超过 256 层（实例爆炸护栏）：" + name);
}

function instantiateStruct(s: Ref<Sm>, gs: Ref<GenSt>, argTys: List<Ref<Ty>>): Ref<Ty> {
    smCacheDependency(s, gs.module_idx);
    const argSize = smArgsSize(s, argTys);
    if (argSize > SM_INST_SIZE_MAX) {
        smInstSizeDiag(s, gs.decl.line, gs.decl.col, gs.decl.name);
        return s.tInt;
    }
    const key = instKey(s, gs.module_idx, gs.decl.name, argTys);
    const memo = instStMemoGet(s, key);
    if (memo != None) { return tStruct(s, memo catch s.dummySi); }
    if (hasCons(gs.decl.tcs)) {
        const cm = consMissAll(s, gs.module_idx, gs.decl.name, gs.decl.tps, gs.decl.tcs, argTys);
        if (cm != "") { emitDiag(s, 3030, 0, 0, cm); }
    }
    s.instCount = s.instCount + 1;
    if (smInstNest >= SM_INST_NEST_MAX) {
        smInstNestDiag(s, gs.decl.line, gs.decl.col, gs.decl.name);
        return s.tInt;
    }
    const mangled = mangledName(s, gs.decl.name, argTys);
    const info = newStructT(s, gs.module_idx, mangled);
    info.aLine = gs.decl.line;
    info.aCol = gs.decl.col;
    smStSizeSet(info.serial, 1 + argSize);
    listPush(s.instStKeys, key);
    listPush(s.instStVals, info);
    listPush(s.iaSt, info.serial);
    listPush(s.iaGs, gs);
    listPush(s.iaOff, listLen(s.iaFlat));
    listPush(s.iaN, listLen(argTys));
    let ai: int = 0;
    const an = listLen(argTys);
    while (ai < an) {
        listPush(s.iaFlat, listGet(argTys, ai) catch s.dT);
        ai = ai + 1;
    }
    const decl = gs.decl;
    const savedMod = s.curMod;
    s.curMod = listGet(s.mods, gs.module_idx) catch s.dummyMod;
    const fnames: List<string> = listNew();
    const ftys: List<Ref<Ty>> = listNew();
    let fi: int = 0;
    const nf = listLen(decl.fnames);
    smInstNest = smInstNest + 1;
    while (fi < nf) {
        const te = substType(s, listGet(decl.ftes, fi) catch s.dummyTe, decl.tps, argTys);
        listPush(fnames, listGet(decl.fnames, fi) catch "");
        listPush(ftys, resolveTypeIn(s, s.curMod, te));
        fi = fi + 1;
    }
    smInstNest = smInstNest - 1;
    const dupst = hasDupName(fnames);
    const sfn2 = listLen(fnames);
    if (dupst) { emitDiag(s, 3003, decl.line, decl.col, "struct " + decl.name + " 存在重名字段"); }
    if (sfn2 > smFieldMax()) { emitDiag(s, 3020, decl.line, decl.col, "struct " + decl.name + " 字段数超过 " + toStr(smFieldMax()) + "（GETFLD " + smFieldBits() + " 位上限）"); }
    info.fnames = fnames;
    info.ftys = ftys;
    s.curMod = savedMod;
    if (s.iv.defCheck == 0) { modSymPut(listGet(s.mods, gs.module_idx) catch s.dummyMod, mangled, symTypeOf(s, info)); }
    return tStruct(s, info);
}

// 型参统一行走（推断）。
function inferWalk(s: Ref<Sm>, ty: Ref<Ty>, te: Ref<Te>, params: List<string>, envN: List<string>, envT: List<Ref<Ty>>): void {
    if (ty == s.dT) { return; }
    const tag = te.tag;
    if (tag == 52) {
        if (isTypeParam(params, te.name)) {
            if (!envHas(envN, te.name)) {
                envPut(envN, envT, te.name, ty);
            }
        }
        return;
    }
    if (tag == 53) {
        if (ty.tag == 8) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 54) {
        if (ty.tag == 9) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 55) {
        if (ty.tag == 10) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 61) {
        if (ty.tag == 16) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 62 && ty.tag == 20) {
        // Gen<T>（D3 v0.22）。
        if (te.name == "Gen" && listLen(te.ls) == 1) { inferWalk(s, ty.inner catch s.dT, listGet(te.ls, 0) catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 62 && ty.tag == 23) {
        // Thread<T>（线程第 2 步）。
        if (te.name == "Thread" && listLen(te.ls) == 1) { inferWalk(s, ty.inner catch s.dT, listGet(te.ls, 0) catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 62 && ty.tag == 24) {
        // Shared<T>（线程第 4c 步）。
        if (te.name == "Shared" && listLen(te.ls) == 1) { inferWalk(s, ty.inner catch s.dT, listGet(te.ls, 0) catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 57) {
        if (ty.tag == 12) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 56) {
        if (ty.tag == 6) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 59 || tag == 67) {
        if (ty.tag == 7) { inferWalk(s, ty.inner catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 58) {
        if (ty.tag == 11) { inferWalk(s, ty.elem catch s.dT, te.a catch s.dummyTe, params, envN, envT); }
        return;
    }
    if (tag == 60) {
        if (ty.tag == 15) {
            const sig = ty.sig catch s.dummySig;
            if (listLen(sig.params) == listLen(te.ls)) {
                let i: int = 0;
                const n = listLen(te.ls);
                while (i < n) {
                    inferWalk(s, listGet(sig.params, i) catch s.dT, listGet(te.ls, i) catch s.dummyTe, params, envN, envT);
                    i = i + 1;
                }
                inferWalk(s, sig.ret, te.a catch s.dummyTe, params, envN, envT);
            }
        }
        return;
    }
    if (tag == 62) {
        if (ty.tag == 19) {
            const ift = listGet(s.iv.ifTs, ty.alen) catch s.iv.dIfT;
            if ((listGet(s.iv.ifDecls, ift.decl) catch s.iv.dIdl).name != te.name) { return; }
            if (listLen(ift.args) != listLen(te.ls)) { return; }
            let k: int = 0;
            while (k < listLen(te.ls)) {
                inferWalk(s, listGet(ift.args, k) catch s.dT, listGet(te.ls, k) catch s.dummyTe, params, envN, envT);
                k = k + 1;
            }
            return;
        }
        if (ty.tag != 13) { return; }
        const got = iaGet(s, (ty.si catch s.dummySi).serial);
        if (got < 0) { return; }
        const gs = listGet(s.iaGs, got) catch s.dGs;
        if (gs.decl.name != te.name) { return; }
        if ((listGet(s.iaN, got) catch 0) != listLen(te.ls)) { return; }
        const off = listGet(s.iaOff, got) catch 0;
        let i: int = 0;
        const n = listLen(te.ls);
        while (i < n) {
            inferWalk(s, listGet(s.iaFlat, off + i) catch s.dT, listGet(te.ls, i) catch s.dummyTe, params, envN, envT);
            i = i + 1;
        }
        return;
    }
}

function finishGenericCall(s: Ref<Sm>, e: Ref<Expr>, fnIdx: int, args: List<Ref<Expr>>): Ref<Ty> {
    const fe = listGet(s.fns, fnIdx) catch s.dummyFE;
    putExprResFunc(s, e, fnIdx);
    if (anaOn) { anaCallee(s, e, anaFnKey(s, fnIdx)); }
    let i: int = 0;
    const n = minInt(listLen(fe.sig.params), listLen(args));
    while (i < n) {
        const atTy = checkExpr(s, listGet(args, i) catch s.dummyE, listGet(fe.sig.params, i) catch s.dT);
        if (!assignableE(s, listGet(args, i) catch s.dummyE, atTy, listGet(fe.sig.params, i) catch s.dT)) {
            emitDiag(s, 3002, (listGet(args, i) catch s.dummyE).line, (listGet(args, i) catch s.dummyE).col, "实参 " + toStr(i + 1) + " 为 " + typeNameOf(s, atTy) + "，形参为 " + typeNameOf(s, listGet(fe.sig.params, i) catch s.dT));
        }
        i = i + 1;
    }
    if (fe.sig.isAsync) { return tFuture(s, fe.sig.ret); }
    return fe.sig.ret;
}

function checkCallGeneric(s: Ref<Sm>, e: Ref<Expr>, gi: Ref<GenFn>, args: List<Ref<Expr>>, targs: List<Ref<Te>>, hasTargs: bool, expected: Ref<Ty>, atLine: int, atCol: int): Ref<Ty> {
    const decl = gi.decl;
    const tps = decl.tps;
    if (listLen(args) != listLen(decl.params)) {
        emitDiag(s, 3011, atLine, atCol, "函数 " + decl.name + " 需要 " + toStr(listLen(decl.params)) + " 个实参，传入 " + toStr(listLen(args)));
    }
    const envN: List<string> = listNew();
    const envT: List<Ref<Ty>> = listNew();
    if (hasTargs) {
        if (listLen(targs) != listLen(tps)) {
            emitDiag(s, 3020, atLine, atCol, "泛型 " + decl.name + " 需要 " + toStr(listLen(tps)) + " 个类型实参，得到 " + toStr(listLen(targs)));
        }
        const n0 = minInt(listLen(targs), listLen(tps));
        let i0: int = 0;
        while (i0 < n0) {
            envPut(envN, envT, listGet(tps, i0) catch "", resolveType(s, listGet(targs, i0) catch s.dummyTe));
            i0 = i0 + 1;
        }
    }
    const n = minInt(listLen(args), listLen(decl.params));
    let i: int = 0;
    while (i < n) {
        const atTy = checkExpr(s, listGet(args, i) catch s.dummyE, s.dT);
        inferWalk(s, atTy, (listGet(decl.params, i) catch s.dummyParam).ty, tps, envN, envT);
        i = i + 1;
    }
    if (expected != s.dT && decl.ret != None) {
        const rh = genRetHint(s, decl, expected);
        if (rh != s.dT) { inferWalk(s, rh, decl.ret catch s.dummyTe, tps, envN, envT); }
    }
    const argTys: List<Ref<Ty>> = listNew();
    let pi: int = 0;
    const pn = listLen(tps);
    while (pi < pn) {
        const pname = listGet(tps, pi) catch "";
        const ei = envGetIdx(envN, pname);
        if (ei < 0) {
            emitDiag(s, 3002, atLine, atCol, "无法推断泛型 " + decl.name + " 的类型参数 '" + pname + "'——用显式类型实参 " + decl.name + "<T>(…) 或具名绑定");
            return s.tInt;
        }
        listPush(argTys, listGet(envT, ei) catch s.tInt);
        pi = pi + 1;
    }
    // D3 v0.20：调用点检查类型实参是否满足约束（3030）。
    if (hasCons(decl.tcs)) {
        const cm = consMissAll(s, gi.module_idx, decl.name, tps, decl.tcs, argTys);
        if (cm != "") {
            emitDiag(s, 3030, atLine, atCol, cm);
            if (decl.ret == None) { return s.tVoid; }
            const crt = resolveTypeIn(s, listGet(s.mods, gi.module_idx) catch s.dummyMod, substType(s, decl.ret catch s.dummyTe, tps, argTys));
            if (decl.isGen) { return tGen(s, crt); }
            return crt;
        }
    }
    const fnIdx = instGenericFn(s, gi, argTys);
    if (fnIdx < 0) { return s.tInt; }
    return finishGenericCall(s, e, fnIdx, args);
}

// D3 v0.22：生成器模板声明的返回类型是元素类型 T，调用结果是 Gen<T>——按调用结果推断前先剥一层 Gen
// （不是 Gen 时不参与推断，返回 dT）。
function genRetHint(s: Ref<Sm>, decl: Ref<FnDecl>, t: Ref<Ty>): Ref<Ty> {
    if (!decl.isGen) { return t; }
    if (t.tag == 20) { return t.inner catch s.dT; }
    return s.dT;
}

// 泛型函数实例化（按类型实参记忆；实例体按副本检查）。返回 fn 表下标，超出实例护栏返回 -1。
function instGenericFn(s: Ref<Sm>, gi: Ref<GenFn>, argTys: List<Ref<Ty>>): int {
    smCacheDependency(s, gi.module_idx);
    const decl = gi.decl;
    const tps = decl.tps;
    if (smArgsSize(s, argTys) > SM_INST_SIZE_MAX) {
        smInstSizeDiag(s, decl.line, decl.col, decl.name);
        return -1;
    }
    const key = instKey(s, gi.module_idx, decl.name, argTys);
    const memoIdx = instFnMemoGet(s, key);
    if (memoIdx >= 0) { return memoIdx; }
    s.instCount = s.instCount + 1;
    if (smInstNest >= SM_INST_NEST_MAX) {
        smInstNestDiag(s, decl.line, decl.col, decl.name);
        return -1;
    }
    const copy = copyFnDecl(s, decl, tps, argTys);
    copy.name = mangledName(s, decl.name, argTys);
    copy.exported = false;
    const sig = resolveFnSig(s, copy);
    listPush(s.fns, new FnEntry { module_idx: gi.module_idx, decl: copy, sig: sig });
    const fnIdx: int = listLen(s.fns) - 1;
    listPush(s.instFnKeys, key);
    listPush(s.instFnIdx, fnIdx);
    // 定义处检查期间不检查实例体（正式检查时再查）；定义处已报错的模板不重复检查实例体。
    if (s.iv.defCheck > 0 || intListHas(s.iv.defFailed, decl.id)) { return fnIdx; }
    const savedMod = s.curMod;
    const savedRet = s.curRet;
    const savedSlot = s.nextSlot;
    const savedLoop = s.inLoop;
    const savedAsync = s.asyncDepth;
    const savedDiverged = s.stmtDiverged;
    const savedScopes = s.scopes;
    const savedDefer = s.deferDepth;
    s.deferDepth = 0;
    s.iv.instDepth = s.iv.instDepth + 1;
    smInstNest = smInstNest + 1;
    checkFn(s, listGet(s.mods, gi.module_idx) catch s.dummyMod, copy);
    smInstNest = smInstNest - 1;
    s.iv.instDepth = s.iv.instDepth - 1;
    s.deferDepth = savedDefer;
    s.curMod = savedMod;
    s.curRet = savedRet;
    s.nextSlot = savedSlot;
    s.inLoop = savedLoop;
    s.asyncDepth = savedAsync;
    s.stmtDiverged = savedDiverged;
    s.scopes = savedScopes;
    return fnIdx;
}

function intListHas(l: List<int>, v: int): bool {
    let i: int = 0;
    const n = listLen(l);
    while (i < n) {
        if ((listGet(l, i) catch -1) == v) { return true; }
        i = i + 1;
    }
    return false;
}

// ============================================================================
// §5.8 接口与泛型约束（D3 v0.20）
// ============================================================================

function hasCons(tcs: List<Ref<Te>>): bool {
    let i: int = 0;
    const n = listLen(tcs);
    while (i < n) {
        const c = listGet(tcs, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() };
        if (c.tag != 0) { return true; }
        i = i + 1;
    }
    return false;
}

// 接口实例（按声明＋类型实参记忆）。方法签名在接口声明模块里按实参替换后解析。
function ifaceInstOf(s: Ref<Sm>, di: int, argTys: List<Ref<Ty>>): Ref<Ty> {
    smCacheDependency(s, listGet(s.iv.ifDeclMod, di) catch -1);
    const idl = listGet(s.iv.ifDecls, di) catch s.iv.dIdl;
    if (listLen(idl.tps) != listLen(argTys)) {
        emitDiag(s, 3020, 0, 0, "接口 " + idl.name + " 需要 " + toStr(listLen(idl.tps)) + " 个类型实参，得到 " + toStr(listLen(argTys)));
        return s.tInt;
    }
    let disp: string = idl.name;
    let key: string = toStr(di);
    if (listLen(argTys) > 0) {
        disp = disp + "<";
        let i: int = 0;
        while (i < listLen(argTys)) {
            if (i > 0) { disp = disp + ", "; }
            disp = disp + typeNameOf(s, listGet(argTys, i) catch s.dT);
            i = i + 1;
        }
        disp = disp + ">";
        key = key + ":" + instArgsKey(s, idl.name, argTys);
    }
    let k: int = 0;
    const kn = listLen(s.iv.ifKeys);
    while (k < kn) {
        if ((listGet(s.iv.ifKeys, k) catch "") == key) {
            const hk = (listGet(s.iv.ifTs, k) catch s.iv.dIfT).hs;
            return mkTyS(s, 19, tStruct(s, hk), None, k, hk, None, None);
        }
        k = k + 1;
    }
    const mi = listGet(s.iv.ifDeclMod, di) catch 0;
    const hs = newStructT(s, mi, disp);
    const ift = new IfaceT { serial: listLen(s.iv.ifTs), name: disp, module_idx: mi, decl: di, args: argTys, mnames: listNew(), msigs: listNew(), hs: hs };
    listPush(s.iv.ifTs, ift);
    listPush(s.iv.ifKeys, key);
    const out = mkTyS(s, 19, tStruct(s, hs), None, ift.serial, hs, None, None);
    const m = listGet(s.mods, mi) catch s.dummyMod;
    // self 字段装任意类型的值：声明成非标量类型（原生发射器按声明类型把 int/float/bool 字段当原始标量存放）。
    listPush(hs.fnames, "self");
    listPush(hs.ftys, s.tString);
    let j: int = 0;
    const nm = listLen(idl.msigs);
    while (j < nm) {
        const x = listGet(idl.msigs, j) catch s.dExDecl;
        const ps: List<Ref<Ty>> = listNew();
        const fps: List<Ref<Ty>> = listNew();
        listPush(fps, s.tString);
        let q: int = 0;
        while (q < listLen(x.params)) {
            const pp = listGet(x.params, q) catch s.dummyParam;
            const pt = resolveTypeIn(s, m, substType(s, pp.ty, idl.tps, argTys));
            if (pt.tag == 4) { emitDiag(s, 3020, x.line, x.col, "接口方法 " + x.name + " 的参数 " + pp.name + " 不能为 void"); }
            listPush(ps, pt);
            listPush(fps, pt);
            q = q + 1;
        }
        const rt = resolveTypeIn(s, m, substType(s, x.ret, idl.tps, argTys));
        listPush(ift.mnames, x.name);
        listPush(ift.msigs, newSig(s, ps, rt, false));
        listPush(hs.fnames, x.name);
        listPush(hs.ftys, tFn(s, newSig(s, fps, rt, false)));
        j = j + 1;
    }
    if (listLen(hs.fnames) > smFieldMax()) { emitDiag(s, 3020, idl.line, idl.col, "接口 " + idl.name + " 方法数超过 " + toStr(smFieldMax() - 1)); }
    return out;
}

// 接口声明的检查：重名方法、型参约束（暂不支持），无型参的接口及早解析签名。
function checkIfaceDecls(s: Ref<Sm>): void {
    let di: int = 0;
    while (di < listLen(s.iv.ifDecls)) {
        const idl = listGet(s.iv.ifDecls, di) catch s.iv.dIdl;
        s.curMod = listGet(s.mods, listGet(s.iv.ifDeclMod, di) catch 0) catch s.dummyMod;
        const dup = hasDupName(idl.mnames);
        if (dup) { emitDiag(s, 3003, idl.line, idl.col, "interface " + idl.name + " 存在重名方法"); }
        if (hasCons(idl.tcs)) { emitDiag(s, 3030, idl.line, idl.col, "接口的类型参数暂不支持约束"); }
        if (listLen(idl.tps) == 0) { ifaceInstOf(s, di, listNew()); }
        di = di + 1;
    }
}

// 方法语法的类型名（D3 §6.10-1）：剥 Ref；泛型 struct 实例取模板名。
function structTname(s: Ref<Sm>, si: Ref<StructT>): string {
    const gi = iaGet(s, si.serial);
    if (gi >= 0) { return (listGet(s.iaGs, gi) catch s.dGs).decl.name; }
    return si.name;
}

function methodTname(s: Ref<Sm>, t: Ref<Ty>): string {
    const base = stripRef(t);
    const tag = base.tag;
    if (tag == 10) { return "List"; }
    if (tag == 17) { return "bytes"; }
    if (tag == 20) { return "gen"; }
    if (tag == 3) { return "string"; }
    if (tag == 13) { return structTname(s, base.si catch s.dummySi); }
    if (tag == 14) { return (base.ei catch s.dummyEi).name; }
    if (tag == 0) { return "int"; }
    if (tag == 1) { return "float"; }
    if (tag == 2) { return "bool"; }
    if (tag == 21) { return fwName(base.alen); }
    if (tag == 11 || tag == 12) { return "array"; }
    return "value";
}

// 接收者类型的声明模块（内建类型＝prelude；未载入 prelude 时 -1）。
function homeModOf(s: Ref<Sm>, t: Ref<Ty>): int {
    const base = stripRef(t);
    if (base.tag == 13) { return (base.si catch s.dummySi).module_idx; }
    if (base.tag == 14) { return (base.ei catch s.dummyEi).module_idx; }
    const tag = base.tag;
    if (tag == 0 || tag == 1 || tag == 2 || tag == 3 || tag == 17) { return s.iv.preludeIdx; }
    return -1;
}

// 方法查找：先 lookMod 的模块作用域，再接收者类型的声明模块（D3 v0.20）。
function methodSym(s: Ref<Sm>, lookMod: Ref<Mod>, t: Ref<Ty>, mapped: string): Ref<Sym> {
    const a = modSymGet(lookMod, mapped) catch s.dummySym;
    if (a.kind == 2 || a.kind == 6) { return a; }
    const hm = homeModOf(s, t);
    if (hm >= 0 && hm != lookMod.idx) {
        const b = modSymGet(listGet(s.mods, hm) catch s.dummyMod, mapped) catch s.dummySym;
        if (b.kind == 2 || b.kind == 6) { return b; }
    }
    return s.dummySym;
}

function wantText(s: Ref<Sm>, t: Ref<Ty>, want: Ref<Sig>): string {
    let acc: string = "(" + typeNameOf(s, t);
    let i: int = 0;
    while (i < listLen(want.params)) {
        acc = acc + ", " + typeNameOf(s, listGet(want.params, i) catch s.dT);
        i = i + 1;
    }
    return acc + "): " + typeNameOf(s, want.ret);
}

function sigText(s: Ref<Sm>, sig: Ref<Sig>): string {
    let acc: string = "(";
    let i: int = 0;
    while (i < listLen(sig.params)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + typeNameOf(s, listGet(sig.params, i) catch s.dT);
        i = i + 1;
    }
    return acc + "): " + typeNameOf(s, sig.ret);
}

function methodSigOk(s: Ref<Sm>, sig: Ref<Sig>, t: Ref<Ty>, want: Ref<Sig>): bool {
    if (sig.isAsync) { return false; }
    if (listLen(sig.params) != listLen(want.params) + 1) { return false; }
    if (!tyEq(s, listGet(sig.params, 0) catch s.dT, t)) { return false; }
    let i: int = 0;
    while (i < listLen(want.params)) {
        if (!tyEq(s, listGet(sig.params, i + 1) catch s.dT, listGet(want.params, i) catch s.dT)) { return false; }
        i = i + 1;
    }
    return tyEq(s, sig.ret, want.ret);
}

// 接口 have 是否覆盖接口 want 的全部方法（同名同签名）。
function ifaceCovers(s: Ref<Sm>, have: Ref<IfaceT>, want: Ref<IfaceT>): string {
    if (have.serial == want.serial) { return ""; }
    let j: int = 0;
    while (j < listLen(want.mnames)) {
        const mname = listGet(want.mnames, j) catch "";
        let k: int = 0;
        let found: int = -1;
        while (k < listLen(have.mnames)) {
            if ((listGet(have.mnames, k) catch "") == mname) { found = k; }
            k = k + 1;
        }
        if (found < 0) { return "缺少方法 " + mname; }
        if (!sigEq(s, listGet(have.msigs, found) catch s.dummySig, listGet(want.msigs, j) catch s.dummySig)) { return "方法 " + mname + " 的签名不符"; }
        j = j + 1;
    }
    return "";
}

// 结构化实现关系：t 实现接口 ift 时返回 ""（fnOut 依接口方法序给出实现函数的 fn 表下标），否则返回原因。
function conformMiss(s: Ref<Sm>, t: Ref<Ty>, ift: Ref<IfaceT>, lookMod: Ref<Mod>, fnOut: List<int>): string {
    if (t.tag == 19) { return ifaceCovers(s, listGet(s.iv.ifTs, t.alen) catch s.iv.dIfT, ift); }
    if (t.tag == 18) {
        if (t.inner == None) { return "类型参数 " + typeNameOf(s, t) + " 没有约束"; }
        return ifaceCovers(s, listGet(s.iv.ifTs, (t.inner catch s.dT).alen) catch s.iv.dIfT, ift);
    }
    const tn = methodTname(s, t);
    let j: int = 0;
    const nm = listLen(ift.mnames);
    while (j < nm) {
        const mname = listGet(ift.mnames, j) catch "";
        const want = listGet(ift.msigs, j) catch s.dummySig;
        const mapped = lowerFirst(tn) + upperFirst(mname);
        const sym = methodSym(s, lookMod, t, mapped);
        let fi: int = -1;
        if (sym.kind == 2) {
            fi = sym.fnIdx;
        } else if (sym.kind == 6) {
            fi = instGenericFor(s, sym.gfn catch s.dGf, t, want);
        }
        if (fi < 0) { return "缺少方法 " + mname + "（找不到函数 " + mapped + "）"; }
        const fe = listGet(s.fns, fi) catch s.dummyFE;
        if (!methodSigOk(s, fe.sig, t, want)) {
            return "方法 " + mname + " 的签名不符：需要 " + mapped + wantText(s, t, want) + "，实际为 " + mapped + sigText(s, fe.sig);
        }
        listPush(fnOut, fi);
        j = j + 1;
    }
    return "";
}

// 泛型函数作为接口方法的实现：按接收者与接口方法签名推断类型实参后实例化；推断不全或不满足约束返回 -1。
function instGenericFor(s: Ref<Sm>, gi: Ref<GenFn>, recv: Ref<Ty>, want: Ref<Sig>): int {
    const decl = gi.decl;
    if (listLen(decl.params) != listLen(want.params) + 1) { return -1; }
    const envN: List<string> = listNew();
    const envT: List<Ref<Ty>> = listNew();
    inferWalk(s, recv, (listGet(decl.params, 0) catch s.dummyParam).ty, decl.tps, envN, envT);
    let i: int = 0;
    while (i < listLen(want.params)) {
        inferWalk(s, listGet(want.params, i) catch s.dT, (listGet(decl.params, i + 1) catch s.dummyParam).ty, decl.tps, envN, envT);
        i = i + 1;
    }
    if (decl.ret != None) {
        const rh = genRetHint(s, decl, want.ret);
        if (rh != s.dT) { inferWalk(s, rh, decl.ret catch s.dummyTe, decl.tps, envN, envT); }
    }
    const argTys: List<Ref<Ty>> = listNew();
    let k: int = 0;
    while (k < listLen(decl.tps)) {
        const ei = envGetIdx(envN, listGet(decl.tps, k) catch "");
        if (ei < 0) { return -1; }
        listPush(argTys, listGet(envT, ei) catch s.tInt);
        k = k + 1;
    }
    if (hasCons(decl.tcs) && consMissAll(s, gi.module_idx, decl.name, decl.tps, decl.tcs, argTys) != "") { return -1; }
    return instGenericFn(s, gi, argTys);
}

// 类型实参逐个对照约束；全部满足返回 ""，否则返回第一条原因。约束在模板模块里解析，
// 实现函数先在模板模块、再在实参类型的声明模块里找。
function consMissAll(s: Ref<Sm>, mi: int, name: string, tps: List<string>, tcs: List<Ref<Te>>, argTys: List<Ref<Ty>>): string {
    const m = listGet(s.mods, mi) catch s.dummyMod;
    let i: int = 0;
    while (i < listLen(tps)) {
        const c = listGet(tcs, i) catch s.dummyTe;
        if (c.tag != 0) {
            const tp = listGet(tps, i) catch "";
            const cty = resolveTypeIn(s, m, substType(s, c, tps, argTys));
            if (cty.tag != 19) { return "类型参数 " + tp + " 的约束 " + typeNameOf(s, cty) + " 不是接口"; }
            const ift = listGet(s.iv.ifTs, cty.alen) catch s.iv.dIfT;
            const at = listGet(argTys, i) catch s.dT;
            const sc: List<int> = listNew();
            const miss = conformMiss(s, at, ift, m, sc);
            if (miss != "") { return "类型 " + typeNameOf(s, at) + " 不满足 " + name + " 的类型参数 " + tp + " 的约束 " + ift.name + "：" + miss; }
        }
        i = i + 1;
    }
    return "";
}

// —— 定义处检查（D3 v0.20 §6.18；诊断记 3031）——

function truncL<T>(l: List<T>, n: int): void {
    while (listLen(l) > n) {
        listRemoveAt(l, listLen(l) - 1);
    }
}

function snapTake(s: Ref<Sm>): List<int> {
    const o: List<int> = listNew();
    listPush(o, listLen(s.fns));
    listPush(o, listLen(s.tExprTy));
    listPush(o, listLen(s.tExprRes));
    listPush(o, listLen(s.tMethodArgs));
    listPush(o, listLen(s.maFlat));
    listPush(o, listLen(s.tFieldRes));
    listPush(o, listLen(s.tBindSlot));
    listPush(o, listLen(s.tArmRes));
    listPush(o, listLen(s.arNames));
    listPush(o, listLen(s.arSlots));
    listPush(o, listLen(s.tStructLit));
    listPush(o, listLen(s.slFlat));
    listPush(o, listLen(s.tArrayLit));
    listPush(o, listLen(s.tVariantRes));
    listPush(o, listLen(s.tBodySlots));
    listPush(o, listLen(s.tCatchBind));
    listPush(o, listLen(s.tSwitchEnum));
    listPush(o, listLen(s.tClosureRes));
    listPush(o, listLen(s.crNames));
    listPush(o, listLen(s.crInts));
    listPush(o, listLen(s.tClosureMeta));
    listPush(o, listLen(s.closureIdx));
    listPush(o, listLen(s.tys));
    listPush(o, listLen(s.tyPool));
    listPush(o, listLen(s.sts));
    listPush(o, listLen(s.stPool));
    listPush(o, listLen(s.ens));
    listPush(o, listLen(s.enPool));
    listPush(o, listLen(s.sgs));
    listPush(o, listLen(s.sgPool));
    listPush(o, listLen(s.instFnKeys));
    listPush(o, listLen(s.instFnIdx));
    listPush(o, listLen(s.instStKeys));
    listPush(o, listLen(s.instStVals));
    listPush(o, listLen(s.iaSt));
    listPush(o, listLen(s.iaGs));
    listPush(o, listLen(s.iaFlat));
    listPush(o, listLen(s.iaOff));
    listPush(o, listLen(s.iaN));
    listPush(o, listLen(s.iv.ifTs));
    listPush(o, listLen(s.iv.ifKeys));
    listPush(o, listLen(s.iv.opqNames));
    listPush(o, listLen(s.iv.tIfaceCall));
    listPush(o, s.instCount);
    listPush(o, s.synNext);
    listPush(o, s.forinN);
    listPush(o, listLen(s.iv.boxKeys));
    return o;
}

function snapRestore(s: Ref<Sm>, o: List<int>): void {
    // 定义处检查也会创建递归类型；先断开临时范围的边，再从类型注册表移除。
    smReleaseTypeRange(s, listGet(o, 22) catch 0);
    // 类型序号会复用，规模索引须与 struct 注册表一起回滚，不能让临时类型污染下一次实例护栏。
    truncL(smStSize, listGet(o, 24) catch 0);
    truncL(s.fns, listGet(o, 0) catch 0);
    s.fnHead = listNew(); // 回滚后同一下标可能换成别的函数：散列索引作废，下次查询重建
    s.fnNext = listNew();
    truncL(s.tExprTy, listGet(o, 1) catch 0);
    truncL(s.tExprRes, listGet(o, 2) catch 0);
    truncL(s.tMethodArgs, listGet(o, 3) catch 0);
    truncL(s.maFlat, listGet(o, 4) catch 0);
    truncL(s.tFieldRes, listGet(o, 5) catch 0);
    truncL(s.tBindSlot, listGet(o, 6) catch 0);
    truncL(s.tArmRes, listGet(o, 7) catch 0);
    truncL(s.arNames, listGet(o, 8) catch 0);
    truncL(s.arSlots, listGet(o, 9) catch 0);
    truncL(s.tStructLit, listGet(o, 10) catch 0);
    truncL(s.slFlat, listGet(o, 11) catch 0);
    truncL(s.tArrayLit, listGet(o, 12) catch 0);
    truncL(s.tVariantRes, listGet(o, 13) catch 0);
    truncL(s.tBodySlots, listGet(o, 14) catch 0);
    truncL(s.tCatchBind, listGet(o, 15) catch 0);
    truncL(s.tSwitchEnum, listGet(o, 16) catch 0);
    truncL(s.tClosureRes, listGet(o, 17) catch 0);
    truncL(s.crNames, listGet(o, 18) catch 0);
    truncL(s.crInts, listGet(o, 19) catch 0);
    truncL(s.tClosureMeta, listGet(o, 20) catch 0);
    truncL(s.closureIdx, listGet(o, 21) catch 0);
    truncL(s.tys, listGet(o, 22) catch 0);
    truncL(s.tyPool, listGet(o, 23) catch 0);
    truncL(s.sts, listGet(o, 24) catch 0);
    truncL(s.stPool, listGet(o, 25) catch 0);
    truncL(s.ens, listGet(o, 26) catch 0);
    truncL(s.enPool, listGet(o, 27) catch 0);
    truncL(s.sgs, listGet(o, 28) catch 0);
    truncL(s.sgPool, listGet(o, 29) catch 0);
    truncL(s.instFnKeys, listGet(o, 30) catch 0);
    truncL(s.instFnIdx, listGet(o, 31) catch 0);
    truncL(s.instStKeys, listGet(o, 32) catch 0);
    truncL(s.instStVals, listGet(o, 33) catch 0);
    truncL(s.iaSt, listGet(o, 34) catch 0);
    truncL(s.iaGs, listGet(o, 35) catch 0);
    truncL(s.iaFlat, listGet(o, 36) catch 0);
    truncL(s.iaOff, listGet(o, 37) catch 0);
    truncL(s.iaN, listGet(o, 38) catch 0);
    truncL(s.iv.ifTs, listGet(o, 39) catch 0);
    truncL(s.iv.ifKeys, listGet(o, 40) catch 0);
    truncL(s.iv.opqNames, listGet(o, 41) catch 0);
    truncL(s.iv.tIfaceCall, listGet(o, 42) catch 0);
    s.instCount = listGet(o, 43) catch 0;
    s.synNext = listGet(o, 44) catch 0;
    s.forinN = listGet(o, 45) catch 0;
    const nbox = listGet(o, 46) catch 0;
    truncL(s.iv.boxKeys, nbox);
    truncL(s.iv.boxSt, nbox);
    truncL(s.iv.boxTy, nbox);
}

function defCheckAll(s: Ref<Sm>): void {
    let mi: int = 0;
    while (mi < listLen(s.mods)) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        if (smPhaseUse(s, mi, 0)) { mi = mi + 1; continue; }
        let di: int = 0;
        while (di < listLen(m.decls)) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 1 && d.fn != None) {
                const f = d.fn catch s.dummyF;
                if (listLen(f.tps) > 0 && hasCons(f.tcs)) { defCheckFn(s, m, f); }
            }
            di = di + 1;
        }
        smPhaseSave(s, mi, 0);
        mi = mi + 1;
    }
}

// 带约束的泛型模板在定义处检查一次：全部型参换成不透明类型（带约束者只能用约束接口里的方法），
// 检查一份副本，然后撤销它留下的全部表记录，只保留诊断。
function defCheckFn(s: Ref<Sm>, m: Ref<Mod>, decl: Ref<FnDecl>): void {
    const snap = snapTake(s);
    const diag0 = listLen(s.diagRows);
    const savedMod = s.curMod;
    const savedRet = s.curRet;
    const savedSlot = s.nextSlot;
    const savedLoop = s.inLoop;
    const savedAsync = s.asyncDepth;
    const savedDiverged = s.stmtDiverged;
    const savedScopes = s.scopes;
    const savedDefer = s.deferDepth;
    const savedCap = s.curCap;
    s.curMod = m;
    const tps = decl.tps;
    const opq: List<Ref<Ty>> = listNew();
    let i: int = 0;
    while (i < listLen(tps)) {
        const oi = listLen(s.iv.opqNames);
        listPush(s.iv.opqNames, listGet(tps, i) catch "T");
        listPush(opq, mkTyS(s, 18, None, None, oi, None, None, None));
        i = i + 1;
    }
    i = 0;
    while (i < listLen(tps)) {
        const c = listGet(decl.tcs, i) catch s.dummyTe;
        if (c.tag != 0) {
            const cty = resolveTypeIn(s, m, substType(s, c, tps, opq));
            if (cty.tag == 19) {
                const ot = listGet(opq, i) catch s.dT;
                ot.inner = cty;
            } else {
                emitDiag(s, 3030, decl.line, decl.col, "类型参数 " + (listGet(tps, i) catch "") + " 的约束必须是接口（得到 " + typeNameOf(s, cty) + "）");
            }
        }
        i = i + 1;
    }
    s.iv.defCheck = s.iv.defCheck + 1;
    const copy = copyFnDecl(s, decl, tps, opq);
    const sig = resolveFnSig(s, copy);
    listPush(s.fns, new FnEntry { module_idx: m.idx, decl: copy, sig: sig });
    s.deferDepth = 0;
    s.curCap = None;
    checkFn(s, m, copy);
    s.iv.defCheck = s.iv.defCheck - 1;
    s.deferDepth = savedDefer;
    s.curCap = savedCap;
    s.curMod = savedMod;
    s.curRet = savedRet;
    s.nextSlot = savedSlot;
    s.inLoop = savedLoop;
    s.asyncDepth = savedAsync;
    s.stmtDiverged = savedDiverged;
    s.scopes = savedScopes;
    snapRestore(s, snap);
    if (listLen(s.diagRows) > diag0) { listPush(s.iv.defFailed, decl.id); }
}

// 对接口值或不透明类型参数调用方法：按接口方法签名检查实参；接口值的调用记入 IFC1
//（codegen 取方法函数值与 self 后按闭包值调用）。
function checkIfaceCall(s: Ref<Sm>, e: Ref<Expr>, recvTy: Ref<Ty>, base: Ref<Ty>, fname: string, args: List<Ref<Expr>>, line: int, col: int): Ref<Ty> {
    let ift: Ref<IfaceT> = s.iv.dIfT;
    if (base.tag == 19) {
        ift = listGet(s.iv.ifTs, base.alen) catch s.iv.dIfT;
    } else {
        if (base.inner == None) {
            emitDiag(s, 3031, line, col, "类型参数 " + typeNameOf(s, base) + " 没有约束，不能调用方法 '" + fname + "'");
            let i: int = 0;
            while (i < listLen(args)) {
                checkExpr(s, listGet(args, i) catch s.dummyE, s.dT);
                i = i + 1;
            }
            return s.tInt;
        }
        ift = listGet(s.iv.ifTs, (base.inner catch s.dT).alen) catch s.iv.dIfT;
    }
    let k: int = 0;
    let found: int = -1;
    while (k < listLen(ift.mnames)) {
        if ((listGet(ift.mnames, k) catch "") == fname) { found = k; }
        k = k + 1;
    }
    if (found < 0) {
        emitDiag(s, 3030, line, col, "接口 " + ift.name + " 没有方法 '" + fname + "'");
        let i: int = 0;
        while (i < listLen(args)) {
            checkExpr(s, listGet(args, i) catch s.dummyE, s.dT);
            i = i + 1;
        }
        return s.tInt;
    }
    const rt = checkCallClosure(s, listGet(ift.msigs, found) catch s.dummySig, args, line, col);
    if (base.tag == 19) {
        listPush(s.iv.tIfaceCall, mkRow(e.id, found + 1, 1, 0, 0, 0, 0));
    }
    return rt;
}

// 接口装箱：把值表达式 e 原地改成 new 隐藏struct{…}（self＝原值的拷贝，其余字段＝实现函数的函数值），
// 接口值是共享句柄（D3 v0.20 §6.18）。
// 原节点内容移到新节点并保留原 id（其类型等表记录随之有效），e 换新 id 作外层。
// 线程第 3b 步：接口装入按（接口，具体类型）各用一个运行期 struct——字段与接口的隐藏 struct 相同（接口调用
// 照旧按隐藏 struct 取方法），只是运行期类型号不同；SND1 按具体类型标记它能否发送（线程设计 §十八）。
function ifaceBoxSt(s: Ref<Sm>, ift: Ref<IfaceT>, from: Ref<Ty>): Ref<StructT> {
    const one: List<Ref<Ty>> = listNew();
    listPush(one, from);
    const key = toStr(ift.serial) + "@" + instArgsKey(s, "", one);
    let i: int = 0;
    const n = listLen(s.iv.boxKeys);
    while (i < n) {
        if ((listGet(s.iv.boxKeys, i) catch "") == key) {
            return listGet(s.iv.boxSt, i) catch ift.hs;
        }
        i = i + 1;
    }
    const hs = ift.hs;
    const bs = newStructT(s, hs.module_idx, hs.name);
    let j: int = 0;
    while (j < listLen(hs.fnames)) {
        listPush(bs.fnames, listGet(hs.fnames, j) catch "");
        listPush(bs.ftys, listGet(hs.ftys, j) catch s.dT);
        j = j + 1;
    }
    listPush(s.iv.boxKeys, key);
    listPush(s.iv.boxSt, bs);
    listPush(s.iv.boxTy, from);
    return bs;
}

function ifaceBox(s: Ref<Sm>, e: Ref<Expr>, from: Ref<Ty>, to: Ref<Ty>): void {
    if (s.iv.defCheck > 0 || e.id < 0) { return; }
    const ft = from.tag;
    if (ft == 4 || ft == 5 || ft == 6 || ft == 7 || ft == 18 || ft == 19) { return; }
    let it: Ref<Ty> = to;
    if (it.tag == 6 || it.tag == 7) { it = it.inner catch s.dT; }
    const ift = listGet(s.iv.ifTs, it.alen) catch s.iv.dIfT;
    const fis: List<int> = listNew();
    if (conformMiss(s, from, ift, s.curMod, fis) != "") { return; }
    smCacheDependency(s, ift.module_idx);
    for (fi in fis) { smCacheDependency(s, (listGet(s.fns, fi) catch s.dummyFE).module_idx); }
    const inner = new Expr { id: e.id, tag: e.tag, line: e.line, col: e.col, s0: e.s0, s1: e.s1, i0: e.i0, i1: e.i1, i2: e.i2, a: e.a, b: e.b, list: e.list, targs: e.targs, lit: e.lit, arms: e.arms, af: e.af, nb: e.nb, cb: e.cb, ty: e.ty };
    e.id = synAlloc(s);
    e.tag = 44;
    e.s0 = "";
    e.s1 = "#iface";
    e.i0 = 0;
    e.i1 = 0;
    e.i2 = 0;
    e.a = None;
    e.b = None;
    e.list = listNew();
    e.targs = listNew();
    e.arms = listNew();
    e.af = None;
    e.nb = None;
    e.cb = None;
    e.ty = new Te { tag: 70, name: "", a: None, alen: it.serial, ls: listNew() };
    const lit = new StructLitX { hint: "", hasHint: false, targs: listNew(), fnames: listNew(), fvals: listNew(), hintLine: e.line, hintCol: e.col };
    listPush(lit.fnames, "self");
    listPush(lit.fvals, inner);
    const off: int = listLen(s.slFlat);
    listPush(s.slFlat, 0);
    let j: int = 0;
    while (j < listLen(fis)) {
        const fi = listGet(fis, j) catch 0;
        const fe = listGet(s.fns, fi) catch s.dummyFE;
        const fx = synIdent(s, fe.decl.name, e.line, e.col);
        putExprResFunc(s, fx, fi);
        putTy(s, fx, tFn(s, fe.sig));
        listPush(lit.fnames, listGet(ift.mnames, j) catch "");
        listPush(lit.fvals, fx);
        listPush(s.slFlat, j + 1);
        j = j + 1;
    }
    const slit = synMake(s, 41, e.line, e.col);
    slit.lit = lit;
    listPush(s.tStructLit, mkRow(slit.id, ifaceBoxSt(s, ift, from).serial, off, listLen(fis) + 1, 0, 0, 0));
    putTy(s, slit, it.inner catch s.dT);
    e.lit = None;
    e.nb = new NewX { isVariant: false, lit: slit, enumName: "", varName: "", args: listNew(), vline: e.line, vcol: e.col };
    putTy(s, e, it);
}

// ============================================================================
// §6 SEB1 发射（§6.3 根序类型图首触 ID＋§6.2 节序＋表条目键升序——sebin.zig 逐节镜像）
// ============================================================================

// 字节序字典序（S1 无 string 序比较——发射面排序用）。
// 按名字稳定排序的下标序（自底向上归并，右侧严格小于左侧才先取右侧——同名保持原相对次序，
// 与原先的插入排序同序）。容量批 C3c：插入排序在符号多时平方级（1.6 万个顶层绑定 15 秒）。
function nameOrder(names: List<string>): List<int> {
    const n = listLen(names);
    const cur: List<int> = listNew();
    const tmp: List<int> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(cur, i);
        listPush(tmp, i);
        i = i + 1;
    }
    let width: int = 1;
    while (width < n) {
        let lo: int = 0;
        while (lo < n) {
            const mid = minInt(lo + width, n);
            const hi = minInt(lo + 2 * width, n);
            let a = lo;
            let b = mid;
            let t = lo;
            while (a < mid || b < hi) {
                let takeA: bool = false;
                if (a < mid) {
                    if (b >= hi) {
                        takeA = true;
                    } else {
                        const na = listGet(names, listGet(cur, a) catch 0) catch "";
                        const nb = listGet(names, listGet(cur, b) catch 0) catch "";
                        if (!strLess(nb, na)) { takeA = true; }
                    }
                }
                if (takeA) {
                    listSet(tmp, t, listGet(cur, a) catch 0);
                    a = a + 1;
                } else {
                    listSet(tmp, t, listGet(cur, b) catch 0);
                    b = b + 1;
                }
                t = t + 1;
            }
            lo = hi;
        }
        i = 0;
        while (i < n) {
            listSet(cur, i, listGet(tmp, i) catch 0);
            i = i + 1;
        }
        width = width * 2;
    }
    return cur;
}

// 是否有重名（容量批 C3c）：原为两两比较，struct 字段、enum 变体、接口方法的上限放宽到三万余后为平方级；
// 按名字排序后相同的名字必相邻。
function hasDupName(names: List<string>): bool {
    const order = nameOrder(names);
    let i: int = 1;
    while (i < listLen(order)) {
        if ((listGet(names, listGet(order, i - 1) catch 0) catch "") == (listGet(names, listGet(order, i) catch 0) catch "")) { return true; }
        i = i + 1;
    }
    return false;
}

function strLess(a: string, b: string): bool {
    const an = len(a);
    const bn = len(b);
    let i: int = 0;
    let n: int = an;
    if (bn < n) { n = bn; }
    while (i < n) {
        const ca = byteAt(a, i) catch 0;
        const cb = byteAt(b, i) catch 0;
        if (ca != cb) { return ca < cb; }
        i = i + 1;
    }
    return an < bn;
}

function sortRows(s: Ref<Sm>, rows: List<Ref<Row>>): void {
    const n = listLen(rows);
    if (n < 2) { return; }
    const tmp: List<Ref<Row>> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(tmp, listGet(rows, i) catch s.dummyRow);
        i = i + 1;
    }
    let width: int = 1;
    while (width < n) {
        let lo: int = 0;
        while (lo < n) {
            const mid = minInt(lo + width, n);
            const hi = minInt(lo + 2 * width, n);
            let a = lo;
            let b = mid;
            let t = lo;
            while (a < mid || b < hi) {
                let takeA: bool = false;
                if (a < mid) {
                    if (b >= hi) {
                        takeA = true;
                    } else {
                        const ka = (listGet(rows, a) catch s.dummyRow).k;
                        const kb = (listGet(rows, b) catch s.dummyRow).k;
                        if (ka <= kb) { takeA = true; }
                    }
                }
                if (takeA) {
                    listSet(tmp, t, listGet(rows, a) catch s.dummyRow);
                    a = a + 1;
                } else {
                    listSet(tmp, t, listGet(rows, b) catch s.dummyRow);
                    b = b + 1;
                }
                t = t + 1;
            }
            lo = hi;
        }
        i = 0;
        while (i < n) {
            listSet(rows, i, listGet(tmp, i) catch s.dummyRow);
            i = i + 1;
        }
        width = width * 2;
    }
}

// 排序后相邻同键压实（末写胜出——HashMap put 语义；计数随压实）。
function compactRows(s: Ref<Sm>, rows: List<Ref<Row>>): void {
    const n = listLen(rows);
    if (n < 2) { return; }
    let w: int = 0;
    let i: int = 0;
    while (i < n) {
        if (i + 1 < n && (listGet(rows, i + 1) catch s.dummyRow).k == (listGet(rows, i) catch s.dummyRow).k) {
            i = i + 1;
            continue;
        }
        listSet(rows, w, listGet(rows, i) catch s.dummyRow);
        w = w + 1;
        i = i + 1;
    }
    while (listLen(rows) > w) {
        listRemoveAt(rows, listLen(rows) - 1);
    }
}

// 相邻同键去重发射判位（末写胜出——HashMap put 语义）。
function rowKeep(s: Ref<Sm>, rows: List<Ref<Row>>, i: int, n: int): bool {
    if (i + 1 >= n) { return true; }
    return (listGet(rows, i + 1) catch s.dummyRow).k != (listGet(rows, i) catch s.dummyRow).k;
}

function emitSeb1(s: Ref<Sm>): string {
    // —— 表排序（键升序）——
    sortRows(s, s.tExprTy);
    sortRows(s, s.tExprRes);
    sortRows(s, s.tMethodArgs);
    sortRows(s, s.tFieldRes);
    sortRows(s, s.tBindSlot);
    sortRows(s, s.tArmRes);
    sortRows(s, s.tStructLit);
    sortRows(s, s.tArrayLit);
    sortRows(s, s.tVariantRes);
    sortRows(s, s.tBodySlots);
    sortRows(s, s.tCatchBind);
    sortRows(s, s.tSwitchEnum);
    sortRows(s, s.tClosureRes);
    sortRows(s, s.tClosureMeta);
    compactRows(s, s.tExprTy);
    compactRows(s, s.tExprRes);
    compactRows(s, s.tMethodArgs);
    compactRows(s, s.tFieldRes);
    compactRows(s, s.tBindSlot);
    compactRows(s, s.tArmRes);
    compactRows(s, s.tStructLit);
    compactRows(s, s.tArrayLit);
    compactRows(s, s.tVariantRes);
    compactRows(s, s.tBodySlots);
    compactRows(s, s.tCatchBind);
    compactRows(s, s.tSwitchEnum);
    compactRows(s, s.tClosureRes);
    compactRows(s, s.tClosureMeta);

    // —— §6.3 根序遍历（类型图 ID 首触分配）——
    let xi: int = 0;
    const xn = listLen(s.externs);
    while (xi < xn) {
        const ext = listGet(s.externs, xi) catch s.dExt;
        let pi: int = 0;
        const pn = listLen(ext.ps);
        while (pi < pn) {
            tyId(s, listGet(ext.ps, pi) catch s.dT);
            pi = pi + 1;
        }
        tyId(s, ext.ret);
        xi = xi + 1;
    }
    let mi: int = 0;
    const nm = listLen(s.mods);
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        let gi: int = 0;
        const gn = listLen(m.gTys);
        while (gi < gn) {
            tyId(s, listGet(m.gTys, gi) catch s.dT);
            gi = gi + 1;
        }
        mi = mi + 1;
    }
    let fi: int = 0;
    const fn = listLen(s.fns);
    while (fi < fn) {
        const fe = listGet(s.fns, fi) catch s.dummyFE;
        sigId(s, fe.sig);
        fi = fi + 1;
    }
    let k: int = 0;
    const kn = listLen(s.tExprTy);
    while (k < kn) {
        tyId(s, listGet(s.tys, (listGet(s.tExprTy, k) catch s.dummyRow).a0) catch s.dT);
        k = k + 1;
    }
    k = 0;
    const kan = listLen(s.tArmRes);
    while (k < kan) {
        enumId(s, listGet(s.ens, (listGet(s.tArmRes, k) catch s.dummyRow).a0) catch s.dummyEi);
        k = k + 1;
    }
    k = 0;
    const ksl = listLen(s.tStructLit);
    while (k < ksl) {
        structId(s, listGet(s.sts, (listGet(s.tStructLit, k) catch s.dummyRow).a0) catch s.dummySi);
        k = k + 1;
    }
    k = 0;
    const kal = listLen(s.tArrayLit);
    while (k < kal) {
        tyId(s, listGet(s.tys, (listGet(s.tArrayLit, k) catch s.dummyRow).a1) catch s.dT);
        k = k + 1;
    }
    k = 0;
    const kvr = listLen(s.tVariantRes);
    while (k < kvr) {
        enumId(s, listGet(s.ens, (listGet(s.tVariantRes, k) catch s.dummyRow).a0) catch s.dummyEi);
        k = k + 1;
    }
    k = 0;
    const kse = listLen(s.tSwitchEnum);
    while (k < kse) {
        enumId(s, listGet(s.ens, (listGet(s.tSwitchEnum, k) catch s.dummyRow).a0) catch s.dummyEi);
        k = k + 1;
    }
    k = 0;
    const kcr = listLen(s.tClosureRes);
    while (k < kcr) {
        const row = listGet(s.tClosureRes, k) catch s.dummyRow;
        sigId(s, listGet(s.sgs, row.a1) catch s.dummySig);
        let ci: int = 0;
        while (ci < row.a3) {
            tyId(s, listGet(s.tys, listGet(s.crInts, (row.a2 + ci) * 5) catch 0) catch s.dT);
            ci = ci + 1;
        }
        k = k + 1;
    }
    // 调试构建：绑定的声明类型排在全部原有根之后，原有类型的编号不变。
    if (smDebug) {
        sortRows(s, smDbgRows);
        k = 0;
        while (k < listLen(smDbgRows)) {
            tyId(s, listGet(s.tys, (listGet(smDbgRows, k) catch s.dummyRow).a0) catch s.dT);
            k = k + 1;
        }
    }

    // —— 发射（§6.2 节序）——
    const o = new Out { parts: listNew() };
    const ctx = makeCur("", false);
    listPush(o.parts, "SEB1 ");
    outDec(o, 1);
    outDec(o, listLen(s.mods));
    mi = 0;
    while (mi < nm) {
        outDec(o, (listGet(s.mods, mi) catch s.dummyMod).nodeCount);
        mi = mi + 1;
    }

    // 类型图池。
    outDec(o, listLen(s.tyOrder));
    let ti: int = 0;
    const tn = listLen(s.tyOrder);
    while (ti < tn) {
        const t = listGet(s.tys, listGet(s.tyOrder, ti) catch 0) catch s.dT;
        const tag = t.tag;
        if (tag <= 5 || tag == 17) {
            outDec(o, tag);
        } else if (tag == 21 || tag == 22) {
            // 定宽数值（O4）：种类码随后；句柄（D3 v0.23 FFI）：句柄序随后。冻结的 Zig 加载器不认 21/22，遇到即拒绝。
            outDec(o, tag);
            outDec(o, t.alen);
        } else if (tag == 11) {
            outDec(o, tag);
            outDec(o, listGet(s.tyPool, (t.elem catch s.dT).serial) catch 0);
            outDec(o, t.alen);
        } else if (tag == 13) {
            outDec(o, tag);
            outDec(o, listGet(s.stPool, (t.si catch s.dummySi).serial) catch 0);
        } else if (tag == 19) {
            // D3 v0.20 接口值＝共享句柄：类型池记为 Ref<隐藏 struct>。
            outDec(o, 8);
            outDec(o, listGet(s.tyPool, (t.inner catch s.dT).serial) catch 0);
        } else if (tag == 14) {
            // D3 v0.19：错误 enum 在类型池记为 19（codegen 按 Error 对象处理）；普通 enum 不变。
            if ((t.ei catch s.dummyEi).isErr) { outDec(o, 19); } else { outDec(o, tag); }
            outDec(o, listGet(s.enPool, (t.ei catch s.dummyEi).serial) catch 0);
        } else if (tag == 15) {
            outDec(o, tag);
            outDec(o, listGet(s.sgPool, (t.sig catch s.dummySig).serial) catch 0);
        } else if (tag == 12) {
            outDec(o, tag);
            outDec(o, listGet(s.tyPool, (t.elem catch s.dT).serial) catch 0);
        } else {
            outDec(o, tag);
            outDec(o, listGet(s.tyPool, (t.inner catch s.dT).serial) catch 0);
        }
        ti = ti + 1;
    }
    // struct 池。
    outDec(o, listLen(s.stOrder));
    ti = 0;
    const stn = listLen(s.stOrder);
    while (ti < stn) {
        const si = listGet(s.sts, listGet(s.stOrder, ti) catch 0) catch s.dummySi;
        outDec(o, si.module_idx);
        outStr(o, ctx, si.name);
        outDec(o, listLen(si.fnames));
        let fi2: int = 0;
        const sfn = listLen(si.fnames);
        while (fi2 < sfn) {
            outStr(o, ctx, listGet(si.fnames, fi2) catch "");
            outDec(o, tyId(s, listGet(si.ftys, fi2) catch s.dT));
            fi2 = fi2 + 1;
        }
        ti = ti + 1;
    }
    // enum 池。
    outDec(o, listLen(s.enOrder));
    ti = 0;
    const enn = listLen(s.enOrder);
    while (ti < enn) {
        const ei = listGet(s.ens, listGet(s.enOrder, ti) catch 0) catch s.dummyEi;
        outDec(o, ei.module_idx);
        outStr(o, ctx, ei.name);
        outDec(o, listLen(ei.vars));
        let vi: int = 0;
        const evn = listLen(ei.vars);
        while (vi < evn) {
            const v = listGet(ei.vars, vi) catch s.dVarT;
            outStr(o, ctx, v.name);
            outDec(o, listLen(v.fnames));
            let fi3: int = 0;
            const vfn = listLen(v.fnames);
            while (fi3 < vfn) {
                outStr(o, ctx, listGet(v.fnames, fi3) catch "");
                outDec(o, tyId(s, listGet(v.ftys, fi3) catch s.dT));
                fi3 = fi3 + 1;
            }
            vi = vi + 1;
        }
        ti = ti + 1;
    }
    // sig 池。
    outDec(o, listLen(s.sgOrder));
    ti = 0;
    const sgn = listLen(s.sgOrder);
    while (ti < sgn) {
        const sig = listGet(s.sgs, listGet(s.sgOrder, ti) catch 0) catch s.dummySig;
        outBool(o, sig.isAsync);
        outDec(o, listLen(sig.params));
        let pi: int = 0;
        const spn = listLen(sig.params);
        while (pi < spn) {
            outDec(o, tyId(s, listGet(sig.params, pi) catch s.dT));
            pi = pi + 1;
        }
        outDec(o, tyId(s, sig.ret));
        ti = ti + 1;
    }

    // externs。
    outDec(o, listLen(s.externs));
    xi = 0;
    while (xi < xn) {
        const ext = listGet(s.externs, xi) catch s.dExt;
        outStr(o, ctx, ext.name);
        outDec(o, listLen(ext.ps));
        let pi: int = 0;
        const epn = listLen(ext.ps);
        while (pi < epn) {
            outDec(o, tyId(s, listGet(ext.ps, pi) catch s.dT));
            pi = pi + 1;
        }
        outDec(o, tyId(s, ext.ret));
        xi = xi + 1;
    }

    // modules。
    outDec(o, nm);
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        outStr(o, ctx, m.display);
        outDec(o, listLen(m.globals));
        let gi: int = 0;
        const gn = listLen(m.globals);
        while (gi < gn) {
            const g = listGet(m.globals, gi) catch s.dBd;
            outStr(o, ctx, g.name);
            outDec(o, tyId(s, listGet(m.gTys, gi) catch s.dT));
            outDec(o, listGet(m.gSlots, gi) catch 0);
            gi = gi + 1;
        }
        outDec(o, m.initCap);
        // symbols 导出面（名字升序）。
        const symRows: List<Ref<Row>> = listNew();
        const symSortNames: List<string> = listNew();
        let si2: int = 0;
        const ssn = listLen(m.symNames);
        while (si2 < ssn) {
            const sym = listGet(m.symVals, si2) catch s.dummySym;
            const nm2 = listGet(m.symNames, si2) catch "";
            if (sym.kind == 1) {
                listPush(symRows, mkRow(0, 0, sym.module_idx, sym.slot, si2, 0, 0));
                listPush(symSortNames, nm2);
            } else if (sym.kind == 2) {
                listPush(symRows, mkRow(0, 1, sym.fnIdx, 0, si2, 0, 0));
                listPush(symSortNames, nm2);
            } else if (sym.kind == 3) {
                listPush(symRows, mkRow(0, 2, (sym.si catch s.dummySi).module_idx, 0, si2, 0, 0));
                listPush(symSortNames, nm2);
            } else if (sym.kind == 4) {
                listPush(symRows, mkRow(0, 3, (sym.ei catch s.dummyEi).module_idx, 0, si2, 0, 0));
                listPush(symSortNames, nm2);
            }
            si2 = si2 + 1;
        }
        // 名字升序（稳定：同名保持登记序；载荷 a/b 随行）。
        const order = nameOrder(symSortNames);
        const icount = listLen(symRows);
        outDec(o, icount);
        let oi: int = 0;
        while (oi < icount) {
            const at = listGet(order, oi) catch 0;
            const sr = listGet(symRows, at) catch s.dummyRow;
            outStr(o, ctx, listGet(symSortNames, at) catch "");
            outDec(o, sr.a0);
            outDec(o, sr.a1);
            outDec(o, sr.a2);
            oi = oi + 1;
        }
        mi = mi + 1;
    }

    // fn_table。
    outDec(o, listLen(s.fns));
    fi = 0;
    while (fi < fn) {
        const fe = listGet(s.fns, fi) catch s.dummyFE;
        outDec(o, fe.module_idx);
        outDec(o, fe.decl.id);
        outStr(o, ctx, fe.decl.name);
        outDec(o, listGet(s.sgPool, fe.sig.serial) catch 0);
        outDec(o, listLen(fe.sig.params));
        let pi: int = 0;
        const fpn = listLen(fe.sig.params);
        while (pi < fpn) {
            outDec(o, tyId(s, listGet(fe.sig.params, pi) catch s.dT));
            pi = pi + 1;
        }
        outDec(o, tyId(s, fe.sig.ret));
        outBool(o, fe.sig.isAsync);
        fi = fi + 1;
    }

    // tests。
    outDec(o, listLen(s.tests));
    let ti2: int = 0;
    const tsn = listLen(s.tests);
    while (ti2 < tsn) {
        const t = listGet(s.tests, ti2) catch s.dTestE;
        outStr(o, ctx, t.name);
        outDec(o, t.module_idx);
        ti2 = ti2 + 1;
    }

    // —— 14 张节点键侧表（§6.2 序；条目键升序）——
    // 1) expr_types。
    outDec(o, listLen(s.tExprTy));
    k = 0;
    while (k < kn) {
        const row = listGet(s.tExprTy, k) catch s.dummyRow;
        if (rowKeep(s, s.tExprTy, k, kn)) {
            outDec(o, row.k);
            outDec(o, tyId(s, listGet(s.tys, row.a0) catch s.dT));
        }
        k = k + 1;
    }
    // 2) expr_res。
    outDec(o, listLen(s.tExprRes));
    k = 0;
    const kern = listLen(s.tExprRes);
    while (k < kern) {
        const row = listGet(s.tExprRes, k) catch s.dummyRow;
        if (rowKeep(s, s.tExprRes, k, kern)) {
            outDec(o, row.k);
            outDec(o, row.a0);
            if (row.a0 == 0) {
                outDec(o, row.a1);
            } else if (row.a0 == 1) {
                outDec(o, row.a1);
                outDec(o, row.a2);
            } else {
                outDec(o, row.a1);
            }
        }
        k = k + 1;
    }
    // 3) method_args。
    outDec(o, listLen(s.tMethodArgs));
    k = 0;
    const kma = listLen(s.tMethodArgs);
    while (k < kma) {
        const row = listGet(s.tMethodArgs, k) catch s.dummyRow;
        if (rowKeep(s, s.tMethodArgs, k, kma)) {
            outDec(o, row.k);
            outDec(o, row.a1);
            let j: int = 0;
            while (j < row.a1) {
                outDec(o, listGet(s.maFlat, row.a0 + j) catch 0);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    // 4) field_res。
    outDec(o, listLen(s.tFieldRes));
    k = 0;
    const kfr = listLen(s.tFieldRes);
    while (k < kfr) {
        const row = listGet(s.tFieldRes, k) catch s.dummyRow;
        if (rowKeep(s, s.tFieldRes, k, kfr)) {
            outDec(o, row.k);
            outDec(o, row.a0);
            if (row.a0 == 0) {
                outDec(o, listGet(s.stPool, row.a1) catch 0);
                outDec(o, row.a2);
                outDec(o, row.a3);
            } else if (row.a0 == 1) {
                outDec(o, listGet(s.enPool, row.a1) catch 0);
                outDec(o, row.a2);
            }
        }
        k = k + 1;
    }
    // 5) binding_slots。
    outDec(o, listLen(s.tBindSlot));
    k = 0;
    const kbs = listLen(s.tBindSlot);
    while (k < kbs) {
        const row = listGet(s.tBindSlot, k) catch s.dummyRow;
        if (rowKeep(s, s.tBindSlot, k, kbs)) {
            outDec(o, row.k);
            outDec(o, row.a0);
        }
        k = k + 1;
    }
    // 6) arm_res。
    outDec(o, listLen(s.tArmRes));
    k = 0;
    while (k < kan) {
        const row = listGet(s.tArmRes, k) catch s.dummyRow;
        if (rowKeep(s, s.tArmRes, k, kan)) {
            outDec(o, row.k);
            outDec(o, listGet(s.enPool, row.a0) catch 0);
            outBool(o, row.a1 != 0);
            if (row.a1 != 0) {
                outDec(o, row.a2);
            }
            outDec(o, row.a4);
            let j: int = 0;
            while (j < row.a4) {
                outStr(o, ctx, listGet(s.arNames, row.a3 + j) catch "");
                outDec(o, listGet(s.arSlots, row.a3 + j) catch 0);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    // 7) struct_lit_res。
    outDec(o, listLen(s.tStructLit));
    k = 0;
    while (k < ksl) {
        const row = listGet(s.tStructLit, k) catch s.dummyRow;
        if (rowKeep(s, s.tStructLit, k, ksl)) {
            outDec(o, row.k);
            outDec(o, listGet(s.stPool, row.a0) catch 0);
            outDec(o, row.a2);
            let j: int = 0;
            while (j < row.a2) {
                outDec(o, listGet(s.slFlat, row.a1 + j) catch 0);
                j = j + 1;
            }
        }
        k = k + 1;
    }
    // 8) array_lit_res。
    outDec(o, listLen(s.tArrayLit));
    k = 0;
    while (k < kal) {
        const row = listGet(s.tArrayLit, k) catch s.dummyRow;
        if (rowKeep(s, s.tArrayLit, k, kal)) {
            outDec(o, row.k);
            outBool(o, row.a0 != 0);
            outDec(o, tyId(s, listGet(s.tys, row.a1) catch s.dT));
            outDec(o, row.a2);
        }
        k = k + 1;
    }
    // 9) variant_res。
    outDec(o, listLen(s.tVariantRes));
    k = 0;
    while (k < kvr) {
        const row = listGet(s.tVariantRes, k) catch s.dummyRow;
        if (rowKeep(s, s.tVariantRes, k, kvr)) {
            outDec(o, row.k);
            outDec(o, listGet(s.enPool, row.a0) catch 0);
            outDec(o, row.a1);
        }
        k = k + 1;
    }
    // 10) body_slots。
    outDec(o, listLen(s.tBodySlots));
    k = 0;
    const kbo = listLen(s.tBodySlots);
    while (k < kbo) {
        const row = listGet(s.tBodySlots, k) catch s.dummyRow;
        if (rowKeep(s, s.tBodySlots, k, kbo)) {
            outDec(o, row.k);
            outDec(o, row.a0);
        }
        k = k + 1;
    }
    // 11) catch_bind_slots。
    outDec(o, listLen(s.tCatchBind));
    k = 0;
    const kcb = listLen(s.tCatchBind);
    while (k < kcb) {
        const row = listGet(s.tCatchBind, k) catch s.dummyRow;
        if (rowKeep(s, s.tCatchBind, k, kcb)) {
            outDec(o, row.k);
            outDec(o, row.a0);
        }
        k = k + 1;
    }
    // 12) switch_enum。
    outDec(o, listLen(s.tSwitchEnum));
    k = 0;
    while (k < kse) {
        const row = listGet(s.tSwitchEnum, k) catch s.dummyRow;
        if (rowKeep(s, s.tSwitchEnum, k, kse)) {
            outDec(o, row.k);
            outDec(o, listGet(s.enPool, row.a0) catch 0);
        }
        k = k + 1;
    }
    // 13) closure_res。
    outDec(o, listLen(s.tClosureRes));
    k = 0;
    while (k < kcr) {
        const row = listGet(s.tClosureRes, k) catch s.dummyRow;
        if (rowKeep(s, s.tClosureRes, k, kcr)) {
            outDec(o, row.k);
            outDec(o, row.a0);
            outDec(o, listGet(s.sgPool, row.a1) catch 0);
            outDec(o, row.a3);
            let j: int = 0;
            while (j < row.a3) {
                outStr(o, ctx, listGet(s.crNames, row.a2 + j) catch "");
                const base = row.a2 * 5 + j * 5;
                outDec(o, tyId(s, listGet(s.tys, listGet(s.crInts, base) catch 0) catch s.dT));
                outDec(o, listGet(s.crInts, base + 1) catch 0);
                const srcTag = listGet(s.crInts, base + 2) catch 0;
                outDec(o, srcTag);
                outDec(o, listGet(s.crInts, base + 3) catch 0);
                if (srcTag == 1) {
                    outDec(o, listGet(s.crInts, base + 4) catch 0);
                }
                j = j + 1;
            }
        }
        k = k + 1;
    }
    // 14) closure_meta。
    outDec(o, listLen(s.tClosureMeta));
    k = 0;
    const kcm = listLen(s.tClosureMeta);
    while (k < kcm) {
        const row = listGet(s.tClosureMeta, k) catch s.dummyRow;
        if (rowKeep(s, s.tClosureMeta, k, kcm)) {
            outDec(o, row.k);
            outDec(o, row.a0);
        }
        k = k + 1;
    }
    // 15) closure_fn_indices（追加序）。
    outDec(o, listLen(s.closureIdx));
    let ci2: int = 0;
    const ccn = listLen(s.closureIdx);
    while (ci2 < ccn) {
        outDec(o, listGet(s.closureIdx, ci2) catch 0);
        ci2 = ci2 + 1;
    }

    // entry。
    outDec(o, s.entryModule);
    outBool(o, s.hasMain);
    outDec(o, s.mainFnIdx);

    // 26) diags（V0.42-B1-⑤；D91 §六）：检查序直发不排序；干净程序计数 0
    //（既有 25 节逐字节恒等——追加节零扰动）。
    outDec(o, listLen(s.diagRows));
    let dgi: int = 0;
    const dgn = listLen(s.diagRows);
    while (dgi < dgn) {
        const drow = listGet(s.diagRows, dgi) catch s.dummyRow;
        outDec(o, drow.k);
        outDec(o, drow.a0);
        outDec(o, drow.a1);
        outDec(o, drow.a2);
        outStr(o, ctx, listGet(s.diagMsgs, dgi) catch "");
        dgi = dgi + 1;
    }

    // ERR1（D3 v0.19，仅程序含错误 enum 时追加）：每个错误 enum 的池号与逐变体
    // 种类名、原因字段（序＋1，0＝无）、消息片段（字段序＋1，0＝字面量后随原文）。
    let nerr: int = 0;
    ti = 0;
    while (ti < enn) {
        if ((listGet(s.ens, listGet(s.enOrder, ti) catch 0) catch s.dummyEi).isErr) { nerr = nerr + 1; }
        ti = ti + 1;
    }
    if (nerr > 0) {
        listPush(o.parts, "ERR1 ");
        outDec(o, nerr);
        ti = 0;
        while (ti < enn) {
            const eei = listGet(s.ens, listGet(s.enOrder, ti) catch 0) catch s.dummyEi;
            if (eei.isErr) {
                outDec(o, ti);
                outDec(o, listLen(eei.vars));
                let evi: int = 0;
                while (evi < listLen(eei.vars)) {
                    const ev = listGet(eei.vars, evi) catch s.dVarT;
                    outStr(o, ctx, eei.name + "." + ev.name);
                    outDec(o, ev.cause + 1);
                    outDec(o, listLen(ev.segField));
                    let sgi: int = 0;
                    while (sgi < listLen(ev.segField)) {
                        const sf = listGet(ev.segField, sgi) catch -1;
                        outDec(o, sf + 1);
                        if (sf < 0) { outStr(o, ctx, listGet(ev.segRaw, sgi) catch ""); }
                        sgi = sgi + 1;
                    }
                    evi = evi + 1;
                }
            }
            ti = ti + 1;
        }
    }

    // IFC1（D3 v0.20，仅程序含接口方法调用时追加）：调用节点键、方法函数值的字段序、接收者是否经 Ref。
    if (listLen(s.iv.tIfaceCall) > 0) {
        sortRows(s, s.iv.tIfaceCall);
        compactRows(s, s.iv.tIfaceCall);
        listPush(o.parts, "IFC1 ");
        outDec(o, listLen(s.iv.tIfaceCall));
        let ici: int = 0;
        while (ici < listLen(s.iv.tIfaceCall)) {
            const icr = listGet(s.iv.tIfaceCall, ici) catch s.dummyRow;
            outDec(o, icr.k);
            outDec(o, icr.a0);
            outDec(o, icr.a1);
            ici = ici + 1;
        }
    }

    // GEN1（D3 v0.22，仅程序用到生成器且无诊断时追加）：生成器函数的 fn 表序（codegen 据此把每个生成器
    // 拆成创建函数＋体函数）。冻结的 Zig 加载器遇到 Gen 类型或未知尾节即拒绝，不会按旧语义静默编译。
    let genUsed: bool = false;
    ti = 0;
    while (ti < tn) {
        if ((listGet(s.tys, listGet(s.tyOrder, ti) catch 0) catch s.dT).tag == 20) { genUsed = true; }
        ti = ti + 1;
    }
    const genFns: List<int> = listNew();
    fi = 0;
    while (fi < fn) {
        if ((listGet(s.fns, fi) catch s.dummyFE).decl.isGen) {
            listPush(genFns, fi);
            genUsed = true;
        }
        fi = fi + 1;
    }
    if (genUsed && listLen(s.diagRows) == 0) {
        listPush(o.parts, "GEN1 ");
        outDec(o, listLen(genFns));
        let gfi: int = 0;
        while (gfi < listLen(genFns)) {
            outDec(o, listGet(genFns, gfi) catch 0);
            gfi = gfi + 1;
        }
    }

    // FFI1（D3 v0.23，仅程序含带 from 的外部函数且无诊断时追加）：每个 extern 的绑定（方式、库名或
    // syscall 号）与逐参封送种类／附加、外部结构体的 C 布局、回调签名与回调实参（fn 表序, 签名序）。
    // 冻结的 Zig 加载器遇到未知尾节即拒绝。
    if (s.fx.used && listLen(s.diagRows) == 0) {
        listPush(o.parts, "FFI1 ");
        outDec(o, listLen(s.externs));
        let fxi: int = 0;
        while (fxi < listLen(s.externs)) {
            const fext = listGet(s.externs, fxi) catch s.dExt;
            if (fext.fx == None) {
                outDec(o, 0);
            } else {
                const ffx = fext.fx catch s.fx.dFx;
                outDec(o, ffx.mode);
                if (ffx.mode == 1) { outStr(o, ctx, ffx.lib); } else { outDec(o, ffx.nr); }
                outDec(o, ffx.mod);
                outDec(o, ffx.line);
                outDec(o, ffx.col);
                outDec(o, listLen(ffx.pk));
                let fpi: int = 0;
                while (fpi < listLen(ffx.pk)) {
                    outDec(o, listGet(ffx.pk, fpi) catch 0);
                    outDec(o, listGet(ffx.pa, fpi) catch 0);
                    fpi = fpi + 1;
                }
                outDec(o, ffx.rk);
                outDec(o, ffx.ra);
                outDec(o, ffx.nfix);
            }
            fxi = fxi + 1;
        }
        outDec(o, listLen(s.fx.xsSer));
        let fli: int = 0;
        while (fli < listLen(s.fx.xsSer)) {
            outDec(o, (listGet(s.stPool, listGet(s.fx.xsSer, fli) catch 0) catch -1) + 1);
            outDec(o, listGet(s.fx.xsSize, fli) catch 0);
            outDec(o, listGet(s.fx.xsAlign, fli) catch 1);
            const flo = listGet(s.fx.xsOff, fli) catch ffiNoInts();
            outDec(o, listLen(flo) / 4);
            let flj: int = 0;
            while (flj < listLen(flo)) {
                outDec(o, listGet(flo, flj) catch 0);
                flj = flj + 1;
            }
            fli = fli + 1;
        }
        outDec(o, listLen(s.fx.cbKinds));
        let fci: int = 0;
        while (fci < listLen(s.fx.cbKinds)) {
            const fcr = listGet(s.fx.cbKinds, fci) catch ffiNoInts();
            let fcj: int = 0;
            while (fcj < listLen(fcr)) {
                outDec(o, listGet(fcr, fcj) catch 0);
                fcj = fcj + 1;
            }
            fci = fci + 1;
        }
        outDec(o, listLen(s.fx.cbFns) / 2);
        let fbi: int = 0;
        while (fbi < listLen(s.fx.cbFns)) {
            outDec(o, listGet(s.fx.cbFns, fbi) catch 0);
            fbi = fbi + 1;
        }
    }

    // DBG1（第 6 轮 6c-4a，仅调试构建且无诊断时追加）：n 行（键, 类型池号＋1）按键升序，键见 smDbgRows。同一个键出现
    // 多次而类型不同时类型记 0（未知），调试会话按运行期标签渲染。其后是类型池每一项的源码拼写（typeNameOf，池序），
    // 会话据此给出槽的类型名——池里的形状丢了接口名、错误联合的失败类型与句柄名，拼写不丢。冻结的 Zig 加载器不会收到它。
    if (smDebug && listLen(s.diagRows) == 0) { dbgEmit(s, o, ctx); }

    // SND1（线程第 3b 步，仅程序用到 threadSpawn 且无诊断时追加）：不可发送的 struct 池序、enum 池序与闭包键，
    // 原生产物据此建运行期可发送表（线程设计 §十八）。冻结的 Zig 加载器遇到未知尾节即拒绝。
    if (s.iv.sendUsed && listLen(s.diagRows) == 0) { sndEmit(s, o); }

    // LVE1（D3 v0.20，仅程序用到 List 值类型元素时追加；无载荷）：只有太虚 codegen 在这些元素的
    // 存取处插入拷贝，冻结的 Zig 加载器遇到未知尾节即拒绝，不会按旧语义静默编译。
    if (s.iv.listValElem) { listPush(o.parts, "LVE1 "); }

    // ANA1（第 6 轮 6d-3a，仅 SEIN 标志位 16 置位时追加，不挂“无诊断”）：n 行，见 AnaRow；键锚类加 1 写出（0 为没有
    // 身份），名字按串写出。其后 ANT1（6d-3b）：n 行声明的说明，每行位置、锚类、标志（位 0＝导出）与名字、文本两个串，
    // 见 AnaDet。冻结的 Zig 加载器不会收到它们。
    if (anaOn) {
        anaEmit(o, ctx);
        anaDetEmit(o, ctx);
    }

    return outJoin(o);
}

function dbgEmit(s: Ref<Sm>, o: Ref<Out>, ctx: Ref<Cur>): void {
    const keys: List<int> = listNew();
    const tys: List<int> = listNew();
    let k: int = 0;
    while (k < listLen(smDbgRows)) {
        const row = listGet(smDbgRows, k) catch s.dummyRow;
        const id = tyId(s, listGet(s.tys, row.a0) catch s.dT);
        const n = listLen(keys);
        if (n > 0 && (listGet(keys, n - 1) catch -1) == row.k) {
            if ((listGet(tys, n - 1) catch -1) != id) { listSet(tys, n - 1, -1); }
        } else {
            listPush(keys, row.k);
            listPush(tys, id);
        }
        k = k + 1;
    }
    listPush(o.parts, "DBG1 ");
    outDec(o, listLen(keys));
    k = 0;
    while (k < listLen(keys)) {
        outDec(o, listGet(keys, k) catch 0);
        outDec(o, (listGet(tys, k) catch -1) + 1);
        k = k + 1;
    }
    const tn = listLen(s.tyOrder);
    outDec(o, tn);
    k = 0;
    while (k < tn) {
        let nm = typeNameOf(s, listGet(s.tys, listGet(s.tyOrder, k) catch 0) catch s.dT);
        if (len(nm) == 0) { nm = "?"; }
        outStr(o, ctx, nm);
        k = k + 1;
    }
}

// ============================================================================
// §8 FAB1 发射（V0.42-B1-④；D91 §7.1——src/compiler/sema/fab1.zig 同构：
// 根集＝终态树全部顶层 decl 根（声明序）＋合成 FnDecl 根（fn_table 序，
// 不可自解析树到达者）；记录＝全树并集每键类节点一条、非键节点按出现；
// 遍历序＝TXB1 序列化序。id 域：键类（Expr/Binding/Block/Arm/FnDecl）＝
// 节点 id（解析＝基座＋流位、合成＝synNext——syn_base 接线后两域互斥）；
// 非键（语句壳/Param/Te/槽行）＝nonkey 域按出现分配（1<<40 起，与键域
// 天然不相交）。dev 面＝main args 尾参；生产面＝SEB1+"FAB1 " 魔数拼接。）
// ============================================================================

struct FabCtx {
    s: Ref<Sm>,
    emitted: List<int>,
    marked: List<int>,
    epoch: int,
    nonkey: int,
    recs: List<string>,
    roots: List<int>,
}

function newFabCtx(s: Ref<Sm>, marked: List<int>, epoch: int): Ref<FabCtx> {
    return new FabCtx { s: s, emitted: listNew(), marked: marked, epoch: epoch, nonkey: 1099511627776, recs: listNew(), roots: listNew() };
}

// 键类已发集：常规 ID 直接索引；域外 ID 保留原线性扫描语义。
function fabSeen(fc: Ref<FabCtx>, id: int): bool {
    if (id >= 0 && id < listLen(fc.marked)) {
        return (listGet(fc.marked, id) catch 0) == fc.epoch;
    }
    let i: int = listLen(fc.emitted) - 1;
    while (i >= 0) {
        if ((listGet(fc.emitted, i) catch 0) == id) { return true; }
        i = i - 1;
    }
    return false;
}

function newFabOut(): Ref<Out> {
    return new Out { parts: listNew() };
}

function fabEmit(fc: Ref<FabCtx>, id: int, kind: int, atoms: Ref<Out>, childIds: List<int>): void {
    const parts: List<string> = listNew();
    listPush(parts, toStr(id) + " ");
    listPush(parts, toStr(kind) + " ");
    let i: int = 0;
    const na = listLen(atoms.parts);
    while (i < na) {
        listPush(parts, listGet(atoms.parts, i) catch "");
        i = i + 1;
    }
    listPush(parts, toStr(listLen(childIds)) + " ");
    i = 0;
    const nc = listLen(childIds);
    while (i < nc) {
        listPush(parts, toStr(listGet(childIds, i) catch 0) + " ");
        i = i + 1;
    }
    listPush(fc.recs, joinRange(parts, 0, listLen(parts)));
}

// 键类节点走查入口：并集去重（已发→仅回 id）。
function fabKeyVisit(fc: Ref<FabCtx>, id: int, kind: int, atoms: Ref<Out>, childIds: List<int>): int {
    if (fabSeen(fc, id)) { return id; }
    listPush(fc.emitted, id);
    if (id >= 0 && id < listLen(fc.marked)) {
        listSet(fc.marked, id, fc.epoch);
    }
    fabEmit(fc, id, kind, atoms, childIds);
    return id;
}

// 非键/槽行记录（槽行每处出现独立记录——TXB1 同形）。
function fabSlot(fc: Ref<FabCtx>, kind: int, atoms: Ref<Out>, childIds: List<int>): int {
    const id = fc.nonkey;
    fc.nonkey = fc.nonkey + 1;
    fabEmit(fc, id, kind, atoms, childIds);
    return id;
}

// —— 类型表达式（kinds 52..64；非键域按出现）——
function fabTe(fc: Ref<FabCtx>, t: Ref<Te>): int {
    const a = newFabOut();
    const ch: List<int> = listNew();
    const tag = t.tag;
    if (tag == 52) {
        outStr(a, fc.s.cur, t.name);
    } else if (tag == 58) {
        outDec(a, t.alen);
        listPush(ch, fabTe(fc, t.a catch fc.s.dummyTe));
    } else if (tag == 60) {
        outDec(a, listLen(t.ls));
        let i: int = 0;
        while (i < listLen(t.ls)) {
            listPush(ch, fabTe(fc, listGet(t.ls, i) catch fc.s.dummyTe));
            i = i + 1;
        }
        listPush(ch, fabTe(fc, t.a catch fc.s.dummyTe));
    } else if (tag == 62) {
        outStr(a, fc.s.cur, t.name);
        outDec(a, listLen(t.ls));
        let i2: int = 0;
        while (i2 < listLen(t.ls)) {
            listPush(ch, fabTe(fc, listGet(t.ls, i2) catch fc.s.dummyTe));
            i2 = i2 + 1;
        }
    } else if (tag == 53 || tag == 54 || tag == 55 || tag == 56 || tag == 57 || tag == 59 || tag == 61) {
        listPush(ch, fabTe(fc, t.a catch fc.s.dummyTe));
    } else if (tag == 67) {
        listPush(ch, fabTe(fc, t.a catch fc.s.dummyTe));
        return fabSlot(fc, 59, a, ch);
    } else if (tag == 70) {
        outStr(a, fc.s.cur, typeNameOf(fc.s, listGet(fc.s.tys, t.alen) catch fc.s.tInt));
        return fabSlot(fc, 52, a, ch);
    } else {
        print("semamirror: fabTe 未知类型 " + toStr(tag));
        panic("abort");
    }
    return fabSlot(fc, tag, a, ch);
}

function fabParam(fc: Ref<FabCtx>, p: Ref<Param>): int {
    const a = newFabOut();
    outStr(a, fc.s.cur, p.name);
    outDec(a, p.col);
    const ch: List<int> = listNew();
    listPush(ch, fabTe(fc, p.ty));
    return fabSlot(fc, 2, a, ch);
}

function fabTparams(fc: Ref<FabCtx>, tps: List<string>): int {
    const a = newFabOut();
    outDec(a, listLen(tps));
    let i: int = 0;
    while (i < listLen(tps)) {
        outStr(a, fc.s.cur, listGet(tps, i) catch "");
        i = i + 1;
    }
    return fabSlot(fc, 64, a, listNew());
}

function fabBinding(fc: Ref<FabCtx>, b: Ref<Binding>): int {
    const a = newFabOut();
    outStr(a, fc.s.cur, b.name);
    outDec(a, b2i(b.exported));
    outDec(a, b.line);
    outDec(a, b.col);
    const ch: List<int> = listNew();
    if (b.ty != None) {
        const ta = newFabOut();
        const tc: List<int> = listNew();
        listPush(tc, fabTe(fc, b.ty catch fc.s.dummyTe));
        listPush(ch, fabSlot(fc, 13, ta, tc));
    } else {
        listPush(ch, fabSlot(fc, 13, newFabOut(), listNew()));
    }
    listPush(ch, fabExpr(fc, b.init));
    let kind: int = 11;
    if (b.isConst) { kind = 12; }
    return fabKeyVisit(fc, b.id, kind, a, ch);
}

function fabBlock(fc: Ref<FabCtx>, blk: Ref<Block>): int {
    const ch: List<int> = listNew();
    let i: int = 0;
    while (i < listLen(blk.stmts)) {
        listPush(ch, fabStmt(fc, listGet(blk.stmts, i) catch fc.s.dStmt));
        i = i + 1;
    }
    return fabKeyVisit(fc, blk.id, 4, newFabOut(), ch);
}

function fabAssign(fc: Ref<FabCtx>, ax: Ref<AssignX>): int {
    const a = newFabOut();
    outDec(a, ax.line);
    outDec(a, ax.col);
    const ch: List<int> = listNew();
    listPush(ch, fabExpr(fc, ax.target));
    listPush(ch, fabExpr(fc, ax.value));
    return fabSlot(fc, 14, a, ch);
}

function fabIf(fc: Ref<FabCtx>, f: Ref<IfX>): int {
    const a = newFabOut();
    outDec(a, f.line);
    outDec(a, f.col);
    const ch: List<int> = listNew();
    listPush(ch, fabExpr(fc, f.cond));
    listPush(ch, fabBlock(fc, f.thenB));
    if (f.elseTag == 0) {
        listPush(ch, fabSlot(fc, 16, newFabOut(), listNew()));
    } else if (f.elseTag == 1) {
        const ea = newFabOut();
        const ec: List<int> = listNew();
        listPush(ec, fabBlock(fc, f.elseB catch fc.s.dummyB));
        listPush(ch, fabSlot(fc, 16, ea, ec));
    } else {
        const ea2 = newFabOut();
        const ec2: List<int> = listNew();
        listPush(ec2, fabIf(fc, f.elseI catch fc.s.dIf));
        listPush(ch, fabSlot(fc, 16, ea2, ec2));
    }
    return fabSlot(fc, 15, a, ch);
}

function fabStmt(fc: Ref<FabCtx>, st: Ref<Stmt>): int {
    const tag = st.tag;
    if (tag == 0) {
        return fabExpr(fc, st.expr catch fc.s.dummyE);
    }
    if (tag == 11 || tag == 12) {
        return fabBinding(fc, st.binding catch fc.s.dBd);
    }
    if (tag == 14) {
        return fabAssign(fc, st.assign catch fc.s.dAssign);
    }
    if (tag == 15) {
        return fabIf(fc, st.ifd catch fc.s.dIf);
    }
    if (tag == 17) {
        const w = st.wh catch fc.s.dWhile;
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        const ch: List<int> = listNew();
        listPush(ch, fabExpr(fc, w.cond));
        listPush(ch, fabBlock(fc, w.body));
        return fabSlot(fc, 17, a, ch);
    }
    if (tag == 18) {
        const fo = st.fo catch fc.s.dFor;
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        const ch: List<int> = listNew();
        if (fo.initTag == 0) {
            listPush(ch, fabSlot(fc, 19, newFabOut(), listNew()));
        } else if (fo.initTag == 1) {
            const ia = newFabOut();
            const ic: List<int> = listNew();
            listPush(ic, fabBinding(fc, fo.initB catch fc.s.dBd));
            listPush(ch, fabSlot(fc, 19, ia, ic));
        } else {
            const ia2 = newFabOut();
            const ic2: List<int> = listNew();
            listPush(ic2, fabAssign(fc, fo.initA catch fc.s.dAssign));
            listPush(ch, fabSlot(fc, 19, ia2, ic2));
        }
        if (fo.cond != None) {
            const ca = newFabOut();
            const cc: List<int> = listNew();
            listPush(cc, fabExpr(fc, fo.cond catch fc.s.dummyE));
            listPush(ch, fabSlot(fc, 20, ca, cc));
        } else {
            listPush(ch, fabSlot(fc, 20, newFabOut(), listNew()));
        }
        if (fo.updTag == 0) {
            listPush(ch, fabSlot(fc, 21, newFabOut(), listNew()));
        } else if (fo.updTag == 1) {
            const ua = newFabOut();
            const uc: List<int> = listNew();
            listPush(uc, fabAssign(fc, fo.updA catch fc.s.dAssign));
            listPush(ch, fabSlot(fc, 21, ua, uc));
        } else {
            const ua2 = newFabOut();
            const uc2: List<int> = listNew();
            listPush(uc2, fabExpr(fc, fo.updE catch fc.s.dummyE));
            listPush(ch, fabSlot(fc, 21, ua2, uc2));
        }
        listPush(ch, fabBlock(fc, fo.body));
        return fabSlot(fc, 18, a, ch);
    }
    if (tag == 22) {
        // 未解糖的 for-in 只会出现在泛型模板体里（模板体不检查、只按实例检查）；
        // codegen 只编译 fn 表里的函数，不读模板体，这里按零原子记录占位。
        const fx = st.fi catch fc.s.dFi;
        const fch: List<int> = listNew();
        listPush(fch, fabExpr(fc, fx.iterable));
        listPush(fch, fabBlock(fc, fx.body));
        return fabSlot(fc, 22, newFabOut(), fch);
    }
    if (tag == 23) {
        const r = st.ret catch fc.s.dRet;
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        const ch: List<int> = listNew();
        if (r.value != None) {
            listPush(ch, fabExpr(fc, r.value catch fc.s.dummyE));
        }
        return fabSlot(fc, 23, a, ch);
    }
    if (tag == 24 || tag == 25) {
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        return fabSlot(fc, tag, a, listNew());
    }
    if (tag == 65) {
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        const ch: List<int> = listNew();
        listPush(ch, fabBlock(fc, st.df catch fc.s.dummyB));
        return fabSlot(fc, 65, a, ch);
    }
    if (tag == 71) {
        const a = newFabOut();
        outDec(a, st.line);
        outDec(a, st.col);
        const ch: List<int> = listNew();
        listPush(ch, fabExpr(fc, st.expr catch fc.s.dummyE));
        return fabSlot(fc, 71, a, ch);
    }
    print("semamirror: fabStmt 未知 tag " + toStr(tag));
    panic("abort");
    return 0;
}

// —— 表达式（键类：id＝节点 id；遍历序＝TXB1 子序）——
function fabExpr(fc: Ref<FabCtx>, e: Ref<Expr>): int {
    const tag = e.tag;
    const a = newFabOut();
    const ch: List<int> = listNew();
    if (tag == 26 || tag == 27 || tag == 28) {
        outStr(a, fc.s.cur, e.s0);
        outDec(a, e.line);
        outDec(a, e.col);
    } else if (tag == 29) {
        outDec(a, e.i0);
        outDec(a, e.line);
        outDec(a, e.col);
    } else if (tag == 30) {
        outDec(a, e.line);
        outDec(a, e.col);
    } else if (tag == 31) {
        outStr(a, fc.s.cur, e.s0);
        outDec(a, e.line);
        outDec(a, e.col);
    } else if (tag == 32) {
        outDec(a, e.i0);
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
        listPush(ch, fabExpr(fc, e.b catch fc.s.dummyE));
    } else if (tag == 33) {
        outDec(a, e.i0);
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
    } else if (tag == 34) {
        outDec(a, e.line);
        outDec(a, e.col);
        if (listLen(e.targs) > 0) {
            const ta = newFabOut();
            outDec(ta, listLen(e.targs));
            const tc: List<int> = listNew();
            let ti: int = 0;
            while (ti < listLen(e.targs)) {
                listPush(tc, fabTe(fc, listGet(e.targs, ti) catch fc.s.dummyTe));
                ti = ti + 1;
            }
            listPush(ch, fabSlot(fc, 63, ta, tc));
        }
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
        let ai: int = 0;
        while (ai < listLen(e.list)) {
            listPush(ch, fabExpr(fc, listGet(e.list, ai) catch fc.s.dummyE));
            ai = ai + 1;
        }
    } else if (tag == 35) {
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
        listPush(ch, fabExpr(fc, e.b catch fc.s.dummyE));
    } else if (tag == 36) {
        outStr(a, fc.s.cur, e.s0);
        outDec(a, e.line);
        outDec(a, e.col);
        outDec(a, e.i1);
        outDec(a, e.i2);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
    } else if (tag == 37) {
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
    } else if (tag == 38) {
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
        listPush(ch, fabTe(fc, e.ty catch fc.s.dummyTe));
    } else if (tag == 39) {
        const cb = e.cb catch fc.s.dCatch;
        if (cb.hasBinding) {
            outDec(a, 1);
            outStr(a, fc.s.cur, cb.binding);
        } else {
            outDec(a, 0);
        }
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, cb.operand));
        const ha = newFabOut();
        const hc: List<int> = listNew();
        if (cb.isBlock) {
            listPush(hc, fabBlock(fc, cb.hBlock catch fc.s.dummyB));
        } else {
            listPush(hc, fabExpr(fc, cb.hExpr catch fc.s.dummyE));
        }
        listPush(ch, fabSlot(fc, 40, ha, hc));
    } else if (tag == 41) {
        const lit = e.lit catch fc.s.dLit;
        if (lit.hasHint) {
            outDec(a, 1);
            outStr(a, fc.s.cur, lit.hint);
        } else {
            outDec(a, 0);
        }
        outDec(a, lit.hintLine);
        outDec(a, lit.hintCol);
        if (listLen(lit.targs) > 0) {
            const ta = newFabOut();
            outDec(ta, listLen(lit.targs));
            const tc: List<int> = listNew();
            let ti: int = 0;
            while (ti < listLen(lit.targs)) {
                listPush(tc, fabTe(fc, listGet(lit.targs, ti) catch fc.s.dummyTe));
                ti = ti + 1;
            }
            listPush(ch, fabSlot(fc, 63, ta, tc));
        }
        let fi: int = 0;
        while (fi < listLen(lit.fnames)) {
            const fa = newFabOut();
            outStr(fa, fc.s.cur, listGet(lit.fnames, fi) catch "");
            const fcvals: List<int> = listNew();
            listPush(fcvals, fabExpr(fc, listGet(lit.fvals, fi) catch fc.s.dummyE));
            listPush(ch, fabSlot(fc, 42, fa, fcvals));
            fi = fi + 1;
        }
    } else if (tag == 43) {
        outDec(a, e.line);
        outDec(a, e.col);
        let i: int = 0;
        while (i < listLen(e.list)) {
            listPush(ch, fabExpr(fc, listGet(e.list, i) catch fc.s.dummyE));
            i = i + 1;
        }
    } else if (tag == 44) {
        outDec(a, e.line);
        outDec(a, e.col);
        const nb = e.nb catch fc.s.dNew;
        if (nb.isVariant) {
            const va = newFabOut();
            outStr(va, fc.s.cur, nb.enumName);
            outStr(va, fc.s.cur, nb.varName);
            outDec(va, nb.vline);
            outDec(va, nb.vcol);
            const vc: List<int> = listNew();
            let i2: int = 0;
            while (i2 < listLen(nb.args)) {
                listPush(vc, fabExpr(fc, listGet(nb.args, i2) catch fc.s.dummyE));
                i2 = i2 + 1;
            }
            listPush(ch, fabSlot(fc, 45, va, vc));
        } else {
            listPush(ch, fabExpr(fc, nb.lit catch fc.s.dummyE));
        }
    } else if (tag == 46) {
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
        let ai: int = 0;
        while (ai < listLen(e.arms)) {
            listPush(ch, fabArm(fc, listGet(e.arms, ai) catch fc.s.dArm));
            ai = ai + 1;
        }
    } else if (tag == 49) {
        const af = e.af catch fc.s.dArrow;
        if (af.isAsync) {
            outDec(a, 1);
        } else {
            outDec(a, 0);
        }
        outDec(a, af.line);
        outDec(a, af.col);
        let pi: int = 0;
        while (pi < listLen(af.params)) {
            listPush(ch, fabParam(fc, listGet(af.params, pi) catch fc.s.dummyParam));
            pi = pi + 1;
        }
        const ra = newFabOut();
        const rc: List<int> = listNew();
        listPush(rc, fabTe(fc, af.ret));
        listPush(ch, fabSlot(fc, 3, ra, rc));
        const ba = newFabOut();
        const bc: List<int> = listNew();
        if (af.isBlock) {
            listPush(bc, fabBlock(fc, af.bodyBlock catch fc.s.dummyB));
        } else {
            listPush(bc, fabExpr(fc, af.bodyExpr catch fc.s.dummyE));
        }
        listPush(ch, fabSlot(fc, 50, ba, bc));
    } else if (tag == 51) {
        outDec(a, e.line);
        outDec(a, e.col);
        listPush(ch, fabExpr(fc, e.a catch fc.s.dummyE));
    } else {
        print("semamirror: fabExpr 未知 tag " + toStr(tag));
        panic("abort");
    }
    return fabKeyVisit(fc, e.id, tag, a, ch);
}

function fabArm(fc: Ref<FabCtx>, arm: Ref<Arm>): int {
    const a = newFabOut();
    if (arm.isElse) {
        outDec(a, 1);
        outStr(a, fc.s.cur, "");
    } else {
        outDec(a, 0);
        outStr(a, fc.s.cur, arm.vname);
    }
    outDec(a, arm.line);
    outDec(a, arm.col);
    const ch: List<int> = listNew();
    let i: int = 0;
    while (i < listLen(arm.patfs)) {
        const pa = newFabOut();
        outStr(pa, fc.s.cur, listGet(arm.patfs, i) catch "");
        listPush(ch, fabSlot(fc, 48, pa, listNew()));
        i = i + 1;
    }
    listPush(ch, fabExpr(fc, arm.body));
    return fabKeyVisit(fc, arm.id, 47, a, ch);
}

// —— 声明（根集①）——
function fabDecl(fc: Ref<FabCtx>, d: Ref<Decl>): int {
    const tag = d.tag;
    if (tag == 10) {
        const a = newFabOut();
        outDec(a, listLen(d.impNames));
        let i: int = 0;
        while (i < listLen(d.impNames)) {
            outStr(a, fc.s.cur, listGet(d.impNames, i) catch "");
            i = i + 1;
        }
        outStr(a, fc.s.cur, d.impPath);
        outDec(a, d.impLine);
        outDec(a, d.impCol);
        return fabSlot(fc, 10, a, listNew());
    }
    if (tag == 1) {
        if (d.fn != None) {
            return fabFn(fc, d.fn catch fc.s.dummyF);
        }
        const x = d.ext catch fc.s.dExDecl;
        const a = newFabOut();
        outStr(a, fc.s.cur, x.name);
        outDec(a, 0);
        outDec(a, 0);
        outDec(a, 1);
        outDec(a, x.line);
        outDec(a, x.col);
        const ch: List<int> = listNew();
        let i: int = 0;
        while (i < listLen(x.params)) {
            listPush(ch, fabParam(fc, listGet(x.params, i) catch fc.s.dummyParam));
            i = i + 1;
        }
        const ra = newFabOut();
        const rc: List<int> = listNew();
        listPush(rc, fabTe(fc, x.ret));
        listPush(ch, fabSlot(fc, 3, ra, rc));
        return fabSlot(fc, 1, a, ch);
    }
    if (tag == 5) {
        const sd = d.sd catch fc.s.dSd;
        const a = newFabOut();
        outStr(a, fc.s.cur, sd.name);
        outDec(a, b2i(sd.exported));
        outDec(a, sd.line);
        outDec(a, sd.col);
        const ch: List<int> = listNew();
        if (listLen(sd.tps) > 0) {
            listPush(ch, fabTparams(fc, sd.tps));
        }
        let i: int = 0;
        while (i < listLen(sd.fnames)) {
            const fa = newFabOut();
            outStr(fa, fc.s.cur, listGet(sd.fnames, i) catch "");
            const ftc: List<int> = listNew();
            listPush(ftc, fabTe(fc, listGet(sd.ftes, i) catch fc.s.dummyTe));
            listPush(ch, fabSlot(fc, 6, fa, ftc));
            i = i + 1;
        }
        return fabSlot(fc, 5, a, ch);
    }
    if (tag == 7) {
        const ed = d.ed catch fc.s.dEd;
        const a = newFabOut();
        outStr(a, fc.s.cur, ed.name);
        outDec(a, b2i(ed.exported));
        outDec(a, ed.line);
        outDec(a, ed.col);
        const ch: List<int> = listNew();
        let i: int = 0;
        while (i < listLen(ed.vars)) {
            const vd = listGet(ed.vars, i) catch fc.s.dVd;
            const va = newFabOut();
            outStr(va, fc.s.cur, vd.name);
            const vc: List<int> = listNew();
            let j: int = 0;
            while (j < listLen(vd.fnames)) {
                const fa2 = newFabOut();
                outStr(fa2, fc.s.cur, listGet(vd.fnames, j) catch "");
                const ftc2: List<int> = listNew();
                listPush(ftc2, fabTe(fc, listGet(vd.ftes, j) catch fc.s.dummyTe));
                listPush(vc, fabSlot(fc, 6, fa2, ftc2));
                j = j + 1;
            }
            listPush(ch, fabSlot(fc, 8, va, vc));
            i = i + 1;
        }
        return fabSlot(fc, 7, a, ch);
    }
    if (tag == 9) {
        const td = d.td catch fc.s.dTest;
        const a = newFabOut();
        outStr(a, fc.s.cur, td.name);
        outDec(a, td.line);
        outDec(a, td.col);
        const ch: List<int> = listNew();
        listPush(ch, fabBlock(fc, td.body));
        return fabSlot(fc, 9, a, ch);
    }
    if (tag == 11 || tag == 12) {
        return fabBinding(fc, d.bd catch fc.s.dBd);
    }
    print("semamirror: fabDecl 未知 tag " + toStr(tag));
    panic("abort");
    return 0;
}

function fabFn(fc: Ref<FabCtx>, f: Ref<FnDecl>): int {
    const a = newFabOut();
    outStr(a, fc.s.cur, f.name);
    outDec(a, b2i(f.exported));
    outDec(a, b2i(f.isAsync));
    outDec(a, 0);
    outDec(a, f.line);
    outDec(a, f.col);
    const ch: List<int> = listNew();
    if (listLen(f.tps) > 0) {
        listPush(ch, fabTparams(fc, f.tps));
    }
    let i: int = 0;
    while (i < listLen(f.params)) {
        listPush(ch, fabParam(fc, listGet(f.params, i) catch fc.s.dummyParam));
        i = i + 1;
    }
    if (f.ret != None) {
        const ra = newFabOut();
        const rc: List<int> = listNew();
        listPush(rc, fabTe(fc, f.ret catch fc.s.dummyTe));
        listPush(ch, fabSlot(fc, 3, ra, rc));
    }
    listPush(ch, fabBlock(fc, f.body));
    return fabKeyVisit(fc, f.id, 1, a, ch);
}

// 主入口：sema 终态树 → FAB1 v1 字节串（ASCII；sebin 同编码域）。
function emitFab1(s: Ref<Sm>): string {
    const head = newFabOut();
    outRaw(head, "FAB1 ");
    outDec(head, 1);
    outDec(head, listLen(s.mods));
    const bodies: List<string> = listNew();
    // 键类 ID 位于 [0, synNext)；按模块代次复用索引，避免每模块全量清零。
    const marked: List<int> = listNew();
    let markI: int = 0;
    while (markI < s.synNext) {
        listPush(marked, 0);
        markI = markI + 1;
    }
    let mi: int = 0;
    while (mi < listLen(s.mods)) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        const fc = newFabCtx(s, marked, mi + 1);
        // 根集①：终态树全部顶层 decl 根（声明序）。
        let i: int = 0;
        while (i < listLen(m.decls)) {
            const rd = listGet(m.decls, i) catch s.dDecl;
            if (rd.tag != 68 && rd.tag != 73) { listPush(fc.roots, fabDecl(fc, rd)); }
            i = i + 1;
        }
        // 根集②：合成 FnDecl 根（fn_table 序；键 id 未发者＝不可自解析树到达）。
        let fi: int = 0;
        while (fi < listLen(s.fns)) {
            const fe = listGet(s.fns, fi) catch s.dummyFE;
            if (fe.module_idx == m.idx) {
                const decl = fe.decl;
                if (!fabSeen(fc, decl.id)) {
                    listPush(fc.roots, fabFn(fc, decl));
                }
            }
            fi = fi + 1;
        }
        // 模块段：idx＋根表＋记录束。
        const seg = newFabOut();
        outDec(seg, m.idx);
        outDec(seg, listLen(fc.roots));
        let r: int = 0;
        while (r < listLen(fc.roots)) {
            outDec(seg, listGet(fc.roots, r) catch 0);
            r = r + 1;
        }
        outDec(seg, listLen(fc.recs));
        let q: int = 0;
        while (q < listLen(fc.recs)) {
            outRaw(seg, listGet(fc.recs, q) catch "");
            q = q + 1;
        }
        listPush(bodies, joinRange(seg.parts, 0, listLen(seg.parts)));
        mi = mi + 1;
    }
    const parts: List<string> = listNew();
    let k: int = 0;
    while (k < listLen(head.parts)) {
        listPush(parts, listGet(head.parts, k) catch "");
        k = k + 1;
    }
    k = 0;
    while (k < listLen(bodies)) {
        listPush(parts, listGet(bodies, k) catch "");
        k = k + 1;
    }
    return joinRange(parts, 0, listLen(parts));
}
// ============================================================================
// §7 入口
// ============================================================================

// DFS 读序基座分配（入口先读；每个 import 声明依声明序递归——零诊断负载
// 下 resolved_imports 与 import 声明一一对应）。
function dfsBases(s: Ref<Sm>, modIns: List<Ref<ModIn>>, mi: int, bases: List<int>, visited: List<int>, accBox: List<int>): void {
    if ((listGet(visited, mi) catch 0) != 0) { return; }
    listSet(visited, mi, 1);
    listSet(bases, mi, listGet(accBox, 0) catch 0);
    listSet(accBox, 0, (listGet(accBox, 0) catch 0) + (listGet(modIns, mi) catch s.dModIn).nodeCount);
    const m = listGet(modIns, mi) catch s.dModIn;
    let j: int = 0;
    const nj = listLen(m.impTargets);
    while (j < nj) {
        dfsBases(s, modIns, listGet(m.impTargets, j) catch 0, bases, visited, accBox);
        j = j + 1;
    }
}

// —— 库化面（V0.50-S5-① 批 E；D102 §一——六柱库化）：mirrorSein 吃 SEIN1
// 容器文本，产出存模块态（smSeb1/smFab1），getter 取用——驱动侧
// bootstrap/taixu.tx 经 import 进程内编排（loadGraph→SEIN→semamirror→
// loader→codegen→serialize 的 .tx 侧）。发射面零改动（emitSeb1/emitFab1
// 原样）；main 委托本函数（文件 IO 留在 main＝VM 执行形态不变）。
let smSeb1: string = "";
let smFab1: string = "";
let smOk: int = 0;

function smAnalysisDecls(s: Ref<Sm>, mi: int, input: Ref<ModIn>, normalBase: int): List<Ref<Decl>> {
    if (smCacheRun == None) { return readTxModule(input.astbin, normalBase); }
    const run = smCacheCurrent(); const m = smCacheAt(run, mi);
    if ((listGet(run.dirty, mi) catch 1) != 0) {
        run.cache.decoded = run.cache.decoded + 1;
        return readTxModule(input.astbin, m.base);
    }
    return smCacheHeaders(s, m.decls);
}

function smAnalyze(modIns: List<Ref<ModIn>>): Ref<Sm> {
    const s = newSm();
    // —— 模块基座＝LOAD 读序（入口先读、导入递归随后的 DFS 先序）累积——
    // oracle 注册表 module_base 随读序推进（compiler.zig registry 段），
    // 与 sema.modules 拓扑展示序分立；SEIN 容器按拓扑序陈列，读序自此重构。
    const n = listLen(modIns);
    const bases: List<int> = listNew();
    const visited: List<int> = listNew();
    let vi: int = 0;
    while (vi < n) {
        listPush(bases, 0);
        listPush(visited, 0);
        vi = vi + 1;
    }
    const accBox: List<int> = listNew();
    listPush(accBox, 0);
    dfsBases(s, modIns, n - 1, bases, visited, accBox);
    // D3 v0.20：编译器自带 prelude 不经任何 import 到达，基座排在其后。
    let ui: int = 0;
    while (ui < n) {
        if ((listGet(visited, ui) catch 1) == 0) { dfsBases(s, modIns, ui, bases, visited, accBox); }
        ui = ui + 1;
    }
    if (smCacheRun != None) {
        const run = smCacheCurrent(); run.normalBases = bases; run.normalTotal = listGet(accBox, 0) catch 0;
    }
    // —— 物化——
    let i: int = 0;
    while (i < n) {
        const min = listGet(modIns, i) catch s.dModIn;
        const base = listGet(bases, i) catch 0;
        const decls = smAnalysisDecls(s, i, min, base);
        const m = new Mod { idx: i, display: min.display, nodeCount: min.nodeCount, decls: decls, symNames: listNew(), symVals: listNew(), symIdx: listNew(), symNext: listNew(), globals: listNew(), gTys: listNew(), gSlots: listNew(), initCap: 1, impSpecs: min.impSpecs, impTargets: min.impTargets, std: min.std };
        listPush(s.mods, m);
        i = i + 1;
    }
    // 合成基座＝Σ各模块解析节点数（V0.42-B1-④ 接线定稿；D91 §7.2 校准项
    // "接线修正（基座起算）须双侧同批"——accBox 终值＝DFS 读序累积总量，
    // 与 oracle 侧 compiler.zig syn_base＝module_base 终值同构；合成键域
    // [Σ解析, Σ解析＋合成数) 与解析键域 [0, Σ解析) 互斥——SEB1 全表键
    // 程序级唯一，for-in/闭包/泛型混合负载同键双条目形态随之消除）。
    s.synNext = listGet(accBox, 0) catch 0;
    if (smCacheRun != None) { s.synNext = smCacheCurrent().synBase; }
    s.entryModule = n - 1;
    registerModules(s);
    importPrelude(s, false);
    checkModules(s);
    return s;
}

// Sm.tys 在断边期间保活所有正式类型。结果只含独立字符串或平面记录，不再借用类型图。
function smReleaseTypes(s: Ref<Sm>): void {
    smReleaseTypeRange(s, 0);
}

function smReleaseTypeRange(s: Ref<Sm>, first: int): void {
    let i = first;
    while (i < listLen(s.tys)) {
        const t = listGet(s.tys, i) catch s.dT;
        t.inner = None;
        t.elem = None;
        t.si = None;
        t.ei = None;
        t.sig = None;
        i = i + 1;
    }
}

export function mirrorSein(data: string): int {
    const s = smAnalyze(parseSein(data));
    smSeb1 = emitSeb1(s);
    smFab1 = emitFab1(s);
    smReleaseTypes(s);
    smOk = 1;
    return 0;
}

function smCheckEmbedResults(s: Ref<Sm>): List<Ref<CheckEmbed>> {
    const out: List<Ref<CheckEmbed>> = listNew();
    if (listLen(smCheckEmbeds) == 0) { return out; }
    sortRows(s, smCheckEmbeds);
    compactRows(s, smCheckEmbeds);
    sortRows(s, s.tExprRes);
    compactRows(s, s.tExprRes);
    let k = 0;
    for (e in smCheckEmbeds) {
        while (k < listLen(s.tExprRes) && (listGet(s.tExprRes, k) catch s.dummyRow).k < e.k) { k = k + 1; }
        const r = listGet(s.tExprRes, k) catch s.dummyRow;
        if (r.k == e.k && r.a0 == 3 && r.a1 == 47 && e.a3 >= 0) {
            listPush(smCheckFinal, mkRow(e.a5, e.a0, e.a1, e.a2, e.a3, e.a4, e.k));
        }
    }
    sortRows(s, smCheckFinal);
    for (e in smCheckFinal) {
        listPush(out, new CheckEmbed { module: e.a0, line: e.a1, col: e.a2, raw: listGet(smCheckRaws, e.a3) catch "" });
    }
    return out;
}

// 进程内检查：与 mirrorSein 共用完整语义分析，输出不经 SEIN/SEB1/FAB1 文本。
export function mirrorCheck(inputs: List<Ref<CheckModule>>, flags: int): Ref<CheckResult> {
    return mirrorCheckRun(inputs, flags, "", None);
}

export function mirrorCheckCached(inputs: List<Ref<CheckModule>>, flags: int, tag: string, cache: Ref<SmCheckCache>): Ref<CheckResult> {
    if ((flags & 8) != 0) {
        cache.total = listLen(inputs); cache.decoded = cache.total; cache.checked = cache.total;
        return mirrorCheck(inputs, flags);
    }
    return mirrorCheckRun(inputs, flags, tag, cache);
}

function mirrorCheckRun(inputs: List<Ref<CheckModule>>, flags: int, tag: string, cache: Ref<SmCheckCache>?): Ref<CheckResult> {
    const ins: List<Ref<ModIn>> = listNew();
    for (m in inputs) {
        listPush(ins, new ModIn { display: m.display, nodeCount: m.nodeCount, astbin: m.astbin, impSpecs: m.specs, impTargets: m.targets, std: m.std });
    }
    let active: Ref<SmCacheRun>? = None;
    if (cache != None) { active = smCachePrepare(cache catch smCheckCacheNew(), inputs, flags, tag); }
    let answer: Ref<CheckResult>? = None;
    while (answer == None) {
        smReset(flags); smCheckCapture = true; smCacheRun = active;
        const s = smAnalyze(ins);
        if (smCacheRun != None && smCacheCurrent().expand) {
            const run = smCacheCurrent();
            checkGraphPropagate(run.graph, run.dirty);
            run.expand = false; run.observed = checkGraphNew(listLen(run.modules)); run.origin = -1; run.phase = -1;
            run.cache.retries = run.cache.retries + 1;
            smReleaseTypes(s);
            continue;
        }
        answer = smCheckPack(s);
        if (smCacheRun != None) { smCacheCommit(flags, tag); }
        smCheckCapture = false; smCacheRun = None;
        smReleaseTypes(s);
    }
    return answer catch new CheckResult { hasMain: false, diags: listNew(), anaInts: listNew(), anaNames: listNew(),
        detInts: listNew(), detStrs: listNew(), embeds: listNew() };
}

function smCheckPack(s: Ref<Sm>): Ref<CheckResult> {
    const out = new CheckResult { hasMain: s.hasMain, diags: listNew(), anaInts: listNew(), anaNames: listNew(),
        detInts: listNew(), detStrs: listNew(), embeds: smCheckEmbedResults(s) };
    let i = 0;
    for (r in s.diagRows) {
        listPush(out.diags, new CheckDiag { code: r.k, module: r.a0, line: r.a1, col: r.a2, msg: listGet(s.diagMsgs, i) catch "" });
        i = i + 1;
    }
    for (r in anaRows) {
        listPush(out.anaInts, r.m); listPush(out.anaInts, r.l); listPush(out.anaInts, r.c);
        listPush(out.anaInts, r.how); listPush(out.anaInts, r.tt); listPush(out.anaInts, r.flags);
        listPush(out.anaInts, r.km); listPush(out.anaInts, r.kl); listPush(out.anaInts, r.kc); listPush(out.anaInts, r.kh + 1);
        listPush(out.anaNames, r.name);
    }
    for (d in anaDets) {
        listPush(out.detInts, d.m); listPush(out.detInts, d.l); listPush(out.detInts, d.c);
        listPush(out.detInts, d.how); listPush(out.detInts, d.flags);
        listPush(out.detStrs, d.name); listPush(out.detStrs, d.text);
    }
    return out;
}

export function smSeb1Out(): string { return smSeb1; }
export function smFab1Out(): string { return smFab1; }
export function smReady(): int { return smOk; }

// TXB1 顶层 import spec 提取（批 E 库化面——driver.tx 模块发现消费）。
// 返回 cp 前缀协议："n l1 spec1 l2 spec2 ..."（R3：长度域＝码点数——len 字节
// 域在中文 spec 面与消费侧 strSub 码点切片错位；两侧同域后协议自洽）。
function smCpCount(p: string): int {
    let n = 0;
    let i = 0;
    while (i < len(p)) {
        const c = byteAt(p, i) catch 0;
        n = n + 1;
        if (c >= 240) { i = i + 4; }
        else if (c >= 224) { i = i + 3; }
        else if (c >= 192) { i = i + 2; }
        else { i = i + 1; }
    }
    return n;
}

export function txImports(astbin: string): string {
    const decls = readTxModule(astbin, 0);
    const specs: List<string> = listNew();
    const lines: List<int> = listNew();
    const cols: List<int> = listNew();
    let i: int = 0;
    const n = listLen(decls);
    while (i < n) {
        const d = listGet(decls, i) catch (new Decl { tag: 0, impNames: listNew(), impPath: "", fn: None, ext: None, sd: None, ed: None, bd: None, td: None, idl: None, impLine: 0, impCol: 0, hd: None, xst: false });
        if (d.tag == 10) {
            listPush(specs, d.impPath);
            listPush(lines, d.impLine);
            listPush(cols, d.impCol);
        }
        i = i + 1;
    }
    let out: string = toStr(listLen(specs));
    i = 0;
    while (i < listLen(specs)) {
        const sp = listGet(specs, i) catch "";
        // 协议扩展：每 import 附 impLine/impCol（driver 3008/3009 诊断位置域；逐条取各自的位置）。
        out = out + " " + toStr(smCpCount(sp)) + " " + sp + " " + toStr(listGet(lines, i) catch 0) + " " + toStr(listGet(cols, i) catch 0);
        i = i + 1;
    }
    return out;
}

// D3 v0.23 按目标选择文件：模块的导出面（每个导出名一行“名字\t签名文本”），driver 比对
// x.tx、x_windows.tx、x_linux.tx 是否一致（3033）。签名按书写的类型文本比较，参数名不计。
function teText(te: Ref<Te>): string {
    const t = te.tag;
    if (t == 52) { return te.name; }
    if (t == 53) { return "Ref<" + teText(te.a catch te) + ">"; }
    if (t == 54) { return "Weak<" + teText(te.a catch te) + ">"; }
    if (t == 55) { return "List<" + teText(te.a catch te) + ">"; }
    if (t == 56) { return teText(te.a catch te) + "?"; }
    if (t == 57) { return "[]" + teText(te.a catch te); }
    if (t == 58) { return "[" + toStr(te.alen) + "]" + teText(te.a catch te); }
    if (t == 59) { return teText(te.a catch te) + " | Error"; }
    if (t == 61) { return "Future<" + teText(te.a catch te) + ">"; }
    if (t == 67) { return teText(te.a catch te) + " | " + teListText(te.ls); }
    if (t == 60) { return "(" + teListText(te.ls) + ") => " + teText(te.a catch te); }
    if (t == 62) { return te.name + "<" + teListText(te.ls) + ">"; }
    return "?";
}

function teListText(ls: List<Ref<Te>>): string {
    let acc: string = "";
    let i: int = 0;
    while (i < listLen(ls)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + teText(listGet(ls, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() });
        i = i + 1;
    }
    return acc;
}

function tpsText(tps: List<string>, tcs: List<Ref<Te>>): string {
    if (listLen(tps) == 0) { return ""; }
    let acc: string = "<";
    let i: int = 0;
    while (i < listLen(tps)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + (listGet(tps, i) catch "");
        const c = listGet(tcs, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() };
        if (c.tag != 0) { acc = acc + ": " + teText(c); }
        i = i + 1;
    }
    return acc + ">";
}

function paramsText(ps: List<Ref<Param>>): string {
    let acc: string = "(";
    let i: int = 0;
    while (i < listLen(ps)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + teText((listGet(ps, i) catch new Param { name: "", ty: new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() }, col: 0 }).ty);
        i = i + 1;
    }
    return acc + ")";
}

function fieldsText(fnames: List<string>, ftes: List<Ref<Te>>): string {
    let acc: string = "";
    let i: int = 0;
    while (i < listLen(fnames)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + (listGet(fnames, i) catch "") + ": " + teText(listGet(ftes, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() });
        i = i + 1;
    }
    return acc;
}

export function txExports(astbin: string): string {
    const decls = readTxModule(astbin, 0);
    let out: string = "";
    let i: int = 0;
    while (i < listLen(decls)) {
        const d = listGet(decls, i) catch (new Decl { tag: 0, impNames: listNew(), impPath: "", fn: None, ext: None, sd: None, ed: None, bd: None, td: None, idl: None, impLine: 0, impCol: 0, hd: None, xst: false });
        let name: string = "";
        let sig: string = "";
        if (d.tag == 1 && d.fn != None) {
            const f = d.fn catch new FnDecl { id: -1, name: "", params: listNew(), ret: None, body: new Block { id: -1, stmts: listNew() }, exported: false, isAsync: false, isGen: false, line: 0, col: 0, tps: listNew(), tcs: listNew() };
            if (f.exported) {
                name = f.name;
                sig = "function";
                if (f.isAsync) { sig = "async function"; }
                if (f.isGen) { sig = "function*"; }
                let rt: string = "void";
                if (f.ret != None) { rt = teText(f.ret catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() }); }
                sig = sig + tpsText(f.tps, f.tcs) + paramsText(f.params) + ": " + rt;
            }
        } else if (d.tag == 5) {
            const sd = d.sd catch new StructDecl { name: "", exported: false, fnames: listNew(), ftes: listNew(), tps: listNew(), tcs: listNew(), line: 0, col: 0 };
            if (sd.exported) {
                name = sd.name;
                sig = "struct";
                if (d.xst) { sig = "declare struct"; }
                sig = sig + tpsText(sd.tps, sd.tcs) + " { " + fieldsText(sd.fnames, sd.ftes) + " }";
            }
        } else if (d.tag == 7) {
            const ed = d.ed catch new EnumDecl { isErr: false, name: "", exported: false, vars: listNew(), line: 0, col: 0 };
            if (ed.exported) {
                name = ed.name;
                sig = "enum";
                if (ed.isErr) { sig = "enum extends Error"; }
                sig = sig + " {";
                let vi: int = 0;
                while (vi < listLen(ed.vars)) {
                    const vd = listGet(ed.vars, vi) catch new VarDecl { msg: None, name: "", fnames: listNew(), ftes: listNew() };
                    sig = sig + " " + vd.name + "(" + fieldsText(vd.fnames, vd.ftes) + ")";
                    vi = vi + 1;
                }
                sig = sig + " }";
            }
        } else if (d.tag == 68) {
            const idl = d.idl catch new IfaceDecl { name: "", exported: false, tps: listNew(), tcs: listNew(), mnames: listNew(), msigs: listNew(), line: 0, col: 0 };
            if (idl.exported) {
                name = idl.name;
                sig = "interface" + tpsText(idl.tps, idl.tcs) + " {";
                let mi: int = 0;
                while (mi < listLen(idl.msigs)) {
                    const ms = listGet(idl.msigs, mi) catch new ExternDecl { name: "", params: listNew(), ret: new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() }, line: 0, col: 0, fmode: 0, flib: "", fnr: 0, fline: 0, fcol: 0, nfix: -1 };
                    sig = sig + " " + ms.name + paramsText(ms.params) + ": " + teText(ms.ret) + ";";
                    mi = mi + 1;
                }
                sig = sig + " }";
            }
        } else if (d.tag == 11 || d.tag == 12) {
            const bd = d.bd catch new Binding { id: -1, isConst: false, name: "", ty: None, init: new Expr { id: -1, tag: 0, line: 0, col: 0, s0: "", s1: "", i0: 0, i1: 0, i2: 0, a: None, b: None, list: listNew(), targs: listNew(), lit: None, arms: listNew(), af: None, nb: None, cb: None, ty: None }, exported: false, line: 0, col: 0 };
            if (bd.exported) {
                name = bd.name;
                sig = "let";
                if (bd.isConst) { sig = "const"; }
                let bt: string = "?";
                if (bd.ty != None) {
                    bt = teText(bd.ty catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() });
                } else if (bd.init.tag == 26) {
                    bt = "int";
                } else if (bd.init.tag == 27) {
                    bt = "float";
                } else if (bd.init.tag == 28) {
                    bt = "string";
                } else if (bd.init.tag == 29) {
                    bt = "bool";
                }
                sig = sig + ": " + bt;
            }
        } else if (d.tag == 73) {
            const hd = d.hd catch new HandleDecl { name: "", exported: false, line: 0, col: 0 };
            if (hd.exported) {
                name = hd.name;
                sig = "declare type";
            }
        }
        if (len(name) > 0) {
            out = out + name + "\t" + sig + "\n";
        }
        i = i + 1;
    }
    return out;
}

export function main(args: []string): int {
    if (len(args) < 2) {
        print("用法: taixu run bootstrap/semamirror.tx <sein 路径> <seb1 输出路径> [fab1 输出路径]");
        return 64;
    }
    // 尾参约定（V0.42-B1-④；D91 §7.1 dev 面）：两参＝sein+SEB1（探针兼容
    // 形）；三参＝增发 FAB1（尾参）。VM args 首位是否含脚本路径皆可——末位
    // 锚定不受影响。
    let fabPath: string = "";
    let outPath: string = "";
    let seinPath: string = "";
    if (len(args) >= 3) {
        fabPath = args[len(args) - 1];
        outPath = args[len(args) - 2];
        seinPath = args[len(args) - 3];
    } else {
        seinPath = args[len(args) - 2];
        outPath = args[len(args) - 1];
    }
    const data = readFile(seinPath) catch (e) {
        print("semamirror: SEIN 读取失败: " + e.message);
        return 1;
    };
    if (mirrorSein(data) != 0) { return 1; }
    writeFile(outPath, smSeb1Out()) catch (e) {
        print("semamirror: SEB1 写出失败: " + e.message);
        return 1;
    };
    if (fabPath != "") {
        writeFile(fabPath, smFab1Out()) catch (e) {
            print("semamirror: FAB1 写出失败: " + e.message);
            return 1;
        };
    }
    return 0;
}
