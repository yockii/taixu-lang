// 进程池回归：用双向握手证明并发、用标记检查依赖与独占，另外核对大输出、失败、超时与无法满足的依赖。
import { absolute, join, list1, mkdirs, nat, plus } from "./build_lib";
import { GateResult, GateTask, gatePool } from "./gate_pool";

function strings(xs: []string): List<string> {
    const out: List<string> = listNew();
    for (x in xs) { listPush(out, x); }
    return out;
}

function exists(p: string): bool { return entryKind(p) == 1; }

function touch(p: string): void { writeFile(p, "ready") catch panic("write " + p); }

function child(args: []string): int {
    const mode = args[1];
    const dir = args[2];
    if (mode == "left" || mode == "right") {
        let peer = "left";
        if (mode == "left") { peer = "right"; }
        touch(join(dir, mode + ".running"));
        touch(join(dir, mode + ".ready"));
        const until = monoNs() + 5000000000;
        while (!exists(join(dir, peer + ".ready"))) {
            if (monoNs() > until) { return 77; }
            const tick = monoNs();
        }
        touch(join(dir, mode + ".done"));
        removeFile(join(dir, mode + ".running")) catch panic("remove running");
        print(mode);
        return 0;
    }
    if (mode == "dependent" || mode == "exclusive") {
        if (!exists(join(dir, "left.done")) || !exists(join(dir, "right.done"))) { return 78; }
        if (exists(join(dir, "left.running")) || exists(join(dir, "right.running"))) { return 79; }
        if (mode == "exclusive") {
            touch(join(dir, "exclusive.running"));
            const until = monoNs() + 50000000;
            while (monoNs() < until) { if (exists(join(dir, "output.running"))) { return 81; } }
            removeFile(join(dir, "exclusive.running")) catch panic("remove exclusive");
        }
        print(mode);
        return 0;
    }
    if (mode == "fail") { return 17; }
    if (mode == "after-fail") { print("after fail"); return 0; }
    if (mode == "wait") {
        while (true) { const tick = monoNs(); }
    }
    if (mode == "output") {
        if (exists(join(dir, "exclusive.running"))) { return 82; }
        touch(join(dir, "output.running"));
        let line = "x";
        while (len(line) < 32768) { line = line + line; }
        let i = 0;
        while (i < 32) { print(line); eprint(line); i = i + 1; }
        if (exists(join(dir, "exclusive.running"))) { return 83; }
        removeFile(join(dir, "output.running")) catch panic("remove output");
        return 0;
    }
    return 80;
}

function task(name: string, mode: string, dir: string, deps: List<string>, exclusive: bool): GateTask {
    return GateTask { name: name, exe: selfExePath(), args: strings(["--child", mode, dir]), cwd: dir, deps: deps, exclusive: exclusive };
}

struct Results {
    names: List<string>,
    values: List<Ref<GateResult>>,
}

function result(rs: Ref<Results>, name: string): Ref<GateResult> {
    let i = 0;
    while (i < listLen(rs.names)) {
        if ((listGet(rs.names, i) catch "") == name) {
            return listGet(rs.values, i) catch new GateResult { code: -1, log: bytesNew(0), elapsedMs: -1 };
        }
        i = i + 1;
    }
    return new GateResult { code: -1, log: bytesNew(0), elapsedMs: -1 };
}

function run(args: []string): int {
    let work = "";
    let i = 0;
    while (i < len(args)) {
        if (i + 1 >= len(args)) { return 2; }
        if (args[i] == "--work") { work = args[i + 1]; }
        else if (args[i] != "--compiler") { return 2; }
        i = i + 2;
    }
    if (len(work) == 0) { return 2; }
    const dir = join(absolute(work), "pool-" + toStr(monoNs()));
    if (!mkdirs(dir)) { return 2; }
    const tasks: List<GateTask> = listNew();
    listPush(tasks, task("left", "left", dir, listNew(), false));
    listPush(tasks, task("right", "right", dir, listNew(), false));
    listPush(tasks, task("dependent", "dependent", dir, strings(["left", "right"]), false));
    listPush(tasks, task("exclusive", "exclusive", dir, listNew(), true));
    listPush(tasks, task("output", "output", dir, listNew(), false));
    listPush(tasks, task("fail", "fail", dir, listNew(), false));
    listPush(tasks, task("after-fail", "after-fail", dir, list1("fail"), false));
    const results = new Results { names: listNew(), values: listNew() };
    const complete = (name: string, r: Ref<GateResult>): void => { listPush(results.names, name); listPush(results.values, r); };
    gatePool(tasks, 2, dir, listNew(), 10000000000, 1000000000, complete);
    let failures = 0;
    for (t in tasks) {
        const r = result(results, t.name);
        let want = 0;
        if (t.name == "fail") { want = 17; }
        let ok = r.code == want && r.elapsedMs >= 0;
        if (t.name == "output") { ok = ok && bytesLen(r.log) == 64 * 32769; }
        if (!ok) { failures = failures + 1; eprint("FAIL " + t.name + " exit=" + toStr(r.code) + " log=" + toStr(bytesLen(r.log))); }
        else { print("PASS " + t.name); }
    }
    const timeoutTasks: List<GateTask> = listNew();
    listPush(timeoutTasks, task("timeout", "wait", dir, listNew(), false));
    listPush(timeoutTasks, GateTask { name: "missing", exe: join(dir, "missing-executable"), args: listNew(), cwd: dir, deps: listNew(), exclusive: false });
    listPush(timeoutTasks, task("blocked", "fail", dir, list1("absent-dependency"), false));
    gatePool(timeoutTasks, 2, dir, listNew(), 200000000, 1000000000, complete);
    for (t in timeoutTasks) {
        const r = result(results, t.name);
        if (r.code != 1 || bytesLen(r.log) == 0) { failures = failures + 1; eprint("FAIL " + t.name); }
        else { print("PASS " + t.name); }
    }
    print("SUMMARY gate-pool 10 checks, failures=" + toStr(failures));
    if (failures > 0) { return 1; }
    return 0;
}

export function main(args: []string): int {
    if (len(args) >= 3 && args[0] == "--child") { return child(args); }
    return run(args);
}
