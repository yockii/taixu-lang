function mk(): List<int> {
    const xs: List<int> = listNew();
    listPush(xs, 10);
    listPush(xs, 20);
    return xs;
}
function main(args: []string): int {
    const (a, b, c) = mk();
    let (u, v) = mk();
    const w: int? = None;
    const x: int = (a ?? -1) + (c ?? 0) + (w ?? 7);
    u = u ?? 0;
    print(toStr(x));
    print(toStr(u ?? -1));
    print(toStr(v ?? -1));
    return 0;
}
