// form —— 表单样例（表单组合；升级：右列页签
// 分组〔help 滚动帮助／data 数据表格〕——table/tab 控件＋列宽拖拽＋行选中。
// 布局全部由窗口尺寸派生（resize 即失效重排——默认零手写自适应）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/form-check.txt taixu run examples/form.tx
// 交互重放七条（checkbox/scroll/input/modal/mods/table/col-drag）见 tests/。
import { Canvas, canvasNew, ProgressBar, Checkbox, RadioGroup, Dropdown, Input, Button, ScrollView, Tooltip, MessageBox, TabBar, Table, TableRow, tabBar, table, tableRow, checkbox, radioGroup, dropdown, groupBox, button, input, scrollView, tooltip, messageBox, progress, drawCheckbox, drawRadioGroup, drawDropdown, drawDropdownList, drawProgress, drawInputC, drawButtonC, drawSeparator, drawGroupBox, drawMultiline, scrollDraw, drawModal, drawTooltip, drawTabBar, drawTable, inputValue, paintText, paintTextWidth, paintFillRect } from "gui/components";
import { App, appNew, appClose, pump, hitZone, onCheck, onRadioSelect, onDropdownSelect, onResize, inputOnKeys, scrollOnEvents, onTabSelect, onTableEvents, onClick, tooltipTick, isHover, syncFocus, modalOpen, textCursor, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_CB: int = 1;
const ID_RG: int = 2;
const ID_DD: int = 3;
const ID_IN: int = 4;
const ID_GO: int = 5;
const ID_SV: int = 6;
const ID_TAB: int = 8;
const ID_TBL: int = 9;

struct Model {
    cb: Ref<Checkbox>,
    rg: Ref<RadioGroup>,
    dd: Ref<Dropdown>,
    inp: Ref<Input>,
    pg: Ref<ProgressBar>,
    go: Ref<Button>,
    sv: Ref<ScrollView>,
    tt: Ref<Tooltip>,
    tb: Ref<TabBar>,
    tbl: Ref<Table>,
    modal_result: int,
    surface: int, // 经 Ref 持有——onResize 闭包按值捕获，须过引用改写
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    const w: int = app.w;
    const h: int = app.h;
    surfaceClear(cv.h, 0x202040);
    // 左列：表单区（几何随 w/h 派生——resize 自适应）。
    const colW: int = w / 2 - 12;
    const gb = groupBox(0, 8, 8, colW, h - 16, "profile");
    drawGroupBox(cv, gb);
    m.cb.x = 16;
    m.cb.y = 26;
    drawCheckbox(cv, m.cb);
    m.rg.x = 16;
    m.rg.y = 46;
    drawRadioGroup(cv, m.rg);
    m.dd.x = 50;
    m.dd.y = 96;
    m.dd.w = colW - 50;
    drawDropdown(cv, m.dd);
    paintText(cv, 16, 100, 0xD8DCE8, "主题");
    m.inp.x = 50;
    m.inp.y = 124;
    m.inp.w = colW - 50;
    syncFocus(app, m.inp);
    drawInputC(cv, m.inp);
    paintText(cv, 16, 128, 0xD8DCE8, "名字");
    m.pg.x = 50;
    m.pg.y = 152;
    m.pg.w = colW - 50;
    drawProgress(cv, m.pg);
    paintText(cv, 16, 151, 0xD8DCE8, "进度");
    m.go.x = colW - 68;
    m.go.y = 180;
    m.go.hovered = isHover(app, ID_GO);
    drawButtonC(cv, m.go);
    drawSeparator(cv, 16, m.go.y + 28, colW - 16);
    // 右列：页签分组——help＝滚动帮助，data＝数据表格。
    const rx: int = w / 2 + 4;
    const rw: int = w - rx - 8;
    const ry: int = 8;
    const rh: int = h - 16;
    m.tb.x = rx;
    m.tb.y = ry;
    m.tb.w = rw;
    drawTabBar(cv, m.tb);
    const bodyY: int = ry + 22;
    const bodyH: int = rh - 22;
    if (m.tb.active == 0) {
        m.sv.x = rx;
        m.sv.y = bodyY;
        m.sv.w = rw;
        m.sv.h = bodyH;
        scrollDraw(cv, m.sv, (child: Ref<Canvas>): void => {
                drawMultiline(child, 6, 6, m.sv.w - 24, 18, "taixu form demo. fill the fields, then submit. checkbox toggles, radio picks one plan, dropdown picks a theme, input takes your name, progress shows completion. drag the scrollbar to read more text here.", 0xE0E0E0);
            });
    } else {
        m.tbl.x = rx;
        m.tbl.y = bodyY;
        m.tbl.w = rw;
        m.tbl.h = bodyH;
        drawTable(cv, m.tbl);
    }
    // tooltip（模态未激活且 hover 达阈值——帧钟计数确定性）。
    if (!app.modal.active && tooltipTick(app, m.tt)) {
        drawTooltip(cv, m.tt);
    }
    // 浮层位（后绘在上）：下拉展开列表 → 模态（v0.1.4 反馈 #5——展开列表
    // 被渲染序在后的组件覆盖的根治；hitDropdown 命中面不变）。
    drawDropdownList(cv, m.dd);
    // app-drawn 模态（激活期盖绘——pump 拦截一切事件）。
    if (app.modal.active) {
        drawModal(cv, app.modal);
    }
}

export function main(args: []string): int {
    args;
    const spec = defaultSpec("taixu form", 320, 220);
    const app = appNew(spec);
    const plans: List<string> = listNew();
    listPush(plans, "free");
    listPush(plans, "pro");
    listPush(plans, "team");
    const themes: List<string> = listNew();
    listPush(themes, "dark");
    listPush(themes, "light");
    // 表格数据（plan/price/seats——三列三行）。
    const cols: List<string> = listNew();
    listPush(cols, "plan");
    listPush(cols, "price");
    listPush(cols, "seats");
    const colWs: List<int> = listNew();
    listPush(colWs, 48);
    listPush(colWs, 44);
    listPush(colWs, 44);
    const rows: List<Ref<TableRow>> = listNew();
    const r0cells: List<string> = listNew();
    listPush(r0cells, "free");
    listPush(r0cells, "$0");
    listPush(r0cells, "1");
    listPush(rows, tableRow(r0cells));
    const r1cells: List<string> = listNew();
    listPush(r1cells, "pro");
    listPush(r1cells, "$12");
    listPush(r1cells, "5");
    listPush(rows, tableRow(r1cells));
    const r2cells: List<string> = listNew();
    listPush(r2cells, "team");
    listPush(r2cells, "$49");
    listPush(r2cells, "20");
    listPush(rows, tableRow(r2cells));
    const tabs: List<string> = listNew();
    listPush(tabs, "help");
    listPush(tabs, "data");
    const m: Ref<Model> = new Model {
        cb: checkbox(ID_CB, 0, 0, "订阅更新", false),
        rg: radioGroup(ID_RG, 0, 0, plans, 0),
        dd: dropdown(ID_DD, 0, 0, 120, themes, 0),
        inp: input(ID_IN, 0, 0, 120, ""),
        pg: progress(7, 0, 0, 120, 1, 4),
        go: button(ID_GO, 0, 0, 60, 20, "提交"),
        sv: scrollView(ID_SV, 0, 0, 100, 100, 260),
        tt: tooltip("提交表单", 3),
        tb: tabBar(ID_TAB, 0, 0, 100, tabs, 0),
        tbl: table(ID_TBL, 0, 0, 100, 100, cols, colWs),
        modal_result: -1,
        surface: 0,
    };
    // tooltip 绑定提交钮（v0.1.4 反馈 #9——提示只在 hover 目标控件时出现；
    // 旧行为对 input/select/右列等任意 hover 组件都弹"提交表单"）。
    m.tt.target = ID_GO;
    listPush(m.tbl.rows, listTryGet(rows, 0) catch tableRow(listNew()));
    listPush(m.tbl.rows, listTryGet(rows, 1) catch tableRow(listNew()));
    listPush(m.tbl.rows, listTryGet(rows, 2) catch tableRow(listNew()));
    m.surface = surfaceOpen(spec.w, spec.h) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    // resize 即失效：surface 随新客户区重建（counter 先例——像素一致模型下
    // 客户区像素＝app.w/h，surface 恒随行；v0.1.4 反馈 #5 白边根治）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpen(w, h) catch 0;
        });
    // 事件装配（pump 三通道分诊；翻转/互斥/展开回填/键入/滚动/
    // 页签切换/表格行选与列宽拖拽全部框架承担，app 只留业务响应位）。
    onCheck(app, m.cb, (on: bool): void => {});
    onRadioSelect(app, m.rg, (idx: int): void => {});
    onDropdownSelect(app, m.dd, (idx: int): void => {});
    textCursor(app, ID_IN);
    inputOnKeys(app, m.inp, (v: string): void => {
            m.pg.value = len(v);
            if (m.pg.value > 4) {
                m.pg.value = 4;
            }
        });
    scrollOnEvents(app, m.sv, (sy: int): void => {});
    onTabSelect(app, m.tb, (idx: int): void => {});
    onTableEvents(app, m.tbl, (row: int): void => {});
    onClick(app, ID_GO, (rec: EventRecord): void => {
            if (rec.kind != 3) {
                return;
            }
            const name: string = inputValue(m.inp);
            const btns: List<string> = listNew();
            if (len(name) == 0) {
                listPush(btns, "ok");
                modalOpen(app, messageBox("error", "name is required", btns));
            } else {
                listPush(btns, "ok");
                listPush(btns, "cancel");
                modalOpen(app, messageBox("saved", "welcome, " + name, btns));
            }
        });
    // 模态结果观测（按钮下标经 pump modalConsume 写回 active 前）。
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.modal.active == false && app.modal.result >= 0 && m.modal_result < 0) {
            m.modal_result = app.modal.result;
        }
        if (app.dirty) {
            const cv = textCanvas(m.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, m);
            // 真窗通道命中区随帧更新（布局后登记；文本宽度走真实轨度量）。
            // v0.1.4 反馈 #6 根治：dd 命中区按**当前开合态**注册——固定按展开
            // 态注册时 96..146 把输入框（124..142）整个罩住且注册在前，
            // resolveHit 先命中 dd——真窗点击输入框永远点中下拉（无头重放
            // 走 target=id 通道不经过命中扫描，故 17 案全绿未拦）。
            hitZone(app, ID_CB, m.cb.x, m.cb.y, 24 + paintTextWidth(cv, m.cb.label), 16);
            hitZone(app, ID_RG, m.rg.x, m.rg.y, 120, 3 * 16);
            let ddh: int = 18;
            if (m.dd.open) {
                ddh = 18 + listLen(m.dd.items) * 16;
            }
            hitZone(app, ID_DD, m.dd.x, m.dd.y, m.dd.w, ddh);
            hitZone(app, ID_IN, m.inp.x, m.inp.y, m.inp.w, 18);
            hitZone(app, ID_GO, m.go.x, m.go.y, m.go.w, m.go.h);
            hitZone(app, ID_SV, m.sv.x, m.sv.y, m.sv.w, m.sv.h);
            hitZone(app, ID_TAB, m.tb.x, m.tb.y, m.tb.w, 18);
            hitZone(app, ID_TBL, m.tbl.x, m.tbl.y, m.tbl.w, m.tbl.h);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    const cw1: int = listTryGet(m.tbl.col_ws, 1) catch 0;
    print("chk=" + toStr(m.cb.checked) + " radio=" + toStr(m.rg.selected) + " dd=" + toStr(m.dd.selected) + " name=" + inputValue(m.inp) + " pg=" + toStr(m.pg.value) + " scroll=" + toStr(m.sv.scroll_y) + " tab=" + toStr(m.tb.active) + " row=" + toStr(m.tbl.selected) + " colw1=" + toStr(cw1) + " modal=" + toStr(m.modal_result) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
