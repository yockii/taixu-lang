import { fileOpen, fileRead, fileClose, FILE_READ } from "./file";
import { fsExists } from "./fs";
import { getenv } from "./os";
import { pemDecodeLimit, PemLimits } from "./pem";
import { x509ParseCertificate } from "./x509";

export function x509LoadRootFile(path: string): List<Bytes> | Error {
    const file = fileOpen(path, FILE_READ)?; defer { fileClose(file); }
    const data = bytesNew(0);
    while (true) {
        const part = fileRead(file, 65536)?;
        if (bytesLen(part) == 0) { break; }
        if (bytesLen(data) > 33554432 - bytesLen(part)) { return err("x509: root bundle input limit"); }
        const out = bytesAsList(data); for (b in bytesAsList(part)) { listPush(out, b); }
    }
    const blocks = pemDecodeLimit(bytesToStr(data)?, PemLimits { maxInputBytes: 33554432, maxDecodedBytes: 33554432, maxBlocks: 4096 })?;
    const roots: List<Bytes> = listNew();
    for (block in blocks) {
        if (block.label != "CERTIFICATE") { continue; }
        x509ParseCertificate(block.data)?; listPush(roots, block.data);
    }
    if (listLen(roots) == 0) { return err("x509: root bundle contains no certificates"); }
    return roots;
}

export function x509SystemRoots(): List<Bytes> | Error {
    const configured = getenv("SSL_CERT_FILE");
    if (len(configured) > 0) { return x509LoadRootFile(configured); }
    for (path in ["/etc/ssl/certs/ca-certificates.crt", "/etc/pki/tls/certs/ca-bundle.crt", "/etc/ssl/ca-bundle.pem", "/etc/pki/tls/cacert.pem", "/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem", "/etc/ssl/cert.pem"]) {
        if (fsExists(path)) { return x509LoadRootFile(path); }
    }
    return err("x509: system CA bundle not found");
}
