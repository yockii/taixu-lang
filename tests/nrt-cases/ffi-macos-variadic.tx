// D3 v0.36 C 变参（macOS，libSystem）：Apple arm64 上变参一律经栈传、各占 8 字节——snprintf 混排 float、int、窄整数与 f32
// （默认实参提升）、u32、字符串；openat 的 mode 是变参（此前声明成定参时 arm64 上进 x3、被调方从栈上读垃圾）：umask 清零后
// 以 0640 新建，stat 核对权限位，再删掉。x86_64 上变参与定参同样传，结果相同。
declare struct STAT { dev: i32, mode: u16, nlink: u16, ino: u64, uid: u32, gid: u32, rdev: i32, pad: i32, atimeSec: int, atimeNsec: int, mtimeSec: int, mtimeNsec: int, ctimeSec: int, ctimeNsec: int, btimeSec: int, btimeNsec: int, size: int, blocks: int, blksize: i32, flags: u32, gen: u32, lspare: i32, qspare0: int, qspare1: int }
declare function snprintf(buf: Bytes, size: usize, format: string, ...e: float, ...a: int, ...b: i8, ...c: u32, ...d: f32, ...f: string): i32 from "libSystem";
declare function openat(fd: i32, path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function umask(mask: u16): u16 from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
declare function stat(path: string, st: Ref< STAT>): i32 from "libSystem";
declare function unlink(path: string): i32 from "libSystem";

function blank(): Ref< STAT> {
    return new STAT { dev: 0, mode: 0, nlink: 0, ino: 0, uid: 0, gid: 0, rdev: 0, pad: 0, atimeSec: 0, atimeNsec: 0, mtimeSec: 0, mtimeNsec: 0, ctimeSec: 0, ctimeNsec: 0, btimeSec: 0, btimeNsec: 0, size: -1, blocks: 0, blksize: 0, flags: 0, gen: 0, lspare: 0, qspare0: 0, qspare1: 0 };
}

function cText(b: Bytes): string {
    let n = 0;
    while (n < bytesLen(b) && (bytesGet(b, n) catch 0) != 0) { n = n + 1; }
    return bytesToStr(bytesSlice(b, 0, n)) catch "bad-utf8";
}

function main(args: []string): int {
    const buf = bytesNew(96);
    const small: i8 = -5;
    const wide: u32 = 4000000000;
    const single: f32 = 1.25;
    const n = snprintf(buf, 96, "%.3f %lld %d %u %.2f %s", 2.5, -9000000000, small, wide, single, "太虚");
    print("ret " + toStr(n as int) + " text " + cText(buf));
    // O_WRONLY|O_CREAT|O_EXCL（macOS 的值），mode 0640。
    umask(0);
    const path = "ffi-macos-variadic.tmp";
    unlink(path);
    const fd = openat(-2, path, 2561, 416);
    const st = blank();
    print("openat " + toStr(fd >= 0) + " close " + toStr(close(fd)) + " stat " + toStr(stat(path, st)) + " mode " + toStr((st.mode as int) % 512 == 416));
    print("unlink " + toStr(unlink(path)));
    return 0;
}
