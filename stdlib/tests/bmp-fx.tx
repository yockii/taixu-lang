// ============================================================================
// stdlib 用例：std/image 的 BMP 读写（2026-10-26，GUI 引擎 G0）。期望字节由 Python 按 BMP 规范
// 独立构造（struct 打包，与本实现不同源）：24 位自底向上写出逐字节相同；读 24 位自底向上、32 位
// 自顶向下、信息头更长且像素偏移不紧接的文件；拒绝 magic、位深、压缩、位面、零高、截断与超大。
// 运行：taixu test tests/bmp-fx.tx
// ============================================================================

import { BmpImage, decodeBmp, encodeBmp } from "std/image";
import { contains } from "std/string";

const V_RGB3X2: string = "00112233445566778899aabbccddeeff1021";
const V_ENC3X2: string = "424d4e0000000000000036000000280000000300000002000000010018000000000018000000130b0000130b00000000000000000000bbaa99eeddcc2110ff000000221100554433887766000000";
const V_RGB2X3: string = "00112233445566778899aabbccddeeff1021";
const V_TD32: string = "424d4e00000000000000360000002800000002000000fdffffff010020000000000018000000130b0000130b000000000000000000002211007f5544337f8877667fbbaa997feeddcc7f2110ff7f";
const V_GAP24: string = "424d5e0000000000000046000000380000000200000003000000010018000000000018000000130b0000130b0000000000000000000000000000000000000000000000000000eeddcc2110ff0000887766bbaa9900002211005544330000";
const V_BAD_MAGIC: string = "424e3a0000000000000036000000280000000100000001000000010018000000000004000000130b0000130b0000000000000000000001020300";
const V_BPP8: string = "424d3a0000000000000036000000280000000100000001000000010008000000000004000000130b0000130b0000000000000000000005000000";
const V_RLE: string = "424d3a0000000000000036000000280000000100000001000000010018000100000004000000130b0000130b0000000000000000000001020300";
const V_PLANES2: string = "424d3a0000000000000036000000280000000100000001000000020018000000000004000000130b0000130b0000000000000000000001020300";
const V_ZERO_H: string = "424d360000000000000036000000280000000100000000000000010018000000000000000000130b0000130b00000000000000000000";
const V_TRUNC: string = "424d460000000000000036000000280000000200000002000000010018000000000010000000130b0000130b0000000000000000000001020304050600000102030405";
const V_HUGE: string = "424d360000000000000036000000280000001027000010270000010018000000000000000000130b0000130b00000000000000000000";

function hexToBytes(hex: string): Bytes {
    const out = bytesNew(0);
    let i: int = 0;
    while (i + 1 < len(hex)) {
        bytesPush(out, nib(byteTryAt(hex, i) catch 0) * 16 + nib(byteTryAt(hex, i + 1) catch 0));
        i = i + 2;
    }
    return out;
}

function nib(c: int): int {
    if (c >= 97) {
        return c - 87;
    }
    return c - 48;
}

function rejects(hex: string, needle: string): bool {
    const img: BmpImage = decodeBmp(hexToBytes(hex)) catch (e) {
        return contains(e.message, needle);
    };
    img;
    return false;
}

function encodeFails(w: int, h: int, n: int): bool {
    const out = encodeBmp(w, h, bytesNew(n)) catch (e) {
        return true;
    };
    out;
    return false;
}

test "bmp：24 位写出与规范逐字节相同" {
    const out = encodeBmp(3, 2, hexToBytes(V_RGB3X2)) catch panic("编码失败");
    assert(bytesEqual(out, hexToBytes(V_ENC3X2)), "3x2 逐字节");
}

test "bmp：读 24 位自底向上（往返）" {
    const img: BmpImage = decodeBmp(hexToBytes(V_ENC3X2)) catch panic("解码失败");
    assert(img.width == 3 && img.height == 2, "宽高");
    assert(bytesEqual(img.rgb, hexToBytes(V_RGB3X2)), "像素自顶向下 RGB");
}

test "bmp：读 32 位自顶向下（alpha 不取）" {
    const img: BmpImage = decodeBmp(hexToBytes(V_TD32)) catch panic("解码失败");
    assert(img.width == 2 && img.height == 3, "宽高");
    assert(bytesEqual(img.rgb, hexToBytes(V_RGB2X3)), "像素");
}

test "bmp：信息头更长、像素偏移不紧接" {
    const img: BmpImage = decodeBmp(hexToBytes(V_GAP24)) catch panic("解码失败");
    assert(bytesEqual(img.rgb, hexToBytes(V_RGB2X3)), "像素");
}

test "bmp：结构化拒绝" {
    assert(rejects(V_BAD_MAGIC, "magic"), "magic");
    assert(rejects(V_BPP8, "位深 8"), "位深");
    assert(rejects(V_RLE, "压缩"), "压缩");
    assert(rejects(V_PLANES2, "位面"), "位面");
    assert(rejects(V_ZERO_H, "高不能为 0"), "零高");
    assert(rejects(V_TRUNC, "截断"), "截断");
    assert(rejects(V_HUGE, "64 MiB"), "超大");
    assert(rejects("424d", "头过短"), "过短");
}

test "bmp：写出参数检查" {
    assert(encodeFails(2, 2, 11), "长度不符");
    assert(encodeFails(0, 2, 0), "零宽");
    assert(!encodeFails(1, 1, 3), "1x1 合法");
}
