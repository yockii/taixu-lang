// ============================================================================
// std/collect —— 泛型集合算法族（V0.38-S3；STD-08——G1 单态化 dogfood）。
//
// 本模块是泛型单态化（D3 v0.13）的首个实战消费面：高阶族/二分/堆以泛型
// 书写，单态实例按调用点型参组合生成（mangled 名入产物）。与 std/collections
// （v0.23 单态族）/std/sort（v0.37 三族稳定归并）关系＝**扩族不换血**：旧
// 名单态族保留原样（调用面不破坏——stdlib-roadmap §四-4 迁移纪律）。
//
// 确定性红线：一切算法纯函数、无平台差异面；sortBy 稳定归并（相等元素
// 保持输入序）。**镜像面注记**：本模块用泛型语法——parser.tx 引导侧镜像
// 滞后（登记 v0.39 首位），diff-parser 对本文件受控排除。
// ============================================================================

// —— 高阶族（G1 dogfood：泛型高阶函数）——

// map：逐元素映射（输入 List<T> → List<U>；确定性按下标序）。
export function map<T, U>(xs: List<T>, f: (T) => U): List<U> {
    const out: List<U> = listNew();
    let i: int = 0;
    while (i < listLen(xs)) {
        listPush(out, f(listGet(xs, i) catch panic("collect.map: 下标越界（不可达——循环界内）")));
        i = i + 1;
    }
    return out;
}

// filter：谓词保序过滤。
export function filter<T>(xs: List<T>, keep: (T) => bool): List<T> {
    const out: List<T> = listNew();
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch panic("collect.filter: 下标越界（不可达）");
        if (keep(v)) {
            listPush(out, v);
        }
        i = i + 1;
    }
    return out;
}

// fold：左折叠（acc = f(acc, x)；init 为种子）。
export function fold<T, A>(xs: List<T>, init: A, f: (A, T) => A): A {
    let acc: A = init;
    let i: int = 0;
    while (i < listLen(xs)) {
        acc = f(acc, listGet(xs, i) catch panic("collect.fold: 下标越界（不可达）"));
        i = i + 1;
    }
    return acc;
}

// take/drop 泛型化（前 n／去前 n——越界安全：取到可用部分）。
export function take<T>(xs: List<T>, n: int): List<T> {
    const out: List<T> = listNew();
    let i: int = 0;
    while (i < n && i < listLen(xs)) {
        listPush(out, listGet(xs, i) catch panic("collect.take: 下标越界（不可达）"));
        i = i + 1;
    }
    return out;
}

export function drop<T>(xs: List<T>, n: int): List<T> {
    const out: List<T> = listNew();
    let i: int = n;
    while (i < 0) {
        i = i + 1;
    }
    while (i < listLen(xs)) {
        listPush(out, listGet(xs, i) catch panic("collect.drop: 下标越界（不可达）"));
        i = i + 1;
    }
    return out;
}

// reverse 泛型化。
export function reverse<T>(xs: List<T>): List<T> {
    const out: List<T> = listNew();
    let i = listLen(xs) - 1;
    while (i >= 0) {
        listPush(out, listGet(xs, i) catch panic("collect.reverse: 下标越界（不可达）"));
        i = i - 1;
    }
    return out;
}

// contains（比较走 f 相等判定）。
export function containsWith<T>(xs: List<T>, target: T, eq: (T, T) => bool): bool {
    let i: int = 0;
    while (i < listLen(xs)) {
        if (eq(listGet(xs, i) catch panic("collect.containsWith: 越界（不可达）"), target)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// —— 排序（稳定归并＋cmp 函数形态；泛型版 std/sort）——

// sortBy：稳定归并排序（cmp(a, b) < 0 ⇒ a 在前；相等保持输入序）。
export function sortBy<T>(xs: List<T>, cmp: (T, T) => int): List<T> {
    const n = listLen(xs);
    if (n <= 1) {
        return copyOf(xs);
    }
    const mid = n / 2;
    const left = sortBy(take(xs, mid), cmp);
    const right = sortBy(drop(xs, mid), cmp);
    return mergeBy(left, right, cmp);
}

function mergeBy<T>(a: List<T>, b: List<T>, cmp: (T, T) => int): List<T> {
    const out: List<T> = listNew();
    let i: int = 0;
    let j: int = 0;
    while (i < listLen(a) && j < listLen(b)) {
        const va = listGet(a, i) catch panic("collect.mergeBy: 越界（不可达）");
        const vb = listGet(b, j) catch panic("collect.mergeBy: 越界（不可达）");
        if (cmp(vb, va) >= 0) {
            listPush(out, va);
            i = i + 1;
        } else {
            listPush(out, vb);
            j = j + 1;
        }
    }
    while (i < listLen(a)) {
        listPush(out, listGet(a, i) catch panic("collect.mergeBy: 越界（不可达）"));
        i = i + 1;
    }
    while (j < listLen(b)) {
        listPush(out, listGet(b, j) catch panic("collect.mergeBy: 越界（不可达）"));
        j = j + 1;
    }
    return out;
}

function copyOf<T>(xs: List<T>): List<T> {
    const out: List<T> = listNew();
    let i: int = 0;
    while (i < listLen(xs)) {
        listPush(out, listGet(xs, i) catch panic("collect.copyOf: 越界（不可达）"));
        i = i + 1;
    }
    return out;
}

// —— 二分（有序前提；cmp 同 sortBy 约定）——

// binarySearch：命中返回下标，未命中 −1。
export function binarySearch<T>(xs: List<T>, target: T, cmp: (T, T) => int): int {
    let lo: int = 0;
    let hi: int = listLen(xs) - 1;
    while (lo <= hi) {
        const mid = lo + (hi - lo) / 2;
        const v = listGet(xs, mid) catch panic("collect.binarySearch: 越界（不可达）");
        const c = cmp(v, target);
        if (c == 0) {
            return mid;
        }
        if (c < 0) {
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    return -1;
}

// —— 二叉堆（最小堆；cmp 同约定——cmp(a,b) < 0 ⇒ a 优先）——

// heapPush：入堆（上浮；就地改写 xs）。
export function heapPush<T>(xs: List<T>, v: T, cmp: (T, T) => int): void {
    listPush(xs, v);
    let i = listLen(xs) - 1;
    while (i > 0) {
        const parent = (i - 1) / 2;
        const vp = listGet(xs, parent) catch panic("collect.heapPush: 越界（不可达）");
        const vi = listGet(xs, i) catch panic("collect.heapPush: 越界（不可达）");
        if (cmp(vi, vp) < 0) {
            listSet(xs, parent, vi);
            listSet(xs, i, vp);
            i = parent;
        } else {
            break;
        }
    }
}

// heapPop：弹出堆顶（最小）；空堆 None。
export function heapPop<T>(xs: List<T>, cmp: (T, T) => int): T? {
    const n = listLen(xs);
    if (n == 0) {
        return None;
    }
    const top = listGet(xs, 0) catch panic("collect.heapPop: 越界（不可达）");
    const last = listPop(xs) catch panic("collect.heapPop: 尾越界（不可达）");
    if (listLen(xs) > 0) {
        listSet(xs, 0, last);
        siftDown(xs, 0, cmp);
    }
    return top;
}

function siftDown<T>(xs: List<T>, start: int, cmp: (T, T) => int): void {
    let i = start;
    while (true) {
        const l = i * 2 + 1;
        const r = i * 2 + 2;
        let best = i;
        if (l < listLen(xs)) {
            if (cmp(listGet(xs, l) catch panic("collect.siftDown: 越界（不可达）"), listGet(xs, best) catch panic("collect.siftDown: 越界（不可达）")) < 0) {
                best = l;
            }
        }
        if (r < listLen(xs)) {
            if (cmp(listGet(xs, r) catch panic("collect.siftDown: 越界（不可达）"), listGet(xs, best) catch panic("collect.siftDown: 越界（不可达）")) < 0) {
                best = r;
            }
        }
        if (best == i) {
            return;
        }
        const vi = listGet(xs, i) catch panic("collect.siftDown: 越界（不可达）");
        const vb = listGet(xs, best) catch panic("collect.siftDown: 越界（不可达）");
        listSet(xs, i, vb);
        listSet(xs, best, vi);
        i = best;
    }
}
