// aarch64-windows 编译器的交叉构建与自举不动点（gate.tx 的 a64-windows-bootstrap 步）：用受测
// 编译器把 bootstrap/taixu.tx 交叉编成 aarch64-windows 的编译器 C，任何宿主上都核对它是 ARM64 的 PE32+ 可执行文件（机器号 0xAA64、
// DYNAMIC_BASE｜NX_COMPAT｜HIGH_ENTROPY_VA、带基址重定位与异常目录）且两次交叉构建逐字节相同；Windows ARM64 宿主上运行 C，由 C
// 在本仓自举出 D，核对 D 与 C 逐字节相同（不动点）。别的宿主上自举一项记 SKIP，不记通过（逐项的 PE 核对见 scripts/pe_arm64_check.py，
// 由 a64-windows-products 步对每个产物执行）。
// 运行：taixu run --toolchain scripts/test_a64w_bootstrap.tx --compiler <taixu> --work <目录> [--root <仓库>]
import { absolute, join, list1, mkdirs, plus, step, readBytes } from "./build_lib";
import { osRealPath } from "./build_os";
import { capture, check, summary, tallyNew } from "./test_lib";

function u(b: Bytes, at: int, n: int): int {
    let v = 0;
    let k = n - 1;
    while (k >= 0) {
        v = (v << 8) | ((bytesGetLE<u8>(b, at + k) ?? 0) as int);
        k = k - 1;
    }
    return v;
}

// ARM64 的 PE32+ 可执行文件：MZ、PE 签名、机器号、可执行且带重定位、可选头 0x20B、ASLR 三位、数据目录 3（异常）与 5（基址重定位）非空。
function peArm64(img: Bytes): bool {
    if (bytesLen(img) < 512 || u(img, 0, 2) != 23117) { return false; }
    const pe = u(img, 60, 4);
    if (pe + 264 > bytesLen(img) || u(img, pe, 4) != 17744 || u(img, pe + 4, 2) != 43620) { return false; }
    const chars = u(img, pe + 22, 2);
    const opt = pe + 24;
    const dll = u(img, opt + 70, 2);
    return (chars & 2) != 0 && (chars & 1) == 0 && u(img, opt, 2) == 523 && (dll & 352) == 352
    && u(img, opt + 108, 4) >= 16 && u(img, opt + 112 + 8 * 3 + 4, 4) > 0 && u(img, opt + 112 + 8 * 5 + 4, 4) > 0;
}

function crossBuild(compiler: string, root: string, out: string): void | Error {
    return step(compiler, plus(plus(list1("build"), list1("bootstrap/taixu.tx")), plus(list1("--toolchain"), plus(list1("--target=aarch64-windows"), plus(list1("--out"), list1(out))))), root);
}

function run(args: []string): int | Error {
    let compiler = "";
    let work = "";
    let root = "";
    let i: int = 0;
    while (i < len(args)) {
        const a = args[i];
        if (i + 1 >= len(args)) {
            return err("缺少取值或未知参数：" + a);
        }
        const v = args[i + 1];
        if (a == "--compiler") {
            compiler = v;
        } else if (a == "--work") {
            work = v;
        } else if (a == "--root") {
            root = v;
        } else {
            return err("未知参数：" + a);
        }
        i = i + 2;
    }
    if (len(compiler) == 0 || len(work) == 0) {
        return err("用法：taixu run --toolchain scripts/test_a64w_bootstrap.tx --compiler <taixu> --work <目录> [--root <仓库>]");
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = osRealPath(absolute(root));
    compiler = osRealPath(absolute(compiler));
    if (!mkdirs(absolute(work))) {
        return err("建不了工作目录：" + work);
    }
    const dir = osRealPath(absolute(work));
    const t = tallyNew();
    const first = join(dir, "c");
    const second = join(dir, "c2");
    crossBuild(compiler, root, first)?;
    crossBuild(compiler, root, second)?;
    const c = join(first, "taixu.exe");
    const img = readBytes(c) catch bytesNew(0);
    const img2 = readBytes(join(second, "taixu.exe")) catch bytesNew(0);
    check(t, "cross-build", bytesLen(img) > 0, "交叉构建没有产物：" + c);
    check(t, "deterministic", bytesLen(img) > 0 && bytesEqual(img, img2), "两次交叉构建不同（" + toStr(bytesLen(img)) + "／" + toStr(bytesLen(img2)) + " 字节）");
    check(t, "pe", peArm64(img), "不是带基址重定位与异常目录的 ARM64 PE32+ 可执行文件");
    if (hostTarget() != "windows" || hostArch() != "aarch64") {
        print("SKIP self-build：不是 Windows ARM64 宿主");
        return summary(t, "a64-windows-bootstrap");
    }
    // C 在本仓自举出 D（Windows ARM64 宿主上缺省目标即 aarch64-windows）。
    const d = join(dir, "d");
    const r = capture(c, plus(plus(list1("build"), list1("bootstrap/taixu.tx")), plus(list1("--toolchain"), plus(list1("--out"), list1(d)))), root, 3600000000000, 65536)?;
    check(t, "self-build", r.code == 0, "退出码 " + toStr(r.code) + "，输出 " + r.out + r.err);
    const dimg = readBytes(join(d, "taixu.exe")) catch bytesNew(0);
    check(t, "fixpoint", bytesLen(dimg) > 0 && bytesEqual(img, dimg), "自举出的 D（" + toStr(bytesLen(dimg)) + " 字节）与交叉构建的 C 不同");
    return summary(t, "a64-windows-bootstrap");
}

function main(args: []string): int {
    return run(args) catch (e) {
        eprint("test_a64w_bootstrap: " + e.message);
        return 1;
    };
}
