// 公开 RSA 运算的 15 位分量；不用于私钥。调用方保证奇数模数与已验证的尺寸。
export function rsaZeros(n: int): List<int> {
    const out: List<int> = listNew(); let i = 0;
    while (i < n) { listPush(out, 0); i = i + 1; }
    return out;
}

export function rsaDecode(data: Bytes, count: int): List<int> {
    const out = rsaZeros(count); let i = 0;
    while (i < bytesLen(data) * 8) {
        const b = bytesGet(data, bytesLen(data) - 1 - i / 8) catch panic("rsa: decode bounds");
        const at = i / 15;
        if (at < count) { listSet(out, at, listGet(out, at) | (((b >> (i % 8)) & 1) << (i % 15))); }
        i = i + 1;
    }
    return out;
}

export function rsaEncode(data: List<int>, length: int): Bytes {
    const out = bytesNew(length); let i = 0;
    while (i < length * 8) {
        const at = length - 1 - i / 8; const b = bytesGet(out, at) catch panic("rsa: encode bounds");
        let bit = 0;
        if (i / 15 < listLen(data)) { bit = (listGet(data, i / 15) >> (i % 15)) & 1; }
        bytesSet(out, at, b | (bit << (i % 8))); i = i + 1;
    }
    return out;
}

export function rsaNprime(n: List<int>): int {
    const low = listGet(n, 0); let inverse = 1; let i = 0;
    while (i < 4) { inverse = (inverse * (2 - low * inverse)) & 32767; i = i + 1; }
    return (-inverse) & 32767;
}

// value 为 n+1 分量，最多 2*n；减一次模数即可规范化。
function reduce(value: List<int>, n: List<int>): List<int> {
    const count = listLen(n); const candidate = rsaZeros(count); let borrow = 0; let i = 0;
    while (i < count) {
        let v = listGet(value, i) - listGet(n, i) - borrow;
        borrow = 0;
        if (v < 0) { v = v + 32768; borrow = 1; }
        listSet(candidate, i, v); i = i + 1;
    }
    if (listGet(value, count) >= borrow) { return candidate; }
    const out = rsaZeros(count); i = 0;
    while (i < count) { listSet(out, i, listGet(value, i)); i = i + 1; }
    return out;
}

export function rsaMontgomery(a: List<int>, b: List<int>, n: List<int>, nprime: int): List<int> {
    const count = listLen(n); const t = rsaZeros(count + 2); let i = 0;
    while (i < count) {
        let carry = 0; let j = 0;
        while (j < count) {
            const v = listGet(t, j) + listGet(a, j) * listGet(b, i) + carry;
            listSet(t, j, v & 32767); carry = v >> 15; j = j + 1;
        }
        const high = listGet(t, count) + carry;
        listSet(t, count, high & 32767); listSet(t, count + 1, high >> 15);
        const m = (listGet(t, 0) * nprime) & 32767;
        carry = 0; j = 0;
        while (j < count) {
            const v = listGet(t, j) + m * listGet(n, j) + carry;
            if (j > 0) { listSet(t, j - 1, v & 32767); }
            carry = v >> 15; j = j + 1;
        }
        const v = listGet(t, count) + carry;
        listSet(t, count - 1, v & 32767); listSet(t, count, listGet(t, count + 1) + (v >> 15)); listSet(t, count + 1, 0);
        i = i + 1;
    }
    return reduce(t, n);
}

export function rsaR2(n: List<int>): List<int> {
    const count = listLen(n); let out = rsaZeros(count); listSet(out, 0, 1); let bit = 0;
    while (bit < count * 30) {
        const wide = rsaZeros(count + 1); let carry = 0; let i = 0;
        while (i < count) {
            const v = listGet(out, i) * 2 + carry;
            listSet(wide, i, v & 32767); carry = v >> 15; i = i + 1;
        }
        listSet(wide, count, carry); out = reduce(wide, n); bit = bit + 1;
    }
    return out;
}

export function rsaModPow(value: List<int>, exponent: int, n: List<int>, nprime: int, r2: List<int>): List<int> {
    const one = rsaZeros(listLen(n)); listSet(one, 0, 1);
    const base = rsaMontgomery(value, r2, n, nprime);
    let out = rsaMontgomery(one, r2, n, nprime); let bit = 30;
    while (bit > 0 && ((exponent >> bit) & 1) == 0) { bit = bit - 1; }
    while (bit >= 0) {
        out = rsaMontgomery(out, out, n, nprime);
        if (((exponent >> bit) & 1) != 0) { out = rsaMontgomery(out, base, n, nprime); }
        bit = bit - 1;
    }
    return rsaMontgomery(out, one, n, nprime);
}
