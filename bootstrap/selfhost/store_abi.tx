// store_abi.tx —— Store RC 计数面原生接入契约（v052-runtime-rc-weak-generation D3）。
// Private fixed-layout descriptor; no ABI or language change. 值面常量（tag/偏移）
// 引用 value_abi.tx revision1，本契约只钉 Store 侧事实。绑定测试在
// src/vm/interp/value.zig（与 D2 同法：.tx 常量 vs Zig 事实逐项锁死）。
export const STORE_ABI_REVISION: int = 2;

// RC 并行数组（SoA）：元素 u32；基址经宿主导出 __tx_rc_base() 获取。
export const RC_ELEMENT_BYTES: int = 4;
// 永生哨兵（驻留字符串表/模块状态）：retain/release 空操作。
export const RC_IMMORTAL: int = 4294967295;
// RC_IMMORTAL 在 .tx int（i64）中以同值正数表示（4294967295 < 2^63）。

// 堆引用 tag 集（__tx_is_heapref 表的 1 位；与 value.zig isHeapRef 同源）：
// err=5 str=6 structv=7 enumv=8 ref=9 arr=10 slice=11 weakbox=14 list=15 future=16。
export const HEAPREF_TAG_COUNT: int = 256;
export const HEAPREF_TAGS: string = "err str structv enumv ref arr slice weakbox list future";
export const TAG_ERR: int = 5;
export const TAG_STR: int = 6;
export const TAG_STRUCTV: int = 7;
export const TAG_ENUMV: int = 8;
export const TAG_REF: int = 9;
export const TAG_ARR: int = 10;
export const TAG_SLICE: int = 11;
export const TAG_WEAKBOX: int = 14;
export const TAG_LIST: int = 15;
export const TAG_FUTURE: int = 16;

// 对象头 flags@0 的位：1＝有弱引用观察者、4＝帧对象、8＝已知 ASCII（子串缓存）、16＝冻结（来自 Shared，
// 写即 trap 4022；线程第 4b 步）、32＝载荷借用自共享块（释放时不归还载荷；线程第 4c 步）。
export const OBJ_FLAG_FROZEN: int = 16;
export const OBJ_FLAG_BORROWED: int = 32;

// __tx_rc_scalar_flag 位域：bit0＝标量臂（TAIXU_RC_SCALAR 生效）、
// bit1＝rc_probe_on（探针计数门）。
export const FLAG_BIT_SCALAR: int = 1;
export const FLAG_BIT_PROBE: int = 2;

// 探针计数器（[rc-path-v1] 数据面）：4 位点 × 2 臂 × u64；基址经
// __tx_probe_counts() 获取；行文本由宿主 rcPathReport 终打印（格式恒等
// 由单点打印保证）。位点序：0=retain 1=release 2=release_frame 3=release_child。
export const PROBE_SITES: int = 4;
export const PROBE_ARMS: int = 2;
export const PROBE_COUNTER_BYTES: int = 8;

// 分期边界（公开声明）：释零终局（级联/载荷分派/weak 通知）经宿主导出
// __tx_rc_zero_cascade(idx) 承接，随 Value/字符串/list 批载荷面迁移后原生。

// StrbState 布局（rev2，v052-runtime-value-strlist-generation 首期 strb 批）：
// extern struct 48B——ptr@0/len@8/cap@16（u64）、inited@24（u32＋pad@28）、
// scratch0@32/scratch1@40（生成侧发射臂私有暂存，shim/原生逻辑不消费）。
// 生成侧 aot/strbld.zig state_bytes 与原生发射共用本契约；绑定测试在
// src/tools/aot_shim.zig（D8，与 D2/D3 同法逐项锁死）。
export const STRB_STATE_BYTES: int = 48;
export const STRB_OFF_PTR: int = 0;
export const STRB_OFF_LEN: int = 8;
export const STRB_OFF_CAP: int = 16;
export const STRB_OFF_INITED: int = 24;
export const STRB_OFF_SCRATCH0: int = 32;
export const STRB_OFF_SCRATCH1: int = 40;
// __tx_strb_stat(mask) 位域：bit0=appends、bit1=allocs、bit2=finishes
// （finishes 增量附带环境门控的 [strb] 报告打印——宿主单一事实源）。
export const STRB_STAT_APPENDS: int = 1;
export const STRB_STAT_ALLOCS: int = 2;
export const STRB_STAT_FINISHES: int = 4;

export function storeAbiCompatible(): bool {
    if (STORE_ABI_REVISION != 2) { return false; }
    if (RC_ELEMENT_BYTES != 4) { return false; }
    if (RC_IMMORTAL != 4294967295) { return false; }
    if (HEAPREF_TAG_COUNT != 256) { return false; }
    if (TAG_ERR != 5 || TAG_STR != 6 || TAG_STRUCTV != 7 || TAG_ENUMV != 8) { return false; }
    if (TAG_REF != 9 || TAG_ARR != 10 || TAG_SLICE != 11) { return false; }
    if (TAG_WEAKBOX != 14 || TAG_LIST != 15 || TAG_FUTURE != 16) { return false; }
    if (FLAG_BIT_SCALAR != 1 || FLAG_BIT_PROBE != 2) { return false; }
    if (PROBE_SITES != 4 || PROBE_ARMS != 2 || PROBE_COUNTER_BYTES != 8) { return false; }
    if (STRB_STATE_BYTES != 48) { return false; }
    if (STRB_OFF_PTR != 0 || STRB_OFF_LEN != 8 || STRB_OFF_CAP != 16) { return false; }
    if (STRB_OFF_INITED != 24 || STRB_OFF_SCRATCH0 != 32 || STRB_OFF_SCRATCH1 != 40) { return false; }
    if (STRB_STAT_APPENDS != 1 || STRB_STAT_ALLOCS != 2 || STRB_STAT_FINISHES != 4) { return false; }
    return true;
}
