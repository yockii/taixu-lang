// mcp_worker_limits_linux.tx 用的系统调用（x86_64 的号）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux 与 _linux_aarch64
// 两个文件（导出面相同）；种子换代后改成 from syscall "名字" 合成一份。
declare function sysGetrlimit(kind: i32, info: Bytes): i32 from syscall 97;
declare function sysGetpid(): i32 from syscall 39;
declare function sysGetpgrp(): i32 from syscall 111;

export function getrlimit(kind: i32, info: Bytes): i32 { return sysGetrlimit(kind, info); }
export function getpid(): i32 { return sysGetpid(); }
export function getpgrp(): i32 { return sysGetpgrp(); }
