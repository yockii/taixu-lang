// image-png ——：PNG 像素面通道——std/image 解码 →
// gui/image.tryImageFromPixels → drawImage（部分可见/完全出界判界）→
// sha 确定性锚。fixture＝tests/vectors/png-vectors.txt 的 rgb12x8（type 2＋
// 多 IDAT 拼接＋filter 0–4 循环；Python zlib 冻结产物，勿手改）。
// 与 tests/image.tx（BMP 通道）同形态对偶——BMP 引擎侧读文件 vs
// PNG stdlib 解码→像素面上行。
import { Canvas, canvasNew, drawImage, imageDispose } from "gui/components";
import { tryImageFromPixels } from "gui/image";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256 } from "gui/surface";
import { decodePngHex } from "std/image";
import { PngImage } from "std/image";

const PNG_HEX: string = "";

export function main(args: []string): int {
    args;
    const surface = surfaceOpen(40, 30) catch (e) {
        print(e.message);
        return 1;
    };
    surfaceClear(surface, 0xE8E8F0);
    const img: PngImage = decodePngHex(PNG_HEX) catch (e) {
        print(e.message);
        surfaceClose(surface);
        return 1;
    };
    const pic = tryImageFromPixels(img.pixels, img.width, img.height, 4, 3) catch (e) {
        print(e.message);
        surfaceClose(surface);
        return 1;
    };
    print("img " + toStr(pic.w) + "x" + toStr(pic.h));
    const cv = canvasNew(surface, 40, 30);
    drawImage(cv, pic);
    // 部分可见（右下越界——引擎边界裁剪）。
    pic.x = 36;
    pic.y = 20;
    drawImage(cv, pic);
    // 完全出界（Canvas 判界跳过——不触引擎）。
    pic.x = 100;
    pic.y = 100;
    drawImage(cv, pic);
    print("sha=" + surfaceSha256(surface));
    imageDispose(pic);
    surfaceClose(surface);
    return 0;
}
