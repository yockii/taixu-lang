import { browserAddressOrder, browserConnectAddresses } from "../examples/browser/connect_socket";
import { BrowserAddress } from "../examples/browser/dns_common";
import { deadlineAfterMs } from "std/deadline";
import { parseIp } from "std/ip";

function address(text: string, scope: int): BrowserAddress { return BrowserAddress { ip: parseIp(text) catch panic("ip"), scope: scope }; }
function invalid(addresses: List<BrowserAddress>, port: int, duration: int, cancel: bool): bool {
    const deadline = deadlineAfterMs(duration) catch panic("deadline"); const cancelled = (): bool => { return cancel; };
    browserConnectAddresses(addresses, port, deadline, cancelled) catch (e) { return true; }; return false;
}
function check(): void {
    const input: List<BrowserAddress> = listNew();
    listPush(input, address("2001:db8::1", 0)); listPush(input, address("2001:db8::2", 0)); listPush(input, address("127.0.0.1", 0)); listPush(input, address("127.0.0.2", 0)); listPush(input, address("2001:db8::1", 0));
    const ordered = browserAddressOrder(input) catch panic("order"); assert(listLen(ordered) == 4, "duplicate addresses removed");
    assert(bytesEqual(listGet(ordered, 0).ip, listGet(input, 0).ip) && bytesEqual(listGet(ordered, 1).ip, listGet(input, 2).ip)
        && bytesEqual(listGet(ordered, 2).ip, listGet(input, 1).ip) && bytesEqual(listGet(ordered, 3).ip, listGet(input, 3).ip), "interleave families and preserve per-family order");
    listPush(input, address("2001:db8::1", 7)); assert(listLen(browserAddressOrder(input) catch panic("scope")) == 5, "different scopes are distinct candidates");
    assert(invalid(input, 0, 1000, false) && invalid(input, 443, 0, false) && invalid(input, 443, 1000, true), "preflight errors before opening any sockets");
    const empty: List<BrowserAddress> = listNew(); assert(invalid(empty, 443, 1000, false), "empty address set");
    const bad: List<BrowserAddress> = listNew(); listPush(bad, address("127.0.0.1", 1)); assert(invalid(bad, 443, 1000, false), "invalid IPv4 scope");
}
test "浏览器连接：地址族交错、去重、scope 与前置错误" { check(); }
export function main(args: []string): int { check(); print("browser connect: ordering, scope and preflight OK"); return 0; }
