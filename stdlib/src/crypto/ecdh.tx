// X25519，RFC 7748。固定轮数的 Montgomery ladder；不按私钥位分支或取表。
import { fieldSmall, fieldDecode, fieldEncode, fieldAdd, fieldSub, fieldMul, fieldSquare, fieldSwap, fieldInverse } from "./field25519";

export function x25519(secret: Bytes, peer: Bytes): Bytes | Error {
    if (bytesLen(secret) != 32 || bytesLen(peer) != 32) { return err("ecdh: X25519 requires 32-byte keys"); }
    const scalar = bytesSlice(secret, 0, 32);
    bytesSet(scalar, 0, (bytesGet(scalar, 0) catch 0) & 248);
    bytesSet(scalar, 31, ((bytesGet(scalar, 31) catch 0) & 127) | 64);
    const x1 = fieldDecode(peer);
    let x2 = fieldSmall(1); let z2 = fieldSmall(0);
    let x3 = fieldDecode(peer); let z3 = fieldSmall(1);
    const a24 = fieldSmall(121665);
    let swap = 0; let t = 254;
    while (t >= 0) {
        const b = bytesGet(scalar, t / 8) catch panic("ecdh: internal scalar bounds");
        const bit = (b >> (t % 8)) & 1;
        swap = swap ^ bit; fieldSwap(x2, x3, swap); fieldSwap(z2, z3, swap); swap = bit;
        const a = fieldAdd(x2, z2); const aa = fieldSquare(a);
        const b2 = fieldSub(x2, z2); const bb = fieldSquare(b2); const e = fieldSub(aa, bb);
        const c = fieldAdd(x3, z3); const d = fieldSub(x3, z3);
        const da = fieldMul(d, a); const cb = fieldMul(c, b2);
        x3 = fieldSquare(fieldAdd(da, cb)); z3 = fieldMul(x1, fieldSquare(fieldSub(da, cb)));
        x2 = fieldMul(aa, bb); z2 = fieldMul(e, fieldAdd(aa, fieldMul(a24, e)));
        t = t - 1;
    }
    fieldSwap(x2, x3, swap); fieldSwap(z2, z3, swap);
    const shared = fieldEncode(fieldMul(x2, fieldInverse(z2)));
    let nonzero = 0; let i = 0;
    while (i < 32) { nonzero = nonzero | (bytesGet(shared, i) catch 0); i = i + 1; }
    if (nonzero == 0) { return err("ecdh: X25519 all-zero shared secret"); }
    return shared;
}

export function x25519PublicKey(secret: Bytes): Bytes | Error {
    const base = bytesNew(32); bytesSet(base, 0, 9);
    return x25519(secret, base);
}
