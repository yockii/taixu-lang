// 02 值与类型：内建类型、struct/enum 值语义、绑定不可变性与 const 对象字段。
struct Point {
    x: int,
    y: int,
}

enum Shape {
    Circle(r: int),
    Rect(w: int, h: int),
    Dot,
}

function main(args: []string): int {
    // 内建类型：int(64 位)/float/bool/string；无隐式数值转换——显式 as
    const n: int = 1_000_000;
    const ratio: float = 3 as float / 2.0;
    const ok: bool = n > 0 && ratio > 1.0;
    print("ratio=" + toStr(ratio) + " ok=" + toStr(ok));

    // struct 值语义：赋值即整体拷贝
    let p: Point = { x: 1, y: 2 };
    const q: Point = p;
    p.x = 100;
    print("q.x 不受影响: " + toStr(q.x));

    // enum 判别联合：switch 表达式穷尽
    const s: Shape = Shape.Rect(3, 4);
    const area = switch (s) {
        case Circle(r) => r * r * 3,
        case Rect(w, h) => w * h,
        case Dot => 0,
    };
    print("area=" + toStr(area));
    return 0;
}
