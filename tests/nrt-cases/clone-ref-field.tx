// 克隆含 Ref 字段的 struct：字段里的 Ref 仍是同一个共享对象（D3 Ref 语义；修复前嵌套 Ref 被展开成值）。
struct Tally { n: int }
struct Holder { t: Ref< Tally> }
function main(args: []string): int {
    const t = new Tally { n: 0 };
    const h = Holder { t: t };
    const h2 = h;
    t.n = 5;
    print(toStr(h2.t.n));
    return 0;
}
