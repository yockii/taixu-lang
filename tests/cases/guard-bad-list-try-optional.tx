// D3 v0.51 §6.9-5、§6.19-3：元素可空的 List<T?> 上 listTryGet／listTryPop 的 None 分不清越界与空元素，
// 值可空的 Map<K, V?> 上 mapGet 的 None 分不清缺键与空值，都定向拒绝并指向 listLen＋listGet、mapHas＋mapAt；解构同理；
// 泛型里写了 T? 而 T 代入可选类型（成了 int??）的，报在实例化处并指明类型参数。
function first<T>(xs: List<T>): T? {
    if (listLen(xs) == 0) { return None; }
    return listGet(xs, 0);
}

export function main(args: []string): int {
    const os: List<int?> = listNew();
    const e = listTryGet(os, 0);
    const f = listTryPop(os);
    const m: Map<string, int?> = mapNew();
    const g = mapGet(m, "k");
    const h = first(os);
    const (p, q) = os;
    return 0;
}
