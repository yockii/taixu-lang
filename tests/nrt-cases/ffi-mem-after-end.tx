// D3 v0.48 外部内存区：ffiMemEnd 之后再读（重复结束本身无效果），trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function main(args: []string): int {
    const m = ffiMem(pageAlloc(), 8, false) catch (e) { print(e.message); return 1; };
    const copy = m;
    ffiMemEnd(m);
    ffiMemEnd(copy);
    print("ended");
    print("never [" + ffiMemUtf8(copy, 0) + "]");
    return 0;
}
