enum Expr {
    Num(v: int),
    Unary(op: string, inner: Ref<Expr>),
    Leaf,
}
function size(e: Ref<Expr>): int {
    return switch (e) {
        case Num(v) => v,
        case Unary(op, inner) => 1 + size(inner),
        case Leaf => 1,
    };
}
function name(e: Ref<Expr>): string {
    return switch (e) {
        case Num(v) => "num",
        else => "other",
    };
}
export function main(args: []string): int {
    const tree: Ref<Expr> = new Expr.Unary("-", new Expr.Num(41));
    print("size=" + toStr(size(tree)));
    print("name=" + name(tree) + "," + name(new Expr.Num(1)));
    return 0;
}
