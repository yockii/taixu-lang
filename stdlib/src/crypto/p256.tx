// P-256 ECDH，32 字节大端私钥与未压缩的 SEC1 公钥；不生成或保留私钥。
import { p256Hex, p256Prime } from "./p256_field";
import { p256Base, p256Multiply, p256Affine, p256DecodePoint, p256Less } from "./p256_point";

function validSecret(secret: Bytes): void | Error {
    if (bytesLen(secret) != 32) { return err("p256: private key must contain 32 bytes"); }
    let nonzero = 0; let i = 0;
    while (i < 32) { nonzero = nonzero | (bytesGet(secret, i) catch 0); i = i + 1; }
    const order = p256Hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
    if (!p256Less(secret, order) || nonzero == 0) { return err("p256: private key outside 1..n-1"); }
    return done();
}

export function p256PublicKey(secret: Bytes): Bytes | Error {
    validSecret(secret)?;
    const field = p256Prime(); const point = p256Affine(field, p256Multiply(field, p256Base(field), secret))?;
    const out = bytesNew(1); bytesSet(out, 0, 4); bytesAppend(out, point.x); bytesAppend(out, point.y); return out;
}

export function p256Ecdh(secret: Bytes, peer: Bytes): Bytes | Error {
    validSecret(secret)?;
    const field = p256Prime(); const point = p256DecodePoint(field, peer)?;
    return (p256Affine(field, p256Multiply(field, point, secret))?).x;
}

function done(): void {}
