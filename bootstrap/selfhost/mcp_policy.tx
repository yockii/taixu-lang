import { JsonValue, jsonGet, JSON_STR } from "./json_parse";
import { McpOut } from "./mcp_debug";
import { ServiceOptions } from "./service_options";
import { serviceAllows, serviceWorkspace, serviceRootsJson, serviceRootAliasesJson, serviceMountTypesJson } from "./service_files";
import { dbgStr } from "./dbg_out";
import { jsonStart } from "./toolchain";

export function mcpToolError(name: string, reason: string, message: string, retryable: bool, extra: string): Ref<McpOut> {
    return new McpOut { code: 0, isErr: true, text: jsonStart("tool-error/1") + ",\"ok\":false,\"tool\":" + dbgStr(name)
        + ",\"reason\":" + dbgStr(reason) + ",\"message\":" + dbgStr(message) + ",\"retryable\":" + toStr(retryable) + extra + "}" };
}
export function mcpPathPolicy(name: string, args: Ref<JsonValue>, c: Ref<ServiceOptions>): Ref<McpOut>? {
    const fileTool = name == "compile" || name == "run" || name == "test" || name == "disasm" || name == "debug_start";
    if (!fileTool) { return None; }
    const pv = jsonGet(args, "path") catch None;
    if (pv == None) { return None; }
    const p = pv catch args;
    if (p.kind != JSON_STR || len(p.s) == 0) { return None; } // 复用实际处理器的参数诊断，不在这里另建一套。
    if (!serviceAllows(p.s)) { return mcpToolError(name, "path_not_trusted", "入口不在已授权的本地根内", false, ""); }
    if ((name == "run" || name == "test" || name == "debug_start") && (!c.trusted || !serviceWorkspace(p.s))) {
        return mcpToolError(name, "untrusted_execution_denied", "执行需要由启动操作者明确授权本地工作区；当前没有可用于不可信执行的已验证系统沙箱", false, "");
    }
    return None;
}
export function mcpSecurityJson(c: Ref<ServiceOptions>): string {
    let scope = "per_process_address_space"; let cpu = "per_process_lifetime"; let processes = "null"; let reaping = "linux_subreaper"; let orphans = "subreaper_adopted";
    if (hostTarget() == "windows") { scope = "job_and_per_process_commit"; cpu = "job_and_per_process_user_time_lifetime"; processes = "32"; reaping = "windows_job"; orphans = "job_members"; }
    // macOS（M3 设计 G4、G9）：内存由看守线程按进程组的物理足迹事后执行；脱离进程树的后代按继承的回收 cookie 找回，清空环境后 exec 的认不出。
    if (hostTarget() == "macos") { scope = "process_group_physical_footprint_after_the_fact"; reaping = "macos_env_cookie"; orphans = "inherited_environment"; }
    return "{\"file_policy\":\"local_roots\",\"roots\":" + serviceRootsJson() + ",\"root_aliases\":" + serviceRootAliasesJson() + ",\"network_paths\":false,\"host_share_mount_types\":" + serviceMountTypesJson() + ",\"workspace_execution_trusted\":" + toStr(c.trusted)
    + ",\"untrusted_execution\":false,\"os_sandbox_verified\":false,\"worker_limit_verification\":\"required_before_requests\",\"worker_memory_bytes\":" + toStr(c.memoryMiB * 1048576)
    + ",\"worker_memory_scope\":" + dbgStr(scope) + ",\"worker_cpu_seconds\":" + toStr(c.cpuSeconds) + ",\"worker_cpu_scope\":" + dbgStr(cpu)
    + ",\"worker_process_limit\":" + processes + ",\"worker_reaping\":" + dbgStr(reaping) + ",\"orphan_reaping_scope\":" + dbgStr(orphans) + ",\"request_timeout_ms\":" + toStr(c.requestMs) + ",\"termination_wait_ms\":250,\"request_json_tokens\":32768,\"worker_artifact_slots\":64,\"worker_scratch\":\"parent_owned_local\",\"deadline_scope\":\"worker_start,input_write,compile,execution,worker_response_read\",\"client_stdout_write_nonblocking\":false,\"stderr_bytes_scope\":\"decoded_text_before_truncation\",\"disk_quota\":false}";
}
