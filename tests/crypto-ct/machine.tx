// Native code inspection fixture. The argument supplies dynamic byte values;
// the output deliberately exposes all bytes of synthetic test results.
import { aes128Expand, aes128Block } from "std/crypto/aes_impl";
import { aes128GcmSeal, aes128GcmOpen } from "std/crypto/gcm";
import { hmacSha256 } from "std/crypto/hmac";
import { hkdfExpandSha256 } from "std/crypto/hkdf";
import { sha384Sum } from "std/crypto/sha384";
import { x25519PublicKey } from "std/crypto/ecdh";
import { p256PublicKey } from "std/crypto/p256";
import { tls13Wipe } from "std/tls13_state";

function filled(n: int, value: int): Bytes { const b = bytesNew(n); bytesFill(b, 0, n, value); return b; }
function output(label: string, data: Bytes): void {
    const digits = "0123456789abcdef"; let text = label + ":"; let i = 0;
    while (i < bytesLen(data)) {
        const value = bytesGet(data, i) catch panic("audit output bounds");
        text = text + (utf8Encode(byteAt(digits, value >> 4)) catch panic("hex"));
        text = text + (utf8Encode(byteAt(digits, value & 15)) catch panic("hex")); i = i + 1;
    }
    print(text);
}

function main(args: []string): int {
    if (len(args) != 1 || len(args[0]) != 1) { return 64; }
    const value = byteAt(args[0], 0);
    const key = filled(16, value); const secret = filled(32, value);
    output("aes", aes128Block(aes128Expand(key), bytesNew(16)));
    const sealed = aes128GcmSeal(key, bytesNew(12), bytesNew(7), filled(33, value)) catch panic("seal");
    output("gcm-seal", sealed);
    output("gcm-open", aes128GcmOpen(key, bytesNew(12), bytesNew(7), sealed) catch panic("open"));
    output("hmac", hmacSha256(secret, filled(55, value)));
    output("hmac-long", hmacSha256(filled(131, value), filled(64, value)));
    output("hkdf", hkdfExpandSha256(secret, bytesFromStr("audit"), 42) catch panic("expand"));
    output("sha384", sha384Sum(filled(113, value)));
    output("x25519", x25519PublicKey(secret) catch panic("X25519"));
    const scalar = filled(32, value); bytesSet(scalar, 0, 1);
    const public = p256PublicKey(scalar) catch panic("P-256");
    output("p256", public);
    tls13Wipe(secret); output("wipe", secret);
    return 0;
}
