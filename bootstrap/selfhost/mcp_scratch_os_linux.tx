declare function mkdirat(fd: i32, path: string, mode: u32): i32 from syscall 258;
declare function unlinkat(fd: i32, path: string, flags: i32): i32 from syscall 263;
declare function openat(fd: i32, path: string, flags: i32, mode: u32): i32 from syscall 257;
declare function close(fd: i32): i32 from syscall 3;
export function scratchMkdir(path: string): bool { return mkdirat(-100, path, 448) == 0; }
export function scratchRmdir(path: string): bool { return unlinkat(-100, path, 512) == 0; }
export function scratchClaim(path: string): bool {
    const file = openat(-100, path, 655553, 448); // WRONLY|CREAT|EXCL|NOFOLLOW|CLOEXEC, 0700.
    if (file < 0) { return false; } return close(file) == 0;
}
