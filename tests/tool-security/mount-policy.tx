// 主机共享挂载作服务根（docs/design/v052-host-share-roots-v0.1-20261023.md §五）。
// 无参数：合成 mountinfo 覆盖判定，任何宿主都跑。两个参数（目录、类型）：在真实主机共享挂载上开启该类型后核验根内读取与链接拒绝。
import { serviceMountReason, serviceConfigure, serviceKind, serviceReadBytes, serviceError } from "../../bootstrap/selfhost/service_files";
import { serviceMountTable } from "../../bootstrap/selfhost/service_mounts";

const INFO: string = "22 1 8:1 / / rw,relatime - ext4 /dev/sdc rw\n"
+ "30 22 8:2 / /home rw,relatime shared:1 - ext4 /dev/sdd rw\n"
+ "50 22 0:45 / /mnt/c rw,noatime - 9p drvfs rw,dirsync,aname=drvfs;path=C:;uid=1000,trans=fd,rfd=4,wfd=4\n"
+ "51 22 0:46 / /mnt/net rw - 9p 10.0.0.1 rw,trans=tcp,port=564\n"
+ "52 22 0:47 / /mnt/nfs rw - nfs4 server:/x rw,vers=4.2\n"
+ "53 50 0:48 / /mnt/c/vfs rw - virtiofs share rw\n"
+ "54 22 0:49 / /mnt/sp\\040ace rw - 9p share rw,trans=virtio\n"
+ "60 22 0:50 / /mnt/over rw - 9p share rw,trans=fd\n"
+ "61 60 8:3 / /mnt/over rw - ext4 /dev/sde rw\n";
const MAC: string = "0 0 0:0 / / rw - apfs /dev/disk3s1s1 rw\n"
+ "1 0 0:0 / /dev rw - devfs devfs rw\n"
+ "2 0 0:0 / /System/Volumes/Data rw - apfs /dev/disk3s5 rw\n"
+ "3 0 0:0 / /Volumes/My\\040Disk rw - apfs /dev/disk5s1 rw\n"
+ "4 0 0:0 / /Volumes/share rw - nonlocal.smbfs //u@server/share rw\n";

function types(a: string, b: string): List< string> {
    const out: List< string> = listNew();
    if (len(a) > 0) { listPush(out, a); }
    if (len(b) > 0) { listPush(out, b); }
    return out;
}
function has(s: string, part: string): bool { return strIndexOf(s, part) >= 0; }

function pure(): int {
    const none = types("", "");
    const p9 = types("9p", "");
    const both = types("9p", "virtiofs");
    const off = serviceMountReason(INFO, none, "/mnt/c/proj");
    assert(has(off, "挂载点 /mnt/c") && has(off, "--allow-mount-type 9p"), "default rejects 9p and names the option: " + off);
    assert(serviceMountReason(INFO, p9, "/mnt/c/proj") == "", "opt-in admits 9p");
    assert(has(serviceMountReason(INFO, none, "/mnt/c"), "--allow-mount-type 9p"), "mount point itself");
    assert(serviceMountReason(INFO, none, "/home/u/proj") == "", "local ext4 unaffected");
    assert(has(serviceMountReason(INFO, p9, "/mnt/net/x"), "trans=tcp"), "network 9p stays rejected");
    const nfs = serviceMountReason(INFO, p9, "/mnt/nfs/x");
    assert(has(nfs, "nfs4") && has(nfs, "不是已识别的本地文件系统") && !has(nfs, "--allow-mount-type"), "nfs never admitted: " + nfs);
    assert(has(serviceMountReason(INFO, p9, "/mnt/c/vfs/x"), "--allow-mount-type virtiofs"), "nested mount checked separately");
    assert(serviceMountReason(INFO, both, "/mnt/c/vfs/x") == "", "each enabled type admitted");
    assert(has(serviceMountReason(INFO, none, "/mnt/sp ace/x"), "挂载点 /mnt/sp ace"), "octal escape decoded");
    assert(serviceMountReason(INFO, p9, "/mnt/sp ace/x") == "", "virtio 9p admitted");
    assert(serviceMountReason(INFO, none, "/mnt/over/x") == "", "later mount on the same point shadows the earlier one");
    assert(has(serviceMountReason("", p9, "/home/u"), "无法核验本地挂载表"), "empty table fails closed");
    assert(has(serviceMountReason("22 1 8:1 / / rw - ext4\n", p9, "/home/u"), "无法核验本地挂载表"), "short line fails closed");
    // macOS 的挂载表由 getfsstat 写成同形的行（M3 设计 G8）：apfs 为本地类型，没有 MNT_LOCAL 的类型带 nonlocal. 前缀。
    assert(serviceMountReason(MAC, none, "/Users/u/proj") == "", "macOS apfs root admitted");
    assert(serviceMountReason(MAC, none, "/Volumes/My Disk/proj") == "", "macOS volume name with a space");
    const smb = serviceMountReason(MAC, p9, "/Volumes/share/x");
    assert(has(smb, "nonlocal.smbfs") && has(smb, "不是已识别的本地文件系统"), "macOS non-local mount rejected: " + smb);
    // 类 Unix 宿主上本进程的真实挂载表：/ 可作祖先；macOS 的 /dev 是 devfs，不是可作信任根的本地文件系统。
    if (hostTarget() != "windows") {
        const table = serviceMountTable();
        assert(len(table) > 0, "host mount table available");
        assert(serviceMountReason(table, none, "/") == "", "host root mount admitted");
        if (hostTarget() == "macos") { assert(has(serviceMountReason(table, none, "/dev/x"), "devfs"), "macOS devfs rejected"); }
    }
    print("PASS_MOUNT_POLICY_DEFAULT_OPTIN_NETWORK_NESTED_ESCAPE_SHADOW_FAILCLOSED");
    return 0;
}

function live(dir: string, kind: string): int {
    const roots: List< string> = listNew(); listPush(roots, dir);
    const libs: List< string> = listNew();
    assert(!serviceConfigure(roots, libs, types("", "")), "host share rejected by default");
    assert(has(serviceError(), "--allow-mount-type " + kind), "rejection names the option: " + serviceError());
    if (!serviceConfigure(roots, libs, types(kind, ""))) { print(serviceError()); return 1; }
    assert(bytesLen(serviceReadBytes(dir + "/ok.bin", 3) catch bytesNew(0)) == 3, "read inside opted-in root");
    assert(serviceKind(dir + "/link/secret.bin") == 0, "links still rejected on the share");
    print("PASS_MOUNT_POLICY_LIVE_" + kind);
    return 0;
}

function main(args: []string): int {
    if (len(args) == 0) { return pure(); }
    if (len(args) == 2) { return live(args[0], args[1]); }
    return 64;
}
