import { htmlParse } from "../examples/browser/html";
import { cssCompute } from "../examples/browser/css";
import { pageLayout, PageLayout } from "../examples/browser/layout";
import { pagePaint, pageMeasure, pageMeasureK, pageScroll } from "../examples/browser/paint";
import { fontEmbedded, fontFree } from "gui/text";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256, surfaceWriteBmp, dipToPxK } from "gui/surface";
import { surfAt, rBlit, rGetPixel } from "gui/engine/raster";
import { textDraw, textDrawStyled, textMeasure } from "gui/engine/text";

function styledCase(): void {
    const font = fontEmbedded() catch panic("font"); defer fontFree(font);
    const plain = surfaceOpen(180, 48) catch panic("plain"); defer surfaceClose(plain);
    const styled = surfaceOpen(180, 48) catch panic("styled"); defer surfaceClose(styled);
    surfaceClear(plain, 0xffffff); assert(textDraw(plain, font.handle, 24, "Hello 太虚", 2, 2, 0x102030) == 0, "ordinary draw"); const expected = surfaceSha256(plain);
    surfaceClear(styled, 0xffffff); assert(textDrawStyled(styled, font.handle, 24, "Hello 太虚", 2, 2, 0x102030, false, false) == 0, "unstyled entry");
    assert(surfaceSha256(styled) == expected, "ordinary draw unchanged through styled entry");
    surfaceClear(styled, 0xffffff); assert(textDrawStyled(styled, font.handle, 24, "Hello 太虚", 2, 2, 0x102030, true, false) == 0, "bold"); const bold = surfaceSha256(styled);
    surfaceClear(styled, 0xffffff); assert(textDrawStyled(styled, font.handle, 24, "Hello 太虚", 2, 2, 0x102030, false, true) == 0, "italic"); const italic = surfaceSha256(styled);
    assert(bold != expected && italic != expected && bold != italic, "synthetic emphasis changes visible ink");
    surfaceClear(styled, 0xffffff); assert(textDrawStyled(styled, font.handle, 24, "Hello 太虚", 2, 2, 0x102030, true, true) == 0, "combined emphasis");
    surfaceClear(styled, 0xffffff); textDraw(styled, font.handle, 24, "Hello 太虚", 2, 2, 0x102030);
    assert(surfaceSha256(styled) == expected, "cached original coverage remains unchanged");
}
function fixture(font: int): Ref<PageLayout> {
    const doc = htmlParse("<style>body{margin:0;padding:4px;background:#f6f7fc;font-size:16px}h1{font-size:20px;margin:0 0 4px}p{margin:4px 0}</style><body><h1>太虚浏览器</h1><p>Simple <b>bold</b> <i>italic</i> text.</p><a href='/next'>下一页 Next</a><p id='bottom'>滚动后的内容</p><p>More content below.</p></body>") catch panic("HTML");
    return pageLayout(doc, cssCompute(doc) catch panic("CSS"), 240, pageMeasure(font)) catch panic("layout");
}
function viewportCase(output: string): void {
    const font = fontEmbedded() catch panic("font"); defer fontFree(font);
    const viewport = surfaceOpen(240, 100) catch panic("viewport"); defer surfaceClose(viewport);
    const host = surfaceOpen(280, 130) catch panic("host"); defer surfaceClose(host);
    const page = fixture(font.handle); assert(page.height > 100, "page exceeds the viewport");
    pagePaint(viewport, font.handle, page, 0, 100) catch panic("paint"); const first = surfaceSha256(viewport);
    assert(rGetPixel(surfAt(viewport), 0, 0) == 0xf6f7fc, "body background");
    let ink = 0; let blue = 0; let y = 0;
    while (y < 100) {
        let x = 0; while (x < 240) {
            const pixel = rGetPixel(surfAt(viewport), x, y); if (pixel != 0xf6f7fc && pixel != 0xffffff) { ink = ink + 1; }
            if ((pixel & 255) > ((pixel >> 16) & 255) + 40) { blue = blue + 1; } x = x + 1;
        } y = y + 1;
    }
    assert(ink > 200 && blue > 20, "actual glyphs and colored link rendered");
    if (len(output) > 0) { assert(surfaceWriteBmp(viewport, output) == 0, "preview BMP"); }
    assert(pageScroll(page, -1, 100) == 0 && pageScroll(page, 1000000, 100) == page.height - 100 && pageScroll(page, 100, page.height + 1) == 0, "scroll clamped to visible content");
    const scroll = pageScroll(page, 20, 100); pagePaint(viewport, font.handle, page, scroll, 100) catch panic("scrolled paint");
    assert(surfaceSha256(viewport) != first, "scroll changes the visible page");
    surfaceClear(host, 0xff00ff); rBlit(surfAt(host), surfAt(viewport), 20, 10);
    assert(rGetPixel(surfAt(host), 19, 10) == 0xff00ff && rGetPixel(surfAt(host), 20, 9) == 0xff00ff && rGetPixel(surfAt(host), 260, 10) == 0xff00ff && rGetPixel(surfAt(host), 20, 110) == 0xff00ff, "page pixels cannot escape the viewport");
    const retina = surfaceOpen(480, 200) catch panic("DPI surface"); defer surfaceClose(retina);
    pagePaint(retina, font.handle, page, 0, 200) catch panic("DPI paint"); assert(rGetPixel(surfAt(retina), 0, 0) == 0xf6f7fc, "DPI background");
}
function badCase(): void {
    const font = fontEmbedded() catch panic("font"); defer fontFree(font); const page = fixture(font.handle);
    const surface = surfaceOpen(40, 40) catch panic("surface"); defer surfaceClose(surface);
    let caught = false; pagePaint(surface, font.handle, page, -1, 100) catch (e) { caught = true; }; assert(caught, "negative scroll rejected");
    caught = false; pagePaint(surface, font.handle, page, 0, 0) catch (e) { caught = true; }; assert(caught, "invalid scale rejected");
    caught = false; pagePaint(surface, -1, page, 0, 100) catch (e) { caught = true; }; assert(caught, "invalid font rejected");
}
function dpiSpacingCase(): void {
    const font = fontEmbedded() catch panic("font"); defer fontFree(font);
    const doc = htmlParse("<style>body{margin:0;font-size:16px}</style><body>Paragraph 1 browser text</body>") catch panic("HTML");
    for (scale in [125, 150, 200, 300]) {
        const page = pageLayout(doc, cssCompute(doc) catch panic("CSS"), 500, pageMeasureK(font.handle, scale)) catch panic("DPI layout");
        let previous = -1;
        for (c in page.commands) {
            if (c.kind != 1) { continue; }
            if (previous >= 0) {
                const before = listGet(page.commands, previous); const rendered = textMeasure(font.handle, dipToPxK(before.size, scale), before.text);
                const space = textMeasure(font.handle, dipToPxK(before.size, scale), " ");
                assert(dipToPxK(c.x, scale) - dipToPxK(before.x, scale) >= rendered + space - 1, "word separation includes the actual rendered advance");
            }
            let i = 0; while (i < listLen(page.commands)) { if (listGet(page.commands, i) == c) { previous = i; break; } i = i + 1; }
        }
    }
}

test "Browser paint: synthetic emphasis preserves cached original glyphs" { styledCase(); }
test "Browser paint: real text, links, viewport clipping, scrolling and DPI" { viewportCase(""); }
test "Browser paint: invalid render inputs" { badCase(); }
test "Browser paint: physical font advances preserve DPI word separation" { dpiSpacingCase(); }
export function main(args: []string): int { styledCase(); let output = ""; if (len(args) > 0) { output = args[0]; } viewportCase(output); badCase(); dpiSpacingCase(); print("browser paint: real text, viewport and emphasis OK"); return 0; }
