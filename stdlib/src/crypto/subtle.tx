// 相同长度时遍历全部字节，不按字节值提前返回。长度是公开元数据；不隐藏长度差异。
export function constantTimeEqual(a: Bytes, b: Bytes): bool {
    if (bytesLen(a) != bytesLen(b)) { return false; }
    let diff = 0;
    let i = 0;
    while (i < bytesLen(a)) {
        const x = bytesGet(a, i) catch panic("subtle: internal byte bounds");
        const y = bytesGet(b, i) catch panic("subtle: internal byte bounds");
        diff = diff | (x ^ y);
        i = i + 1;
    }
    return diff == 0;
}
