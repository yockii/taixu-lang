// D3 v0.49 §6.3-7：返回 void | Error（或 void | 错误 enum）的函数里 `return;` 与走到末尾即成功；
// 闭包同；async void 函数体内 `return;`（原先误报“缺返回值”）。
enum IoErr extends Error { Full = "满了", Denied(path: string) = `拒绝 ${path}` }

function save(ok: bool): void | Error {
    if (!ok) {
        return err("写入失败");
    }
    return;
}

function log(n: int): void | Error {
    if (n < 0) {
        return err("负数");
    }
    print("log " + toStr(n));
}

function put(n: int): void | IoErr {
    if (n > 9) {
        return IoErr.Full;
    }
}

function chain(): void | Error {
    save(true)?;
    log(3)?;
    save(false)?;
    print("不该到这里");
}

async function job(n: int): void {
    if (n == 0) {
        return;
    }
    print("job " + toStr(n));
}

async function driver(): int {
    await job(0) catch (e) { return 1; };
    await job(2) catch (e) { return 1; };
    return 0;
}

export function main(args: []string): int {
    args;
    save(true) catch (e) { print("不该失败"); };
    save(false) catch (e) { print("失败：" + toStr(e)); };
    log(5) catch (e) { print("不该失败"); };
    log(-1) catch (e) { print("失败：" + toStr(e)); };
    put(1) catch (e) { print("不该失败"); };
    put(10) catch (e) { print("失败：" + toStr(e)); };
    chain() catch (e) { print("链：" + toStr(e)); };
    const f = (x: int): void | Error => {
        if (x > 1) {
            return err("闭包失败");
        }
    };
    f(0) catch (e) { print("不该失败"); };
    f(2) catch (e) { print("失败：" + toStr(e)); };
    const d = driver();
    const dDone = await d;
    return 0;
}
