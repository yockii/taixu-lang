// Compiler profile engine and the two renderers. Never executes the target.
import { CompileProfileData, CompileProfileFn, CompileProfilePhase, compileProfileData, compileProfileClear, compileProfileSortRows, compileProfileTotals } from "./compile_profile_data";
import { drvCompileProfile, drvBytesOut, drvDiagOut, drvSetKernel, drvSetToolchain } from "./driver";
import { sha256Hex } from "./sha256";
import { jsonQuote } from "./json_text";
import { diagsArray } from "./cli_json";
import { jsonStart, TOOLCHAIN_VERSION } from "./toolchain";
import { targetName } from "./target";
import { hostTargetId, targetFlagHost } from "./target_host";
import { ANALYSIS_BUDGET } from "./emit_record";

export struct CompileProfileResult {
    ok: bool, entry: string, target: string, diags: string,
    facts: Ref<CompileProfileData>, bytes: int, hash: string,
}
export function collectCompileProfile(entry: string, t: int, kernel: Bytes): Ref<CompileProfileResult> {
    drvSetKernel(kernel);
    const rc = drvCompileProfile(entry, t);
    const facts = compileProfileData();
    const r = new CompileProfileResult { ok: rc == 0, entry: entry, target: targetName(t),
        diags: drvDiagOut(), facts: facts, bytes: 0, hash: "" };
    if (r.ok) { const bytes = drvBytesOut(); r.bytes = bytesLen(bytes); r.hash = sha256Hex(bytes); }
    // The returned facts remain owned by r, independently of the next profile.
    compileProfileClear();
    return r;
}
function qnum(v: int): string { return jsonQuote(toStr(v)); }
function join(xs: List<string>): string {
    let out = ""; let i = 0;
    while (i < listLen(xs)) { out = out + (listGet(xs, i) catch ""); i = i + 1; }
    return out;
}
function sortName(sort: int): string {
    if (sort == 1) { return "instructions"; } if (sort == 2) { return "record-time"; } return "records";
}
function phasesJson(xs: List<Ref<CompileProfilePhase>>): string {
    const out: List<string> = listNew(); let first = true;
    for (p in xs) {
        if (!first) { listPush(out, ","); } first = false;
        listPush(out, "{\"name\":" + jsonQuote(p.name) + ",\"wall_ns\":" + qnum(p.ns) + "}");
    }
    return "[" + join(out) + "]";
}
function fnJson(f: Ref<CompileProfileFn>): string {
    return "{\"id\":" + toStr(f.id) + ",\"module\":" + jsonQuote(f.module) + ",\"name\":" + jsonQuote(f.name)
    + ",\"input_ir_words\":" + qnum(f.inputIr) + ",\"bridge_ir_words_copied\":" + qnum(f.copiedIr)
    + ",\"bridge_fn_nodes\":" + qnum(f.fnNodes) + ",\"bridge_const_nodes\":" + qnum(f.constNodes)
    + ",\"bridge_line_nodes\":" + qnum(f.lineNodes) + ",\"record_ir_words\":" + qnum(f.recordIr)
    + ",\"record_parts\":" + qnum(f.recordParts) + ",\"record_utf8_bytes\":" + qnum(f.recordBytes)
    + ",\"record_wall_ns\":" + qnum(f.recordNs) + ",\"native_instructions\":" + qnum(f.instructions)
    + ",\"native_operand_uses\":" + qnum(f.operands) + ",\"immediate_uses\":" + qnum(f.immediates)
    + ",\"zero_immediate_uses\":" + qnum(f.zeroImmediates) + ",\"memory_operand_uses\":" + qnum(f.memories)
    + ",\"analysis_cells\":" + qnum(f.analysisCells) + ",\"analysis_skipped\":" + toStr(f.analysisSkipped) + "}";
}
function countRows(top: int, total: int): int { if (top > 0 && top < total) { return top; } return total; }
// Sorting uses the supplied facts, never whichever profile was most recent.
function sorted(facts: Ref<CompileProfileData>, sort: int): List<Ref<CompileProfileFn>> {
    return compileProfileSortRows(facts.functions, sort);
}
function summaryJson(d: Ref<CompileProfileData>, returned: int): string {
    const t = compileProfileTotals(d);
    return "{\"functions_total\":" + qnum(listLen(d.functions)) + ",\"functions_returned\":" + qnum(returned)
    + ",\"input_ir_words\":" + qnum(t.inputIr) + ",\"bridge_ir_words_copied\":" + qnum(t.copiedIr)
    + ",\"bridge_fn_nodes\":" + qnum(t.fnNodes) + ",\"bridge_const_nodes\":" + qnum(t.constNodes)
    + ",\"bridge_line_nodes\":" + qnum(t.lineNodes) + ",\"record_parts\":" + qnum(d.recordParts)
    + ",\"record_utf8_bytes\":" + qnum(d.recordBytes) + ",\"function_record_parts\":" + qnum(t.recordParts)
    + ",\"function_record_utf8_bytes\":" + qnum(t.recordBytes) + ",\"native_instructions\":" + qnum(t.instructions)
    + ",\"native_operand_uses\":" + qnum(t.operands) + ",\"immediate_uses\":" + qnum(t.immediates)
    + ",\"zero_immediate_uses\":" + qnum(t.zeroImmediates) + ",\"memory_operand_uses\":" + qnum(t.memories)
    + ",\"analysis_budget_cells\":" + qnum(ANALYSIS_BUDGET) + ",\"analysis_skipped_functions\":" + qnum(t.analysisSkipped)
    + ",\"analysis_max_cells\":" + qnum(t.analysisMaxCells) + "}";
}
function textHopsJson(d: Ref<CompileProfileData>): string {
    return "{\"seb1_utf8_bytes\":" + qnum(d.seb1Bytes) + ",\"fab1_utf8_bytes\":" + qnum(d.fab1Bytes)
    + ",\"record_utf8_bytes\":" + qnum(d.recordBytes) + "}";
}
export function compileProfileErrorJson(kind: string, message: string, code: int, diags: string): string {
    return jsonStart("compile-profile/1") + ",\"toolchain_version\":" + jsonQuote(TOOLCHAIN_VERSION)
    + ",\"ok\":false,\"error\":{\"kind\":" + jsonQuote(kind) + ",\"message\":" + jsonQuote(message)
    + ",\"exit_code\":" + toStr(code) + "},\"profile\":null,\"diags\":" + diagsArray(diags) + "}";
}
export function compileProfileJson(r: Ref<CompileProfileResult>, top: int, sort: int): string {
    if (!r.ok) { return compileProfileErrorJson("compile", "编译失败：" + r.diags, 1, r.diags); }
    const d = r.facts; const rows = sorted(d, sort); const n = countRows(top, listLen(rows));
    const out: List<string> = listNew(); let i = 0;
    for (f in rows) { if (i >= n) { break; } if (i > 0) { listPush(out, ","); } listPush(out, fnJson(f)); i = i + 1; }
    return jsonStart("compile-profile/1") + ",\"toolchain_version\":" + jsonQuote(TOOLCHAIN_VERSION)
    + ",\"ok\":true,\"error\":null,\"diags\":[],\"profile\":{\"scope\":\"compiler-workload\",\"entry\":" + jsonQuote(r.entry)
    + ",\"target\":" + jsonQuote(r.target) + ",\"numeric_encoding\":\"decimal-string/int64\",\"sort\":" + jsonQuote(sortName(sort))
    + ",\"truncated\":" + toStr(n < listLen(rows)) + ",\"units\":{\"time\":\"ns\",\"size\":\"bytes\",\"record_text\":\"utf8-bytes\",\"counts\":\"count\"}"
    + ",\"measurement\":{\"wall_ns\":" + qnum(d.totalNs) + ",\"clock\":\"monotonic\",\"instrumented\":true,\"overhead_included\":true,\"report_and_hash_excluded\":true,\"cpu_ns\":null,\"peak_rss_bytes\":null,\"heap_allocations\":null,\"acceptance_verdict\":null}"
    + ",\"coverage\":{\"native_counts\":\"program-functions-including-prologue-epilogue\",\"excluded_native_counts\":[\"kernel\",\"runtime\",\"ffi-stubs\",\"debug-stubs\",\"tool-stubs\"],\"bridge_nodes\":[\"Fn\",\"Const\",\"LineCol\"],\"runtime_frequencies\":false}"
    + ",\"phases\":" + phasesJson(d.phases) + ",\"record_details\":" + phasesJson(d.details)
    + ",\"codegen_details\":" + phasesJson(d.codegenDetails) + ",\"text_hops\":" + textHopsJson(d)
    + ",\"summary\":" + summaryJson(d, n) + ",\"functions\":[" + join(out) + "]"
    + ",\"product\":{\"bytes\":" + qnum(r.bytes) + ",\"sha256\":" + jsonQuote(r.hash) + ",\"written\":false,\"executed\":false}}}";
}
function milliseconds(ns: int): string {
    return toStr(ns / 1000000) + "." + toStr((ns / 100000) % 10) + toStr((ns / 10000) % 10) + toStr((ns / 1000) % 10);
}
export function compileProfileText(r: Ref<CompileProfileResult>, top: int, sort: int): string {
    if (!r.ok) { return "编译画像未完成：\n" + r.diags; }
    const d = r.facts; const rows = sorted(d, sort); const n = countRows(top, listLen(rows));
    const t = compileProfileTotals(d);
    const out: List<string> = listNew();
    listPush(out, "编译画像 " + jsonQuote(r.entry) + " → " + r.target + "\n");
    listPush(out, "观测墙钟 " + milliseconds(d.totalNs) + " ms（含收集开销；报告和哈希除外）\n阶段（ms）：\n");
    for (p in d.phases) { listPush(out, "  " + p.name + "  " + milliseconds(p.ns) + "\n"); }
    listPush(out, "记录子项（包含在 records 阶段内，ms）：\n");
    for (p in d.details) { listPush(out, "  " + p.name + "  " + milliseconds(p.ns) + "\n"); }
    listPush(out, "codegen 子项（包含在 codegen 阶段内，ms）：\n");
    for (p in d.codegenDetails) { listPush(out, "  " + p.name + "  " + milliseconds(p.ns) + "\n"); }
    listPush(out, "记录总量 " + toStr(d.recordParts) + " 片段，" + toStr(d.recordBytes) + " UTF-8 字节（含换行）\n");
    listPush(out, "文本中转：SEB1 " + toStr(d.seb1Bytes) + "、FAB1 " + toStr(d.fab1Bytes) + "、记录 " + toStr(d.recordBytes) + " UTF-8 字节\n");
    listPush(out, "分析预算 " + toStr(ANALYSIS_BUDGET) + " 项（指令数×寄存器数）：跳过分析 " + toStr(t.analysisSkipped) + " 个函数，最大 " + toStr(t.analysisMaxCells) + " 项\n");
    listPush(out, "记录桥接：复制 " + toStr(t.copiedIr) + " IR字，构造 Fn=" + toStr(t.fnNodes) + " Const=" + toStr(t.constNodes) + " LineCol=" + toStr(t.lineNodes) + " 节点\n");
    listPush(out, "程序函数发射：" + toStr(t.instructions) + " 指令，" + toStr(t.operands) + " 操作数使用（立即数=" + toStr(t.immediates) + "，零立即数=" + toStr(t.zeroImmediates) + "，内存=" + toStr(t.memories) + "）\n");
    listPush(out, "函数排行 " + toStr(n) + "/" + toStr(listLen(rows)) + "，按 " + sortName(sort) + " 降序、ID 升序\n");
    listPush(out, "ID  记录片段  原生指令  记录ms  模块::函数\n");
    let i = 0;
    for (f in rows) {
        if (i >= n) { break; }
        listPush(out, toStr(f.id) + "  " + toStr(f.recordParts) + "  " + toStr(f.instructions) + "  " + milliseconds(f.recordNs)
            + "  " + jsonQuote(f.module) + "::" + jsonQuote(f.name) + "\n"); i = i + 1;
    }
    if (n < listLen(rows)) { listPush(out, "排行已截断；--top 0 显示全部。\n"); }
    listPush(out, "范围：原生计数仅程序函数及其序言/尾声；不含内核、运行时和各类桩。\n");
    listPush(out, "这些是编译工作量和观测墙钟，不是运行频次、CPU/堆剖析或性能验收。\n");
    listPush(out, "产物 " + toStr(r.bytes) + " bytes，SHA-256 " + r.hash + "（未写出、未运行）\n");
    listPush(out, "完整字段：--format=json；完整函数：--top 0。\n");
    return join(out);
}
export function compileProfileHelp(): string {
    return "用法：taixu profile compile <file.tx> [--format=text|json] [--target=windows|linux|macos|<三元组>] [--toolchain] [--top N] [--sort=records|instructions|record-time]\n"
    + "仅编译，不执行目标或写出产物；两个格式共用同一组事实。缺省排行前20，--top 0 全部，平局按函数ID。\n"
    + "示例：taixu profile compile bootstrap/taixu.tx --toolchain --format=json --top 0\n"
    + "记录/IR/原生指令均为编译工作量；桥接构造计数仅Fn/Const/LineCol，操作数是使用次数。\n"
    + "record-time是含观测开销的墙钟；阶段和记录子项存在包含关系。CPU、RSS及通用堆分配未测，JSON记null。\n"
    + "JSON schema=compile-profile/1，64位计数/字节/纳秒是十进制字符串。能力查询：taixu capabilities --format=json。\n";
}
function nonnegative(s: string): int {
    if (len(s) == 0) { return -1; } let v = 0; let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 0; if (c < 48 || c > 57) { return -1; }
        const digit = c - 48;
        if (v > 922337203685477580 || (v == 922337203685477580 && digit > 7)) { return -1; }
        v = v * 10 + digit; i = i + 1;
    }
    return v;
}
function usage(json: bool, message: string): int {
    if (json) { if (writeOutput(compileProfileErrorJson("usage", message, 64, "")) != 0) { return 3; } }
    else { eprint("taixu profile: " + message + "；请用 taixu profile compile --help 查看用法。"); }
    return 64;
}
function writeOutput(text: string): int {
    if (stdoutWrite(bytesFromStr(text + "\n")) < 0) { eprint("taixu profile: 输出写入失败"); return 3; }
    return 0;
}
/// kernelOf(目标) 给出该目标的内嵌内核（taixu.tx 的 embeddedKernel）。
export function compileProfileCommand(args: []string, kernelOf: (int) => Bytes): int {
    let json = false; let text = false;
    for (arg in args) { if (arg == "--format=json") { json = true; } if (arg == "--format=text") { text = true; } }
    if (json && text) { return usage(json, "只能选择一种输出格式"); }
    if (len(args) < 2 || args[1] != "compile") { return usage(json, "需要 compile 子命令"); }
    if (len(args) == 3 && args[2] == "--help") { return writeOutput(compileProfileHelp()); }
    // 缺省目标为宿主（编译画像不运行产物，--target 可改）。
    let entry = ""; let top = 20; let sort = 0; let t = hostTargetId(); let tool = false;
    let i = 2;
    while (i < len(args)) {
        const a = args[i];
        if (a == "--format=json" || a == "--format=text") {}
        else if (targetFlagHost(a) >= 0) { t = targetFlagHost(a); }
        else if (a == "--toolchain") { tool = true; }
        else if (a == "--sort=records") { sort = 0; }
        else if (a == "--sort=instructions") { sort = 1; }
        else if (a == "--sort=record-time") { sort = 2; }
        else if (a == "--top" && i + 1 < len(args)) {
            i = i + 1; top = nonnegative(args[i]); if (top < 0) { return usage(json, "--top 需要不溢出的非负整数"); }
        } else if (len(a) > 0 && (byteAt(a, 0) catch 0) != 45 && len(entry) == 0) { entry = a; }
        else { return usage(json, "不支持的参数 " + a); }
        i = i + 1;
    }
    if (len(entry) == 0) { return usage(json, "缺少待分析源文件"); }
    drvSetToolchain(tool);
    const kernel = kernelOf(t);
    const r = collectCompileProfile(entry, t, kernel);
    let writeCode = 0;
    if (json) { writeCode = writeOutput(compileProfileJson(r, top, sort)); }
    else if (r.ok) { writeCode = writeOutput(compileProfileText(r, top, sort)); }
    else { eprint(compileProfileText(r, top, sort)); }
    if (writeCode != 0) { return writeCode; }
    if (!r.ok) { return 1; } return 0;
}
