import { BrowserController, controllerNew, controllerTick, controllerClose } from "../examples/browser/controller";
import { navigationOpen, navigationLink, navigationStop, navigationStep } from "../examples/browser/navigation";

function tick(controller: Ref<BrowserController>, count: int): void { let i = 0; while (i < count) { controllerTick(controller) catch panic("tick"); i = i + 1; } }
function generationCase(): void {
    const controller = controllerNew(true, listNew(), 1000) catch panic("controller"); defer controllerClose(controller); const state = controller.navigation;
    navigationOpen(state, "https://example.test/a") catch panic("a"); tick(controller, 1); assert(state.loading && controller.demoActive != None && controller.version == 1, "pending page leaves GUI display version unchanged");
    tick(controller, 2); assert(!state.loading && state.content.title == "DEMO A" && controller.version == 2, "fixed completion commits once");
    navigationOpen(state, "https://example.test/slow") catch panic("slow"); tick(controller, 1);
    navigationOpen(state, "https://example.test/b") catch panic("b"); tick(controller, 1);
    navigationOpen(state, "https://example.test/c") catch panic("c"); tick(controller, 3);
    assert(state.content.title == "DEMO C" && controller.started == 4 && controller.cancelled == 2 && controller.completed == 2, "rapid requests retain only the latest work");
    assert(listLen(state.history) == 3 && controller.job == None, "abandoned loads never commit history or create real network jobs in demo mode");
}
function localCase(): void {
    const controller = controllerNew(true, listNew(), 1000) catch panic("controller"); defer controllerClose(controller); const state = controller.navigation;
    navigationOpen(state, "https://example.test/a") catch panic("a"); tick(controller, 3); state.scroll = 123;
    navigationLink(state, "#section") catch panic("anchor"); tick(controller, 1);
    assert(controller.started == 1 && state.anchorPending && !state.loading, "fragment commits without a loader");
    assert(navigationStep(state, -1) catch panic("back"), "back"); tick(controller, 1);
    assert(controller.started == 1 && state.scroll == 123, "same-document history restores scroll without work");
    navigationOpen(state, "https://example.test/slow") catch panic("slow"); tick(controller, 1); navigationStop(state); tick(controller, 12);
    assert(!state.loading && controller.demoActive == None && state.content.url == "https://example.test/a", "stop cancels and excludes delayed completion");
}
function errorCase(): void {
    const controller = controllerNew(true, listNew(), 1000) catch panic("controller"); defer controllerClose(controller); const state = controller.navigation;
    navigationOpen(state, "https://example.test/error") catch panic("error"); tick(controller, 3);
    assert(!state.loading && state.content.title == "Navigation failed" && state.content.url == "https://example.test/error" && len(state.content.error) > 0, "failure owns its URL and document");
    navigationOpen(state, "about:home") catch panic("home"); tick(controller, 1); assert(!state.loading && state.content.url == "about:home" && controller.started == 1, "internal home never starts a worker");
}
test "Browser controller: fixed completion and latest request" { generationCase(); }
test "Browser controller: local navigation, history and stop" { localCase(); }
test "Browser controller: independent errors and home" { errorCase(); }
export function main(args: []string): int { generationCase(); localCase(); errorCase(); print("browser controller: latest request, local paths and errors OK"); return 0; }
