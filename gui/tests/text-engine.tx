// text-engine —— 文字引擎守护（GUI 原生引擎 G1）：
// ① 嵌入字体覆盖 tests/font/cjk-chars.txt 的全部 3996 个码位（缺一个即 .notdef 方块）；
// ② 字体是不可信输入：嵌入字体（CFF）与测试字体（glyf）截到若干长度、在若干位置改写字节后，
//    载入、度量、绘制都不得 trap——载入失败得 -1，载入成功的照常度量与绘制（坏字形画不出即跳过）；
// ③ 度量与连字：fi 连成一个字形，同串两次度量相同。
// 输出逐行确定（三端相同）。运行：taixu run tests/text-engine.tx（仓根为当前目录）
import { Font, fontParse, glyphOf } from "gui/engine/sfnt";
import { textFontLoad, textFontFree, textMeasure, textDraw, textEmbedded } from "gui/engine/text";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256 } from "gui/surface";

function codepoints(t: string): List<int> {
    const out: List<int> = listNew();
    let i: int = 0;
    while (i < len(t)) {
        const c: int = byteTryAt(t, i) catch 0;
        if (c < 128) {
            listPush(out, c);
            i = i + 1;
        } else if (c < 224) {
            listPush(out, ((c & 31) << 6) | ((byteTryAt(t, i + 1) catch 0) & 63));
            i = i + 2;
        } else if (c < 240) {
            listPush(out, ((c & 15) << 12) | (((byteTryAt(t, i + 1) catch 0) & 63) << 6) | ((byteTryAt(t, i + 2) catch 0) & 63));
            i = i + 3;
        } else {
            listPush(out, ((c & 7) << 18) | (((byteTryAt(t, i + 1) catch 0) & 63) << 12) | (((byteTryAt(t, i + 2) catch 0) & 63) << 6) | ((byteTryAt(t, i + 3) catch 0) & 63));
            i = i + 4;
        }
    }
    return out;
}

// 截断与篡改的变体：载入、度量、绘制；返回载入成功的个数。
function abuse(name: string, data: Bytes, surf: int): int {
    const n: int = bytesLen(data);
    let loaded: int = 0;
    let total: int = 0;
    const cuts: List<int> = listNew();
    for (c in [0, 4, 12, 100, 1000, 50000, n / 2, n - 1]) {
        listPush(cuts, c);
    }
    for (c in cuts) {
        const h: int = textFontLoad(bytesSlice(data, 0, c));
        total = total + 1;
        if (h > 0) {
            loaded = loaded + 1;
            textMeasure(h, 16, "Taixu 太虚 fi");
            textDraw(surf, h, 16, "Taixu 太虚 fi", 2, 2, 0xFFFFFF);
            textFontFree(h);
        }
    }
    let k: int = 0;
    while (k < 48) {
        const bad = bytesSlice(data, 0, n);
        let j: int = 0;
        while (j < 16) {
            bytesSet(bad, ((k * 16 + j) * 7919 + k * 104729) % n, (k * 31 + j * 17) % 256);
            j = j + 1;
        }
        const h: int = textFontLoad(bad);
        total = total + 1;
        if (h > 0) {
            loaded = loaded + 1;
            textMeasure(h, 16, "Taixu 太虚 fi 字体");
            textDraw(surf, h, 16, "Taixu 太虚 fi 字体", 2, 20, 0xFFFFFF);
            textFontFree(h);
        }
        k = k + 1;
    }
    print(name + " variants=" + toStr(total) + " loaded=" + toStr(loaded));
    return loaded;
}

export function main(args: []string): int {
    args;
    const emb = textEmbedded();
    const f: Font = fontParse(emb) catch (e) {
        print("embedded parse failed: " + e.message);
        return 1;
    };
    const chars: string = readFile("tests/font/cjk-chars.txt") catch "";
    let missing: int = 0;
    let count: int = 0;
    for (cp in codepoints(chars)) {
        count = count + 1;
        if (glyphOf(f, cp) == 0) {
            missing = missing + 1;
        }
    }
    print("cjk chars=" + toStr(count) + " missing=" + toStr(missing));

    const h: int = textFontLoad(emb);
    // 14 号的 profile：fi 连成一个字形时宽 39（不连为 38；form 的分组框缺口按 39 排）。
    const w1: int = textMeasure(h, 14, "profile");
    print("profile=" + toStr(w1) + " again=" + toStr(textMeasure(h, 14, "profile")) + " 太虚=" + toStr(textMeasure(h, 14, "太虚")));
    print("size0=" + toStr(textMeasure(h, 0, "x")) + " badfont=" + toStr(textMeasure(99, 16, "x")) + " empty=" + toStr(textMeasure(h, 16, "")));
    textFontFree(h);

    const surf: int = surfaceOpen(160, 40) catch (e) {
        print("surface failed");
        return 1;
    };
    surfaceClear(surf, 0x000000);
    abuse("cff", emb, surf);
    const ttf = readFileBytes("tests/font/text-font.ttf") catch bytesNew(0);
    abuse("glyf", ttf, surf);
    print("sha=" + surfaceSha256(surf));
    surfaceClose(surf);
    return 0;
}
