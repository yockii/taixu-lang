// 异步守护（D3 v0.53 改）：main 体内可直接 await，但其中嵌套的普通箭头不行（箭头不继承外层的 await 资格）→ 3024。
function main(args: []string): int {
    const v = await job(1) catch 0;
    const f = (): int => {
        const w = await job(2) catch 0;
        return w;
    };
    return v + f();
}

async function job(n: int): int {
    return n;
}
