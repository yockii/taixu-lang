// Hidden native window; messages travel through the Windows message queue.
import { windowOpenEx, windowWaitEvent, windowClose, windowScale, eventWindowTarget, eventWindowX, eventWindowY } from "gui/surface";
import { platDebugPost } from "gui/engine/platform";

declare struct POINT { x: i32, y: i32 }
declare function FindWindowW(cls: wstr, title: wstr): usize from "user32";
declare function ClientToScreen(h: usize, p: Ref<POINT>): i32 from "user32";
declare function SetWindowPos(h: usize, after: usize, x: i32, y: i32, cx: i32, cy: i32, flags: u32): i32 from "user32";
declare function GetCurrentProcessId(): u32 from "kernel32";

function packed(x: int, y: int): int { return ((y & 65535) << 16) | (x & 65535); }
function near(a: int, b: int): bool { return a - b <= 1 && b - a <= 1; }
export function main(args: []string): int {
    const title = "Taixu hidden wheel " + toStr(GetCurrentProcessId());
    const id = windowOpenEx(title, 240, 160, 16); assert(id > 0, "hidden native window");
    const hwnd = FindWindowW("TaixuGui", title); assert(hwnd != 0, "find own hidden window");
    assert(SetWindowPos(hwnd, 0, -300, -200, 0, 0, 21) != 0, "negative screen coordinates");
    const point = new POINT { x: 40, y: 30 }; assert(ClientToScreen(hwnd, point) != 0 && point.x < 0 && point.y < 0, "signed screen point");
    const position = packed(point.x as int, point.y as int);
    assert(platDebugPost(id, 0x020A, packed(0, 120), position) == 0, "post up");
    assert(platDebugPost(id, 0x020A, packed(0, -120), position) == 0, "post down");
    let j = 0; while (j < 3) { assert(platDebugPost(id, 0x020A, packed(0, 1), position) == 0, "post fraction"); j = j + 1; }
    let found = 0; let tries = 0; const k = windowScale(id);
    while (tries < 64) {
        const kind = windowWaitEvent(id, 0); if (kind == 0) { break; }
        if (kind == 9) {
            let expected = -40; if (found == 1) { expected = 40; } else if (found == 2) { expected = -1; }
            assert(found < 3 && eventWindowTarget(id) == expected, "direction and retained sub-DIP remainder");
            assert(near(eventWindowX(id), (4000 + k / 2) / k) && near(eventWindowY(id), (3000 + k / 2) / k), "screen to client DIP");
            found = found + 1;
        } tries = tries + 1;
    }
    windowClose(id); assert(found == 3, "all native wheel events");
    print("wheel Windows: signed coordinates, direction and fractions OK"); return 0;
}
