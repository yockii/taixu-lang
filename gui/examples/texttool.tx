// texttool —— 文本小工具（实战件②——输入体验完形样本）：
// 单行编辑器（inputOnKeys 全键面：可打印/退格删词/ctrl+退格/Home-End/
// shift 延伸选区/ctrl+A）＋ inputOnMouse 鼠标拖选（扩面位）＋
// 剪贴板 ctrl+C/V/X（引擎绑定消费面——升格兑现）＋ multiline
// 回显区（回车提交行→wrapText 折行显示）。
//
// 确定性校验：
//   TAIXU_REPLAY=tests/text-edit.txt TAIXU_FRAME=20 TAIXU_OUT_DIR=tests/.rv-out taixu run examples/texttool.tx
// 剪贴板＝I/O 边界：重放内 ctrl+C→ctrl+V 板面往返（同会话自给，外部无
// 写入即确定）；golden 帧回显动作计数（copied/pasted）与选区长度，不直
// 接渲染板面原文以外的内容。
import { Canvas, Input, input, drawInputC, inputValue, drawMultiline, paintText, paintFillRect, inputSelLo, inputSelHi, inputDeleteSelection, EV_MOD_CTRL } from "gui/components";
import { App, appNew, appClose, pump, hitZone, onClick, onHotkey, onResize, inputOnKeys, inputOnMouse, syncFocus, clipboardSet, clipboardGet, textCursor, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { join } from "std/string";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_IN: int = 4;
const ID_CLR: int = 5;

struct TextModel {
    inp: Ref<Input>,
    lines: List<string>,
    copied: int,
    pasted: int,
    surface: int, // 经 Ref 持有——onResize 闭包按值捕获，须过引用改写
}

// 编辑器缓冲 → 字符串（List<string> 逐码元拼接——join 单一事实源）。
function charsOf(inp: Ref<Input>): string {
    return join(inp.chars, "");
}

function selText(m: Ref<TextModel>): string {
    const lo: int = inputSelLo(m.inp);
    const hi: int = inputSelHi(m.inp);
    if (lo < 0) {
        return "";
    }
    const part: List<string> = listNew();
    let i: int = lo;
    while (i < hi) {
        listPush(part, listTryGet(m.inp.chars, i) catch "");
        i = i + 1;
    }
    return join(part, "");
}

function selLen(m: Ref<TextModel>): int {
    const lo: int = inputSelLo(m.inp);
    const hi: int = inputSelHi(m.inp);
    if (lo < 0) {
        return 0;
    }
    return hi - lo;
}

// 整缓冲重建（paste 替换选区面：prefix+clip+suffix 重排——与键入替换
// 同模型，anchor 归一）。
function rebuildWith(m: Ref<TextModel>, text: string, atLo: int, atHi: int): void {
    const full: string = charsOf(m.inp);
    const head: string = headOf(full, atLo);
    const tailStr: string = tailOf(full, atHi);
    const merged: string = head + text + tailStr;
    m.inp.chars = listNew();
    let i: int = 0;
    while (i < len(merged)) {
        listPush(m.inp.chars, utf8Encode(byteTryAt(merged, i) catch 32) catch "?");
        i = i + 1;
    }
    m.inp.cursor = len(head) + len(text);
    m.inp.anchor = -1;
    m.inp.select = false;
}

function headOf(s: string, upto: int): string {
    const part: List<string> = listNew();
    let i: int = 0;
    while (i < upto && i < len(s)) {
        listPush(part, utf8Encode(byteTryAt(s, i) catch 32) catch "?");
        i = i + 1;
    }
    return join(part, "");
}

function tailOf(s: string, from: int): string {
    const part: List<string> = listNew();
    let i: int = from;
    while (i < len(s)) {
        listPush(part, utf8Encode(byteTryAt(s, i) catch 32) catch "?");
        i = i + 1;
    }
    return join(part, "");
}

function doCopy(m: Ref<TextModel>): void {
    const s: string = selText(m);
    if (len(s) == 0) {
        return;
    }
    if (clipboardSet(s)) {
        m.copied = m.copied + 1;
    }
}

function doPaste(m: Ref<TextModel>): void {
    const clip: string = clipboardGet();
    if (len(clip) == 0) {
        return;
    }
    const lo: int = inputSelLo(m.inp);
    const hi: int = inputSelHi(m.inp);
    let a: int = lo;
    let b: int = hi;
    if (a < 0) {
        a = m.inp.cursor;
        b = m.inp.cursor;
    }
    rebuildWith(m, clip, a, b);
    m.pasted = m.pasted + 1;
}

function doCut(m: Ref<TextModel>): void {
    doCopy(m);
    inputDeleteSelection(m.inp);
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<TextModel>): void {
    surfaceClear(cv.h, 0x14181E);
    const w: int = app.w;
    const h: int = app.h;
    paintText(cv, 8, 4, 0xC8D8E8, "taixu texttool");
    m.inp.x = 8;
    m.inp.y = 22;
    m.inp.w = w - 16;
    syncFocus(app, m.inp);
    drawInputC(cv, m.inp);
    hitZone(app, ID_IN, 8, 22, w - 16, 20);
    // 回显区（multiline——wrapText 折行；提交行模型）。
    paintFillRect(cv, 8, 50, w - 16, 1, 0x2A3642);
    const body: string = join(m.lines, "\n");
    drawMultiline(cv, 8, 58, w - 16, 14, body, 0xAFC8D8);
    paintText(cv, 8, h - 22, 0x88A0B0, "lines=" + toStr(listLen(m.lines)) + " sel=" + toStr(selLen(m)) + " copied=" + toStr(m.copied) + " pasted=" + toStr(m.pasted));
}

export function main(args: []string): int {
    args;
    const spec = defaultSpec("taixu texttool", 320, 240);
    const app = appNew(spec);
    const m: Ref<TextModel> = new TextModel {
        inp: input(ID_IN, 8, 22, 200, ""),
        lines: listNew(),
        copied: 0,
        pasted: 0,
        surface: surfaceOpen(spec.w, spec.h) catch 0,
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    // 画布逐脏帧重建（surface 随 resize 换柄——v0.1.4 反馈 #5 白边根治）；
    // 注册期画布只供拖选换算用（与绘制同字体同字号，度量一致；柄不参与）。
    const cv0: Ref<Canvas> = textCanvas(m.surface, spec.w, spec.h, fb.handle, 14);
    textCursor(app, ID_IN);
    inputOnKeys(app, m.inp, (v: string): void => {
            if (len(v) > 0) {
                listPush(m.lines, v);
            }
            m.inp.chars = listNew();
            m.inp.cursor = 0;
            m.inp.anchor = -1;
        });
    inputOnMouse(app, m.inp, cv0, 8, 22);
    // 组合键全键面（mods 位集消费方；VK：C=67 V=86 X=88）。
    onHotkey(app, EV_MOD_CTRL, 67, (): void => {
            doCopy(m);
        });
    onHotkey(app, EV_MOD_CTRL, 86, (): void => {
            doPaste(m);
        });
    onHotkey(app, EV_MOD_CTRL, 88, (): void => {
            doCut(m);
        });
    // resize 即失效：surface 随新客户区重建（counter 先例）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpen(w, h) catch 0;
        });
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvas(m.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("lines=" + toStr(listLen(m.lines)) + " copied=" + toStr(m.copied) + " pasted=" + toStr(m.pasted) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
