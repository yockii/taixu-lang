// D3 v0.52 §6.5：string 的 < <= > >= 按字节字典序，UTF-8 下即码点序（同 Go、Rust；不同于 JS 按 UTF-16
// 码元比，｡ 与 😀 在 JS 里是反序）；strCompare(a, b) 在前得 -1、相等得 0、在后得 1；两侧自左向右求值。期望值由 Python
// 独立算出。
let trace: string = "";

function t(s: string): string {
    trace = trace + s;
    return s;
}

export function main(args: []string): int {
    print(toStr("a" < "b") + " " + toStr("b" < "a") + " " + toStr("ab" < "abc") + " " + toStr("" < "a") + " " + toStr("a" <= "a") + " " + toStr("a" >= "b") + " " + toStr("Z" < "a"));
    print(toStr("中" > "z") + " " + toStr("一" < "二") + " " + toStr("é" < "😀") + " " + toStr("｡" < "😀") + " " + toStr("abc" > "abd"));
    print(toStr(strCompare("a", "b")) + " " + toStr(strCompare("b", "a")) + " " + toStr(strCompare("x", "x")) + " " + toStr(strCompare("", "")) + " " + toStr(strCompare("abc", "ab")) + " " + toStr(strCompare("太", "虚")));
    if (t("b") > t("a") && t("c") >= t("c")) { trace = trace + "!"; }
    print(trace);
    const xs: List<string> = ["banana", "Apple", "苹果", "apple", "", "app", "｡", "😀"];
    let i = 1;
    while (i < listLen(xs)) {
        const v = listGet(xs, i);
        let j = i - 1;
        while (j >= 0 && listGet(xs, j) > v) {
            listSet(xs, j + 1, listGet(xs, j));
            j = j - 1;
        }
        listSet(xs, j + 1, v);
        i = i + 1;
    }
    let line = "";
    for (x in xs) { line = line + "[" + x + "]"; }
    print(line);
    const lo = "x" < "y" ? "x" : "y";
    print(lo);
    return 0;
}
