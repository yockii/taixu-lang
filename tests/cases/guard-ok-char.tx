// 正例守护（TEST-02 / LANG-16）：字符字面量——int 码点＋转义集＋字节比较锚。
export function main(args: []string): int {
    const s = "abc";
    let hits = 0;
    for (let i = 0; i < 3; i = i + 1) {
        if ((byteAt(s, i) catch 0) == 'a' + i) { hits = hits + 1; }
    }
    if (hits != 3) { return 1; }
    const nl = '\n';
    const tab = '\t';
    const cr = '\r';
    const bs2 = '\\';
    const q = '\'';
    const z = '\0';
    if (nl != 10 || tab != 9 || cr != 13 || bs2 != 92 || q != 39 || z != 0) { return 2; }
    print("char-ok " + toStr('a') + toStr(q) + toStr(z));
    return 0;
}
