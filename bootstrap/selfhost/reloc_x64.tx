// x86_64 的 RELA 语义（x86-64 psABI；目标分层 X3a 从 link_objects.tx 拆出）：R_X86_64_64／PC32／PLT32／32／32S。sa = S+A（与
// S+A−P）以 64 位环绕计算，32 位的几种再核对范围，同 lld。施加函数返回空串为成功，否则为拒绝的原因（由 link_objects.tx 记下）。
import { relocPatch } from "./reloc_bits";

/// 重定位改写的字节数：R_X86_64_64 为 8，其余 4。
export function x64RelocWidth(kind: int): int {
    if (kind == 1) { return 8; }
    return 4;
}

/// 重定位的目标恰是符号本身：PC32／PLT32 的加数只含 PC 偏置（−4 减去位移之后的立即数长度 0～4），别的为 0。
export function x64RelocExact(kind: int, addend: int): bool {
    if (kind == 2 || kind == 4) { return addend >= -8 && addend <= -4; }
    return addend == 0;
}

/// 施加一项：sa = S+A，site = P（虚拟地址），fileAt 为 out 里的位置；64 位绝对地址的位置记入 absSites。
export function x64Relocate(out: Bytes, fileAt: int, site: int, kind: int, sa: int, absSites: List<int>): string {
    if (kind == 1) {
        relocPatch(out, fileAt, sa, 8);
        listPush(absSites, site);
        return "";
    }
    if (kind == 2 || kind == 4) {
        const v = wrapSub(sa, site);
        if (v < -2147483648 || v > 2147483647) { return "RelativeRelocationOutOfRange"; }
        relocPatch(out, fileAt, v, 4);
        return "";
    }
    if (kind == 10) {
        if (sa < 0 || sa > 4294967295) { return "AbsoluteRelocationOutOfRange"; }
        relocPatch(out, fileAt, sa, 4);
        return "";
    }
    if (kind == 11) {
        if (sa < -2147483648 || sa > 2147483647) { return "AbsoluteRelocationOutOfRange"; }
        relocPatch(out, fileAt, sa, 4);
        return "";
    }
    return "UnsupportedRelocation:" + toStr(kind);
}
