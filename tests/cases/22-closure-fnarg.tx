// LANG-09 回归（V0.17-G1 执行发现；V0.9-L 起潜伏）：闭包体内**调用捕获的
// 函数值**——帧窗口校正不动点的闭包值链正反馈发散（codegen fixpoint：
// max_closure 与闭包体自身 reg_count 互相充值）。修复＝迭代轮次以闭包数+2
// 为静态链深上界（更深的运行期互递归沿直接递归同款栈容量兜底纪律）。
// 本用例为最小复现形态：捕获 fn 值调用＋捕获 Ref 变异＋嵌套闭包返回。

function apply(g: (int) => int, v: int): int {
    return g(v);
}

function wrap(step: (int) => int): (int) => int {
    // 闭包体调用捕获的函数值 step——修复前 sema/codegen 死循环挂起点。
    const h = (n: int): int => {
        return step(n + 1);
    };
    return h;
}

export function main(args: []string): int {
    args;
    const base: Ref<Counter2> = new Counter2 { v: 10 };
    const inc = (n: int): int => {
        base.v = base.v + 1; // 捕获 Ref 变异（既有面）
        return n * 2 + base.v;
    };
    const chained = wrap(inc); // 闭包值作实参＋闭包体调用捕获 fn（回归面）
    print(toStr(chained(3))); // inc(4) = 8 + 11 = 19
    print(toStr(chained(4))); // inc(5) = 10 + 12 = 22
    print(toStr(apply((k: int): int => k + 100, 1))); // 101（具名直调 fn 实参）
    print(toStr(base.v)); // 12
    return 0;
}

struct Counter2 {
    v: int,
}
