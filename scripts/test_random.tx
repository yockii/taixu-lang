// 与 Python 的 random.Random 逐值相同的伪随机数（service-sequence 等带种子的 fuzz 门复现原序列用；独立实现，不导入
// 编译器模块）。MT19937（Matsumoto 与 Nishimura 1998 的 init_genrand、init_by_array、genrand_int32），整数种子按 Python 的 seed()：
// 取绝对值，按 32 位从低到高切成 key（0 为 [0]）再 init_by_array；random() 为 genrand_res53；randbelow(n) 取 n 的位数 k、
// getrandbits(k)（32 位以内为高 k 位）直到小于 n；randint、choice、choices（累计权重、random()×总和、bisect_right）、randbytes 同 Python 3。
// 中间值都在 2^63 以内（乘数小于 2^31、被乘数小于 2^32）。

const N: int = 624;
const M: int = 397;
const MASK32: int = 4294967295;
const MATRIX_A: int = 2567483615;
const UPPER: int = 2147483648;
const LOWER: int = 2147483647;

export struct Rng {
    mt: List<int>,
    mti: int,
}

function initGenrand(r: Ref<Rng>, s: int): void {
    listSet(r.mt, 0, s & MASK32);
    let i = 1;
    while (i < N) {
        const prev = listGet(r.mt, i - 1) catch 0;
        listSet(r.mt, i, (1812433253 * (prev ^ (prev >> 30)) + i) & MASK32);
        i = i + 1;
    }
    r.mti = N;
}

function initByArray(r: Ref<Rng>, key: List<int>): void {
    initGenrand(r, 19650218);
    let i = 1;
    let j = 0;
    let k = N;
    if (listLen(key) > k) {
        k = listLen(key);
    }
    while (k > 0) {
        const prev = listGet(r.mt, i - 1) catch 0;
        const cur = listGet(r.mt, i) catch 0;
        listSet(r.mt, i, ((cur ^ ((prev ^ (prev >> 30)) * 1664525)) + (listGet(key, j) catch 0) + j) & MASK32);
        i = i + 1;
        j = j + 1;
        if (i >= N) {
            listSet(r.mt, 0, listGet(r.mt, N - 1) catch 0);
            i = 1;
        }
        if (j >= listLen(key)) {
            j = 0;
        }
        k = k - 1;
    }
    k = N - 1;
    while (k > 0) {
        const prev = listGet(r.mt, i - 1) catch 0;
        const cur = listGet(r.mt, i) catch 0;
        listSet(r.mt, i, ((cur ^ ((prev ^ (prev >> 30)) * 1566083941)) - i) & MASK32);
        i = i + 1;
        if (i >= N) {
            listSet(r.mt, 0, listGet(r.mt, N - 1) catch 0);
            i = 1;
        }
        k = k - 1;
    }
    listSet(r.mt, 0, UPPER);
}

// 同 random.Random(seed)（整数种子）。
export function rngNew(seed: int): Ref<Rng> {
    const mt: List<int> = listNew();
    let i = 0;
    while (i < N) {
        listPush(mt, 0);
        i = i + 1;
    }
    const r = new Rng { mt: mt, mti: N + 1 };
    let a = seed;
    if (a < 0) {
        a = -a;
    }
    const key: List<int> = listNew();
    if (a == 0) {
        listPush(key, 0);
    }
    while (a > 0) {
        listPush(key, a & MASK32);
        a = a >> 32;
    }
    initByArray(r, key);
    return r;
}

function mix(a: int, b: int): int {
    return (a & UPPER) | (b & LOWER);
}

function twist(y: int): int {
    if ((y & 1) != 0) {
        return (y >> 1) ^ MATRIX_A;
    }
    return y >> 1;
}

// genrand_int32：一个 32 位无符号数。
export function rngU32(r: Ref<Rng>): int {
    if (r.mti >= N) {
        let kk = 0;
        while (kk < N - M) {
            const y = mix(listGet(r.mt, kk) catch 0, listGet(r.mt, kk + 1) catch 0);
            listSet(r.mt, kk, (listGet(r.mt, kk + M) catch 0) ^ twist(y));
            kk = kk + 1;
        }
        while (kk < N - 1) {
            const y = mix(listGet(r.mt, kk) catch 0, listGet(r.mt, kk + 1) catch 0);
            listSet(r.mt, kk, (listGet(r.mt, kk + M - N) catch 0) ^ twist(y));
            kk = kk + 1;
        }
        const y = mix(listGet(r.mt, N - 1) catch 0, listGet(r.mt, 0) catch 0);
        listSet(r.mt, N - 1, (listGet(r.mt, M - 1) catch 0) ^ twist(y));
        r.mti = 0;
    }
    let y = listGet(r.mt, r.mti) catch 0;
    r.mti = r.mti + 1;
    y = y ^ (y >> 11);
    y = y ^ ((y << 7) & 2636928640);
    y = y ^ ((y << 15) & 4022730752);
    y = y ^ (y >> 18);
    return y & MASK32;
}

// randbytes(n)：getrandbits(8n) 的小端字节——每 4 字节取一个 32 位字、低字节在前，末尾不足 4 字节的那个字先右移 32－8×余数
// （getrandbits 只留高位）；n 为 0 时不取数。
export function rngBytes(r: Ref<Rng>, n: int): Bytes {
    const out = bytesNew(0);
    let left = n;
    while (left > 0) {
        let w = rngU32(r);
        let k = 4;
        if (left < 4) {
            w = w >> (32 - 8 * left);
            k = left;
        }
        let j = 0;
        while (j < k) {
            bytesPush(out, (w >> (8 * j)) & 255);
            j = j + 1;
        }
        left = left - k;
    }
    return out;
}

// random()：[0, 1) 的 53 位浮点。
export function rngRandom(r: Ref<Rng>): float {
    const a = rngU32(r) >> 5;
    const b = rngU32(r) >> 6;
    return ((a * 67108864 + b) as float) / 9007199254740992.0;
}

function bitLength(n: int): int {
    let k = 0;
    let v = n;
    while (v > 0) {
        k = k + 1;
        v = v >> 1;
    }
    return k;
}

// _randbelow(n)：[0, n)，n 须为正且小于 2^32。
export function rngBelow(r: Ref<Rng>, n: int): int {
    const k = bitLength(n);
    let v = rngU32(r) >> (32 - k);
    while (v >= n) {
        v = rngU32(r) >> (32 - k);
    }
    return v;
}

// randint(a, b)：[a, b]。
export function rngRandint(r: Ref<Rng>, a: int, b: int): int {
    return a + rngBelow(r, b - a + 1);
}

// choices(range(n), weights)[0]：按权重取下标。
export function rngWeighted(r: Ref<Rng>, weights: List<int>): int {
    const cum: List<int> = listNew();
    let total = 0;
    for (w in weights) {
        total = total + w;
        listPush(cum, total);
    }
    const x = rngRandom(r) * (total as float);
    const hi = listLen(cum) - 1;
    let i = 0;
    while (i < hi && ((listGet(cum, i) catch 0) as float) <= x) {
        i = i + 1;
    }
    return i;
}
