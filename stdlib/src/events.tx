// ============================================================================
// std/events —— 事件订阅分发面（V0.9-L2；D25 §六-2；GUI-11）。
//
// **回调仅限事件订阅面**（定档兑现：定时器/通用回调不入面）——分发循环
// = .tx 层模式：宿主事件记录（txp_window_event_record 族）→ 查注册表 →
// handler(rec)。注册表＝`Ref<Listener>` 平行 List（按注册序；注销＝置
// dead 旗标，分发跳过——List 无删除内建，标记法保持 token 稳定）。
//
// handler 签名冻结 `(EventRecord) => void`（EventRecord 为值语义 struct，
// 字段 kind/target/x/y 全 int——与宿主记录面一一对应）。target 即 GUI-10
// button id 预留位的消费键（组件 id → 注册 target，一一对应）。
// ============================================================================

// 宿主事件记录（值语义；与 platform 事件记录面字段一一对应）。
// **v1.1 增补（V0.18-M1；D48 §一）**：行尾追加 mods 修饰位集
//（shift=1/ctrl=2/alt=4）——旧构造点补 mods: 0 即零行为变化。
export struct EventRecord {
    kind: int,
    target: int,
    x: int,
    y: int,
    mods: int,
}

// 注册表条目（Ref 句柄入 List——List 元素冻结面含 Ref 与函数类型）。
export struct Listener {
    token: int,
    target: int,
    dead: bool,
    handler: (EventRecord) => void,
}

// 注册表本体（Ref 句柄语义：listenersNew 产生，赋值/传参共享）。
export struct ListenerTable {
    nextToken: int,
    items: List<Ref<Listener>>,
}

export function listenersNew(): Ref<ListenerTable> {
    const t: Ref<ListenerTable> = new ListenerTable {
        nextToken: 1,
        items: listNew(),
    };
    return t;
}

/// 注册：target（GUI-10 button id 等组件键）→ handler；返回注销用 token。
export function on(t: Ref<ListenerTable>, target: int, handler: (EventRecord) => void): int {
    const token: int = t.nextToken;
    t.nextToken = t.nextToken + 1;
    const l: Ref<Listener> = new Listener {
        token: token,
        target: target,
        dead: false,
        handler: handler,
    };
    listPush(t.items, l);
    return token;
}

/// 注销：按 token 置 dead（token 不存在返回 false；幂等——重复注销 false）。
export function off(t: Ref<ListenerTable>, token: int): bool {
    let found: bool = false;
    for (l in t.items) {
        if (l.token == token && !l.dead) {
            l.dead = true;
            found = true;
        }
    }
    return found;
}

/// 派发：按注册序对 target 相同的存活条目逐个调用 handler（返回派发数）。
/// handler 异常无隔离面（S1 无异常）；确定性＝注册序 × 注入序。
export function dispatch(t: Ref<ListenerTable>, rec: EventRecord): int {
    let n: int = 0;
    for (l in t.items) {
        if (l.dead) { continue; }
        if (l.target == rec.target) {
            l.handler(rec);
            n = n + 1;
        }
    }
    return n;
}

/// 存活条目数（诊断/断言面）。
export function listenersCount(t: Ref<ListenerTable>): int {
    let n: int = 0;
    for (l in t.items) {
        if (!l.dead) { n = n + 1; }
    }
    return n;
}
