// 开发门：复用原生 parser 的 AST，校验数据文件，不执行数据中的声明。
import { parseSource } from "../parser";

function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    const source = readFile(args[0]) catch (e) { eprint(e.message); return 1; };
    const ast = parseSource(source);
    if (strIndexOf(ast, "! ") >= 0 || strIndexOf(ast, "# notimpl") >= 0) { eprint(ast); return 1; }
    print(ast);
    return 0;
}
