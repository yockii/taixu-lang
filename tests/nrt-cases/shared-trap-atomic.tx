// 线程第 4c 步：经函数值带入的 Atomic 不能直接发送（只能经 Shared 跨线程，线程设计 §二十一-5）：闭包的环境类型
// 在可发送表里标为 2（只可共享），threadSpawn 时 trap 4021。
function main(args: []string): void {
    const a = atomicNew(1);
    const fs: List< () => int> = listNew();
    listPush(fs, (): int => atomicAdd(a, 1));
    const t = threadSpawn((): int => listLen(fs));
    print(toStr(threadJoin(t) catch -1));
}
