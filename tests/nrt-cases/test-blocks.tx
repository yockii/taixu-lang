// 原生 taixu test（D3 v0.21）：每个 test 块在独立进程中运行——trap 只判该 test 失败，
// 模块状态每个 test 重新初始化；test 里可用 v0.19 起的新语法（接口值、Map、defer）。
interface Named {
    name(): string;
}
struct Cat { n: string }
function catName(c: Cat): string { return c.n; }
function greet(x: Named): string { return "hi " + x.name(); }

let counter = 0;

test "接口值与 Map" {
    assert(greet(Cat { n: "mi" }) == "hi mi", "接口值调用");
    const m: Map< string, int> = mapNew();
    m.set("a", 1);
    assert((m.get("a") catch 0) == 1, "Map 取值");
}

test "模块状态每个 test 重新初始化" {
    counter = counter + 1;
    assert(counter == 1, "counter 应从 0 开始");
}

test "再次检查模块状态" {
    counter = counter + 1;
    assert(counter == 1, "counter 应从 0 开始");
}

test "trap 只判本 test 失败" {
    const xs: List< int> = listNew();
    assert(listLen(xs) == 1, "本用例故意失败");
}

test "defer 在 test 中执行" {
    let n = 0;
    defer { print("defer ran, n=" + toStr(n)); }
    n = n + 1;
    assert(n == 1, "n");
}
