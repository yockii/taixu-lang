// 线程第 4c 步：Shared<T>（线程设计 §四-4、§二十一）。sharedNew 把对象图深拷贝进进程级的共享块，原对象不受影响；
// 各线程经 sharedGet 取得冻结的对象图（每线程物化一次；字符串、Bytes 与数值 List 的载荷借用块，不拷贝）。句柄随
// 捕获、结果发送，也能嵌进别的 sharedNew；同一线程里句柄活着时 sharedGet 每次返回同一个根（值类型的根按值语义
// 交一份拷贝）。
struct Entry {
    name: string,
    tags: List< string>,
}

enum Kind {
    Small(n: int),
    Named(label: string),
}

struct Table {
    title: string,
    weights: List< int>,
    raw: Bytes,
    entries: List< Ref< Entry>>,
    kind: Kind,
}

struct Bundle {
    label: string,
    table: Shared< Ref< Table>>,
}

struct Pos {
    x: int,
    label: string,
}

function kindText(k: Kind): string {
    return switch (k) {
        case Small(n) => "small " + toStr(n),
        case Named(label) => "named " + label,
    };
}

function describe(t: Ref< Table>): string {
    let sum = 0;
    for (w in t.weights) {
        sum = sum + w;
    }
    let tags = 0;
    for (e in t.entries) {
        tags = tags + listLen(e.tags);
    }
    return t.title + " weights " + toStr(listLen(t.weights)) + " sum " + toStr(sum) + " raw " + toStr(bytesLen(t.raw)) + " entries " + toStr(listLen(t.entries)) + " tags " + toStr(tags) + " " + kindText(t.kind);
}

function makeTable(): Ref< Table> {
    const weights: List< int> = listNew();
    let i = 0;
    while (i < 100000) {
        listPush(weights, i % 7);
        i = i + 1;
    }
    const entries: List< Ref< Entry>> = listNew();
    i = 0;
    while (i < 50) {
        const tags: List< string> = listNew();
        listPush(tags, "t" + toStr(i));
        listPush(tags, "共享");
        listPush(entries, new Entry { name: "e" + toStr(i), tags: tags });
        i = i + 1;
    }
    return new Table { title: "表", weights: weights, raw: bytesFromStr("0123456789"), entries: entries, kind: Kind.Named("模型") };
}

function main(args: []string): void {
    const t = makeTable();
    const s = sharedNew(t);
    // 原对象不受影响，照常可写。
    listPush(t.weights, 1000);
    t.title = "改过的原表";
    print(t.title + " " + toStr(listLen(t.weights)));
    const a = sharedGet(s);
    print(describe(a));
    print("same root " + toStr(sharedGet(s) == a));
    const tags0: List< string> = listNew();
    const e0 = listGet(a.entries, 0) catch new Entry { name: "?", tags: tags0 };
    print(e0.name + " " + (listGet(e0.tags, 1) catch "?") + " " + toStr(bytesGet(a.raw, 9) catch -1));

    // 多个线程读同一个块（句柄随捕获发送）。
    const ths: List< Thread< string>> = listNew();
    let i = 0;
    while (i < 4) {
        const k = i;
        listPush(ths, threadSpawn((): string => toStr(k) + ": " + describe(sharedGet(s))));
        i = i + 1;
    }
    for (th in ths) {
        print(threadJoin(th) catch "join failed");
    }

    // 嵌套：Shared 放进另一个 sharedNew；线程里建的 Shared 作为结果发送回来。
    const b = sharedNew(new Bundle { label: "外层", table: s });
    const t2 = threadSpawn((): string => {
            const bb = sharedGet(b);
            return bb.label + " " + sharedGet(bb.table).title;
        });
    print(threadJoin(t2) catch "join failed");
    const t3 = threadSpawn((): Shared< List< string>> => {
            const xs: List< string> = listNew();
            listPush(xs, "来自");
            listPush(xs, "线程");
            return sharedNew(xs);
        });
    const empty: List< string> = listNew();
    const back = threadJoin(t3) catch sharedNew(empty);
    const xs = sharedGet(back);
    print(toStr(listLen(xs)) + " " + (listGet(xs, 0) catch "?") + (listGet(xs, 1) catch "?"));

    // 标量与字符串。
    print(toStr(sharedGet(sharedNew(42))) + " " + sharedGet(sharedNew("你好")));

    // 值类型的根按值语义：sharedGet 交一份拷贝，改拷贝不影响共享的数据。
    const sp = sharedNew(Pos { x: 1, label: "p" });
    let p1 = sharedGet(sp);
    p1.x = 5;
    print(toStr(p1.x) + " " + toStr(sharedGet(sp).x) + " " + p1.label);
}
