// 负例守护（D3 v0.52）：strSub／strIndexOf／strByteSub／strByteIndexOf 已移除，普通构建报 3001 并给逐字等价的改写。
export function main(args: []string): int {
    const s = "太虚abc";
    print(strSub(s, 0, 1));
    print(toStr(strIndexOf(s, "a")));
    print(strByteSub(s, 0, 3));
    print(toStr(strByteIndexOf(s, "a")));
    return 0;
}
