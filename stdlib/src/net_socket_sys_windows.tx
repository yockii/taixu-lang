import { socketAddressScoped } from "./net_socket_addr";

declare function WSAStartup(version: u16, data: Bytes): i32 from "ws2_32";
declare function WSACleanup(): i32 from "ws2_32";
declare function WSAGetLastError(): i32 from "ws2_32";
declare function WSASocketW(family: i32, kind: i32, protocol: i32, info: usize, group: u32, flags: u32): isize from "ws2_32";
declare function ioctlsocket(socket: isize, command: i32, value: Bytes): i32 from "ws2_32";
declare function connect(socket: isize, address: Bytes, length: i32): i32 from "ws2_32";
declare function recv(socket: isize, data: Bytes, length: i32, flags: i32): i32 from "ws2_32";
declare function send(socket: isize, data: Bytes, length: i32, flags: i32): i32 from "ws2_32";
declare function closesocket(socket: isize): i32 from "ws2_32";
declare function select(ignored: i32, read: Bytes, write: Bytes, except: Bytes, timeout: Bytes): i32 from "ws2_32";
declare function getsockopt(socket: isize, level: i32, option: i32, value: Bytes, length: Bytes): i32 from "ws2_32";

export function sysByteOpen(version: int, datagram: bool): int {
    const status = WSAStartup(514 as u16, bytesNew(512)); if (status != 0 as i32) { return -(status as int); }
    let family = 2; if (version == 6) { family = 23; } let kind = 1; if (datagram) { kind = 2; }
    const socket = WSASocketW(family as i32, kind as i32, 0 as i32, 0 as usize, 0 as u32, 129 as u32);
    if (socket == -1 as isize) { const code = WSAGetLastError() as int; WSACleanup(); return -code; }
    const mode = bytesNew(4); bytesSetLE<u32>(mode, 0, 1 as u32);
    if (ioctlsocket(socket, wrapTo<i32>(2147772030), mode) != 0 as i32) {
        const code = WSAGetLastError() as int; closesocket(socket); WSACleanup(); return -code;
    }
    return socket as int;
}
export function sysByteClose(socket: int): void { closesocket(socket as isize); WSACleanup(); }
export function sysByteConnect(socket: int, ip: Bytes, port: int, scope: int): int {
    const address = socketAddressScoped(ip, port, 23, false, scope) catch (e) { return -10022; };
    if (connect(socket as isize, address, bytesLen(address) as i32) == 0 as i32) { return 0; }
    const code = WSAGetLastError() as int;
    if (code == 10035 || code == 10036 || code == 10037 || code == 10004) { return 1; }
    if (code == 10056) { return 0; } return -code;
}
function ioResult(result: i32): int {
    if (result >= 0 as i32) { return result as int; }
    const code = WSAGetLastError() as int; if (code == 10035 || code == 10004) { return -2; } return -code;
}
export function sysByteRead(socket: int, data: Bytes): int { return ioResult(recv(socket as isize, data, bytesLen(data) as i32, 0 as i32)); }
export function sysByteWrite(socket: int, data: Bytes): int { return ioResult(send(socket as isize, data, bytesLen(data) as i32, 0 as i32)); }
function fdSet(socket: int, enabled: bool): Bytes {
    const set = bytesNew(520);
    if (enabled) { bytesSetLE<u32>(set, 0, 1 as u32); bytesSetLE<u64>(set, 8, socket as u64); } return set;
}
export function sysBytePoll(socket: int, writable: bool, timeoutMs: int): int {
    const read = fdSet(socket, !writable); const write = fdSet(socket, writable); const except = fdSet(socket, true); const time = bytesNew(8);
    bytesSetLE<i32>(time, 0, (timeoutMs / 1000) as i32); bytesSetLE<i32>(time, 4, ((timeoutMs % 1000) * 1000) as i32);
    const result = select(0 as i32, read, write, except, time);
    if (result < 0 as i32) { const code = WSAGetLastError() as int; if (code == 10004) { return 0; } return -code; }
    if (result > 0 as i32) { return 1; } return 0;
}
export function sysByteError(socket: int): int {
    const error = bytesNew(4); const length = bytesNew(4); bytesSetLE<i32>(length, 0, 4 as i32);
    if (getsockopt(socket as isize, 65535 as i32, 4103 as i32, error, length) != 0 as i32) { return -(WSAGetLastError() as int); }
    return (bytesGetLE<i32>(error, 0) catch (-1 as i32)) as int;
}
