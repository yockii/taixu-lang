import { x25519, x25519PublicKey } from "std/crypto/ecdh";
import { constantTimeEqual } from "std/crypto/subtle";
import { fieldDecode, fieldEncode, fieldAdd, fieldSub, fieldMul } from "std/crypto/field25519";

function hex(text: string): Bytes {
    const out = bytesNew(len(text) / 2); let i = 0;
    while (i < bytesLen(out)) {
        const a = byteAt(text, i * 2); const b = byteAt(text, i * 2 + 1);
        let av = a - 48; let bv = b - 48;
        if (a >= 97) { av = a - 87; } if (b >= 97) { bv = b - 87; }
        assert(av >= 0 && av < 16 && bv >= 0 && bv < 16, "hex fixture");
        bytesSet(out, i, av * 16 + bv); i = i + 1;
    }
    return out;
}

test "X25519：RFC 7748 双方公钥与共享密钥" {
    const alice = hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a");
    const bob = hex("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb");
    const ap = hex("8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a");
    const bp = hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f");
    const shared = hex("4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742");
    assert(constantTimeEqual(x25519PublicKey(alice) catch panic("Alice public"), ap), "Alice public");
    assert(constantTimeEqual(x25519PublicKey(bob) catch panic("Bob public"), bp), "Bob public");
    assert(constantTimeEqual(x25519(alice, bp) catch panic("Alice shared"), shared), "Alice shared");
    assert(constantTimeEqual(x25519(bob, ap) catch panic("Bob shared"), shared), "Bob shared");
    assert(constantTimeEqual(alice, hex("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a")), "private input unchanged");
    assert(constantTimeEqual(bp, hex("de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f")), "public input unchanged");
}

test "X25519：RFC 7748 单项与一次迭代" {
    const result = x25519(hex("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4"),
        hex("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c")) catch panic("RFC vector 1");
    assert(constantTimeEqual(result, hex("c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552")), "RFC vector 1");
    const result2 = x25519(hex("4b66e9d4d1b4673c5ad22691957d6af5c11b6421e0ea01d42ca4169e7918ba0d"),
        hex("e5210f12786811d3f4b7959d0538ae2c31dbe7106fc03c3efc4cd549c715a493")) catch panic("RFC vector 2");
    assert(constantTimeEqual(result2, hex("95cbde9476e8907d7aade45cb4b873f88b595a68799fa152e6f8f7647aac7957")), "RFC vector 2");
    const nine = bytesNew(32); bytesSet(nine, 0, 9);
    assert(constantTimeEqual(x25519(nine, nine) catch panic("iteration"), hex("422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079")), "one iteration");
}

function rejects(secret: Bytes, peer: Bytes): bool { x25519(secret, peer) catch (e) { return true; }; return false; }

test "X25519：独立实现与域算术的固定交叉向量" {
    const text = readFile("tests/vectors/crypto-ecdh.txt") catch panic("ECDH vectors");
    let shared = 0; let rejected = 0; let fields = 0;
    for (line in strSplit(text, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const parts = strSplit(line, " "); const kind = listGet(parts, 0);
        const a = hex(listGet(parts, 1)); const b = hex(listGet(parts, 2));
        if (kind == "field") {
            const fa = fieldDecode(a); const fb = fieldDecode(b);
            assert(constantTimeEqual(fieldEncode(fieldAdd(fa, fb)), hex(listGet(parts, 3))), "field add " + toStr(fields));
            assert(constantTimeEqual(fieldEncode(fieldSub(fa, fb)), hex(listGet(parts, 4))), "field sub " + toStr(fields));
            assert(constantTimeEqual(fieldEncode(fieldMul(fa, fb)), hex(listGet(parts, 5))), "field mul " + toStr(fields)); fields = fields + 1;
        } else if (kind == "reject") { assert(rejects(a, b), "low-order point " + toStr(rejected)); rejected = rejected + 1; }
        else {
            assert(kind == "shared", "vector type");
            assert(constantTimeEqual(x25519(a, b) catch panic("shared vector"), hex(listGet(parts, 3))), "shared " + toStr(shared)); shared = shared + 1;
        }
    }
    assert(shared == 33 && rejected == 7 && fields == 128, "all cross vectors");
}

test "X25519：钳位、最高位忽略及输入长度" {
    const scalar = bytesNew(32); const other = bytesNew(32);
    bytesSet(other, 0, 7); bytesSet(other, 31, 192);
    const a = x25519PublicKey(scalar) catch panic("clamp 1"); const b = x25519PublicKey(other) catch panic("clamp 2");
    assert(constantTimeEqual(a, b), "ignored scalar bits");
    const high = bytesSlice(a, 0, 32); bytesSet(high, 31, (bytesGet(high, 31) catch 0) | 128);
    assert(constantTimeEqual(x25519(other, a) catch panic("peer normal"), x25519(other, high) catch panic("peer high bit")), "ignored u high bit");
    assert(rejects(bytesNew(31), a) && rejects(scalar, bytesNew(33)), "invalid input lengths");
}
