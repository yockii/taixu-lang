// bootstrap/semamirror —— zig sema 全表位 .tx 镜像（V0.42-B1；BOOT-28 核心件；D91 v0.2 §五/§六）。
//
// 消费 `taixu dev-sein-dump` 产的 SEIN1 容器（display/node_count/AST-BIN/导入映射
// per 模块），自包含完成 zig sema 的全检查面镜像（registerModules 五相位＋
// checkModules 全检查面＋泛型单态化＋闭包综合＋for-in 解糖），发射与
// src/compiler/sema/sebin.zig oracle **逐字节恒等**的 SEB1 v1 文件。
//
// 节点键纪律（D91 v0.2 §五）：解析节点 ID＝AST-BIN 先序流位＋模块基座叠加；
// 合成节点 ID＝程序基座（Σ解析节点数）起检查期分配序——分配点与 zig 侧
// sema.zig 各创建点逐一镜像。表条目发射键升序；类型图 ID＝§6.3 根序首触
// 分配；intern 纪律＝对象同一性（每 mk 一新对象——serial 对应 zig arena 指针）。
//
// 自包含：不 import stdlib（SEIN 已带 AST-BIN，零 parser 依赖）。
// 用法：taixu run bootstrap/semamirror.tx <sein 路径> <seb1 输出路径>

import { CheckModule, CheckDiag, CheckEmbed, CheckResult } from "./selfhost/check_model";
import { checkGraphNew, checkGraphAdd, checkGraphPropagate } from "./selfhost/check_graph";
import { ffiTargetMessage, ffiVariadicFixed } from "./selfhost/ffi_target";

// ============================================================================
// §0 常量——ast_bin K 表（镜像锁定；漂移即探针红）
// ============================================================================

// —— 二元 op id（binOpId 镜像）——

// —— 一元 op id（unOpId 镜像）——

// —— Ty tag（sebin 发射 tag 同值；0..5＝单例基元）——

// —— Builtin id（sema.Builtin 枚举序＝expr_res builtin 载荷）——

// ============================================================================
// §1 字节游标与字符串工具
// ============================================================================

struct Cur {
    b: string,
    pos: int,
    n: int,
    tab: List<int>,
    ncp: int,
    chunks: List<string>,
}

function minInt(a: int, b: int): int {
    if (a < b) { return a; }
    return b;
}

function makeCur(b: string, prechunk: bool): Ref<Cur> {
    const tab: List<int> = listNew();
    const chunks: List<string> = listNew();
    let n: int = 0;
    const total = len(b);
    let ncp: int = 0;
    while (n < total) {
        if (n % 64 == 0) { listPush(tab, ncp); }
        const ch = byteAt(b, n) catch 0;
        if ((ch & 0xC0) != 0x80) {
            ncp = ncp + 1;
        }
        n = n + 1;
    }
    if (prechunk && total > 65536) {
        let cp: int = 0;
        while (cp < ncp) {
            const count = minInt(8192, ncp - cp);
            listPush(chunks, strSub(b, cp, count));
            cp = cp + count;
        }
    }
    return new Cur { b: b, pos: 0, n: total, tab: tab, ncp: ncp, chunks: chunks };
}

// 字节位→码点序：每 64 字节一处前缀计数，局部补扫。
function cpAt(c: Ref<Cur>, pos: int): int {
    if (pos >= c.n) { return c.ncp; }
    const block = pos / 64;
    let count = listGet(c.tab, block) catch 0;
    let i = block * 64;
    while (i < pos) {
        if (((byteAt(c.b, i) catch 0) & 0xC0) != 0x80) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

// 长输入以 8192 码点为段；短片段切片不再从整个 SEIN 起点扫描。
function curSlice(c: Ref<Cur>, from: int, count: int): string {
    if (listLen(c.chunks) > 0 && count >= 0) {
        const chunk = from / 8192;
        const off = from % 8192;
        if (off + count <= 8192 && chunk < listLen(c.chunks)) {
            return strSub(listGet(c.chunks, chunk) catch "", off, count);
        }
    }
    return strSub(c.b, from, count);
}

// dec ＋空格（支持 '-' 前导——tarray len -1 形）。
function cDec(c: Ref<Cur>): int {
    let neg: bool = false;
    if (c.pos < c.n) {
        const c0 = byteAt(c.b, c.pos) catch 0;
        if (c0 == 45) {
            neg = true;
            c.pos = c.pos + 1;
        }
    }
    let v: int = 0;
    while (c.pos < c.n) {
        const ch = byteAt(c.b, c.pos) catch 0;
        if (ch < 48 || ch > 57) { break; }
        v = v * 10 + (ch - 48);
        c.pos = c.pos + 1;
    }
    c.pos = c.pos + 1;
    if (neg) { return -v; }
    return v;
}

function peekDec(c: Ref<Cur>): int {
    const save = c.pos;
    const v = cDec(c);
    c.pos = save;
    return v;
}

// 原子串读入：len dec＋转义字节——反转义回原始串（render.escape 逆；非 ASCII
// 原样直通经码点切片拷贝——镜像 ast_bin_read.unescapeAtom）。
// V0.42-B1-④ 执行发现修复：原形以手工 cp 计数承接 strSub 全局码点位——
// 转义序列耗 2..4 缓冲码点却只进 1，转义引号后再遇 CJK 即错位切片
// （"A太" → "AA太"）。改为 cpAt(c, i) 现算（对数二分——位界恒码点界）。
function cStr(c: Ref<Cur>): string {
    const n = cDec(c);
    const end = c.pos + n;
    if (c.n > 65536 && n >= 0 && c.pos >= 0 && end <= c.n) {
        let scan: int = c.pos;
        let escaped: bool = false;
        while (scan < end) {
            if ((byteAt(c.b, scan) catch 0) == 92) { escaped = true; break; }
            scan = scan + 1;
        }
        if (!escaped) {
            const first = cpAt(c, c.pos);
            const last = cpAt(c, end);
            c.pos = end;
            return curSlice(c, first, last - first);
        }
    }
    if (n > 256) { return cStrLarge(c, end); }
    let acc: string = "";
    let i: int = c.pos;
    while (i < end) {
        const ch = byteAt(c.b, i) catch 0;
        if (ch == 92) {
            const nx = byteAt(c.b, i + 1) catch 0;
            if (nx == 120) {
                const hv = hexVal(byteAt(c.b, i + 2) catch 48);
                const lv = hexVal(byteAt(c.b, i + 3) catch 48);
                acc = acc + (utf8Encode(hv * 16 + lv) catch "");
                i = i + 4;
            } else if (nx == 92) {
                acc = acc + "\\";
                i = i + 2;
            } else if (nx == 34) {
                acc = acc + "\"";
                i = i + 2;
            } else {
                acc = acc + (utf8Encode(nx) catch "");
                i = i + 2;
            }
        } else if (ch < 0x80) {
            acc = acc + (utf8Encode(ch) catch "");
            i = i + 1;
        } else {
            let j: int = i + 1;
            while (j < end) {
                const c2 = byteAt(c.b, j) catch 0;
                if ((c2 & 0xC0) == 0x80) { j = j + 1; } else { break; }
            }
            const p0 = cpAt(c, i);
            let c1: int = c.ncp;
            if (j < c.n) { c1 = cpAt(c, j); }
            acc = acc + curSlice(c, p0, c1 - p0);
            i = j;
        }
    }
    c.pos = end;
    return acc;
}

// 长原子串按完整转义/码点分块；游标和UTF-8边界沿用短串路径。
function cStrLarge(c: Ref<Cur>, end: int): string {
    const parts: List<string> = listNew();
    let acc: string = "";
    let i: int = c.pos;
    while (i < end) {
        if (len(acc) >= 256) { listPush(parts, acc); acc = ""; }
        const ch = byteAt(c.b, i) catch 0;
        if (ch == 92) {
            const nx = byteAt(c.b, i + 1) catch 0;
            if (nx == 120) {
                const hv = hexVal(byteAt(c.b, i + 2) catch 48);
                const lv = hexVal(byteAt(c.b, i + 3) catch 48);
                acc = acc + (utf8Encode(hv * 16 + lv) catch "");
                i = i + 4;
            } else if (nx == 92) {
                acc = acc + "\\";
                i = i + 2;
            } else if (nx == 34) {
                acc = acc + "\"";
                i = i + 2;
            } else {
                acc = acc + (utf8Encode(nx) catch "");
                i = i + 2;
            }
        } else if (ch < 0x80) {
            acc = acc + (utf8Encode(ch) catch "");
            i = i + 1;
        } else {
            let j: int = i + 1;
            while (j < end) {
                const c2 = byteAt(c.b, j) catch 0;
                if ((c2 & 0xC0) == 0x80) { j = j + 1; } else { break; }
            }
            const p0 = cpAt(c, i);
            let c1: int = c.ncp;
            if (j < c.n) { c1 = cpAt(c, j); }
            acc = acc + curSlice(c, p0, c1 - p0);
            i = j;
        }
    }
    c.pos = end;
    listPush(parts, acc);
    return joinRange(parts, 0, listLen(parts));
}

// SEIN 容器串原子：同 cStr，但原子后恒随一个空格（容器惯例——TXB1 为
// 紧胶连，读面两式分立）。
function cStrS(c: Ref<Cur>): string {
    const s = cStr(c);
    if (c.pos < c.n) {
        const ch = byteAt(c.b, c.pos) catch 0;
        if (ch == 32) {
            c.pos = c.pos + 1;
        }
    }
    return s;
}

function hexVal(ch: int): int {
    if (ch >= 97) { return ch - 87; }
    if (ch >= 65) { return ch - 55; }
    return ch - 48;
}

// —— 发射面：render.escape 同构（转义集 \\ \" 空格与控制字符 0x00-0x1F/0x7F；
// \x 小写十六进制；非 ASCII 直通）——
function escapeRaw(c: Ref<Cur>, s: string): string {
    if (len(s) > 256) { return escapeRawLarge(c, s); }
    const nbytes = len(s);
    let plainPos: int = 0;
    while (plainPos < nbytes) {
        const ch = byteAt(s, plainPos) catch 0;
        if (ch == 92 || ch == 34 || ch == 32 || ch < 0x20 || ch == 0x7f) { break; }
        plainPos = plainPos + 1;
    }
    if (plainPos == nbytes) { return s; }
    const tab: List<int> = listNew();
    let n: int = 0;
    const total = len(s);
    let ncp: int = 0;
    while (n < total) {
        const ch = byteAt(s, n) catch 0;
        if ((ch & 0xC0) != 0x80) {
            listPush(tab, n);
            ncp = ncp + 1;
        }
        n = n + 1;
    }
    let acc: string = "";
    let cp: int = 0;
    let i: int = 0;
    while (i < total) {
        const ch = byteAt(s, i) catch 0;
        if (ch == 92) {
            acc = acc + "\\\\";
            i = i + 1;
            cp = cp + 1;
        } else if (ch == 34) {
            acc = acc + "\\\"";
            i = i + 1;
            cp = cp + 1;
        } else if (ch == 32) {
            acc = acc + "\\x20";
            i = i + 1;
            cp = cp + 1;
        } else if (ch < 0x20 || ch == 0x7f) {
            acc = acc + "\\x" + hex2(ch);
            i = i + 1;
            cp = cp + 1;
        } else if (ch < 0x80) {
            acc = acc + (utf8Encode(ch) catch "");
            i = i + 1;
            cp = cp + 1;
        } else {
            let j: int = i + 1;
            while (j < total) {
                const c2 = byteAt(s, j) catch 0;
                if ((c2 & 0xC0) == 0x80) { j = j + 1; } else { break; }
            }
            // 末码点边界（V0.42-B1-④ 执行发现修复）：j==total 时 cpAt2 二分
            // 落在末码点自身索引——尾切片长度 0，最末 CJK 码点整段丢失
            //（"add 基本行为" → "add 基本行"）；j 越尾须回码点总数。
            let c1: int = ncp;
            if (j < total) { c1 = cpAt2(tab, ncp, j); }
            acc = acc + strSub(s, cp, c1 - cp);
            cp = c1;
            i = j;
        }
    }
    return acc;
}

// 长串转义保持原字符表，限制局部增长串并均衡合并。
function escapeRawLarge(c: Ref<Cur>, s: string): string {
    const nbytes = len(s);
    let plainPos: int = 0;
    while (plainPos < nbytes) {
        const ch = byteAt(s, plainPos) catch 0;
        if (ch == 92 || ch == 34 || ch == 32 || ch < 0x20 || ch == 0x7f) { break; }
        plainPos = plainPos + 1;
    }
    if (plainPos == nbytes) { return s; }
    const tab: List<int> = listNew();
    let n: int = 0;
    const total = len(s);
    let ncp: int = 0;
    while (n < total) {
        const ch = byteAt(s, n) catch 0;
        if ((ch & 0xC0) != 0x80) {
            listPush(tab, n);
            ncp = ncp + 1;
        }
        n = n + 1;
    }
    const parts: List<string> = listNew();
    let acc: string = "";
    let cp: int = 0;
    let i: int = 0;
    while (i < total) {
        if (len(acc) >= 256) { listPush(parts, acc); acc = ""; }
        const ch = byteAt(s, i) catch 0;
        if (ch == 92) {
            acc = acc + "\\\\";
            i = i + 1;
            cp = cp + 1;
        } else if (ch == 34) {
            acc = acc + "\\\"";
            i = i + 1;
            cp = cp + 1;
        } else if (ch == 32) {
            acc = acc + "\\x20";
            i = i + 1;
            cp = cp + 1;
        } else if (ch < 0x20 || ch == 0x7f) {
            acc = acc + "\\x" + hex2(ch);
            i = i + 1;
            cp = cp + 1;
        } else if (ch < 0x80) {
            acc = acc + (utf8Encode(ch) catch "");
            i = i + 1;
            cp = cp + 1;
        } else {
            let j: int = i + 1;
            while (j < total) {
                const c2 = byteAt(s, j) catch 0;
                if ((c2 & 0xC0) == 0x80) { j = j + 1; } else { break; }
            }
            // 末码点边界（V0.42-B1-④ 执行发现修复）：j==total 时 cpAt2 二分
            // 落在末码点自身索引——尾切片长度 0，最末 CJK 码点整段丢失
            //（"add 基本行为" → "add 基本行"）；j 越尾须回码点总数。
            let c1: int = ncp;
            if (j < total) { c1 = cpAt2(tab, ncp, j); }
            acc = acc + strSub(s, cp, c1 - cp);
            cp = c1;
            i = j;
        }
    }
    listPush(parts, acc);
    return joinRange(parts, 0, listLen(parts));
}

function cpAt2(tab: List<int>, ncp: int, pos: int): int {
    let lo: int = 0;
    let hi: int = ncp;
    while (lo + 1 < hi) {
        const mid = (lo + hi) / 2;
        if ((listGet(tab, mid) catch 0) <= pos) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    return lo;
}

function hex2(v: int): string {
    const digits: string = "0123456789abcdef";
    return strSub(digits, (v / 16) % 16, 1) + strSub(digits, v % 16, 1);
}

// —— 输出缓冲：分段＋倍增拼接（parser.tx joinParts 同法）——
struct Out {
    parts: List<string>,
}

function outRaw(o: Ref<Out>, s: string): void {
    listPush(o.parts, s);
}

function outDec(o: Ref<Out>, v: int): void {
    listPush(o.parts, toStr(v) + " ");
}

function outBool(o: Ref<Out>, v: bool): void {
    if (v) {
        listPush(o.parts, "1 ");
    } else {
        listPush(o.parts, "0 ");
    }
}

// 字符串原子：转义长＋转义字节＋空格（sebin W.str 同构）。
function outStr(o: Ref<Out>, ctx: Ref<Cur>, raw: string): void {
    const esc = escapeRaw(ctx, raw);
    listPush(o.parts, toStr(len(esc)) + " " + esc + " ");
}

function outJoin(o: Ref<Out>): string {
    return joinRange(o.parts, 0, listLen(o.parts));
}

function joinRange(parts: List<string>, lo: int, hi: int): string {
    if (hi - lo <= 0) { return ""; }
    if (hi - lo == 1) { return listGet(parts, lo) catch ""; }
    // 3–4 leaves form one bytecode str_concat; one result allocation suffices.
    if (hi - lo == 3) {
        return (listGet(parts, lo) catch "") + (listGet(parts, lo + 1) catch "") + (listGet(parts, lo + 2) catch "");
    }
    if (hi - lo == 4) {
        return (listGet(parts, lo) catch "") + (listGet(parts, lo + 1) catch "") + (listGet(parts, lo + 2) catch "") + (listGet(parts, lo + 3) catch "");
    }
    const mid = lo + (hi - lo) / 2;
    return joinRange(parts, lo, mid) + joinRange(parts, mid, hi);
}

// ============================================================================
// §2 数据模型——AST 物化树＋类型表示＋sema 状态
// ============================================================================

struct Te {
    tag: int,
    name: string,
    a: Ref<Te>?,
    alen: int,
    ls: List<Ref<Te>>,
}

struct Param {
    name: string,
    ty: Ref<Te>,
    col: int,
}

struct Arm {
    id: int,
    isElse: bool,
    vname: string,
    patfs: List<string>,
    body: Ref<Expr>,
    line: int,
    col: int,
}

struct StructLitX {
    hint: string,
    hasHint: bool,
    targs: List<Ref<Te>>,
    fnames: List<string>,
    fvals: List<Ref<Expr>>,
    hintLine: int,
    hintCol: int,
}

struct ArrowX {
    params: List<Ref<Param>>,
    ret: Ref<Te>,
    isBlock: bool,
    bodyExpr: Ref<Expr>?,
    bodyBlock: Ref<Block>?,
    line: int,
    col: int,
    isAsync: bool,
}

struct NewX {
    isVariant: bool,
    lit: Ref<Expr>?,
    enumName: string,
    varName: string,
    args: List<Ref<Expr>>,
    vline: int,
    vcol: int,
}

struct CatchX {
    operand: Ref<Expr>,
    hasBinding: bool,
    binding: string,
    isBlock: bool,
    hExpr: Ref<Expr>?,
    hBlock: Ref<Block>?,
}

struct Expr {
    id: int,
    tag: int,
    line: int,
    col: int,
    s0: string,
    s1: string,
    i0: int,
    i1: int,
    i2: int,
    a: Ref<Expr>?,
    b: Ref<Expr>?,
    list: List<Ref<Expr>>,
    targs: List<Ref<Te>>,
    lit: Ref<StructLitX>?,
    arms: List<Ref<Arm>>,
    af: Ref<ArrowX>?,
    nb: Ref<NewX>?,
    cb: Ref<CatchX>?,
    ty: Ref<Te>?,
}

struct Binding {
    id: int,
    isConst: bool,
    name: string,
    ty: Ref<Te>?,
    init: Ref<Expr>,
    exported: bool,
    line: int,
    col: int,
}

struct AssignX {
    target: Ref<Expr>,
    value: Ref<Expr>,
    // 位置域（V0.42-B1-④）：FAB1 assign 记录原子面（.txc 行号表恒等依赖；
    // SEB1 不载——零表位影响）。
    line: int,
    col: int,
}

struct IfX {
    cond: Ref<Expr>,
    thenB: Ref<Block>,
    elseTag: int,
    elseB: Ref<Block>?,
    elseI: Ref<IfX>?,
    // 位置域（V0.42-B1-④）：FAB1 if 记录原子面（else-if 链的内层 if 无语句
    // 壳可依托——位置必须自持）。
    line: int,
    col: int,
}

struct WhileX {
    cond: Ref<Expr>,
    body: Ref<Block>,
}

struct ForX {
    initTag: int,
    initB: Ref<Binding>?,
    initA: Ref<AssignX>?,
    cond: Ref<Expr>?,
    updTag: int,
    updA: Ref<AssignX>?,
    updE: Ref<Expr>?,
    body: Ref<Block>,
}

struct ForInX {
    vars: List<string>,
    vline: int,
    vcol: int,
    iterable: Ref<Expr>,
    body: Ref<Block>,
    line: int,
    col: int,
}

struct RetX {
    value: Ref<Expr>?,
}

struct Stmt {
    tag: int,
    binding: Ref<Binding>?,
    assign: Ref<AssignX>?,
    expr: Ref<Expr>?,
    ifd: Ref<IfX>?,
    wh: Ref<WhileX>?,
    fo: Ref<ForX>?,
    fi: Ref<ForInX>?,
    ret: Ref<RetX>?,
    df: Ref<Block>?, // defer 体（D3 v0.19，tag 65）
    line: int,
    col: int,
}

struct Block {
    id: int,
    stmts: List<Ref<Stmt>>,
}

struct FnDecl {
    id: int,
    name: string,
    params: List<Ref<Param>>,
    ret: Ref<Te>?,
    body: Ref<Block>,
    exported: bool,
    isAsync: bool,
    isGen: bool, // 生成器 function*（D3 v0.22）
    line: int,
    col: int,
    tps: List<string>,
    tcs: List<Ref<Te>>, // 型参约束（与 tps 等长；tag 0＝无约束，D3 v0.20）
}

struct ExternDecl {
    name: string,
    params: List<Ref<Param>>,
    ret: Ref<Te>,
    line: int,
    col: int,
    // D3 v0.23 FFI：from 子句（fmode 0＝无，宿主 extern；1＝from "库"；2＝from syscall 编号）。
    fmode: int,
    flib: string,
    fnr: int,
    fline: int,
    fcol: int,
    nfix: int, // D3 v0.36：C 变参参数（`...名: 类型`）之前的定参个数；没有变参参数为 −1
}

// D3 v0.23 FFI：declare type 名; —— 不透明句柄类型声明。
struct HandleDecl {
    name: string,
    exported: bool,
    line: int,
    col: int,
}

struct VarDecl {
    msg: Ref<Expr>?, // 错误 enum 变体消息（D3 v0.19）
    name: string,
    fnames: List<string>,
    ftes: List<Ref<Te>>,
}

struct StructDecl {
    name: string,
    exported: bool,
    fnames: List<string>,
    ftes: List<Ref<Te>>,
    tps: List<string>,
    tcs: List<Ref<Te>>, // 型参约束（D3 v0.20）
    line: int,
    col: int,
}

struct EnumDecl {
    isErr: bool, // enum … extends Error（D3 v0.19）
    name: string,
    exported: bool,
    vars: List<Ref<VarDecl>>,
    line: int,
    col: int,
}

// D3 v0.20 接口声明：方法签名不含接收者（extern 形，无体）。
struct IfaceDecl {
    name: string,
    exported: bool,
    tps: List<string>,
    tcs: List<Ref<Te>>,
    mnames: List<string>,
    msigs: List<Ref<ExternDecl>>,
    line: int,
    col: int,
}

struct TestDecl {
    name: string,
    body: Ref<Block>,
    // 位置域（V0.42-B1-④）：FAB1 test 记录原子面。
    line: int,
    col: int,
}

struct Decl {
    tag: int,
    impNames: List<string>,
    impPath: string,
    fn: Ref<FnDecl>?,
    ext: Ref<ExternDecl>?,
    sd: Ref<StructDecl>?,
    ed: Ref<EnumDecl>?,
    bd: Ref<Binding>?,
    td: Ref<TestDecl>?,
    idl: Ref<IfaceDecl>?, // D3 v0.20 interface（tag 68）
    // 位置域（V0.42-B1-④）：FAB1 import 记录原子面（mirror 原样弃读）。
    impLine: int,
    impCol: int,
    hd: Ref<HandleDecl>?, // D3 v0.23 declare type（tag 73）
    xst: bool, // D3 v0.23 declare struct（tag 5，C 布局外部结构体）
}

// —— 类型表示（对象同一性＝serial；单例 0..5 固定）——
struct StructT {
    serial: int,
    module_idx: int,
    name: string,
    fnames: List<string>,
    ftys: List<Ref<Ty>>,
    aLine: int, // 声明名的位置（泛型实例为模板的；隐藏 struct 为 0），分析节的键（§四-2）
    aCol: int,
}

struct VarT {
    // 错误 enum 变体（D3 v0.19）：消息片段（segField -1＝字面量原文 segRaw，否则字段序）与原因字段序（-1 无）。
    segRaw: List<string>,
    segField: List<int>,
    cause: int,
    name: string,
    fnames: List<string>,
    ftys: List<Ref<Ty>>,
}

struct EnumT {
    isErr: bool,
    serial: int,
    module_idx: int,
    name: string,
    vars: List<Ref<VarT>>,
    aLine: int, // 声明名的位置，分析节的键（§四-2）
    aCol: int,
}

struct Sig {
    serial: int,
    params: List<Ref<Ty>>,
    ret: Ref<Ty>,
    isAsync: bool,
}

// 接口实例（D3 v0.20）：签名已按型参实参替换、不含接收者；hs＝运行期隐藏 struct
//（字段 0＝self，1..＝各方法的函数值），类型池里接口值按它记为 struct。
struct IfaceT {
    serial: int,
    name: string,
    module_idx: int,
    decl: int,
    args: List<Ref<Ty>>,
    mnames: List<string>,
    msigs: List<Ref<Sig>>,
    hs: Ref<StructT>,
}

// Ty.tag 18＝不透明类型参数（定义处检查用；alen＝opqNames 序，inner＝约束接口或 None）；
// 19＝接口值（alen＝IfaceT 序，si＝隐藏 struct，inner＝隐藏 struct 类型；类型池记为 Ref<隐藏 struct>）。
struct Ty {
    serial: int,
    tag: int,
    inner: Ref<Ty>?,
    elem: Ref<Ty>?,
    alen: int,
    si: Ref<StructT>?,
    ei: Ref<EnumT>?,
    sig: Ref<Sig>?,
}

struct GenFn {
    module_idx: int,
    decl: Ref<FnDecl>,
}

struct GenSt {
    module_idx: int,
    decl: Ref<StructDecl>,
}

// —— 符号/作用域/模块 ——

struct Sym {
    kind: int,
    slot: int,
    ty: Ref<Ty>?,
    isConst: bool,
    module_idx: int,
    fnIdx: int,
    sig: Ref<Sig>?,
    si: Ref<StructT>?,
    ei: Ref<EnumT>?,
    bi: int,
    gfn: Ref<GenFn>?,
    gst: Ref<GenSt>?,
    decl: int, // 分析节的声明行号（局部与顶层绑定；-1 为无，§四-2）
}

struct Scope {
    names: List<string>,
    syms: List<Ref<Sym>>,
    hHead: List<int>, // 按名散列桶头（名字超过 32 个时按需建，见 scopeFind）
    hNext: List<int>,
}

struct Cap {
    name: string,
    tySer: int,
    slot: int,
    srcTag: int,
    p0: int,
    p1: int,
}

struct CapCtx {
    floor: int,
    names: List<string>,
    idxs: List<int>,
    caps: List<Ref<Cap>>,
}

struct Mod {
    idx: int,
    display: string,
    nodeCount: int,
    decls: List<Ref<Decl>>,
    symNames: List<string>,
    symVals: List<Ref<Sym>>,
    symIdx: List<int>, // 散列桶头（见 symIdxRebuild）
    symNext: List<int>, // 散列链：与 symNames 等长时索引已同步
    globals: List<Ref<Binding>>,
    gTys: List<Ref<Ty>>,
    gSlots: List<int>,
    initCap: int,
    impSpecs: List<string>,
    impTargets: List<int>,
    std: bool, // 标准库模块（SEIN 标志 bit2 的逐模块标记）：可调用 __rt 内部内建
}

struct FnEntry {
    module_idx: int,
    decl: Ref<FnDecl>,
    sig: Ref<Sig>,
}

struct TestE {
    name: string,
    module_idx: int,
    body: Ref<Block>,
}

struct ExtE {
    name: string,
    ps: List<Ref<Ty>>,
    ret: Ref<Ty>,
    fx: Ref<FfiX>?, // D3 v0.23：带 from 的外部函数（None＝宿主 extern）
    decl: int, // 分析节里名字的声明行号（-1 为无，§四-2）
}

// D3 v0.23 FFI（docs/design/v052-ffi-platform-v0.1-20261015.md §四）：外部函数的绑定与逐参封送种类。
// 种类码：0 void（仅返回）；1..10 定宽（同 O4 种类码 i8 i16 i32 u8 u16 u32 u64 isize usize f32）；
// 11 int（i64）；12 float（f64）；13 bool；14 string（C 串，原 cstr）；15 wstr；16 Bytes；17 句柄；18 可空句柄；
// 19 Ref<外部结构体>（附加＝布局序）；20 回调（附加＝回调签名序）。
struct FfiX {
    mode: int,
    lib: string,
    nr: int,
    mod: int, // 声明所在模块：带 from 的外部函数只在本模块可见，各模块可各自声明同一个 C 函数
    line: int,
    col: int,
    pk: List<int>,
    pa: List<int>,
    rk: int,
    ra: int,
    nfix: int, // D3 v0.36：定参个数（其后的参数按 C 变参约定传）；没有变参参数时等于参数个数
}

// D3 v0.23 FFI 状态（Sm 字段数受 GETFLD 7 位上限约束，另立子结构）。
struct FfiS {
    hNames: List<string>, // declare type 句柄名（Ty tag 22 的 alen 为其序）
    xsSer: List<int>, // declare struct 的 StructT serial
    xsSi: List<Ref<StructT>>,
    xsDecl: List<Ref<StructDecl>>,
    xsMod: List<int>,
    xsSize: List<int>, // 布局（按 xsSer 序；-1＝未算，-2＝计算中）
    xsAlign: List<int>,
    xsOff: List<List<int>>, // 每字段 4 元组：偏移、种类、元素数、附加（嵌套外部结构体的 xs 序）
    cbSigs: List<Ref<Sig>>, // 回调签名
    cbKinds: List<List<int>>, // 回调签名的封送种类：返回、参数个数、各参数
    cbFns: List<int>, // 回调实参（fn 表序, 回调签名序）成对
    lastK: int, // ffiKindOf 的附加结果（布局序、回调签名序）
    lastA: int,
    used: bool, // 程序有带 from 的外部函数（SEB1 追加 FFI1 节）
    dFx: Ref<FfiX>,
    dHd: Ref<HandleDecl>,
}

// —— sema 上下文（单实例）——
struct Sm {
    cur: Ref<Cur>,
    mods: List<Ref<Mod>>,
    fns: List<Ref<FnEntry>>,
    fnHead: List<int>, // fns 按声明节点号的散列桶头（见 findFnIdx）
    fnNext: List<int>,
    tests: List<Ref<TestE>>,
    externs: List<Ref<ExtE>>,
    extNames: List<string>,
    extIdx: List<int>,
    tExprTy: List<Ref<Row>>,
    tExprRes: List<Ref<Row>>,
    tMethodArgs: List<Ref<Row>>,
    maFlat: List<int>,
    tFieldRes: List<Ref<Row>>,
    tBindSlot: List<Ref<Row>>,
    tArmRes: List<Ref<Row>>,
    arNames: List<string>,
    arSlots: List<int>,
    tStructLit: List<Ref<Row>>,
    slFlat: List<int>,
    tArrayLit: List<Ref<Row>>,
    tVariantRes: List<Ref<Row>>,
    tBodySlots: List<Ref<Row>>,
    tCatchBind: List<Ref<Row>>,
    tSwitchEnum: List<Ref<Row>>,
    tClosureRes: List<Ref<Row>>,
    crNames: List<string>,
    crInts: List<int>,
    tClosureMeta: List<Ref<Row>>,
    closureIdx: List<int>,
    tys: List<Ref<Ty>>,
    tyPool: List<int>,
    tyOrder: List<int>,
    sts: List<Ref<StructT>>,
    stPool: List<int>,
    stOrder: List<int>,
    ens: List<Ref<EnumT>>,
    enPool: List<int>,
    enOrder: List<int>,
    sgs: List<Ref<Sig>>,
    sgPool: List<int>,
    sgOrder: List<int>,
    instFnKeys: List<string>,
    instFnIdx: List<int>,
    instStKeys: List<string>,
    instStVals: List<Ref<StructT>>,
    iaSt: List<int>,
    iaGs: List<Ref<GenSt>>,
    iaFlat: List<Ref<Ty>>,
    iaOff: List<int>,
    iaN: List<int>,
    instCount: int,
    tySerial: int,
    stSerial: int,
    enSerial: int,
    sgSerial: int,
    tInt: Ref<Ty>,
    tFloat: Ref<Ty>,
    tBool: Ref<Ty>,
    tString: Ref<Ty>,
    tVoid: Ref<Ty>,
    tErr: Ref<Ty>,
    dummySym: Ref<Sym>,
    dummyE: Ref<Expr>,
    dummyB: Ref<Block>,
    dummyTe: Ref<Te>,
    dummyScope: Ref<Scope>,
    dummyFE: Ref<FnEntry>,
    dummyF: Ref<FnDecl>,
    dummyParam: Ref<Param>,
    dummyMod: Ref<Mod>,
    dummyCap: Ref<Cap>,
    dummyRow: Ref<Row>,
    dDecl: Ref<Decl>,
    dTest: Ref<TestDecl>,
    dStmt: Ref<Stmt>,
    dFi: Ref<ForInX>,
    dAssign: Ref<AssignX>,
    dIf: Ref<IfX>,
    dWhile: Ref<WhileX>,
    dFor: Ref<ForX>,
    dRet: Ref<RetX>,
    dArrow: Ref<ArrowX>,
    dLit: Ref<StructLitX>,
    dCatch: Ref<CatchX>,
    dNew: Ref<NewX>,
    dVarT: Ref<VarT>,
    dVd: Ref<VarDecl>,
    dExDecl: Ref<ExternDecl>,
    dTestE: Ref<TestE>,
    dModIn: Ref<ModIn>,
    dCapCtx: Ref<CapCtx>,
    dSd: Ref<StructDecl>,
    dEd: Ref<EnumDecl>,
    dBd: Ref<Binding>,
    dExt: Ref<ExtE>,
    dArm: Ref<Arm>,
    dGf: Ref<GenFn>,
    dGs: Ref<GenSt>,
    dT: Ref<Ty>,
    dummySi: Ref<StructT>,
    dummyEi: Ref<EnumT>,
    dummySig: Ref<Sig>,
    curMod: Ref<Mod>,
    curRet: Ref<Ty>,
    nextSlot: int,
    inLoop: int,
    stmtDiverged: bool,
    forinN: int,
    scopes: List<Ref<Scope>>,
    curCap: Ref<CapCtx>?,
    asyncDepth: int,
    deferDepth: int, // defer 体嵌套深度（D3 v0.19：体内禁 return/?/跳出）
    synNext: int,
    entryModule: int,
    mainFnIdx: int,
    hasMain: bool,
    diagRows: List<Ref<Row>>,
    diagMsgs: List<string>,
    iv: Ref<IfS>, // D3 v0.20 接口与泛型约束状态（Sm 字段数受 GETFLD 7 位上限约束，另立子结构）
    fx: Ref<FfiS>, // D3 v0.23 FFI 状态
}

struct IfS {
    ifDecls: List<Ref<IfaceDecl>>,
    ifDeclMod: List<int>,
    ifTs: List<Ref<IfaceT>>,
    ifKeys: List<string>,
    opqNames: List<string>,
    tIfaceCall: List<Ref<Row>>,
    defCheck: int, // >0：正在做带约束模板的定义处检查（诊断记 3031，记录事后撤销）
    defFailed: List<int>, // 定义处检查已报错的模板（其实例不再重复检查体）
    instDepth: int, // >0：正在检查泛型实例体（方法语法可回落到接收者类型的声明模块）
    mangling: bool,
    preludeIdx: int, // 编译器自带 prelude 模块序（未载入为 -1）
    listValElem: bool, // 程序用到 List 值类型元素（SEB1 追加 LVE1 标记节）
    // D3 v0.22 生成器：genDirect＝正在直接检查生成器函数体（yield 可用，return 不带值、禁 ? 与 defer）；
    // genAny＝在生成器体内（含其中的箭头函数，yield 不能作标识符）；genElem＝元素类型。
    genDirect: bool,
    genAny: bool,
    genElem: Ref<Ty>?,
    // 线程第 3b 步：sendUsed＝程序用到 threadSpawn（SEB1 追加 SND1 可发送标记节）。接口装入按（接口，具体类型）
    // 各用一个运行期 struct：boxKeys 记忆键、boxSt 该 struct、boxTy 具体类型（SND1 按具体类型标记）。
    sendUsed: bool,
    shareMode: bool, // 线程第 4c 步：正在按“可共享”判定（sharedNew 的实参，Atomic<int> 允许）
    boxKeys: List<string>,
    boxSt: List<Ref<StructT>>,
    boxTy: List<Ref<Ty>>,
    dIfT: Ref<IfaceT>,
    dIdl: Ref<IfaceDecl>,
}

struct Row {
    k: int,
    a0: int,
    a1: int,
    a2: int,
    a3: int,
    a4: int,
    a5: int,
}

function mkRow(k: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int): Ref<Row> {
    return new Row { k: k, a0: a0, a1: a1, a2: a2, a3: a3, a4: a4, a5: a5 };
}

// ============================================================================
// §3 SEIN 解析
// ============================================================================

struct ModIn {
    display: string,
    nodeCount: int,
    astbin: string,
    impSpecs: List<string>,
    impTargets: List<int>,
    std: bool,
}

// SEIN v2 flags bit0: toolchain builtins (writeExecutable) allowed.
let smToolchain: bool = false;
// SEIN v2 flags bit1：宽格式（原生链，TXC v6）——字段号 15 位；未置位（Zig 链，TXC v4）维持 7 位。
let smWide: bool = false;
// 编译目标编号（selfhost/target.tx；标志位 32..224 存 编号＋1）：外部函数的目标检查用；未知（-1）时不查，由构建尾部兜底。
let smTarget: int = -1;
// 本次检查里已做过目标检查的外部函数序（每个只查一次，诊断落在声明处）。
let smFfiTargetDone: List<int> = listNew();
// SEIN v2 flags bit2：每个模块末尾带标准库标记（0/1；线程设计 §十六，2c）。未置位（Zig 链）时没有标准库模块。
let smStdMarks: bool = false;
// SEIN v2 flags bit3：调试构建（第 6 轮 6c-4a，调试实施设计 §四-3）——记下 let/const、catch 绑定与 switch 臂绑定的声明类型，
// SEB1 追加 DBG1 尾节。未置位（正常构建、Zig 链）时什么都不记，SEB1 逐字节不变。
let smDebug: bool = false;
// DBG1 行：k＝键（种类×2^58 ＋ 节点号；switch 臂绑定为 臂号×2^16 ＋ 绑定序），a0＝类型 serial。
let smDbgRows: List<Ref<Row>> = listNew();
// 检查入口只保留 embedBytes 的位置；最终仍按 tExprRes 的末写结果筛选，排除定义处检查回滚的记录。
let smCheckCapture: bool = false;
let smCheckEmbeds: List<Ref<Row>> = listNew();
let smCheckRaws: List<string> = listNew();
const DBG_KEY_CATCH: int = 288230376151711744;
const DBG_KEY_ARM: int = 576460752303423488;
// SEIN v2 flags bit4：分析节（第 6 轮 6d-3a，LSP 与 MCP 实施设计 §四-2）——记下每个名字出现处的身份，SEB1 在 LVE1 之后
// 追加 ANA1。行只含位置与名字（不含合成号、池序），带约束模板的定义处检查回滚后照样是关于源码的事实，所以不进快照。
// 未置位（构建、Zig 链）时什么都不记，SEB1 逐字节不变；置位时 ANA1 之前的部分也不变（不加类型池的根）。
let anaOn: bool = false;
let anaRows: List<Ref<AnaRow>> = listNew();
// 声明的说明文本（6d-3b，§四-5），发射为 ANT1。泛型实例的副本里书写的类型已被替换，所以函数、外部函数、struct、enum
// 与其形参、字段、变体在注册时由模板生成；绑定、catch 与模式绑定在检查时记，同一声明随实例不同时由读出侧标注。
let anaDets: List<Ref<AnaDet>> = listNew();

// 一条说明：声明的位置、锚类与名字（即身份键）、标志（位 0＝导出）、文本。
struct AnaDet {
    m: int,
    l: int,
    c: int,
    how: int,
    flags: int,
    name: string,
    text: string,
}

// 一行：出现处（模块、行、列、锚类、名字）与身份（键模块、键行、键列、键锚类；键锚类 -1 为没有身份，只供着色）。
// 声明行的键是它自己。锚类见 ANA_AT_*，LSP 从锚出发扫词法记号找名字。
struct AnaRow {
    m: int,
    l: int,
    c: int,
    how: int,
    tt: int,
    flags: int, // 位 0＝声明
    km: int,
    kl: int,
    kc: int,
    kh: int,
    name: string,
}

// 锚类：0 名字首字符；1 let/const 关键字（含解构与 for-in 变量——后者位于 for 关键字）；2 函数、extern、箭头函数的锚
// （其后第一个 `(` 里的形参）；3 catch 的基（其后第一个 catch 的 `(`）；4 switch 臂的变体名（其后 `(` 里的模式绑定）；
// 5 struct 名（`{` 里的字段声明）；6 enum 名（`{` 里的变体）；7 import 关键字（`{` 里的名字）；8 字面量键的初值（往回
// 跳过 `:`）；9 `new E.V` 的变体名（往回跳过 `.` 是 enum 名）。
const ANA_AT_EXACT: int = 0;
const ANA_AT_BIND: int = 1;
const ANA_AT_PARAM: int = 2;
const ANA_AT_CATCH: int = 3;
const ANA_AT_PAT: int = 4;
const ANA_AT_FIELD: int = 5;
const ANA_AT_VARIANT: int = 6;
const ANA_AT_IMPORT: int = 7;
const ANA_AT_LITKEY: int = 8;
const ANA_AT_ENUMPRE: int = 9;
// 着色类＝semanticTokens legend 的下标（与 Zig 版 legend 同序）。
const ANA_TT_FN: int = 0;
const ANA_TT_STRUCT: int = 1;
const ANA_TT_ENUM: int = 2;
const ANA_TT_MEMBER: int = 3;
const ANA_TT_VAR: int = 4;
const ANA_TT_PARAM: int = 5;
const ANA_TT_PROP: int = 6;

// GETFLD/SETFLD 字段号上限与其位数文案（容量与编码上限评估 §八-6）。
function smFieldMax(): int {
    if (smWide) { return 32767; }
    return 127;
}
// 函数、函数类型、箭头函数的参数上限：CALL 的 B＝实参数＋1。宽格式（原生链，B 16 位，C3b）为 65534，
// 否则（Zig 链，B 8 位）为 254。外部函数参数恒为 254（C ABI，见 collectExterns）。
function smParamMax(): int {
    if (smWide) { return 65534; }
    return 254;
}

function smFieldBits(): string {
    if (smWide) { return "15"; }
    return "7";
}

// 一个入口只保存当前原始树与平面事实；工作类型图属于各次 Sm。
struct SmCacheEmbed { module: int, line: int, col: int, raw: string, key: int, parsed: bool, }
struct SmPhase {
    valid: bool, rows: List<Ref<Row>>, msgs: List<string>, ana: List<Ref<AnaRow>>, dets: List<Ref<AnaDet>>,
    failed: List<int>, syn: int, forin: int, begin: int, embeds: List<Ref<SmCacheEmbed>>,
}
struct SmCacheModule {
    input: Ref<CheckModule>, decls: List<Ref<Decl>>, base: int, span: int,
    defs: Ref<SmPhase>, body: Ref<SmPhase>, deps: List<int>,
}
export struct SmCheckCache {
    modules: List<Ref<SmCacheModule>>, flags: int, tag: string, high: int,
    decoded: int, checked: int, reused: int, retries: int, total: int, changed: List<int>,
}
struct SmPhaseMark { diag: int, ana: int, det: int, failed: int, syn: int, forin: int, }
struct SmCacheRun {
    cache: Ref<SmCheckCache>, modules: List<Ref<SmCacheModule>>, dirty: List<int>, graph: List<List<int>>,
    observed: List<List<int>>, normalBases: List<int>, normalTotal: int, synBase: int,
    origin: int, phase: int, mark: Ref<SmPhaseMark>, expand: bool,
}
let smCacheRun: Ref<SmCacheRun>? = None;
let smCopyIds: bool = false;
let smCheckFinal: List<Ref<Row>> = listNew();

function smPhaseNew(): Ref<SmPhase> {
    return new SmPhase { valid: false, rows: listNew(), msgs: listNew(), ana: listNew(), dets: listNew(), failed: listNew(),
        syn: 0, forin: 0, begin: 0, embeds: listNew() };
}
export function smCheckCacheNew(): Ref<SmCheckCache> {
    return new SmCheckCache { modules: listNew(), flags: -1, tag: "", high: 0,
        decoded: 0, checked: 0, reused: 0, retries: 0, total: 0, changed: listNew() };
}
function smCacheModuleNew(input: Ref<CheckModule>): Ref<SmCacheModule> {
    return new SmCacheModule { input: input, decls: listNew(), base: 0, span: 0, defs: smPhaseNew(), body: smPhaseNew(), deps: listNew() };
}
function smCacheEmptyInts(): List<int> { return listNew(); }
function smCacheRunNew(cache: Ref<SmCheckCache>, n: int): Ref<SmCacheRun> {
    return new SmCacheRun { cache: cache, modules: listNew(), dirty: listNew(), graph: checkGraphNew(n),
        observed: checkGraphNew(n), normalBases: listNew(), normalTotal: 0, synBase: 0,
        origin: -1, phase: -1, mark: new SmPhaseMark { diag: 0, ana: 0, det: 0, failed: 0, syn: 0, forin: 0 }, expand: false };
}
function smCacheCurrent(): Ref<SmCacheRun> { return smCacheRun catch smCacheRunNew(smCheckCacheNew(), 0); }
function smCacheInputEmpty(): Ref<CheckModule> {
    return new CheckModule { path: "", display: "", nodeCount: 0, astbin: "", specs: listNew(), targets: listNew(), std: false };
}
function smCacheAt(run: Ref<SmCacheRun>, mi: int): Ref<SmCacheModule> {
    return listGet(run.modules, mi) catch smCacheModuleNew(smCacheInputEmpty());
}
function smCacheSameInts(a: List<int>, b: List<int>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) { if ((listGet(a, i) catch -1) != (listGet(b, i) catch -2)) { return false; } i = i + 1; }
    return true;
}
function smCacheSameStrs(a: List<string>, b: List<string>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) { if ((listGet(a, i) catch "") != (listGet(b, i) catch "")) { return false; } i = i + 1; }
    return true;
}
function smCacheSameGraph(cache: Ref<SmCheckCache>, inputs: List<Ref<CheckModule>>, flags: int, tag: string): bool {
    if (cache.flags != flags || cache.tag != tag || listLen(cache.modules) != listLen(inputs)) { return false; }
    let i = 0;
    for (input in inputs) {
        const old = (listGet(cache.modules, i) catch smCacheModuleNew(input)).input;
        if (old.path != input.path || old.display != input.display || old.std != input.std
            || !smCacheSameStrs(old.specs, input.specs) || !smCacheSameInts(old.targets, input.targets)) { return false; }
        i = i + 1;
    }
    return true;
}
function smCachePrepare(cache: Ref<SmCheckCache>, inputs: List<Ref<CheckModule>>, flags: int, tag: string): Ref<SmCacheRun> {
    cache.decoded = 0; cache.checked = 0; cache.reused = 0; cache.retries = 0; cache.total = listLen(inputs);
    let same = smCacheSameGraph(cache, inputs, flags, tag);
    let reserve = 0;
    for (input in inputs) {
        if (reserve > 9223372036854775807 - input.nodeCount) { same = false; }
        else { reserve = reserve + input.nodeCount; }
    }
    if (cache.high > 9223372036854775807 - reserve) { same = false; }
    if (!same) { cache.high = 0; }
    const run = smCacheRunNew(cache, listLen(inputs));
    let i = 0;
    for (input in inputs) {
        const m = smCacheModuleNew(input);
        let changed = true;
        if (same) {
            const old = listGet(cache.modules, i) catch smCacheModuleNew(input);
            m.base = old.base; m.span = old.span; m.defs = old.defs; m.body = old.body; m.deps = old.deps;
            changed = old.input.astbin != input.astbin;
            if (!changed) { m.decls = old.decls; }
        }
        if (changed) {
            if (!same || input.nodeCount > m.span) {
                m.base = cache.high; m.span = input.nodeCount; cache.high = cache.high + input.nodeCount;
            }
            m.decls = readTxModule(input.astbin, m.base); cache.decoded = cache.decoded + 1;
        }
        listPush(run.modules, m);
        let dirty = 0;
        if (changed || !m.defs.valid || !m.body.valid) { dirty = 1; }
        listPush(run.dirty, dirty);
        for (dep in input.targets) { checkGraphAdd(run.graph, dep, i); }
        i = i + 1;
    }
    i = 0;
    for (m in run.modules) {
        if (m.input.path == "<prelude>") {
            let j = 0; while (j < listLen(inputs)) { if (i != j) { checkGraphAdd(run.graph, i, j); } j = j + 1; }
        }
        for (dep in m.deps) { checkGraphAdd(run.graph, dep, i); checkGraphAdd(run.graph, i, dep); }
        i = i + 1;
    }
    checkGraphPropagate(run.graph, run.dirty);
    run.synBase = cache.high;
    return run;
}

// 原树绝不交给会原地改写的检查体。未改模块只复制顶层初始化表达式；类型声明与未检查的函数体可共享。
function smCopyNodeId(s: Ref<Sm>, original: int): int {
    if (smCopyIds) { return original; }
    return synAlloc(s);
}
function smCacheHeaders(s: Ref<Sm>, decls: List<Ref<Decl>>): List<Ref<Decl>> {
    const out: List<Ref<Decl>> = listNew();
    const ps: List<string> = listNew(); const ts: List<Ref<Ty>> = listNew();
    smCopyIds = true;
    for (d in decls) {
        if (d.tag != 11 && d.tag != 12) { listPush(out, d); continue; }
        const b = d.bd catch s.dBd;
        const binding = new Binding { id: b.id, isConst: b.isConst, name: b.name, ty: b.ty,
            init: copyExpr(s, b.init, ps, ts), exported: b.exported, line: b.line, col: b.col };
        listPush(out, new Decl { tag: d.tag, impNames: d.impNames, impPath: d.impPath, fn: d.fn, ext: d.ext,
                sd: d.sd, ed: d.ed, bd: binding, td: d.td, idl: d.idl, impLine: d.impLine, impCol: d.impCol, hd: d.hd, xst: d.xst });
    }
    smCopyIds = false;
    return out;
}

function smCacheDependency(s: Ref<Sm>, target: int): void {
    if (smCacheRun == None) { return; }
    const run = smCacheCurrent();
    let origin = run.origin;
    if (origin < 0) { origin = s.curMod.idx; }
    if (origin < 0 || target < 0 || origin >= listLen(run.modules) || target >= listLen(run.modules) || origin == target) { return; }
    const row = listGet(run.observed, origin) catch smCacheEmptyInts();
    if (!intListHas(row, target)) { listPush(row, target); }
    checkGraphAdd(run.graph, target, origin); checkGraphAdd(run.graph, origin, target);
    if ((listGet(run.dirty, origin) catch 1) != (listGet(run.dirty, target) catch 1)) { run.expand = true; }
}

function smCheckEmbedKey(key: int, module: int): int {
    if (smCacheRun == None) { return key; }
    const run = smCacheCurrent();
    if (key >= run.synBase) { return run.normalTotal + (key - run.synBase); }
    return (listGet(run.normalBases, module) catch 0) + (key - smCacheAt(run, module).base);
}
function smCheckRecordEmbed(key: int, module: int, line: int, col: int, raw: string, literal: bool): void {
    let ridx = -1;
    if (literal) { ridx = listLen(smCheckRaws); listPush(smCheckRaws, raw); }
    let origin = -1;
    if (smCacheRun != None) {
        const run = smCacheCurrent();
        if (run.phase == 1) { origin = run.origin; }
    }
    listPush(smCheckEmbeds, mkRow(key, module, line, col, ridx, origin, smCheckEmbedKey(key, module)));
}

function smPhaseUse(s: Ref<Sm>, mi: int, which: int): bool {
    if (smCacheRun == None) { return false; }
    const run = smCacheCurrent(); const m = smCacheAt(run, mi);
    let p = m.body;
    if (which == 0) { p = m.defs; }
    run.origin = mi; run.phase = which;
    if ((listGet(run.dirty, mi) catch 1) == 0 && p.valid) {
        for (r in p.rows) { listPush(s.diagRows, r); }
        for (msg in p.msgs) { listPush(s.diagMsgs, msg); }
        for (a in p.ana) { listPush(anaRows, a); }
        for (d in p.dets) { listPush(anaDets, d); }
        for (failed in p.failed) { listPush(s.iv.defFailed, failed); }
        const begin = s.synNext;
        for (e in p.embeds) {
            let key = e.key;
            if (!e.parsed) { key = begin + e.key; }
            listPush(s.tExprRes, mkRow(key, 3, 47, 0, 0, 0, 0));
            smCheckRecordEmbed(key, e.module, e.line, e.col, e.raw, true);
        }
        s.synNext = s.synNext + p.syn; s.forinN = s.forinN + p.forin;
        run.origin = -1; run.phase = -1;
        return true;
    }
    run.mark = new SmPhaseMark { diag: listLen(s.diagRows), ana: listLen(anaRows), det: listLen(anaDets),
        failed: listLen(s.iv.defFailed), syn: s.synNext, forin: s.forinN };
    if (which == 1) { run.cache.checked = run.cache.checked + 1; }
    return false;
}
function smPhaseSave(s: Ref<Sm>, mi: int, which: int): void {
    if (smCacheRun == None) { return; }
    const run = smCacheCurrent(); const mark = run.mark; const p = smPhaseNew();
    p.valid = true; p.begin = mark.syn; p.syn = s.synNext - mark.syn; p.forin = s.forinN - mark.forin;
    let i = mark.diag;
    while (i < listLen(s.diagRows)) { listPush(p.rows, listGet(s.diagRows, i) catch s.dummyRow); listPush(p.msgs, listGet(s.diagMsgs, i) catch ""); i = i + 1; }
    i = mark.ana;
    while (i < listLen(anaRows)) { listPush(p.ana, listGet(anaRows, i) catch anaKey(0, 0, 0, -1, 0)); i = i + 1; }
    i = mark.det;
    while (i < listLen(anaDets)) {
        listPush(p.dets, listGet(anaDets, i) catch new AnaDet { m: 0, l: 0, c: 0, how: 0, flags: 0, name: "", text: "" }); i = i + 1;
    }
    i = mark.failed;
    while (i < listLen(s.iv.defFailed)) { listPush(p.failed, listGet(s.iv.defFailed, i) catch -1); i = i + 1; }
    const m = smCacheAt(run, mi);
    if (which == 0) { m.defs = p; } else { m.body = p; }
    run.origin = -1; run.phase = -1;
}

function smCacheCommit(flags: int, tag: string): void {
    const run = smCacheCurrent();
    for (r in smCheckFinal) {
        if (r.a4 < 0 || (listGet(run.dirty, r.a4) catch 0) == 0) { continue; }
        const p = smCacheAt(run, r.a4).body;
        let parsed = true; let key = r.a5;
        if (key >= run.synBase) { parsed = false; key = key - p.begin; }
        listPush(p.embeds, new SmCacheEmbed { module: r.a0, line: r.a1, col: r.a2, raw: listGet(smCheckRaws, r.a3) catch "", key: key, parsed: parsed });
    }
    let i = 0; let reused = 0;
    for (m in run.modules) {
        const fresh = listGet(run.observed, i) catch smCacheEmptyInts();
        if ((listGet(run.dirty, i) catch 1) == 0) {
            const deps: List<int> = listNew();
            for (dep in m.deps) { listPush(deps, dep); }
            for (dep in fresh) { if (!intListHas(deps, dep)) { listPush(deps, dep); } }
            m.deps = deps; reused = reused + 1;
        } else { m.deps = fresh; }
        i = i + 1;
    }
    run.cache.modules = run.modules; run.cache.flags = flags; run.cache.tag = tag;
    run.cache.reused = reused; run.cache.changed = run.dirty;
}

function smReset(flags: int): void {
    smToolchain = (flags & 1) != 0;
    smWide = (flags & 2) != 0;
    smTarget = ((flags >> 5) & 7) - 1;
    smFfiTargetDone = listNew();
    smStdMarks = (flags & 4) != 0;
    smDebug = (flags & 8) != 0;
    smDbgRows = listNew();
    anaOn = (flags & 16) != 0;
    anaRows = listNew();
    anaDets = listNew();
    smInstNest = 0;
    smStSizeReset();
    smCheckCapture = false;
    smCheckEmbeds = listNew();
    smCheckRaws = listNew();
    smSeb1 = "";
    smFab1 = "";
    smOk = 0;
    smCacheRun = None;
    smCopyIds = false;
    smCheckFinal = listNew();
}

function parseSein(data: string): List<Ref<ModIn>> {
    const c = makeCur(data, false);
    const magicOk: bool = (byteAt(data, 0) catch 0) == 83 && (byteAt(data, 1) catch 0) == 69 && (byteAt(data, 2) catch 0) == 73 && (byteAt(data, 3) catch 0) == 78;
    if (!magicOk) {
        print("semamirror: 坏 SEIN magic");
        panic("abort");
    }
    c.pos = 6;
    const ver = cDec(c);
    let flags = 0;
    if (ver == 2) {
        flags = cDec(c);
    }
    smReset(flags);
    const nmod = cDec(c);
    if (ver != 1 && ver != 2) {
        print("semamirror: SEIN version " + toStr(ver) + " 不受支持");
        panic("abort");
    }
    const out: List<Ref<ModIn>> = listNew();
    let i: int = 0;
    while (i < nmod) {
        const display = cStrS(c);
        const nodeCount = cDec(c);
        const alen = cDec(c);
        const c0 = cpAt(c, c.pos);
        const c1 = cpAt(c, c.pos + alen);
        const astbin = strSub(c.b, c0, c1 - c0);
        c.pos = c.pos + alen;
        if (c.pos < c.n) {
            const sp = byteAt(c.b, c.pos) catch 0;
            if (sp == 32) {
                c.pos = c.pos + 1;
            }
        }
        const specs: List<string> = listNew();
        const targets: List<int> = listNew();
        const nimp = cDec(c);
        let j: int = 0;
        while (j < nimp) {
            const spec = cStrS(c);
            const tgt = cDec(c);
            listPush(specs, spec);
            listPush(targets, tgt);
            j = j + 1;
        }
        let std: bool = false;
        if (smStdMarks) { std = cDec(c) == 1; }
        listPush(out, new ModIn { display: display, nodeCount: nodeCount, astbin: astbin, impSpecs: specs, impTargets: targets, std: std });
        i = i + 1;
    }
    return out;
}

// ============================================================================
// §4 TXB1 物化器——ast_bin_read.zig 同构（读序＝流序；节点 ID＝模块基座＋流位；
// 注册面＝Expr/Binding/Block/Arm/FnDecl 五类表键节点；TypeExpr/槽行不注册）
// ============================================================================

struct Mat {
    c: Ref<Cur>,
    base: int,
    nodes: int,
    dummyE: Ref<Expr>,
    dummyB: Ref<Block>,
    dummyT: Ref<Te>,
}

function matNode(m: Ref<Mat>): int {
    return m.base + m.nodes - 1;
}

// 节点流 kind 消费（计数——peek 不计；读序＝流序＝节点 ID 纪律）。
function kDec(m: Ref<Mat>): int {
    m.nodes = m.nodes + 1;
    return cDec(m.c);
}

function peekKind(m: Ref<Mat>): int {
    return peekDec(m.c);
}

function newExpr(m: Ref<Mat>, tag: int, line: int, col: int): Ref<Expr> {
    return new Expr { id: matNode(m), tag: tag, line: line, col: col, s0: "", s1: "", i0: 0, i1: 0, i2: 0, a: None, b: None, list: listNew(), targs: listNew(), lit: None, arms: listNew(), af: None, nb: None, cb: None, ty: None };
}

function newBindingN(m: Ref<Mat>, nid: int, isConst: bool, name: string): Ref<Binding> {
    return new Binding { id: nid, isConst: isConst, name: name, ty: None, init: m.dummyE, exported: false, line: 0, col: 0 };
}

function newMat(bin: string, base: int): Ref<Mat> {
    const c = makeCur(bin, true);
    const m = new Mat { c: c, base: base, nodes: 0, dummyE: new Expr { id: -1, tag: 0, line: 0, col: 0, s0: "", s1: "", i0: 0, i1: 0, i2: 0, a: None, b: None, list: listNew(), targs: listNew(), lit: None, arms: listNew(), af: None, nb: None, cb: None, ty: None }, dummyB: new Block { id: -1, stmts: listNew() }, dummyT: new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() }, };
    return m;
}

function newBlockN(m: Ref<Mat>, nid: int): Ref<Block> {
    return new Block { id: nid, stmts: listNew() };
}

function readType(m: Ref<Mat>): Ref<Te> {
    const id = kDec(m);
    const t = new Te { tag: id, name: "", a: None, alen: 0, ls: listNew() };
    if (id == 52) {
        t.name = cStr(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: tnamed 子数坏形");
            panic("abort");
        }
        return t;
    }
    if (id == 53 || id == 54 || id == 55 || id == 56 || id == 57 || id == 59 || id == 61) {
        if (cDec(m.c) != 1) {
            print("semamirror: 单子类型子数坏形");
            panic("abort");
        }
        t.a = readType(m);
        return t;
    }
    if (id == 67) {
        if (cDec(m.c) != 2) {
            print("semamirror: terrtyped 子数坏形");
            panic("abort");
        }
        t.a = readType(m);
        listPush(t.ls, readType(m));
        return t;
    }
    if (id == 58) {
        const ln = cDec(m.c);
        t.alen = ln;
        if (cDec(m.c) != 1) {
            print("semamirror: tarray 子数坏形");
            panic("abort");
        }
        t.a = readType(m);
        return t;
    }
    if (id == 60) {
        const n = cDec(m.c);
        const cn = cDec(m.c);
        if (cn != n + 1) {
            print("semamirror: tfn 子数坏形");
            panic("abort");
        }
        let i: int = 0;
        while (i < n) {
            listPush(t.ls, readType(m));
            i = i + 1;
        }
        t.a = readType(m);
        return t;
    }
    if (id == 62) {
        t.name = cStr(m.c);
        const n = cDec(m.c);
        let i: int = 0;
        while (i < n) {
            listPush(t.ls, readType(m));
            i = i + 1;
        }
        return t;
    }
    print("semamirror: 未知类型节点 " + toStr(id));
    panic("abort");
    return t;
}

function readParam(m: Ref<Mat>): Ref<Param> {
    const id = kDec(m);
    if (id != 2) {
        print("semamirror: param 槽坏形");
        panic("abort");
    }
    const name = cStr(m.c);
    const col = cDec(m.c);
    const n = cDec(m.c);
    if (n != 1) {
        print("semamirror: param 子数坏形");
        panic("abort");
    }
    return new Param { name: name, ty: readType(m), col: col };
}

function readRetSlot(m: Ref<Mat>): Ref<Te> {
    const id = kDec(m);
    if (id != 3) {
        print("semamirror: ret 槽坏形");
        panic("abort");
    }
    const n = cDec(m.c);
    if (n != 1) {
        print("semamirror: ret 子数坏形");
        panic("abort");
    }
    return readType(m);
}

// 型参表：64＝无约束；69（D3 v0.20）＝名字后逐参一个有无约束标志，子为各约束类型。
// tcs 与名字等长（tag 0＝无约束）。
function readTparams(m: Ref<Mat>, tcs: List<Ref<Te>>): List<string> {
    const id = kDec(m);
    if (id != 64 && id != 69) {
        print("semamirror: tparams 坏形");
        panic("abort");
    }
    const n = cDec(m.c);
    const names: List<string> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(names, cStr(m.c));
        i = i + 1;
    }
    if (id == 69) {
        const flags: List<int> = listNew();
        i = 0;
        while (i < n) {
            listPush(flags, cDec(m.c));
            i = i + 1;
        }
        cDec(m.c);
        i = 0;
        while (i < n) {
            if ((listGet(flags, i) catch 0) != 0) {
                listPush(tcs, readType(m));
            } else {
                listPush(tcs, new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() });
            }
            i = i + 1;
        }
        return names;
    }
    if (cDec(m.c) != 0) {
        print("semamirror: tparams 子数坏形");
        panic("abort");
    }
    i = 0;
    while (i < n) {
        listPush(tcs, new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() });
        i = i + 1;
    }
    return names;
}

function readTyargs(m: Ref<Mat>): List<Ref<Te>> {
    const id = kDec(m);
    if (id != 63) {
        print("semamirror: tyargs 坏形");
        panic("abort");
    }
    const n = cDec(m.c);
    const ts: List<Ref<Te>> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(ts, readType(m));
        i = i + 1;
    }
    return ts;
}

function readBinding(m: Ref<Mat>, isConst: bool, nid: int): Ref<Binding> {
    const name = cStr(m.c);
    const exported = cDec(m.c) != 0;
    const line = cDec(m.c);
    const col = cDec(m.c);
    if (cDec(m.c) != 2) {
        print("semamirror: binding 子数坏形");
        panic("abort");
    }
    const tyId = kDec(m);
    if (tyId != 13) {
        print("semamirror: binding ty 槽坏形");
        panic("abort");
    }
    const b = newBindingN(m, nid, isConst, name);
    b.exported = exported;
    b.line = line;
    b.col = col;
    if (cDec(m.c) == 1) {
        b.ty = readType(m);
    }
    b.init = readExpr(m);
    return b;
}

function readBlock(m: Ref<Mat>): Ref<Block> {
    const id = kDec(m);
    const nid = matNode(m);
    if (id != 4) {
        print("semamirror: block 坏形");
        panic("abort");
    }
    const n = cDec(m.c);
    const b = newBlockN(m, nid);
    let i: int = 0;
    while (i < n) {
        listPush(b.stmts, readStmt(m));
        i = i + 1;
    }
    return b;
}

function readAssign(m: Ref<Mat>): Ref<AssignX> {
    const id = kDec(m);
    if (id != 14) {
        print("semamirror: assign 坏形");
        panic("abort");
    }
    const line = cDec(m.c);
    const col = cDec(m.c);
    if (cDec(m.c) != 2) {
        print("semamirror: assign 子数坏形");
        panic("abort");
    }
    const target = readExpr(m);
    const value = readExpr(m);
    return new AssignX { target: target, value: value, line: line, col: col };
}

function readIf(m: Ref<Mat>): Ref<IfX> {
    const id = kDec(m);
    if (id != 15) {
        print("semamirror: if 坏形");
        panic("abort");
    }
    const line = cDec(m.c);
    const col = cDec(m.c);
    if (cDec(m.c) != 3) {
        print("semamirror: if 子数坏形");
        panic("abort");
    }
    const cond = readExpr(m);
    const thenB = readBlock(m);
    const elseId = kDec(m);
    if (elseId != 16) {
        print("semamirror: else 槽坏形");
        panic("abort");
    }
    const f = new IfX { cond: cond, thenB: thenB, elseTag: 0, elseB: None, elseI: None, line: line, col: col };
    if (cDec(m.c) == 1) {
        const cid = peekKind(m);
        if (cid == 4) {
            f.elseTag = 1;
            f.elseB = readBlock(m);
        } else if (cid == 15) {
            f.elseTag = 2;
            f.elseI = readIf(m);
        } else {
            print("semamirror: else 臂坏形");
            panic("abort");
        }
    }
    return f;
}

function newStmt(tag: int): Ref<Stmt> {
    return new Stmt { df: None, ret: None, tag: tag, binding: None, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
}

function readStmt(m: Ref<Mat>): Ref<Stmt> {
    const id = peekKind(m);
    if (id == 11 || id == 12) {
        const k = kDec(m);
        const nid = matNode(m);
        const s = newStmt(k);
        s.binding = readBinding(m, k == 12, nid);
        return s;
    }
    if (id == 14) {
        const s = newStmt(14);
        s.assign = readAssign(m);
        return s;
    }
    if (id == 15) {
        const s = newStmt(15);
        s.ifd = readIf(m);
        return s;
    }
    if (id == 17) {
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: while 子数坏形");
            panic("abort");
        }
        const cond = readExpr(m);
        const body = readBlock(m);
        const s = newStmt(k);
        s.wh = new WhileX { cond: cond, body: body };
        s.line = line;
        s.col = col;
        return s;
    }
    if (id == 18) {
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 4) {
            print("semamirror: for 子数坏形");
            panic("abort");
        }
        const slot = kDec(m);
        if (slot != 19) {
            print("semamirror: for init 槽坏形");
            panic("abort");
        }
        const fo = new ForX { initTag: 0, initB: None, initA: None, cond: None, updTag: 0, updA: None, updE: None, body: m.dummyB };
        if (cDec(m.c) == 1) {
            const cid = peekKind(m);
            if (cid == 11 || cid == 12) {
                const kk = kDec(m);
                const nid = matNode(m);
                fo.initTag = 1;
                fo.initB = readBinding(m, kk == 12, nid);
            } else if (cid == 14) {
                fo.initTag = 2;
                fo.initA = readAssign(m);
            } else {
                print("semamirror: for init 坏形");
                panic("abort");
            }
        }
        const cslot = kDec(m);
        if (cslot != 20) {
            print("semamirror: for cond 槽坏形");
            panic("abort");
        }
        if (cDec(m.c) == 1) {
            fo.cond = readExpr(m);
        }
        const uslot = kDec(m);
        if (uslot != 21) {
            print("semamirror: for update 槽坏形");
            panic("abort");
        }
        if (cDec(m.c) == 1) {
            const cid = peekKind(m);
            if (cid == 14) {
                fo.updTag = 1;
                fo.updA = readAssign(m);
            } else {
                fo.updTag = 2;
                fo.updE = readExpr(m);
            }
        }
        fo.body = readBlock(m);
        const s = newStmt(k);
        s.fo = fo;
        s.line = line;
        s.col = col;
        return s;
    }
    if (id == 22) {
        const k = kDec(m);
        const vn = cDec(m.c);
        const vars: List<string> = listNew();
        let i: int = 0;
        while (i < vn) {
            listPush(vars, cStr(m.c));
            i = i + 1;
        }
        const line = cDec(m.c);
        const col = cDec(m.c);
        const vline = cDec(m.c);
        const vcol = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: forin 子数坏形");
            panic("abort");
        }
        const iterable = readExpr(m);
        const body = readBlock(m);
        const s = newStmt(k);
        s.fi = new ForInX { vars: vars, vline: vline, vcol: vcol, iterable: iterable, body: body, line: line, col: col };
        s.line = line;
        s.col = col;
        return s;
    }
    if (id == 23) {
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        const s = newStmt(k);
        s.line = line;
        s.col = col;
        if (cDec(m.c) == 1) {
            s.ret = new RetX { value: readExpr(m) };
        } else {
            s.ret = new RetX { value: None };
        }
        return s;
    }
    if (id == 24 || id == 25) {
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: break/continue 子数坏形");
            panic("abort");
        }
        const s = newStmt(k);
        s.line = line;
        s.col = col;
        return s;
    }
    if (id == 71) {
        // yield 语句（D3 v0.22）：at=yield，子＝产出值。
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: yield 子数坏形");
            panic("abort");
        }
        const s = newStmt(k);
        s.expr = readExpr(m);
        s.line = line;
        s.col = col;
        return s;
    }
    if (id == 65) {
        const k = kDec(m);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: defer 子数坏形");
            panic("abort");
        }
        const body = readBlock(m);
        const s = newStmt(k);
        s.df = body;
        s.line = line;
        s.col = col;
        return s;
    }
    const s = newStmt(0);
    s.expr = readExpr(m);
    return s;
}

function readExpr(m: Ref<Mat>): Ref<Expr> {
    const id = kDec(m);
    if (id == 26 || id == 27 || id == 28) {
        const raw = cStr(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: 字面量子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.s0 = raw;
        return e;
    }
    if (id == 29 || id == 30) {
        // V0.42-B1-④ 执行发现修复：TXB1 bool 原子序＝v／line／col
        //（ast_bin_write.bool_lit——v 先行）；原形先读 line/col 再读 v——
        // 值与位置错位。SEB1 不载 AST 原子故探针不可见，FAB1 原子面
        // ＋loader 重建 bool 值即破（false→true 翻转实测）。
        let v: int = 0;
        if (id == 29) {
            v = cDec(m.c);
        }
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: bool/none 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.i0 = v;
        return e;
    }
    if (id == 31) {
        const name = cStr(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: ident 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.s0 = name;
        return e;
    }
    if (id == 32) {
        const op = cDec(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: binary 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.i0 = op;
        e.a = readExpr(m);
        e.b = readExpr(m);
        return e;
    }
    if (id == 33) {
        const op = cDec(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: unary 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.i0 = op;
        e.a = readExpr(m);
        return e;
    }
    if (id == 34) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        if (n < 1) {
            print("semamirror: call 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        if (peekKind(m) == 63) {
            e.targs = readTyargs(m);
        }
        e.a = readExpr(m);
        let i: int = 1;
        if (listLen(e.targs) > 0) { i = 2; }
        while (i < n) {
            listPush(e.list, readExpr(m));
            i = i + 1;
        }
        return e;
    }
    if (id == 35) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: index 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.a = readExpr(m);
        e.b = readExpr(m);
        return e;
    }
    if (id == 36) {
        const name = cStr(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        const nline = cDec(m.c);
        const ncol = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: field 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.s0 = name;
        e.i1 = nline;
        e.i2 = ncol;
        e.a = readExpr(m);
        return e;
    }
    if (id == 37) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: propagate 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.a = readExpr(m);
        return e;
    }
    if (id == 38) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: as 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.a = readExpr(m);
        e.ty = readType(m);
        return e;
    }
    if (id == 39) {
        const e = newExpr(m, id, 0, 0);
        const hasBinding = cDec(m.c) != 0;
        let binding: string = "";
        if (hasBinding) {
            binding = cStr(m.c);
        }
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 2) {
            print("semamirror: catch 子数坏形");
            panic("abort");
        }
        const operand = readExpr(m);
        const hid = kDec(m);
        if (hid != 40) {
            print("semamirror: handler 槽坏形");
            panic("abort");
        }
        if (cDec(m.c) != 1) {
            print("semamirror: handler 子数坏形");
            panic("abort");
        }
        const cx = new CatchX { operand: operand, hasBinding: hasBinding, binding: binding, isBlock: false, hExpr: None, hBlock: None };
        if (peekKind(m) == 4) {
            cx.isBlock = true;
            cx.hBlock = readBlock(m);
        } else {
            cx.hExpr = readExpr(m);
        }
        e.line = line;
        e.col = col;
        e.cb = cx;
        return e;
    }
    if (id == 41) {
        const e = newExpr(m, id, 0, 0);
        const hasHint = cDec(m.c) != 0;
        let hint: string = "";
        if (hasHint) {
            hint = cStr(m.c);
        }
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const lit = new StructLitX { hint: hint, hasHint: hasHint, targs: listNew(), fnames: listNew(), fvals: listNew(), hintLine: line, hintCol: col };
        if (n > 0 && peekKind(m) == 63) {
            lit.targs = readTyargs(m);
        }
        let i: int = 0;
        if (listLen(lit.targs) > 0) { i = 1; }
        while (i < n) {
            const fid = kDec(m);
            if (fid != 42) {
                print("semamirror: finit 坏形");
                panic("abort");
            }
            const fname = cStr(m.c);
            if (cDec(m.c) != 1) {
                print("semamirror: finit 子数坏形");
                panic("abort");
            }
            listPush(lit.fnames, fname);
            listPush(lit.fvals, readExpr(m));
            i = i + 1;
        }
        e.line = line;
        e.col = col;
        e.lit = lit;
        return e;
    }
    if (id == 43) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const e = newExpr(m, id, line, col);
        let i: int = 0;
        while (i < n) {
            listPush(e.list, readExpr(m));
            i = i + 1;
        }
        return e;
    }
    if (id == 44) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: new 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        const nx = new NewX { isVariant: false, lit: None, enumName: "", varName: "", args: listNew(), vline: 0, vcol: 0 };
        const cid = peekKind(m);
        if (cid == 41) {
            nx.lit = readExpr(m);
        } else if (cid == 45) {
            const vk = kDec(m);
            nx.isVariant = true;
            nx.enumName = cStr(m.c);
            nx.varName = cStr(m.c);
            nx.vline = cDec(m.c);
            nx.vcol = cDec(m.c);
            const n = cDec(m.c);
            let i: int = 0;
            while (i < n) {
                listPush(nx.args, readExpr(m));
                i = i + 1;
            }
        } else {
            print("semamirror: new 内槽坏形");
            panic("abort");
        }
        e.nb = nx;
        return e;
    }
    if (id == 46) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        if (n < 1) {
            print("semamirror: switch 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.a = readExpr(m);
        const nids: List<int> = listNew();
        let i: int = 1;
        while (i < n) {
            const aid = kDec(m);
            if (aid != 47) {
                print("semamirror: arm 坏形");
                panic("abort");
            }
            const anid = matNode(m);
            listPush(nids, anid);
            const isElse = cDec(m.c) != 0;
            const name = cStr(m.c);
            const aline = cDec(m.c);
            const acol = cDec(m.c);
            const cn = cDec(m.c);
            if (cn < 1) {
                print("semamirror: arm 子数坏形");
                panic("abort");
            }
            const patfs: List<string> = listNew();
            let j: int = 0;
            while (j < cn - 1) {
                const pid = kDec(m);
                if (pid != 48) {
                    print("semamirror: patf 坏形");
                    panic("abort");
                }
                listPush(patfs, cStr(m.c));
                if (cDec(m.c) != 0) {
                    print("semamirror: patf 子数坏形");
                    panic("abort");
                }
                j = j + 1;
            }
            const body = readExpr(m);
            const arm = new Arm { id: anid, isElse: isElse, vname: name, patfs: patfs, body: body, line: aline, col: acol };
            listPush(e.arms, arm);
            i = i + 1;
        }
        return e;
    }
    if (id == 49) {
        const isAsync = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const e = newExpr(m, id, line, col);
        const af = new ArrowX { params: listNew(), ret: m.dummyT, isBlock: false, bodyExpr: None, bodyBlock: None, line: line, col: col, isAsync: isAsync };
        let seen: int = 0;
        while (seen < n) {
            const cid = peekKind(m);
            if (cid == 2) {
                listPush(af.params, readParam(m));
            } else if (cid == 3) {
                af.ret = readRetSlot(m);
            } else if (cid == 50) {
                const bk = kDec(m);
                if (cDec(m.c) != 1) {
                    print("semamirror: body 子数坏形");
                    panic("abort");
                }
                const bc = peekKind(m);
                if (bc == 4) {
                    af.isBlock = true;
                    af.bodyBlock = readBlock(m);
                } else {
                    af.bodyExpr = readExpr(m);
                }
            } else {
                print("semamirror: arrow 子槽坏形");
                panic("abort");
            }
            seen = seen + 1;
        }
        e.af = af;
        return e;
    }
    if (id == 51) {
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: await 子数坏形");
            panic("abort");
        }
        const e = newExpr(m, id, line, col);
        e.a = readExpr(m);
        return e;
    }
    print("semamirror: 未知表达式节点 " + toStr(id));
    panic("abort");
    return m.dummyE;
}

function readDecl(m: Ref<Mat>): Ref<Decl> {
    const id = kDec(m);
    const nid = matNode(m);
    const d = new Decl { tag: id, impNames: listNew(), impPath: "", fn: None, ext: None, sd: None, ed: None, bd: None, td: None, idl: None, impLine: 0, impCol: 0, hd: None, xst: false };
    if (id == 10) {
        const n = cDec(m.c);
        let i: int = 0;
        while (i < n) {
            listPush(d.impNames, cStr(m.c));
            i = i + 1;
        }
        d.impPath = cStr(m.c);
        d.impLine = cDec(m.c);
        d.impCol = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: import 子数坏形");
            panic("abort");
        }
        return d;
    }
    if (id == 1) {
        const name = cStr(m.c);
        const exported = cDec(m.c) != 0;
        // async 位：1＝async，2＝生成器 function*（D3 v0.22）。
        const asyncFlag = cDec(m.c);
        const isAsync = asyncFlag == 1;
        const isGen = asyncFlag == 2;
        const isExtern = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const params: List<Ref<Param>> = listNew();
        let ret: Ref<Te>? = None;
        let body: Ref<Block>? = None;
        let tps: List<string> = listNew();
        const tcs: List<Ref<Te>> = listNew();
        let fmode: int = 0;
        let flib: string = "";
        let fnr: int = 0;
        let fline: int = 0;
        let fcol: int = 0;
        let nfix: int = -1;
        let seen: int = 0;
        while (seen < n) {
            const cid = peekKind(m);
            if (cid == 64 || cid == 69) {
                tps = readTparams(m, tcs);
            } else if (cid == 2) {
                listPush(params, readParam(m));
            } else if (cid == 3) {
                ret = readRetSlot(m);
            } else if (cid == 4) {
                body = readBlock(m);
            } else if (cid == 72) {
                // D3 v0.23 FFI：from 子句（方式、库名、syscall 号、位置，无子）。
                kDec(m);
                fmode = cDec(m.c);
                flib = cStr(m.c);
                fnr = cDec(m.c);
                fline = cDec(m.c);
                fcol = cDec(m.c);
                if (cDec(m.c) != 0) {
                    print("semamirror: from 子数坏形");
                    panic("abort");
                }
            } else if (cid == 75) {
                // D3 v0.36 C 变参：定参个数与第一个 `...` 的位置（无子）。
                kDec(m);
                nfix = cDec(m.c);
                cDec(m.c);
                cDec(m.c);
                if (cDec(m.c) != 0) {
                    print("semamirror: varargs 子数坏形");
                    panic("abort");
                }
            } else {
                print("semamirror: fn 子槽坏形");
                panic("abort");
            }
            seen = seen + 1;
        }
        if (isExtern) {
            const x = new ExternDecl { name: name, params: params, ret: ret catch m.dummyT, line: line, col: col, fmode: fmode, flib: flib, fnr: fnr, fline: fline, fcol: fcol, nfix: nfix };
            d.ext = x;
            return d;
        }
        const f = new FnDecl { id: nid, name: name, params: params, ret: ret, body: body catch m.dummyB, exported: exported, isAsync: isAsync, isGen: isGen, line: line, col: col, tps: tps, tcs: tcs };
        d.fn = f;
        return d;
    }
    if (id == 73) {
        // D3 v0.23 FFI：declare type 名;
        const name = cStr(m.c);
        const exported = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 0) {
            print("semamirror: declare type 子数坏形");
            panic("abort");
        }
        d.hd = new HandleDecl { name: name, exported: exported, line: line, col: col };
        return d;
    }
    if (id == 5 || id == 74) {
        // 74＝declare struct（D3 v0.23 FFI，节点形同 struct）：按 struct 处理并记 xst。
        d.tag = 5;
        d.xst = id == 74;
        const name = cStr(m.c);
        const exported = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const sd = new StructDecl { name: name, exported: exported, fnames: listNew(), ftes: listNew(), tps: listNew(), tcs: listNew(), line: line, col: col };
        let i: int = 0;
        while (i < n) {
            if ((peekKind(m) == 64 || peekKind(m) == 69) && listLen(sd.tps) == 0 && listLen(sd.fnames) == 0) {
                sd.tps = readTparams(m, sd.tcs);
                i = i + 1;
                continue;
            }
            const fk = kDec(m);
            if (fk != 6) {
                print("semamirror: field_d 坏形");
                panic("abort");
            }
            const fname = cStr(m.c);
            if (cDec(m.c) != 1) {
                print("semamirror: field 子数坏形");
                panic("abort");
            }
            listPush(sd.fnames, fname);
            listPush(sd.ftes, readType(m));
            i = i + 1;
        }
        d.sd = sd;
        return d;
    }
    if (id == 7 || id == 66) {
        const name = cStr(m.c);
        const exported = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const ed = new EnumDecl { isErr: false, name: name, exported: exported, vars: listNew(), line: line, col: col };
        let i: int = 0;
        while (i < n) {
            const vid = kDec(m);
            if (vid != 8) {
                print("semamirror: variant_d 坏形 vid=" + toStr(vid));
                panic("abort");
            }
            const vname = cStr(m.c);
            const vn = cDec(m.c);
            const vd = new VarDecl { msg: None, name: vname, fnames: listNew(), ftes: listNew() };
            let j: int = 0;
            while (j < vn) {
                const fk = kDec(m);
                if (fk != 6) {
                    print("semamirror: 变体 field 坏形");
                    panic("abort");
                }
                const fname = cStr(m.c);
                if (cDec(m.c) != 1) {
                    print("semamirror: 变体 field 子数坏形");
                    panic("abort");
                }
                listPush(vd.fnames, fname);
                listPush(vd.ftes, readType(m));
                j = j + 1;
            }
            if (id == 66) {
                if (cDec(m.c) == 1) { vd.msg = readExpr(m); }
            }
            listPush(ed.vars, vd);
            i = i + 1;
        }
        ed.isErr = id == 66;
        d.ed = ed;
        d.tag = 7;
        return d;
    }
    if (id == 68) {
        // D3 v0.20 interface：可选型参表＋方法签名（extern 形 fn 节点）。
        const name = cStr(m.c);
        const exported = cDec(m.c) != 0;
        const line = cDec(m.c);
        const col = cDec(m.c);
        const n = cDec(m.c);
        const idl = new IfaceDecl { name: name, exported: exported, tps: listNew(), tcs: listNew(), mnames: listNew(), msigs: listNew(), line: line, col: col };
        const dx = new ExternDecl { name: "", params: listNew(), ret: m.dummyT, line: 0, col: 0, fmode: 0, flib: "", fnr: 0, fline: 0, fcol: 0, nfix: -1 };
        let i: int = 0;
        while (i < n) {
            const ck = peekKind(m);
            if ((ck == 64 || ck == 69) && i == 0) {
                idl.tps = readTparams(m, idl.tcs);
            } else {
                const md = readDecl(m);
                const x = md.ext catch dx;
                listPush(idl.mnames, x.name);
                listPush(idl.msigs, x);
            }
            i = i + 1;
        }
        d.idl = idl;
        return d;
    }
    if (id == 9) {
        const name = cStr(m.c);
        const line = cDec(m.c);
        const col = cDec(m.c);
        if (cDec(m.c) != 1) {
            print("semamirror: test 子数坏形");
            panic("abort");
        }
        const td = new TestDecl { name: name, body: readBlock(m), line: line, col: col };
        d.td = td;
        return d;
    }
    if (id == 11 || id == 12) {
        d.bd = readBinding(m, id == 12, nid);
        return d;
    }
    print("semamirror: 未知声明节点 " + toStr(id));
    panic("abort");
    return d;
}

// 模块读入：头部 "TXB1 <nodes> <sbytes> "＋声明流。
function readTxModule(bin: string, base: int): List<Ref<Decl>> {
    const m = newMat(bin, base);
    const c = m.c;
    if ((byteAt(bin, 0) catch 0) != 84 || (byteAt(bin, 1) catch 0) != 88 || (byteAt(bin, 2) catch 0) != 66 || (byteAt(bin, 3) catch 0) != 49 || (byteAt(bin, 4) catch 0) != 32) {
        print("semamirror: 坏 TXB1 magic");
        panic("abort");
    }
    c.pos = 5;
    const wantNodes = cDec(c);
    const wantStr = cDec(c);
    const decls: List<Ref<Decl>> = listNew();
    while (c.pos < c.n) {
        listPush(decls, readDecl(m));
    }
    if (m.nodes != wantNodes) {
        print("semamirror: 节点数不符 " + toStr(m.nodes) + "!=" + toStr(wantNodes));
        panic("abort");
    }
    return decls;
}

// ============================================================================
// §5 Sema 镜像——src/compiler/sema/sema.zig 逐函数逐记账点复刻
// ============================================================================

// —— 诊断发射（V0.42-B1-⑤；SEB1 第 26 节——sema.zig self.err 镜像）：
// code=diag.Code 常量值；line/col=对应节点 at；msg=格式化串（与 zig
// std.fmt 逐字节一致）；module_idx=curMod 序；检查序追加不排序。
function emitDiag(s: Ref<Sm>, code: int, line: int, col: int, msg: string): void {
    if (s.iv.defCheck > 0) {
        // D3 v0.20：带约束模板的定义处检查（类型参数按约束看待）——一律记 3031。
        listPush(s.diagRows, mkRow(3031, s.curMod.idx, line, col, 0, 0, 0));
        listPush(s.diagMsgs, "泛型模板按约束检查不通过：" + msg);
        return;
    }
    listPush(s.diagRows, mkRow(code, s.curMod.idx, line, col, 0, 0, 0));
    listPush(s.diagMsgs, msg);
}

// 前缀判断（S1 无 startsWith——导入路径文法面用）。
function strStartsWith(h: string, p: string): bool {
    const hn = len(h);
    const pn = len(p);
    if (hn < pn) { return false; }
    let i: int = 0;
    while (i < pn) {
        if ((byteAt(h, i) catch 0) != (byteAt(p, i) catch 0)) { return false; }
        i = i + 1;
    }
    return true;
}

// 作用域顶查名（同一作用域重复声明判定——sema checkStmt top().get 镜像）。
function scopeTopHas(s: Ref<Sm>, name: string): bool {
    if (listLen(s.scopes) == 0) { return false; }
    return scopeFind(scopeTop(s), name) >= 0;
}

// 作用域内按名找最后登记的下标，无则 -1（容量批 C3b）。名字不超过 32 个时从尾向前线性查找；更多时用
// 散列链——作用域名表只追加，按需增量补链，负载过半时桶数翻倍重建；按下标升序头插，链头即最新，
// 与从尾向前的线性查找结果相同。原为一律线性，单个作用域 7 万个局部时 sema 189 秒。
function scopeFind(sc: Ref<Scope>, name: string): int {
    const n = listLen(sc.names);
    if (n <= 32) {
        let j: int = n - 1;
        while (j >= 0) {
            if ((listGet(sc.names, j) catch "") == name) { return j; }
            j = j - 1;
        }
        return -1;
    }
    if (listLen(sc.hHead) < n * 2) {
        let nb: int = 64;
        while (nb < n * 4) { nb = nb * 2; }
        sc.hHead = listNew();
        sc.hNext = listNew();
        let b: int = 0;
        while (b < nb) {
            listPush(sc.hHead, -1);
            b = b + 1;
        }
    }
    while (listLen(sc.hNext) < n) {
        const k = listLen(sc.hNext);
        const bk = symHash(listGet(sc.names, k) catch "") % listLen(sc.hHead);
        listPush(sc.hNext, listGet(sc.hHead, bk) catch -1);
        listSet(sc.hHead, bk, k);
    }
    let i: int = listGet(sc.hHead, symHash(name) % listLen(sc.hHead)) catch -1;
    while (i >= 0) {
        if ((listGet(sc.names, i) catch "") == name) { return i; }
        i = listGet(sc.hNext, i) catch -1;
    }
    return -1;
}

function b2i(b: bool): int {
    if (b) { return 1; }
    return 0;
}

function lowerCh(ch: int): int {
    if (ch >= 65 && ch <= 90) { return ch + 32; }
    return ch;
}

function upperCh(ch: int): int {
    if (ch >= 97 && ch <= 122) { return ch - 32; }
    return ch;
}

function lowerFirst(name: string): string {
    if (len(name) == 0) { return name; }
    const c0 = byteAt(name, 0) catch 0;
    // strSub(s, from, count)——第三参为计数（V0.21-L1 码元面语义）；执行发现
    // （B1-④）：原形 `strSub(name, 1, len(name))` 传终界致区间越界 trap——
    // 探针集无方法糖负载故潜伏；sugar-forin 负载 first-press 即崩。
    return (utf8Encode(lowerCh(c0)) catch "") + strSub(name, 1, len(name) - 1);
}

function upperFirst(name: string): string {
    if (len(name) == 0) { return name; }
    const c0 = byteAt(name, 0) catch 0;
    return (utf8Encode(upperCh(c0)) catch "") + strSub(name, 1, len(name) - 1);
}

