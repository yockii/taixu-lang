// glass —— frameless 自绘标题栏＋效果声明样例（
// 增补②③兑现的"毛玻璃窗形态"样例）。
//
// 确定性校验（无头通道——标题栏自绘面即内容面，golden 逐字节守护；特效
// 不入 golden——headless 占位，既定边界）：
//   TAIXU_REPLAY=../tests/glass-close.txt TAIXU_FRAME=1 TAIXU_OUT_DIR=/tmp taixu run examples/glass.tx
// 真窗冒烟：taixu run examples/glass.tx --auto=800
import { Canvas, canvasNew, drawButtonC, paintText, paintFillRect, paintStrokeRect, Button, button } from "gui/components";
import { App, appNew, appClose, pump, appFrameChrome, defaultSpec, scale, capabilities, EFFECT_ACRYLIC, onEvent, onResize, hitZone } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_CARD: int = 1;

struct Glass {
    clicks: int,
    surface: int, // 经 Ref 持有——onResize 闭包按值捕获，须过引用改写
}

function render(cv: Ref<Canvas>, app: Ref<App>, g: Ref<Glass>): void {
    surfaceClear(cv.h, 0x1A1A2E);
    // 内容面：声明卡片（毛玻璃窗形态的内容占位）。
    paintFillRect(cv, 20, 44, app.w - 40, 116, 0x24243E);
    paintStrokeRect(cv, 20, 44, app.w - 40, 116, 0x3A3A5C);
    // 行距 24（反馈 #3——真实文本轨 14px 字形按 8×10 字模行距排必然挤压）。
    paintText(cv, 30, 56, 0xC8C8E8, "acrylic frameless window 毛玻璃窗形态");
    paintText(cv, 30, 80, 0x8888B0, "title bar is app-drawn content");
    paintText(cv, 30, 104, 0x8888B0, "effect tier reported by capabilities()");
    paintText(cv, 30, 132, 0x60C090, "clicks=" + toStr(g.clicks));
    // frameless 自绘标题栏最后盖绘（自绘面即内容面最上层——golden 守护）。
    appFrameChrome(app, cv);
}

export function main(args: []string): int {
    args;
    const spec = defaultSpec("taixu glass", 300, 190);
    spec.frameless = true;
    spec.effect = EFFECT_ACRYLIC;
    const app = appNew(spec);
    const g = new Glass { clicks: 0, surface: 0 };
    const caps = capabilities();
    g.surface = surfaceOpen(spec.w, spec.h) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(g.surface);
        return 1;
    };
    // resize 即失效：surface 随新客户区重建（v0.1.4 反馈 #5 白边根治）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(g.surface);
            g.surface = surfaceOpen(w, h) catch 0;
        });
    onEvent(app, ID_CARD, (rec: EventRecord): void => {
            if (rec.kind == 3) {
                g.clicks = g.clicks + 1;
            }
        });
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvas(g.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, g);
            hitZone(app, ID_CARD, 20, 44, app.w - 40, 116);
            const rc: int = windowPresent(app.hwnd, g.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("glass exit clicks=" + toStr(g.clicks) + " effects=" + toStr(caps.effects) + " frameless=" + toStr(caps.frameless) + " dpi=" + toStr(caps.dpi_scale_x100) + " scale=" + toStr(scale(app)) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(g.surface);
    return 0;
}
