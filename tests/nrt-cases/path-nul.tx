// 字符串过系统边界时的 NUL（核心安全；伴文件 .toolchain）：路径、程序路径、进程参数里的 NUL 会被系统在该处截断，
// 看到的是另一个串（"/taixu-no-such-dir/a\0b" 成了 ".../a"）。一律按无效实参拒绝，不截断（同 Go 的 EINVAL、Rust 的
// NulError、Python 的 ValueError）。前缀目录不存在：万一截断，操作也只会得 no such file，不会在任何地方建出文件。
function nulPath(): string {
    const b = bytesNew(21);
    const head = "/taixu-no-such-dir/a";
    let i = 0;
    while (i < len(head)) {
        bytesSet(b, i, byteAt(head, i) catch 0);
        i = i + 1;
    }
    bytesSet(b, 20, 0);
    const s = bytesToStr(b) catch "";
    return s + "b";
}

function status(m: string): string {
    return strSub(m, 0, strIndexOf(m, ":"));
}

function tryRead(p: string): string {
    const s = readFile(p) catch (e) { return status(e.message); };
    return "ok " + toStr(len(s));
}

function tryReadBytes(p: string): string {
    const b = readFileBytes(p) catch (e) { return status(e.message); };
    return "ok " + toStr(bytesLen(b));
}

function tryList(p: string): string {
    const names = listDir(p) catch (e) { return status(e.message); };
    return "ok " + toStr(listLen(names));
}

function tryRun(exe: string, argv: List< string>, err: string): string {
    const code = runProcess(exe, argv, err) catch (e) { return status(e.message); };
    return "ok " + toStr(code);
}

function main(args: []string): int {
    const p = nulPath();
    print("len " + toStr(len(p)));
    print("readFile: " + tryRead(p));
    writeFile(p, "x") catch (e) { print("writeFile: " + status(e.message)); };
    print("readFileBytes: " + tryReadBytes(p));
    makeDir(p) catch (e) { print("makeDir: " + status(e.message)); };
    removeFile(p) catch (e) { print("removeFile: " + status(e.message)); };
    print("listDir: " + tryList(p));
    print("entryKind: " + toStr(entryKind(p)));
    const none: List< string> = listNew();
    print("runProcess exe: " + tryRun(p, none, ""));
    const argv: List< string> = listNew();
    listPush(argv, p);
    print("runProcess arg: " + tryRun("/taixu-no-such-dir/x", argv, ""));
    print("runProcess stderr: " + tryRun("/taixu-no-such-dir/x", none, p));
    return 0;
}
