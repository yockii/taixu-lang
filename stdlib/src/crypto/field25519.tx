// 内部域 GF(2^255-19)，17 个 15 位分量。全部循环次数固定，不按域元素取表或分支。
export function fieldSmall(value: int): List<int> {
    const out: List<int> = listNew();
    let i = 0;
    while (i < 17) { listPush(out, 0); i = i + 1; }
    listSet(out, 0, value & 32767); listSet(out, 1, value >> 15);
    return out;
}

function carry(out: List<int>): void {
    let round = 0;
    while (round < 4) {
        let c = 0; let i = 0;
        while (i < 17) {
            const v = listGet(out, i) + c;
            listSet(out, i, v & 32767); c = v >> 15; i = i + 1;
        }
        listSet(out, 0, listGet(out, 0) + c * 19);
        round = round + 1;
    }
}

export function fieldDecode(data: Bytes): List<int> {
    const out = fieldSmall(0);
    let i = 0;
    while (i < 255) {
        const b = bytesGet(data, i / 8) catch panic("ecdh: internal byte bounds");
        const at = i / 15;
        listSet(out, at, listGet(out, at) | (((b >> (i % 8)) & 1) << (i % 15)));
        i = i + 1;
    }
    return out;
}

export function fieldAdd(a: List<int>, b: List<int>): List<int> {
    const out = fieldSmall(0); let i = 0;
    while (i < 17) { listSet(out, i, listGet(a, i) + listGet(b, i)); i = i + 1; }
    carry(out); return out;
}

export function fieldSub(a: List<int>, b: List<int>): List<int> {
    const out = fieldSmall(0); let i = 0;
    while (i < 17) {
        let p = 32767;
        if (i == 0) { p = 32749; }
        listSet(out, i, listGet(a, i) + p * 2 - listGet(b, i)); i = i + 1;
    }
    carry(out); return out;
}

export function fieldMul(a: List<int>, b: List<int>): List<int> {
    const product: List<int> = listNew();
    let i = 0;
    while (i < 33) { listPush(product, 0); i = i + 1; }
    i = 0;
    while (i < 17) {
        let j = 0;
        while (j < 17) {
            listSet(product, i + j, listGet(product, i + j) + listGet(a, i) * listGet(b, j));
            j = j + 1;
        }
        i = i + 1;
    }
    i = 32;
    while (i >= 17) { listSet(product, i - 17, listGet(product, i - 17) + listGet(product, i) * 19); i = i - 1; }
    const out = fieldSmall(0); i = 0;
    while (i < 17) { listSet(out, i, listGet(product, i)); i = i + 1; }
    carry(out); return out;
}

export function fieldSquare(a: List<int>): List<int> { return fieldMul(a, a); }

export function fieldSwap(a: List<int>, b: List<int>, bit: int): void {
    const mask = -bit; let i = 0;
    while (i < 17) {
        const av = listGet(a, i); const bv = listGet(b, i); const change = (av ^ bv) & mask;
        listSet(a, i, av ^ change); listSet(b, i, bv ^ change); i = i + 1;
    }
}

export function fieldInverse(a: List<int>): List<int> {
    let out = fieldSmall(1); let i = 254;
    while (i >= 0) {
        out = fieldSquare(out);
        if (i != 2 && i != 4) { out = fieldMul(out, a); }
        i = i - 1;
    }
    return out;
}

export function fieldEncode(a: List<int>): Bytes {
    const v = fieldAdd(a, fieldSmall(0));
    const candidate = fieldSmall(0); let borrow = 0; let i = 0;
    while (i < 17) {
        let p = 32767;
        if (i == 0) { p = 32749; }
        const difference = listGet(v, i) - p - borrow;
        borrow = (difference >> 63) & 1;
        listSet(candidate, i, difference + borrow * 32768); i = i + 1;
    }
    const mask = borrow - 1; i = 0;
    while (i < 17) {
        const original = listGet(v, i);
        listSet(v, i, original ^ ((original ^ listGet(candidate, i)) & mask)); i = i + 1;
    }
    const out = bytesNew(32); i = 0;
    while (i < 255) {
        const at = i / 8; const b = bytesGet(out, at) catch panic("ecdh: internal encode bounds");
        bytesSet(out, at, b | (((listGet(v, i / 15) >> (i % 15)) & 1) << (i % 8))); i = i + 1;
    }
    return out;
}
