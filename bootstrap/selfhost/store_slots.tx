// Native-owned Obj/RC/index/free-chain storage. Payload semantics remain separate.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
import { tSysV } from "./target";
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function d(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function m(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
function md(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { op(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
function call(b: Ref<StructuredBuffer>, name: string): void { jump(b, "call", name); }
function ret(b: Ref<StructuredBuffer>): void { op(b, "ret", 0, asStructuredMissing(), asStructuredMissing()); }

export function storeSlotsEmit(b: Ref<StructuredBuffer>, t: int): void {
    let copy = "memcpy"; let fill = "memset";
    if (tSysV(t)) { copy = "__tx_linux_memcpy"; fill = "__tx_linux_memset"; }
    lab(b, "__tx_native_slots_create_v2"); two(b, "sub", r(4), i(56));
    mov(b, d(1), d(1)); two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_ss_create_bad");
    mov(b, m(4, 32), r(1)); mov(b, r(1), i(64)); mov(b, r(2), i(8)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_ss_create_done");
    mov(b, m(4, 40), r(0)); mov(b, r(1), r(0)); mov(b, r(2), i(0)); mov(b, r(8), i(64)); call(b, fill);
    mov(b, r(10), m(4, 40)); mov(b, d(0), i(-1)); mov(b, m(10, 32), r(0));
    mov(b, r(0), m(4, 32)); mov(b, m(10, 56), r(0)); mov(b, r(0), r(10)); jump(b, "jmp", "__tx_ss_create_done");
    lab(b, "__tx_ss_create_bad"); mov(b, r(0), i(0));
    lab(b, "__tx_ss_create_done"); two(b, "add", r(4), i(56)); ret(b);

    lab(b, "__tx_native_slots_acquire_v2"); two(b, "sub", r(4), i(104)); mov(b, m(4, 32), r(1));
    two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_ss_fail");
    mov(b, r(0), m(1, 32)); mov(b, d(9), i(-1)); two(b, "cmp", r(0), r(9)); jump(b, "jne", "__tx_ss_pop");
    mov(b, r(0), m(1, 16)); mov(b, d(9), i(-2)); two(b, "cmp", r(0), r(9)); jump(b, "jae", "__tx_ss_fail");
    two(b, "cmp", r(0), m(1, 24)); jump(b, "jb", "__tx_ss_append");
    mov(b, r(0), m(1, 24)); two(b, "test", r(0), r(0)); jump(b, "jne", "__tx_ss_double");
    mov(b, r(0), i(64)); jump(b, "jmp", "__tx_ss_capacity");
    lab(b, "__tx_ss_double"); two(b, "shl", r(0), i(1)); two(b, "cmp", r(0), r(9)); jump(b, "jbe", "__tx_ss_capacity"); mov(b, r(0), r(9));
    lab(b, "__tx_ss_capacity"); mov(b, m(4, 40), r(0)); mov(b, r(1), r(0)); two(b, "shl", r(1), i(2)); mov(b, r(2), i(4)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_ss_fail"); mov(b, m(4, 48), r(0));
    mov(b, r(1), m(4, 40)); two(b, "shl", r(1), i(2)); mov(b, r(2), i(4)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_ss_second_fail"); mov(b, m(4, 56), r(0));
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(4, 40)); mov(b, r(9), m(10, 56)); two(b, "imul", r(1), r(9));
    mov(b, r(2), i(16)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_ss_third_fail"); mov(b, m(4, 72), r(0));
    mov(b, r(10), m(4, 32)); mov(b, r(8), m(10, 16)); two(b, "shl", r(8), i(2)); mov(b, m(4, 64), r(8));
    two(b, "test", r(8), r(8)); jump(b, "jz", "__tx_ss_copied");
    mov(b, r(1), m(4, 48)); mov(b, r(2), m(10, 0)); call(b, copy);
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(4, 56)); mov(b, r(2), m(10, 8)); mov(b, r(8), m(4, 64)); call(b, copy);
    mov(b, r(10), m(4, 32)); mov(b, r(8), m(10, 16)); mov(b, r(9), m(10, 56)); two(b, "imul", r(8), r(9));
    mov(b, r(1), m(4, 72)); mov(b, r(2), m(10, 48)); call(b, copy);
    lab(b, "__tx_ss_copied");
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(10, 0)); call(b, "__tx_native_mem_free");
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(10, 8)); call(b, "__tx_native_mem_free");
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(10, 48)); call(b, "__tx_native_mem_free");
    mov(b, r(1), m(4, 32)); mov(b, r(0), m(4, 48)); mov(b, m(1, 0), r(0));
    mov(b, r(0), m(4, 56)); mov(b, m(1, 8), r(0)); mov(b, r(0), m(4, 40)); mov(b, m(1, 24), r(0));
    mov(b, r(0), m(4, 72)); mov(b, m(1, 48), r(0));
    mov(b, r(0), m(1, 16));
    lab(b, "__tx_ss_append"); mov(b, r(11), r(0)); two(b, "add", r(11), i(1)); mov(b, m(1, 16), r(11)); jump(b, "jmp", "__tx_ss_live");
    lab(b, "__tx_ss_pop"); mov(b, r(11), r(0)); two(b, "shl", r(11), i(2)); mov(b, r(10), m(1, 8)); two(b, "add", r(10), r(11));
    mov(b, d(9), md(10, 0)); mov(b, m(1, 32), r(9)); mov(b, r(9), m(1, 40)); two(b, "sub", r(9), i(1)); mov(b, m(1, 40), r(9));
    lab(b, "__tx_ss_live"); mov(b, r(11), r(0)); two(b, "shl", r(11), i(2)); mov(b, r(10), m(1, 0)); two(b, "add", r(10), r(11)); mov(b, md(10, 0), i(1));
    mov(b, r(10), m(1, 8)); two(b, "add", r(10), r(11)); mov(b, md(10, 0), i(-2)); jump(b, "jmp", "__tx_ss_done");
    lab(b, "__tx_ss_third_fail"); mov(b, r(1), m(4, 56)); call(b, "__tx_native_mem_free");
    lab(b, "__tx_ss_second_fail"); mov(b, r(1), m(4, 48)); call(b, "__tx_native_mem_free");
    lab(b, "__tx_ss_fail"); mov(b, d(0), i(-1));
    lab(b, "__tx_ss_done"); two(b, "add", r(4), i(104)); ret(b);

    lab(b, "__tx_native_slots_free_v2"); two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_ss_free_bad");
    mov(b, d(2), d(2)); two(b, "cmp", r(2), m(1, 16)); jump(b, "jae", "__tx_ss_free_bad");
    mov(b, r(11), r(2)); two(b, "shl", r(11), i(2)); mov(b, r(10), m(1, 8)); two(b, "add", r(10), r(11));
    two(b, "cmp", md(10, 0), i(-2)); jump(b, "jne", "__tx_ss_free_bad");
    mov(b, r(9), m(1, 0)); two(b, "add", r(9), r(11)); two(b, "cmp", md(9, 0), i(0)); jump(b, "jne", "__tx_ss_free_bad");
    mov(b, r(9), m(1, 32)); mov(b, md(10, 0), d(9)); mov(b, m(1, 32), r(2));
    mov(b, r(9), m(1, 40)); two(b, "add", r(9), i(1)); mov(b, m(1, 40), r(9)); mov(b, d(0), i(1)); ret(b);
    lab(b, "__tx_ss_free_bad"); mov(b, d(0), i(0)); ret(b);

    lab(b, "__tx_native_slots_destroy_v2"); two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_ss_destroy_null");
    two(b, "sub", r(4), i(40)); mov(b, m(4, 32), r(1)); mov(b, r(1), m(1, 0)); call(b, "__tx_native_mem_free");
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(10, 8)); call(b, "__tx_native_mem_free");
    mov(b, r(10), m(4, 32)); mov(b, r(1), m(10, 48)); call(b, "__tx_native_mem_free");
    mov(b, r(1), m(4, 32)); call(b, "__tx_native_mem_free"); two(b, "add", r(4), i(40));
    lab(b, "__tx_ss_destroy_null"); ret(b);
}
