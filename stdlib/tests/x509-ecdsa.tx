import { x509ParseCertificate } from "std/x509";
import { X509Certificate } from "std/x509_types";
import { x509VerifyCertificateSignature, x509P384PublicKey } from "std/x509_keys";
import { p256Hex } from "std/crypto/p256_field";

function lines(): List<string> { return strSplit(readFile("tests/vectors/x509-ecdsa.txt") catch panic("ECDSA certificates"), "\n"); }
function signatureError(cert: Ref<X509Certificate>): bool { x509VerifyCertificateSignature(cert, cert) catch (e) { return true; }; return false; }
function keyError(cert: Ref<X509Certificate>): bool { x509P384PublicKey(cert) catch (e) { return true; }; return false; }

test "X509 ECDSA: independent curve/digest matrix and saved public chains" {
    let own = 0; let publicCount = 0;
    for (line in lines()) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; } const v = strSplit(line, " ");
        const cert = x509ParseCertificate(p256Hex(listGet(v, 3))) catch panic("certificate parse");
        if (listGet(v, 0) == "self") { assert(x509VerifyCertificateSignature(cert, cert) catch panic("self verify"), "curve/digest combination"); own = own + 1; }
        else { const issuer = x509ParseCertificate(p256Hex(listGet(v, 4))) catch panic("issuer parse"); assert(x509VerifyCertificateSignature(cert, issuer) catch panic("public signature verify"), "saved public chain signature"); publicCount = publicCount + 1; }
    }
    assert(own == 4 && publicCount == 5, "all independent and public certificate signatures");
}

test "X509 P384: owned point, strict named curve and signature parameters" {
    for (line in lines()) {
        if (strFind(line, "self secp384r1 sha384 ") != 0) { continue; } const v = strSplit(line, " ");
        const cert = x509ParseCertificate(p256Hex(listGet(v, 3))) catch panic("certificate");
        const point = x509P384PublicKey(cert) catch panic("public key"); assert(bytesLen(point) == 97 && bytesEqual(point, cert.publicKey), "public point");
        bytesSet(point, 0, 0); assert((bytesGet(cert.publicKey, 0) catch 0) == 4, "owned output");
        cert.signatureAlgorithm.parameters = p256Hex("0500"); assert(signatureError(cert), "NULL parameters rejected"); cert.signatureAlgorithm.parameters = bytesNew(0);
        const params = cert.publicKeyAlgorithm.parameters; cert.publicKeyAlgorithm.parameters = bytesNew(0); assert(keyError(cert) && signatureError(cert), "missing named curve rejected");
        cert.publicKeyAlgorithm.parameters = p256Hex("06052b81040023"); assert(keyError(cert) && signatureError(cert), "unknown curve rejected"); cert.publicKeyAlgorithm.parameters = params;
        const before = bytesGet(cert.signature, 0) catch 0; bytesSet(cert.signature, 0, before ^ 1);
        assert(!(x509VerifyCertificateSignature(cert, cert) catch panic("tampered signature")), "altered DER signature rejected"); return;
    } panic("missing P384 certificate");
}
