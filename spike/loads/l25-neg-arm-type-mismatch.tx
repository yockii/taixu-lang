// l25-neg-arm-type-mismatch —— BOOT-19 第八柱 3018 臂类型不一致负例。
// zig sema：switch 表达式各臂类型须一致（首臂定型 int；第二臂 str → 3018）。
enum Op {
    Add(v: int),
    Neg(v: int),
}
export function main(args: []string): int {
    const o: Op = Op.Add(1);
    const n: int = switch (o) {
        case Add(v) => v,
        case Neg(v) => "bad",
    };
    print(toStr(n));
    return 0;
}
