// 外部内存区（D3 v0.48 §6.8-22）前端负例（门槛）：ffiMem、ffiMemOf 只许出现在本身声明了 from 外部函数的模块里；
// 读写函数与 FfiMem 参数不受此限。
declare struct POINT { x: i32, y: i32 }

function open(a: int): int {
    const m = ffiMem(a, 4, false) catch (e) { return 0; };
    const p = ffiMemOf<POINT>(a, false) catch (e) { return 0; };
    return 1;
}

function readOnly(m: FfiMem): int {
    return bytesLen(ffiMemRead(m, 0, 4));
}

function main(args: []string): int {
    return 0;
}
