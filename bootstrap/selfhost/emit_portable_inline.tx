// 可移植渲染器的内联快路径（macOS 适配 M4 设计 A9 修订）：callbi 的 list_push、len、byteAt、listGet／listSet／listLen、
// Bytes 与紧凑列表，以及定宽数值运算族 fwop。逐条对照 emitmirror 的原生形态：类型不符、越界、需要扩容或冻结时一律转通用
// callbi（或 __tx_fw_slow），由内核给出同一结果或同一 trap。标号与 emitmirror 同名。
import { PCtx, pField, pcLbl, payOff, tagOff, ldPay, ldPay32, ldTag, ldTagQ, stPay, stPayI, stTag, stTagQ, guardTag, releaseOld, releaseOldQuick, retainAt, releaseAt, retainSlotOff, argsOf1, argsOf2, argsOf3, kcall, ints4, trap, callbiGeneric } from "./emit_portable_core";
import { G_W, G_K0, G_K1, G_T0, G_T1, G_T2, G_T3, G_SP, genLabel, genJmp, genMov, genMovI, genLd, genSt, genLdX, genStX, genLea, genOp, genOpI, genOpO, genNeg, genNegO, genNot, genDivRem, genBr, genBrI, genFop, genF32Round, genCall, genRes, genRes2, genRes32, gaI, gaR, gaLd, gaLea } from "./gen_ops";

/// callbi 带内联快路径的几种；返回 false 表示不认得、由调用方走通用路。
export function pCallbiInline(c: Ref<PCtx>, pc: int, rec: List<string>, a: int, biId: int, nargs: int): bool {
    if (listLen(rec) < 8) { return false; }
    const t1 = pField(rec, 6, 0);
    const t2 = pField(rec, 7, 0);
    const lbl = pcLbl(c, pc);
    const g = c.g;
    if (nargs == 2 && biId == 14) {
        // listPush：冻结或外部调用借用中的 List 返回非零，转通用路报 4022／4024。
        guardTag(c, a + 1, 15, t1, lbl + "bis");
        genCall(g, "__tx_list_push", argsOf2(gaLd(4, G_W, payOff(a + 1)), gaLea(G_W, tagOff(a + 2))));
        genRes32(g, G_T0);
        genBrI(g, "ne", G_T0, 0, lbl + "bis");
        genJmp(g, lbl + "bie");
        slowTail(c, pc, a, biId, nargs);
        return true;
    }
    if (nargs == 1 && biId == 4) {
        // len：字符串取字节数，数组与切片取元素数。
        ldTag(c, G_T0, a + 1);
        genBrI(g, "eq", G_T0, 6, lbl + "bls");
        genBrI(g, "eq", G_T0, 10, lbl + "blq");
        genBrI(g, "ne", G_T0, 11, lbl + "bis");
        genLabel(g, lbl + "blq");
        genCall(g, "__tx_seq_len", argsOf1(gaLd(4, G_W, payOff(a + 1))));
        genRes(g, G_T0);
        genBrI(g, "eq", G_T0, 0, lbl + "bis");
        genLd(g, 4, G_K1, G_T0, 0);
        genJmp(g, lbl + "blh");
        genLabel(g, lbl + "bls");
        genCall(g, "__tx_str_bytes", argsOf1(gaLd(4, G_W, payOff(a + 1))));
        genRes(g, G_T0);
        genBrI(g, "eq", G_T0, 0, lbl + "bis");
        genLd(g, 8, G_K1, G_T0, 8);
        genLabel(g, lbl + "blh");
        releaseOld(c, a, lbl + "bll");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
        genJmp(g, lbl + "bie");
        slowTail(c, pc, a, biId, nargs);
        return true;
    }
    if (nargs == 2 && biId == 11) {
        // byteAt：界内得 int，越界（含负数）得 None。
        guardTag(c, a + 1, 6, t1, lbl + "bis");
        guardTag(c, a + 2, 1, t2, lbl + "bis");
        genCall(g, "__tx_str_bytes", argsOf1(gaLd(4, G_W, payOff(a + 1))));
        genRes(g, G_T0);
        genBrI(g, "eq", G_T0, 0, lbl + "bis");
        ldPay(c, G_T1, a + 2);
        genLd(g, 8, G_T2, G_T0, 8);
        genBrI(g, "lt", G_T1, 0, lbl + "bin");
        genBr(g, "uge", G_T1, G_T2, lbl + "bin");
        genLd(g, 8, G_T2, G_T0, 0);
        genLdX(g, 1, G_K1, G_T2, G_T1, false);
        releaseOld(c, a, lbl + "brl");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
        genJmp(g, lbl + "bie");
        noneTail(c, a, lbl);
        slowTail(c, pc, a, biId, nargs);
        return true;
    }
    if (biId >= 71 && biId <= 73) { compactInline(c, pc, a, biId, nargs, t1, t2); return true; }
    if (nargs == 2 && biId == 16) { listGetInline(c, pc, rec, a, biId, nargs, t1, t2); return true; }
    if (nargs == 3 && biId == 17) { listSetInline(c, pc, rec, a, biId, nargs, t1, t2); return true; }
    if (nargs == 1 && biId == 18) {
        guardTag(c, a + 1, 15, t1, lbl + "bis");
        listView(c, a, "__tx_list_view", lbl + "bis");
        genLd(g, 8, G_K1, G_SP, 40);
        releaseOld(c, a, lbl + "bll");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
        genJmp(g, lbl + "bie");
        slowTail(c, pc, a, biId, nargs);
        return true;
    }
    if (biId >= 38 && biId <= 41) { bytesInline(c, pc, a, biId, nargs, t1, t2); return true; }
    return false;
}

function slowTail(c: Ref<PCtx>, pc: int, a: int, biId: int, nargs: int): void {
    const lbl = pcLbl(c, pc);
    genLabel(c.g, lbl + "bis");
    callbiGeneric(c, pc, a, biId, nargs);
    genLabel(c.g, lbl + "bie");
}
// 越界得 None。
function noneTail(c: Ref<PCtx>, a: int, lbl: string): void {
    genLabel(c.g, lbl + "bin");
    releaseOld(c, a, lbl + "binx");
    stTag(c, a, 4);
    stPayI(c, a, 0);
    genJmp(c.g, lbl + "bie");
}
// __tx_list_view(句柄, &出参[SP+32..55])：种类码 0 失败（转 fail）、2 为紧凑；出参为元素指针、长度、紧凑元素的标签。种类码留在 T0。
function listView(c: Ref<PCtx>, a: int, sym: string, fail: string): void {
    genCall(c.g, sym, argsOf2(gaLd(4, G_W, payOff(a + 1)), gaLea(G_SP, 32)));
    genRes32(c.g, G_T0);
    genBrI(c.g, "eq", G_T0, 0, fail);
}

function listGetInline(c: Ref<PCtx>, pc: int, rec: List<string>, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const fast = pField(rec, 8, 0);
    guardTag(c, a + 1, 15, t1, lbl + "bis");
    guardTag(c, a + 2, 1, t2, lbl + "bis");
    listView(c, a, "__tx_list_view", lbl + "bis");
    ldPay(c, G_T1, a + 2);
    genLd(g, 8, G_T2, G_SP, 40);
    if (fast == 0) {
        genBrI(g, "lt", G_T1, 0, lbl + "bin");
        genBr(g, "uge", G_T1, G_T2, lbl + "bin");
    }
    genLd(g, 8, G_T2, G_SP, 32);
    genBrI(g, "eq", G_T0, 2, lbl + "brr");
    genOpI(g, "shl", G_T1, G_T1, 4);
    genOp(g, "add", G_K1, G_T2, G_T1);
    retainAt(c, G_K1, lbl + "bkr");
    genLd(g, 8, G_K0, G_K1, 0);
    genLd(g, 8, G_K1, G_K1, 8);
    releaseOld(c, a, lbl + "brl");
    stTagQ(c, a, G_K0);
    stPay(c, a, G_K1);
    genJmp(g, lbl + "bie");
    // 紧凑：元素是 8 字节的原始值，标签取自出参。
    genLabel(g, lbl + "brr");
    genLdX(g, 8, G_K1, G_T2, G_T1, true);
    genLd(g, 4, G_K0, G_SP, 48);
    releaseOldQuick(c, a, lbl + "brrl");
    stTagQ(c, a, G_K0);
    stPay(c, a, G_K1);
    genJmp(g, lbl + "bie");
    noneTail(c, a, lbl);
    slowTail(c, pc, a, biId, nargs);
}

function listSetInline(c: Ref<PCtx>, pc: int, rec: List<string>, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const fast = pField(rec, 8, 0);
    guardTag(c, a + 1, 15, t1, lbl + "bis");
    guardTag(c, a + 2, 1, t2, lbl + "bis");
    listView(c, a, "__tx_list_view_w", lbl + "bis");
    ldPay(c, G_T1, a + 2);
    genLd(g, 8, G_T2, G_SP, 40);
    if (fast == 0) {
        genBrI(g, "lt", G_T1, 0, lbl + "bis");
        genBr(g, "uge", G_T1, G_T2, lbl + "bis");
    }
    genLd(g, 8, G_T2, G_SP, 32);
    genBrI(g, "eq", G_T0, 2, lbl + "brw");
    genOpI(g, "shl", G_T1, G_T1, 4);
    genOp(g, "add", G_K1, G_T2, G_T1);
    retainSlotOff(c, tagOff(a + 3), lbl + "bkr");
    releaseAt(c, G_K1, lbl + "bkw");
    ldTagQ(c, G_T0, a + 3);
    ldPay(c, G_T1, a + 3);
    genSt(g, 8, G_K1, 0, G_T0);
    genSt(g, 8, G_K1, 8, G_T1);
    genJmp(g, lbl + "bie");
    // 紧凑：值的标签须等于列表的元素标签，否则转通用路。
    genLabel(g, lbl + "brw");
    ldTag(c, G_K0, a + 3);
    genLd(g, 4, G_T3, G_SP, 48);
    genBr(g, "ne", G_K0, G_T3, lbl + "bis");
    ldPay(c, G_T3, a + 3);
    genStX(g, 8, G_T2, G_T1, G_T3, true);
    genJmp(g, lbl + "bie");
    slowTail(c, pc, a, biId, nargs);
}

// 紧凑列表 listGet 71、listSet 72、listLen 73：直调内核叶子例程，越界、冻结、非紧凑时转通用路（运行期同 16..18）。
function compactInline(c: Ref<PCtx>, pc: int, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const slow = lbl + "cls";
    guardTag(c, a + 1, 15, t1, slow);
    if (biId != 73) { guardTag(c, a + 2, 1, t2, slow); }
    if (biId == 73) {
        genCall(g, "__tx_list_clen1", argsOf1(gaLd(4, G_W, payOff(a + 1))));
        genRes(g, G_K1);
        genBrI(g, "lt", G_K1, 0, slow);
        releaseOld(c, a, lbl + "cll");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
    } else if (biId == 71) {
        genCall(g, "__tx_list_cget1", argsOf2(gaLd(4, G_W, payOff(a + 1)), gaLd(8, G_W, payOff(a + 2))));
        genRes(g, G_K1);
        genRes2(g, G_K0);
        genOpI(g, "and", G_K0, G_K0, 4294967295);
        genBrI(g, "eq", G_K0, 0, slow);
        releaseOld(c, a, lbl + "cgl");
        stTagQ(c, a, G_K0);
        stPay(c, a, G_K1);
    } else {
        genCall(g, "__tx_list_cset1", argsOf3(gaLd(4, G_W, payOff(a + 1)), gaLd(8, G_W, payOff(a + 2)), gaLea(G_W, tagOff(a + 3))));
        genRes32(g, G_T0);
        genBrI(g, "eq", G_T0, 0, slow);
    }
    genJmp(g, lbl + "bie");
    genLabel(g, slow);
    callbiGeneric(c, pc, a, biId, nargs);
    genLabel(g, lbl + "bie");
}

// Bytes 的 bytesLen 38、bytesGet 39、bytesSet 40、bytesPush 41。__tx_str_bytes(_w) 返回 &ptr（+0 ptr、+8 len、+16 cap）。
function bytesInline(c: Ref<PCtx>, pc: int, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const slow = lbl + "bis";
    guardTag(c, a + 1, 17, t1, slow);
    if (biId != 38) { guardTag(c, a + 2, 1, t2, slow); }
    if (biId == 40) { guardTag(c, a + 3, 1, -1, slow); }
    // 写用访问器：冻结的 Bytes 返回 0，转通用路报 4022。
    let bytesFn = "__tx_str_bytes";
    if (biId == 40 || biId == 41) { bytesFn = "__tx_str_bytes_w"; }
    genCall(g, bytesFn, argsOf1(gaLd(4, G_W, payOff(a + 1))));
    genRes(g, G_T0);
    genBrI(g, "eq", G_T0, 0, slow);
    if (biId == 41) {
        // 外部调用借用中的 Bytes（对象头 flags 位 64，在 &ptr−32）不改长度，转通用路报 4024（D3 v0.34）。
        genLd(g, 4, G_T1, G_T0, -32);
        genOpI(g, "and", G_T1, G_T1, 64);
        genBrI(g, "ne", G_T1, 0, slow);
    }
    if (biId == 38) {
        genLd(g, 8, G_K1, G_T0, 8);
        releaseOld(c, a, lbl + "bll");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
    } else if (biId == 39) {
        ldPay(c, G_T1, a + 2);
        genLd(g, 8, G_T2, G_T0, 8);
        genBr(g, "uge", G_T1, G_T2, lbl + "bin");
        genLd(g, 8, G_T2, G_T0, 0);
        genLdX(g, 1, G_K1, G_T2, G_T1, false);
        releaseOld(c, a, lbl + "brl");
        stPay(c, a, G_K1);
        stTag(c, a, 1);
        genJmp(g, lbl + "bie");
        genLabel(g, lbl + "bin");
        releaseOld(c, a, lbl + "binx");
        stTag(c, a, 4);
        stPayI(c, a, 0);
    } else if (biId == 40) {
        ldPay(c, G_T1, a + 2);
        genLd(g, 8, G_T2, G_T0, 8);
        genBr(g, "uge", G_T1, G_T2, slow);
        ldPay(c, G_T3, a + 3);
        genBrI(g, "ugt", G_T3, 255, slow);
        genLd(g, 8, G_T2, G_T0, 0);
        genStX(g, 1, G_T2, G_T1, G_T3, false);
    } else {
        ldPay(c, G_T3, a + 2);
        genBrI(g, "ugt", G_T3, 255, slow);
        genLd(g, 8, G_T1, G_T0, 8);
        genLd(g, 8, G_T2, G_T0, 16);
        genBr(g, "uge", G_T1, G_T2, slow);
        genLd(g, 8, G_T2, G_T0, 0);
        genStX(g, 1, G_T2, G_T1, G_T3, false);
        genOpI(g, "add", G_T1, G_T1, 1);
        genSt(g, 8, G_T0, 8, G_T1);
    }
    genJmp(g, lbl + "bie");
    slowTail(c, pc, a, biId, nargs);
}

// —— 定宽数值运算族（fwop，设计 §七-4）：fop = 256 + 类型×16 + 运算；类型 1..3 有符号窄、4..6 无符号窄、7 u64、8 i64、9 usize、
// 10 f32；运算 0 加 1 减 2 乘 3 除 4 余 5 取负 6 取反 7 << 8 >> 9 >>> 10..12 环绕加减乘。快路径在 T0 里算，溢出、除零、计数越界、
// 标签不符转冷路径 __tx_fw_slow 重算并给出带类型的 trap。——
function fwRangeCheck(c: Ref<PCtx>, t: int, cold: string): void {
    const g = c.g;
    if (t == 1 || t == 2 || t == 3) {
        let sh = 32;
        if (t == 1) { sh = 56; }
        if (t == 2) { sh = 48; }
        genOpI(g, "shl", G_T2, G_T0, sh);
        genOpI(g, "sar", G_T2, G_T2, sh);
        genBr(g, "ne", G_T2, G_T0, cold);
    } else if (t == 4 || t == 5) {
        let hi = 255;
        if (t == 5) { hi = 65535; }
        genBrI(g, "ugt", G_T0, hi, cold);
    } else if (t == 6) {
        genOpI(g, "shr", G_T2, G_T0, 32);
        genBrI(g, "ne", G_T2, 0, cold);
    }
}
function fwWrap(c: Ref<PCtx>, t: int): void {
    const g = c.g;
    if (t == 1) { genOpI(g, "shl", G_T0, G_T0, 56); genOpI(g, "sar", G_T0, G_T0, 56); }
    if (t == 2) { genOpI(g, "shl", G_T0, G_T0, 48); genOpI(g, "sar", G_T0, G_T0, 48); }
    if (t == 3) { genOpI(g, "shl", G_T0, G_T0, 32); genOpI(g, "sar", G_T0, G_T0, 32); }
    if (t == 4) { genOpI(g, "and", G_T0, G_T0, 255); }
    if (t == 5) { genOpI(g, "and", G_T0, G_T0, 65535); }
    if (t == 6) { genOpI(g, "and", G_T0, G_T0, 4294967295); }
}
function fwBitsOf(t: int): int {
    if (t == 1 || t == 4) { return 8; }
    if (t == 2 || t == 5) { return 16; }
    if (t == 3 || t == 6) { return 32; }
    return 64;
}

export function pFwop(c: Ref<PCtx>, pc: int, rec: List<string>): void {
    const g = c.g;
    const na = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    const nc = pField(rec, 5, 0);
    const fop = pField(rec, 6, 0);
    const t1 = pField(rec, 7, 0);
    const t2 = pField(rec, 8, 0);
    const dnr = pField(rec, 9, 0);
    const t = (fop - 256) / 16;
    const o = (fop - 256) % 16;
    const lbl = pcLbl(c, pc);
    const cold = lbl + "fwc";
    const done = lbl + "fwd";
    let want = 1;
    if (t == 10) { want = 2; }
    const unary = o == 5 || o == 6;
    if (t1 != want) { ldTag(c, G_T0, nb); genBrI(g, "ne", G_T0, want, cold); }
    if (!unary && nc != nb && t2 != want) { ldTag(c, G_T0, nc); genBrI(g, "ne", G_T0, want, cold); }
    let tagOut = 1;
    if (t == 10) {
        let fm = "fadd";
        if (o == 1) { fm = "fsub"; }
        if (o == 2) { fm = "fmul"; }
        if (o == 3) { fm = "fdiv"; }
        ldPay(c, G_T0, nb);
        ldPay(c, G_T1, nc);
        genFop(g, fm, G_T0, G_T0, G_T1);
        genF32Round(g, G_K1, G_T0);
        tagOut = 2;
    } else {
        const wide64 = t == 7 || t == 9;
        if (o == 0 || o == 1 || o == 10 || o == 11) {
            let op = "add";
            if (o == 1 || o == 11) { op = "sub"; }
            ldPay(c, G_T0, nb);
            ldPay(c, G_T1, nc);
            if (o >= 10) { genOp(g, op, G_T0, G_T0, G_T1); fwWrap(c, t); }
            else if (wide64) { genOpO(g, op + "u", G_T0, G_T0, G_T1, cold); }
            else if (t == 8) { genOpO(g, op, G_T0, G_T0, G_T1, cold); }
            else { genOp(g, op, G_T0, G_T0, G_T1); fwRangeCheck(c, t, cold); }
        } else if (o == 2 || o == 12) {
            ldPay(c, G_T0, nb);
            ldPay(c, G_T1, nc);
            if (o == 2 && wide64) { genOpO(g, "mulu", G_T0, G_T0, G_T1, cold); }
            else if (o == 12) { genOp(g, "mul", G_T0, G_T0, G_T1); fwWrap(c, t); }
            else if (t == 8) { genOpO(g, "mul", G_T0, G_T0, G_T1, cold); }
            else { genOp(g, "mul", G_T0, G_T0, G_T1); fwRangeCheck(c, t, cold); }
        } else if (o == 3 || o == 4) {
            ldPay(c, G_T1, nc);
            genBrI(g, "eq", G_T1, 0, cold);
            if (!wide64 && t == 8) { genBrI(g, "eq", G_T1, -1, cold); }
            ldPay(c, G_T0, nb);
            let q = G_T0;
            let r = -1;
            if (o == 4) { q = -1; r = G_T0; }
            genDivRem(g, !wide64, q, r, G_T0, G_T1);
            // 余数的绝对值小于除数，无符号的商不大于被除数；只有有符号窄整数的“最小值 / −1”越界。
            if (o == 3 && (t == 1 || t == 2 || t == 3)) { fwRangeCheck(c, t, cold); }
        } else if (o == 5) {
            ldPay(c, G_T0, nb);
            if (t == 8) { genNegO(g, G_T0, G_T0, cold); } else { genNeg(g, G_T0, G_T0); fwRangeCheck(c, t, cold); }
        } else if (o == 6) {
            ldPay(c, G_T0, nb);
            genNot(g, G_T0, G_T0);
            fwWrap(c, t);
        } else {
            // 移位 7 <<、8 >>、9 >>>：计数按无符号与“宽度−1”比较，负数与过大一并走冷路径（4016）。
            ldPay(c, G_T1, nc);
            genBrI(g, "ugt", G_T1, fwBitsOf(t) - 1, cold);
            ldPay(c, G_T0, nb);
            const signedT = t == 1 || t == 2 || t == 3 || t == 8;
            if (o == 7) { genOp(g, "shl", G_T0, G_T0, G_T1); fwWrap(c, t); }
            else if (o == 8) {
                if (signedT) { genOp(g, "sar", G_T0, G_T0, G_T1); } else { genOp(g, "shr", G_T0, G_T0, G_T1); }
            } else {
                if (t == 1) { genOpI(g, "and", G_T0, G_T0, 255); }
                if (t == 2) { genOpI(g, "and", G_T0, G_T0, 65535); }
                if (t == 3) { genOpI(g, "and", G_T0, G_T0, 4294967295); }
                genOp(g, "shr", G_T0, G_T0, G_T1);
                if (t == 1 || t == 2 || t == 3) { fwWrap(c, t); }
            }
        }
        genMov(g, G_K1, G_T0);
    }
    if (dnr == 0) { releaseOld(c, na, lbl + "fwr"); }
    stPay(c, na, G_K1);
    stTag(c, na, tagOut);
    genJmp(g, done);
    genLabel(g, cold);
    kcall(c, "__tx_fw_slow", pc, ints4(fop, na, nb, nc));
    genLabel(g, done);
}
