// 真实路径（macOS）：libSystem 的 realpath。导出面同 real_path_linux.tx、real_path_windows.tx。macOS 的 /tmp、/var 是链接，local*
// 内建拒绝路径里的链接，启动操作者给的路径只在这里解析一次。
declare function realpath(path: string, resolved: Bytes): usize from "libSystem";

// 解析不了时原样返回，由随后的检查报错。
export function realPath(path: string): string {
    const out = bytesNew(1024);
    if (realpath(path, out) == 0) {
        return path;
    }
    let n: int = 0;
    while (n < 1024 && (bytesGet(out, n) ?? 0) != 0) {
        n = n + 1;
    }
    return bytesToStr(bytesSlice(out, 0, n)) catch path;
}
