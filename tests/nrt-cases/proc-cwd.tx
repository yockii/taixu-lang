// 第 6 轮 6c-4a 工具链内建 currentDir（TOOL-103；仅 --toolchain，伴文件 proc-cwd.toolchain）：结果是绝对路径，
// 两次调用相同；以它为工作目录启动的子进程读到同一个串；在临时目录里启动的子进程读到的路径与临时目录末段相同
// （Windows 的 tempDir 可能是 8.3 短名，Linux 的 getcwd 会解开符号链接，所以只比末段）。
// Linux 上当前目录被删除后的 Error 见 proc-cwd-gone。

function sep(): string {
    if (hostTarget() == "windows") { return "\\"; }
    return "/";
}

function argv2(mode: string, x: string): List< string> {
    const xs: List< string> = listNew();
    listPush(xs, mode);
    listPush(xs, x);
    return xs;
}

function lastSegment(p: string): string {
    let i = len(p) - 1;
    while (i > 0) {
        const c = byteAt(p, i) catch 0;
        if (c == 47 || c == 92) { return strSub(p, i + 1, len(p) - i - 1); }
        i = i - 1;
    }
    return p;
}

function isAbsolute(p: string): bool {
    if (hostTarget() == "windows") {
        if (len(p) < 3) { return false; }
        const c0 = byteAt(p, 0) catch 0;
        const drive = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122);
        return drive && (byteAt(p, 1) catch 0) == 58 && (byteAt(p, 2) catch 0) == 92;
    }
    return len(p) > 0 && (byteAt(p, 0) catch 0) == 47;
}

// 子模式：same 打印当前目录是否等于实参；tail 打印当前目录的末段。
function child(mode: string, want: string): int {
    const d = currentDir() catch (e) {
        print("child error: " + e.message);
        return 1;
    };
    if (mode == "same") {
        print("child same: " + toStr(d == want));
    } else {
        print("child tail: " + lastSegment(d));
    }
    return 0;
}

function readAll(h: int, buf: Bytes): string {
    let got = "";
    while (true) {
        const r = ioWait(h, 2, 10000);
        if (r == 0) { return got + "<timeout>"; }
        const n = procRead(h, 1, buf);
        if (n < 0) { return got; }
        got = got + (bytesToStr(bytesSlice(buf, 0, n)) catch "?");
    }
    return got;
}

function runChild(me: string, mode: string, want: string, cwd: string): string {
    const h = procSpawn(me, argv2(mode, want), cwd, 0) catch (e) { return "spawn failed: " + e.message; };
    const buf = bytesNew(256);
    const got = readAll(h, buf);
    const code = procWait(h, 10000) catch -999;
    procClose(h);
    return got + "exit " + toStr(code);
}

function main(args: []string): int {
    if (len(args) >= 2) { return child(args[0], args[1]); }
    const d = currentDir() catch (e) {
        print("currentDir failed: " + e.message);
        return 1;
    };
    print("absolute: " + toStr(isAbsolute(d)));
    const again = currentDir() catch "?";
    print("stable: " + toStr(d == again));
    const me = selfExePath();
    print(runChild(me, "same", d, d));
    const tmp = tempDir();
    print("temp tail: " + toStr(runChild(me, "tail", "", tmp) == "child tail: " + lastSegment(tmp) + "\nexit 0"));
    return 0;
}
