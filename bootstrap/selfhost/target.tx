// 编译目标描述（字段化
// 第五节 X2）：目标编号加按维度的谓词，代替一路传下去的 `linux` 布尔量。判断点按自己真正关心的维度取谓词——文件格式、与 C 交界的
// 调用约定、系统接口、操作系统语义。每个目标是一行（架构，系统），各维度谓词由架构表与系统表的字段推出：新增一个已有架构×已有系统
// 的组合只加一行；新增架构或系统在对应的表里加一行。随组合而变的 ABI 数据（入口、TLS、系统调用号、常量与结构布局）不在这里。
// 程序代码在 x86-64 目标上一律用私有约定（emit_record 的 target win64），所以这里的调用约定只管 FFI 桩、回调外壳、线程入口、
// libc 钩子与导出的 memcpy 这些与 C 交界的地方。
export const T_X64_WINDOWS: int = 0;
export const T_X64_LINUX: int = 1;
// macOS（适配 M0b，M1）：
// x86_64 自 M1 起是产物目标（构建、反汇编、画像、内核生成器、
// Mach-O 链接）；aarch64 仍只用于分析（dev-check），产物在 M4 实施。
export const T_X64_MACOS: int = 2;
export const T_ARM64_MACOS: int = 3;
// Linux 的 aarch64、loongarch64、riscv64（A0、A1）：aarch64-linux 自 A2
// 起是产物目标（A64 指令层与 aarch64-macos 共用，ELF、裸系统调用与 x86_64-linux 共用）；loongarch64-linux 自 A4e 起是产物目标
// （龙芯指令层，B16）；riscv64-linux 自 A5e 起是产物目标（RISC-V 指令层，B17）。
export const T_ARM64_LINUX: int = 4;
export const T_LA64_LINUX: int = 5;
export const T_RV64_LINUX: int = 6;
// aarch64-windows：A64 指令层与另两个 A64 目标共用，PE 与 kernel32 与 x86_64-windows 共用（PE 经 ELF 对象由
// link_pe_objects.tx 链接）；A6b 起只用于分析，A6c 起是产物目标。
export const T_ARM64_WINDOWS: int = 7;
const TARGET_COUNT: int = 8;

// 架构表（名字同 Zig、Rust、LLVM，也是 x_<os>_<arch>.tx 的后缀）：指令集、ELF 机器号、Linux 上用不用内核通用号表与通用结构布局
// （asm-generic；x86_64 有自己的号表）。
const ARCHES: [4]string = ["x86_64", "aarch64", "loongarch64", "riscv64"];
const ARCH_ELF_MACHINE: [4]int = [62, 183, 258, 243];
const ARCH_GENERIC_LINUX: [4]bool = [false, true, true, true];
// 系统表：产物格式、系统接口、是否类 Unix、A64 上的系统变体（与 assemble.tx 的 A64_OS_* 同值）。
const OSES: [3]string = ["windows", "linux", "macos"];
const OS_WINDOWS: int = 0;
const OS_LINUX: int = 1;
const OS_MACOS: int = 2;
const FMT_PE: int = 0;
const FMT_ELF: int = 1;
const FMT_MACHO: int = 2;
const OS_FORMAT: [3]int = [FMT_PE, FMT_ELF, FMT_MACHO];
const SYS_KERNEL32: int = 0;
const SYS_RAW: int = 1;
const SYS_LIBSYSTEM: int = 2;
const OS_SYSIF: [3]int = [SYS_KERNEL32, SYS_RAW, SYS_LIBSYSTEM];
const OS_UNIX: [3]bool = [false, true, true];
const OS_A64: [3]int = [3, 2, 1];
// 目标表：编号即下标，每行（架构，系统）在上两张表里的下标。
const TARGET_ARCH: [8]int = [0, 0, 0, 1, 1, 2, 3, 1];
const TARGET_OS: [8]int = [0, 1, 2, 2, 1, 1, 1, 0];
// 目标文件（内核与程序对象）用 COFF 的目标：只有 x86_64-windows；其余都出 ELF 可重定位对象（aarch64-windows）。
const TARGET_COFF_OBJECTS: [8]bool = [true, false, false, false, false, false, false, false];

function known(t: int): bool { return t >= 0 && t < TARGET_COUNT; }
function archIndex(t: int): int { if (!known(t)) { return -1; } return TARGET_ARCH[t]; }
function osIndex(t: int): int { if (!known(t)) { return -1; } return TARGET_OS[t]; }

/// 系统名：hostTarget() 的返回值，也是按目标选择源文件（x_<os>.tx）用的名字；不认识的编号得空串。
export function targetOs(t: int): string {
    const o = osIndex(t);
    if (o < 0) { return ""; }
    return OSES[o];
}
/// 架构名（ISA 名，同 Zig、Rust、LLVM；hostArch() 的返回值，也是 x_<os>_<arch>.tx 的后缀）；不认识的编号得空串。
export function targetArch(t: int): string {
    const a = archIndex(t);
    if (a < 0) { return ""; }
    return ARCHES[a];
}
/// 规范名（三元组，同内核生成器、链接映射、编译画像的写法）；不认识的编号得空串。
export function targetName(t: int): string {
    const os = targetOs(t);
    if (len(os) == 0) { return ""; }
    return targetArch(t) + "-" + os;
}
/// 架构名与系统名 → 目标编号；目标表里没有这个组合得 -1。
export function targetOf(arch: string, os: string): int {
    let t = 0;
    while (t < TARGET_COUNT) {
        if (targetArch(t) == arch && targetOs(t) == os) { return t; }
        t = t + 1;
    }
    return -1;
}
/// 已知的系统名与架构名：按目标选文件的后缀全集（导出面一致性比对的兄弟名单由它们生成）。
export function targetOsNames(): List<string> {
    const out: List<string> = listNew();
    for (o in OSES) { listPush(out, o); }
    return out;
}
export function targetArchNames(): List<string> {
    const out: List<string> = listNew();
    for (a in ARCHES) { listPush(out, a); }
    return out;
}
/// 按目标选文件的后缀链：x_<os>_<arch>、x_<os>，类 Unix 目标再试 x_unix；都没有才用 x.tx。
export function targetFileSuffixes(t: int): List<string> {
    const out: List<string> = listNew();
    const os = targetOs(t);
    if (len(os) == 0) { return out; }
    listPush(out, os + "_" + targetArch(t));
    listPush(out, os);
    if (tUnix(t)) { listPush(out, "unix"); }
    return out;
}
/// 同组兄弟文件的全部后缀（导出面一致性比对）：每个系统、unix、每个“系统_架构”。
export function targetFileSuffixesAll(): List<string> {
    const out: List<string> = listNew();
    const oses = targetOsNames();
    const arches = targetArchNames();
    for (os in oses) { listPush(out, os); }
    listPush(out, "unix");
    for (os in oses) { for (arch in arches) { listPush(out, os + "_" + arch); } }
    return out;
}
// 三元组按“-”拆成架构与系统，恰好两段才算；否则两段都为空串。用 strSplit 而不按位置切：种子 0.3.0-beta.1 编译器源码时
// 不认字节面的 strByteSub，按“-”拆也不涉及位置换算。
function tripleArch(s: string): string {
    const parts = strSplit(s, "-");
    if (listLen(parts) != 2) { return ""; }
    return listGet(parts, 0) catch "";
}
function tripleOs(s: string): string {
    const parts = strSplit(s, "-");
    if (listLen(parts) != 2) { return ""; }
    return listGet(parts, 1) catch "";
}
/// `--target=` 的写法（系统名或三元组）→ 目标编号；不认识得 -1。这一档只认 x86_64：不带架构的系统名取 x86_64（命令行的
/// --target 经 targetFlag 先按宿主架构试，M4），三元组只认 x86_64 的三个。
export function targetParse(s: string): int {
    const bare = targetOf("x86_64", s);
    if (bare >= 0) { return bare; }
    if (tripleArch(s) != "x86_64") { return -1; }
    return targetOf("x86_64", tripleOs(s));
}
/// 只认规范名（三元组）→ 目标编号；不认识得 -1。只认 targetParse 那一档（x86_64）的规范名。
export function targetParseName(s: string): int {
    const t = targetParse(s);
    if (t >= 0 && targetName(t) == s) { return t; }
    return -1;
}
/// 目标表里任一目标的规范名（三元组，不认别名与不带架构的写法）→ 目标编号；不认识得 -1。内核生成器的 `--target` 用它。
export function targetParseCanonical(s: string): int {
    let t = 0;
    while (t < TARGET_COUNT) {
        if (targetName(t) == s) { return t; }
        t = t + 1;
    }
    return -1;
}
/// 全部目标写法：targetParse 之外另认其余架构的三元组（aarch64-macos 自 M4 起是产物目标，但只由明确支持它的命令收：build、
/// dev-check、内核生成器）。`arm64` 是 aarch64 的别名，`loong64` 是 loongarch64 的别名（Go、Debian 的写法，B16），
/// 只在这里认，不进文件名。
export function targetParseAnalysis(s: string): int {
    const t = targetParse(s);
    if (t >= 0) { return t; }
    let arch = tripleArch(s);
    if (arch == "arm64") { arch = "aarch64"; }
    if (arch == "loong64") { arch = "loongarch64"; }
    if (len(arch) == 0) { return -1; }
    return targetOf(arch, tripleOs(s));
}
/// 只用于分析的目标（产物命令拒绝，退出码 64）：riscv64-linux 自出产物；aarch64-windows 自 A6b 起经这一档接入、A6c 起出
/// 产物，现在没有。它不并入
/// 系统、格式等维度的谓词（A6a 起 tLinux／tUnix 不再含它）：新目标在各维度谓词里显式列出，免得只用于分析的 Windows 目标被当成 Linux。
export function tAnalysisOnly(t: int): bool { return false; }
function flagValue(arg: string): string {
    if (strIndexOf(arg, "--target=") != 0) { return ""; }
    const parts = strSplit(arg, "=");
    if (listLen(parts) != 2) { return ""; }
    return listGet(parts, 1) catch "";
}
/// 命令行选项 `--target=<写法>` → 目标编号；不是这个选项或写法不认识得 -1（调用方照旧按未知选项处理）。不带架构的
/// 系统名先按宿主架构 `arch` 试（同 Go 的 GOARCH 缺省取宿主），该系统没有这个架构的目标再取 x86_64（M4）；只用于
/// 分析的目标不由不带架构的写法选中（aarch64 宿主上的 `linux` 仍是 x86_64-linux，直到 aarch64-linux 能出产物）。
/// 认得出 aarch64-macos；不支持 A64 的命令自行拒绝。
export function targetFlag(arg: string, arch: string): int {
    const v = flagValue(arg);
    if (len(v) > 0 && strIndexOf(v, "-") < 0) {
        const t = targetParseAnalysis(arch + "-" + v);
        if (t >= 0 && !tAnalysisOnly(t)) { return t; }
    }
    return targetParseAnalysis(v);
}
/// 目标架构的 ELF 机器号（e_machine）；不认识的编号得 0。
export function targetElfMachine(t: int): int {
    const a = archIndex(t);
    if (a < 0) { return 0; }
    return ARCH_ELF_MACHINE[a];
}
/// 目标文件（内核与程序对象）是 ELF 可重定位对象（其余为 COFF，只有 x86_64-windows）；不认识的编号为假。
export function tElfObjects(t: int): bool { return known(t) && !TARGET_COFF_OBJECTS[t]; }

// 指令集：x86_64 与 A64（Linux）。
export function tA64(t: int): bool { return archIndex(t) == 1; }
// 指令集枚举：缓冲、宏层、rtfn、渲染器与汇编映像按它分派，取代原先的布尔量 a64。分派处只认自己
// 实现了的指令集；守卫处（x86 指令进不了别的映像等）写成“不是 x86_64”，未实现的指令集在那里失败，不会被当成 x86。
// 枚举值即架构表的下标。不认识的编号取 x86_64（同改字段化之前）。
export const ISA_X86_64: int = 0;
export const ISA_A64: int = 1;
export const ISA_LA64: int = 2;
export const ISA_RV64: int = 3;
export function tIsa(t: int): int {
    const a = archIndex(t);
    if (a < 0) { return ISA_X86_64; }
    return a;
}
function osFormat(t: int): int {
    const o = osIndex(t);
    if (o < 0) { return -1; }
    return OS_FORMAT[o];
}
function osSysif(t: int): int {
    const o = osIndex(t);
    if (o < 0) { return -1; }
    return OS_SYSIF[o];
}
// 文件格式：PE/COFF、ELF 与 Mach-O。
export function tPe(t: int): bool { return osFormat(t) == FMT_PE; }
export function tElf(t: int): bool { return osFormat(t) == FMT_ELF; }
export function tMachO(t: int): bool { return osFormat(t) == FMT_MACHO; }
// 与 C 交界的调用约定：Win64（rcx/rdx/r8/r9、影子空间、XMM6–15 非易失）与 SysV（x86_64 的 Linux、macOS）；
// A64 上是 AAPCS64（Apple、Linux 与 Windows 在栈上实参的排布与变参上不同，见 tA64Os）；tWin64 只指 x86_64 的约定。
export function tWin64(t: int): bool { return archIndex(t) == 0 && tWindows(t); }
export function tSysV(t: int): bool { return archIndex(t) == 0 && tUnix(t); }
// 系统接口：经 kernel32 等 DLL 导入、直接发系统调用，或经 libSystem 导入（macOS 不提供稳定的系统调用接口）。
export function tKernel32(t: int): bool { return osSysif(t) == SYS_KERNEL32; }
export function tRawSyscall(t: int): bool { return osSysif(t) == SYS_RAW; }
/// A64 目标的系统（与 assemble.tx 的 A64_OS_* 同值）：1 Apple、2 Linux、3 Windows；非 A64 为 0。C 调用约定随它：Apple arm64 栈上
/// 实参按自然对齐紧排、变参一律上栈、x18 保留；Linux 的 aarch64 是标准 AAPCS64（栈上每个实参占 8 字节槽、变参与定参同规则）；
/// Windows 定参同标准 AAPCS64，变参不用浮点寄存器（浮点按位进整数寄存器、复合类型不按 HFA）、x18 指向 TEB（B18）。
/// 原子操作也随它：Apple 的 arm64 都有 LSE；Linux、Windows 上按启动时读到的 CPU 特性选 LSE 或 LL/SC（B18）。
export function tA64Os(t: int): int {
    if (!tA64(t)) { return 0; }
    return OS_A64[osIndex(t)];
}
export function tLibSystem(t: int): bool { return osSysif(t) == SYS_LIBSYSTEM; }
// 操作系统语义（路径语法、errno 与 GetLastError、信号、控制台编码、进程模型）。
export function tWindows(t: int): bool { return osIndex(t) == OS_WINDOWS; }
/// 用内核通用号表（scripts/syscall.tbl）与通用结构布局（asm-generic 的 stat 等）的 Linux：aarch64、loongarch64、riscv64。
/// 通用表没有 open、poll、dup2 这类旧形态（rtfn 的 a64LinuxSyscall 改写）；x86_64 用自己的号表。
export function tGenericLinux(t: int): bool { return tLinux(t) && ARCH_GENERIC_LINUX[archIndex(t)]; }
export function tLinux(t: int): bool { return osIndex(t) == OS_LINUX; }
export function tMacos(t: int): bool { return osIndex(t) == OS_MACOS; }
export function tUnix(t: int): bool {
    const o = osIndex(t);
    if (o < 0) { return false; }
    return OS_UNIX[o];
}
