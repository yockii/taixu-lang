// Always uses an explicit replay before creating App, including direct execution.
import { setenv } from "std/os";
import { appNew, appClose, defaultSpec, focusPushId } from "gui/app";
import { fontEmbedded } from "gui/text";
import { surfAt } from "gui/engine/raster";
import { controllerNew } from "../examples/browser/controller";
import { uiNew, uiEnsureSurfaces, uiReflow, uiRender, uiDestroy, ADDRESS_X, ID_ADDRESS } from "../examples/browser/ui_state";
import { addressSet } from "../examples/browser/address";

export function main(args: []string): int {
    setenv("TAIXU_REPLAY", "tests/browser-ui-script.txt") catch panic("replay");
    const app = appNew(defaultSpec("browser UI bounds", 760, 540)); assert(app.scripted && app.k == 200, "scripted DPI viewport");
    const font = fontEmbedded() catch panic("font"); const controller = controllerNew(true, listNew(), 1000) catch panic("controller");
    const model = uiNew(controller, font); uiEnsureSurfaces(model, app) catch panic("surface"); uiReflow(model, app) catch panic("reflow");
    focusPushId(app, ID_ADDRESS); model.editing = true; assert(addressSet(model.address, ""), "empty field"); uiRender(model, app) catch panic("initial draw");
    const target = surfAt(model.window); const before = bytesSlice(target.px, 0, bytesLen(target.px));
    let long = "https://example.test/"; while (len(long) < 4096) { long = long + "a"; }
    assert(addressSet(model.address, long), "maximum address"); uiRender(model, app) catch panic("long address draw");
    const x0 = ADDRESS_X * 2; const x1 = (ADDRESS_X + model.address.w) * 2; let outside = 0; let changed = 0; let y = 0;
    while (y < target.h) {
        let x = 0;
        while (x < target.w) {
            const at = (y * target.w + x) * 4; const old = bytesGetLE<u32>(before, at) catch 0; const value = bytesGetLE<u32>(target.px, at) catch 0;
            if (x >= x0 && x < x1 && y >= 20 && y < 76) { if (old != value) { changed = changed + 1; } }
            else { assert(old == value, "address text cannot overwrite toolbar, page or status pixels"); outside = outside + 1; } x = x + 1;
        } y = y + 1;
    }
    assert(outside > 1000000 && changed > 20 && model.addressOffset > 0, "DPI field clips and follows the end caret");
    uiDestroy(model, app); appClose(app); print("browser UI: bounded address pixels and DPI caret OK"); return 0;
}
