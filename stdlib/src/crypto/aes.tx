// AES-128 单块加密；消息加密应使用 AEAD，例如 std/crypto/gcm。
import { aes128Expand, aes128Block } from "./aes_impl";

export function aes128EncryptBlock(key: Bytes, block: Bytes): Bytes | Error {
    if (bytesLen(key) != 16 || bytesLen(block) != 16) { return err("aes: AES-128 requires 16-byte key and block"); }
    return aes128Block(aes128Expand(key), block);
}
