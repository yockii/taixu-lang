// gui-image —— 像素面图像消费（与 std/image PNG 解码配对）。
//
// engine/image 的 imgCreate 建空白图像句柄、imgSetPixel 逐像素写（2026-10-26 起取代
// 旧宿主的 txp_image_create／txp_image_set_pixel）。argb＝0xAARRGGBB；引擎图像面为 RGB
// 三输出语义（sha256/BMP/投影），alpha 位当前忽略——透明合成＝G1 臂⑤面。
//
// 本模块自成一体的原因：不触碰 gui/surface 与 gui/components 既有面（tryImage/drawImage
// 原样复用）。

import { Image } from "gui/components";
import { imageFree } from "gui/surface";
import { imgCreate, imgSetPixel } from "./engine/image";

/// 像素面图像构造（std/image decodePng 输出 → 引擎句柄）。pixels＝RGBA8
/// 行主序（w*h*4）；失败 Error（尺寸非正/长度不符/句柄池耗尽/写入越界）。
export function tryImageFromPixels(pixels: List<int>, w: int, h: int,
    x: int, y: int): Ref<Image> | Error {
    if (w <= 0 || h <= 0) {
        return err("tryImageFromPixels: 尺寸须为正");
    }
    if (listLen(pixels) != w * h * 4) {
        return err("tryImageFromPixels: 像素面长度不符（须 w*h*4）");
    }
    const handle: int = imgCreate(w, h);
    if (handle <= 0) {
        return err("tryImageFromPixels: 句柄池耗尽");
    }
    const n: int = w * h;
    let i: int = 0;
    while (i < n) {
        const r: int = listTryGet(pixels, i * 4) catch 0;
        const g: int = listTryGet(pixels, i * 4 + 1) catch 0;
        const b: int = listTryGet(pixels, i * 4 + 2) catch 0;
        const a: int = listTryGet(pixels, i * 4 + 3) catch 0;
        const argb: int = (a << 24) | (r << 16) | (g << 8) | b;
        const px: int = imgSetPixel(handle, i % w, i / w, argb);
        if (px < 0) {
            imageFree(handle);
            return err("tryImageFromPixels: 像素写入失败");
        }
        i = i + 1;
    }
    return new Image { id: 0, handle: handle, x: x, y: y, w: w, h: h };
}
