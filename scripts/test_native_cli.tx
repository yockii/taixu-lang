// 原生 CLI 行为对照声明式伴文件与冻结的 doc／init 夹具。
//
// `.out` 要求退出码 0 且 stdout（CRLF 归一）逐字相等。`.err`／`.test` 要求声明的退出码且每个非空期望行都出现。JSON 变体查结构化的
// 诊断与测试结果。只属于另一目标的用例在本宿主跳过；退场的 VM 旗标记名跳过。原生反汇编另有门。
//
// 不给用例时另查：每个发出的诊断码在 explain 里有条目、原生能力表、冻结的 doc／init 行为、新语法的文档、模板的安全创建、gui/ 根的
// 发现与内部内建的拒绝、调试／DAP／MCP 的旗标错误。GUI 引擎在外部库；这里只留纯布局与根解析。编出的产物起不来（Windows 上典型是被
// 杀软拦截）只记它自己那一行失败，其余各组照跑。期望都已冻结；只运行原生编译器。
//
// 运行（仓根）：taixu run --toolchain scripts/test_native_cli.tx --compiler <原生 taixu> [--report 文件] [用例 ...]
import { absolute, baseOf, copyFile, deleteTree, dirOf, exeName, join, kindOf, mkdirs, nat, readBytes, startsWith } from "./build_lib";
import { osRealPath } from "./build_os";
import { captureRaw } from "./test_lib";
import { contains, crlf, digits, endsWith, headChars, padRight, reprBytes, reprStr, slashes, sorted, strip, tailChars } from "./test_text";
import { lossyText } from "./check_lib";
import { J_ARR, J_BOOL, J_NULL, J_NUM, J_OBJ, J_STR, Jv, jArray, jDump, jGet, jIsTrue, jNull, jNumber, jObject, jParseBytes, jPretty, jPush,
    jSet, jSorted, jString, jText } from "./test_json";

const SEC: int = 1000000000;
const DRAIN_NS: int = 10000000000;
const MAX_OUTPUT: int = 1073741824;
const ALL: int = 4611686018427387904;
const FIXTURE_VAR: string = "TAIXU_SYS_PROC_FIXTURE";
const FIXTURE_VALUE: string = "fixture 中文 🦊";
const RETIRED_FLAGS: []string = ["--mem-report", "--tier", "--format", "--debug", "--replay", "--frame", "--out-dir", "--auto"];
const COMPANIONS: []string = [".out", ".err", ".test", ".testjson", ".json", ".disasm", ".disasmjson"];
const CASE_DIRS: []string = ["tests/cases", "tests/nrt-cases", "examples"];

// ---------------------------------------------------------------- 运行

struct Res {
    code: int,
    out: Bytes,
    err: Bytes,
}

function lst(xs: []string): List<string> {
    const out: List<string> = listNew();
    for (x in xs) {
        listPush(out, x);
    }
    return out;
}

function cat(a: List<string>, b: List<string>): List<string> {
    const out: List<string> = listNew();
    for (x in a) {
        listPush(out, x);
    }
    for (x in b) {
        listPush(out, x);
    }
    return out;
}

function noStrings(): List<string> {
    const xs: List<string> = listNew();
    return xs;
}

// argv[0] 为程序（stdin 接空设备）。起不来时退出码记 −1，原因以 LAUNCH_FAILED 开头写进 stderr（典型是
// Windows 上被杀软拦截）；超时记 −1，stderr 为 TIMEOUT。
function call(argv: List<string>, cwd: string, limitSec: int): Ref<Res> {
    const exe = listGet(argv, 0) catch "";
    const rest: List<string> = listNew();
    let i = 1;
    while (i < listLen(argv)) {
        listPush(rest, listGet(argv, i) catch "");
        i = i + 1;
    }
    const r = captureRaw(exe, rest, nat(cwd), limitSec * SEC, DRAIN_NS, MAX_OUTPUT) catch (e) {
        return new Res { code: -1, out: bytesNew(0), err: bytesFromStr("LAUNCH_FAILED " + e.message) };
    };
    if (r.timedOut) {
        return new Res { code: -1, out: r.out, err: bytesFromStr("TIMEOUT after " + toStr(limitSec) + " s") };
    }
    return new Res { code: r.code, out: r.out, err: r.err };
}

function txt(b: Bytes): string {
    return lossyText(b);
}

// CRLF 归一（只换 \r\n）。
function lf(s: string): string {
    return bytesToStr(crlf(bytesFromStr(s))) catch s;
}

function lfBytes(b: Bytes): Bytes {
    return crlf(b);
}

// Python 的 read_text：通用换行（\r\n 与单独的 \r 都成 \n）。
function universal(b: Bytes): string {
    const out = bytesNew(0);
    const n = bytesLen(b);
    let i = 0;
    while (i < n) {
        const c = bytesGet(b, i) ?? 0;
        if (c == 13) {
            bytesPush(out, 10);
            if (i + 1 < n && (bytesGet(b, i + 1) ?? 0) == 10) {
                i = i + 1;
            }
        } else {
            bytesPush(out, c);
        }
        i = i + 1;
    }
    return lossyText(out);
}

// Python 的 str.splitlines()（只认 \n、\r\n、\r）。
function splitLines(s: string): List<string> {
    const out = strSplit(universal(bytesFromStr(s)), "\n");
    if (listLen(out) > 0 && len(listGet(out, listLen(out) - 1) catch "") == 0) {
        const last = listPop(out);
    }
    return out;
}

function fileExists(p: string): bool {
    return kindOf(p) == 1;
}

function exists(p: string): bool {
    const k = kindOf(p);
    return k == 1 || k == 2;
}

function readText(p: string): string? {
    if (!fileExists(p)) {
        return None;
    }
    const b = readBytes(p) catch (e) {
        return None;
    };
    return universal(b);
}

function write(path: string, text: string): bool {
    mkdirs(dirOf(path));
    writeFile(path, text) catch (e) {
        return false;
    };
    return true;
}

function sameBytes(a: Bytes, b: Bytes): bool {
    if (bytesLen(a) != bytesLen(b)) {
        return false;
    }
    let i = 0;
    while (i < bytesLen(a)) {
        if ((bytesGet(a, i) ?? 0) != (bytesGet(b, i) ?? 1)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function bytesHas(hay: Bytes, needle: string): bool {
    const nb = bytesFromStr(needle);
    const m = bytesLen(nb);
    const first = bytesGet(nb, 0) ?? 0;
    let i = 0;
    const last = bytesLen(hay) - m;
    while (i <= last) {
        if ((bytesGet(hay, i) ?? 0) == first) {
            let k = 1;
            while (k < m && (bytesGet(hay, i + k) ?? 0) == (bytesGet(nb, k) ?? 0)) {
                k = k + 1;
            }
            if (k == m) {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

function cat2(a: Bytes, b: Bytes): Bytes {
    const out = bytesNew(0);
    bytesAppend(out, a);
    bytesAppend(out, b);
    return out;
}

function tempWork(prefix: string): string {
    const d = join(slashes(osRealPath(tempDir())), prefix + toStr(monoNs()));
    mkdirs(d);
    return d;
}

function pyBool(b: bool): string {
    if (b) {
        return "True";
    }
    return "False";
}

// Python 的 repr：JSON 值按 dict／list／str／True／False／None 写。
function pyRepr(v: Ref<Jv>): string {
    if (v.kind == J_STR) {
        return reprStr(v.text);
    }
    if (v.kind == J_BOOL) {
        return pyBool(v.truth);
    }
    if (v.kind == J_NULL) {
        return "None";
    }
    if (v.kind == J_NUM) {
        return v.text;
    }
    let s = "";
    let i = 0;
    while (i < listLen(v.items)) {
        if (i > 0) {
            s = s + ", ";
        }
        const item = listGet(v.items, i) catch v;
        if (v.kind == J_OBJ) {
            s = s + reprStr(listGet(v.keys, i) catch "") + ": ";
        }
        s = s + pyRepr(item);
        i = i + 1;
    }
    if (v.kind == J_OBJ) {
        return "{" + s + "}";
    }
    return "[" + s + "]";
}

function reprList(xs: List<string>): string {
    let s = "[";
    let i = 0;
    for (x in xs) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + reprStr(x);
        i = i + 1;
    }
    return s + "]";
}

function reprInts(xs: List<int>): string {
    let s = "[";
    let i = 0;
    for (x in xs) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + toStr(x);
        i = i + 1;
    }
    return s + "]";
}

// ---------------------------------------------------------------- 结果行

// 附加组的一行：state 1 通过、0 失败、−1 跳过（detail 为原因）。
struct XRow {
    name: string,
    state: int,
    detail: Ref<Jv>,
}

function okState(ok: bool): int {
    if (ok) {
        return 1;
    }
    return 0;
}

function add(rows: List<XRow>, name: string, ok: bool, detail: string): void {
    listPush(rows, XRow { name: name, state: okState(ok), detail: jString(detail) });
}

function addJ(rows: List<XRow>, name: string, ok: bool, detail: Ref<Jv>): void {
    listPush(rows, XRow { name: name, state: okState(ok), detail: detail });
}

function skip(rows: List<XRow>, name: string, reason: string): void {
    listPush(rows, XRow { name: name, state: -1, detail: jString(reason) });
}

function exitOut(code: int, s: string, n: int): string {
    return "exit=" + toStr(code) + " out=" + reprStr(headChars(s, n));
}

function exitErr(code: int, s: string, n: int): string {
    return "exit=" + toStr(code) + " err=" + reprStr(headChars(s, n));
}

struct Ctx {
    root: string,
    compiler: string,
}

function compilerCall(c: Ref<Ctx>, args: List<string>, cwd: string, limitSec: int): Ref<Res> {
    return call(cat(lst([c.compiler]), args), cwd, limitSec);
}

// ---------------------------------------------------------------- 伴文件与用例

function stemPath(tx: string): string {
    return bytesToStr(bytesSlice(bytesFromStr(tx), 0, len(tx) - 3)) catch tx;
}

function companion(tx: string, ext: string): string? {
    const t = readText(stemPath(tx) + ext);
    if (t == None) {
        return None;
    }
    return lf(t ?? "");
}

// 首行 exit=N 给出期望的退出码，否则取缺省。
function exitOf(content: string, dflt: int): int {
    const first = listGet(strSplit(content, "\n"), 0) catch "";
    if (!startsWith(first, "exit=")) {
        return dflt;
    }
    const v = strip(bytesToStr(bytesSlice(bytesFromStr(first), 5, len(first) - 5)) catch "");
    let i = 0;
    if (i < len(v) && ((byteAt(v, 0) ?? 0) == 45 || (byteAt(v, 0) ?? 0) == 43)) {
        i = 1;
    }
    if (i >= len(v)) {
        return dflt;
    }
    while (i < len(v)) {
        const ch = byteAt(v, i) ?? 0;
        if (ch < 48 || ch > 57) {
            return dflt;
        }
        i = i + 1;
    }
    if ((byteAt(v, 0) ?? 0) == 43) {
        return digits(bytesToStr(bytesSlice(bytesFromStr(v), 1, len(v) - 1)) catch "0");
    }
    return digits(v);
}

// 首行之后的非空行（原样，不去空白）。
function needles(content: string): List<string> {
    const out: List<string> = listNew();
    const lines = strSplit(content, "\n");
    let i = 1;
    while (i < listLen(lines)) {
        const l = listGet(lines, i) catch "";
        if (len(strip(l)) > 0) {
            listPush(out, l);
        }
        i = i + 1;
    }
    return out;
}

struct Spec {
    kind: string,
    exit: int,
    want: List<string>,
    wantText: string,
    extra: List<string>,
    suffix: string,
}

struct Classified {
    specs: List<Spec>,
    reason: string,
}

// 次序：.test 与 .testjson（两个都跑），再 .json、.err、.out。
function classify(tx: string): Classified {
    const specs: List<Spec> = listNew();
    const t = companion(tx, ".test");
    if (t != None) {
        const s = t ?? "";
        listPush(specs, Spec { kind: "test", exit: exitOf(s, 2), want: needles(s), wantText: "", extra: noStrings(), suffix: "" });
    }
    const tj = companion(tx, ".testjson");
    if (tj != None) {
        const s = tj ?? "";
        let suffix = "";
        if (listLen(specs) > 0) {
            suffix = " [json]";
        }
        listPush(specs, Spec { kind: "test", exit: exitOf(s, 2), want: needles(s), wantText: "", extra: lst(["--format=json"]), suffix: suffix });
    }
    if (listLen(specs) > 0) {
        return Classified { specs: specs, reason: "" };
    }
    const j = companion(tx, ".json");
    if (j != None) {
        const s = j ?? "";
        listPush(specs, Spec { kind: "err", exit: exitOf(s, 1), want: needles(s), wantText: "", extra: lst(["--format=json"]), suffix: "" });
        return Classified { specs: specs, reason: "" };
    }
    const dis = [".disasm", ".disasmjson"];
    for (ext in dis) {
        if (exists(stemPath(tx) + ext)) {
            return Classified { specs: specs, reason: "retired-cli-only:" + ext };
        }
    }
    const e = companion(tx, ".err");
    if (e != None) {
        const s = e ?? "";
        listPush(specs, Spec { kind: "err", exit: exitOf(s, 1), want: needles(s), wantText: "", extra: noStrings(), suffix: "" });
        return Classified { specs: specs, reason: "" };
    }
    const o = companion(tx, ".out");
    if (o != None) {
        listPush(specs, Spec { kind: "out", exit: 0, want: noStrings(), wantText: o ?? "", extra: noStrings(), suffix: "" });
        return Classified { specs: specs, reason: "" };
    }
    return Classified { specs: specs, reason: "no-companion" };
}

// 按伴文件跳过的规则（同 scripts/test_nrt_products.tx）：目标操作系统／架构专属、runflags、解释器内存报告。
function skipReason(tx: string, target: string, arch: string): string {
    const oses = ["windows", "linux", "macos"];
    for (only in oses) {
        if (exists(stemPath(tx) + "." + only) && target != only) {
            return "target-only:" + only;
        }
    }
    const archs = ["x86_64", "aarch64", "loongarch64", "riscv64"];
    for (only in archs) {
        if (exists(stemPath(tx) + "." + only) && arch != only) {
            return "target-only:" + only;
        }
    }
    if (exists(stemPath(tx) + ".runflags")) {
        return "runflags";
    }
    const e = readText(stemPath(tx) + ".err");
    if (e != None && contains(e ?? "", "retained by kind")) {
        return "interpreter-mem-report";
    }
    return "";
}

function runSpec(c: Ref<Ctx>, tx: string, name: string, s: Spec, argv: List<string>): Ref<Jv> {
    const row = jObject();
    jSet(row, "case", jString(name + s.suffix));
    let tool: List<string> = listNew();
    if (exists(stemPath(tx) + ".toolchain")) {
        listPush(tool, "--toolchain");
    }
    const flags = companion(tx, ".buildflags");
    if (flags != None) {
        for (l in splitLines(flags ?? "")) {
            if (len(strip(l)) > 0) {
                listPush(tool, strip(l));
            }
        }
    }
    let verb = "run";
    if (s.kind == "test") {
        verb = "test";
    }
    const r = call(cat(cat(cat(lst([c.compiler, verb]), tool), s.extra), cat(lst([baseOf(tx)]), argv)), dirOf(tx), 600);
    const out = lf(txt(r.out));
    const err = lf(txt(r.err));
    let ok = r.code == s.exit;
    let detail = "";
    if (s.kind == "out") {
        if (out != s.wantText) {
            ok = false;
            detail = "stdout differs";
        }
    } else {
        for (n in s.want) {
            if (!contains(err, n) && !contains(out, n)) {
                ok = false;
                detail = "expected text not found";
            }
        }
    }
    if (!ok) {
        detail = strip(detail + " exit=" + toStr(r.code) + " want=" + toStr(s.exit));
        jSet(row, "detail", jString(detail + " | stdout: " + tailChars(out, 300) + " | stderr: " + tailChars(err, 300)));
    }
    let status = "PASS";
    if (!ok) {
        status = "FAIL";
    }
    jSet(row, "status", jString(status));
    return row;
}

// ---------------------------------------------------------------- explain 与 capabilities

function isDigit(c: int): bool {
    return c >= 48 && c <= 57;
}

function isWord(c: int): bool {
    return isDigit(c) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

function isWs(c: int): bool {
    return c == 32 || (c >= 9 && c <= 13);
}

function at(b: Bytes, i: int, s: string): bool {
    const n = len(s);
    if (i + n > bytesLen(b)) {
        return false;
    }
    let k = 0;
    while (k < n) {
        if ((bytesGet(b, i + k) ?? 0) != (byteAt(s, k) ?? 0)) {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// `[^,]+,\s*`：从 j 起至少一个非逗号、到第一个逗号，再跳过空白；得码的起点，不成为 −1。
function afterArg(b: Bytes, j: int): int {
    const n = bytesLen(b);
    if (j >= n || (bytesGet(b, j) ?? 0) == 44) {
        return -1;
    }
    let k = j;
    while (k < n && (bytesGet(b, k) ?? 0) != 44) {
        k = k + 1;
    }
    if (k >= n) {
        return -1;
    }
    k = k + 1;
    while (k < n && isWs(bytesGet(b, k) ?? 0)) {
        k = k + 1;
    }
    return k;
}

// `[1-3][0-9]{3}(?![0-9])`：得码，不成为 −1。
function codeAt(b: Bytes, p: int): int {
    if (p < 0 || p + 4 > bytesLen(b)) {
        return -1;
    }
    const c0 = bytesGet(b, p) ?? 0;
    if (c0 < 49 || c0 > 51) {
        return -1;
    }
    let v = 0;
    let k = 0;
    while (k < 4) {
        const ch = bytesGet(b, p + k) ?? 0;
        if (!isDigit(ch)) {
            return -1;
        }
        v = v * 10 + ch - 48;
        k = k + 1;
    }
    if (p + 4 < bytesLen(b) && isDigit(bytesGet(b, p + 4) ?? 0)) {
        return -1;
    }
    return v;
}

// 源码里发出的诊断码（即正则 (?:emitDiag\([^,]+,\s*|recordErr\w*\([^,]+,\s*|error |export const C_\w+: int = )
// ([1-3][0-9]{3})(?![0-9]) 自左向右、互不重叠的全部匹配）。
function scanCodes(b: Bytes, want: Map<int, bool>): void {
    const n = bytesLen(b);
    let i = 0;
    while (i < n) {
        const c = bytesGet(b, i) ?? 0;
        let p = -1;
        if (c == 101) {
            if (at(b, i, "emitDiag(")) {
                p = afterArg(b, i + 9);
            } else if (at(b, i, "error ")) {
                p = i + 6;
            } else if (at(b, i, "export const C_")) {
                let j = i + 15;
                while (j < n && isWord(bytesGet(b, j) ?? 0)) {
                    j = j + 1;
                }
                if (j > i + 15 && at(b, j, ": int = ")) {
                    p = j + 8;
                }
            }
        } else if (c == 114 && at(b, i, "recordErr")) {
            let j = i + 9;
            while (j < n && isWord(bytesGet(b, j) ?? 0)) {
                j = j + 1;
            }
            if (j < n && (bytesGet(b, j) ?? 0) == 40) {
                p = afterArg(b, j + 1);
            }
        }
        const code = codeAt(b, p);
        if (code > 0) {
            mapSet(want, code, true);
            i = p + 4;
        } else {
            i = i + 1;
        }
    }
}

function txFiles(dir: string): List<string> {
    const out: List<string> = listNew();
    const names = localListDir(nat(dir), "") catch noStrings();
    for (n in names) {
        if (endsWith(n, ".tx") && fileExists(join(dir, n))) {
            listPush(out, join(dir, n));
        }
    }
    return out;
}

// explain 列表的一行 `NNNN [种类:名] `：得 (码, 种类, 名)，不是为码 −1。
struct Listed {
    code: int,
    kind: string,
    name: string,
}

function listedOf(line: string): Listed {
    const none = Listed { code: -1, kind: "", name: "" };
    const b = bytesFromStr(line);
    if (bytesLen(b) < 9) {
        return none;
    }
    let v = 0;
    let k = 0;
    while (k < 4) {
        const ch = bytesGet(b, k) ?? 0;
        if (!isDigit(ch)) {
            return none;
        }
        v = v * 10 + ch - 48;
        k = k + 1;
    }
    if ((bytesGet(b, 4) ?? 0) != 32 || (bytesGet(b, 5) ?? 0) != 91) {
        return none;
    }
    let j = 6;
    while (j < bytesLen(b) && isWord(bytesGet(b, j) ?? 0)) {
        j = j + 1;
    }
    if (j == 6 || (bytesGet(b, j) ?? 0) != 58) {
        return none;
    }
    const kind = bytesToStr(bytesSlice(b, 6, j - 6)) catch "";
    const s = j + 1;
    j = s;
    while (j < bytesLen(b) && isWord(bytesGet(b, j) ?? 0)) {
        j = j + 1;
    }
    if (j == s || (bytesGet(b, j) ?? 0) != 93 || (bytesGet(b, j + 1) ?? 0) != 32) {
        return none;
    }
    return Listed { code: v, kind: kind, name: bytesToStr(bytesSlice(b, s, j - s)) catch "" };
}

function sortInts(xs: List<int>): List<int> {
    const out: List<int> = listNew();
    for (x in xs) {
        listPush(out, x);
        let k = listLen(out) - 1;
        while (k > 0 && x < (listGet(out, k - 1) catch 0)) {
            listSet(out, k, listGet(out, k - 1) catch 0);
            k = k - 1;
        }
        listSet(out, k, x);
    }
    return out;
}

// 运行时诊断码的名表：nrt.tx 的 RUNTIME_NAMES，自 4001 起依次。
function runtimeNames(root: string): List<string> {
    const text = txt(readBytes(join(root, "bootstrap/selfhost/nrt.tx")) catch bytesNew(0));
    const key = "const RUNTIME_NAMES: string = \"";
    const parts = strSplit(text, key);
    const out: List<string> = listNew();
    if (listLen(parts) < 2) {
        return out;
    }
    const body = listGet(strSplit(listGet(parts, 1) catch "", "\""), 0) catch "";
    for (w in strSplit(universal(bytesFromStr(body)), " ")) {
        for (x in strSplit(w, "\n")) {
            const y = strip(x);
            if (len(y) > 0) {
                listPush(out, y);
            }
        }
    }
    return out;
}

// capabilities JSON 的一个键：缺席或 null 为 None（同 Python 的 caps.get）。
struct Cap {
    none: bool,
    isStr: bool,
    text: string,
    v: Ref<Jv>,
}

function capOf(caps: Ref<Jv>, key: string): Cap {
    const v = jGet(caps, key) ?? jNull();
    return Cap { none: v.kind == J_NULL, isStr: v.kind == J_STR, text: v.text, v: v };
}

function capIs(caps: Ref<Jv>, key: string, want: string): bool {
    const c = capOf(caps, key);
    return c.isStr && c.text == want;
}

function notImplementedHas(caps: Ref<Jv>, name: string): bool {
    const c = capOf(caps, "not_implemented");
    if (c.none) {
        return false;
    }
    if (!c.isStr) {
        return true;
    }
    for (x in strSplit(c.text, ",")) {
        if (x == name) {
            return true;
        }
    }
    return false;
}

function lowerAscii(s: string): string {
    const b = bytesFromStr(s);
    let i = 0;
    while (i < bytesLen(b)) {
        const ch = bytesGet(b, i) ?? 0;
        if (ch >= 65 && ch <= 90) {
            bytesSet(b, i, (ch + 32) as u8);
        }
        i = i + 1;
    }
    return bytesToStr(b) catch s;
}

// Python 的 str(caps.get(key)).lower()。
function pyStrLower(c: Cap): string {
    if (c.none) {
        return "none";
    }
    if (c.v.kind == J_BOOL) {
        if (c.v.truth) {
            return "true";
        }
        return "false";
    }
    if (c.isStr || c.v.kind == J_NUM) {
        return lowerAscii(c.v.text);
    }
    return lowerAscii(pyRepr(c.v));
}

function capRepr(c: Cap): string {
    if (c.none) {
        return "None";
    }
    return pyRepr(c.v);
}

function optRepr(present: bool, s: string): string {
    if (!present) {
        return "None";
    }
    return reprStr(s);
}

function hasSpace(s: string): bool {
    let i = 0;
    while (i < len(s)) {
        if (isWs(byteAt(s, i) ?? 0)) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

struct Match {
    ok: bool,
    detail: string,
}

// 文本形的键值行按 "; " 切成 key=value，值里不得再有空白或 '='（漏写分号即失败），并逐项对 JSON；不含 '=' 的行是说明文字。
function capabilitiesTextMatches(text: string, caps: Ref<Jv>): Match {
    const pairs: Map<string, string> = mapNew();
    for (line in splitLines(text)) {
        if (!contains(line, "=")) {
            continue;
        }
        for (seg in strSplit(line, "; ")) {
            const parts = strSplit(seg, "=");
            const key = listGet(parts, 0) catch "";
            let value = "";
            let eq = listLen(parts) > 1;
            if (eq) {
                value = bytesToStr(bytesSlice(bytesFromStr(seg), len(key) + 1, len(seg) - len(key) - 1)) catch "";
            }
            if (!eq || len(key) == 0 || len(value) == 0 || contains(value, "=") || hasSpace(value) || mapHas(pairs, key)) {
                return Match { ok: false, detail: "bad segment " + reprStr(seg) };
            }
            mapSet(pairs, key, value);
        }
    }
    if (contains(text, "未实现")) {
        return Match { ok: false, detail: "text claims something is not implemented" };
    }
    const lsp = "native(" + capOf(caps, "lsp_features").text + ")";
    const mcp = "native(" + capOf(caps, "mcp_tools").text + ")";
    const rd = capOf(caps, "run_debug");
    if ((mapGet(pairs, "lsp") ?? "\n") != lsp || (mapGet(pairs, "mcp") ?? "\n") != mcp || !sameCap(pairs, "run --debug", rd)) {
        return Match { ok: false, detail: "lsp/mcp/run --debug differ from JSON" };
    }
    const keys = ["toolchain_version", "diagnostic_version", "build", "run", "test", "fmt", "explain", "doc", "init", "bench", "disasm", "profile",
        "link_map", "dap", "frontend", "target", "runtime", "compiler", "lsp_file_policy", "mcp_execution_default", "mcp_worker",
        "mcp_request_timeout", "mcp_error_schema", "program_regalloc", "program_regalloc_flag", "program_regalloc_controls", "program_regalloc_commands"];
    for (key in keys) {
        const cv = capOf(caps, key);
        if (!sameCap(pairs, key, cv)) {
            return Match { ok: false, detail: key + ": text " + optRepr(mapHas(pairs, key), mapGet(pairs, key) ?? "") + ", JSON " + capRepr(cv) };
        }
    }
    const lowered = ["lsp_network_paths", "mcp_untrusted_sandbox_verified", "program_regalloc_default"];
    for (key in lowered) {
        const cv = capOf(caps, key);
        if (!mapHas(pairs, key) || (mapGet(pairs, key) ?? "") != pyStrLower(cv)) {
            return Match { ok: false, detail: key + ": text " + optRepr(mapHas(pairs, key), mapGet(pairs, key) ?? "") + ", JSON " + capRepr(cv) };
        }
    }
    const formats = "format=json(run,test,fmt,doc,bench,capabilities,profile-compile,disasm)";
    if ("format=" + (mapGet(pairs, "format") ?? "") != formats) {
        return Match { ok: false, detail: "format list " + optRepr(mapHas(pairs, "format"), mapGet(pairs, "format") ?? "") };
    }
    return Match { ok: true, detail: toStr(mapLen(pairs)) + " keys" };
}

// pairs.get(key) == caps.get(key)：两边都没有，或文本等于 JSON 里的字符串。
function sameCap(pairs: Map<string, string>, key: string, cv: Cap): bool {
    if (!mapHas(pairs, key)) {
        return cv.none;
    }
    return cv.isStr && (mapGet(pairs, key) ?? "") == cv.text;
}

function explainRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const want: Map<int, bool> = mapNew();
    const srcs = cat(txFiles(join(c.root, "bootstrap")), txFiles(join(c.root, "bootstrap/selfhost")));
    for (f in srcs) {
        scanCodes(readBytes(f) catch bytesNew(0), want);
    }
    const names = runtimeNames(c.root);
    const p = compilerCall(c, lst(["explain"]), c.root, 60);
    const listed: Map<int, Listed> = mapNew();
    for (line in splitLines(txt(p.out))) {
        const l = listedOf(line);
        if (l.code >= 0) {
            mapSet(listed, l.code, l);
        }
    }
    add(rows, "explain:list", p.code == 0 && mapLen(listed) > 0, "exit=" + toStr(p.code) + " entries=" + toStr(mapLen(listed)));
    const missing: List<int> = listNew();
    for (code in sortInts(mapKeys(want))) {
        if (!mapHas(listed, code)) {
            listPush(missing, code);
        }
    }
    add(rows, "explain:compiler-codes", listLen(missing) == 0, "codes=" + toStr(mapLen(want)) + " missing=" + reprInts(missing));
    const bad: List<int> = listNew();
    let i = 0;
    while (i < listLen(names)) {
        const code = 4001 + i;
        const got = mapGet(listed, code) ?? Listed { code: -1, kind: "", name: "" };
        if (got.name != (listGet(names, i) catch "") || got.kind != "runtime") {
            listPush(bad, code);
        }
        i = i + 1;
    }
    add(rows, "explain:runtime-codes", listLen(bad) == 0, "codes=" + toStr(listLen(names)) + " mismatched=" + reprInts(bad));
    const one = compilerCall(c, lst(["explain", "3002"]), c.root, 60);
    const text = txt(one.out);
    add(rows, "explain:one", one.code == 0 && startsWith(text, "3002 [sema:type_mismatch] ") && contains(text, "\n修复建议："), "exit=" + toStr(one.code));
    const unk = compilerCall(c, lst(["explain", "9999"]), c.root, 60);
    add(rows, "explain:unknown", unk.code == 64 && contains(txt(unk.err), "未知诊断码 9999"), "exit=" + toStr(unk.code));
    const cap = compilerCall(c, lst(["capabilities", "--format=json"]), c.root, 60);
    rows2Cap(c, rows, cap, parseOrNull(cap.out));
}

function parseOrNull(b: Bytes): Ref<Jv> {
    const v = jParseBytes(b) catch (e) {
        return jNull();
    };
    return v;
}

// capabilities 的两行（JSON 与文本）；doc 为 JSON 解析结果（解析不了为 null）。
function rows2Cap(c: Ref<Ctx>, rows: List<XRow>, cap: Ref<Res>, doc: Ref<Jv>): void {
    // 调试三面（run --debug、dap、mcp 的 debug_*）为 native；：lsp 为 native，lsp_features 列已做的请求（增
    // definition、references、rename，增 semanticTokens，增 hover）。
    const mcpTools = "compile,run,test,disasm,debug_start,debug_breakpoint,debug_step,debug_continue,debug_frames,debug_inspect,debug_stops,debug_kill";
    const lspFeatures = "diagnostics,formatting,documentSymbol,hover,signatureHelp,completion,definition,references,rename,semanticTokens";
    const caps = jGet(doc, "capabilities") ?? jNull();
    const capOk = cap.code == 0 && caps.kind == J_OBJ && capIs(caps, "fmt", "native") && capIs(caps, "explain", "native")
    && capIs(caps, "run_debug", "native") && capIs(caps, "dap", "native") && capIs(caps, "mcp", "native") && capIs(caps, "mcp_tools", mcpTools)
    && capIs(caps, "lsp", "native") && capIs(caps, "lsp_features", lspFeatures) && !notImplementedHas(caps, "lsp")
    && capIs(caps, "disasm", "native") && !notImplementedHas(caps, "disasm");
    add(rows, "capabilities:json", capOk, "exit=" + toStr(cap.code));
    const plain = compilerCall(c, lst(["capabilities"]), c.root, 60);
    let ok = capOk && plain.code == 0 && bytesLen(plain.err) == 0;
    let detail = "exit=" + toStr(plain.code);
    if (ok) {
        const m = capabilitiesTextMatches(txt(plain.out), caps);
        ok = m.ok;
        detail = m.detail;
    }
    add(rows, "capabilities:text-json", ok, detail);
}

// ---------------------------------------------------------------- doc 与 init

function docJson(c: Ref<Ctx>, path: string): Ref<Jv> {
    const p = compilerCall(c, lst(["doc", "--format=json", path]), c.root, 300);
    if (p.code != 0) {
        return jNull();
    }
    const v = jParseBytes(p.out) catch (e) {
        return jNull();
    };
    return v;
}

function sameJson(a: Ref<Jv>?, b: Ref<Jv>?): bool {
    if (a == None || b == None) {
        return a == None && b == None;
    }
    return jDump(jSorted(a ?? jNull())) == jDump(jSorted(b ?? jNull()));
}

// 目录下全部普通文件（相对 base、正斜杠）。
function walk(base: string, rel: string, out: List<string>): void {
    let dir = base;
    if (len(rel) > 0) {
        dir = base + "/" + rel;
    }
    const names = localListDir(nat(dir), "") catch noStrings();
    for (n in names) {
        let r = n;
        if (len(rel) > 0) {
            r = rel + "/" + n;
        }
        const k = localEntryKind(nat(dir), n);
        if (k == 2) {
            walk(base, r, out);
        } else if (k == 1) {
            listPush(out, r);
        }
    }
}

// 目录内容的快照（相对路径与字节，按路径排序）；两个快照相等即内容相同。
function snapshot(dir: string): Bytes {
    const files: List<string> = listNew();
    walk(dir, "", files);
    const out = bytesNew(0);
    for (r in sorted(files)) {
        const b = readBytes(dir + "/" + r) catch bytesFromStr("\u{0}unreadable");
        bytesAppend(out, bytesFromStr(r + "\u{0}" + toStr(bytesLen(b)) + "\u{0}"));
        bytesAppend(out, b);
    }
    return out;
}

function toolRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const fixture = jParseBytes(readBytes(join(c.root, "tests/doc-native.json")) catch bytesNew(0)) catch (e) {
        add(rows, "tool_rows:aborted", false, "tests/doc-native.json：" + e.message);
        return;
    };
    const templates = jParseBytes(readBytes(join(c.root, "tests/init-native.json")) catch bytesNew(0)) catch (e) {
        add(rows, "tool_rows:aborted", false, "tests/init-native.json：" + e.message);
        return;
    };
    const work = tempWork("taixu-tools-");
    const api = work + "/api.tx";
    write(api, jText(jGet(fixture, "source")) ?? "");
    let data = docJson(c, nat(api));
    addJ(rows, "doc:frozen-declarations", data.kind != J_NULL && sameJson(jGet(data, "decls"), jGet(fixture, "decls")), data);
    const names = ["tests/nrt-cases/gen-basic.tx", "tests/nrt-cases/iface-values.tx", "tests/nrt-cases/ffi-linux-lib.tx"];
    const kinds = ["function", "interface", "extern"];
    const sigs = ["function* range(from: int, to: int): int", "interface Shape（2 个方法）", "declare function strlen(s: string): usize from \"libc.so.6\""];
    let k = 0;
    while (k < 3) {
        data = docJson(c, nat(join(c.root, names[k])));
        let ok = false;
        const decls = jGet(data, "decls") ?? jArray();
        for (d in decls.items) {
            if ((jText(jGet(d, "kind")) ?? "\n") == kinds[k] && (jText(jGet(d, "signature")) ?? "\n") == sigs[k]) {
                ok = true;
            }
        }
        addJ(rows, "doc:syntax-" + names[k], data.kind != J_NULL && ok, data);
        k = k + 1;
    }
    const out = work + "/doc/a/b";
    const p = compilerCall(c, lst(["doc", "--format=json", "--out-dir=" + nat(out), "examples"]), c.root, 300);
    let good = p.code == 0;
    let found = 0;
    const listed = localListDir(nat(out), "") catch noStrings();
    for (n in listed) {
        if (endsWith(n, ".json") && localEntryKind(nat(out), n) != 0) {
            found = found + 1;
            const item = jParseBytes(readBytes(out + "/" + n) catch bytesNew(0)) catch (e) {
                good = false;
                continue;
            };
            const decls = jGet(item, "decls") ?? jNull();
            good = good && decls.kind == J_ARR;
        }
    }
    add(rows, "doc:out-dir", good && found > 0, tailChars(txt(p.err), 500));
    const project = work + "/projects";
    mkdirs(project);
    const expected: Map<string, string> = mapNew();
    const cases = jGet(templates, "cases") ?? jArray();
    for (cs in cases.items) {
        const args: List<string> = listNew();
        const argsJ = jGet(cs, "args") ?? jArray();
        for (a in argsJ.items) {
            listPush(args, a.text);
        }
        const r = compilerCall(c, cat(lst(["init"]), args), project, 300);
        const files = jGet(cs, "files") ?? jObject();
        let i = 0;
        while (i < listLen(files.keys)) {
            const v = listGet(files.items, i) catch files;
            mapSet(expected, listGet(files.keys, i) catch "", v.text);
            i = i + 1;
        }
        const actual: List<string> = listNew();
        walk(project, "", actual);
        let same = listLen(actual) == mapLen(expected);
        for (rel in actual) {
            const content = universal(readBytes(project + "/" + rel) catch bytesNew(0));
            if (!mapHas(expected, rel) || (mapGet(expected, rel) ?? "") != content) {
                same = false;
            }
        }
        const ok = r.code == 0 && lf(txt(r.out)) == (jText(jGet(cs, "stdout")) ?? "\n") && same;
        add(rows, "init:frozen-" + joinWith(args, "-"), ok, tailChars(txt(r.err), 300));
    }
    const personal = project + "/p1/main.tx";
    writeFileBytes(personal, bytesFromStr("// user content\n")) catch (e) {};
    let r = compilerCall(c, lst(["init", "p1"]), project, 300);
    add(rows, "init:no-overwrite", r.code == 0 && sameBytes(readBytes(personal) catch bytesNew(0), bytesFromStr("// user content\n")), txt(r.err));
    const before = snapshot(project);
    // 每项的实参以空格分开（实参本身不含空格）。
    const rejects = ["--template=desktop desktop-project", "desktop project", "bad/name", "--template=nope p5", "a b c", "--help", "-x", "console -p7"];
    for (args in rejects) {
        const al = strSplit(args, " ");
        r = compilerCall(c, cat(lst(["init"]), al), project, 300);
        add(rows, "init:reject-" + joinWith(al, " "), r.code == 64 && sameBytes(before, snapshot(project)), tailChars(txt(r.err), 300));
    }
    deleteTree(work);
}

function joinWith(xs: List<string>, sep: string): string {
    let s = "";
    let i = 0;
    for (x in xs) {
        if (i > 0) {
            s = s + sep;
        }
        s = s + x;
        i = i + 1;
    }
    return s;
}

// ---------------------------------------------------------------- 其余各组

function testOptionRows(c: Ref<Ctx>, rows: List<XRow>): void {
    // test 的选项可放在文件之后（taixu test main.tx --leak-check，同 build）；第二个文件仍被拒绝。
    const work = tempWork("tx-testopt-");
    write(work + "/main.tx", "export function main(args: []string): int { return 0; }\ntest \"加法\" {\n    assert(1 + 1 == 2, \"1 + 1\");\n}\n");
    const names = ["test-options:after-file", "test-options:before-file", "test-options:two-files"];
    const argvs = ["test main.tx --leak-check", "test --leak-check main.tx", "test main.tx main.tx"];
    const wants = [0, 0, 64];
    let k = 0;
    while (k < 3) {
        const p = compilerCall(c, strSplit(argvs[k], " "), work, 300);
        const both = txt(cat2(p.out, p.err));
        let ok = p.code == wants[k];
        if (wants[k] == 0) {
            ok = ok && contains(both, "1 passed, 0 failed");
        } else {
            ok = ok && contains(both, "只接受一个 .tx 文件");
        }
        add(rows, names[k], ok, exitOut(p.code, both, 300));
        k = k + 1;
    }
    deleteTree(work);
}

// 发布包布局：编译器旁的 stdlib/src 即标准库根（设计 v052-public-release §三）；没有时 3008 的提示写出可用的位置。
function stdlibRootRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const saved = getEnv("TAIXU_STDLIB");
    // 编译器把空值当作未设。
    setEnv("TAIXU_STDLIB", "") catch (e) {};
    const work = tempWork("tx-stdroot-");
    write(work + "/user/use.tx", "import { probeValue } from \"std/probe\";\nexport function main(args: []string): int { print(toStr(probeValue())); return 0; }\n");
    const names = ["release-layout", "missing"];
    for (name in names) {
        const withLib = name == "release-layout";
        const pkg = work + "/pkg-" + name;
        mkdirs(pkg);
        const exe = pkg + "/" + baseOf(c.compiler);
        copyFile(c.compiler, exe, true);
        if (withLib) {
            write(pkg + "/stdlib/src/probe.tx", "export function probeValue(): int { return 7; }\n");
        }
        const p = call(lst([nat(exe), "run", "use.tx"]), work + "/user", 300);
        const out = lf(txt(p.out));
        const both = out + txt(p.err);
        if (withLib) {
            add(rows, "stdlib-root:" + name, p.code == 0 && out == "7\n", exitOut(p.code, both, 300));
        } else {
            add(rows, "stdlib-root:" + name, p.code != 0 && contains(both, "error 3008") && contains(both, "编译器同目录的 stdlib/"), exitOut(p.code, both, 300));
        }
    }
    deleteTree(work);
    setEnv("TAIXU_STDLIB", saved ?? "") catch (e) {};
}

struct Out3 {
    code: int,
    out: string,
    both: string,
}

function run3(exe: string, args: List<string>, cwd: string): Out3 {
    const p = call(cat(lst([exe]), args), cwd, 300);
    const out = lf(txt(p.out));
    return Out3 { code: p.code, out: out, both: out + txt(p.err) };
}

// 复制目录树（普通文件与子目录）。
function copyTree(from: string, to: string): void {
    mkdirs(to);
    const names = localListDir(nat(from), "") catch noStrings();
    for (n in names) {
        const k = localEntryKind(nat(from), n);
        if (k == 2) {
            copyTree(from + "/" + n, to + "/" + n);
        } else if (k == 1) {
            copyFile(from + "/" + n, to + "/" + n, false);
        }
    }
}

function guiRootRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const data = c.root + "/tests/nrt-cases/data";
    const fixture = data + "/gui-root";
    const saved = getEnv("TAIXU_GUI_ROOT");
    const want = "gui:太虚\n";
    const work = tempWork("tx-guiroot-");
    mkdirs(work + "/bare");
    const bareExe = work + "/bare/" + baseOf(c.compiler);
    copyFile(c.compiler, bareExe, true);
    setEnv("TAIXU_GUI_ROOT", nat(fixture)) catch (e) {};
    let r = run3(c.compiler, lst(["run", nat(data + "/gui-use.tx")]), c.root);
    add(rows, "gui-root:env", r.code == 0 && r.out == want, exitOut(r.code, r.both, 300));
    setEnv("TAIXU_GUI_ROOT", "") catch (e) {};
    copyFile(data + "/gui-use.tx", work + "/use.tx", false);
    r = run3(nat(bareExe), lst(["run", "use.tx"]), work);
    add(rows, "gui-root:missing", r.code != 0 && contains(r.both, "error 3008") && contains(r.both, "gui/ 导入需要 GUI 框架根"), exitOut(r.code, r.both, 300));
    const bindir = work + "/bin";
    mkdirs(bindir);
    const exe2 = bindir + "/" + baseOf(c.compiler);
    copyFile(c.compiler, exe2, true);
    copyTree(fixture, bindir + "/taixu-gui/src");
    r = run3(nat(exe2), lst(["run", "use.tx"]), work);
    add(rows, "gui-root:exe-sibling", r.code == 0 && r.out == want, exitOut(r.code, r.both, 300));
    const publicBin = work + "/public-bin";
    mkdirs(publicBin);
    const publicExe = publicBin + "/" + baseOf(c.compiler);
    copyFile(c.compiler, publicExe, true);
    copyTree(fixture, publicBin + "/gui/src");
    r = run3(nat(publicExe), lst(["run", "use.tx"]), work);
    add(rows, "gui-root:release-layout", r.code == 0 && r.out == want, exitOut(r.code, r.both, 300));
    copyFile(data + "/gui-env.tx", work + "/internal.tx", false);
    r = run3(nat(publicExe), lst(["run", "internal.tx"]), work);
    add(rows, "gui-root:release-rt-builtin", r.code != 0 && contains(r.both, "error 3001") && contains(r.both, "只供标准库模块使用"), exitOut(r.code, r.both, 300));
    const source = work + "/source";
    mkdirs(source);
    copyFile(data + "/gui-use.tx", source + "/use.tx", false);
    copyTree(fixture, source + "/gui/src");
    r = run3(nat(bareExe), lst(["run", "use.tx"]), source);
    add(rows, "gui-root:ordinary-gui-dir-not-discovered", r.code != 0 && contains(r.both, "error 3008"), exitOut(r.code, r.both, 300));
    write(source + "/bootstrap/taixu.tx", "// source layout marker\n");
    write(work + "/taixu-gui/src/demo/greet.tx", "export function greet(name: string): string { return \"wrong-version:\" + name; }\n");
    r = run3(nat(bareExe), lst(["run", "use.tx"]), source);
    add(rows, "gui-root:source-layout", r.code == 0 && r.out == want, exitOut(r.code, r.both, 300));
    mkdirs(source + "/project");
    r = run3(nat(bareExe), lst(["run", "../use.tx"]), source + "/project");
    add(rows, "gui-root:source-parent-layout", r.code == 0 && r.out == want, exitOut(r.code, r.both, 300));
    write(work + "/override/demo/greet.tx", "export function greet(name: string): string { return \"override:\" + name; }\n");
    setEnv("TAIXU_GUI_ROOT", nat(work + "/override")) catch (e) {};
    r = run3(nat(publicExe), lst(["run", "use.tx"]), work);
    add(rows, "gui-root:env-overrides-release", r.code == 0 && r.out == "override:太虚\n", exitOut(r.code, r.both, 300));
    setEnv("TAIXU_GUI_ROOT", nat(fixture)) catch (e) {};
    r = run3(c.compiler, lst(["run", nat(data + "/gui-env.tx")]), c.root);
    add(rows, "gui-root:rt-builtin", r.code != 0 && contains(r.both, "error 3001") && contains(r.both, "只供标准库模块使用"), exitOut(r.code, r.both, 300));
    setEnv("TAIXU_GUI_ROOT", "") catch (e) {};
    let sib = c.root + "/gui/tests";
    if (!fileExists(sib + "/layout.tx")) { sib = dirOf(c.root) + "/taixu-gui/tests"; }
    if (fileExists(sib + "/layout.tx") && fileExists(sib + "/layout.out")) {
        r = run3(c.compiler, lst(["run", nat(sib + "/layout.tx")]), c.root);
        const expect = universal(readBytes(sib + "/layout.out") catch bytesNew(0));
        add(rows, "gui-root:sibling-layout", r.code == 0 && r.out == expect, exitOut(r.code, r.both, 300));
    } else {
        skip(rows, "gui-root:sibling-layout", "no sibling taixu-gui checkout");
    }
    deleteTree(work);
    setEnv("TAIXU_GUI_ROOT", saved ?? "") catch (e) {};
}

// 产物运行结果的 Python 元组写法 (退出码, stdout, stderr)。
function tuple3(r: Ref<Res>): string {
    return "(" + toStr(r.code) + ", " + reprBytes(r.out, ALL) + ", " + reprBytes(r.err, ALL) + ")";
}

function debugBuildRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const src = nat(c.root + "/tests/debug/basic.tx");
    let work = tempWork("tx-dbgbuild-");
    const tags = ["normal", "debug"];
    const reprs: List<string> = listNew();
    const sizes: List<string> = listNew();
    const keys: List<string> = listNew();
    let codes: List<int> = listNew();
    let built = 0;
    for (tag in tags) {
        let flags: List<string> = listNew();
        if (tag == "debug") {
            flags = lst(["--debug"]);
        }
        const b = compilerCall(c, cat(cat(lst(["build", src]), flags), lst(["--out", nat(work + "/" + tag)])), c.root, 300);
        const exe = work + "/" + tag + "/" + exeName("basic");
        if (b.code != 0 || !fileExists(exe)) {
            listPush(reprs, "None");
            listPush(sizes, reprStr(headChars(txt(b.err), 300)));
            listPush(keys, "");
            listPush(codes, -1000);
            continue;
        }
        // 先取大小：被杀软拦截的产物可能随即被隔离删除。
        const size = fileSize(exe) catch -1;
        const r = call(lst([nat(exe)]), c.root, 60);
        listPush(reprs, tuple3(r));
        listPush(sizes, toStr(size));
        listPush(keys, tuple3(r));
        listPush(codes, r.code);
        built = built + 1;
    }
    const ok = built == 2 && (listGet(keys, 0) catch "a") == (listGet(keys, 1) catch "b") && (listGet(codes, 0) catch 0) == 10;
    add(rows, "debug-build:transparent", ok, "normal=" + (listGet(reprs, 0) catch "") + " debug=" + (listGet(reprs, 1) catch "") + " sizes="
        + (listGet(sizes, 0) catch "") + "/" + (listGet(sizes, 1) catch ""));
    const others = ["--leak-check", "--bytecode", "--lib"];
    for (other in others) {
        const r = compilerCall(c, lst(["build", src, "--debug", other, "--out", nat(work + "/x")]), c.root, 120);
        const text = txt(r.err);
        let needle = "--debug 与 --lib、--leak-check 互斥";
        if (other == "--bytecode") {
            needle = "字节码产物已退场";
        }
        add(rows, "debug-build:excl" + other, r.code == 64 && contains(text, needle), exitErr(r.code, text, 200));
    }
    // run --debug 的旗标冲突（文案同 VM，退出码 64，stdout 无输出）与找不到入口文件（compile_failed 3008）。
    const runOthers = ["--format=json", "--leak-check"];
    const runWants = ["--debug 与 --format=json 互斥", "--debug 与 --lib、--leak-check 互斥"];
    let k = 0;
    while (k < 2) {
        const r = compilerCall(c, lst(["run", "--debug", runOthers[k], src]), c.root, 120);
        const text = txt(r.err);
        add(rows, "debug-run:excl" + runOthers[k], r.code == 64 && contains(text, runWants[k]) && bytesLen(r.out) == 0,
            "exit=" + toStr(r.code) + " out=" + reprBytes(r.out, 100) + " err=" + reprStr(headChars(text, 200)));
        k = k + 1;
    }
    // `taixu dap`、`taixu mcp` 不接受多余参数（64）；会话本身由各自的端到端门覆盖。
    const servers = ["dap", "mcp"];
    for (s in servers) {
        const r = compilerCall(c, lst([s, "extra"]), c.root, 120);
        add(rows, s + ":extra-arg", r.code == 64 && bytesLen(r.out) == 0, "exit=" + toStr(r.code) + " out=" + reprBytes(r.out, 100));
    }
    const missing = nat(work + "/no-such.tx");
    let r = compilerCall(c, lst(["run", "--debug", missing]), c.root, 120);
    const out = txt(r.out);
    add(rows, "debug-run:missing-entry", r.code == 1 && contains(out, "\"event\":\"compile_failed\"") && contains(out, "\"code\":3008")
        && contains(out, "FileNotFound"), exitOut(r.code, out, 300));
    deleteTree(work);
    //进程与标准输入内建的例程只进原生产物，字节码构建用到它们即报错、不出产物。
    work = tempWork("tx-toolbc-");
    r = compilerCall(c, lst(["build", nat(c.root + "/tests/nrt-cases/proc-pipe.tx"), "--toolchain", "--bytecode", "--out", nat(work + "/bc")]), c.root, 300);
    const text = txt(cat2(r.out, r.err));
    const made = exists(work + "/bc");
    add(rows, "tool-builtins:bytecode-rejected", r.code == 64 && contains(text, "字节码产物已退场") && !made,
        "exit=" + toStr(r.code) + " out=" + reprStr(headChars(text, 200)) + " files=" + pyBool(made));
    deleteTree(work);
}

// build --lib（宿主目标）：没有 main 的入口只在带 --lib 时构建（否则 3010），产物运行时以“程序没有 main 入口”trap（退出码 3）。各目标
// 相同，macOS 也是。
function libBuildRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const work = tempWork("tx-lib-");
    const src = work + "/nomain.tx";
    write(src, "export function twice(x: int): int {\n    return x * 2;\n}\n");
    let r = compilerCall(c, lst(["build", nat(src), "--out", nat(work + "/plain")]), c.root, 300);
    let text = txt(r.err);
    add(rows, "lib-build:no-main-rejected", r.code == 1 && contains(text, "3010"), exitErr(r.code, text, 200));
    r = compilerCall(c, lst(["build", nat(src), "--lib", "--out", nat(work + "/lib")]), c.root, 300);
    const exe = work + "/lib/" + exeName("nomain");
    add(rows, "lib-build:built", r.code == 0 && fileExists(exe), exitErr(r.code, txt(r.err), 200));
    if (fileExists(exe)) {
        const p = call(lst([nat(exe)]), c.root, 60);
        const err = txt(p.err);
        add(rows, "lib-build:run-traps", p.code == 3 && contains(err, "程序没有 main 入口") && bytesLen(p.out) == 0,
            "exit=" + toStr(p.code) + " out=" + reprBytes(p.out, 100) + " err=" + reprStr(headChars(err, 200)));
    }
    deleteTree(work);
}

// 构建报告的外部内存行（D3 v0.48 §6.8-18）：ffi-mem.tx 在 9 处源码位置建区、都在自己的模块里，构建在外部库那一行之后打出
// “外部内存区：ffi-mem.tx（9 处）”；有外部函数而不建区的程序（ffi-front.tx）不打这一行。宿主目标，各宿主都跑。
function ffiMemReportRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const work = tempWork("tx-memrep-");
    const cases = c.root + "/tests/nrt-cases";
    const names = ["ffi-mem.tx", "ffi-front.tx"];
    const wants = ["taixu: 外部内存区：ffi-mem.tx（9 处）", ""];
    let k = 0;
    while (k < 2) {
        const name = names[k];
        const r = compilerCall(c, lst(["build", name, "--out", nat(work + "/" + name)]), cases, 300);
        const lines = splitLines(txt(r.out));
        const mem: List<string> = listNew();
        for (l in lines) {
            if (startsWith(l, "taixu: 外部内存区")) {
                listPush(mem, l);
            }
        }
        let ok = r.code == 0;
        if (len(wants[k]) > 0) {
            ok = ok && listLen(mem) == 1 && (listGet(mem, 0) catch "") == wants[k];
        } else {
            ok = ok && listLen(mem) == 0;
        }
        const last3: List<string> = listNew();
        let i = listLen(lines) - 3;
        if (i < 0) {
            i = 0;
        }
        while (i < listLen(lines)) {
            listPush(last3, listGet(lines, i) catch "");
            i = i + 1;
        }
        add(rows, "build-report:ffi-mem:" + name, ok, "exit=" + toStr(r.code) + " lines=" + reprList(last3) + " err=" + reprStr(headChars(txt(r.err), 200)));
        k = k + 1;
    }
    deleteTree(work);
}

// --heap-check（设计 v052-heap-check-tool）：产物链接内嵌的检测内核（页堆＋对象编号隔离；消息以“heapcheck:”开头）且运行结果相同；可与
// --leak-check 及 test 合用；与 --link-object 互斥；bench 不收。
function heapCheckRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const work = tempWork("tx-heapcheck-");
    const src = work + "/hc.tx";
    write(src, "struct Node { next: Ref<Node>?, v: int }\nexport function main(args: []string): int {\n    let head: Ref<Node>? = None;\n"
        + "    let i = 0;\n    while (i < 1000) { head = new Node { next: head, v: i }; i = i + 1; }\n    print(\"ok\");\n    return 0;\n}\n");
    const std = work + "/standard/" + exeName("hc");
    const hc = work + "/heapcheck/" + exeName("hc");
    let r = compilerCall(c, lst(["build", nat(src), "--out", nat(work + "/standard")]), c.root, 300);
    add(rows, "heap-check:build-standard", r.code == 0 && fileExists(std), exitErr(r.code, txt(r.err), 200));
    r = compilerCall(c, lst(["build", nat(src), "--heap-check", "--out", nat(work + "/heapcheck")]), c.root, 300);
    add(rows, "heap-check:build-heapcheck", r.code == 0 && fileExists(hc), exitErr(r.code, txt(r.err), 200));
    if (fileExists(std) && fileExists(hc)) {
        add(rows, "heap-check:detection-kernel", bytesHas(readBytes(hc) catch bytesNew(0), "heapcheck:")
            && !bytesHas(readBytes(std) catch bytesFromStr("heapcheck:"), "heapcheck:"), "marker");
        const p = call(lst([nat(hc)]), c.root, 60);
        add(rows, "heap-check:runs", p.code == 0 && sameBytes(lfBytes(p.out), bytesFromStr("ok\n")), bytesDetail(p, 100, 200));
    }
    r = compilerCall(c, lst(["run", "--heap-check", "--leak-check", nat(src)]), c.root, 300);
    add(rows, "heap-check:run-with-leak-check", r.code == 0 && sameBytes(lfBytes(r.out), bytesFromStr("ok\n")), bytesDetail(r, 100, 200));
    const t = work + "/hct.tx";
    write(t, "test \"quarantine\" {\n    const xs: List<int> = listNew();\n    listPush(xs, 1);\n    assert(listLen(xs) == 1, \"one element\");\n}\n");
    r = compilerCall(c, lst(["test", "--heap-check", nat(t)]), c.root, 300);
    add(rows, "heap-check:test", r.code == 0, bytesDetail(r, 200, 200));
    r = compilerCall(c, lst(["build", nat(src), "--heap-check", "--link-object", nat(std), "--out", nat(work + "/x")]), c.root, 120);
    const text = txt(r.err);
    add(rows, "heap-check:excludes-link-object", r.code == 64 && contains(text, "--heap-check 与 --link-object 互斥"), exitErr(r.code, text, 200));
    r = compilerCall(c, lst(["bench", "--heap-check", nat(src)]), c.root, 120);
    add(rows, "heap-check:bench-rejects", r.code == 64, "exit=" + toStr(r.code) + " err=" + reprBytes(r.err, 200));
    deleteTree(work);
}

function bytesDetail(r: Ref<Res>, nOut: int, nErr: int): string {
    return "exit=" + toStr(r.code) + " out=" + reprBytes(r.out, nOut) + " err=" + reprBytes(r.err, nErr);
}

// 路径规范形：类 Unix 上 \ 是名字里的普通字符——名为 back\slash.tx 的入口导入同目录模块，构建、运行，产物名为 back\slash；循环导入的
// 诊断里路径按宿主显示（Windows 为 \，其余为 /）。
function pathRows(c: Ref<Ctx>, rows: List<XRow>): void {
    const windows = hostTarget() == "windows";
    const work = tempWork("tx-paths-");
    write(work + "/cyc/a.tx", "import { b } from \"./b\";\nexport function a(): int { return 1; }\nfunction main(args: []string): int { return b(); }\n");
    write(work + "/cyc/b.tx", "import { a } from \"./a\";\nexport function b(): int { return a(); }\n");
    let r = run3(c.compiler, lst(["build", "cyc/a.tx", "--out", "cyc-out"]), work);
    let shown = "cyc/";
    if (windows) {
        shown = "cyc\\";
    }
    add(rows, "paths:cycle-diag-host-separator", r.code != 0 && contains(r.both, "循环导入") && contains(r.both, shown) && (windows || !contains(r.both, "\\")),
        exitOut(r.code, r.both, 400));
    if (windows) {
        skip(rows, "paths:posix-backslash-name", "Windows 上 \\ 是分隔符");
        deleteTree(work);
        return;
    }
    writeFile(work + "/back\\slash.tx", "import { greet } from \"./helper\";\nfunction main(args: []string): int { print(greet()); return 0; }\n") catch (e) {};
    write(work + "/helper.tx", "export function greet(): string { return \"back-slash ok\"; }\n");
    r = run3(c.compiler, lst(["build", "back\\slash.tx", "--out", "out"]), work);
    const productKind = localEntryKind(work + "/out", "back\\slash");
    add(rows, "paths:posix-backslash-build", r.code == 0 && productKind == 1 && localEntryKind(work, "back") == 0, exitOut(r.code, r.both, 400));
    if (productKind == 1) {
        const p = call(lst([work + "/out/back\\slash"]), work, 60);
        add(rows, "paths:posix-backslash-product", p.code == 0 && sameBytes(p.out, bytesFromStr("back-slash ok\n")),
            "exit=" + toStr(p.code) + " out=" + reprBytes(p.out, 200));
    }
    r = run3(c.compiler, lst(["run", "back\\slash.tx"]), work);
    add(rows, "paths:posix-backslash-run", r.code == 0 && r.out == "back-slash ok\n", exitOut(r.code, r.both, 400));
    deleteTree(work);
}

// ---------------------------------------------------------------- 入口

// Python 的 sorted(Path.glob(...))：Windows 上路径比较不分大小写。
function pathSorted(xs: List<string>): List<string> {
    if (hostTarget() != "windows") {
        return sorted(xs);
    }
    const keyed: List<string> = listNew();
    const orig: Map<string, string> = mapNew();
    for (x in xs) {
        const k = lowerAscii(x) + "\n" + x;
        listPush(keyed, k);
        mapSet(orig, k, x);
    }
    const out: List<string> = listNew();
    for (k in sorted(keyed)) {
        listPush(out, mapGet(orig, k) ?? "");
    }
    return out;
}

function hasCompanion(tx: string): bool {
    for (ext in COMPANIONS) {
        if (exists(stemPath(tx) + ext)) {
            return true;
        }
    }
    return false;
}

struct Counts {
    keys: List<string>,
    n: Map<string, int>,
}

function bump(c: Ref<Counts>, status: string): void {
    if (!mapHas(c.n, status)) {
        listPush(c.keys, status);
    }
    mapSet(c.n, status, (mapGet(c.n, status) ?? 0) + 1);
}

function main(args: []string): int {
    let compiler = "";
    let reportPath = "";
    let root = "";
    const explicit: List<string> = listNew();
    let i = 0;
    while (i < len(args)) {
        const a = args[i];
        if (i + 1 < len(args) && (a == "--compiler" || a == "--report" || a == "--root")) {
            if (a == "--compiler") {
                compiler = args[i + 1];
            } else if (a == "--report") {
                reportPath = args[i + 1];
            } else {
                root = args[i + 1];
            }
            i = i + 2;
        } else if (startsWith(a, "-")) {
            eprint("用法：taixu run --toolchain scripts/test_native_cli.tx --compiler <原生 taixu> [--report 文件] [用例 ...]");
            return 2;
        } else {
            listPush(explicit, a);
            i = i + 1;
        }
    }
    if (len(compiler) == 0) {
        eprint("要给 --compiler");
        return 2;
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    const c = new Ctx { root: slashes(absolute(root)), compiler: nat(absolute(compiler)) };
    // getEnv 的正例夹具（同语料运行器）：Windows 宿主上经 wsl.exe 运行的 Linux 产物只看得到 WSLENV 列出的变量。
    if (hostTarget() == "windows") {
        const cur = getEnv("WSLENV") ?? "";
        let listed = false;
        for (n in strSplit(cur, ":")) {
            if (n == FIXTURE_VAR) {
                listed = true;
            }
        }
        if (!listed) {
            let names = "";
            for (n in strSplit(cur, ":")) {
                if (len(n) > 0) {
                    names = names + n + ":";
                }
            }
            setEnv("WSLENV", names + FIXTURE_VAR) catch (e) {};
        }
    }
    setEnv(FIXTURE_VAR, FIXTURE_VALUE) catch (e) {};
    const txs: List<string> = listNew();
    if (listLen(explicit) > 0) {
        for (x in explicit) {
            listPush(txs, slashes(absolute(x)));
        }
    } else {
        for (d in CASE_DIRS) {
            const here: List<string> = listNew();
            const names = localListDir(nat(join(c.root, d)), "") catch noStrings();
            for (n in names) {
                if (endsWith(n, ".tx")) {
                    listPush(here, n);
                }
            }
            for (n in pathSorted(here)) {
                const tx = c.root + "/" + d + "/" + n;
                if (hasCompanion(tx)) {
                    listPush(txs, tx);
                }
            }
        }
    }
    let arch = hostArch();
    if (arch != "aarch64") {
        arch = "x86_64";
    }
    const host = hostTarget();
    const rows = jArray();
    const counts = new Counts { keys: listNew(), n: mapNew() };
    for (tx in txs) {
        let name = tx;
        if (startsWith(tx, c.root + "/")) {
            name = bytesToStr(bytesSlice(bytesFromStr(tx), len(c.root) + 1, len(tx) - len(c.root) - 1)) catch tx;
        }
        const cl = classify(tx);
        let reason = cl.reason;
        if (len(reason) == 0) {
            reason = skipReason(tx, host, arch);
        }
        let argv: List<string> = listNew();
        const a = companion(tx, ".argv");
        if (a != None) {
            let body = a ?? "";
            while (endsWith(body, "\n")) {
                body = bytesToStr(bytesSlice(bytesFromStr(body), 0, len(body) - 1)) catch "";
            }
            for (line in strSplit(body, "\n")) {
                let l = line;
                while (endsWith(l, "\r")) {
                    l = bytesToStr(bytesSlice(bytesFromStr(l), 0, len(l) - 1)) catch "";
                }
                listPush(argv, l);
            }
            if (len(reason) == 0) {
                for (x in argv) {
                    const flag = listGet(strSplit(x, "="), 0) catch "";
                    for (rf in RETIRED_FLAGS) {
                        if (flag == rf) {
                            reason = "retired-cli-flag-in-argv";
                        }
                    }
                }
            }
        }
        const caseRows: List<Ref<Jv>> = listNew();
        if (len(reason) > 0) {
            const row = jObject();
            jSet(row, "case", jString(name));
            jSet(row, "status", jString("SKIP"));
            jSet(row, "reason", jString(reason));
            listPush(caseRows, row);
        } else {
            for (s in cl.specs) {
                listPush(caseRows, runSpec(c, tx, name, s, argv));
            }
        }
        for (row in caseRows) {
            const status = jText(jGet(row, "status")) ?? "";
            bump(counts, status);
            jPush(rows, row);
            let line = padRight(status, 5) + " " + (jText(jGet(row, "case")) ?? "");
            if (status == "FAIL") {
                line = line + "  " + reprStr(headChars(jText(jGet(row, "detail")) ?? "", 200));
            }
            print(line);
        }
    }
    if (listLen(explicit) == 0) {
        const extra: List<XRow> = listNew();
        explainRows(c, extra);
        testOptionRows(c, extra);
        stdlibRootRows(c, extra);
        guiRootRows(c, extra);
        debugBuildRows(c, extra);
        libBuildRows(c, extra);
        heapCheckRows(c, extra);
        ffiMemReportRows(c, extra);
        toolRows(c, extra);
        pathRows(c, extra);
        for (x in extra) {
            const row = jObject();
            jSet(row, "case", jString(x.name));
            let status = "PASS";
            if (x.state == -1) {
                status = "SKIP";
                jSet(row, "status", jString(status));
                jSet(row, "reason", x.detail);
            } else {
                if (x.state == 0) {
                    status = "FAIL";
                }
                jSet(row, "status", jString(status));
                jSet(row, "detail", x.detail);
            }
            bump(counts, status);
            jPush(rows, row);
            let line = padRight(status, 5) + " " + x.name;
            if (x.state == 0) {
                line = line + "  " + pyRepr(x.detail);
            }
            print(line);
        }
    }
    let summary = "SUMMARY ";
    let first = true;
    for (k in sorted(counts.keys)) {
        if (!first) {
            summary = summary + " ";
        }
        summary = summary + k + "=" + toStr(mapGet(counts.n, k) ?? 0);
        first = false;
    }
    print(summary);
    if (len(reportPath) > 0) {
        const doc = jObject();
        jSet(doc, "compiler", jString(c.compiler));
        jSet(doc, "rows", rows);
        const cj = jObject();
        for (k in counts.keys) {
            jSet(cj, k, jNumber(mapGet(counts.n, k) ?? 0));
        }
        jSet(doc, "counts", cj);
        writeFile(reportPath, jPretty(doc, 1) + "\n") catch (e) {
            eprint("写不了报告 " + reportPath + "：" + e.message);
            return 1;
        };
    }
    if ((mapGet(counts.n, "FAIL") ?? 0) > 0) {
        return 1;
    }
    return 0;
}
