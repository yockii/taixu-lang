import { fioRead, fioTake, fioAtEof, fioError } from "../../bootstrap/selfhost/frame_io";
const HEX = "0123456789abcdef";
function main(args: []string): int {
    while (true) {
        const b = fioTake(128);
        if (bytesLen(b) > 0) {
            const out = bytesNew(0); let i = 0;
            while (i < bytesLen(b)) {
                const c = bytesGet(b, i) catch 0;
                bytesPush(out, byteAt(HEX, c / 16) catch 0); bytesPush(out, byteAt(HEX, c % 16) catch 0); i = i + 1;
            }
            print("BODY " + (bytesToStr(out) catch "bad"));
        } else if (len(fioError()) > 0) { print("ERROR " + fioError()); return 3; }
        else if (fioAtEof()) { return 0; }
        else { fioRead(-1); if (len(args) > 0) { print("READ"); } }
    }
    return 0;
}
