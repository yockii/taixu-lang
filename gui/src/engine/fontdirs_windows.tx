// engine/fontdirs_windows —— Windows 的系统字体目录：%WINDIR%\Fonts（全机安装）与
// %LOCALAPPDATA%\Microsoft\Windows\Fonts（当前用户安装，Windows 10 1809 起）。两处都不递归。
import { getenv } from "std/os";

export function fontDirs(): List<string> {
    const out: List<string> = listNew();
    let win: string = getenv("WINDIR");
    if (len(win) == 0) {
        win = "C:/Windows";
    }
    listPush(out, win + "/Fonts");
    const local: string = getenv("LOCALAPPDATA");
    if (len(local) > 0) {
        listPush(out, local + "/Microsoft/Windows/Fonts");
    }
    return out;
}
