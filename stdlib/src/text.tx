// ============================================================================
// std/text —— 文本工具（扩批）。
//
// 与 std/string 的分工：string.tx＝查找/切分/大小写（字符面）；text.tx＝
// 版面与统计（填充/截断/缩进/行列计数——展示层预处理面）。全部确定性。
//
// 2026-11-04（D3 v0.52）：padStart／padEnd／truncate 的宽度改按显示列宽——东亚宽度为宽（W、F）
// 的字符占 2 列，组合符号等零宽字符与控制字符占 0 列，其余（含宽度不定的 A 类）占 1 列，同 wcwidth；切点只在
// 字符边界，零宽字符随前面的字符留下。按码点计，不合成字素簇（emoji 的 ZWJ 序列按各码点之和）。宽度表在
// text_width.tx（生成文件）。协议、定长字段等按字节计的场合用 padStartBytes／padEndBytes／truncateBytes
// （即此前的语义：宽度按字节，切点向下取到字符边界，结果恒为合法 UTF-8）。
// ============================================================================

import { split } from "./string";
import { ZERO_WIDTH, WIDE } from "./text_width";

// repeat：s 重复 n 次（n <= 0 → 空串）。
export function repeat(s: string, n: int): string {
    let out: string = "";
    let i: int = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// startsWith／endsWith：前后缀判定（字节序列；len 语义与 string.tx 一致）。
export function startsWith(s: string, prefix: string): bool {
    const m = len(prefix);
    if (m > len(s)) {
        return false;
    }
    return bytesEqualAt(s, 0, prefix);
}

export function endsWith(s: string, suffix: string): bool {
    const m = len(suffix);
    const n = len(s);
    if (m > n) {
        return false;
    }
    return bytesEqualAt(s, n - m, suffix);
}

// s 从字节 at 起是否逐字节等于 part（调用方保证不越界）。
function bytesEqualAt(s: string, at: int, part: string): bool {
    let i: int = 0;
    while (i < len(part)) {
        if ((byteTryAt(s, at + i) catch -1) != (byteTryAt(part, i) catch -2)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// codepointWidth：一个码点占的显示列数（0、1 或 2，见文件头）。不是合法码点的按 1。
export function codepointWidth(cp: int): int {
    if (cp < 0x20 || (cp >= 0x7F && cp < 0xA0)) {
        return 0;
    }
    if (cp < 0x300) {
        return 1;
    }
    if (cp >= 0x4E00 && cp <= 0x9FFF) {
        return 2;
    }
    if (inRanges(ZERO_WIDTH, cp)) {
        return 0;
    }
    if (inRanges(WIDE, cp)) {
        return 2;
    }
    return 1;
}

// displayWidth：s 在等宽排版（终端等）里占的列数，即各码点的 codepointWidth 之和。
export function displayWidth(s: string): int {
    let w: int = 0;
    for (c in s) {
        w = w + codepointWidth(c);
    }
    return w;
}

// 区间表（text_width.tx：每段 12 个十六进制字符，起点、终点各 6 位，升序）里有没有 cp。
function inRanges(t: string, cp: int): bool {
    let lo: int = 0;
    let hi: int = len(t) / 12 - 1;
    while (lo <= hi) {
        const mid = (lo + hi) / 2;
        if (cp < hexField(t, mid * 12)) {
            hi = mid - 1;
        } else if (cp > hexField(t, mid * 12 + 6)) {
            lo = mid + 1;
        } else {
            return true;
        }
    }
    return false;
}

function hexField(t: string, at: int): int {
    let v: int = 0;
    let i: int = at;
    while (i < at + 6) {
        const c = byteAt(t, i);
        if (c <= '9') {
            v = v * 16 + (c - '0');
        } else {
            v = v * 16 + (c - 'A' + 10);
        }
        i = i + 1;
    }
    return v;
}

// s 开头不超过 cols 列的最长一段：切点只在字符边界，紧跟的零宽字符随前面的字符留下。
function headCols(s: string, cols: int): string {
    let used: int = 0;
    for (i, c in s) {
        const cw = codepointWidth(c);
        if (used + cw > cols) {
            return strSlice(s, 0, i);
        }
        used = used + cw;
    }
    return s;
}

// 填满 cols 列：pad 依次重复，最后一份按列截取，放不下的宽字符以空格补齐（结果恰为 cols 列）；
// cols <= 0 或 pad 为空、零宽时得空串。
function fillCols(cols: int, pad: string): string {
    const pw = displayWidth(pad);
    if (cols <= 0 || pw == 0) {
        return "";
    }
    let fill: string = "";
    let used: int = 0;
    while (used + pw <= cols) {
        fill = fill + pad;
        used = used + pw;
    }
    const part = headCols(pad, cols - used);
    return fill + part + repeat(" ", cols - used - displayWidth(part));
}

// padStart／padEnd：按显示列宽填充到 width 列（s 本身不窄于 width 则原样；pad 为空或零宽时原样）。
export function padStart(s: string, width: int, pad: string): string {
    return fillCols(width - displayWidth(s), pad) + s;
}

export function padEnd(s: string, width: int, pad: string): string {
    return s + fillCols(width - displayWidth(s), pad);
}

// truncate：超过 max 列时截断并追加 suffix（suffix 计入宽度；max 不够放 suffix 时只取 suffix 的开头）；
// 不超宽原样。结果不超过 max 列。
export function truncate(s: string, max: int, suffix: string): string {
    if (displayWidth(s) <= max) {
        return s;
    }
    const sw = displayWidth(suffix);
    if (max <= sw) {
        return headCols(suffix, max);
    }
    return headCols(s, max - sw) + suffix;
}

// s 的前 n 个字节，切点向下取到字符边界（结果字节数 ≤ n，恒为合法 UTF-8）。
function byteHead(s: string, n: int): string {
    let k: int = n;
    if (k >= len(s)) {
        return s;
    }
    if (k <= 0) {
        return "";
    }
    while (k > 0 && byteAt(s, k) >= 128 && byteAt(s, k) < 192) {
        k = k - 1;
    }
    return strSlice(s, 0, k);
}

// padStartBytes／padEndBytes：按字节填充到 width 字节（协议、定长字段用；s 本身更宽则原样，pad 空串时原样；
// 最后一份 pad 的切点向下取到字符边界，放不下整字则不填）。
export function padStartBytes(s: string, width: int, pad: string): string {
    const n = len(s);
    if (n >= width || len(pad) == 0) {
        return s;
    }
    let fill: string = "";
    while (len(fill) < width - n) {
        fill = fill + pad;
    }
    return byteHead(fill, width - n) + s;
}

export function padEndBytes(s: string, width: int, pad: string): string {
    const n = len(s);
    if (n >= width || len(pad) == 0) {
        return s;
    }
    let fill: string = "";
    while (len(fill) < width - n) {
        fill = fill + pad;
    }
    return s + byteHead(fill, width - n);
}

// truncateBytes：超过 max 字节时截断并追加 suffix（suffix 计入；不超宽原样）。切点取字符边界，结果字节数 ≤ max。
export function truncateBytes(s: string, max: int, suffix: string): string {
    const m = len(suffix);
    if (len(s) <= max) {
        return s;
    }
    if (max <= m) {
        return byteHead(suffix, max);
    }
    return byteHead(s, max - m) + suffix;
}

// indent：逐行加前缀（按 '\n' 分行后重接——空行也缩进）。
export function indent(s: string, prefix: string): string {
    const lines = split(s, "\n");
    let out: string = "";
    let i: int = 0;
    while (i < listLen(lines)) {
        if (i > 0) {
            out = out + "\n";
        }
        out = out + prefix + (listTryGet(lines, i) catch "");
        i = i + 1;
    }
    return out;
}

// lineCount：行数（'\n' 计数＋1；空串为 1——空内容也算一行）。
export function lineCount(s: string): int {
    let n: int = 1;
    let i: int = 0;
    while (i < len(s)) {
        if ((byteTryAt(s, i) catch 0) == '\n') {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// wordCount：词数（ASCII 空白分隔——空格/\t/\r/\n；连续空白计一段）。
export function wordCount(s: string): int {
    let count: int = 0;
    let inWord: bool = false;
    let i: int = 0;
    while (i < len(s)) {
        const ch = byteTryAt(s, i) catch 32;
        const isWs = ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n';
        if (isWs) {
            inWord = false;
        } else {
            if (!inWord) {
                count = count + 1;
            }
            inWord = true;
        }
        i = i + 1;
    }
    return count;
}
