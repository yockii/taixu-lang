function outside(n: int): int {
    print("outside head"); let i = 0;
    while (i < n) { i = i + 1; }
    print("outside tail"); return i;
}
function inside(n: int): int {
    let i = 0;
    while (i < n) { print("inside"); i = i + 1; }
    return i;
}
function nested(n: int): int {
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < 2) { print("nested"); j = j + 1; }
        i = i + 1;
    }
    return i;
}
function twoLoops(n: int): int {
    let i = 0; while (i < n) { print("first"); i = i + 1; }
    let j = 0; while (j < n) { j = j + 1; }
    return j;
}
function main(args: []string): int {
    print(toStr(outside(3))); print(toStr(inside(2))); print(toStr(nested(1))); print(toStr(twoLoops(1)));
    return 0;
}
