// D3 v0.22：生成器运行中再对它取值（体内间接对自身 genNext）是运行期 trap（退出码 3）。
let self: List< Gen< int>> = listNew();

function* selfish(): int {
    yield 1;
    const me = listGet(self, 0) catch panic("unreachable");
    print("re-entering");
    const v = genNext(me) catch -1;
    yield v;
}

export function main(args: []string): int {
    const g = selfish();
    listPush(self, g);
    print(toStr(genNext(g) catch -1));
    print(toStr(genNext(g) catch -1));
    print("unreachable");
    return 0;
}
