export function main(args: []string): int {
    list_i8();
    list_i16();
    list_i32();
    list_u8();
    list_u16();
    list_u32();
    list_f32();
    const ws: List< u16> = listNew();
    const w0: u16 = 1;
    const w1: u16 = 65535;
    const w2: u16 = 300;
    listPush(ws, w0);
    listPush(ws, w1);
    listPush(ws, w2);
    const rw = rev(ws);
    print("rev " + toStr(listGet(rw, 0) catch w0) + " " + toStr(listGet(rw, 1) catch w0) + " " + toStr(listGet(rw, 2) catch w0) + " " + toStr(listLen(rw)));
    const fs: List< f32> = listNew();
    const g0: f32 = 0.1;
    const g1: f32 = -2.5;
    listPush(fs, g0);
    listPush(fs, g1);
    const rf = rev(fs);
    print("revf " + toStr(listGet(rf, 0) catch g0) + " " + toStr(listGet(rf, 1) catch g0));
    const outer: List< List< u8>> = listNew();
    let k = 0;
    while (k < 3) {
        const inner: List< u8> = listNew();
        let j = 0;
        while (j < 10 + k * 7) {
            listPush(inner, ((j * 37 + k) % 256) as u8);
            j = j + 1;
        }
        listPush(outer, inner);
        k = k + 1;
    }
    let nest = "nest";
    for (inner in outer) {
        let s = 0;
        for (x in inner) {
            s = s + x;
        }
        nest = nest + " " + toStr(listLen(inner)) + ":" + toStr(s);
    }
    print(nest);
    const px = new Pix { w: 2, data: listNew() };
    const d0: u16 = 40000;
    const d1: u16 = 7;
    listPush(px.data, d0);
    listPush(px.data, d1);
    listSet(px.data, 0, d1);
    print("pix " + toStr(px.w) + " " + toStr(listLen(px.data)) + " " + toStr(listGet(px.data, 0) catch d0) + " " + toStr(listGet(px.data, 1) catch d0));
    const big: List< u8> = listNew();
    let i = 0;
    while (i < 100000) {
        listPush(big, (i % 251) as u8);
        i = i + 1;
    }
    const zb: u8 = 0;
    let bs = 0;
    i = 0;
    while (i < listLen(big)) {
        bs = bs + (listGet(big, i) catch zb);
        i = i + 1;
    }
    print("big " + toStr(listLen(big)) + " " + toStr(bs));
    const nums: List< u32> = listNew();
    const q0: u32 = 922725035;
    listPush(nums, q0);
    const q1: u32 = 2664156963;
    listPush(nums, q1);
    const q2: u32 = 157013726;
    listPush(nums, q2);
    const q3: u32 = 19333849;
    listPush(nums, q3);
    const q4: u32 = 442544779;
    listPush(nums, q4);
    const q5: u32 = 3685305800;
    listPush(nums, q5);
    const q6: u32 = 1818527200;
    listPush(nums, q6);
    const q7: u32 = 91988545;
    listPush(nums, q7);
    const q8: u32 = 2692558422;
    listPush(nums, q8);
    const q9: u32 = 3524259396;
    listPush(nums, q9);
    const q10: u32 = 1510088846;
    listPush(nums, q10);
    const q11: u32 = 1405164159;
    listPush(nums, q11);
    const t1 = threadSpawn((): int => sumU32(nums));
    print("thread sum " + toStr(threadJoin(t1) catch -1) + " main " + toStr(sumU32(nums)));
    const t2 = threadSpawn((): List< i16> => {
        const r: List< i16> = listNew();
        let n = 0;
        while (n < 5) {
            listPush(r, (n * -1000) as i16);
            n = n + 1;
        }
        return r;
    });
    const empty: List< i16> = listNew();
    const back = threadJoin(t2) catch empty;
    let tb = "thread back";
    for (x in back) {
        tb = tb + " " + toStr(x);
    }
    print(tb);
    const sh = sharedNew(nums);
    const view = sharedGet(sh);
    const t3 = threadSpawn((): int => sumU32(sharedGet(sh)));
    print("shared " + toStr(listLen(view)) + " " + toStr(listGet(view, 11) catch q0) + " " + toStr(sumU32(view)) + " " + toStr(threadJoin(t3) catch -1));
    return 0;
}
