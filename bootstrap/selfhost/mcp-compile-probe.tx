// MCP 兼容摘要的开发对照：只为测试写出内部编码，不提供 VM 或公开产物命令。
import { drvCompile, drvDiagOut, drvBytesOut, drvSetPrelude } from "./driver";

function main(args: []string): int {
    if (len(args) != 2) { return 64; }
    drvSetPrelude(bytesToStr(embedBytes("../../prelude/collections.tx")) catch "");
    if (drvCompile(args[0], 0) != 0) { eprint(drvDiagOut()); return 1; }
    writeFileBytes(args[1], drvBytesOut()) catch (e) { eprint(e.message); return 1; };
    return 0;
}
