// 运行期内建名表：BuiltinId → 内核处理例程名后缀（__tx_bi_<名>；bc.BuiltinId @tagName 同表）。
// driver 按程序用到的内建发射 __tx_bi_table（从 driver.tx 拆出，D3 v0.23 起含 ffi_last_error）。

// callbi 编号空间（TXC v6，容量与编码上限评估 §八）：内建 0..4095、外部函数从 EXTERN_ID_BASE 起。
// 程序的内建表 __tx_bi_table 只有 BI_TABLE_LEN 项（须 > MAX_BUILTIN_ID）；内核 __tx_callbi 查表前按它做界检查。
export const EXTERN_ID_BASE: int = 4096;
export const BI_TABLE_LEN: int = 99;
// __rt 内部内建（2c）：RT_BI_BASE..RT_BI_BASE+RT_BI_COUNT-1，只供标准库模块；不进程序的内建表，
// 内核 __tx_callbi 按编号直接分派到 __tx_bi_<rtBiName>。
export const RT_BI_BASE: int = 2048;
export const RT_BI_COUNT: int = 7;
// 调试检查点：只出现在 --debug 构建里，源码不可写；不写目标槽、不带实参，
// 发射器直调程序对象里的 __tx_dbg_<dbgBiName>，不进内建表、不经内核。
export const DBG_BI_BASE: int = 3072;
export const DBG_BI_COUNT: int = 4;
export const DBG_ENTER: int = 3072;
export const DBG_STMT: int = 3073;
export const DBG_LEAVE: int = 3074;
export const DBG_RESUME: int = 3075;

// 外部内存区按外部结构体布局的读写（D3 v0.48 §6.8-22）：ffiMemGet、ffiMemSet 发 callbi FMEM_GET／FMEM_SET，末个实参是布局序；
// 发射器直调程序对象里的 __tx_ffimem_get／__tx_ffimem_set（同工具链例程，参数同 __tx_callbi），例程按程序用到的布局生成
// （ffi_stubs.tx 的 ffiMemEmitRoutines），不进内建表、不经内核。
export const FMEM_GET: int = 3076;
export const FMEM_SET: int = 3077;

export function isFmemBi(id: int): bool {
    return id == FMEM_GET || id == FMEM_SET;
}

export function fmemBiName(id: int): string {
    if (id == FMEM_GET) { return "get"; }
    if (id == FMEM_SET) { return "set"; }
    return "";
}

export function isDbgBi(id: int): bool {
    return id >= DBG_BI_BASE && id < DBG_BI_BASE + DBG_BI_COUNT;
}

export function dbgBiName(id: int): string {
    if (id == DBG_ENTER) { return "enter"; }
    if (id == DBG_STMT) { return "stmt"; }
    if (id == DBG_LEAVE) { return "leave"; }
    if (id == DBG_RESUME) { return "resume"; }
    return "";
}

// 工具链进程与标准输入内建：仅 --toolchain，sema 序数即运行期编号；
// 发射器直调程序对象里的 __tx_tool_<toolBiName>，例程只在程序用到时生成，不进内建表、不经内核。3593 currentDir 为增补。
export const TOOL_BI_BASE: int = 3584;
// 3600 起为增补（localListDir）；号段扩到 32 个。
export const TOOL_BI_COUNT: int = 32;

export function isToolBi(id: int): bool {
    return id >= TOOL_BI_BASE && id < TOOL_BI_BASE + TOOL_BI_COUNT;
}

export function toolBiName(id: int): string {
    if (id == 3584) { return "stdin_read"; }
    if (id == 3585) { return "stdout_write"; }
    if (id == 3586) { return "proc_spawn"; }
    if (id == 3595) { return "proc_spawn_limited"; }
    if (id == 3587) { return "proc_write"; }
    if (id == 3599) { return "proc_try_write"; }
    if (id == 3588) { return "proc_read"; }
    if (id == 3589) { return "io_wait"; }
    if (id == 3590) { return "proc_kill"; }
    if (id == 3591) { return "proc_wait"; }
    if (id == 3592) { return "proc_close"; }
    if (id == 3593) { return "current_dir"; }
    if (id == 3594) { return "file_size"; }
    if (id == 3596) { return "read_local_file_bytes"; }
    if (id == 3597) { return "local_entry_kind"; }
    if (id == 3598) { return "local_file_size"; }
    if (id == 3600) { return "local_list_dir"; }
    return "";
}

export function rtBiName(id: int): string {
    if (id == 2048) { return "rt_handle_add"; }
    if (id == 2049) { return "rt_handle_peek"; }
    if (id == 2050) { return "rt_handle_take"; }
    if (id == 2051) { return "rt_env_get"; }
    if (id == 2052) { return "rt_env_set"; }
    if (id == 2053) { return "rt_arg_count"; }
    if (id == 2054) { return "rt_arg_at"; }
    return "";
}

export function biName(id: int): string {
    // BuiltinId 序数→shim handler 名（bc.BuiltinId @tagName 同表）。
    if (id == 1) { return "print"; }
    if (id == 2) { return "errf"; }
    if (id == 3) { return "read_file"; }
    if (id == 4) { return "len"; }
    if (id == 5) { return "to_str"; }
    if (id == 6) { return "unref"; }
    if (id == 7) { return "assertf"; }
    if (id == 8) { return "panicf"; }
    if (id == 9) { return "weak"; }
    if (id == 10) { return "deref"; }
    if (id == 11) { return "byte_at"; }
    if (id == 12) { return "utf8_encode"; }
    if (id == 13) { return "list_new"; }
    if (id == 14) { return "list_push"; }
    if (id == 15) { return "list_pop"; }
    if (id == 16) { return "list_get"; }
    if (id == 17) { return "list_set"; }
    if (id == 18) { return "list_len"; }
    if (id == 19) { return "str_concat"; }
    if (id == 20) { return "task_cancel"; }
    if (id == 21) { return "task_cancelled"; }
    if (id == 22) { return "task_await_any"; }
    if (id == 23) { return "write_file"; }
    if (id == 24) { return "now_ms"; }
    if (id == 25) { return "sleep_ms"; }
    if (id == 26) { return "list_remove_at"; }
    if (id == 27) { return "list_insert"; }
    if (id == 28) { return "str_sub"; }
    if (id == 29) { return "str_index_of"; }
    if (id == 30) { return "str_split"; }
    if (id == 31) { return "eprint"; }
    if (id == 32) { return "list_dir"; }
    if (id == 33) { return "entry_kind"; }
    if (id == 34) { return "write_file_bytes"; }
    if (id == 35) { return "make_dir"; }
    if (id == 36) { return "write_executable"; }
    // D3 v0.18 新增 Bytes（37..47）。
    if (id == 37) { return "bytes_new"; }
    if (id == 38) { return "bytes_len"; }
    if (id == 39) { return "bytes_get"; }
    if (id == 40) { return "bytes_set"; }
    if (id == 41) { return "bytes_push"; }
    if (id == 42) { return "bytes_append"; }
    if (id == 43) { return "bytes_slice"; }
    if (id == 44) { return "bytes_equal"; }
    if (id == 45) { return "bytes_from_str"; }
    if (id == 46) { return "bytes_to_str"; }
    if (id == 47) { return "read_file_bytes"; }
    // D3 v0.19 结构化错误（48..52）。
    if (id == 48) { return "err_as"; }
    if (id == 49) { return "err_wrap"; }
    if (id == 50) { return "err_rich"; }
    if (id == 51) { return "err_payload"; }
    if (id == 52) { return "err_cause"; }
    // D3 v0.21 工具链系统内建（53..59；仅 --toolchain）。
    if (id == 53) { return "host_target"; }
    if (id == 54) { return "get_env"; }
    if (id == 55) { return "run_process"; }
    if (id == 56) { return "temp_dir"; }
    if (id == 57) { return "remove_file"; }
    if (id == 58) { return "self_exe_path"; }
    if (id == 59) { return "mono_ns"; }
    // D3 v0.23 FFI：最近一次外部函数调用后保存的系统错误码。
    if (id == 60) { return "ffi_last_error"; }
    // 线程第 2 步。
    if (id == 61) { return "thread_spawn"; }
    if (id == 62) { return "thread_join"; }
    // 线程第 4c 步：Shared 与 Atomic。
    if (id == 63) { return "shared_new"; }
    if (id == 64) { return "shared_get"; }
    if (id == 65) { return "atomic_new"; }
    if (id == 66) { return "atomic_load"; }
    if (id == 67) { return "atomic_store"; }
    if (id == 68) { return "atomic_add"; }
    if (id == 69) { return "atomic_cas"; }
    // toStr(f32)（codegen 按实参的静态类型直发）。
    if (id == 70) { return "f32_str"; }
    // 紧凑列表的 listGet/listSet/listLen（codegen 按静态类型发出，发射器单设内联臂）；运行期同 16/17/18。
    if (id == 71) { return "list_get"; }
    if (id == 72) { return "list_set"; }
    if (id == 73) { return "list_len"; }
    // Bytes 与 List<u8> 零拷贝互转。
    if (id == 74) { return "bytes_as_list"; }
    if (id == 75) { return "list_as_bytes"; }
    // 工具链内建 hostArch。
    if (id == 76) { return "host_arch"; }
    // D3 v0.37 Bytes 批量操作；定宽读写的种类码由代码生成作末个实参。
    if (id == 77) { return "bytes_copy"; }
    if (id == 78) { return "bytes_fill"; }
    if (id == 79) { return "bytes_get_num"; }
    if (id == 80) { return "bytes_set_num"; }
    // D3 v0.42：工具链内建 setEnv（与 getEnv 同一张环境表）。
    if (id == 81) { return "set_env"; }
    // D3 v0.44 字符串的字节面：strByteSub、strByteIndexOf。
    if (id == 82) { return "str_byte_sub"; }
    if (id == 83) { return "str_byte_index_of"; }
    // D3 v0.48 外部内存区：ffiMem 与按字节的读写、读串、提前结束；91 是代码生成在创建区的函数出口发出的弹栈，
    // 不是源码可写的内建。ffiMemOf、ffiMemGet、ffiMemSet 另走程序映像例程。
    if (id == 84) { return "ffi_mem"; }
    if (id == 85) { return "ffi_mem_read"; }
    if (id == 86) { return "ffi_mem_read_into"; }
    if (id == 87) { return "ffi_mem_write"; }
    if (id == 88) { return "ffi_mem_utf16"; }
    if (id == 89) { return "ffi_mem_utf8"; }
    if (id == 90) { return "ffi_mem_end"; }
    if (id == 91) { return "ffi_mem_leave"; }
    // D3 v0.51：越界即 trap 的 listGet、listPop、byteAt（非 --toolchain 构建）。代码生成先走 list_get／list_pop／
    // byte_at（含内联快路径），只在得 None 时（元素非可空，None 只可能来自越界）转到这里报 4002；元素本身可空时直接调这里。
    if (id == 92) { return "list_get_strict"; }
    if (id == 93) { return "list_pop_strict"; }
    if (id == 94) { return "byte_at_strict"; }
    // D3 v0.52：strSlice（字节区间 [from, to)）、字符串 for-in 解糖的逐字符解码（字节偏移处的码点、下一字符的
    // 偏移）、strCompare（按字节字典序）。strFind 复用 str_byte_index_of（83）。
    if (id == 95) { return "str_slice"; }
    if (id == 96) { return "str_cp_at"; }
    if (id == 97) { return "str_cp_end"; }
    if (id == 98) { return "str_compare"; }
    // imul 是直发 opcode 47，不是内建。
    return "";
}
