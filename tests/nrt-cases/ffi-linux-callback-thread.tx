// 第 5 轮 FFI（D3 v0.23，Linux）：回调只能在太虚运行时所在的线程上被调用——pthread_create 让新线程
// 调用回调，蹦床 trap 4020（ffi_callback），位置报在回调函数开头；主线程此时停在 pthread_join。
declare function pthread_create(thread: Bytes, attr: usize, start: (usize) => usize, arg: usize): i32 from "libc.so.6";
declare function pthread_join(thread: u64, ret: usize): i32 from "libc.so.6";

function worker(p: usize): usize {
    print("worker should not run");
    return 0;
}

function main(args: []string): int {
    print("start");
    const t = bytesNew(8);
    if (pthread_create(t, 0, worker, 0) == 0) {
        let id = 0;
        let i = 7;
        while (i >= 0) {
            id = id * 256 + (bytesGet(t, i) catch 0);
            i = i - 1;
        }
        pthread_join(id as u64, 0);
    }
    print("unreachable");
    return 0;
}
