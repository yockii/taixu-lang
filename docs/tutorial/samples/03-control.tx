// 03 控制流：条件必须 bool、while/for/for-in、switch 表达式。
function main(args: []string): int {
    let acc: int = 0;
    let i: int = 1;
    while (i <= 10) {
        if (i % 2 == 0) {
            acc = acc + i;
        }
        i = i + 1;
    }
    print("even-sum:" + toStr(acc));

    for (let j = 0; j < 3; j = j + 1) {
        print("for:" + toStr(j));
    }

    // for-in：List 按下标顺序迭代
    const xs: List<int> = listNew();
    listPush(xs, 7);
    listPush(xs, 8);
    for (v in xs) {
        print("got:" + toStr(v));
    }
    return 0;
}
