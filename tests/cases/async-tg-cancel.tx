// V0.10-A1 e2e：TaskGroup.cancel 组级取消传播（D29 §三）——登记序遍历
// taskCancel；cancel 后 drain 必达零 pending（结构化闭环断言）。
import { taskGroupNew, taskGroupAdd, taskGroupDrain, taskGroupCancel, taskGroupFailed } from "std/task";

function main(args: []string): int {
    const t = runner();
    print("spawned");
    return 0;
}

async function runner(): int {
    const tg = taskGroupNew();
    taskGroupAdd(tg, stalled(1));
    taskGroupAdd(tg, stalled(2));
    taskGroupAdd(tg, stalled(3));
    taskGroupCancel(tg) catch (e) {
        print("cancel err: " + e.message);
        return 0;
    };
    const rs = await taskGroupDrain(tg, 2) catch (e) {
        print("drain err: " + e.message);
        return 0;
    };
    print("drained=" + toStr(listLen(rs)) + " failed=" + toStr(taskGroupFailed(tg)));
    return 0;
}

async function stalled(n: int): int {
    const s = sleepMs(60000);
    await s catch (e) {
        return err(e.message);
    };
    return n;
}
