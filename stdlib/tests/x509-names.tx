import { x509ParseCertificate } from "std/x509";
import { x509SubjectAltNames, x509VerifyHostname } from "std/x509_names";
import { p256Hex } from "std/crypto/p256_field";
import { X509Certificate } from "std/x509_types";

function hostnameError(cert: Ref<X509Certificate>, host: string): bool { x509VerifyHostname(cert, host) catch (e) { return true; }; return false; }

test "X.509 身份：独立证书、SAN、单标签通配符与 CN 禁回退" {
    const fixture = readFile("tests/vectors/x509-hostnames.txt") catch panic("hostname fixture"); let matched = 0; let missed = 0; let errors = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const kind = listGet(p, 0); const host = listGet(p, 1);
        const cert = x509ParseCertificate(p256Hex(listGet(p, 2))) catch panic("parse identity certificate");
        if (kind == "error") {
            assert(hostnameError(cert, host), "reference or SAN rejected " + host); errors = errors + 1;
        } else {
            const actual = x509VerifyHostname(cert, host) catch (e) { panic(host + ": " + e.message); };
            if (kind == "match") { assert(actual, "match " + host); matched = matched + 1; }
            else { assert(kind == "miss" && !actual, "mismatch " + host); missed = missed + 1; }
        }
    }
    assert(matched == 10 && missed == 11 && errors == 11, "complete hostname vectors");
}

test "X.509 SAN：DNS 与 IP 不合并" {
    const fixture = readFile("tests/vectors/x509-hostnames.txt") catch panic("hostname fixture"); let checked = false;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const cert = x509ParseCertificate(p256Hex(listGet(p, 2))) catch panic("parse");
        const names = x509SubjectAltNames(cert) catch panic("SAN");
        assert(listLen(names.dns) == 2 && listLen(names.ips) == 2 && bytesLen(listGet(names.ips, 0)) == 4 && bytesLen(listGet(names.ips, 1)) == 16, "typed identities");
        checked = true; break;
    }
    assert(checked, "SAN fixture selected");
}
