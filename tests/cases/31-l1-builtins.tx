// 内建正向全景：List 删除/插入＋string 子串/查找/分割。D3 v0.52 起子串与查找
// 按字节（strSlice／strFind，取代按码点的 strSub／strIndexOf）。
export function main(args: []string): int {
    // —— listRemoveAt / listInsert（省掉 todo 删行的样板代码）——
    const xs: List<int> = listNew();
    let i: int = 0;
    while (i < 5) {
        listPush(xs, i * 10);
        i = i + 1;
    }
    listRemoveAt(xs, 2); // [0,10,30,40]
    listInsert(xs, 1, 99); // [0,99,10,30,40]
    let acc: int = 0;
    i = 0;
    while (i < listLen(xs)) {
        acc = acc * 100 + (listTryGet(xs, i) catch -1);
        i = i + 1;
    }
    print(toStr(acc)); // 099103040 → 99103040
    listInsert(xs, listLen(xs), 50); // 尾加位（i==len）
    print(toStr(listTryGet(xs, 5) catch -1)); // 50

    // —— strSlice / strFind / strSplit（按字节：é 2 字节、汉字 3 字节）——
    const s: string = "héllo世界";
    print(strSlice(s, 1, 6)); // éllo（字节 [1, 6)）
    print(toStr(strFind(s, "界"))); // 9（字节下标）
    print(toStr(strFind(s, "zz"))); // -1（缺席）
    print(toStr(strFind(s, ""))); // 0（空针）
    const parts: List<string> = strSplit("a,太,虚,c", ",");
    print(toStr(listLen(parts))); // 4
    print(strSlice(listTryGet(parts, 1) catch "", 0, 3)); // 太
    const bare: List<string> = strSplit("x,,y", ",");
    print(toStr(len(listTryGet(bare, 1) catch "?"))); // 0（连续分隔符产空片——len 为字节长）
    return 0;
}
