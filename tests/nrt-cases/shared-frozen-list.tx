// 线程第 4c 步：冻结的 List（来自 Shared）上 listPush 即 trap 4022；读照常。
function main(args: []string): void {
    const xs: List< int> = listNew();
    listPush(xs, 1);
    listPush(xs, 2);
    const s = sharedNew(xs);
    const ys = sharedGet(s);
    print(toStr(listLen(ys)) + " " + toStr(listGet(ys, 1) catch -1));
    listPush(ys, 3);
    print("unreachable");
}
