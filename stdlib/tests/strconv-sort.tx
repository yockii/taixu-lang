// std/strconv＋std/sort 验证。
import { abs } from "std/math";
import { parseInt, parseFloat, formatInt, formatFloat, formatFloatF } from "std/strconv";
import { sortInt, sortFloat, sortString } from "std/sort";

test "strconv：parse/format 往返" {
    assert((parseInt("42") catch -1) == 42, "p42");
    assert((parseInt("-17") catch 1) == -17, "pneg");
    assert((parseInt("bad") catch 99) == 99, "perr");
    assert((parseInt("") catch 7) == 7, "pempty");
    assert(abs((parseFloat("3.25") catch 0.0) - 3.25) < 0.0000001, "pf");
    assert((parseFloat("x") catch 5.0) == 5.0, "pferr");
    assert((formatInt(255, 16) catch "?") == "ff", "f16");
    assert((formatInt(-10, 2) catch "?") == "-1010", "f2neg");
    assert(formatFloat(1.5) == "1.5", "ff");
    assert(formatFloatF(3.14159, 2) == "3.14", "fff");
}

test "sort：三族稳定排序" {
    const xs: List<int> = listNew();
    listPush(xs, 3); listPush(xs, 1); listPush(xs, 2); listPush(xs, 1);
    sortInt(xs);
    assert((listTryGet(xs, 0) catch 9) == 1 && (listTryGet(xs, 1) catch 9) == 1 && (listTryGet(xs, 3) catch 9) == 3, "sortInt");

    const fs: List<float> = listNew();
    listPush(fs, 2.5); listPush(fs, 0.5); listPush(fs, 1.5);
    sortFloat(fs);
    assert((listTryGet(fs, 0) catch 9.0) == 0.5 && (listTryGet(fs, 2) catch 9.0) == 2.5, "sortFloat");

    const ss: List<string> = listNew();
    listPush(ss, "banana"); listPush(ss, "apple"); listPush(ss, "cherry");
    sortString(ss);
    assert((listTryGet(ss, 0) catch "?") == "apple" && (listTryGet(ss, 2) catch "?") == "cherry", "sortStr");
}
