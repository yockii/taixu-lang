// Canonical Obj72 assembly and views. All input facts use ObjectSpec64.
// Payload kinds 0..9 (kind k+3 for k>=3); 9 = generator (D3 v0.22, kind 12): ptr@32/len@40 hold the
// suspended snapshot values and release like a fields container; 10 = thread handle (threads step 2,
// kind 13): ptr@32 is the process-level thread record, released through __tx_rc_zero_cascade (no values);
// 11 = Shared handle (threads step 4c, kind 14): ptr@32 is the shared block, the result slot caches this thread's
// materialized root; 12 = Atomic<int> (kind 15): ptr@32 is the 8-byte cell. Both release through the cascade.
import { StructuredBuffer } from "./assemble";
import { nr, nd, ni, nm, nmd, nt, nmov, nl, nj, nret } from "./native_emit";
function zero(b: Ref<StructuredBuffer>, reg: int, count: int): void {
    let at = 0; while (at < count) { nmov(b, nm(reg, at), ni(0)); at = at + 8; }
}
function initialize(b: Ref<StructuredBuffer>): void {
    const p = "__tx_oi"; nl(b, "__tx_native_object_init_v1");
    nt(b, "test", nr(1), nr(1)); nj(b, "jz", p + "_reject"); nt(b, "test", nr(2), nr(2)); nj(b, "jz", p + "_reject");
    nt(b, "sub", nr(4), ni(72)); nmov(b, nm(4, 64), nr(1));
    let at = 0; while (at < 64) { nmov(b, nr(10), nm(2, at)); nmov(b, nm(4, at), nr(10)); at = at + 8; }
    nmov(b, nd(10), nmd(4, 0)); nmov(b, nd(11), nmd(4, 12));
    nt(b, "cmp", nd(10), ni(1)); nj(b, "jb", p + "_bad"); nt(b, "cmp", nd(10), ni(15)); nj(b, "ja", p + "_bad");
    nt(b, "cmp", nd(11), ni(12)); nj(b, "ja", p + "_bad");
    let k = 0; while (k < 13) { nt(b, "cmp", nd(11), ni(k)); nj(b, "je", p + "_kind" + toStr(k)); k = k + 1; }
    nl(b, p + "_kind0"); nt(b, "cmp", nd(10), ni(1)); nj(b, "je", p + "_write"); nt(b, "cmp", nd(10), ni(2)); nj(b, "je", p + "_write"); nj(b, "jmp", p + "_bad");
    nl(b, p + "_kind1"); nt(b, "cmp", nd(10), ni(3)); nj(b, "je", p + "_write"); nt(b, "cmp", nd(10), ni(5)); nj(b, "je", p + "_write"); nj(b, "jmp", p + "_bad");
    nl(b, p + "_kind2"); nt(b, "cmp", nd(10), ni(4)); nj(b, "je", p + "_write"); nt(b, "cmp", nd(10), ni(5)); nj(b, "je", p + "_write"); nj(b, "jmp", p + "_bad");
    k = 3; while (k < 13) {
        nl(b, p + "_kind" + toStr(k)); nt(b, "cmp", nd(10), ni(k + 3)); nj(b, "jne", p + "_bad");
        if (k == 7 || k == 8) {
            nmov(b, nr(10), nm(4, 24)); nt(b, "cmp", nr(10), nm(4, 32)); nj(b, "ja", p + "_bad");
            if (k == 7) { nt(b, "cmp", nmd(4, 44), ni(1)); nj(b, "jb", p + "_bad"); nt(b, "cmp", nmd(4, 44), ni(3)); nj(b, "ja", p + "_bad"); } // form 1 通用、2 原始、3 紧凑
            else { nt(b, "cmp", nmd(4, 44), ni(2)); nj(b, "ja", p + "_bad"); }
        }
        nj(b, "jmp", p + "_write"); k = k + 1;
    }
    nl(b, p + "_write"); nmov(b, nr(1), nm(4, 64)); nmov(b, nmd(1, 0), ni(0));
    nmov(b, nd(10), nmd(4, 4)); nmov(b, nmd(1, 4), nd(10)); nmov(b, nd(10), nmd(4, 8)); nmov(b, nmd(1, 8), nd(10));
    nmov(b, nd(10), nmd(4, 0)); nmov(b, nmd(1, 12), nd(10)); nmov(b, nd(10), nmd(4, 12)); nmov(b, nmd(1, 16), nd(10)); nmov(b, nmd(1, 20), ni(-1));
    nmov(b, nd(10), nmd(4, 40)); nmov(b, nmd(1, 24), nd(10)); nmov(b, nd(10), nmd(4, 44)); nmov(b, nmd(1, 28), nd(10));
    at = 0; while (at < 24) { nmov(b, nr(10), nm(4, 16 + at)); nmov(b, nm(1, 32 + at), nr(10)); at = at + 8; }
    nmov(b, nr(10), nm(4, 48)); nmov(b, nm(1, 56), nr(10)); nmov(b, nr(10), nm(4, 56)); nmov(b, nm(1, 64), nr(10));
    nmov(b, nd(0), ni(1)); nt(b, "add", nr(4), ni(72)); nret(b);
    nl(b, p + "_bad"); nt(b, "add", nr(4), ni(72)); nl(b, p + "_reject"); nmov(b, nd(0), ni(0)); nret(b);
}
function payloadView(b: Ref<StructuredBuffer>): void {
    const p = "__tx_ov"; nl(b, "__tx_native_object_payload_v1"); zero(b, 2, 80);
    nmov(b, nd(10), nmd(1, 0)); nmov(b, nmd(2, 28), nd(10)); nmov(b, nm(2, 32), ni(4)); nmov(b, nmd(2, 72), ni(1));
    nmov(b, nd(11), nmd(1, 16)); nt(b, "cmp", nd(11), ni(1)); nj(b, "je", p + "_values"); nt(b, "cmp", nd(11), ni(2)); nj(b, "je", p + "_values"); nt(b, "cmp", nd(11), ni(3)); nj(b, "je", p + "_values");
    nt(b, "cmp", nd(11), ni(9)); nj(b, "je", p + "_values"); // 生成器（D3 v0.22，kind 12）：ptr@32/len@40 为快照值槽
    nt(b, "cmp", nd(11), ni(4)); nj(b, "je", p + "_slice"); nt(b, "cmp", nd(11), ni(7)); nj(b, "je", p + "_list"); nt(b, "cmp", nd(11), ni(8)); nj(b, "je", p + "_future"); nj(b, "jmp", p + "_frame");
    nl(b, p + "_values"); nmov(b, nr(10), nm(1, 32)); nmov(b, nm(2, 0), nr(10)); nmov(b, nr(11), nm(1, 40)); nmov(b, nm(2, 8), nr(11)); nmov(b, nmd(2, 24), ni(1)); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_frame"); nmov(b, nm(2, 16), nr(10)); nj(b, "jmp", p + "_frame");
    nl(b, p + "_slice"); nmov(b, nm(2, 32), ni(10)); nmov(b, nd(10), nmd(1, 24)); nmov(b, nm(2, 40), nr(10)); nmov(b, nr(10), nr(2)); nt(b, "add", nr(10), ni(32)); nmov(b, nm(2, 0), nr(10)); nmov(b, nm(2, 8), ni(1)); nj(b, "jmp", p + "_frame");
    nl(b, p + "_future"); nmov(b, nr(10), nr(1)); nt(b, "add", nr(10), ni(56)); nmov(b, nm(2, 0), nr(10)); nmov(b, nm(2, 8), ni(1)); nmov(b, nmd(2, 24), ni(1)); nt(b, "cmp", nm(1, 48), ni(0)); nj(b, "je", p + "_frame"); nmov(b, nr(10), nm(1, 32)); nmov(b, nm(2, 16), nr(10)); nj(b, "jmp", p + "_frame");
    nl(b, p + "_list"); let off = 0; while (off < 24) { nmov(b, nr(10), nm(1, 32 + off)); nmov(b, nm(2, 48 + off), nr(10)); off = off + 8; }
    nmov(b, nd(10), nmd(1, 28)); nmov(b, nmd(2, 72), nd(10)); nmov(b, nd(11), nmd(1, 24)); nmov(b, nmd(2, 76), nd(11)); nmov(b, nmd(2, 24), ni(2)); nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_frame"); nmov(b, nr(10), nm(1, 32)); nmov(b, nm(2, 0), nr(10)); nmov(b, nr(10), nm(1, 40)); nmov(b, nm(2, 8), nr(10));
    nl(b, p + "_frame"); nmov(b, nd(10), nmd(1, 0)); nt(b, "and", nd(10), ni(4)); nj(b, "jz", p + "_return"); nmov(b, nm(2, 16), ni(0)); nmov(b, nmd(2, 24), ni(0)); nl(b, p + "_return"); nret(b);
}
function view(b: Ref<StructuredBuffer>, clone: bool): void {
    let p = "__tx_oe"; if (clone) { p = "__tx_oc"; }
    let name = "__tx_native_object_equal_view_v1"; if (clone) { name = "__tx_native_object_clone_view_v1"; }
    nl(b, name); zero(b, 8, 32); nmov(b, nd(2), nd(2)); nmov(b, nd(10), nmd(1, 16));
    if (clone == false) { nt(b, "cmp", nd(2), ni(5)); nj(b, "je", p + "_bytes"); nt(b, "cmp", nd(2), ni(6)); nj(b, "je", p + "_bytes"); }
    nt(b, "cmp", nd(2), ni(7)); nj(b, "je", p + "_compound"); nt(b, "cmp", nd(2), ni(8)); nj(b, "je", p + "_compound");
    if (clone) { nt(b, "cmp", nd(2), ni(9)); nj(b, "je", p + "_compound"); }
    nt(b, "cmp", nd(2), ni(10)); nj(b, "je", p + "_array"); nj(b, "jmp", p + "_none");
    if (clone == false) { nl(b, p + "_bytes"); nt(b, "cmp", nd(10), ni(0)); nj(b, "jne", p + "_none"); nmov(b, nd(0), ni(1)); nj(b, "jmp", p + "_span"); }
    nl(b, p + "_compound"); nt(b, "cmp", nd(10), ni(1)); nj(b, "je", p + "_fields"); nt(b, "cmp", nd(10), ni(2)); nj(b, "je", p + "_enum"); nj(b, "jmp", p + "_bad");
    nl(b, p + "_fields"); if (clone == false) { nt(b, "cmp", nd(2), ni(7)); nj(b, "jne", p + "_none"); } nmov(b, nd(11), nmd(1, 4)); nmov(b, nmd(8, 4), nd(11)); nmov(b, nd(0), ni(2)); if (clone) { nmov(b, nd(0), ni(1)); } nj(b, "jmp", p + "_span");
    nl(b, p + "_enum"); if (clone == false) { nt(b, "cmp", nd(2), ni(8)); nj(b, "jne", p + "_none"); } nmov(b, nd(0), ni(3)); if (clone) { nmov(b, nd(0), ni(2)); nmov(b, nd(11), nmd(1, 4)); nmov(b, nmd(8, 4), nd(11)); } nj(b, "jmp", p + "_meta");
    nl(b, p + "_array"); nt(b, "cmp", nd(10), ni(3)); nj(b, "jne", p + "_bad"); nmov(b, nd(0), ni(4)); if (clone) { nmov(b, nd(0), ni(3)); nmov(b, nd(11), nmd(1, 4)); nmov(b, nmd(8, 4), nd(11)); }
    nl(b, p + "_meta"); nmov(b, nd(11), nmd(1, 24)); nmov(b, nmd(8, 8), nd(11));
    nl(b, p + "_span"); nmov(b, nmd(8, 0), nd(0)); nmov(b, nr(11), nm(1, 32)); nmov(b, nm(8, 16), nr(11)); nmov(b, nr(11), nm(1, 40)); nmov(b, nm(8, 24), nr(11)); nret(b);
    nl(b, p + "_bad"); if (clone) { nmov(b, nd(0), ni(5)); nret(b); } nl(b, p + "_none"); nmov(b, nd(0), ni(0)); nret(b);
}
export function objectRecordEmit(b: Ref<StructuredBuffer>): void {
    initialize(b); payloadView(b); view(b, true); view(b, false);
    const p = "__tx_ow"; nl(b, "__tx_native_object_weak_dead_v1"); nt(b, "test", nd(2), nd(2)); nj(b, "jz", p + "_return"); nt(b, "cmp", nmd(1, 12), ni(9)); nj(b, "jne", p + "_return"); nt(b, "cmp", nmd(1, 16), ni(6)); nj(b, "jne", p + "_return"); nmov(b, nd(10), nmd(1, 24)); nt(b, "cmp", nd(10), nd(8)); nj(b, "jne", p + "_return"); nmov(b, nmd(1, 28), ni(1)); nl(b, p + "_return"); nret(b);
}
