// URI 的 IP-literal 语法，RFC 3986 §3.2.2。不解析网络、端口或带区域号的地址。
function hex(c: int): bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

function ipv4(s: string): bool {
    const parts = strSplit(s, ".");
    if (listLen(parts) != 4) { return false; }
    for (part in parts) {
        if (len(part) == 0 || len(part) > 3 || (len(part) > 1 && byteAt(part, 0) == 48)) { return false; }
        let n = 0;
        for (c in part) { if (c < 48 || c > 57) { return false; } n = n * 10 + c - 48; }
        if (n > 255) { return false; }
    }
    return true;
}

// 一侧的冒号分组数；末尾的 IPv4 计作两组，且只能在整个地址的末端。
function groups(s: string, final: bool): int {
    if (len(s) == 0) { return 0; }
    const parts = strSplit(s, ":");
    let count = 0;
    let i = 0;
    while (i < listLen(parts)) {
        const p = listGet(parts, i);
        if (len(p) == 0) { return -1; }
        if (strFind(p, ".") >= 0) {
            if (!final || i != listLen(parts) - 1 || !ipv4(p)) { return -1; }
            count = count + 2;
        } else {
            if (len(p) > 4) { return -1; }
            for (c in p) { if (!hex(c)) { return -1; } }
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

export function ipLiteral(s: string): bool {
    if (len(s) == 0) { return false; }
    if (byteAt(s, 0) == 118 || byteAt(s, 0) == 86) {
        const dot = strFind(s, ".");
        if (dot < 2 || dot == len(s) - 1) { return false; }
        let i = 1;
        while (i < dot) { if (!hex(byteAt(s, i))) { return false; } i = i + 1; }
        i = dot + 1;
        while (i < len(s)) {
            const c = byteAt(s, i);
            const alpha = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
            if (!alpha && !(c >= 48 && c <= 57) && strFind("-._~!$&'()*+,;=:", strSlice(s, i, i + 1)) < 0) { return false; }
            i = i + 1;
        }
        return true;
    }
    const dbl = strFind(s, "::");
    if (dbl < 0) { return groups(s, true) == 8; }
    const left = strSlice(s, 0, dbl);
    const right = strSlice(s, dbl + 2, len(s));
    if (strFind(right, "::") >= 0) { return false; }
    const a = groups(left, false);
    const b = groups(right, true);
    return a >= 0 && b >= 0 && a + b < 8;
}
