// D3 v0.50 §6.4-4：三元 c ? a : b——最低一层、右结合（else 支可接三元），条件须为 bool；两支类型合成同 switch 臂（T 与 None
// 合成 T?，None 支在前也行）；两支取条件的 None 收窄；then 支以后缀 ? 结尾、或传播后接不能开始表达式的运算符照常
// （`c ? x? : 0`、`c ? x? + 1 : 0`）；条件以后缀 ? 结尾加括号；`a ?? b ? x : y` 即 `(a ?? b) ? x : y`；箭头函数可作分支。
function label(score: int): string {
    return score >= 60 ? "及格" : "不及格";
}

function grade(score: int): string {
    return score >= 90 ? "优" : score >= 75 ? "良" : score >= 60 ? "中" : "差";
}

function sign(n: int): int {
    return n > 0 ? 1 : n < 0 ? -1 : 0;
}

function narrowTern(x: int?): int {
    return x != None ? x * 10 : 0;
}

function optArm(c: bool, v: int): int? {
    return c ? v : None;
}

function optArm2(c: bool, v: int): int? {
    return c ? None : v;
}

function noneFirst(c: bool): string {
    const r = c ? None : "有";
    return r ?? "空";
}

function nested(a: bool, b: bool): string {
    return a ? (b ? "aa" : "ab") : (b ? "ba" : "bb");
}

function propThen(x: int?): int? {
    const y = x? + 1;
    return y > 5 ? y : None;
}

function thenProp(c: bool, x: int?): int? {
    return c ? x? : 0;
}

function thenPropPlus(c: bool, x: int?): int? {
    return c ? x? + 1 : 0;
}

function parenCond(x: bool?): int? {
    return (x?) ? 1 : 2;
}

function coalesceCond(x: bool?): string {
    return x ?? false ? "真" : "假";
}

function arrows(c: bool): int {
    const f = c ? (k: int): int => k * 2 : (k: int): int => -k;
    return f(5);
}

function sideEffects(c: bool): int {
    let n = 0;
    const v = c ? bump(1) : bump(100);
    n += v;
    return n;
}

function bump(k: int): int {
    print("求值 " + toStr(k));
    return k;
}

function main(args: []string): void {
    print(label(75) + " " + label(30));
    print(grade(95) + grade(80) + grade(61) + grade(10));
    print(toStr(sign(5)) + " " + toStr(sign(-3)) + " " + toStr(sign(0)));
    print(toStr(narrowTern(4)) + " " + toStr(narrowTern(None)));
    print(toStr(optArm(true, 3) ?? -1) + " " + toStr(optArm(false, 3) ?? -1));
    print(toStr(optArm2(true, 3) ?? -1) + " " + toStr(optArm2(false, 3) ?? -1));
    print(noneFirst(true) + " " + noneFirst(false));
    print(nested(true, true) + nested(true, false) + nested(false, true) + nested(false, false));
    print(toStr(propThen(9) ?? -1) + " " + toStr(propThen(2) ?? -1) + " " + toStr(propThen(None) ?? -1));
    print(toStr(thenProp(true, 7) ?? -1) + " " + toStr(thenProp(true, None) ?? -1) + " " + toStr(thenProp(false, None) ?? -1));
    print(toStr(thenPropPlus(true, 7) ?? -1) + " " + toStr(thenPropPlus(true, None) ?? -1));
    print(toStr(parenCond(true) ?? -1) + " " + toStr(parenCond(false) ?? -1) + " " + toStr(parenCond(None) ?? -1));
    print(coalesceCond(true) + " " + coalesceCond(None));
    print(toStr(arrows(true)) + " " + toStr(arrows(false)));
    print(toStr(sideEffects(true)) + " " + toStr(sideEffects(false)));
}
