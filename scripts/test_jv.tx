// 协议端到端测试取 JSON 值的写法：对可缺席的值（Ref<Jv>?）安全地取字段、下标与比较，语义同 Python 的 `(x or {}).get(k)`、
// `==`、真值——取不到得 None 或假，不抛异常。与 test_json.tx 一样不导入 bootstrap/。
import { J_ARR, J_BOOL, J_NULL, J_OBJ, J_STR, Jv, jAt, jDump, jEq, jGet, jInt, jIsBool, jIsTrue, jLen, jNull, jParse, jQuote, jText }
from "./test_json";

// 对象的字段；v 缺席或不是对象得 None。
export function at(v: Ref<Jv>?, key: string): Ref<Jv>? {
    if (v == None) {
        return None;
    }
    return jGet(v ?? jNull(), key);
}

// 数组的元素（负下标从末尾数，同 Python）；越界或不是数组得 None。
export function item(v: Ref<Jv>?, i: int): Ref<Jv>? {
    if (v == None) {
        return None;
    }
    const x = v ?? jNull();
    if (i < 0) {
        return jAt(x, jLen(x) + i);
    }
    return jAt(x, i);
}

export function isObj(v: Ref<Jv>?): bool {
    return v != None && (v ?? jNull()).kind == J_OBJ;
}

export function isArr(v: Ref<Jv>?): bool {
    return v != None && (v ?? jNull()).kind == J_ARR;
}

export function isNull(v: Ref<Jv>?): bool {
    return v != None && (v ?? jNull()).kind == J_NULL;
}

// 数组的元素数；不是数组得 0。
export function count(v: Ref<Jv>?): int {
    if (!isArr(v)) {
        return 0;
    }
    return jLen(v ?? jNull());
}

export function has(v: Ref<Jv>?, key: string): bool {
    return at(v, key) != None;
}

export function textIs(v: Ref<Jv>?, key: string, want: string): bool {
    const t = jText(at(v, key));
    return t != None && (t ?? "") == want;
}

// 字段的字符串值；缺席或不是字符串得空串。
export function textOf(v: Ref<Jv>?, key: string): string {
    return jText(at(v, key)) ?? "";
}

export function intIs(v: Ref<Jv>?, key: string, want: int): bool {
    const n = jInt(at(v, key));
    return n != None && (n ?? 0) == want;
}

// 字段的整数值；缺席或不是整数得 0。
export function intOf(v: Ref<Jv>?, key: string): int {
    return jInt(at(v, key)) ?? 0;
}

export function trueAt(v: Ref<Jv>?, key: string): bool {
    return jIsTrue(at(v, key));
}

// 字段是 JSON false（Python 的 x is False）。
export function falseAt(v: Ref<Jv>?, key: string): bool {
    const x = at(v, key);
    return jIsBool(x) && !jIsTrue(x);
}

// Python 的真值：缺席、null、false、0、空串、空数组、空对象为假。
export function truthy(v: Ref<Jv>?): bool {
    if (v == None) {
        return false;
    }
    const x = v ?? jNull();
    if (x.kind == J_NULL) {
        return false;
    }
    if (x.kind == J_BOOL) {
        return x.truth;
    }
    if (x.kind == J_ARR || x.kind == J_OBJ) {
        return jLen(x) > 0;
    }
    if (x.kind == J_STR) {
        return len(x.text) > 0;
    }
    // 数字：指数之前有非 0 的数字即为真。
    let i = 0;
    while (i < len(x.text)) {
        const d = byteAt(x.text, i) ?? 0;
        if (d == 101 || d == 69) {
            return false;
        }
        if (d >= 49 && d <= 57) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// v 与 JSON 文本 want 解析出的值相等（同 Python 的 ==）；v 缺席为假。
export function eqJson(v: Ref<Jv>?, want: string): bool {
    if (v == None) {
        return false;
    }
    const w = jParse(want) catch (e) {
        return false;
    };
    return jEq(v ?? w, w);
}

// 两个可缺席的值相等；都缺席也算相等（同 Python 的 None == None）。
export function sameJv(a: Ref<Jv>?, b: Ref<Jv>?): bool {
    if (a == None || b == None) {
        return a == None && b == None;
    }
    return jEq(a ?? jNull(), b ?? jNull());
}

// 两个值的同名字段相等（同 Python 的 a.get(k) == b.get(k)）。
export function sameAt(a: Ref<Jv>?, b: Ref<Jv>?, key: string): bool {
    return sameJv(at(a, key), at(b, key));
}

// 紧凑的 JSON 原文；缺席写 None（FAIL 行的细节用）。
export function dump(v: Ref<Jv>?): string {
    if (v == None) {
        return "None";
    }
    return jDump(v ?? jNull());
}

// 数组各元素某字段的文本，以空格连接（缺席或不是字符串写 None）。
export function fieldsOf(v: Ref<Jv>?, key: string): string {
    let s = "";
    let i = 0;
    while (i < count(v)) {
        if (i > 0) {
            s = s + " ";
        }
        s = s + (jText(at(item(v, i), key)) ?? "None");
        i = i + 1;
    }
    return s;
}

// 字符串列表的 JSON 写法（FAIL 行的细节用）。
export function listText(xs: List<string>): string {
    let s = "[";
    let i = 0;
    while (i < listLen(xs)) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + jQuote(listGet(xs, i) catch "");
        i = i + 1;
    }
    return s + "]";
}

// Python 以某字段建 dict 再按键取（同名的以后一个为准）：数组里该字段文本等于 name 的最后一项；没有得 None。
export function lastBy(xs: Ref<Jv>?, key: string, name: string): Ref<Jv>? {
    let found: Ref<Jv>? = None;
    let i = 0;
    while (i < count(xs)) {
        const x = item(xs, i);
        if (textIs(x, key, name)) {
            found = x;
        }
        i = i + 1;
    }
    return found;
}

// 数组里该字段文本等于 name 的第一项（同 Python 的 next(…)）；没有得 None。
export function firstBy(xs: Ref<Jv>?, key: string, name: string): Ref<Jv>? {
    let i = 0;
    while (i < count(xs)) {
        const x = item(xs, i);
        if (textIs(x, key, name)) {
            return x;
        }
        i = i + 1;
    }
    return None;
}
