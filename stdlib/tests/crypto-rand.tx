import { randomBytes, randomFill } from "std/crypto/rand";
import { fillRandomFrom } from "std/crypto/rand_impl";
import { constantTimeEqual } from "std/crypto/subtle";

struct Calls { count: int, next: int }

test "crypto/rand：短读、中断与边界无遗漏" {
    const state = new Calls { count: 0, next: 0 };
    const data = bytesNew(777);
    fillRandomFrom(data, (buf: Bytes, want: int): int => {
            state.count = state.count + 1;
            assert(want > 0 && want <= 256 && want <= bytesLen(buf), "bounded system call");
            if (state.count == 1 || state.count == 5) { return -4; }
            let n = want;
            if (n > 17) { n = 17; }
            let i = 0;
            while (i < n) {
                bytesSet(buf, i, state.next % 256);
                state.next = state.next + 1; i = i + 1;
            }
            return n;
        }) catch panic("short read fill");
    assert(state.next == 777 && state.count > 2, "exact total");
    let i = 0;
    while (i < 777) { assert((bytesGet(data, i) catch -1) == i % 256, "byte " + toStr(i)); i = i + 1; }
    fillRandomFrom(bytesNew(0), (buf: Bytes, n: int): int => { panic("empty invokes source"); return -1; }) catch panic("empty");
}

function fails(code: int): bool {
    fillRandomFrom(bytesNew(256), (buf: Bytes, n: int): int => { return code; }) catch (e) { return true; };
    return false;
}

test "crypto/rand：失败、无进展与源越界拒绝" {
    assert(fails(-38) && fails(-1) && fails(0) && fails(257), "no fallback or invalid progress");
    const state = new Calls { count: 0, next: 0 };
    const data = bytesNew(4);
    let failed = false;
    fillRandomFrom(data, (buf: Bytes, n: int): int => {
            state.count = state.count + 1;
            if (state.count > 1) { return -38; }
            bytesSet(buf, 0, 99); return 1;
        }) catch (e) { failed = true; };
    assert(failed && state.count == 2 && (bytesGet(data, 0) catch -1) == 99 && (bytesGet(data, 1) catch -1) == 0, "partial failure is explicit");
}

function negativeFails(): bool { randomBytes(-1) catch (e) { return true; }; return false; }

test "crypto/rand：系统源各一 MiB 两次及长度边界" {
    assert(negativeFails(), "negative length");
    for (n in [0, 1, 255, 256, 257]) { assert(bytesLen(randomBytes(n) catch panic("random length")) == n, "length " + toStr(n)); }
    randomFill(bytesNew(0)) catch panic("empty fill");
    const a = randomBytes(1048576) catch panic("first MiB");
    const b = randomBytes(1048576) catch panic("second MiB");
    assert(bytesLen(a) == 1048576 && bytesLen(b) == 1048576 && !constantTimeEqual(a, b), "two independent MiB smoke");
}
