// ============================================================================
// gui/layout —— flex 布局暴露（臂②；#16）。
//
// **几何测试**：tests/layout.tx 按固定输入的布局表检查位置与尺寸，
// 包含 22 例布局；实现为确定性整数 flex 子集。
// 对每一例逐项比较几何四元组，不依赖平台窗口系统。
// 支持的子集与整数策略如下：
// - 纳入：flex-direction（row/column）、gap、padding/margin、width/height
//   （auto|px）、min/max 钳制、flex-grow/shrink、flex-basis（auto|px）、
//   justify-content（四值）、align-items/align-self（四值）；
// - 排除（不静默）：wrap 多行、baseline、RTL、百分比、absolute、margin:auto、
//   order；
// - 确定性整数策略：§9.7 违例冻结→重分配至稳定；份额 floor(总量×权重/总
//   权重)＋余量自左向右逐项 +1；center/space_between 取 floor；auto 无内容
//   测量 → 0。
//
// **维度编码（S1 无 union——恒等语义的结构化替代）**：width/height/basis
// 以 int 表达，**负值＝auto**（-1 惯用；语义面 auto与显式 0 的区别仅 basis
// 假想尺寸回退与 stretch 资格两处）。纯函数：同输入
// 恒同输出（无时间源/无随机源——确定性红线）。
// ============================================================================

// —— 布局常量 ——

/// flex-direction（§5.1）。
export const DIR_ROW: int = 0;
export const DIR_COLUMN: int = 1;

/// justify-content（§5.2 四值）。
export const JUSTIFY_FLEX_START: int = 0;
export const JUSTIFY_FLEX_END: int = 1;
export const JUSTIFY_CENTER: int = 2;
export const JUSTIFY_SPACE_BETWEEN: int = 3;

/// align-items / align-self（§5.3 四值）。
export const ALIGN_STRETCH: int = 0;
export const ALIGN_FLEX_START: int = 1;
export const ALIGN_FLEX_END: int = 2;
export const ALIGN_CENTER: int = 3;

/// 维度 auto（width/height/basis 共用；负值域哨兵）。
export const DIM_AUTO: int = -1;
/// 不可达的最大尺寸（min/max 缺省＝无钳制）。
export const NO_MAX: int = 536870911;

/// 边距/内边距（TRBL 序，CSS 惯例）。
export struct Edges {
    top: int,
    right: int,
    bottom: int,
    left: int,
}

/// 样式面（UI 即数据：可序列化属性集；缺省值经 styleDefault 装配）。
export struct Style {
    direction: int,
    grow: int,
    shrink: int, // CSS 默认 1
    basis: int, // DIM_AUTO | px
    width: int, // DIM_AUTO | px
    height: int, // DIM_AUTO | px
    min_w: int,
    min_h: int,
    max_w: int,
    max_h: int,
    padding: Edges,
    margin: Edges,
    gap: int,
    justify: int,
    align_items: int,
    align_self: int, // -1＝未设（随 align_items）；else ALIGN_*
}

/// 几何结果（preorder 对应节点；独立命名——gui/components 的 Box 为既有
/// 静态控件件，不冲突）。
export struct LayoutBox {
    x: int,
    y: int,
    w: int,
    h: int,
}

/// 树节点（值语义 style＋children；构建面经 nodeNew）。
export struct Node {
    style: Style,
    children: List<Ref<Node>>,
}

/// 缺省样式（全字段显式）。
export function styleDefault(): Style {
    const s: Style = {
        direction: DIR_ROW,
        grow: 0,
        shrink: 1,
        basis: DIM_AUTO,
        width: DIM_AUTO,
        height: DIM_AUTO,
        min_w: 0,
        min_h: 0,
        max_w: NO_MAX,
        max_h: NO_MAX,
        padding: Edges { top: 0, right: 0, bottom: 0, left: 0 },
        margin: Edges { top: 0, right: 0, bottom: 0, left: 0 },
        gap: 0,
        justify: JUSTIFY_FLEX_START,
        align_items: ALIGN_STRETCH,
        align_self: -1,
    };
    return s;
}

export function nodeNew(style: Style): Ref<Node> {
    return new Node { style: style, children: listNew() };
}

/// 尺寸便捷声明（px 或 auto）。
export function dimPx(v: int): int {
    return v;
}

// —— 语义面：假想尺寸/钳制/权重 ——

function dimOr0(d: int): int {
    if (d < 0) {
        return 0;
    }
    return d;
}

function hypotheticalMain(st: Style, is_row: bool): int {
    if (st.basis >= 0) {
        return st.basis;
    }
    if (is_row) {
        return dimOr0(st.width);
    }
    return dimOr0(st.height);
}

function hypotheticalCross(st: Style, is_row: bool): int {
    if (is_row) {
        return dimOr0(st.height);
    }
    return dimOr0(st.width);
}

function crossIsAuto(st: Style, is_row: bool): bool {
    if (is_row) {
        return st.height < 0;
    }
    return st.width < 0;
}

function clampMain(st: Style, is_row: bool, v: int): int {
    if (is_row) {
        return maxInt(st.min_w, minInt(st.max_w, v));
    }
    return maxInt(st.min_h, minInt(st.max_h, v));
}

function clampCross(st: Style, is_row: bool, v: int): int {
    if (is_row) {
        return maxInt(st.min_h, minInt(st.max_h, v));
    }
    return maxInt(st.min_w, minInt(st.max_w, v));
}

function shrinkWeight(st: Style, base: int): int {
    if (base > 0) {
        return st.shrink * base;
    }
    return st.shrink;
}

function marginMain(direction: int, m: Edges): int {
    if (direction == DIR_ROW) {
        return m.left + m.right;
    }
    return m.top + m.bottom;
}

function marginMainBefore(direction: int, m: Edges): int {
    if (direction == DIR_ROW) {
        return m.left;
    }
    return m.top;
}

function marginMainAfter(direction: int, m: Edges): int {
    if (direction == DIR_ROW) {
        return m.right;
    }
    return m.bottom;
}

function marginCrossBefore(direction: int, m: Edges): int {
    if (direction == DIR_ROW) {
        return m.top;
    }
    return m.left;
}

function marginCrossAfter(direction: int, m: Edges): int {
    if (direction == DIR_ROW) {
        return m.bottom;
    }
    return m.right;
}

/// 确定性份额：floor(总量×权重/总权重)（非法输入 0 不崩溃）。
function shareOf(total: int, weight: int, total_weight: int): int {
    if (total <= 0 || weight <= 0 || total_weight <= 0) {
        return 0;
    }
    return divFloor(total * weight, total_weight);
}

/// floor 除法（`/` 为截断，此处显式处理负数向下取整）。
function divFloor(a: int, b: int): int {
    const q: int = a / b;
    const r: int = a % b;
    if (r != 0 && ((r < 0) != (b < 0))) {
        return q - 1;
    }
    return q;
}

function minInt(a: int, b: int): int {
    if (a < b) {
        return a;
    }
    return b;
}

function maxInt(a: int, b: int): int {
    if (a > b) {
        return a;
    }
    return b;
}

// ============================================================================
// 布局纯函数入口（preorder：out[0]＝根盒＝视口全幅原点；其余为 children 递归）。
// 同输入恒同输出（确定性单测守护——tests/layout.tx 22 例规范用例表对拍）。
// ============================================================================

export function resolve(root: Ref<Node>, viewport_w: int, viewport_h: int): List<Ref<LayoutBox>> {
    const boxes: List<Ref<LayoutBox>> = listNew();
    listPush(boxes, new LayoutBox { x: 0, y: 0, w: viewport_w, h: viewport_h });
    layoutChildren(root, boxes, new LayoutBox { x: 0, y: 0, w: viewport_w, h: viewport_h });
    return boxes;
}

/// 单行 flex 布局（对 node 的 children；content 为 node 的盒子）。
/// 五阶段：收集 → 弹性长度（§9.7 循环）→ 主轴定位（justify）→
/// 交叉轴（align/stretch）→ 盒子写入＋子树递归。
function layoutChildren(node: Ref<Node>, out: List<Ref<LayoutBox>>, content: Ref<LayoutBox>): void {
    const kids: List<Ref<Node>> = node.children;
    const n: int = listLen(kids);
    if (n == 0) {
        return;
    }
    const st: Style = node.style;
    const is_row: bool = st.direction == DIR_ROW;

    // —— 阶段 1：假想主/交尺寸收集（§9.4）——
    const bases: List<int> = listNew();
    const targets: List<int> = listNew();
    const cross_bases: List<int> = listNew();
    const frozen: List<bool> = listNew();
    let i: int = 0;
    let total_margins: int = 0;
    while (i < n) {
        const kid = listTryGet(kids, i) catch node;
        listPush(bases, hypotheticalMain(kid.style, is_row));
        listPush(targets, hypotheticalMain(kid.style, is_row));
        listPush(cross_bases, hypotheticalCross(kid.style, is_row));
        listPush(frozen, false);
        total_margins = total_margins + marginMain(st.direction, kid.style.margin);
        i = i + 1;
    }
    const total_gap: int = st.gap * (n - 1);
    let main_content: int = content.w - st.padding.left - st.padding.right;
    let cross_content: int = content.h - st.padding.top - st.padding.bottom;
    if (!is_row) {
        main_content = content.h - st.padding.top - st.padding.bottom;
        cross_content = content.w - st.padding.left - st.padding.right;
    }

    // —— 阶段 2：弹性长度解析（§9.7：违例项冻结→剩余空间重分配至稳定）——
    let looping: bool = true;
    while (looping) {
        let sum_frozen: int = 0;
        let sum_unfrozen_bases: int = 0;
        let total_grow: int = 0;
        let total_shrink_w: int = 0;
        i = 0;
        while (i < n) {
            const kid = listTryGet(kids, i) catch node;
            if (listTryGet(frozen, i) catch false) {
                sum_frozen = sum_frozen + (listTryGet(targets, i) catch 0);
            } else {
                sum_unfrozen_bases = sum_unfrozen_bases + (listTryGet(bases, i) catch 0);
                total_grow = total_grow + kid.style.grow;
                total_shrink_w = total_shrink_w + shrinkWeight(kid.style, listTryGet(bases, i) catch 0);
            }
            i = i + 1;
        }
        // 自由空间＝内容主幅 −间隙 −边距 −冻结项当前尺寸 −未冻结项假想
        //（基础）主尺寸——CSS §9.7：份额相对 flex base size 分派。
        const free: int = main_content - total_gap - total_margins - sum_frozen - sum_unfrozen_bases;
        if (free >= 0) {
            // grow 分配（floor）＋余量自左向右逐项 +1（冻结整数策略）。
            let distributed: int = 0;
            i = 0;
            while (i < n) {
                const kid = listTryGet(kids, i) catch node;
                if (listTryGet(frozen, i) catch false) {
                    i = i + 1;
                    continue;
                }
                if (kid.style.grow > 0 && total_grow > 0) {
                    const share: int = shareOf(free, kid.style.grow, total_grow);
                    listSet(targets, i, (listTryGet(bases, i) catch 0) + share);
                    distributed = distributed + share;
                }
                i = i + 1;
            }
            let rem: int = free - distributed;
            i = 0;
            while (i < n && rem > 0) {
                const kid = listTryGet(kids, i) catch node;
                if (!(listTryGet(frozen, i) catch false) && kid.style.grow > 0) {
                    listSet(targets, i, (listTryGet(targets, i) catch 0) + 1);
                    rem = rem - 1;
                }
                i = i + 1;
            }
        } else {
            // shrink 分配（权重 shrink×basis——0 退化 shrink 本身）＋余量 +1。
            const deficit: int = -free;
            let distributed: int = 0;
            i = 0;
            while (i < n) {
                const kid = listTryGet(kids, i) catch node;
                if (listTryGet(frozen, i) catch false) {
                    i = i + 1;
                    continue;
                }
                const w: int = shrinkWeight(kid.style, listTryGet(bases, i) catch 0);
                if (total_shrink_w > 0) {
                    const share: int = shareOf(deficit, w, total_shrink_w);
                    listSet(targets, i, (listTryGet(bases, i) catch 0) - share);
                    distributed = distributed + share;
                }
                i = i + 1;
            }
            let rem: int = deficit - distributed;
            i = 0;
            while (i < n && rem > 0) {
                if (!(listTryGet(frozen, i) catch false)) {
                    listSet(targets, i, (listTryGet(targets, i) catch 0) - 1);
                    rem = rem - 1;
                }
                i = i + 1;
            }
        }
        let clamped_any: bool = false;
        i = 0;
        while (i < n) {
            const kid = listTryGet(kids, i) catch node;
            if (listTryGet(frozen, i) catch false) {
                i = i + 1;
                continue;
            }
            const clamped: int = clampMain(kid.style, is_row, listTryGet(targets, i) catch 0);
            if (clamped != (listTryGet(targets, i) catch 0)) {
                listSet(targets, i, clamped);
                listSet(frozen, i, true);
                clamped_any = true;
            }
            i = i + 1;
        }
        if (!clamped_any) {
            looping = false;
        }
    }

    // —— 阶段 3：主轴定位（§9.5 justify；整数 floor，余量左→右 +1）——
    let used_final: int = total_gap + total_margins;
    i = 0;
    while (i < n) {
        used_final = used_final + (listTryGet(targets, i) catch 0);
        i = i + 1;
    }
    const free_main: int = main_content - used_final;
    let content_origin_main: int = content.x + st.padding.left;
    if (!is_row) {
        content_origin_main = content.y + st.padding.top;
    }
    let cursor: int = content_origin_main;
    let lead: int = 0;
    const gaps: List<int> = listNew();
    i = 0;
    while (i < n - 1) {
        listPush(gaps, st.gap);
        i = i + 1;
    }
    if (st.justify == JUSTIFY_FLEX_END) {
        lead = free_main;
    } else if (st.justify == JUSTIFY_CENTER) {
        lead = divFloor(free_main, 2);
    } else if (st.justify == JUSTIFY_SPACE_BETWEEN) {
        if (n > 1) {
            const base_between: int = divFloor(free_main, n - 1);
            let rem: int = free_main - base_between * (n - 1);
            i = 0;
            while (i < n - 1) {
                let g: int = st.gap + base_between;
                if (rem > 0) {
                    g = g + 1;
                    rem = rem - 1;
                }
                listSet(gaps, i, g);
                i = i + 1;
            }
        }
    }
    cursor = cursor + lead;
    const positions: List<int> = listNew();
    i = 0;
    while (i < n) {
        const kid = listTryGet(kids, i) catch node;
        cursor = cursor + marginMainBefore(st.direction, kid.style.margin);
        listPush(positions, cursor);
        cursor = cursor + (listTryGet(targets, i) catch 0) + marginMainAfter(st.direction, kid.style.margin);
        if (i + 1 < n) {
            cursor = cursor + (listTryGet(gaps, i) catch 0);
        }
        i = i + 1;
    }

    // —— 阶段 4＋5：交叉轴（align/stretch）＋盒子写入＋子树递归 ——
    let content_origin_cross: int = content.y + st.padding.top;
    if (!is_row) {
        content_origin_cross = content.x + st.padding.left;
    }
    i = 0;
    while (i < n) {
        const kid = listTryGet(kids, i) catch node;
        let align_eff: int = st.align_items;
        if (kid.style.align_self >= 0) {
            align_eff = kid.style.align_self;
        }
        const m_before: int = marginCrossBefore(st.direction, kid.style.margin);
        const m_after: int = marginCrossAfter(st.direction, kid.style.margin);
        let cs: int = listTryGet(cross_bases, i) catch 0;
        if (align_eff == ALIGN_STRETCH && crossIsAuto(kid.style, is_row)) {
            cs = cross_content - m_before - m_after;
            cs = clampCross(kid.style, is_row, cs);
        }
        let cp: int = content_origin_cross + m_before;
        if (align_eff == ALIGN_FLEX_END) {
            cp = content_origin_cross + cross_content - m_after - cs;
        } else if (align_eff == ALIGN_CENTER) {
            cp = content_origin_cross + divFloor(cross_content - m_before - m_after - cs, 2);
        }

        let bx: int = listTryGet(positions, i) catch 0;
        let by: int = cp;
        let bw: int = listTryGet(targets, i) catch 0;
        let bh: int = cs;
        if (!is_row) {
            bx = cp;
            by = listTryGet(positions, i) catch 0;
            bw = cs;
            bh = listTryGet(targets, i) catch 0;
        }

        listPush(out, new LayoutBox { x: bx, y: by, w: bw, h: bh });
        layoutChildren(kid, out, new LayoutBox { x: bx, y: by, w: bw, h: bh });
        i = i + 1;
    }
}

// ============================================================================
// 组件写回面（App/pump onResize 自动重排的消费形态）：调用方每
// 脏帧以当前 app.w/h 重解算（resize 即失效——pump 已更新根尺寸并分发
// onResize），再按 preorder 序把盒几何写回组件 x/y/w/h。
// ============================================================================

/// 按序取盒（越界回退零盒——调用方计数错位时的确定性兜底）。
export function boxAt(boxes: List<Ref<LayoutBox>>, i: int): Ref<LayoutBox> {
    return listTryGet(boxes, i) catch new LayoutBox { x: 0, y: 0, w: 0, h: 0 };
}
