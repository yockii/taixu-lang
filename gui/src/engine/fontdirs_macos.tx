// engine/fontdirs_macos —— macOS 的系统字体目录：/System/Library/Fonts（含 Supplemental 子目录）、
// 系统按需下载的字体资产（/System/Library/AssetsV2/com_apple_MobileAsset_Font<版本>，苹方等在这里）、
// /Library/Fonts 与 ~/Library/Fonts，都递归（以“/”结尾）。
import { getenv } from "std/os";
import { readDir } from "std/fs";
import { byteSlice } from "./bin";

const ASSETS: string = "/System/Library/AssetsV2";
const FONT_ASSET: string = "com_apple_MobileAsset_Font";

export function fontDirs(): List<string> {
    const out: List<string> = listNew();
    listPush(out, "/System/Library/Fonts/");
    const none: List<string> = listNew();
    const assets: List<string> = readDir(ASSETS) catch none;
    for (name in assets) {
        if (len(name) > len(FONT_ASSET) && byteSlice(name, 0, len(FONT_ASSET)) == FONT_ASSET) {
            listPush(out, ASSETS + "/" + name + "/");
        }
    }
    listPush(out, "/Library/Fonts/");
    const home: string = getenv("HOME");
    if (len(home) > 0) {
        listPush(out, home + "/Library/Fonts/");
    }
    return out;
}
