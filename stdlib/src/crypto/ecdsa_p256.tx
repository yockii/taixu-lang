// ECDSA-P256 验签，严格 DER 的两个正整数；不提供私钥签名。
import { p256Hex, p256Prime, p256Order, p256Decode, p256Encode, p256Mul, p256Inverse } from "./p256_field";
import { p256DecodePoint, p256Less, p256Base, p256Multiply, p256PointAdd, p256Affine } from "./p256_point";
import { sha256Sum } from "../hash";
import { constantTimeEqual } from "./subtle";

struct Signature { r: Bytes, s: Bytes }
function at(data: Bytes, i: int): int { return bytesGet(data, i) catch panic("ecdsa: internal signature bounds"); }

function integer(data: Bytes, start: int, length: int): Bytes | Error {
    if (length < 1 || length > 33 || start < 0 || start > bytesLen(data) - length || at(data, start) >= 128) { return err("ecdsa: invalid DER integer"); }
    let offset = start; let count = length;
    if (at(data, offset) == 0) {
        if (count == 1 || at(data, offset + 1) < 128) { return err("ecdsa: zero or redundant DER integer"); }
        offset = offset + 1; count = count - 1;
    }
    if (count > 32) { return err("ecdsa: oversized integer"); }
    const out = bytesNew(32); bytesCopy(out, 32 - count, data, offset, count);
    if (!p256Less(out, p256Hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"))) { return err("ecdsa: integer outside 1..n-1"); }
    return out;
}

function pair(data: Bytes): Signature | Error {
    const n = bytesLen(data);
    if (n < 8 || n > 72 || at(data, 0) != 48 || at(data, 1) != n - 2 || at(data, 2) != 2) { return err("ecdsa: invalid DER sequence"); }
    const rlen = at(data, 3); const next = 4 + rlen;
    if (next > n - 3 || at(data, next) != 2) { return err("ecdsa: invalid DER pair"); }
    const slen = at(data, next + 1);
    if (slen != n - next - 2) { return err("ecdsa: trailing or truncated DER"); }
    return Signature { r: integer(data, 4, rlen)?, s: integer(data, next + 2, slen)? };
}

export function ecdsaP256VerifyDigest(peer: Bytes, digest: Bytes, signature: Bytes): bool | Error {
    if (bytesLen(digest) < 1 || bytesLen(digest) > 64) { return err("ecdsa: unsupported digest length"); }
    const prime = p256Prime(); const point = p256DecodePoint(prime, peer)?;
    const sig = pair(signature) catch (e) { return false; };
    const order = p256Order(); const inverse = p256Inverse(order, p256Decode(order, sig.s));
    let hash = digest; if (bytesLen(hash) > 32) { hash = bytesSlice(hash, 0, 32); }
    const u1 = p256Encode(order, p256Mul(order, p256Decode(order, hash), inverse));
    const u2 = p256Encode(order, p256Mul(order, p256Decode(order, sig.r), inverse));
    const sum = p256PointAdd(prime, p256Multiply(prime, p256Base(prime), u1), p256Multiply(prime, point, u2));
    const result = p256Affine(prime, sum) catch (e) { return false; };
    return constantTimeEqual(p256Encode(order, p256Decode(order, result.x)), sig.r);
}

export function ecdsaP256Sha256Verify(peer: Bytes, message: Bytes, signature: Bytes): bool | Error { return ecdsaP256VerifyDigest(peer, sha256Sum(message), signature); }
