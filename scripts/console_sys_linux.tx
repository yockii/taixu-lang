// 控制台门的 Linux 系统原语（console_os_unix.tx 用；导出面同 console_sys_macos.tx）：from syscall，不依赖 libc。打开标志与 ioctl
// 号取 asm-generic 的值，x86_64 与 aarch64、loongarch64、riscv64 相同。
declare function lxOpenat(dir: int, path: string, flags: int, mode: int): int from syscall "openat";
declare function lxIoctl(fd: int, req: int, arg: Bytes): int from syscall "ioctl";
declare function lxPpoll(fds: Bytes, n: int, timeout: Bytes, mask: int, size: int): int from syscall "ppoll";
declare function lxRead(fd: int, buf: Bytes, n: int): int from syscall "read";
declare function lxClose(fd: int): int from syscall "close";
declare function lxSetsid(): int from syscall "setsid";

const AT_FDCWD: int = -100;
// O_RDWR｜O_NOCTTY｜O_CLOEXEC。
const OPEN_PTY: int = 524546;
const TIOCSPTLCK: int = 1074025521;
const TIOCGPTN: int = 2147767344;
const TCGETS: int = 21505;
const POLLIN: int = 1;

export const EIO: int = 5;
export const EINTR: int = 4;

// 一对 PTY：主端、从端与从端的路径。
export struct Pty {
    master: int,
    slave: int,
    path: string,
}

// 开 /dev/ptmx、解锁、取从端号并打开从端（同 os.openpty）。
export function ptyOpen(): Ref<Pty> | Error {
    const master = lxOpenat(AT_FDCWD, "/dev/ptmx", OPEN_PTY, 0);
    if (master < 0) {
        return err("open /dev/ptmx failed: errno " + toStr(-master));
    }
    const unlock = bytesNew(4);
    const a = lxIoctl(master, TIOCSPTLCK, unlock);
    const num = bytesNew(4);
    const b = lxIoctl(master, TIOCGPTN, num);
    if (a != 0 || b != 0) {
        const c = lxClose(master);
        return err("unlocking the PTY failed: errno " + toStr(-a) + "/" + toStr(-b));
    }
    const path = "/dev/pts/" + toStr((bytesGetLE<u32>(num, 0) ?? 0) as int);
    const slave = lxOpenat(AT_FDCWD, path, OPEN_PTY, 0);
    if (slave < 0) {
        const c = lxClose(master);
        return err("open " + path + " failed: errno " + toStr(-slave));
    }
    return new Pty { master: master, slave: slave, path: path };
}

// 等 fd 可读至多 ms 毫秒：可读（含挂断）为正，超时 0，出错为 −errno。
export function waitReadable(fd: int, ms: int): int {
    const fds = bytesNew(8);
    bytesSetLE<i32>(fds, 0, fd as i32);
    bytesSetLE<i16>(fds, 4, POLLIN as i16);
    const ts = bytesNew(16);
    bytesSetLE<int>(ts, 0, ms / 1000);
    bytesSetLE<int>(ts, 8, (ms % 1000) * 1000000);
    return lxPpoll(fds, 1, ts, 0, 8);
}

// 读至多 n 字节：读到的字节数，流尾 0，出错为 −errno。
export function readFd(fd: int, buf: Bytes, n: int): int {
    return lxRead(fd, buf, n);
}

export function closeFd(fd: int): void {
    const c = lxClose(fd);
}

// 自成会话（同 Python 的 start_new_session）；失败为 −errno。
export function newSession(): int {
    return lxSetsid();
}

// 描述符 n 是不是终端（同 isatty：TCGETS 成功）。
export function isTty(n: int): bool {
    const t = bytesNew(64);
    return lxIoctl(n, TCGETS, t) == 0;
}
