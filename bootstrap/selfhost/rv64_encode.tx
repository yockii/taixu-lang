// RISC-V RV64G 指令编码。
// 指令定长 32 位（不出压缩指令）：opcode 6:0、rd 11:7、funct3 14:12、rs1 19:15、rs2 24:20、funct7 31:25，立即数按格式散在各处；
// 每种格式一个纯函数，收操作码常量（opcode、funct3、funct7 等固定位已并入）与字段，返回编码字，字段编不出时返回 -1，不悄悄改写。
// 合法化（大常数、大偏移、远跳）在上一层做。寄存器参数是编码号 0..31（通用 x0..x31、浮点 f0..f31）；偏移一律是相对本条指令的
// 字节数。浮点的舍入方式并在操作码里（运算与转换为 dyn，转整数为 rtz）。
// 只收后端用到的子集：RV64IMAFD 的一部分，不收 C、Zba／Zbb、V，也不收融合乘加（不做 a*b+c 的隐式融合）。
// 校验：tests/rv64/encodings.txt（scripts/rv64_encodings.tx 交 LLVM 与 GNU as 两家汇编器生成，两边须一致）经
// bootstrap/rv64_encode_probe.tx 逐条核对；指令表（助记符、格式、寄存器类别）在 rv64_disasm.tx，表项引用这里的常量。

// ---------------------------------------------------------------- 格式
export const RV64_F_R: int = 1; // op rd, rs1, rs2
export const RV64_F_R2: int = 2; // op rd, rs1（rs2 并在操作码里：浮点单源、转换、搬运）
export const RV64_F_I: int = 3; // op rd, rs1, imm12
export const RV64_F_LOAD: int = 4; // op rd, imm12(rs1)（读与 jalr）
export const RV64_F_S: int = 5; // op rs2, imm12(rs1)（写）
export const RV64_F_B: int = 6; // op rs1, rs2, 偏移（偶数，±4 KiB）
export const RV64_F_U: int = 7; // op rd, imm20（lui、auipc；0..1048575）
export const RV64_F_J: int = 8; // jal rd, 偏移（偶数，±1 MiB）
export const RV64_F_SH6: int = 9; // op rd, rs1, shamt（64 位移位，0..63）
export const RV64_F_SH5: int = 10; // op rd, rs1, shamt（32 位移位，0..31）
export const RV64_F_AMO: int = 11; // op rd, rs2, (rs1)（sc 与 amo*，序在操作码里）
export const RV64_F_LR: int = 12; // op rd, (rs1)
export const RV64_F_FENCE: int = 13; // fence pred, succ（各为 iorw 四位）
export const RV64_F_NONE: int = 14; // ecall、ebreak

// ---------------------------------------------------------------- 操作码
// 整数三寄存器（OP 0x33、OP-32 0x3b）
export const RV64_ADD: int = 0x00000033;
export const RV64_SUB: int = 0x40000033;
export const RV64_SLL: int = 0x00001033;
export const RV64_SLT: int = 0x00002033;
export const RV64_SLTU: int = 0x00003033;
export const RV64_XOR: int = 0x00004033;
export const RV64_SRL: int = 0x00005033;
export const RV64_SRA: int = 0x40005033;
export const RV64_OR: int = 0x00006033;
export const RV64_AND: int = 0x00007033;
export const RV64_MUL: int = 0x02000033;
export const RV64_MULH: int = 0x02001033;
export const RV64_MULHSU: int = 0x02002033;
export const RV64_MULHU: int = 0x02003033;
export const RV64_DIV: int = 0x02004033;
export const RV64_DIVU: int = 0x02005033;
export const RV64_REM: int = 0x02006033;
export const RV64_REMU: int = 0x02007033;
export const RV64_ADDW: int = 0x0000003b;
export const RV64_SUBW: int = 0x4000003b;
export const RV64_SLLW: int = 0x0000103b;
export const RV64_SRLW: int = 0x0000503b;
export const RV64_SRAW: int = 0x4000503b;
export const RV64_MULW: int = 0x0200003b;
export const RV64_DIVW: int = 0x0200403b;
export const RV64_DIVUW: int = 0x0200503b;
export const RV64_REMW: int = 0x0200603b;
export const RV64_REMUW: int = 0x0200703b;
// 12 位立即数（OP-IMM 0x13、OP-IMM-32 0x1b）与移位
export const RV64_ADDI: int = 0x00000013;
export const RV64_SLTI: int = 0x00002013;
export const RV64_SLTIU: int = 0x00003013;
export const RV64_XORI: int = 0x00004013;
export const RV64_ORI: int = 0x00006013;
export const RV64_ANDI: int = 0x00007013;
export const RV64_SLLI: int = 0x00001013;
export const RV64_SRLI: int = 0x00005013;
export const RV64_SRAI: int = 0x40005013;
export const RV64_ADDIW: int = 0x0000001b;
export const RV64_SLLIW: int = 0x0000101b;
export const RV64_SRLIW: int = 0x0000501b;
export const RV64_SRAIW: int = 0x4000501b;
// 读（LOAD 0x03、LOAD-FP 0x07）与写（STORE 0x23、STORE-FP 0x27）
export const RV64_LB: int = 0x00000003;
export const RV64_LH: int = 0x00001003;
export const RV64_LW: int = 0x00002003;
export const RV64_LD: int = 0x00003003;
export const RV64_LBU: int = 0x00004003;
export const RV64_LHU: int = 0x00005003;
export const RV64_LWU: int = 0x00006003;
export const RV64_FLW: int = 0x00002007;
export const RV64_FLD: int = 0x00003007;
export const RV64_SB: int = 0x00000023;
export const RV64_SH: int = 0x00001023;
export const RV64_SW: int = 0x00002023;
export const RV64_SD: int = 0x00003023;
export const RV64_FSW: int = 0x00002027;
export const RV64_FSD: int = 0x00003027;
// 跳转
export const RV64_BEQ: int = 0x00000063;
export const RV64_BNE: int = 0x00001063;
export const RV64_BLT: int = 0x00004063;
export const RV64_BGE: int = 0x00005063;
export const RV64_BLTU: int = 0x00006063;
export const RV64_BGEU: int = 0x00007063;
export const RV64_JALR: int = 0x00000067;
export const RV64_JAL: int = 0x0000006f;
export const RV64_LUI: int = 0x00000037;
export const RV64_AUIPC: int = 0x00000017;
// 系统与屏障
export const RV64_ECALL: int = 0x00000073;
export const RV64_EBREAK: int = 0x00100073;
export const RV64_FENCE: int = 0x0000000f;
// 原子（AMO 0x2f；aq 为第 26 位、rl 为第 25 位，并进操作码）
export const RV64_AQ: int = 0x04000000;
export const RV64_RL: int = 0x02000000;
export const RV64_LR_W: int = 0x1000202f;
export const RV64_LR_D: int = 0x1000302f;
export const RV64_SC_W: int = 0x1800202f;
export const RV64_SC_D: int = 0x1800302f;
export const RV64_AMOSWAP_W: int = 0x0800202f;
export const RV64_AMOSWAP_D: int = 0x0800302f;
export const RV64_AMOADD_W: int = 0x0000202f;
export const RV64_AMOADD_D: int = 0x0000302f;
// 浮点（OP-FP 0x53；双精度运算，单精度只用于搬运与舍入；舍入方式在 14:12，7 为 dyn、1 为 rtz）
export const RV64_FADD_D: int = 0x02007053;
export const RV64_FSUB_D: int = 0x0a007053;
export const RV64_FMUL_D: int = 0x12007053;
export const RV64_FDIV_D: int = 0x1a007053;
export const RV64_FSQRT_D: int = 0x5a007053;
export const RV64_FSGNJ_D: int = 0x22000053;
export const RV64_FSGNJN_D: int = 0x22001053;
export const RV64_FSGNJX_D: int = 0x22002053;
export const RV64_FMIN_D: int = 0x2a000053;
export const RV64_FMAX_D: int = 0x2a001053;
export const RV64_FCVT_S_D: int = 0x40107053;
export const RV64_FCVT_D_S: int = 0x42000053;
export const RV64_FEQ_D: int = 0xa2002053;
export const RV64_FLT_D: int = 0xa2001053;
export const RV64_FLE_D: int = 0xa2000053;
export const RV64_FCVT_L_D: int = 0xc2201053;
export const RV64_FCVT_D_L: int = 0xd2207053;
export const RV64_FMV_X_D: int = 0xe2000053;
export const RV64_FMV_D_X: int = 0xf2000053;
export const RV64_FMV_X_W: int = 0xe0000053;
export const RV64_FMV_W_X: int = 0xf0000053;
export const RV64_FCLASS_D: int = 0xe2001053;

// 寄存器号（psABI 的角色名）。
export const RV64_ZERO: int = 0;
export const RV64_RA: int = 1;
export const RV64_SP: int = 2;
export const RV64_GP: int = 3;
export const RV64_TP: int = 4;
export const RV64_T0: int = 5;
export const RV64_FP: int = 8;
export const RV64_S1: int = 9;
export const RV64_A0: int = 10;

function isReg(r: int): bool { return r >= 0 && r <= 31; }
function fits(v: int, lo: int, hi: int): bool { return v >= lo && v <= hi; }

/// op rd, rs1, rs2：三寄存器（整数、浮点运算与比较，寄存器类别随指令）。
export function rv64R(op: int, rd: int, rs1: int, rs2: int): int {
    if (!isReg(rd) || !isReg(rs1) || !isReg(rs2)) { return -1; }
    return op | (rs2 << 20) | (rs1 << 15) | (rd << 7);
}
/// op rd, rs1：rs2 字段并在操作码里（fsqrt.d、fcvt.*、fmv.*、fclass.d）。
export function rv64R2(op: int, rd: int, rs1: int): int {
    if (!isReg(rd) || !isReg(rs1)) { return -1; }
    return op | (rs1 << 15) | (rd << 7);
}
/// op rd, rs1, imm：有符号 12 位立即数（OP-IMM、读、jalr）。
export function rv64I(op: int, rd: int, rs1: int, imm: int): int {
    if (!isReg(rd) || !isReg(rs1) || !fits(imm, -2048, 2047)) { return -1; }
    return op | ((imm & 4095) << 20) | (rs1 << 15) | (rd << 7);
}
/// op rs2, imm(rs1)：写，有符号 12 位偏移拆在 31:25 与 11:7。
export function rv64S(op: int, rs2: int, rs1: int, imm: int): int {
    if (!isReg(rs2) || !isReg(rs1) || !fits(imm, -2048, 2047)) { return -1; }
    const v = imm & 4095;
    return op | ((v >>> 5) << 25) | (rs2 << 20) | (rs1 << 15) | ((v & 31) << 7);
}
/// beq／bne／blt／bge／bltu／bgeu rs1, rs2, 偏移：偶数，−4096..4094；imm[12|10:5] 在 31:25，imm[4:1|11] 在 11:7。
export function rv64B(op: int, rs1: int, rs2: int, offset: int): int {
    if (!isReg(rs1) || !isReg(rs2) || offset % 2 != 0 || !fits(offset, -4096, 4094)) { return -1; }
    const v = offset & 8191;
    const hi = (((v >>> 12) & 1) << 6) | ((v >>> 5) & 63);
    const lo = (((v >>> 1) & 15) << 1) | ((v >>> 11) & 1);
    return op | (hi << 25) | (rs2 << 20) | (rs1 << 15) | (lo << 7);
}
/// lui／auipc rd, imm20：高 20 位，0..1048575（auipc 的有符号页差由调用方按 20 位取补）。
export function rv64U(op: int, rd: int, imm20: int): int {
    if (!isReg(rd) || !fits(imm20, 0, 1048575)) { return -1; }
    return op | (imm20 << 12) | (rd << 7);
}
/// jal rd, 偏移：偶数，±1 MiB；imm[20|10:1|11|19:12] 在 31:12。
export function rv64J(rd: int, offset: int): int {
    if (!isReg(rd) || offset % 2 != 0 || !fits(offset, -1048576, 1048574)) { return -1; }
    const v = offset & 2097151;
    const f = (((v >>> 20) & 1) << 19) | (((v >>> 1) & 1023) << 9) | (((v >>> 11) & 1) << 8) | ((v >>> 12) & 255);
    return RV64_JAL | (f << 12) | (rd << 7);
}
/// op rd, rs1, shamt：移位立即数，width 64（0..63，slli／srli／srai）或 32（0..31，*iw）。
export function rv64Shift(op: int, rd: int, rs1: int, shamt: int, width: int): int {
    if (!isReg(rd) || !isReg(rs1) || !(width == 32 || width == 64) || !fits(shamt, 0, width - 1)) { return -1; }
    return op | (shamt << 20) | (rs1 << 15) | (rd << 7);
}
/// sc／amo* rd, rs2, (rs1)：[rs1] 的旧值（sc 为成败）进 rd；序（aq、rl）在操作码里。
export function rv64Amo(op: int, rd: int, rs2: int, rs1: int): int {
    if (!isReg(rd) || !isReg(rs2) || !isReg(rs1)) { return -1; }
    return op | (rs2 << 20) | (rs1 << 15) | (rd << 7);
}
/// lr rd, (rs1)。
export function rv64Lr(op: int, rd: int, rs1: int): int {
    if (!isReg(rd) || !isReg(rs1)) { return -1; }
    return op | (rs1 << 15) | (rd << 7);
}
/// fence pred, succ：各为 i(8) o(4) r(2) w(1) 的组合，1..15（0 不是有意义的屏障，拒绝）。
export function rv64Fence(pred: int, succ: int): int {
    if (!fits(pred, 1, 15) || !fits(succ, 1, 15)) { return -1; }
    return RV64_FENCE | (pred << 24) | (succ << 20);
}
