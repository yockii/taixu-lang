// mcp_reaper_linux.tx 用的系统调用（x86_64 的号）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux 与 _linux_aarch64
// 两个文件（导出面相同）；种子换代后改成 from syscall "名字" 合成一份。
declare function sysReapPrctl(option: i32, arg: usize, b: usize, c: usize, d: usize): i32 from syscall 157;
declare function sysReapPrctlRead(option: i32, arg: Bytes, b: usize, c: usize, d: usize): i32 from syscall 157;
declare function sysReapGetPid(): i32 from syscall 39;
declare function sysReapWaitId(kind: i32, id: i32, info: Bytes, options: i32, usage: usize): i32 from syscall 247;
declare function sysReapWaitPid(pid: i32, status: Bytes, options: i32, usage: usize): i32 from syscall 61;
declare function sysReapSignalAction(signal: i32, action: Bytes, previous: usize, size: usize): i32 from syscall 13;
declare function sysReapOpen(dir: i32, path: string, flags: i32, mode: u32): i32 from syscall 257;
declare function sysReapRead(fd: i32, buf: Bytes, n: usize): i64 from syscall 0;
declare function sysReapClose(fd: i32): i32 from syscall 3;
declare function sysReapKill(pid: i32, signal: i32): i32 from syscall 62;

export function reapPrctl(option: i32, arg: usize, b: usize, c: usize, d: usize): i32 { return sysReapPrctl(option, arg, b, c, d); }
export function reapPrctlRead(option: i32, arg: Bytes, b: usize, c: usize, d: usize): i32 { return sysReapPrctlRead(option, arg, b, c, d); }
export function reapGetPid(): i32 { return sysReapGetPid(); }
export function reapWaitId(kind: i32, id: i32, info: Bytes, options: i32, usage: usize): i32 { return sysReapWaitId(kind, id, info, options, usage); }
export function reapWaitPid(pid: i32, status: Bytes, options: i32, usage: usize): i32 { return sysReapWaitPid(pid, status, options, usage); }
export function reapSignalAction(signal: i32, action: Bytes, previous: usize, size: usize): i32 { return sysReapSignalAction(signal, action, previous, size); }
export function reapOpen(dir: i32, path: string, flags: i32, mode: u32): i32 { return sysReapOpen(dir, path, flags, mode); }
export function reapRead(fd: i32, buf: Bytes, n: usize): i64 { return sysReapRead(fd, buf, n); }
export function reapClose(fd: i32): i32 { return sysReapClose(fd); }
export function reapKill(pid: i32, signal: i32): i32 { return sysReapKill(pid, signal); }
