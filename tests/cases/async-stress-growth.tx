// 原生异步压力：任务表/就绪队/观察集/定时器多次扩容；唤醒序与 VM 逐字节对照。
let hub: List<Future<int>> = listNew();

function main(args: []string): int {
    let i = 0;
    while (i < 300) {
        listPush(hub, worker(i));
        i = i + 1;
    }
    const s = summer();
    const any = picker();
    const z = sleepers(s);
    print("spawned " + toStr(listLen(hub)));
    return 0;
}

async function worker(n: int): int {
    if (n % 3 == 0) {
        await sleepMs(0) catch (e) {
            return -1;
        };
    }
    if (n > 0 && n % 7 == 0) {
        const prev = (listGet(hub, n - 1) catch err("none"))?;
        const v = await prev catch -2;
        return v + n;
    }
    return n;
}

async function summer(): int {
    let total = 0;
    let i = 0;
    while (i < listLen(hub)) {
        if (i % 7 != 6 && i < 250) {
            const f = (listGet(hub, i) catch err("none"))?;
            const v = await f catch 0;
            total = total + v;
        }
        i = i + 1;
    }
    print("total " + toStr(total));
    return total;
}

async function picker(): int {
    const l: List<Future<int>> = listNew();
    let i = 299;
    while (i >= 250) {
        listPush(l, (listGet(hub, i) catch err("none"))?);
        i = i - 1;
    }
    const k = taskAwaitAny(l) catch -1;
    print("first " + toStr(k));
    return k;
}

async function sleepers(total: Future<int>): int {
    const fs: List<Future<void>> = listNew();
    let i = 0;
    while (i < 40) {
        listPush(fs, sleepMs(i % 4));
        i = i + 1;
    }
    let j = 39;
    while (j >= 0) {
        const f = (listGet(fs, j) catch err("none"))?;
        await f catch (e) {
            return -1;
        };
        j = j - 1;
    }
    // 定时器就绪不保证其他任务先完成；以依赖固定 golden 的打印顺序。
    const done = await total catch -1;
    print("slept");
    return 0;
}
