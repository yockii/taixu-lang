import { RsaPublicKey, rsaPublicKey, rsaPublicKeyLimit, rsaPssSha256Verify, rsaPkcs1Sha256Verify } from "std/crypto/rsa";
import { rsaDecode, rsaEncode, rsaNprime, rsaR2, rsaModPow } from "std/crypto/rsa_math";
import { constantTimeEqual } from "std/crypto/subtle";
import { parseInt } from "std/strconv";

function hex(text: string): Bytes {
    if (text == "-") { return bytesNew(0); }
    const out = bytesNew(len(text) / 2); let i = 0;
    while (i < bytesLen(out)) {
        const a = byteAt(text, i * 2); const b = byteAt(text, i * 2 + 1);
        let av = a - 48; let bv = b - 48;
        if (a >= 97) { av = a - 87; } if (b >= 97) { bv = b - 87; }
        assert(av >= 0 && av < 16 && bv >= 0 && bv < 16, "fixture hex"); bytesSet(out, i, av * 16 + bv); i = i + 1;
    }
    return out;
}

function number(text: string): int { return parseInt(text) catch panic("fixture integer"); }

test "RSA 数学：独立模幂、进位与非整分量边界" {
    const fixture = readFile("tests/vectors/crypto-rsa.txt") catch panic("RSA fixture"); let count = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " ");
        if (listGet(p, 0) != "math") { continue; }
        const modulus = hex(listGet(p, 1)); const exponent = number(listGet(p, 2)); const input = hex(listGet(p, 3));
        const n = rsaDecode(modulus, (bytesLen(modulus) * 8 + 14) / 15);
        const result = rsaModPow(rsaDecode(input, listLen(n)), exponent, n, rsaNprime(n), rsaR2(n));
        assert(constantTimeEqual(rsaEncode(result, bytesLen(modulus)), hex(listGet(p, 4))), "pow " + toStr(count)); count = count + 1;
    }
    assert(count == 32, "all math vectors");
}

test "RSA 验签：OpenSSL PSS、v1.5 与恶意编码" {
    const fixture = readFile("tests/vectors/crypto-rsa.txt") catch panic("RSA fixture");
    let current: Ref<RsaPublicKey>? = None; let keys = 0; let pss = 0; let v15 = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const kind = listGet(p, 0);
        if (kind == "math") { continue; }
        if (kind == "key") {
            const modulus = hex(listGet(p, 1));
            current = rsaPublicKey(modulus, number(listGet(p, 2))) catch panic("RSA public key");
            const key = current catch panic("key"); const original = bytesSlice(key.modulus, 0, bytesLen(key.modulus));
            bytesSet(modulus, 0, 0); assert(constantTimeEqual(key.modulus, original), "public key owns modulus copy"); keys = keys + 1;
            assert(!rsaPssSha256Verify(key, bytesNew(0), key.modulus) && !rsaPkcs1Sha256Verify(key, bytesNew(0), key.modulus), "signature >= modulus");
            assert(!rsaPssSha256Verify(key, bytesNew(0), bytesNew(0)) && !rsaPkcs1Sha256Verify(key, bytesNew(0), bytesNew(1)), "signature length");
        } else {
            const key = current catch panic("missing fixture key"); const message = hex(listGet(p, 2)); const signature = hex(listGet(p, 3));
            const original = bytesSlice(signature, 0, bytesLen(signature)); const expected = listGet(p, 1) == "1";
            if (kind == "pss") { assert(rsaPssSha256Verify(key, message, signature) == expected, "PSS " + toStr(pss)); pss = pss + 1; }
            else { assert(kind == "v15", "fixture kind"); assert(rsaPkcs1Sha256Verify(key, message, signature) == expected, "v1.5 " + toStr(v15)); v15 = v15 + 1; }
            assert(constantTimeEqual(signature, original), "signature input unchanged");
        }
    }
    assert(keys == 5 && pss == 55 && v15 == 60, "complete signature vectors");
}

function rejects(modulus: Bytes, exponent: int, maxBits: int): bool { rsaPublicKeyLimit(modulus, exponent, maxBits) catch (e) { return true; }; return false; }

test "RSA 公钥：位数、奇数、指数与资源上限" {
    const modulus = bytesNew(128); bytesSet(modulus, 0, 128); bytesSet(modulus, 127, 1);
    assert(rejects(bytesNew(0), 65537, 8192) && rejects(bytesNew(127), 65537, 8192), "short key");
    assert(rejects(modulus, 1, 8192) && rejects(modulus, 2, 8192) && rejects(modulus, 2147483648, 8192), "bad exponent");
    assert(rejects(modulus, 65537, 1023) && rejects(modulus, 65537, 1048577), "resource parameter bounds");
    const even = bytesSlice(modulus, 0, 128); bytesSet(even, 127, 0);
    assert(rejects(even, 65537, 8192), "even modulus");
    const small = bytesSlice(modulus, 0, 128); bytesSet(small, 0, 127);
    assert(rejects(small, 65537, 8192), "less than 1024 bits");
    bytesSet(small, 0, 0); assert(rejects(small, 65537, 8192), "leading zero");
    const huge = bytesNew(1025); bytesSet(huge, 0, 1); bytesSet(huge, 1024, 1);
    assert(rejects(huge, 65537, 8192), "default cap before precomputation");
    const key = rsaPublicKeyLimit(modulus, 3, 1024) catch panic("exact bit cap"); assert(key.bits == 1024, "exact cap accepted");
}
