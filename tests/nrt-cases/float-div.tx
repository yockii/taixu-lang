// float 除法（IEEE 双精度，就近舍入）：除零得 ±inf，0/0 得 nan，不陷入；整数除法的陷入不受影响（int-div-* 用例）。
// 两侧静态都是 float 时生成代码直接出浮点除（运行段 div_f 或 lop div 的 typed 臂），静态类型不确定时走动态分派的 float 分支，
// 三条路径结果须逐位相同。nan 的位模式随架构不同（x86 的缺省 nan 带符号位），只打印 toStr 与自比较。
function fdiv(a: float, b: float): float { return a / b; }

function bits(x: float): string {
    if (x != x) { return "nan"; }
    return toStr(floatToBits(x));
}

// 运行段：循环体里全是值形操作，商与累加量留在寄存器里。
function leibniz(n: int): float {
    let x = 1.0;
    let pi = 1.0;
    let i = 2.0;
    const stop = (n + 2) as float;
    while (i <= stop) {
        x = -x;
        pi = pi + x / (2.0 * i - 1.0);
        i = i + 1.0;
    }
    return pi * 4.0;
}

export function main(args: []string): int {
    const z = 0.0;
    const one = 1.0;
    const cases = [1.0, -1.0, 0.0, -z, 3.0, 1.0e308, 1.0e-308, 5.0e-324, one / z, -one / z];
    const ds = [3.0, -3.0, z, -z, 1.0e-308, 1.0e308, 2.0, 0.5, one / z, 7.0];
    // 静态类型已知（形参有类型）与动态（数组元素经下标取出）两条路径逐项对照。
    let i = 0;
    let line = "";
    let mismatch = 0;
    while (i < len(cases)) {
        let j = 0;
        while (j < len(ds)) {
            const a = cases[i];
            const b = ds[j];
            const s = fdiv(a, b);
            const d = cases[i] / ds[j];
            if (bits(s) != bits(d)) { mismatch = mismatch + 1; }
            if (j == 0) { line = bits(s); } else { line = line + " " + bits(s); }
            j = j + 1;
        }
        print(line);
        i = i + 1;
    }
    print("mismatch " + toStr(mismatch));
    print(toStr(one / z) + " " + toStr(-one / z) + " " + toStr(z / z) + " " + toStr((z / z) != (z / z)));
    print(toStr(one / -z) + " " + bits(one / (one / z)) + " " + bits(-one / (one / z)) + " " + bits(z / -one));
    print(toStr(leibniz(1000000)));
    return 0;
}
