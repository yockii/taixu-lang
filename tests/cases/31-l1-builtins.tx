// LANG-11 正向全景（V0.21-L1；D57 §一）：List 删除/插入＋string 码元子串/
// 查找/分割＋errMsg 六内建——两执行面（interp/AOT）逐字节一致。
export function main(args: []string): int {
    // —— listRemoveAt / listInsert（G1 feedback #2：todo 删行样板根除）——
    const xs: List<int> = listNew();
    let i: int = 0;
    while (i < 5) {
        listPush(xs, i * 10);
        i = i + 1;
    }
    listRemoveAt(xs, 2); // [0,10,30,40]
    listInsert(xs, 1, 99); // [0,99,10,30,40]
    let acc: int = 0;
    i = 0;
    while (i < listLen(xs)) {
        acc = acc * 100 + (listGet(xs, i) catch -1);
        i = i + 1;
    }
    print(toStr(acc)); // 099103040 → 99103040
    listInsert(xs, listLen(xs), 50); // 尾加位（i==len）
    print(toStr(listGet(xs, 5) catch -1)); // 50

    // —— strSub / strIndexOf / strSplit（码元面：CJK 拆字节根除）——
    const s: string = "héllo世界";
    print(strSub(s, 1, 4)); // éllo（é 为双字节——码元语义不拆字节）
    print(toStr(strIndexOf(s, "界"))); // 6（码元索引）
    print(toStr(strIndexOf(s, "zz"))); // -1（缺席）
    print(toStr(strIndexOf(s, ""))); // 0（空针）
    const parts: List<string> = strSplit("a,太,虚,c", ",");
    print(toStr(listLen(parts))); // 4
    print(strSub(listGet(parts, 1) catch "", 0, 1)); // 太
    const bare: List<string> = strSplit("x,,y", ",");
    print(toStr(len(listGet(bare, 1) catch "?"))); // 0（连续分隔符产空片——len 为字节长）
    return 0;
}
