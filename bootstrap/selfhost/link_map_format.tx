// Formatting shared by symbol and function views; all facts stay in link_map_data.
export function mapHex(v: int): string {
    const digits = "0123456789abcdef"; let out = "0x"; let shift = 60;
    while (shift >= 0) { out = out + strSub(digits, (v >>> shift) & 15, 1); shift = shift - 4; } return out;
}
export function mapJoin(xs: List<string>, lo: int, hi: int): string {
    if (hi <= lo) { return ""; } if (hi - lo == 1) { return listGet(xs, lo) catch ""; }
    const mid = lo + (hi - lo) / 2; return mapJoin(xs, lo, mid) + mapJoin(xs, mid, hi);
}
