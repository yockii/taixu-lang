// macOS 适配 M2（设计稿 F1，伴文件 .macos）：macOS 上 from "库" 须写 dylib 的安装名，Linux 的 soname 报 3033
// （语义分析在第一次调用处检查，诊断落在声明处）；只查被调用的，未调用的 kernel32 声明无害。
declare function getpid(): i32 from "libc.so.6";
declare function unused(): i32 from "kernel32";

function main(args: []string): int {
    print(toStr(getpid()));
    return 0;
}
