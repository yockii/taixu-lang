// D3 v0.22：生成器的元素类型不能是可选类型、void、失败联合、Error 或错误 enum（3032）——
// genNext 以 None 表示取完，失败语义留给将来的可失败生成器。
function* maybe(): int? {
    yield 1;
}

function* nothing(): void {
    return;
}

function* fallible(): int | Error {
    yield 1;
}

function* errors(): Error {
    yield err("x");
}

export function main(args: []string): int {
    return 0;
}
