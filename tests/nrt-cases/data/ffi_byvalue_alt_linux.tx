// ffi-linux-struct-byvalue 的另一组声明（同一个 C 函数在一个模块里只能声明一次；macOS 版见 _macos）：lldiv 的返回布局写成
// 定长数组与按值嵌套、conj 的复数写成 [2]float——与 C 原型 ABI 等价（SysV 按八字节分类），核对按值返回填外壳时的嵌套对象与
// 数组元素。
export declare struct BOX { v: int }
export declare struct QR { q: [1]int, r: BOX }
export declare struct CARR { v: [2]float }
declare function lldiv(a: int, b: int): QR from "libc.so.6";
declare function conj(z: CARR): CARR from "libm.so.6";

export function divNested(a: int, b: int): QR { return lldiv(a, b); }
export function conjArr(z: CARR): CARR { return conj(z); }
