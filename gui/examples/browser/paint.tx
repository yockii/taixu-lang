// Paint into a viewport-sized surface. Scrolling never allocates a page bitmap.
import { PageLayout } from "./layout";
import { textMeasure, textDrawStyled } from "gui/engine/text";
import { surfOk, surfAt, rClear, rFillRect } from "gui/engine/raster";
import { dipToPxK } from "gui/surface";

export function pageMeasure(font: int): (string, int) => int {
    return pageMeasureK(font, 100);
}
export function pageMeasureK(font: int, scale: int): (string, int) => int {
    return (text: string, size: int): int => {
        if (scale < 1 || scale > 1000) { return -1; }
        const pixels = textMeasure(font, dipToPxK(size, scale), text); if (pixels < 0) { return pixels; }
        return (pixels * 100 + scale - 1) / scale;
    };
}
export function pageScroll(page: Ref<PageLayout>, requested: int, viewportHeight: int): int {
    if (viewportHeight < 0 || page.height < 0) { return 0; }
    let maximum = page.height - viewportHeight; if (maximum < 0) { maximum = 0; }
    if (requested < 0) { return 0; } if (requested > maximum) { return maximum; } return requested;
}
export function pagePaint(surface: int, font: int, page: Ref<PageLayout>, scroll: int, scale: int): void | Error {
    if (!surfOk(surface) || scale < 50 || scale > 1000 || scroll < 0 || scroll > 10000000 || listLen(page.commands) > 100000) { return err("browser paint: invalid viewport"); }
    const target = surfAt(surface); const height = (target.h * 100 + scale - 1) / scale; const width = (target.w * 100 + scale - 1) / scale;
    rClear(target, 0xffffff);
    for (c in page.commands) {
        if (c.kind < 0 || c.kind > 1 || c.x < -10000000 || c.x > 10000000 || c.y < -10000000 || c.y > 10000000
            || c.width < 0 || c.width > 1000000 || c.height < 0 || c.height > 10000000 || c.size < 0 || c.size > 256) { return err("browser paint: invalid command geometry"); }
        if (c.y + c.height + c.size < scroll || c.y - c.size > scroll + height || c.x + c.width + c.size < 0 || c.x - c.size > width) { continue; }
        const x = dipToPxK(c.x, scale); const y = dipToPxK(c.y - scroll, scale); const w = dipToPxK(c.width, scale); const h = dipToPxK(c.height, scale);
        if (c.kind == 0) { rFillRect(target, x, y, w, h, c.color); continue; }
        const size = dipToPxK(c.size, scale);
        if (size < 1 || size > 1024) { return err("browser paint: scaled font size limit"); }
        if (c.background >= 0) { rFillRect(target, x, y, w, h, c.background); }
        if (textDrawStyled(surface, font, size, c.text, x, y, c.color, c.bold, c.italic) != 0) { return err("browser paint: font rendering failed"); }
        if (c.underline) { let thickness = dipToPxK(1, scale); if (thickness < 1) { thickness = 1; } rFillRect(target, x, y + dipToPxK(c.size + 1, scale), w, thickness, c.color); }
    } return done();
}
function done(): void {}
