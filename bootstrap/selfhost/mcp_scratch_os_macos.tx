// macOS（M3 设计 G9）：同 Linux 版，经 libSystem；AT_FDCWD −2、AT_REMOVEDIR 0x80，标志位按 macOS 的值。
declare function mkdirat(fd: i32, path: string, mode: u16): i32 from "libSystem";
declare function unlinkat(fd: i32, path: string, flags: i32): i32 from "libSystem";
// openat 是 C 变参函数（定参 3 个）：mode 按变参约定传，Apple arm64 上在栈上（D3 v0.36）。
declare function openat(fd: i32, path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
export function scratchMkdir(path: string): bool { return mkdirat(-2, path, 448) == 0; }
export function scratchRmdir(path: string): bool { return unlinkat(-2, path, 128) == 0; }
export function scratchClaim(path: string): bool {
    const file = openat(-2, path, 16780033, 448); // WRONLY|CREAT|EXCL|NOFOLLOW|CLOEXEC, 0700.
    if (file < 0) { return false; } return close(file) == 0;
}
