// 线程第 2 步（Windows，线程设计 §四-7）：工作线程里调外部函数、经回调回到本线程（qsort 的比较函数，回调
// 窗口每线程一份）、ffiLastError 每线程一份（工作线程里 GetFileAttributesW 查不存在的文件得 ERROR_FILE_NOT_FOUND 2，
// main 自己没调过外部函数仍为 0）。
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "ucrtbase";
declare function RtlMoveMemory(dst: Bytes, src: usize, n: usize): void from "kernel32";
declare function GetFileAttributesW(path: wstr): u32 from "kernel32";
declare function GetCurrentProcessId(): u32 from "kernel32";

let compares = 0;

function u32At(addr: usize): int {
    const tmp = bytesNew(4);
    RtlMoveMemory(tmp, addr, 4);
    return (bytesGet(tmp, 0) catch 0) + (bytesGet(tmp, 1) catch 0) * 256;
}

function byValue(a: usize, b: usize): i32 {
    compares = compares + 1;
    const x = u32At(a);
    const y = u32At(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

function sortInThread(): int {
    const vals = [5, 3, 9, 1, 7, 2];
    const buf = bytesNew(24);
    let i = 0;
    while (i < 6) {
        bytesSet(buf, i * 4, vals[i]);
        i = i + 1;
    }
    qsort(buf, 6, 4, byValue);
    const first = bytesGet(buf, 0) catch -1;
    const last = bytesGet(buf, 20) catch -1;
    if (compares == 0) { return -1; }
    return first * 100 + last;
}

function errInThread(): int {
    GetFileAttributesW("C:\\taixu-no-such-file.txt");
    return ffiLastError();
}

function pidInThread(): bool {
    return GetCurrentProcessId() > 0;
}

function main(args: []string): void {
    print("sorted " + toStr(threadJoin(threadSpawn(sortInThread)) catch -1) + " main compares " + toStr(compares));
    print("error " + toStr(threadJoin(threadSpawn(errInThread)) catch -1) + " main " + toStr(ffiLastError()));
    print("pid " + toStr(threadJoin(threadSpawn(pidInThread)) catch false));
}
