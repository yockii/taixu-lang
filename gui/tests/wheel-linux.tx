// Hidden X11 window; SendEvent packets are returned by the X server.
import { windowOpenEx, windowWaitEvent, windowClose, windowScale, eventWindowTarget, eventWindowX, eventWindowY, eventWindowMods } from "gui/surface";
import { platDebugPost } from "gui/engine/platform";
export function main(args: []string): int {
    const id = windowOpenEx("Taixu hidden wheel", 240, 160, 16); assert(id > 0, "hidden native window");
    const pos = (30 << 16) | 40 | (1 << 32); const k = windowScale(id);
    for (button in [4, 5, 6, 7]) {
        assert(platDebugPost(id, 4, button, pos) == 0, "post button press");
        assert(platDebugPost(id, 5, button, pos) == 0, "post button release");
    }
    let found = 0; let tries = 0;
    while (tries < 64) {
        const kind = windowWaitEvent(id, 100); if (kind == 0) { break; }
        if (kind == 9) {
            let expected = -40; if (found == 1) { expected = 40; }
            assert(found < 2 && eventWindowTarget(id) == expected, "vertical presses only");
            assert(eventWindowX(id) == (4000 + k / 2) / k && eventWindowY(id) == (3000 + k / 2) / k && eventWindowMods(id) == 1, "DIP position and modifiers");
            found = found + 1;
        } tries = tries + 1;
    }
    windowClose(id); assert(found == 2, "up and down without release or horizontal duplicates");
    print("wheel Linux: vertical presses, DIP coordinates and modifiers OK"); return 0;
}
