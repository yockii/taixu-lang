// D3 v0.49 §6.5-4：复合赋值照普通赋值检查目标与类型；for 段里插不进暂存语句，下标含调用时报 3016。
function seven(): int {
    return 7;
}

export function main(args: []string): int {
    args;
    const c: int = 1;
    c += 1;
    let s: string = "a";
    s -= "b";
    let a: [2]int = [1, 2];
    for (let k: int = 0; k < 2; a[seven() - 7] += 1) {
        k += 1;
    }
    return 0;
}
