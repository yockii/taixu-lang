#!/usr/bin/env bash
set -eu
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
# 缺省先 python3 再 python；以能实际运行 Python 3 为准（Windows 的 python3 可能是应用商店占位程序）。
PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  for c in python3 python; do
    if "$c" -c 'import sys; sys.exit(sys.version_info[0] != 3)' >/dev/null 2>&1; then PY="$c"; break; fi
  done
fi
if [ -z "$PY" ]; then
  echo "verify: 找不到 Python 3（可用 PYTHON 指定）" >&2
  exit 2
fi
exec "$PY" "$SELF_DIR/verify.py" "$@"
