declare function tx_xmm_probe(cb: () => void): i32 from "ffi_safety_probe";
declare function tx_xmm_control(bad: i32): i32 from "ffi_safety_probe";
declare function tx_seed(): float from "ffi_safety_probe";
let seed: float = 0.0;
let result: float = 0.0;
function nested(): void { result = compute(seed * 2.0); }
function pressure(): void {
    assert(tx_xmm_probe(nested) == 0, "nested callback preserves callee-saved vector registers");
    result = compute(seed);
}
function compute(s: float): float {
    const a: float = s + 1.0; const b: float = s + 2.0; const c: float = s + 3.0; const d: float = s + 4.0;
    const e: float = s + 5.0; const f: float = s + 6.0; const g: float = s + 7.0; const h: float = s + 8.0;
    return a*b + c*d + e*f + g*h;
}
function main(args: []string): int {
    assert(tx_xmm_control(0) == 0, "no-op control");
    assert(tx_xmm_control(1) == 3, "detect clobber of the first two (xmm6/7, d8/d9)");
    seed = tx_seed();
    let i = 0;
    while (i < 32) { assert(tx_xmm_probe(pressure) == 0, "preserve every callee-saved vector register"); i = i + 1; }
    assert(result == 151.25, "callback executed"); print("PASS_XMM128");
    return 0;
}
