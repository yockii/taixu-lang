// Linux 3.17+。flags=0 等待内核随机源初始化；错误保留负 errno，不退回设备或伪随机。
declare function lxGetrandom(data: Bytes, length: int, flags: int): int from syscall "getrandom";

export function sysRandomRead(data: Bytes, length: int): int {
    if (length < 0 || length > bytesLen(data)) { return -1; }
    if (length == 0) { return 0; }
    return lxGetrandom(data, length, 0);
}
