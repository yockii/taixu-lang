[
  {"name": "geom", "kind": "lsp", "encodings": null, "script": [
    {"open": "lsp-geom.tx"},
    {"open": "lsp-app-main.tx"},
    {"req": "textDocument/documentSymbol", "file": "lsp-app-main.tx"},
    {"req": "textDocument/documentSymbol", "file": "lsp-geom.tx"},
    {"req": "textDocument/hover", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1},
    {"req": "textDocument/hover", "file": "lsp-app-main.tx", "at": "strSplit", "delta": 2},
    {"req": "textDocument/hover", "file": "lsp-geom.tx", "at": "Rect", "delta": 1},
    {"req": "textDocument/hover", "file": "lsp-app-main.tx", "at": "parts", "delta": 1},
    {"req": "textDocument/completion", "file": "lsp-app-main.tx", "at": "return 0", "delta": 3},
    {"req": "textDocument/completion", "file": "lsp-app-main.tx", "at": "strSplit", "delta": 3},
    {"req": "textDocument/definition", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1},
    {"req": "textDocument/definition", "file": "lsp-geom.tx", "at": "Ref<Rect>", "delta": 5},
    {"req": "textDocument/definition", "file": "lsp-app-main.tx", "at": "UNIT + 3", "delta": 1},
    {"req": "textDocument/references", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1, "params": {"context": {"includeDeclaration": true}}},
    {"req": "textDocument/references", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1, "params": {"context": {"includeDeclaration": false}}},
    {"req": "textDocument/rename", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1, "params": {"newName": "measure"}},
    {"req": "textDocument/rename", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1, "params": {"newName": "while"}},
    {"req": "textDocument/signatureHelp", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 5},
    {"req": "textDocument/signatureHelp", "file": "lsp-app-main.tx", "at": "\"|\"", "delta": 0},
    {"req": "textDocument/signatureHelp", "file": "lsp-app-main.tx", "at": "area(r)", "delta": 1},
    {"req": "textDocument/semanticTokens/full", "file": "lsp-app-main.tx"},
    {"req": "textDocument/semanticTokens/full", "file": "lsp-geom.tx"},
    {"req": "textDocument/formatting", "file": "lsp-app-main.tx", "params": {"options": {"tabSize": 4, "insertSpaces": true}}},
    {"req": "shutdown"},
    {"notify": "exit"}
  ]},
  {"name": "zh-utf16", "kind": "lsp", "encodings": ["utf-16"], "script": [
    {"open": "lsp-zh.tx"},
    {"req": "textDocument/documentSymbol", "file": "lsp-zh.tx"},
    {"req": "textDocument/hover", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1},
    {"req": "textDocument/definition", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1},
    {"req": "textDocument/references", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1, "params": {"context": {"includeDeclaration": true}}},
    {"req": "textDocument/rename", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1, "params": {"newName": "measure"}},
    {"req": "textDocument/rename", "file": "lsp-zh.tx", "at": "total = total", "delta": 0, "params": {"newName": "sum"}},
    {"req": "textDocument/signatureHelp", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 5},
    {"req": "textDocument/semanticTokens/full", "file": "lsp-zh.tx"},
    {"req": "textDocument/formatting", "file": "lsp-zh.tx", "params": {"options": {"tabSize": 4, "insertSpaces": true}}},
    {"change": "lsp-zh.tx", "text": "export function f(n: int): int {\n  return n;\n}"},
    {"req": "textDocument/formatting", "file": "lsp-zh.tx", "params": {"options": {"tabSize": 4, "insertSpaces": true}}},
    {"req": "shutdown"},
    {"notify": "exit"}
  ]},
  {"name": "zh-utf8", "kind": "lsp", "encodings": ["utf-8"], "same_as": "zh-utf16"},
  {"name": "zh-default", "kind": "lsp", "encodings": null, "script": [
    {"open": "lsp-zh.tx"},
    {"req": "textDocument/hover", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1},
    {"req": "textDocument/definition", "file": "lsp-zh.tx", "at": "dist(p)))", "delta": 1},
    {"req": "shutdown"},
    {"notify": "exit"}
  ]},
  {"name": "diag-routing", "kind": "lsp", "encodings": ["utf-16"], "script": [
    {"open": "lsp-importer.tx"},
    {"open": "lsp-err.tx"},
    {"change": "lsp-err.tx", "replace": ["const s: string = n;", "const s: int = n;"]},
    {"req": "textDocument/hover", "file": "lsp-importer.tx", "at": "half(4)", "delta": 1},
    {"req": "textDocument/definition", "file": "lsp-importer.tx", "at": "half(4)", "delta": 1},
    {"close": "lsp-err.tx"},
    {"req": "shutdown"},
    {"notify": "exit"}
  ]},
  {"name": "broken", "kind": "lsp", "encodings": ["utf-16"], "script": [
    {"open": "lsp-broken.tx"},
    {"req": "textDocument/documentSymbol", "file": "lsp-broken.tx"},
    {"req": "textDocument/hover", "file": "lsp-broken.tx", "at": "ok(1)", "delta": 0},
    {"req": "textDocument/semanticTokens/full", "file": "lsp-broken.tx"},
    {"req": "textDocument/formatting", "file": "lsp-broken.tx", "params": {"options": {"tabSize": 4, "insertSpaces": true}}},
    {"change": "lsp-broken.tx", "replace": ["return n +;", "return n + 2;"]},
    {"req": "textDocument/references", "file": "lsp-broken.tx", "at": "ok(1)", "delta": 0, "params": {"context": {"includeDeclaration": true}}},
    {"req": "shutdown"},
    {"notify": "exit"}
  ]},
  {"name": "rpc-edge", "kind": "lsp", "encodings": null, "pre_init": [
    {"req": "textDocument/hover", "params": {"textDocument": {"uri": "file:///nowhere.tx"}, "position": {"line": 0, "character": 0}}, "wait": 3}
  ], "script": [
    {"raw": "not json"},
    {"raw": "[1,2]"},
    {"raw": "{\"jsonrpc\":\"2.0\",\"id\":77}"},
    {"req": "$/frobnicate", "wait": 3},
    {"req": "workspace/symbol", "params": {"query": "x"}},
    {"notify": "$/cancelRequest", "params": {"id": 1}},
    {"notify": "workspace/didChangeConfiguration", "params": {"settings": {}}},
    {"open": "lsp-geom.tx"},
    {"change": "lsp-geom.tx", "ranged": {"range": {"start": {"line": 0, "character": 0}, "end": {"line": 0, "character": 0}}, "text": "// x\n"}},
    {"req": "textDocument/documentSymbol", "file": "lsp-geom.tx"},
    {"req": "textDocument/hover", "file": "lsp-geom.tx", "at": "area", "delta": 1, "id": "s1"},
    {"req": "shutdown"},
    {"req": "textDocument/documentSymbol", "file": "lsp-geom.tx", "wait": 3},
    {"notify": "exit"}
  ]},
  {"name": "no-shutdown", "kind": "lsp", "encodings": null, "script": [
    {"open": "lsp-geom.tx"},
    {"notify": "exit"}
  ]},
  {"name": "bad-frame", "kind": "lsp", "encodings": null, "script": [
    {"frame": "Content-Length: abc\r\n\r\n{}"}
  ]},
  {"name": "mcp-core", "kind": "mcp", "script": [
    {"method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "lsp-baseline", "version": "0"}}},
    {"tool": "compile", "arguments": {"path": "lsp-zh.tx"}},
    {"tool": "compile", "arguments": {"path": "<dir>/lsp-app-main.tx"}},
    {"tool": "compile", "arguments": {"path": "<dir>/lsp-err.tx"}},
    {"tool": "compile", "arguments": {"path": "<dir>/lsp-broken.tx"}},
    {"tool": "compile", "arguments": {"path": "<dir>/lsp-importer.tx"}},
    {"tool": "compile", "arguments": {"path": "mcp-tests.tx"}},
    {"tool": "compile", "arguments": {"path": "<dir>/nope.tx"}},
    {"tool": "run", "arguments": {"path": "<dir>/lsp-zh.tx"}},
    {"tool": "run", "arguments": {"path": "<dir>/mcp-args.tx", "args": ["a", "中文 实参"]}},
    {"tool": "run", "arguments": {"path": "<dir>/mcp-args.tx", "args": ["boom"]}},
    {"tool": "run", "arguments": {"path": "<dir>/mcp-loop.tx", "timeout_ms": 500}},
    {"tool": "run", "arguments": {"path": "<dir>/lsp-err.tx"}},
    {"tool": "run", "arguments": {"path": "<dir>/nope.tx"}},
    {"tool": "test", "arguments": {"path": "<dir>/mcp-tests.tx"}},
    {"tool": "test", "arguments": {"path": "<dir>/lsp-err.tx"}},
    {"tool": "compile", "arguments": {}},
    {"tool": "compile", "arguments": {"path": 1}},
    {"tool": "compile", "arguments": {"path": ""}},
    {"tool": "nope", "arguments": {"path": "<dir>/lsp-zh.tx"}}
  ]}
]
