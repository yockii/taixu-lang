// A64 编码表的双向核对（gate.tx 的 a64-encodings 步）：拿
// tests/a64/encodings.txt（独立汇编器生成，见该文件头）逐条核对——bootstrap/a64_encode_probe.tx 核编码函数（文本 → 字节，负例须被
// 拒绝），bootstrap/a64_disasm_probe.tx 核反汇编器（字节 → 文本；另有固定例，子集外的字须得 .inst；再拿随机字段经编码函数编出的字，
// 须都译得出）。表的重新生成要汇编器，不在门里；改了编码器或指令表时在开发仓手动重生成。
// 运行（仓根）：taixu run --toolchain scripts/test_a64_encodings.tx --compiler <taixu> --work <目录> [--root <仓库>]
// 不合时打一行 FAIL 与细节、退出码 1。
import { absolute, exeName, join, mkdirs, nat } from "./build_lib";
import { osRealPath } from "./build_os";
import { lossyText } from "./check_lib";
import { captureRaw } from "./test_lib";
import { byteSub, digits, isSpace, strip, tailChars } from "./test_text";

const SEC: int = 1000000000;
const MAX_OUTPUT: int = 16777216;
// 表的规模下限：防止表被截断或生成时漏了指令而门仍通过。
const MIN_POSITIVE: int = 7000;
const MIN_NEGATIVE: int = 80;
const MIN_FIXED: int = 20;
const MIN_FUZZ: int = 200000;

// 按空白切分（同 Python 的 str.split()）。
function fields(s: string): List<string> {
    const out: List<string> = listNew();
    let cur = bytesNew(0);
    let i = 0;
    while (i <= len(s)) {
        const c = byteAt(s, i) ?? 32;
        if (isSpace(c)) {
            if (bytesLen(cur) > 0) {
                listPush(out, bytesToStr(cur) catch "");
                cur = bytesNew(0);
            }
        } else {
            bytesPush(cur, c);
        }
        i = i + 1;
    }
    return out;
}

struct Out {
    ok: bool,
    text: string,
}

// 在仓根运行，须退出 0；不然打 FAIL 行。
function exec(exe: string, args: List<string>, root: string, what: string): Out | Error {
    const r = captureRaw(exe, args, root, 600 * SEC, 10 * SEC, MAX_OUTPUT)?;
    const text = lossyText(r.out);
    if (r.code != 0 || r.timedOut) {
        print("FAIL  " + what + " exit=" + toStr(r.code) + " " + tailChars(text + lossyText(r.err), 4000));
        return Out { ok: false, text: text };
    }
    return Out { ok: true, text: text };
}

function build(compiler: string, src: string, out: string, root: string): bool | Error {
    const args: List<string> = listNew();
    listPush(args, "build");
    listPush(args, src);
    listPush(args, "--toolchain");
    listPush(args, "--out");
    listPush(args, out);
    const r = exec(compiler, args, root, "build " + src)?;
    return r.ok;
}

function fail(what: string, detail: string): int {
    print("FAIL  " + what + " " + detail);
    return 1;
}

function run(argv: []string): int | Error {
    let compiler = "";
    let work = "";
    let root = "";
    let i = 0;
    while (i + 1 < len(argv)) {
        if (argv[i] == "--compiler") {
            compiler = argv[i + 1];
        } else if (argv[i] == "--work") {
            work = argv[i + 1];
        } else if (argv[i] == "--root") {
            root = argv[i + 1];
        } else {
            return err("未知参数：" + argv[i]);
        }
        i = i + 2;
    }
    if (len(compiler) == 0 || len(work) == 0 || i != len(argv)) {
        return err("用法：taixu run --toolchain scripts/test_a64_encodings.tx --compiler <taixu> --work <目录> [--root <仓库>]");
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = osRealPath(absolute(nat(root)));
    compiler = osRealPath(absolute(nat(compiler)));
    if (!mkdirs(absolute(nat(work)))) {
        return err("建不了工作目录：" + work);
    }
    work = osRealPath(absolute(nat(work)));
    const table = nat(join(root, "tests/a64/encodings.txt"));
    let positive = 0;
    let negative = 0;
    for (line in strSplit(readFile(table)?, "\n")) {
        let l = line;
        if (len(l) > 0 && (byteAt(l, len(l) - 1) ?? 0) == 13) {
            l = byteSub(l, 0, len(l) - 1);
        }
        if (len(l) == 0 || (byteAt(l, 0) ?? 0) == 35) {
            continue;
        }
        if ((byteAt(l, 0) ?? 0) == 33) {
            negative = negative + 1;
        } else {
            positive = positive + 1;
        }
    }

    const enc = nat(join(work, "probe"));
    if (!build(compiler, "bootstrap/a64_encode_probe.tx", enc, root)?) {
        return 1;
    }
    const targs: List<string> = listNew();
    listPush(targs, table);
    const e = exec(nat(join(enc, exeName("a64_encode_probe"))), targs, root, "a64_encode_probe")?;
    if (!e.ok) {
        return 1;
    }
    const ew = fields(e.text);
    if (listLen(ew) != 3 || (listGet(ew, 0) catch "") != "PASS_A64_ENCODINGS") {
        return fail("encodings", "探针输出：" + strip(e.text));
    }
    const p = digits(listGet(ew, 1) catch "");
    const n = digits(listGet(ew, 2) catch "");
    if (p != positive || n != negative) {
        return fail("encodings", "探针核对 " + toStr(p) + "／" + toStr(n) + "，表里 " + toStr(positive) + "／" + toStr(negative));
    }
    if (p < MIN_POSITIVE || n < MIN_NEGATIVE) {
        return fail("encodings", "正例 " + toStr(p) + "（下限 " + toStr(MIN_POSITIVE) + "），负例 " + toStr(n) + "（下限 " + toStr(MIN_NEGATIVE) + "）");
    }
    print("PASS A64 encodings " + toStr(p) + ", rejected " + toStr(n));

    const dis = nat(join(work, "disasm"));
    if (!build(compiler, "bootstrap/a64_disasm_probe.tx", dis, root)?) {
        return 1;
    }
    const dexe = nat(join(dis, exeName("a64_disasm_probe")));
    const d = exec(dexe, targs, root, "a64_disasm_probe")?;
    if (!d.ok) {
        return 1;
    }
    const dw = fields(d.text);
    if (listLen(dw) != 3 || (listGet(dw, 0) catch "") != "PASS_A64_DISASM" || digits(listGet(dw, 1) catch "") != positive
        || digits(listGet(dw, 2) catch "") < MIN_FIXED) {
        return fail("disasm", "探针输出：" + strip(d.text) + "（表里正例 " + toStr(positive) + "，固定例下限 " + toStr(MIN_FIXED) + "）");
    }
    // 编码表之外：随机字段经编码函数编出的字都须反汇编得出（两边子集一致）。
    const fargs: List<string> = listNew();
    listPush(fargs, "--fuzz");
    listPush(fargs, "1");
    listPush(fargs, "280000");
    const f = exec(dexe, fargs, root, "a64_disasm_probe --fuzz")?;
    if (!f.ok) {
        return 1;
    }
    const fw = fields(f.text);
    if (listLen(fw) != 3 || (listGet(fw, 0) catch "") != "FUZZ_A64_DISASM" || digits(listGet(fw, 1) catch "") < MIN_FUZZ
        || (listGet(fw, 2) catch "") != "0") {
        return fail("disasm-fuzz", "探针输出：" + strip(f.text) + "（随机字下限 " + toStr(MIN_FUZZ) + "，须 0 个译不出）");
    }
    print("PASS A64 disasm " + (listGet(dw, 1) catch "") + ", fixed " + (listGet(dw, 2) catch "") + ", fuzz " + (listGet(fw, 1) catch ""));
    return 0;
}

function main(argv: []string): int {
    return run(argv) catch (e) {
        eprint("test_a64_encodings: " + e.message);
        return 1;
    };
}
