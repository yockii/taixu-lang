// D3 v0.49 §6.3-3：catch (e) 块里的 break／continue 只有跳出 catch 外层的循环才算离开——块外无循环、块里另开的循环、
// 闭包体里、只有一个分支离开，都不算。
function parse(s: string): int | Error {
    return len(s);
}

function outside(): int {
    const n: int = parse("a") catch (e) {
        break;
    };
    return n;
}

function inner(xs: List<string>): int {
    let t: int = 0;
    for (x in xs) {
        const n: int = parse(x) catch (e) {
            while (true) {
                break;
            }
        };
        t = t + n;
    }
    return t;
}

function viaClosure(xs: List<string>): int {
    let t: int = 0;
    for (x in xs) {
        const f = (): int => {
            const n: int = parse(x) catch (e) {
                continue;
            };
            return n;
        };
        t = t + f();
    }
    return t;
}

function halfway(xs: List<string>): int {
    let t: int = 0;
    for (x in xs) {
        const n: int = parse(x) catch (e) {
            if (x == "a") {
                continue;
            }
        };
        t = t + n;
    }
    return t;
}

export function main(args: []string): int {
    args;
    return 0;
}
