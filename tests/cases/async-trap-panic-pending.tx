// main 以 panic 结束时只报原错误（退出码 3）。D3 v0.53 起未完成的任务不再是错误（入口返回即取消），原先附在
// trap 文案后的“另有 N 个未决任务”退场（原用例 async-trap-err-exit-pending）。
function main(args: []string): int {
    const a = alpha();
    panic("boom");
    return 0;
}

async function alpha(): int {
    const b = beta();
    const v = await b;
    return v;
}

async function beta(): int {
    let i: int = 0;
    while (i < 1000000) {
        i = i + 1;
    }
    return i;
}
