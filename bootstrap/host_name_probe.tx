import { assembleText, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { coffCaptureAssembler, coffWrite, coffResultOk, coffResultBytes, coffResultError } from "./selfhost/emit_coff_storage";
import { linkExe, linkExeObjects, lkIsFailed, lkGetMissing, exeBytesList } from "./selfhost/link_pe";

function sameBytes(a: List<int>, b: List<int>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) {
        if ((listGet(a, i) catch -1) != (listGet(b, i) catch -2)) { return false; }
        i = i + 1;
    }
    return true;
}
function main(args: []string): int {
    if (len(args) < 3) { eprint("usage: generate asm out [exports...] | link asm coff out"); return 64; }
    const source = readFile(args[1]) catch (e) { eprint(e.message); return 65; };
    assembleText(source);
    if (asFailedAs() != 0) { eprint(asLastErrAs()); return 66; }
    if (args[0] == "generate") {
        const exports: List<string> = listNew();
        let i = 3;
        while (i < len(args)) { listPush(exports, args[i]); i = i + 1; }
        const image = coffCaptureAssembler();
        const firstResult = coffWrite(image, exports);
        if (coffResultOk(firstResult) != 1) { eprint(coffResultError(firstResult)); return 67; }
        const first = coffResultBytes(firstResult);
        const invalid: List<string> = listNew(); listPush(invalid, "");
        const badResult = coffWrite(image, invalid);
        if (coffResultOk(badResult) != 0 || coffResultError(badResult) != "UndefinedExport" || listLen(coffResultBytes(badResult)) != 0) { eprint("BadExportNotRejected"); return 71; }
        assembleText(".text\nother_context:\nret\n");
        const otherImage = coffCaptureAssembler();
        const noExports: List<string> = listNew();
        const otherResult = coffWrite(otherImage, noExports);
        if (coffResultOk(otherResult) != 1) { eprint("OtherContextFailed"); return 72; }
        assembleText(".section .unsupported\n");
        const failedImage = coffCaptureAssembler();
        const failedResult = coffWrite(failedImage, noExports);
        if (coffResultOk(failedResult) != 0 || coffResultError(failedResult) != "AssemblerFailed" || listLen(coffResultBytes(failedResult)) != 0) { eprint("FailedContextAccepted"); return 73; }
        const secondResult = coffWrite(image, exports);
        if (coffResultOk(secondResult) != 1 || !sameBytes(first, coffResultBytes(secondResult))) { eprint("OldInputContextChanged"); return 74; }
        if (coffResultOk(firstResult) != 1 || !sameBytes(first, coffResultBytes(firstResult)) || coffResultError(badResult) != "UndefinedExport") { eprint("OldResultChanged"); return 75; }
        writeFileBytes(args[2], first) catch (e) { eprint(e.message); return 69; };
        return 0;
    }
    if (args[0] == "link" && len(args) == 4) {
        const object = readFile(args[2]) catch (e) { eprint(e.message); return 65; };
        if (linkExe(object, 0) != 0 || lkIsFailed() != 0) { eprint(lkGetMissing()); return 70; }
        writeFileBytes(args[3], exeBytesList()) catch (e) { eprint(e.message); return 69; };
        return 0;
    }
    if (args[0] == "link-many" && len(args) >= 4) {
        const object = readFile(args[2]) catch (e) { eprint(e.message); return 65; };
        const others: List<string> = listNew(); let i = 4;
        while (i < len(args)) { const bytes = readFile(args[i]) catch (e) { eprint(e.message); return 65; }; listPush(others, bytes); i = i + 1; }
        if (linkExeObjects(object, 0, others) != 0 || lkIsFailed() != 0) { eprint(lkGetMissing()); return 70; }
        writeFileBytes(args[3], exeBytesList()) catch (e) { eprint(e.message); return 69; };
        return 0;
    }
    eprint("BadMode"); return 64;
}
