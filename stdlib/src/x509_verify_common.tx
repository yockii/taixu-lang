import { X509Certificate } from "./x509_types";
import { x509ParseCertificate } from "./x509";
import { x509VerifyHostname } from "./x509_names";

// chain[0] 为叶证书，后续仅作不可信的路径候选；roots 不来自服务器。
export function x509CheckServerInputs(chain: List<Bytes>, host: string, roots: List<Bytes>): Ref<X509Certificate> | Error {
    if (listLen(chain) < 1 || listLen(chain) > 16 || listLen(roots) > 4096) { return err("x509: certificate count limit"); }
    let total = 0;
    for (cert in chain) {
        if (bytesLen(cert) < 1 || bytesLen(cert) > 1048576) { return err("x509: certificate size limit"); }
        total = total + bytesLen(cert);
    }
    for (cert in roots) {
        if (bytesLen(cert) < 1 || bytesLen(cert) > 1048576) { return err("x509: root certificate size limit"); }
        total = total + bytesLen(cert);
        if (total > 33554432) { return err("x509: certificate bytes limit"); }
    }
    const leaf = x509ParseCertificate(listGet(chain, 0))?;
    if (!x509VerifyHostname(leaf, host)?) { return err("x509: server identity mismatch"); }
    return leaf;
}
