// 同一检查覆盖 syscall，以及非首个 Bytes 参数和 List<u8> 转换得到的 Bytes。
declare function getcpu(cpu: Bytes, node: Bytes, cache: bool): i32 from syscall 309;

function main(args: []string): void {
    const frozen = sharedGet(sharedNew(bytesAsList(bytesNew(4))));
    getcpu(bytesNew(4), listAsBytes(frozen), false);
    print("unreachable");
}
