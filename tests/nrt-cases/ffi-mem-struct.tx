// D3 v0.48 外部内存区按外部结构体布局读写：ffiMemOf<S> 以布局大小建区；ffiMemGet／ffiMemSet 与 C 布局逐字节对上（嵌套
// 结构体、定长数组、窄整数的符号扩展、f32、f64、u64，按 C 规则的对齐与填充）；区内偏移不要求对齐（奇数偏移）；Set 不动填充字节；
// 同一区上 Get、改字段、Set 往返（WM_GETMINMAXINFO 的写法）。页分配同 ffi-mem（data/ffimem_page_<系统>.tx）。
import { pageAlloc } from "./data/ffimem_page";

// 外部内存区只许在声明了 from 外部函数的模块里创建；只声明不调用的外部函数充当平台层（见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

declare struct PT { x: i32, y: i32 }
declare struct MINMAXINFO { reserved: PT, maxSize: PT, maxPosition: PT, minTrackSize: PT, maxTrackSize: PT }
// a@0 填充@1 b@2 c@4 d@8 e@16..21 填充@22..23 h@24，大小 32。
declare struct MIX { a: u8, b: i16, c: f32, d: f64, e: [3]u16, h: u64 }

function bytesOf(xs: []int): Bytes {
    const out = bytesNew(0);
    for (x in xs) { bytesPush(out, x); }
    return out;
}

function show(b: Bytes): string {
    let s = "";
    let i = 0;
    while (i < bytesLen(b)) {
        if (i > 0) { s = s + " "; }
        s = s + toStr(bytesGet(b, i) catch -1);
        i = i + 1;
    }
    return s;
}

function pt(p: PT): string {
    return "(" + toStr(p.x) + "," + toStr(p.y) + ")";
}

// WM_GETMINMAXINFO 的写法：从 C 交来的地址读出结构体，改两个字段，写回。
function onMinMax(lp: int): int {
    const m = ffiMemOf<MINMAXINFO>(lp, true) catch (e) { return 0; };
    let info = ffiMemGet<MINMAXINFO>(m, 0);
    info.minTrackSize = PT { x: 800, y: 600 };
    info.maxTrackSize.y = info.maxTrackSize.y - 40;
    ffiMemSet<MINMAXINFO>(m, 0, info);
    return 1;
}

function main(args: []string): int {
    const p = pageAlloc();
    if (p == 0) { print("pageAlloc failed"); return 1; }
    const raw = ffiMem(p, 256, true) catch (e) { print("raw: " + e.message); return 1; };
    // maxTrackSize = (1920, 1080)，minTrackSize 先是 (-1, -1)。
    ffiMemWrite(raw, 24, bytesOf([255, 255, 255, 255, 255, 255, 255, 255, 128, 7, 0, 0, 56, 4, 0, 0]));
    print("handled " + toStr(onMinMax(p)));
    const m = ffiMemOf<MINMAXINFO>(p, false) catch (e) { print("of: " + e.message); return 1; };
    const info = ffiMemGet<MINMAXINFO>(m, 0);
    print("min " + pt(info.minTrackSize) + " max " + pt(info.maxTrackSize) + " reserved " + pt(info.reserved));
    print("bytes " + show(ffiMemRead(raw, 24, 16)));

    // 奇数偏移 101 处的 MIX：先把 101..132 填成 0xAA，Set 之后填充字节（102、123、124）仍是 0xAA。
    let i = 0;
    const fill = bytesNew(0);
    while (i < 32) { bytesPush(fill, 170); i = i + 1; }
    ffiMemWrite(raw, 101, fill);
    const v = MIX { a: 200, b: -2, c: 1.5, d: -2.25, e: [1, 2, 65535], h: 1234567890123 };
    ffiMemSet<MIX>(raw, 101, v);
    const w = ffiMemGet<MIX>(raw, 101);
    print("mix a=" + toStr(w.a) + " b=" + toStr(w.b) + " c=" + toStr(w.c) + " d=" + toStr(w.d) + " e=" + toStr(w.e[0]) + "," + toStr(w.e[1]) + "," + toStr(w.e[2]) + " h=" + toStr(w.h));
    print("mix bytes " + show(ffiMemRead(raw, 101, 32)));
    const small = ffiMemOf<PT>(p + 32, false) catch (e) { print("small: " + e.message); return 1; };
    print("pt " + pt(ffiMemGet<PT>(small, 0)));
    const zero = ffiMemOf<PT>(0, false) catch (e) { print("null -> " + e.message); return 0; };
    print("never " + pt(ffiMemGet<PT>(zero, 0)));
    return 0;
}
