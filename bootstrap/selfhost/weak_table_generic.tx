// 弱引用登记表的可移植版（rtfn 写，macOS 适配 M4 设计 A8）：语义与导出名同 weak_table.tx。
// 表 {头数组@0, 链数组@8, 容量@16}，两个数组各有“容量”个 8 字节项，空项全 1。头数组按对象号：{首个弱引用号 u32@0, 末个 u32@4}；
// 链数组按弱引用号：{对象号 u32@0, 下一个弱引用号 u32@4}。编号 0xFFFFFFFF 表示无。扩容两张表一起换，第二张分配失败时退回第一张。
import { StructuredBuffer } from "./assemble";
import { RtFn, L, I } from "./rtfn_base";
import { rtBegin, rtEnd, rtFailed, rtSet, rtOp, rtShift, rtLoad, rtStore, rtLabel, rtJump, rtIf, rtCall1, rtCall2, rtRet, rtRetVoid } from "./rtfn";

const MODULE: string = "bootstrap/selfhost/weak_table_generic.tx";
const NONE: int = 4294967295;

function done(f: Ref<RtFn>, failures: List<string>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

// link(state, obj, weak) → 1，或 0（编号为 NONE、该弱引用已登记、分配失败）。
function linkFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_weak_link_v1", "state obj weak", "cap e need ncap heads links i p q x old", 2, MODULE);
    rtOp(f, "obj", L("obj"), "and", I(NONE));
    rtOp(f, "weak", L("weak"), "and", I(NONE));
    rtIf(f, L("obj"), "eq", I(NONE), "bad");
    rtIf(f, L("weak"), "eq", I(NONE), "bad");
    rtLoad(f, "cap", L("state"), 16, 8);
    rtIf(f, L("weak"), "uge", L("cap"), "capacity");
    rtLoad(f, "e", L("state"), 8, 8);
    rtShift(f, "x", L("weak"), "shl", 3);
    rtOp(f, "e", L("e"), "add", L("x"));
    rtLoad(f, "x", L("e"), 0, 4);
    rtIf(f, L("x"), "ne", I(NONE), "bad");
    rtLabel(f, "capacity");
    rtSet(f, "need", L("obj"));
    rtIf(f, L("need"), "uge", L("weak"), "need1");
    rtSet(f, "need", L("weak"));
    rtLabel(f, "need1");
    rtOp(f, "need", L("need"), "add", I(1));
    rtIf(f, L("need"), "ule", L("cap"), "commit");
    rtSet(f, "ncap", L("cap"));
    rtIf(f, L("ncap"), "uge", I(16), "grow");
    rtSet(f, "ncap", I(16));
    rtLabel(f, "grow");
    rtIf(f, L("ncap"), "uge", L("need"), "alloc");
    rtShift(f, "ncap", L("ncap"), "shl", 1);
    rtJump(f, "grow");
    rtLabel(f, "alloc");
    rtShift(f, "x", L("ncap"), "shl", 3);
    rtCall2(f, "heads", "__tx_native_mem_alloc", L("x"), I(8));
    rtIf(f, L("heads"), "eq", I(0), "bad");
    rtShift(f, "x", L("ncap"), "shl", 3);
    rtCall2(f, "links", "__tx_native_mem_alloc", L("x"), I(8));
    rtIf(f, L("links"), "eq", I(0), "rollback");
    rtSet(f, "p", L("heads"));
    rtSet(f, "q", L("links"));
    rtSet(f, "i", L("ncap"));
    rtLabel(f, "init");
    rtStore(f, L("p"), 0, I(-1), 8);
    rtStore(f, L("q"), 0, I(-1), 8);
    rtOp(f, "p", L("p"), "add", I(8));
    rtOp(f, "q", L("q"), "add", I(8));
    rtOp(f, "i", L("i"), "sub", I(1));
    rtIf(f, L("i"), "ne", I(0), "init");
    rtIf(f, L("cap"), "eq", I(0), "swap");
    rtLoad(f, "p", L("state"), 0, 8);
    rtLoad(f, "q", L("state"), 8, 8);
    rtSet(f, "i", I(0));
    rtLabel(f, "copy");
    rtShift(f, "e", L("i"), "shl", 3);
    rtOp(f, "x", L("p"), "add", L("e")); rtLoad(f, "x", L("x"), 0, 8);
    rtOp(f, "old", L("heads"), "add", L("e")); rtStore(f, L("old"), 0, L("x"), 8);
    rtOp(f, "x", L("q"), "add", L("e")); rtLoad(f, "x", L("x"), 0, 8);
    rtOp(f, "old", L("links"), "add", L("e")); rtStore(f, L("old"), 0, L("x"), 8);
    rtOp(f, "i", L("i"), "add", I(1));
    rtIf(f, L("i"), "ult", L("cap"), "copy");
    rtCall1(f, "", "__tx_native_mem_free", L("p"));
    rtCall1(f, "", "__tx_native_mem_free", L("q"));
    rtLabel(f, "swap");
    rtStore(f, L("state"), 0, L("heads"), 8);
    rtStore(f, L("state"), 8, L("links"), 8);
    rtStore(f, L("state"), 16, L("ncap"), 8);
    rtLabel(f, "commit");
    // 链项：{obj, NONE}；挂到该对象链的末尾（链空时同时作首个）。
    rtLoad(f, "e", L("state"), 8, 8);
    rtShift(f, "x", L("weak"), "shl", 3);
    rtOp(f, "e", L("e"), "add", L("x"));
    rtStore(f, L("e"), 0, L("obj"), 4);
    rtStore(f, L("e"), 4, I(NONE), 4);
    rtLoad(f, "p", L("state"), 0, 8);
    rtShift(f, "x", L("obj"), "shl", 3);
    rtOp(f, "p", L("p"), "add", L("x"));
    rtLoad(f, "x", L("p"), 4, 4);
    rtIf(f, L("x"), "eq", I(NONE), "first");
    rtLoad(f, "q", L("state"), 8, 8);
    rtShift(f, "x", L("x"), "shl", 3);
    rtOp(f, "q", L("q"), "add", L("x"));
    rtStore(f, L("q"), 4, L("weak"), 4);
    rtJump(f, "tail");
    rtLabel(f, "first");
    rtStore(f, L("p"), 0, L("weak"), 4);
    rtLabel(f, "tail");
    rtStore(f, L("p"), 4, L("weak"), 4);
    rtRet(f, I(1));
    rtLabel(f, "rollback");
    rtCall1(f, "", "__tx_native_mem_free", L("heads"));
    rtLabel(f, "bad");
    rtRet(f, I(0));
    done(f, failures);
}

// unlink(state, obj, weak)：把 weak 从 obj 的链上摘下并清空它的链项；不符（越界、weak 不属于 obj、链上找不到）时什么也不做。
function unlinkFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_weak_unlink_v1", "state obj weak", "cap e h at cur prev x", 0, MODULE);
    rtOp(f, "obj", L("obj"), "and", I(NONE));
    rtOp(f, "weak", L("weak"), "and", I(NONE));
    rtLoad(f, "cap", L("state"), 16, 8);
    rtIf(f, L("obj"), "uge", L("cap"), "out");
    rtIf(f, L("weak"), "uge", L("cap"), "out");
    rtLoad(f, "e", L("state"), 8, 8);
    rtShift(f, "x", L("weak"), "shl", 3);
    rtOp(f, "e", L("e"), "add", L("x"));
    rtLoad(f, "x", L("e"), 0, 4);
    rtIf(f, L("x"), "ne", L("obj"), "out");
    rtLoad(f, "h", L("state"), 0, 8);
    rtShift(f, "x", L("obj"), "shl", 3);
    rtOp(f, "h", L("h"), "add", L("x"));
    // at 指向“指向当前项的那个 u32”（先是头项的首个字段，之后是前一项的下一个字段）。
    rtSet(f, "at", L("h"));
    rtSet(f, "prev", I(NONE));
    rtLabel(f, "walk");
    rtLoad(f, "cur", L("at"), 0, 4);
    rtIf(f, L("cur"), "eq", L("weak"), "found");
    rtIf(f, L("cur"), "eq", I(NONE), "out");
    rtSet(f, "prev", L("cur"));
    rtLoad(f, "at", L("state"), 8, 8);
    rtShift(f, "x", L("cur"), "shl", 3);
    rtOp(f, "at", L("at"), "add", L("x"));
    rtOp(f, "at", L("at"), "add", I(4));
    rtJump(f, "walk");
    rtLabel(f, "found");
    rtLoad(f, "x", L("e"), 4, 4);
    rtStore(f, L("at"), 0, L("x"), 4);
    rtLoad(f, "x", L("h"), 4, 4);
    rtIf(f, L("x"), "ne", L("weak"), "clear");
    rtStore(f, L("h"), 4, L("prev"), 4);
    rtLabel(f, "clear");
    rtStore(f, L("e"), 0, I(-1), 8);
    rtLabel(f, "out");
    rtRetVoid(f);
    done(f, failures);
}

// notify(state, obj)：对象死亡，依次清空它链上的每个弱引用项并调 __tx_store_weak_dead_v1(obj, weak)，最后清空头项。
function notifyFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_weak_notify_v1", "state obj", "cap h cur e x", 2, MODULE);
    rtOp(f, "obj", L("obj"), "and", I(NONE));
    rtLoad(f, "cap", L("state"), 16, 8);
    rtIf(f, L("obj"), "uge", L("cap"), "out");
    rtLoad(f, "h", L("state"), 0, 8);
    rtShift(f, "x", L("obj"), "shl", 3);
    rtOp(f, "h", L("h"), "add", L("x"));
    rtLoad(f, "cur", L("h"), 0, 4);
    rtStore(f, L("h"), 0, I(-1), 8);
    rtLabel(f, "loop");
    rtIf(f, L("cur"), "eq", I(NONE), "out");
    rtLoad(f, "e", L("state"), 8, 8);
    rtShift(f, "x", L("cur"), "shl", 3);
    rtOp(f, "e", L("e"), "add", L("x"));
    rtLoad(f, "x", L("e"), 4, 4);
    rtStore(f, L("e"), 0, I(-1), 8);
    rtCall2(f, "", "__tx_store_weak_dead_v1", L("obj"), L("cur"));
    rtSet(f, "cur", L("x"));
    rtJump(f, "loop");
    rtLabel(f, "out");
    rtRetVoid(f);
    done(f, failures);
}

// destroy(state)：归还两张表，三个字段清零。
function destroyFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_weak_destroy_v1", "state", "cap p", 1, MODULE);
    rtLoad(f, "cap", L("state"), 16, 8);
    rtIf(f, L("cap"), "eq", I(0), "clear");
    rtLoad(f, "p", L("state"), 0, 8);
    rtCall1(f, "", "__tx_native_mem_free", L("p"));
    rtLoad(f, "p", L("state"), 8, 8);
    rtCall1(f, "", "__tx_native_mem_free", L("p"));
    rtLabel(f, "clear");
    rtStore(f, L("state"), 0, I(0), 8);
    rtStore(f, L("state"), 8, I(0), 8);
    rtStore(f, L("state"), 16, I(0), 8);
    rtRetVoid(f);
    done(f, failures);
}

/// 发出弱引用表的四个函数；rtfn 的失败记进 failures。
export function weakTableGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>): void {
    linkFn(b, failures);
    unlinkFn(b, failures);
    notifyFn(b, failures);
    destroyFn(b, failures);
}
