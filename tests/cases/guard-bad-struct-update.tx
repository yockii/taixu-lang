// D3 v0.51 §6.2-1：struct 更新表达式的展开源须是同一 struct 的值——别的 struct 不收；Ref<T> 先 unref。
struct T { id: int, name: string }
struct U { id: int }

export function main(args: []string): int {
    const t = T { id: 1, name: "a" };
    const u = U { ...t };
    const rt = new T { id: 1, name: "a" };
    const v = T { ...rt, id: 2 };
    return 0;
}
