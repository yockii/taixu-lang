// 服务启动配置；权限与预算只由启动操作者设定，协议只能在上限内缩短请求预算。
import { HOST_SHARE_TYPES, serviceHostShareType } from "./service_files";
export struct ServiceOptions {
    error: string, scratch: string, toolchain: bool, trusted: bool, worker: bool, generation: int,
    memoryMiB: int, cpuSeconds: int, requestMs: int,
    workspaces: List<string>, libraries: List<string>, mountTypes: List<string>,
}
function positive(text: string, maximum: int): int {
    if (len(text) == 0) { return -1; }
    let n = 0; let i = 0;
    while (i < len(text)) {
        const c = byteAt(text, i) catch 0;
        if (c < 48 || c > 57 || n > (maximum - (c - 48)) / 10) { return -1; }
        n = n * 10 + c - 48; i = i + 1;
    }
    if (n <= 0) { return -1; } return n;
}
export function serviceOptionsNew(): Ref<ServiceOptions> {
    return new ServiceOptions { error: "", scratch: "", toolchain: false, trusted: false, worker: false, generation: 0,
        memoryMiB: 4096, cpuSeconds: 60, requestMs: 10000, workspaces: listNew(), libraries: listNew(), mountTypes: listNew() };
}
export function serviceOptions(args: []string, start: int, mcp: bool): Ref<ServiceOptions> {
    const c = serviceOptionsNew();
    let i = start;
    while (i < len(args)) {
        const a = args[i]; i = i + 1;
        if (!mcp && a == "--stdio") { continue; }
        if (!mcp && a == "--toolchain") { c.toolchain = true; continue; }
        if (mcp && a == "--trust-workspace") { c.trusted = true; continue; }
        if (a == "--allow-mount-type") {
            // 主机共享挂载逐类开启（设计 v052-host-share-roots-v0.1 §三-1）；网络文件系统不收。
            if (i >= len(args)) { c.error = "未知选项或缺少参数：" + a; return c; }
            const kind = args[i]; i = i + 1;
            if (!serviceHostShareType(kind)) { c.error = "--allow-mount-type 只收主机共享挂载类型（" + HOST_SHARE_TYPES + "）：" + kind; return c; }
            let seen = false; for (x in c.mountTypes) { if (x == kind) { seen = true; } }
            if (!seen) { listPush(c.mountTypes, kind); }
            continue;
        }
        const path = a == "--workspace" || a == "--library-root" || (mcp && a == "--worker-scratch");
        const numeric = mcp && (a == "--worker-memory-mib" || a == "--worker-cpu-s" || a == "--request-timeout-ms" || a == "--worker-generation");
        if ((!path && !numeric) || i >= len(args)) { c.error = "未知选项或缺少参数：" + a; return c; }
        const value = args[i]; i = i + 1;
        if (path) {
            if (len(value) == 0) { c.error = "本地根不能为空：" + a; return c; }
            if (a == "--workspace") { listPush(c.workspaces, value); }
            else if (a == "--library-root") { listPush(c.libraries, value); }
            else { c.scratch = value; }
            continue;
        }
        let maximum = 1048576;
        if (a == "--worker-cpu-s") { maximum = 86400; }
        if (a == "--request-timeout-ms") { maximum = 1800000; }
        if (a == "--worker-generation") { maximum = 9223372036854775807; }
        const n = positive(value, maximum);
        if (n < 0) { c.error = a + " 需要 1.." + toStr(maximum) + " 的整数"; return c; }
        if (a == "--worker-memory-mib") { c.memoryMiB = n; }
        else if (a == "--worker-cpu-s") { c.cpuSeconds = n; }
        else if (a == "--request-timeout-ms") { c.requestMs = n; }
        else { c.generation = n; c.worker = true; }
    }
    if (c.worker != (len(c.scratch) > 0)) { c.error = "内部 worker 入口需要同时提供代数与父进程临时目录"; }
    return c;
}
export function workerArguments(c: Ref<ServiceOptions>, generation: int, scratch: string): List<string> {
    const a: List<string> = listNew(); listPush(a, "mcp");
    if (c.trusted) { listPush(a, "--trust-workspace"); }
    listPush(a, "--worker-memory-mib"); listPush(a, toStr(c.memoryMiB));
    listPush(a, "--worker-cpu-s"); listPush(a, toStr(c.cpuSeconds));
    listPush(a, "--request-timeout-ms"); listPush(a, toStr(c.requestMs));
    listPush(a, "--worker-generation"); listPush(a, toStr(generation));
    listPush(a, "--worker-scratch"); listPush(a, scratch);
    for (root in c.workspaces) { listPush(a, "--workspace"); listPush(a, root); }
    for (root in c.libraries) { listPush(a, "--library-root"); listPush(a, root); }
    for (kind in c.mountTypes) { listPush(a, "--allow-mount-type"); listPush(a, kind); }
    return a;
}
