// aarch64-windows 写出链路的端到端探针（手写两对象小程序）：用 a64_asm 手写两个 aarch64 目标
// 文件，不带内核与运行时，经 ELF 对象与 link_pe_objects.tx 写成 ARM64 的 PE32+ 可执行文件。在 Windows ARM64 上运行应依次打印三行：
//   a64w image: write ok          ← 经 IAT 槽（__imp_GetStdHandle，PAGE21＋LDST64）与合成的导入桩（裸名 WriteFile，CALL26）调 kernel32
//   a64w image: relax ok          ← 越过 1 MiB 的 cbz 与越过 32 KiB 的向后 tbnz 换成长形式
//   a64w image: call/data ok      ← 跨对象 bl（CALL26）、跨对象读写 .data、.data 里的绝对地址（ABS64 → DIR64 基址重定位，ARM64 映像
//                                   总被 ASLR 挪动，加载器不改就读错地址）
// 然后 ExitProcess(0)。用法：a64w_image_probe <输出文件>；构建成功打印 PASS_A64W_IMAGE 与字节数。
import { StructuredBuffer, asBufferNewA64Os, A64_OS_WINDOWS, asBufferLabel, asStructuredBegin, asStructuredSection, asStructuredLabel, asStructuredByte, asStructuredAddress, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { a64BufferSubmit, a64Emit, a64B, a64Cbz, a64Tbz, a64AddrOf, a64SymAccess, a64MovImm } from "./selfhost/a64_asm";
import { a64LdStPair, a64AddSubImm, a64BranchReg, a64Brk, A64_NOP } from "./selfhost/a64_encode";
import { elfWriteObject, elfObjectOk, elfObjectBytes, elfObjectError } from "./selfhost/emit_elf_object";
import { NativeFunctionImage } from "./selfhost/native_function_data";
import { linkPeObjects, peObjectsBytes, peObjectsError } from "./selfhost/link_pe_objects";

function text(label: string, s: string): void {
    asStructuredSection(1);
    asStructuredLabel(label);
    let i = 0;
    while (i < len(s)) { asStructuredByte(byteAt(s, i) catch 0); i = i + 1; }
    asStructuredSection(0);
}

// 帧记录与一个 16 字节的局部区（[x29, #16] 放 WriteFile 写出的字节数）：stp x29, x30, [sp, #-32]!; add x29, sp, #0。
function prologue(b: Ref<StructuredBuffer>): void {
    a64Emit(b, a64LdStPair(2, 0, 0, 29, 30, 31, -32, 3), "stp");
    a64Emit(b, a64AddSubImm(1, 0, 0, 29, 31, 0, 0), "mov x29, sp");
}

// WriteFile([a64w_handle], x1, n, x29 + 16, NULL)：x1 由调用者备好；经裸名 WriteFile 的导入桩调用。
function writeFile(b: Ref<StructuredBuffer>, n: int): void {
    a64SymAccess(b, 3, 0, 1, 0, 9, "a64w_handle", 0);
    a64MovImm(b, 2, n);
    a64Emit(b, a64AddSubImm(1, 0, 0, 3, 29, 16, 0), "add x3, x29, #16");
    a64MovImm(b, 4, 0);
    a64B(b, 1, "WriteFile");
}

function object(exports: List<string>): Bytes {
    const r = elfWriteObject(exports);
    if (elfObjectOk(r) != 1) { eprint("elf: " + elfObjectError(r)); return bytesNew(0); }
    return elfObjectBytes(r);
}

const MSG_WRITE: string = "a64w image: write ok\n";
const MSG_RELAX: string = "a64w image: relax ok\n";
const MSG_CALL: string = "a64w image: call/data ok\n";
// GetStdHandle 的 STD_OUTPUT_HANDLE：DWORD (−11)。
const STD_OUTPUT_HANDLE: int = 4294967285;

function first(): Bytes {
    const b = asBufferNewA64Os(A64_OS_WINDOWS);
    asBufferLabel(b, "a64w_main", 1);
    prologue(b);
    // a64w_handle ＝ GetStdHandle(STD_OUTPUT_HANDLE)：经 IAT 槽间接调用（x16）。
    a64MovImm(b, 0, STD_OUTPUT_HANDLE);
    a64SymAccess(b, 3, 0, 1, 16, 16, "__imp_GetStdHandle", 0);
    a64Emit(b, a64BranchReg(1, 16), "blr");
    a64SymAccess(b, 3, 0, 0, 0, 9, "a64w_handle", 0);
    a64AddrOf(b, 1, "msg_write", 0);
    writeFile(b, len(MSG_WRITE));
    // 向前越过 1 MiB 的 cbz（x9＝0，必跳）：短形式够不着，换成 cbnz +8; b .Lfar。
    a64MovImm(b, 9, 0);
    a64Cbz(b, 1, 0, 9, ".Lfar");
    asBufferLabel(b, ".Lback", 1);
    a64AddrOf(b, 1, "msg_relax", 0);
    writeFile(b, len(MSG_RELAX));
    a64B(b, 0, ".Lafter");
    let k = 0;
    while (k < 300000) { a64Emit(b, A64_NOP, "nop"); k = k + 1; }
    a64Emit(b, a64Brk(1), "brk");
    asBufferLabel(b, ".Lfar", 1);
    // 向后越过 32 KiB 的 tbnz（x10 的第 0 位为 1，必跳）。
    a64MovImm(b, 10, 1);
    a64Tbz(b, 1, 10, 0, ".Lback");
    a64Emit(b, a64Brk(2), "brk");
    asBufferLabel(b, ".Lafter", 1);
    a64B(b, 1, "a64w_helper");
    a64MovImm(b, 0, 0);
    a64SymAccess(b, 3, 0, 1, 16, 16, "__imp_ExitProcess", 0);
    a64Emit(b, a64BranchReg(1, 16), "blr");
    a64Emit(b, a64Brk(3), "brk");
    asStructuredBegin();
    a64BufferSubmit(b);
    if (asFailedAs() != 0) { eprint("a64: " + asLastErrAs()); return bytesNew(0); }
    text("msg_write", MSG_WRITE);
    text("msg_relax", MSG_RELAX);
    asStructuredSection(2);
    asStructuredLabel("a64w_handle");
    let z = 0;
    while (z < 8) { asStructuredByte(0); z = z + 1; }
    asStructuredSection(0);
    const exports: List<string> = listNew(); listPush(exports, "a64w_main"); listPush(exports, "a64w_handle");
    return object(exports);
}

function second(): Bytes {
    const b = asBufferNewA64Os(A64_OS_WINDOWS);
    asBufferLabel(b, "a64w_helper", 1);
    prologue(b);
    // x1 ＝ [a64w_cell]：.data 里存着 msg_call 的绝对地址；句柄从第一个对象的 .data 读。
    a64SymAccess(b, 3, 0, 1, 1, 16, "a64w_cell", 0);
    writeFile(b, len(MSG_CALL));
    a64Emit(b, a64LdStPair(2, 0, 1, 29, 30, 31, 32, 1), "ldp");
    a64Emit(b, a64BranchReg(2, 30), "ret");
    asStructuredBegin();
    a64BufferSubmit(b);
    if (asFailedAs() != 0) { eprint("a64: " + asLastErrAs()); return bytesNew(0); }
    text("msg_call", MSG_CALL);
    asStructuredSection(2);
    asStructuredLabel("a64w_cell");
    asStructuredAddress("msg_call");
    asStructuredSection(0);
    const exports: List<string> = listNew(); listPush(exports, "a64w_helper");
    return object(exports);
}

function main(args: []string): int {
    if (len(args) < 1) { eprint("usage: a64w_image_probe <out>"); return 64; }
    const a = first();
    if (asFailedAs() != 0) { eprint("asm: " + asLastErrAs()); return 65; }
    const c = second();
    if (asFailedAs() != 0) { eprint("asm: " + asLastErrAs()); return 65; }
    if (bytesLen(a) == 0 || bytesLen(c) == 0) { return 66; }
    const objects: List<Bytes> = listNew();
    listPush(objects, a);
    listPush(objects, c);
    // 两个对象都没有函数目录：不出展开信息（系统按叶函数处理；探针不抛异常、不回溯）。
    const none = new NativeFunctionImage { ok: false, error: "", isa: "aarch64", functions: listNew() };
    if (linkPeObjects(objects, "a64w_main", 0, none) != 0) { eprint("link: " + peObjectsError()); return 67; }
    const image = peObjectsBytes();
    writeFileBytes(args[0], image) catch (e) { eprint(e.message); return 68; };
    print("PASS_A64W_IMAGE " + toStr(bytesLen(image)));
    return 0;
}
