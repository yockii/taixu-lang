// bench/algo/fib-iter —— 迭代斐波那契 fib(87)（线性循环＋i64 上界内）。
export function main(args: []string): int {
    let a: int = 0;
    let b: int = 1;
    let i: int = 0;
    while (i < 87) {
        const t: int = a + b;
        a = b;
        b = t;
        i = i + 1;
    }
    print(toStr(a));
    return 0;
}
