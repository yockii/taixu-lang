// ============================================================================
// engine/mac/m_p1 —— objc_msgSend：id(id, SEL, id)。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: usize): usize from "/usr/lib/libobjc.A.dylib";

export function msgP(o: usize, s: string, a: usize): usize {
    return objc_msgSend(o, sel_registerName(s), a);
}
