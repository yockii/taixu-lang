// std/math 验证（V0.37-M1）：恒等式锚＋双路逐位一致面（aot-load 消费）。
import { sin, cos, tan, asin, acos, atan, atan2, sqrt, cbrt, pow, exp, log, log2, log10, floor, ceil, round, trunc, abs, fmin, fmax, hypot, PI, E } from "std/math";

test "math：三角恒等式（常规域）" {
    const eps: float = 0.0000000001;
    assert(abs(sin(PI() / 6.0) - 0.5) < eps, "sin30");
    assert(abs(cos(PI() / 3.0) - 0.5) < eps, "cos60");
    assert(abs(tan(PI() / 4.0) - 1.0) < eps, "tan45");
    assert(abs(asin(0.5) - PI() / 6.0) < eps, "asin");
    assert(abs(acos(0.5) - PI() / 3.0) < eps, "acos");
    assert(abs(atan(1.0) - PI() / 4.0) < eps, "atan");
    assert(abs(atan2(1.0, 1.0) - PI() / 4.0) < eps, "atan2");
}

test "math：指数对数幂与位操作族" {
    assert(abs(exp(1.0) - E()) < 0.0000000001, "exp1");
    assert(abs(log(E()) - 1.0) < 0.0000000001, "logE");
    assert(abs(log2(8.0) - 3.0) < 0.0000000001, "log2");
    assert(abs(log10(100.0) - 2.0) < 0.0000000001, "log10");
    assert(abs(pow(2.0, 10.0) - 1024.0) < 0.000000001, "pow");
    assert(abs(cbrt(27.0) - 3.0) < 0.0000000001, "cbrt");
    assert(sqrt(9.0) == 3.0, "sqrt");
    assert(floor(2.7) == 2.0 && floor(-1.5) == -2.0, "floor");
    assert(ceil(2.1) == 3.0 && ceil(-1.5) == -1.0, "ceil");
    assert(round(2.5) == 3.0 && round(-2.5) == -3.0, "round");
    assert(trunc(2.9) == 2.0 && trunc(-2.9) == -2.0, "trunc");
    assert(abs(-3.5) == 3.5, "abs");
    assert(fmin(5.0, 2.0) == 2.0 && fmax(5.0, 2.0) == 5.0, "fminmax");
    assert(hypot(3.0, 4.0) == 5.0, "hypot");
}
