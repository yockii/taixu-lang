// D3 v0.53：main 是同步入口，体内可直接 await——未完成时就地运行调度泵（按 FIFO 跑就绪任务、
// 收割定时器），完成后 main 继续；taskAwaitAny、sleepMs 同样可以在 main 里等。detach 发后即忘；main 返回即取消
// 未完成的任务：挂起中的先执行已登记的 defer，还没开始的不再执行。名为 detach 的普通函数照常可调用。
async function job(n: int): int {
    print("job " + toStr(n) + " start");
    (await sleepMs(0))?;
    print("job " + toStr(n) + " end");
    return n * 10;
}

async function lingering(): void {
    defer {
        print("lingering defer");
    }
    print("lingering start");
    (await sleepMs(600000))?;
    print("lingering never");
}

async function neverStarted(): void {
    print("never started");
}

function detach(x: int): void {
    print("plain detach " + toStr(x));
}

function main(args: []string): int {
    detach(5);
    detach lingering();
    const a = job(1);
    const b = job(2);
    print("main before await");
    const va = await a catch -1;
    print("a=" + toStr(va));
    const vb = await b catch -1;
    print("b=" + toStr(vb));
    await sleepMs(0) catch (e) {
        print("sleep failed");
    };
    print("slept");
    const fs: List<Future<int>> = listNew();
    listPush(fs, job(3));
    listPush(fs, job(4));
    const i = taskAwaitAny(fs) catch -1;
    print("any=" + toStr(i));
    detach neverStarted();
    print("main end");
    return 0;
}
