// real-window-linux —— Linux 真窗（GUI 原生引擎 G3，纯太虚 X11）：开一个不显示的真窗（引擎旗标 16），经 X 服务器的 SendEvent
// 投递按钮、移动、键（按 keysym）、尺寸与关窗事件，核对事件分派翻出的序列（移动合并、产生字符的键只发字符、Shift 取大写、
// 右键不发、坐标按 DPI 换成 DIP）；程序化改客户区尺寸（是否回尺寸事件由窗口管理器决定，不核对）、呈现、标题（含 NUL 不 trap）、菜单（X 没有原生菜单栏，得 -1）、光标、
// 最小最大尺寸的返回值；剪贴板写入后读回。只在 Linux 上、DISPLAY 可连时跑（verify 按文件名的 -linux 后缀与 DISPLAY 判定）。
import { windowOpenEx, windowWaitEvent, windowPresent, windowClose, eventWindowTarget, eventWindowX, eventWindowY, eventWindowMods, windowScale, windowSetTitle, windowMenuAdd, windowSetCursor, windowSetMinMax, windowClientResize, surfaceOpen, surfaceClear, surfaceClose, guiQuery, eventWindowOpen, clipboardSetText, clipboardGetText } from "gui/surface";
import { platDebugPost } from "gui/engine/platform";

function pxToDip(v: int, k: int): int {
    if (k == 100) {
        return v;
    }
    return (v * 100 + k / 2) / k;
}

function lp(x: int, y: int): int {
    return (y << 16) | x;
}

export function main(args: []string): int {
    args;
    const id: int = windowOpenEx("真窗探针", 240, 160, 16);
    const k: int = windowScale(id);
    print("real " + toStr(id > 0) + " scale-ok " + toStr(k >= 100 && k <= 500) + " cap " + toStr(guiQuery(0)) + " clip-cap " + toStr(guiQuery(5)));
    const sid: int = eventWindowOpen("脚本窗", 10, 10);
    print("ids distinct " + toStr(sid != id));
    const surf: int = surfaceOpen(64, 32) catch (e) {
        print("surface failed");
        return 1;
    };
    surfaceClear(surf, 0x3366CC);
    print("present " + toStr(windowPresent(id, surf)) + " title " + toStr(windowSetTitle(id, "新标题")) + " nul-title " + toStr(windowSetTitle(id, "前" + (bytesToStr(bytesNew(1)) catch "") + "后")));
    print("menu " + toStr(windowMenuAdd(id, 120, "文件")) + " cursor " + toStr(windowSetCursor(id, 1)) + " " + toStr(windowSetCursor(id, 5)) + " minmax " + toStr(windowSetMinMax(id, 100, 80, 0, 0)));
    print("clip " + toStr(clipboardSetText("剪贴板：太虚 ✓")) + " back " + toStr(clipboardGetText() == "剪贴板：太虚 ✓"));
    print("resize-api " + toStr(windowClientResize(id, 300, 200)));
    platDebugPost(id, 4, 1, lp(40, 30));
    platDebugPost(id, 6, 0, lp(41, 31));
    platDebugPost(id, 6, 0, lp(42, 32));
    platDebugPost(id, 5, 1, lp(43, 33));
    platDebugPost(id, 4, 3, lp(44, 34));
    platDebugPost(id, 2, 0xFF51, 0);
    platDebugPost(id, 2, 0xFFFF, 0);
    platDebugPost(id, 3, 0xFF51, 0);
    platDebugPost(id, 2, 0xFF0D, 0);
    platDebugPost(id, 2, 0x7A, 0);
    platDebugPost(id, 2, 0x7A, 1 << 32);
    platDebugPost(id, 2, 0x7A, 4 << 32);
    platDebugPost(id, 2, 0xFF08, 0);
    platDebugPost(id, 22, 0, lp(250, 150));
    platDebugPost(id, 33, 0, 0);
    let n: int = 0;
    while (n < 40) {
        const kind: int = windowWaitEvent(id, 500);
        if (kind == 0) {
            break;
        }
        const t: int = eventWindowTarget(id);
        const x: int = eventWindowX(id);
        const y: int = eventWindowY(id);
        if (kind == 3 || kind == 4 || kind == 5) {
            let px: int = 40;
            let py: int = 30;
            if (kind == 5) {
                px = 42;
                py = 32;
            } else if (kind == 4) {
                px = 43;
                py = 33;
            }
            print("ev " + toStr(kind) + " " + toStr(t) + " xy " + toStr(x == pxToDip(px, k) && y == pxToDip(py, k)));
        } else if (kind == 7) {
            // 程序化改尺寸经窗口管理器转发、是否回 ConfigureNotify 由它决定（不显示的窗口常常不回），只核对投递的那条。
            if (x == 300 && y == 200) {
                n = n + 1;
                continue;
            }
            print("ev 7 posted " + toStr(x == pxToDip(250, k) && y == pxToDip(150, k)));
        } else if (kind == 1 || kind == 2 || kind == 8) {
            print("ev " + toStr(kind) + " " + toStr(t) + " mods " + toStr(eventWindowMods(id)));
        } else {
            print("ev " + toStr(kind) + " " + toStr(t));
        }
        if (kind == 6) {
            break;
        }
        n = n + 1;
    }
    windowClose(id);
    print("closed real " + toStr(windowSetTitle(id, "x")));
    windowClose(sid);
    surfaceClose(surf);
    return 0;
}
