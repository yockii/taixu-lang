import { parseIp } from "std/ip";
import { p256Hex } from "std/crypto/p256_field";
import { constantTimeEqual } from "std/crypto/subtle";

function rejects(text: string): bool { parseIp(text) catch (e) { return true; }; return false; }

test "IP：独立解析器字节对照与所有零压缩位置" {
    const fixture = readFile("tests/vectors/ip.txt") catch panic("IP fixture"); let good = 0; let bad = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " ");
        if (listGet(p, 0) == "good") {
            const actual = parseIp(listGet(p, 1)) catch (e) { panic("IP " + listGet(p, 1) + ": " + e.message); };
            assert(constantTimeEqual(actual, p256Hex(listGet(p, 2))), "packed IP " + toStr(good)); good = good + 1;
        } else {
            assert(listGet(p, 0) == "bad", "fixture type"); let value = listGet(p, 1); if (value == "-") { value = ""; }
            assert(rejects(value), "reject " + value); bad = bad + 1;
        }
    }
    assert(good == 174 && bad == 24, "complete IP vectors");
}

test "IP：非 ASCII、空白和 NUL 拒绝" {
    for (text in [" ::1", "::1 ", "127.0.0.1 ", "中::1", "１２７.0.0.1"]) { assert(rejects(text), "invalid IP text"); }
    assert(rejects("::1" + (utf8Encode(0) catch "")), "embedded NUL");
}
