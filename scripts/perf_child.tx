// 测量子进程的共用件（perf_os_*.tx）：排空子进程的输出——stdout 丢弃，stderr 收下（至多 MAX_STDERR 字节）；子进程退出时两个流随之
// 到流尾，pump 立即返回，所以墙钟不受轮询间隔影响。另有 CPU 亲和掩码与逗号分隔的 CPU 号之间的转换。
const MAX_STDERR: int = 16777216;

export struct Pipes {
    h: int,
    outOpen: bool,
    errOpen: bool,
    buf: Bytes,
    err: Bytes,
}

export function pipesNew(h: int): Ref<Pipes> {
    return new Pipes { h: h, outOpen: true, errOpen: true, buf: bytesNew(65536), err: bytesNew(0) };
}

export function pipesOpen(p: Ref<Pipes>): bool {
    return p.outOpen || p.errOpen;
}

// 等至多 ms 毫秒，读出已就绪的输出。
export function pump(p: Ref<Pipes>, ms: int): void {
    let mask = 0;
    if (p.outOpen) {
        mask = mask | 2;
    }
    if (p.errOpen) {
        mask = mask | 4;
    }
    if (mask == 0) {
        return;
    }
    const ready = ioWait(p.h, mask, ms);
    if ((ready & 2) != 0) {
        if (procRead(p.h, 1, p.buf) < 0) {
            p.outOpen = false;
        }
    }
    if ((ready & 4) != 0) {
        const n = procRead(p.h, 2, p.buf);
        if (n < 0) {
            p.errOpen = false;
        } else if (n > 0 && bytesLen(p.err) < MAX_STDERR) {
            bytesAppend(p.err, bytesSlice(p.buf, 0, n));
        }
    }
}

// 子进程已退出后读完剩下的输出；孙进程仍握着管道时至多再等 limitMs 毫秒。
export function pumpRest(p: Ref<Pipes>, limitMs: int): void {
    const deadline = monoNs() + limitMs * 1000000;
    while (pipesOpen(p) && monoNs() < deadline) {
        pump(p, 50);
    }
}

// 掩码（小端字节序的位图，第 i 位为 CPU i）里置位的 CPU 号，逗号分隔（如 0,2,3）。
export function maskText(mask: Bytes, n: int): string {
    let out = "";
    let i = 0;
    while (i < n * 8) {
        if ((((bytesGet(mask, i / 8) ?? 0) >> (i % 8)) & 1) != 0) {
            if (len(out) > 0) {
                out = out + ",";
            }
            out = out + toStr(i);
        }
        i = i + 1;
    }
    return out;
}
