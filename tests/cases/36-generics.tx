// V0.38-G1 泛型单态化（D3 v0.13）e2e：恒等/Pair/推断/高阶/互调/期望型收窄。
function id<T>(x: T): T {
    return x;
}
struct Pair<A, B> {
    first: A,
    second: B,
}
function swap(p: Pair<int, string>): Pair<string, int> {
    return Pair<string, int> { first: p.second, second: p.first };
}
function firstOf<T>(xs: List<T>): T? {
    if (listLen(xs) == 0) {
        return None;
    }
    return listGet(xs, 0) catch None;
}
function twice<T>(x: T, f: (T) => T): T {
    return f(f(x));
}
function inc(n: int): int {
    return n + 1;
}
function repeatOf<T>(x: T, n: int): List<T> {
    const out: List<T> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(out, x);
        i = i + 1;
    }
    return out;
}
export function main(args: []string): int {
    const a = id(7);
    const b = id("hi");
    const p: Pair<int, string> = { first: 3, second: "s" };
    const q = swap(p);
    const xs: List<int> = listNew();
    listPush(xs, 42);
    const v = firstOf(xs) catch -1;
    const rs = repeatOf(9, 3);
    const t = twice<int>(5, inc);
    print(toStr(a) + " " + b);
    print(toStr(q.second) + " " + q.first);
    print(toStr(v));
    print(toStr(listLen(rs)));
    print(toStr(t));
    return 0;
}
