// AArch64 的 RELA 语义（ELF for the Arm 64-bit Architecture；目标分层 X3a 从 link_objects.tx 拆出）：sa = S+A，
// site = P。指令里的操作码位保留，只改立即数位；范围与对齐不合即拒绝（不截断）。PAGE21 以 4 KiB 页计；LDSTn 的页内偏移按访问宽度
// 缩放，须对齐。施加函数返回空串为成功，否则为拒绝的原因（由 link_objects.tx 记下）。
import { relocPatch, relocWord32 } from "./reloc_bits";

/// 重定位改写的字节数：R_AARCH64_ABS64（257）为 8，其余 4（1 号也按 8 算，同拆分之前；它在施加时被拒）。
export function a64RelocWidth(kind: int): int {
    if (kind == 1 || kind == 257) { return 8; }
    return 4;
}

/// 重定位的目标恰是符号本身：加数为 0。
export function a64RelocExact(kind: int, addend: int): bool { return addend == 0; }

export function a64Relocate(out: Bytes, fileAt: int, site: int, kind: int, sa: int, absSites: List<int>): string {
    if (kind == 257) {
        relocPatch(out, fileAt, sa, 8);
        listPush(absSites, site);
        return "";
    }
    if (kind == 261) {
        const v = wrapSub(sa, site);
        if (v < -2147483648 || v > 2147483647) { return "RelativeRelocationOutOfRange"; }
        relocPatch(out, fileAt, v, 4);
        return "";
    }
    const insn = relocWord32(out, fileAt);
    if (kind == 282 || kind == 283 || kind == 280 || kind == 279) {
        const v = wrapSub(sa, site);
        let limit = 134217728; let bits = 67108863; let shift = 0;
        if (kind == 280) { limit = 1048576; bits = 524287; shift = 5; }
        if (kind == 279) { limit = 32768; bits = 16383; shift = 5; }
        if (v % 4 != 0 || v < -limit || v >= limit) { return "BranchRelocationOutOfRange"; }
        relocPatch(out, fileAt, (insn & ~(bits << shift)) | (((v / 4) & bits) << shift), 4);
        return "";
    }
    if (kind == 275) {
        const pages = wrapSub(sa & -4096, site & -4096) / 4096;
        if (pages < -1048576 || pages > 1048575) { return "PageRelocationOutOfRange"; }
        const v = pages & 2097151;
        relocPatch(out, fileAt, (insn & 2667577375) | ((v & 3) << 29) | ((v >>> 2) << 5), 4);
        return "";
    }
    let scale = -1;
    if (kind == 277 || kind == 278) { scale = 0; }
    if (kind == 284) { scale = 1; }
    if (kind == 285) { scale = 2; }
    if (kind == 286) { scale = 3; }
    if (kind == 299) { scale = 4; }
    if (scale < 0) { return "UnsupportedRelocation:" + toStr(kind); }
    const low = sa & 4095;
    if ((low & ((1 << scale) - 1)) != 0) { return "MisalignedPageOffset"; }
    relocPatch(out, fileAt, (insn & ~(4095 << 10)) | ((low >>> scale) << 10), 4);
    return "";
}
