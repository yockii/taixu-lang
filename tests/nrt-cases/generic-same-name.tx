// 泛型实例的记忆键按类型身份区分：两个模块各自显式导入同一泛型 struct（不再报导入名冲突），
// 并以各自的同名 struct/enum 实例化泛型 struct 与泛型函数（含嵌套实例、List< Ref< P>>、函数类型实参），
// 互不复用对方的实例。
import { fa } from "./data/gsn_a";
import { fb } from "./data/gsn_b";

export function main(args: []string): int {
    print(fa());
    print(fb());
    return 0;
}
