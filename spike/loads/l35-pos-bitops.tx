// 探针负载（V0.40-B1 扩面）：位运算八式正例——D3 v0.14 面（37-bitops 同型精简；经 idInt 阻断常量折叠）。
function idInt(x: int): int {
    return x;
}
export function main(args: []string): int {
    const a: int = idInt(12);
    const b: int = idInt(10);
    const c: int = a & b;
    const d: int = a | b;
    const e: int = a ^ b;
    const f: int = ~a;
    const g: int = a << 2;
    const h: int = a >> 2;
    const i: int = -8 >>> 1;
    const j: int = imul(a, b);
    return (c & 255) + (d & 255) + (e & 255) + (f & 255) + (g & 255) + (h & 255) + (i & 255) + (j & 255);
}
