// 构建驱动的 Linux 系统原语（docs/design/v052-build-driver-v0.1-20261025.md；导出面同 build_os_windows.tx、build_os_macos.tx）：
// from syscall，产物静态、不依赖 libc（同编译器的 mcp_scratch_os_linux.tx）。
import { realPath } from "../bootstrap/selfhost/real_path";
declare function lxOpenat(dir: int, path: string, flags: int, mode: int): int from syscall 257;
declare function lxWrite(fd: int, buf: Bytes, n: int): int from syscall 1;
declare function lxClose(fd: int): int from syscall 3;
declare function lxUnlinkat(dir: int, path: string, flags: int): int from syscall 263;
declare function lxRenameat(olddir: int, oldpath: string, newdir: int, newpath: string): int from syscall 264;

const AT_FDCWD: int = -100;
const AT_REMOVEDIR: int = 512;
// O_WRONLY｜O_CREAT｜O_TRUNC｜O_CLOEXEC。
const OPEN_WRITE: int = 524865;
const EINTR: int = 4;
// 一次写出至多 16 MiB（只在不是整块时切出这一段）。
const CHUNK: int = 16777216;

// 删除空目录（不递归，不跟随链接）。
export function osRemoveDir(path: string): bool {
    return lxUnlinkat(AT_FDCWD, path, AT_REMOVEDIR) == 0;
}

// 改名；目标已存在时原子地替换它（同一文件系统内）。
export function osRename(from: string, to: string): bool {
    return lxRenameat(AT_FDCWD, from, AT_FDCWD, to) == 0;
}

// 真实路径：同编译器的 real_path 模块（服务信任根、MCP 暂存区共用一份实现）；local* 内建拒绝路径里的链接，解析不了时原样
// 返回，由随后的检查报错。
export function osRealPath(path: string): string {
    return realPath(path);
}

// 新建或截断 path 并写出 data 的全部内容；exec 为真时权限 0755，否则 0644（都再受 umask 约束）。
export function osWriteFile(path: string, data: Bytes, exec: bool): bool {
    let mode: int = 420;
    if (exec) {
        mode = 493;
    }
    const fd = lxOpenat(AT_FDCWD, path, OPEN_WRITE, mode);
    if (fd < 0) {
        return false;
    }
    const total = bytesLen(data);
    let off: int = 0;
    let ok: bool = true;
    while (off < total) {
        let n: int = total - off;
        if (n > CHUNK) {
            n = CHUNK;
        }
        let src: Bytes = data;
        if (off > 0 || n < total) {
            src = bytesSlice(data, off, n);
        }
        const r = lxWrite(fd, src, n);
        if (r == -EINTR) {
            continue;
        }
        if (r <= 0) {
            ok = false;
            break;
        }
        off = off + r;
    }
    if (lxClose(fd) != 0) {
        ok = false;
    }
    return ok;
}
