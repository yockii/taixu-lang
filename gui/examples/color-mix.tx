// color-mix —— 滑动调色样例：三条 slider（r/g/b）拖拽
// 混色——拖拽会话（down 锚定→move 跟踪→up 提交）由 pump 单点分诊；面板
// 颜色即改即见。布局随窗口尺寸派生（resize 自适应）。
//
// 确定性校验：TAIXU_REPLAY=tests/color-drag.txt taixu run examples/color-mix.tx
import { Canvas, canvasNew, Slider, slider, drawSlider, box, drawBox, paintText } from "gui/components";
import { App, appNew, appClose, pump, hitZone, sliderOnEvents, onResize, isHover, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_R: int = 1;
const ID_G: int = 2;
const ID_B: int = 3;

struct Model {
    r: Ref<Slider>,
    g: Ref<Slider>,
    b: Ref<Slider>,
    changes: int,
    surface: int, // 经 Ref 持有——onResize 闭包按值捕获，须过引用改写
}

function rgb(m: Ref<Model>): int {
    return m.r.value * 65536 + m.g.value * 256 + m.b.value;
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x202040);
    const w: int = app.w;
    m.r.x = 16;
    m.g.x = 16;
    m.b.x = 16;
    const sw: int = w / 2 - 32;
    m.r.w = sw;
    m.g.w = sw;
    m.b.w = sw;
    m.r.y = h_(app) / 5 - 9;
    m.g.y = h_(app) * 2 / 5 - 9;
    m.b.y = h_(app) * 3 / 5 - 9;
    drawSlider(cv, m.r);
    drawSlider(cv, m.g);
    drawSlider(cv, m.b);
    // 色板（当前混色）＋数值行。
    const px: int = w / 2 + 8;
    const pw: int = w - px - 16;
    drawBox(cv.h, box(0, px, h_(app) / 5, pw, h_(app) / 2, rgb(m)));
    paintText(cv, px, h_(app) * 4 / 5, 0xE0E0E0, "rgb=" + toStr(m.r.value) + "," + toStr(m.g.value) + "," + toStr(m.b.value));
}

function h_(app: Ref<App>): int {
    return app.h;
}

export function main(args: []string): int {
    args;
    const spec = defaultSpec("taixu color", 300, 180);
    const app = appNew(spec);
    const m: Ref<Model> = new Model {
        r: slider(ID_R, 0, 0, 100, 0, 255, 128),
        g: slider(ID_G, 0, 0, 100, 0, 255, 64),
        b: slider(ID_B, 0, 0, 100, 0, 255, 192),
        changes: 0,
        surface: 0,
    };
    m.surface = surfaceOpen(spec.w, spec.h) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    // resize 即失效：surface 随新客户区重建（v0.1.4 反馈 #5 白边根治）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpen(w, h) catch 0;
        });
    const bump = (v: int): void => {
        m.changes = m.changes + 1;
    };
    sliderOnEvents(app, m.r, bump);
    sliderOnEvents(app, m.g, bump);
    sliderOnEvents(app, m.b, bump);
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvas(m.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, m);
            hitZone(app, ID_R, m.r.x, m.r.y - 4, m.r.w, 26);
            hitZone(app, ID_G, m.g.x, m.g.y - 4, m.g.w, 26);
            hitZone(app, ID_B, m.b.x, m.b.y - 4, m.b.w, 26);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("rgb=" + toStr(m.r.value) + "," + toStr(m.g.value) + "," + toStr(m.b.value) + " changes=" + toStr(m.changes) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
