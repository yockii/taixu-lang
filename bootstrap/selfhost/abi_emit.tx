// 入口、线程局部取址与线程桩按目标的派发（目标分层 X3b）：每个目标一行，指向它的
// 组合文件（<系统>_<短架构名>.tx）、同架构共用的线程入口外壳（thread_entry.tx）或同系统共用的例程（macOS 的 libSystem 蹦床）。
// 加一个组合即在这三个函数里各加一行；随组合而变的数据（页长、stat 布局、线程指针的取法等）在 target_abi.tx。没有一行的目标报错，
// 不拿别的目标的例程顶替。
import { StructuredBuffer } from "./assemble";
import { T_X64_WINDOWS, T_X64_LINUX, T_X64_MACOS, T_ARM64_MACOS, T_ARM64_LINUX, T_LA64_LINUX, T_RV64_LINUX, T_ARM64_WINDOWS } from "./target";
import { nrtFailWith } from "./nrt_base";
import { macSysEmit } from "./unix_sys";
import { x64SysvThreadEntry, a64ThreadEntry, la64ThreadEntry, rv64ThreadEntry } from "./thread_entry";
import { windowsX64Start, windowsX64Chkstk, windowsX64TlsLeaves, windowsX64ThreadEntry } from "./windows_x64";
import { linuxX64Start, linuxX64TlsLeaves, linuxX64ThreadStubs } from "./linux_x64";
import { macosX64TlsLeaves } from "./macos_x64";
import { macosA64TlsLeaves } from "./macos_a64";
import { linuxA64Start, linuxA64TlsLeaves, linuxA64ThreadStubs } from "./linux_a64";
import { linuxLa64Start, linuxLa64Rodata, linuxLa64TlsLeaves, linuxLa64ThreadStubs } from "./linux_la64";
import { linuxRv64Start, linuxRv64Data, linuxRv64TlsLeaves, linuxRv64ThreadStubs } from "./linux_rv64";
import { windowsA64Start, windowsA64Chkstk, windowsA64TlsLeaves, windowsA64ThreadEntry } from "./windows_a64";

/// 代码段开头、各目标专有的例程：进程入口（Linux 的 _start、Windows 的 __tx_entry；macOS 的入口是共用的 main）、Windows 的栈探测、
/// macOS 的 libSystem 蹦床、龙芯与 RISC-V 入口要用的数据。
export function abiEntry(b: Ref<StructuredBuffer>, t: int): void {
    if (t == T_X64_WINDOWS) { windowsX64Start(b); windowsX64Chkstk(b); return; }
    if (t == T_X64_LINUX) { linuxX64Start(b); return; }
    if (t == T_X64_MACOS) { macSysEmit(b); return; }
    if (t == T_ARM64_MACOS) { macSysEmit(b); return; }
    if (t == T_ARM64_LINUX) { linuxA64Start(b); return; }
    if (t == T_LA64_LINUX) { linuxLa64Start(b); linuxLa64Rodata(b); return; }
    if (t == T_RV64_LINUX) { linuxRv64Start(b); linuxRv64Data(b); return; }
    if (t == T_ARM64_WINDOWS) { windowsA64Start(b); windowsA64Chkstk(b); return; }
    nrtFailWith("NoProcessEntry:" + toStr(t));
}

/// __tx_tls_tb_get、__tx_tls_tb_set：取、存本线程 TLS 槽里的线程块。
export function abiTlsLeaves(b: Ref<StructuredBuffer>, t: int): void {
    if (t == T_X64_WINDOWS) { windowsX64TlsLeaves(b); return; }
    if (t == T_X64_LINUX) { linuxX64TlsLeaves(b); return; }
    if (t == T_X64_MACOS) { macosX64TlsLeaves(b); return; }
    if (t == T_ARM64_MACOS) { macosA64TlsLeaves(b); return; }
    if (t == T_ARM64_LINUX) { linuxA64TlsLeaves(b); return; }
    if (t == T_LA64_LINUX) { linuxLa64TlsLeaves(b); return; }
    if (t == T_RV64_LINUX) { linuxRv64TlsLeaves(b); return; }
    if (t == T_ARM64_WINDOWS) { windowsA64TlsLeaves(b); return; }
    nrtFailWith("NoTlsLeaves:" + toStr(t));
}

/// 线程入口 __tx_thread_entry；Linux 另有不经 libc 起线程用的 __tx_thread_clone 与 __tx_thread_unmap_exit。
export function abiThreadStubs(b: Ref<StructuredBuffer>, t: int): void {
    if (t == T_X64_WINDOWS) { windowsX64ThreadEntry(b); return; }
    if (t == T_X64_LINUX) { x64SysvThreadEntry(b); linuxX64ThreadStubs(b); return; }
    if (t == T_X64_MACOS) { x64SysvThreadEntry(b); return; }
    if (t == T_ARM64_MACOS) { a64ThreadEntry(b); return; }
    if (t == T_ARM64_LINUX) { a64ThreadEntry(b); linuxA64ThreadStubs(b); return; }
    if (t == T_LA64_LINUX) { la64ThreadEntry(b); linuxLa64ThreadStubs(b); return; }
    if (t == T_RV64_LINUX) { rv64ThreadEntry(b); linuxRv64ThreadStubs(b); return; }
    if (t == T_ARM64_WINDOWS) { windowsA64ThreadEntry(b); return; }
    nrtFailWith("NoThreadStubs:" + toStr(t));
}
