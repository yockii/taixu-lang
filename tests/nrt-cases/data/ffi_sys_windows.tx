// ffi-front 的 Windows 实现：外部函数只在 probe 为真时调用。
declare type HANDLE;
declare function GetCurrentProcessId(): u32 from "kernel32";
declare function GetStdHandle(n: i32): HANDLE? from "kernel32";
declare function CloseHandle(h: HANDLE): i32 from "kernel32";

export function which(): string {
    return "variant";
}

export function selfId(probe: bool): int {
    if (probe) {
        const h = GetStdHandle(-11);
        if (h != None) { CloseHandle(h catch handleFromBits < HANDLE > (0)); }
        return GetCurrentProcessId() as int;
    }
    return 7;
}
