// 第 6 轮 6d-1a 工具链内建 fileSize（仅 --toolchain，伴文件 file-size.toolchain；LSP 与 MCP 实施设计 §三-4）：普通文件
// 的字节数（空文件、中文文件名、多字节内容）；目录、设备（Windows 的 NUL、Linux 的 /dev/null）与含 NUL 的路径
// 得 invalid argument，不存在的得 no such file
// （Error 文案为 "{状态}: 路径"，这里只打印状态，免得临时目录的路径进入期望输出）。临时文件建在 tempDir 下，结束时删掉。

function sep(): string {
    if (hostTarget() == "windows") { return "\\"; }
    return "/";
}

function devNull(): string {
    if (hostTarget() == "windows") { return "NUL"; }
    return "/dev/null";
}

function status(msg: string): string {
    const at = strIndexOf(msg, ": ");
    if (at < 0) { return msg; }
    return strSub(msg, 0, at);
}

function show(label: string, path: string): void {
    const n = fileSize(path) catch (e) {
        print(label + " -> " + status(e.message));
        return;
    };
    print(label + " -> " + toStr(n));
}

export function main(args: []string): int {
    const dir = tempDir();
    const a = dir + sep() + "taixu-file-size-a.tmp";
    const empty = dir + sep() + "taixu-file-size-空.tmp";
    const zh = dir + sep() + "taixu-file-size-中文.tmp";
    writeFile(a, "abc") catch (e) {
        print("write failed: " + e.message);
        return 1;
    };
    writeFile(empty, "") catch (e) {
        print("write failed: " + e.message);
        return 1;
    };
    writeFile(zh, "中文内容\n") catch (e) {
        print("write failed: " + e.message);
        return 1;
    };
    show("ascii", a);
    show("empty", empty);
    show("chinese", zh);
    show("directory", dir);
    show("device", devNull());
    show("missing", dir + sep() + "taixu-file-size-none.tmp");
    const nul = bytesToStr(bytesNew(1)) catch "";
    show("nul", a + nul + "x");
    removeFile(a) catch (e) { print("remove failed: " + e.message); };
    removeFile(empty) catch (e) { print("remove failed: " + e.message); };
    removeFile(zh) catch (e) { print("remove failed: " + e.message); };
    show("removed", a);
    return 0;
}
