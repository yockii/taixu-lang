// V0.9-A1 e2e：taskCancel 未启动任务→cancelled；观察者 await 得 err("task cancelled")。
function main(args: []string): int {
    const slow = slowJob(3);
    const watcher = watch(slow);
    taskCancel(slow);
    print("spawned");
    return 0;
}

async function slowJob(n: int): int {
    let i: int = 0;
    while (i < n) {
        i = i + 1;
    }
    return 100;
}

async function watch(f: Future<int>): int {
    const v = await f catch (e) {
        print("cancelled-as-expected:");
        print(e.message);
        return 0;
    };
    print("unreachable");
    print(toStr(v));
    return v;
}
