// Shared structured-emission helpers; integer widths are explicit at ABI boundaries.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asBufferFunctionEnd, asManualBegin, asManualLeaf, asManualFrame, asManualReturn, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
export function nr(n: int): Ref<Operand> { return asStructuredReg(0, n); }
export function nd(n: int): Ref<Operand> { return asStructuredReg(1, n); }
export function nb(n: int): Ref<Operand> { return asStructuredReg(2, n); }
export function nx(n: int): Ref<Operand> { return asStructuredReg(3, n); }
export function ni(n: int): Ref<Operand> { return asStructuredImm(n); }
export function nm(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
export function nmd(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
export function nmb(n: int, off: int): Ref<Operand> { return asStructuredMem(0, n, -1, 0, off, 0, ""); }
export function no(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
export function nt(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { no(b, name, 2, a, c); }
export function nmov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { nt(b, "mov", a, c); }
export function nl(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
export function nj(b: Ref<StructuredBuffer>, cond: string, name: string): void { no(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
export function nc(b: Ref<StructuredBuffer>, name: string): void { nj(b, "call", name); }
export function nret(b: Ref<StructuredBuffer>): void { no(b, "ret", 0, asStructuredMissing(), asStructuredMissing()); }
// 手写例程登记（来源 runtime-manual，PE 规范化 P3 第 7 项；规则见 assemble.tx 的 asManualBegin）：nfn 起函数并放入口标号，
// 叶函数接 nleaf、入口即分配的接 nframe（sub rsp, n），每个出口 nunframe（add rsp, n；ret），nfnEnd 结束。
export function nfn(b: Ref<StructuredBuffer>, module: string, name: string): void { asManualBegin(b, module, name); }
export function nleaf(b: Ref<StructuredBuffer>): void { asManualLeaf(b); }
export function nframe(b: Ref<StructuredBuffer>, bytes: int): void { asManualFrame(b, bytes); }
export function nunframe(b: Ref<StructuredBuffer>, bytes: int): void { asManualReturn(b, bytes); }
export function nfnEnd(b: Ref<StructuredBuffer>): void { asBufferFunctionEnd(b); }
