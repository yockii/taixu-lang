// bench/algo/matmul —— 矩阵乘 192×192（float；平铺一维 List）。
// 校验和＝C 对角线 Σ c[i][i] ×10^6 取整。
const N: int = 192;

function idx(i: int, j: int): int {
    return i * N + j;
}

export function main(args: []string): int {
    const a: List<float> = listNew();
    const b: List<float> = listNew();
    const c: List<float> = listNew();
    let i: int = 0;
    while (i < N * N) {
        listPush(a, (i % 13) as float * 0.5);
        listPush(b, (i % 7) as float * 0.25 + 0.5);
        listPush(c, 0.0);
        i = i + 1;
    }
    let r: int = 0;
    while (r < N) {
        let k: int = 0;
        while (k < N) {
            const av: float = listGet(a, idx(r, k)) catch 0.0;
            let cc: int = 0;
            while (cc < N) {
                const cv: float = listGet(c, idx(r, cc)) catch 0.0;
                listSet(c, idx(r, cc), cv + av * (listGet(b, idx(k, cc)) catch 0.0));
                cc = cc + 1;
            }
            k = k + 1;
        }
        r = r + 1;
    }
    let diag: float = 0.0;
    i = 0;
    while (i < N) {
        diag = diag + (listGet(c, idx(i, i)) catch 0.0);
        i = i + 1;
    }
    print(toStr((diag * 1000000.0) as int));
    return 0;
}
