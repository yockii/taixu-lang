// worker 内本次请求的时限：父进程信封里的 budget_ms 减去回复余量（mcp.tx），收到请求时开始计时。
let activeMs: int = 10000;
let startedMs: int = 0;
export function mcpRequestBudget(ms: int): void { activeMs = ms; startedMs = monoNs() / 1000000; }
export function mcpRequestMs(): int { return activeMs; }
// 本次请求还剩的毫秒数（未开始计时时为整段时限）。
export function mcpRequestLeftMs(): int {
    if (startedMs == 0) { return activeMs; }
    return activeMs - (monoNs() / 1000000 - startedMs);
}
