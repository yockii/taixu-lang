// Optional link facts. No driver, renderer or toolchain-only builtins.
import { BinaryName, rawName, rawNameNone, rawNameSize, rawNameByte } from "./binary_name";
import { NativeFunction, nativeFunctionsEnable, nativeFunctionsReset } from "./native_function_data";

export struct LinkMapSection {
    index: int, name: Ref<BinaryName>, va: int, fileOffset: int, fileBytes: int, memoryBytes: int,
}
export struct LinkMapSymbol {
    id: int, name: Ref<BinaryName>, origin: string, objectIndex: int, symbolIndex: int,
    sectionIndex: int, sectionName: Ref<BinaryName>, sectionOffset: int, outputSection: int,
    binding: string, symbolType: string, valueKind: string, value: int, declaredSize: int, hasDeclaredSize: bool, state: string,
}
export struct LinkMapPlacement { objectIndex: int, inputSection: int, outputSection: int, va: int, bytes: int }
export struct LinkMapFunction { id: int, source: Ref<NativeFunction>, objectIndex: int, inputSection: int, outputSection: int, va: int, fileOffset: int }
export struct LinkMapData {
    target: string, ok: bool, error: string, imageBase: int, entry: int, imageBytes: int, sha256: string,
    sections: List<Ref<LinkMapSection>>, symbols: List<Ref<LinkMapSymbol>>,
    scope: string, placements: List<Ref<LinkMapPlacement>>, functions: List<Ref<LinkMapFunction>>, functionsPresent: bool,
    metadataObjects: int, unknownObjects: int,
}
let scope: string = "all";
function empty(): Ref<LinkMapData> {
    return new LinkMapData { target: "", ok: false, error: "", imageBase: 0, entry: 0, imageBytes: 0, sha256: "",
        sections: listNew(), symbols: listNew(), scope: scope, placements: listNew(), functions: listNew(), functionsPresent: false, metadataObjects: 0, unknownObjects: 0 };
}
let enabled: bool = false;
let data: Ref<LinkMapData> = empty();
export function linkMapEnabled(): bool { return enabled; }
export function linkMapEnable(on: bool): void { enabled = on; scope = "all"; data = empty(); nativeFunctionsEnable(on); }
export function linkMapScope(value: string): void { assert(value == "all" || value == "functions", "link map scope"); scope = value; data = empty(); }
export function linkMapSymbolsEnabled(): bool { return enabled && scope == "all"; }
export function linkMapClear(): void { data = empty(); nativeFunctionsReset(); }
export function linkMapData(): Ref<LinkMapData> { return data; }
export function linkMapBegin(target: string): void { if (enabled) { data = empty(); data.target = target; } }
export function linkMapFail(message: string): void {
    if (!enabled) { return; } const target = data.target;
    data = empty(); data.target = target; data.error = message;
}
export function linkMapDone(): void { if (enabled) { data.ok = true; } }
export function linkMapLayout(base: int, entry: int): void { if (enabled) { data.imageBase = base; data.entry = entry; } }
/// The ISA that numbers registers in this map's frame facts (the target triple's architecture).
export function linkMapIsa(d: Ref<LinkMapData>): string { if (d.target == "aarch64-macos") { return "aarch64"; } return "x86_64"; }
export function linkMapNameCopy(n: Ref<BinaryName>): Ref<BinaryName> {
    if (!n.ok) { return rawNameNone(); }
    const bytes = bytesNew(0); let i = 0;
    while (i < rawNameSize(n)) { bytesPush(bytes, rawNameByte(n, i)); i = i + 1; }
    return rawName(bytes, 0, bytesLen(bytes));
}
export function linkMapAddSection(index: int, name: Ref<BinaryName>, va: int, at: int, file: int, memory: int): void {
    if (enabled) { listPush(data.sections, new LinkMapSection { index: index, name: linkMapNameCopy(name), va: va,
                fileOffset: at, fileBytes: file, memoryBytes: memory }); }
}
export function linkMapAddPlacement(objectIndex: int, inputSection: int, outputSection: int, va: int, size: int): void {
    if (enabled) { listPush(data.placements, new LinkMapPlacement { objectIndex: objectIndex, inputSection: inputSection, outputSection: outputSection, va: va, bytes: size }); }
}
export function linkMapRow(name: Ref<BinaryName>, origin: string, objectIndex: int, symbolIndex: int): Ref<LinkMapSymbol> {
    return new LinkMapSymbol { id: -1, name: linkMapNameCopy(name), origin: origin, objectIndex: objectIndex, symbolIndex: symbolIndex,
        sectionIndex: -1, sectionName: rawNameNone(), sectionOffset: -1, outputSection: -1,
        binding: "unknown", symbolType: "unknown", valueKind: "undefined", value: 0, declaredSize: 0, hasDeclaredSize: false, state: "undefined" };
}
export function linkMapInput(r: Ref<LinkMapSymbol>, section: int, name: Ref<BinaryName>, offset: int): void {
    r.sectionIndex = section; r.sectionName = linkMapNameCopy(name); r.sectionOffset = offset;
}
export function linkMapAdd(r: Ref<LinkMapSymbol>): void {
    if (linkMapSymbolsEnabled()) { r.id = listLen(data.symbols); listPush(data.symbols, r); }
}
export function linkMapSynthetic(name: Ref<BinaryName>, kind: string, section: int, va: int): void {
    if (!linkMapSymbolsEnabled()) { return; } const r = linkMapRow(name, "synthetic", -1, -1);
    r.binding = "synthetic"; r.symbolType = kind; r.outputSection = section;
    r.valueKind = "link-va"; r.value = va; r.state = "generated"; linkMapAdd(r);
}
