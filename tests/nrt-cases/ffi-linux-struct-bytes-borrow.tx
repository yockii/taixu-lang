// Bytes 字段（Linux）：外部结构体 Bytes 字段指向的缓冲在外部调用期间被 C 借用——bsearch 的比较回调经同一个 Bytes 改变长度即
// trap 4024（同 Bytes 参数，D3 §6.8-16）。
declare struct ARR { data: Bytes, n: usize }
declare function bsearch(key: Bytes, base: Ref<ARR>, n: usize, size: usize, cmp: (usize, usize) => i32): usize from "libc.so.6";

let held: Bytes = bytesNew(4);

function cmp(a: usize, b: usize): i32 {
    a;
    b;
    bytesPush(held, 1);
    return 0;
}

function main(args: []string): int {
    held = bytesNew(4);
    const arr = new ARR { data: held, n: 4 };
    bsearch(bytesNew(16), arr, 1, 16, cmp);
    print("unreachable");
    return 0;
}
