// 回调与串字段（macOS，伴文件 .macos，两种架构共用）：同
// ffi-linux-struct-callback——sigaction 的处理函数字段（raise 期间同步回调）、字段赋值换处理函数后再装；writev 的
// iovec.iov_base 用串字段写进管道再读回；调用后回调与串字段保持原值。Darwin 的 struct sigaction 为处理函数、32 位
// sa_mask、sa_flags，共 16 字节；SIGUSR1 为 30。read、close 与运行时经 libSystem 导入的同名函数共用导入槽。
declare struct SIGACTION { handler: (i32) => void, mask: u32, flags: i32 }
declare struct IOVEC { base: string, len: usize }
declare function sigaction(sig: i32, act: Ref<SIGACTION>, old: usize): i32 from "libSystem";
declare function raise(sig: i32): i32 from "libSystem";
declare function pipe(fds: Bytes): i32 from "libSystem";
declare function writev(fd: i32, iov: Ref<IOVEC>, n: i32): isize from "libSystem";
declare function read(fd: i32, buf: Bytes, n: usize): isize from "libSystem";
declare function close(fd: i32): i32 from "libSystem";

const SIGUSR1: i32 = 30;

let firstHits = 0;
let secondHits = 0;
let lastSig = 0;

function onFirst(sig: i32): void {
    firstHits = firstHits + 1;
    lastSig = sig as int;
}

function onSecond(sig: i32): void {
    secondHits = secondHits + 1;
    lastSig = sig as int + 100;
}

function fdAt(b: Bytes, at: int): i32 {
    const v = (bytesGet(b, at) catch 0) + (bytesGet(b, at + 1) catch 0) * 256;
    return v as i32;
}

function roundTrip(text: string): string {
    const fds = bytesNew(8);
    if (pipe(fds) != 0) { return "pipe failed"; }
    const iov = new IOVEC { base: text, len: len(text) as usize };
    const n = writev(fdAt(fds, 4), iov, 1);
    close(fdAt(fds, 4));
    const buf = bytesNew(64);
    const got = read(fdAt(fds, 0), buf, 64);
    close(fdAt(fds, 0));
    if (got < 0) { return "read failed"; }
    const back = bytesToStr(bytesSlice(buf, 0, got as int)) catch "?";
    return toStr(n) + " [" + back + "] kept [" + iov.base + "]";
}

function main(args: []string): int {
    const act = new SIGACTION { handler: onFirst, mask: 0, flags: 0 };
    print("install " + toStr(sigaction(SIGUSR1, act, 0)));
    print("raise " + toStr(raise(SIGUSR1)) + " first " + toStr(firstHits) + " sig " + toStr(lastSig));
    act.handler = onSecond;
    print("install2 " + toStr(sigaction(SIGUSR1, act, 0)));
    raise(SIGUSR1);
    print("raise2 first " + toStr(firstHits) + " second " + toStr(secondHits) + " sig " + toStr(lastSig));
    const kept = act.handler;
    kept(7);
    print("kept second " + toStr(secondHits) + " sig " + toStr(lastSig) + " flags " + toStr(act.flags));
    print("writev " + roundTrip("hello 太虚"));
    print("writev " + roundTrip(""));
    return 0;
}
