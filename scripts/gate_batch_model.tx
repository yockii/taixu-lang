// 批次清单、步骤与收据的结构约束。这里只做纯规划，不启动进程。
import { J_ARR, J_BOOL, J_OBJ, J_STR, Jv, jArray, jAt, jDump, jGet, jInt, jIsTrue, jLen, jNull, jObject, jPush, jString } from "./test_json";
import { STEP_NAMES } from "./gate_steps";
import { allTargets, targetNamed } from "./targets";
import { sha256Hex } from "../bootstrap/selfhost/sha256";

export const RECEIPT: string = "TAIXU_BATCH_RECEIPT ";

export struct BatchHost {
    id: string,
    target: string,
    resource: string,
    exe: string,
    args: List<string>,
    cwd: string,
    work: string,
}

export struct BatchSpec {
    mode: string,
    dedup: bool,
    steps: List<string>,
    hosts: List<BatchHost>,
}

export function field(v: Ref<Jv>, key: string): Ref<Jv> { return jGet(v, key) ?? jNull(); }
export function choose(ok: bool, yes: string, no: string): string { if (ok) { return yes; } return no; }
export function bit(ok: bool): int { if (ok) { return 1; } return 0; }
export function unit(): void {}
export function txt(v: Ref<Jv>, key: string): string {
    const x = field(v, key);
    return choose(x.kind == J_STR, x.text, "");
}
export function number(v: Ref<Jv>, key: string): int { return jInt(field(v, key)) ?? -1; }
export function contains(xs: List<string>, needle: string): bool {
    for (x in xs) { if (x == needle) { return true; } }
    return false;
}
export function stringArray(xs: List<string>): Ref<Jv> {
    const out = jArray(); for (x in xs) { jPush(out, jString(x)); } return out;
}
export function sameStrings(a: List<string>, b: List<string>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) { if ((listGet(a, i) ?? "") != (listGet(b, i) ?? "")) { return false; } i = i + 1; }
    return true;
}
export function strings(v: Ref<Jv>): List<string> | Error {
    if (v.kind != J_ARR) { return err("应为字符串数组"); }
    const out: List<string> = listNew();
    for (x in v.items) { if (x.kind != J_STR) { return err("数组中须为字符串"); } listPush(out, x.text); }
    return out;
}
export function hex(s: string, n: int): bool {
    if (len(s) != n) { return false; }
    let i = 0;
    while (i < n) { const c = byteAt(s, i) ?? 0; if (!((c >= 48 && c <= 57) || (c >= 97 && c <= 102))) { return false; } i = i + 1; }
    return true;
}
export function identifier(s: string): bool {
    if (len(s) == 0 || len(s) > 64) { return false; }
    let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) ?? 0;
        if (!((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95)) { return false; }
        i = i + 1;
    }
    return true;
}
export function nativeSteps(s: Ref<BatchSpec>): List<string> {
    const out: List<string> = listNew(); for (x in s.steps) { if (x != "cross-products") { listPush(out, x); } } return out;
}
export function crossTargets(host: string, includeHost: bool): List<string> {
    const out: List<string> = listNew();
    for (t in allTargets()) { if (includeHost || t.triple != host) { listPush(out, t.triple); } }
    return out;
}
export function parseSpec(v: Ref<Jv>): Ref<BatchSpec> | Error {
    if (v.kind != J_OBJ || txt(v, "schema") != "gate-batch/1") { return err("批次清单须为 gate-batch/1"); }
    const mode = txt(v, "mode");
    if (mode != "development" && mode != "milestone") { return err("mode 须为 development 或 milestone"); }
    const dedup = field(v, "deduplicate_cross_products");
    if (dedup.kind != J_BOOL) { return err("deduplicate_cross_products 须为 bool"); }
    const steps = strings(field(v, "steps"))?;
    const known = strSplit(STEP_NAMES, " ");
    const seen: List<string> = listNew();
    for (step in steps) {
        if (!contains(known, step) || contains(seen, step)) { return err("未知或重复步名：" + step); }
        listPush(seen, step);
    }
    if (mode == "milestone" && (jIsTrue(dedup) || listLen(steps) != 0)) { return err("milestone 必须完整执行，不能选步或去重"); }
    if (mode == "development" && listLen(steps) == 0) { return err("development 须明确选择步骤"); }
    if (jIsTrue(dedup) && !contains(steps, "cross-products")) { return err("去重只适用于 cross-products"); }
    const hv = field(v, "hosts");
    if (hv.kind != J_ARR || jLen(hv) < 1 || jLen(hv) > 32) { return err("hosts 须为 1..32 项"); }
    const hosts: List<BatchHost> = listNew();
    const ids: List<string> = listNew(); const targets: List<string> = listNew();
    for (h in hv.items) {
        const id = txt(h, "id"); const resource = txt(h, "resource"); const target = txt(h, "target");
        if (!identifier(id) || !identifier(resource) || contains(ids, id)) { return err("宿主 id／resource 不合法或 id 重复"); }
        if (targetNamed(target) == None) { return err("未知宿主目标：" + target); }
        const exe = txt(h, "exe"); const cwd = txt(h, "cwd"); const work = txt(h, "work");
        if (len(exe) == 0 || len(cwd) == 0 || len(work) == 0) { return err("exe、cwd、work 不能为空"); }
        const args = strings(field(h, "args"))?;
        listPush(hosts, BatchHost { id: id, target: target, resource: resource, exe: exe, args: args, cwd: cwd, work: work });
        listPush(ids, id); listPush(targets, target);
    }
    if (mode == "milestone" && (!contains(targets, "x86_64-windows") || !contains(targets, "x86_64-linux") || !contains(targets, "aarch64-macos"))) {
        return err("milestone 至少包含 Windows x64、Linux x64、macOS arm64");
    }
    return new BatchSpec { mode: mode, dedup: jIsTrue(dedup), steps: steps, hosts: hosts };
}

export function checkReceipt(v: Ref<Jv>, h: BatchHost, phase: string, runId: string, requested: List<string>, code: int, witness: bool): void | Error {
    if (code != 0 || v.kind != J_OBJ || txt(v, "schema") != "gate-batch-receipt/1" || txt(v, "status") != "PASS") { return err("阶段失败或缺少成功收据"); }
    if (txt(v, "host") != h.target || txt(v, "phase") != phase || txt(v, "run_id") != runId) { return err("收据宿主／阶段／运行身份不符"); }
    if (!hex(txt(v, "input_id"), 64) || !hex(txt(v, "compiler_sha256"), 64)) { return err("收据缺少输入或编译器身份"); }
    const input = field(v, "input");
    if (input.kind != J_OBJ || jLen(input) != 4 || !hex(txt(input, "core_tree"), 40) || !hex(txt(input, "stdlib_tree"), 40)
        || !hex(txt(input, "gui_tree"), 40) || !hex(txt(input, "kernels_sha256"), 64) || sha256Hex(bytesFromStr(jDump(input))) != txt(v, "input_id")) {
        return err("输入身份与来源摘要不符");
    }
    const got = strings(field(v, "requested"))?;
    if (!sameStrings(got, requested)) { return err("收据请求步骤不符"); }
    if (phase == "native" || phase == "full") {
        if (witness && !hex(txt(v, "witness_sha256"), 64)) { return err("缺少共同目标编译器见证"); }
        const report = field(v, "gate_report");
        if (phase == "full" || listLen(requested) > 0) {
            if (report.kind != J_OBJ || txt(report, "status") != "PASS") { return err("原生 gate 报告未通过"); }
            if (txt(report, "compiler_sha256") != txt(v, "compiler_sha256")) { return err("gate 的实际编译器不符"); }
            if (phase == "full" && txt(report, "scope") != "full-host") { return err("里程碑不是完整宿主门"); }
            const checks = field(report, "checks");
            if (checks.kind != J_ARR) { return err("gate 缺少检查项"); }
            const names: List<string> = listNew();
            for (c in checks.items) {
                const name = txt(c, "name");
                if (len(name) == 0 || contains(names, name) || number(c, "exit") != 0) { return err("gate 含失败或重复检查"); }
                listPush(names, name);
            }
            let required = requested;
            if (phase == "full") {
                required = listNew();
                for (name in strSplit(STEP_NAMES, " ")) { if (name != "export" && name != "product-identity") { listPush(required, name); } }
            }
            for (step in required) {
                let found = false;
                for (c in checks.items) { if (txt(c, "name") == step && number(c, "exit") == 0) { found = true; } }
                if (!found) { return err("gate 未实际完成：" + step); }
            }
        }
    } else {
        const report = field(v, "cross_report");
        if (txt(report, "schema") != "cross-products/1" || txt(report, "status") != "PASS" || txt(report, "compiler_sha256") != txt(v, "compiler_sha256")) {
            return err("交叉构建报告不符");
        }
        if (txt(report, "host_target") != h.target || number(report, "include_host") != bit(phase == "shared-cross")) { return err("交叉报告的宿主或范围不符"); }
        const actual = field(report, "targets"); const expected = crossTargets(h.target, phase == "shared-cross");
        if (actual.kind != J_ARR || jLen(actual) != listLen(expected)) { return err("交叉目标集合不完整"); }
        const seen: List<string> = listNew();
        for (row in actual.items) {
            const target = txt(row, "target");
            if (!contains(expected, target) || contains(seen, target) || number(row, "exit") != 0 || number(row, "case_count") <= 0 || !hex(txt(row, "report_sha256"), 64)) {
                return err("交叉目标失败、重复或缺少语料证据：" + target);
            }
            const counts = field(row, "counts");
            if (counts.kind != J_OBJ || number(counts, "BUILT") <= 0) { return err("目标没有实际构建产物：" + target); }
            let total = 0;
            for (count in counts.items) { const n = jInt(count) ?? -1; if (n < 0) { return err("语料计数非法"); } total = total + n; }
            if (total != number(row, "case_count")) { return err("语料计数与明细数量不符"); }
            for (bad in ["FAIL", "BUILD_FAIL", "REJECT_MISMATCH"]) {
                const n = jInt(field(counts, bad)) ?? 0;
                if (n != 0) { return err("语料含失败：" + target + " " + bad); }
            }
            listPush(seen, target);
        }
    }
    return unit();
}

export function shareKey(v: Ref<Jv>): string {
    const input = txt(v, "input_id"); const proof = txt(v, "witness_sha256");
    if (txt(v, "status") != "PASS" || !hex(input, 64) || !hex(proof, 64)) { return ""; }
    return input + ":" + proof;
}
