    rtCall1(f, "", "__tx_native_mem_free", L("buf")); rtSet(f, "buf", I(0));
    if (tRawSyscall(t)) { rtIf(f, L("x"), "lt", I(0), "done"); rtSyscall(f, "", 3, xs1(L("x"))); rtLabel(f, "done"); }
    if (tMacos(t)) { rtIf(f, L("x"), "lt", I(0), "done"); uxMac(f, "", "closedir", xs1(L("x"))); rtLabel(f, "done"); }
