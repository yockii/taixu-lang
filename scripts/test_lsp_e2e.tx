// 原生 `taixu lsp` 的无头会话门。§四-1、§六。
//
// 各组：
//   lifecycle  initialize 之前、再次 initialize、坏 JSON、非对象、缺 method、带 id 的 $/、未知方法、串 id、shutdown 之后、退出码 0/1/3、
//              --stdio 重复与 --toolchain；
//   framing    帧头回归（test_frames.tx）；
//   encoding   缺省 utf-16、宣告 utf-8 时选 utf-8，中文行的列；
//   uri        Windows 的 %3A 形与小写盘符、百分号编码的中文路径，POSIX 路径；回复与诊断用客户端给的 URI；
//   diag       分文件发布、依赖改动后重查、修好后清空、覆盖层、未保存的新文件、导入失败、关闭后、防抖、范围终点；
//   format     只替换首尾相同行之间的一段（无尾换行、只改中间一行，编辑应用后与格式化结果相同）、无变化、词法错误、未打开；
//   symbols    各种声明的种类、名字位置与范围，utf-16 下的中文列；
//   refs       definition（捕获、跨文件、字段、方法糖、内建、名字末尾的光标、中文列、for-in、泛型体）、references（struct 的导入名、
//              类型标注补面、字面量、声明，includeDeclaration）、rename（局部、跨文件、方法糖的前缀改写与拒绝、struct 连类型标注、
//              模板插值、标准库、遮蔽、坏新名与缺 newName），import { a as b }，变更后立即请求按新文本作答；
//   tokens     legend、记号逐个对照（补面、中文串之后的 utf-16 列）、变更后立即请求、未打开的文档、refreshSupport 时的 refresh 与
//              对其响应的静默收下；
//   hover      各类声明的说明、泛型照写与随实例不同的注明、导入名、prelude、内建与遮蔽内建的用户函数、名字末尾、关键字与注释为
//              null、变更后立即请求、plaintext 偏好；
//   sig        宣告的触发字符、各个实参位置、嵌套与 ) 之后、函数名上为 null、方法糖不含接收者、变体构造、函数类型的绑定、串里的
//              逗号、隔着型参的内建（utf-16 偏移）、导入的函数、未闭合的 (、分组括号；
//   complete   局部按位置与块、形参、顶层声明与导入名、遮蔽内建、内建与 --toolchain、prelude 的导出、类型名、None 与关键字，注释、
//              串与 . 之后为空表。
//
// 客户端是 test_proto.tx 的分帧模式（回复以独立的 test_json.tx 解析）。服务起在仓根，工作区为仓根与工作目录（信任根取真实
// 路径：macOS 的临时目录在 /var 下，/var 是链接），库根优先取 TAIXU_STDLIB，否则为仓内 stdlib/src 或同级 taixu-stdlib/src。
// 取不到字段时记该项 FAIL、余下照跑（组本身起不来时记 <组>: crash）；FAIL 行的细节是 JSON 原文；读到流尾之后再取消息
// 不再等满超时。
//
// 运行（仓根）：taixu run --toolchain scripts/test_lsp_e2e.tx --compiler <原生 taixu> [--only 组,组] [--work 目录]
// 任何 FAIL 时退出码 1。
import { absolute, deleteTree, dirOf, join, kindOf, mkdirs, nat, onWindows } from "./build_lib";
import { osRealPath } from "./build_os";
import { captureRaw } from "./test_lib";
import { byteSub, contains, headChars, indexOf, slashes } from "./test_text";
import { J_ARR, Jv, jDump, jInt, jNull, jParse, jQuote, jSorted, jText } from "./test_json";
import { at, count, dump, eqJson, fieldsOf, has, intIs, isArr, isNull, isObj, item, lastBy, textIs, textOf, trueAt } from "./test_jv";
import { peerIdle } from "./test_proto";
import { framingCases } from "./test_frames";
import { change, changeText, close, diags, finish, frameOf, get, init, kill, Lsp, lspOpen, notify, open, pubsFor, quiet, raw, request, requestRid, send, units, uriOf,
    vscodeUri, WAIT_MS, waitExit } from "./test_lsp_session";

