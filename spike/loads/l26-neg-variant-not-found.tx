// l26-neg-variant-not-found —— BOOT-19 第八柱 3019 enum 变体不存在负例。
// zig sema：switch 模式名不在 enum 变体表 → 3019。
enum Op {
    Add(v: int),
    Neg(v: int),
}
export function main(args: []string): int {
    const o: Op = Op.Add(1);
    const n: int = switch (o) {
        case Add(v) => v,
        case Mul(v) => v,
        else => 0,
    };
    print(toStr(n));
    return 0;
}
