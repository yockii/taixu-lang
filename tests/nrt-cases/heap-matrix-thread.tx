// 安全审查攻关第 2 项场景矩阵（docs/design/v052-heap-check-v0.1-20261024.md 四）：跨线程 × 持有物 × 结局。
// 发送深拷贝后两侧各自修改、各自释放；Shared 的最后一个引用在子线程放掉（主线程先放掉自己的句柄）；嵌套 Shared
// 在子线程里逐层取用后放掉；子线程以 Error 结束时主线程的状态照常可用（结构化失败可恢复）；结果深拷贝回主线程。
// 每轮重复多次，让释放落在不同线程的不同时刻。scripts/test-heap-check.py 的语料部分在页堆内核下再跑本例。
struct Node {
    name: string,
    tags: List< string>,
    raw: Bytes,
}

function makeNode(name: string, n: int): Ref< Node> {
    const tags: List< string> = listNew();
    let i = 0;
    while (i < n) {
        listPush(tags, name + "#" + toStr(i));
        i = i + 1;
    }
    const raw = bytesNew(n);
    bytesFill(raw, 0, n, 7);
    return new Node { name: name, tags: tags, raw: raw };
}

function weight(x: Ref< Node>): int {
    let s = bytesLen(x.raw);
    for (t in x.tags) {
        s = s + len(t);
    }
    return s;
}

// 发送：捕获在启动时深拷贝；子线程改自己的那份并返回新对象（结果深拷贝回来），主线程那份不变。
function sendRound(round: int): string {
    const mine = makeNode("send" + toStr(round), 16);
    const before = weight(mine);
    const t = threadSpawn((): Ref< Node> => {
            listPush(mine.tags, "child");
            bytesSetLE < u32 > (mine.raw, 0, 4294967295);
            return makeNode(mine.name + "-reply", listLen(mine.tags));
        });
    listPush(mine.tags, "parent");
    const reply = threadJoin(t) catch makeNode("lost", 0);
    return reply.name + " " + toStr(listLen(reply.tags)) + " mine " + toStr(listLen(mine.tags)) + " unchanged " + toStr(weight(mine) - len("parent") == before);
}

// Shared：主线程放掉自己的句柄后才 join，子线程手里的是最后一个引用。
function sharedRound(round: int): string {
    let handle: Shared < Ref< Node>>? = sharedNew(makeNode("shared" + toStr(round), 8));
    const h = handle catch sharedNew(makeNode("none", 0));
    const t = threadSpawn((): int => {
            let i = 0;
            let s = 0;
            while (i < 50) {
                s = s + weight(sharedGet(h));
                i = i + 1;
            }
            return s;
        });
    handle = None;
    return "shared sum " + toStr(threadJoin(t) catch -1);
}

// 嵌套 Shared：外层块里嵌着内层句柄；子线程逐层取用，两层都在子线程里放掉最后的引用。
function nestedRound(round: int): string {
    const inner = sharedNew(makeNode("inner" + toStr(round), 4));
    const outer = sharedNew(inner);
    const t = threadSpawn((): string => sharedGet(sharedGet(outer)).name + " " + toStr(weight(sharedGet(sharedGet(outer)))));
    return "nested " + (threadJoin(t) catch "?");
}

// 子线程以 Error 结束：主线程持有的对象与共享块照常可用。
function failRound(round: int): string {
    const keep = makeNode("keep" + toStr(round), 3);
    const s = sharedNew(makeNode("seen" + toStr(round), 2));
    const t = threadSpawn((): int | Error => {
            const local = makeNode("doomed", 5);
            if (weight(sharedGet(s)) > 0) {
                return err("child failed holding " + local.name);
            }
            return 0;
        });
    const r = threadJoin(t) catch (e) {
        return e.message + "; keep " + toStr(weight(keep)) + " shared " + sharedGet(s).name;
    };
    return "unexpected " + toStr(r);
}

function main(args: []string): int {
    let round = 0;
    while (round < 20) {
        const a = sendRound(round);
        const b = sharedRound(round);
        const c = nestedRound(round);
        const d = failRound(round);
        if (round == 0 || round == 19) {
            print(a);
            print(b);
            print(c);
            print(d);
        }
        round = round + 1;
    }
    print("rounds " + toStr(round));
    return 0;
}
