// D3 v0.20：prelude 的名字是预声明标识符——用户自己的同名声明优先，prelude 只补缺。
struct Map { n: int }
function mapNew(): Map { return Map { n: 42 }; }

function main(args: []string): int {
    const m = mapNew();
    print(toStr(m.n));
    const s: Set< string> = setNew();
    s.add("x");
    print(toStr(s.len()));
    return 0;
}
