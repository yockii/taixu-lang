// Independent context facts, old-snapshot ownership, mode cleanup and JSON width.
import { collectCompileProfile, compileProfileJson, compileProfileText } from "./selfhost/compile_profile";
import { compileProfileActive, compileProfileData, compileProfileSortRows } from "./selfhost/compile_profile_data";
import { drvSetKernel, drvSetPrelude, drvNativeRuntime, drvBytesOut,
    drvDisasm, drvDisasmRelease, drvLastContext } from "./selfhost/driver";
import { sha256Hex } from "./selfhost/sha256";
import { emitNativeRecords, emDiagOut } from "./emitmirror";
import { T_X64_WINDOWS, T_X64_LINUX } from "./selfhost/target";

function ints(): List<int> { return listNew(); }
export function main(args: []string): int {
    if (len(args) != 2) { return 64; }
    let t = T_X64_WINDOWS; let kernel = embedBytes("nrt-kernel/kernel.obj");
    if (args[1] == "linux") { t = T_X64_LINUX; kernel = embedBytes("nrt-kernel/kernel-linux.o"); }
    drvSetPrelude(bytesToStr(embedBytes("../prelude/collections.tx")) catch "");
    assert(emitNativeRecords("emitmirror_v3\ntarget win64\nframe_pad 40\nentry 0\n") != 0
        && strIndexOf(emDiagOut(), "E010") >= 0, "native reject must preserve diagnostics without printing");
    const r = collectCompileProfile(args[0], t, kernel);
    assert(r.ok, r.diags);
    const saved = compileProfileJson(r, 0, 0);
    assert(!compileProfileActive() && listLen(compileProfileData().functions) == 0, "profile state not cleared");
    // A failed second collection must not mutate a previously returned result.
    const failed = collectCompileProfile(args[0] + ".missing", t, kernel);
    assert(!failed.ok && !compileProfileActive(), "failed profile state not cleared");
    assert(compileProfileJson(r, 0, 0) == saved, "old snapshot changed after reentry");
    assert(drvDisasm(args[0], t, 0) == 0, "disasm after profile failed");
    const ctx = drvLastContext() catch (e) { eprint(e.message); return 1; };
    assert(listLen(ctx.fnCode) == listLen(r.facts.functions), "function count differs from independent context");
    let i = 0;
    for (f in r.facts.functions) {
        const ir = listLen(listGet(ctx.fnCode, i) catch ints());
        assert(f.inputIr == ir && f.copiedIr == ir && f.fnNodes == 1, "bridge IR/Fn count differs");
        assert(f.constNodes == listLen(listGet(ctx.fnConstsK, i) catch ints()), "bridge Const count differs");
        assert(f.lineNodes == listLen(listGet(ctx.fnLinesL, i) catch ints()), "bridge LineCol count differs");
        i = i + 1;
    }
    drvDisasmRelease();
    drvSetKernel(kernel);
    const objects: List<string> = listNew(); let rc = 0;
    rc = drvNativeRuntime(args[0], 0, objects, t);
    assert(rc == 0 && sha256Hex(drvBytesOut()) == r.hash, "ordinary build changed after profile/disasm/failure");
    // Both renderers consume the same retained facts, including values beyond JS exact integers.
    assert(listLen(r.facts.functions) >= 2, "fixture needs two functions");
    for (f in r.facts.functions) {
        if (f.id < 2) { f.recordParts = 9007199254740993; }
        if (f.id == 0) { f.name = "引用\"\\\n太虚"; }
    }
    const rows = compileProfileSortRows(r.facts.functions, 0);
    let ri = 0;
    for (f in rows) { if (ri < 2) { assert(f.id == ri, "tie order unstable"); } ri = ri + 1; }
    assert(strIndexOf(compileProfileText(r, 1, 0), "9007199254740993") >= 0, "human integer lost precision");
    print(compileProfileJson(r, 1, 0));
    print("PASS_PROFILE_CONTEXT_OWNERSHIP_REENTRY_PRECISION");
    return 0;
}
