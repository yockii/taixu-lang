// V0.9-A1 trap②：main 错误出口的退出 pending 守护——原 panic 保留并附未决
// 计数（结构化纪律不分正误出口，D26 §三-7 审查补）。
function main(args: []string): int {
    const a = alpha();
    panic("boom");
    return 0;
}

async function alpha(): int {
    const b = beta();
    const v = await b;
    return v;
}

async function beta(): int {
    let i: int = 0;
    while (i < 1000000) {
        i = i + 1;
    }
    return i;
}
