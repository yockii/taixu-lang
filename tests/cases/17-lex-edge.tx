// TEST-05 词法边界用例：转义全集、进制前缀、`_` 分隔、float 指数（双实现一致才通过）。
export function main(args: []string): int {
    const esc: string = "a\tb\rc\nd\\e\"f\0g\u{592A}h";
    const dec: int = 1_000_000;
    const hex: int = 0xFF_ab;
    const oct: int = 0o17;
    const bin: int = 0b1011_01;
    const e1: float = 6.02e23;
    const e2: float = 3.14e-2;
    const e3: float = 1e3;
    print(toStr(len(esc)) + "," + toStr(dec + hex + oct + bin));
    print(toStr(e1) + " " + toStr(e2) + " " + toStr(e3));
    return 0;
}
