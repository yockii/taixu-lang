function require(ok: bool): void { assert(ok, "tool security boundary"); }
function drain(h: int, stream: int): string {
    const b = bytesNew(4096);
    // 已等待子进程退出；本夹具的单流输出严格小于一个缓冲。
    const n = procRead(h, stream, b);
    if (n <= 0) { return ""; }
    return bytesToStr(bytesSlice(b, 0, n)) catch "bad-utf8";
}
function main(args: []string): int {
    if (len(args) > 1) {
        if (args[1] == "cpu") {
            let n = 0;
            while (true) { n = n + 1; if (n == 100000000) { n = 0; } }
        }
        if (args[1] == "memory") {
            // 占住并逐页写满，直到被杀：macOS 的看守线程每 50 ms 取样一次物理足迹，分配完就退出的子进程可能落在两次取样之间
            // （设计允许短暂超出，保证的是持续超出必被杀）。Windows、Linux 在分配时即以内存不足失败。
            const b = bytesNew(1073741824);
            let i = 0;
            while (true) { bytesSet(b, i, 1); i = i + 4096; if (i >= 1073741824) { i = 0; } }
        }
        if (args[1] == "invalid") { const a: List< string> = listNew(); procSpawnLimited(args[0], a, "", 0, 0, 1) catch -1; return 99; }
        print("child-ok"); return 17;
    }
    if (len(args) != 1) { return 64; }
    const cases: List< string> = listNew(); listPush(cases, "ok"); listPush(cases, "cpu"); listPush(cases, "memory"); listPush(cases, "ok");
    let i = 0;
    while (i < listLen(cases)) {
        const name = listGet(cases, i) catch "";
        const a: List< string> = listNew(); listPush(a, args[0]); listPush(a, name);
        const h = procSpawnLimited(args[0], a, "", 0, 805306368, 1) catch (e) { print(e.message); return 1; };
        const code = procWait(h, 15000) catch 888;
        const out = drain(h, 1); const err = drain(h, 2); procClose(h);
        print("case=" + name + " code=" + toStr(code) + " stdout=" + out + " stderr=" + err);
        require(code != 888);
        if (name == "ok") { require(code == 17 && out == "child-ok\n" && err == ""); }
        else if (name == "memory") {
            // macOS 没有可用的地址空间限额：看守线程按物理足迹事后 SIGKILL 整组，结局是信号终止而非分配失败（M3 设计 G4）。
            if (hostTarget() == "macos") { require(code == -9 && out == "" && err == ""); }
            else { require(code == 3 && strIndexOf(err, "内存不足") >= 0); }
        }
        else { require(code != 0 && code != 99 && code != 17); }
        print(name + " " + toStr(code));
        i = i + 1;
    }
    print("PASS_HARD_CPU_OOM_RECOVERY"); return 0;
}
