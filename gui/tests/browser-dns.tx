import { browserResolve } from "../examples/browser/dns";
import { deadlineAfterMs } from "std/deadline";
import { parseIp } from "std/ip";

function invalid(host: string, milliseconds: int, cancel: bool): bool {
    const deadline = deadlineAfterMs(milliseconds) catch panic("deadline");
    const cancelled = (): bool => { return cancel; };
    browserResolve(host, deadline, cancelled) catch (e) { return true; }; return false;
}
function worker(): int {
    let i = 0;
    while (i < 20) {
        const deadline = deadlineAfterMs(5000) catch (e) { return 1; }; const cancelled = (): bool => { return false; };
        const results = browserResolve("localhost", deadline, cancelled) catch (e) { return 2; };
        if (listLen(results) == 0) { return 3; }
        for (address in results) { if (address.scope < 0 || (bytesLen(address.ip) != 4 && bytesLen(address.ip) != 16)) { return 4; } }
        i = i + 1;
    } return 0;
}

function addressCase(): void {
    const deadline = deadlineAfterMs(5000) catch panic("deadline"); const cancelled = (): bool => { return false; };
    const v4 = browserResolve("127.0.0.1", deadline, cancelled) catch panic("IPv4");
    const v6 = browserResolve("2001:db8::1", deadline, cancelled) catch panic("IPv6");
    assert(listLen(v4) == 1 && bytesEqual(listGet(v4, 0).ip, parseIp("127.0.0.1") catch panic("v4")), "IPv4 without DNS");
    assert(listLen(v6) == 1 && bytesEqual(listGet(v6, 0).ip, parseIp("2001:db8::1") catch panic("v6")), "IPv6 without DNS");
    assert(invalid("localhost", 0, false) && invalid("localhost", 5000, true), "deadline and cancellation before system work");
    assert(invalid("a..b", 5000, false) && invalid("中文.test", 5000, false), "invalid ASCII reference hosts");
}

function workerCase(): void {
    const first = threadSpawn(worker); const second = threadSpawn(worker);
    assert((threadJoin(first) catch -1) == 0, "first worker owns and closes its queries");
    assert((threadJoin(second) catch -1) == 0, "second worker has separate callback state");
}
test "浏览器 DNS：字面地址与前置拒绝" { addressCase(); }
test "浏览器 DNS：两个网络线程反复解析并收回状态" { workerCase(); }
export function main(args: []string): int {
    addressCase(); workerCase(); print("browser dns: literals, rejection and worker ownership OK"); return 0;
}
