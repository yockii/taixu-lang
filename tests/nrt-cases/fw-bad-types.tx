// O4 第一步：字面量越界、无公共类型的比较、可能丢值的隐式收窄、保留类型名（含 i/u 后接数字）、wrapTo 误用。
struct u8 {
    x: int,
}

export function main(args: []string): int {
    const a: u8 = 256;
    const b: i8 = -129;
    const u: u64 = 5;
    const n: int = 5;
    if (u == n) {
        print("x");
    }
    const c: i32 = n;
    const w = wrapTo(5);
    const f = wrapTo<float>(5);
    const q: i3 = 1;
    return 0;
}
