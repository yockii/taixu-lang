// RISC-V RV64G 编码表的核对（gate.tx 的 rv64-encodings 步）：由给定编译器编出 bootstrap/rv64_encode_probe.tx，
// 拿 tests/rv64/encodings.txt（scripts/rv64_encodings.tx 交 GNU as 与 LLVM 两家汇编器生成）逐条核对编码函数与反汇编器，负例须被
// 拒绝，再做随机往返与固定反例。表本身的重新生成要两家汇编器，不在门里（同 A64、龙芯的做法），改了编码器或指令表时手动跑 --check。
// 运行：taixu run --toolchain scripts/test_rv64_encodings.tx --compiler <taixu> --work <目录> [--root <仓库>]
import { absolute, exeName, join, list1, mkdirs, plus, step, words } from "./build_lib";
import { osRealPath } from "./build_os";
import { capture, check, summary, tallyNew } from "./test_lib";

// 表的规模下限：防止表被截断或生成脚本漏了指令时门仍通过。
const MIN_POSITIVE: int = 1600;
const MIN_NEGATIVE: int = 200;

function run(args: []string): int | Error {
    let compiler = "";
    let work = "";
    let root = "";
    let i: int = 0;
    while (i < len(args)) {
        const a = args[i];
        if (i + 1 >= len(args)) {
            return err("缺少取值或未知参数：" + a);
        }
        const v = args[i + 1];
        if (a == "--compiler") {
            compiler = v;
        } else if (a == "--work") {
            work = v;
        } else if (a == "--root") {
            root = v;
        } else {
            return err("未知参数：" + a);
        }
        i = i + 2;
    }
    if (len(compiler) == 0 || len(work) == 0) {
        return err("用法：taixu run --toolchain scripts/test_rv64_encodings.tx --compiler <taixu> --work <目录> [--root <仓库>]");
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = osRealPath(absolute(root));
    compiler = osRealPath(absolute(compiler));
    if (!mkdirs(absolute(work))) {
        return err("建不了工作目录：" + work);
    }
    const dir = join(osRealPath(absolute(work)), "probe");
    const t = tallyNew();
    step(compiler, plus(plus(list1("build"), list1("bootstrap/rv64_encode_probe.tx")), plus(list1("--toolchain"), plus(list1("--out"), list1(dir)))), root)?;
    const table = join(root, "tests/rv64/encodings.txt");
    const text = readFile(table)?;
    let positive = 0;
    let negative = 0;
    for (line in strSplit(text, "\n")) {
        if (len(line) == 0 || (byteAt(line, 0) catch 0) == 35) { continue; }
        if ((byteAt(line, 0) catch 0) == 33) { negative = negative + 1; } else { positive = positive + 1; }
    }
    check(t, "table-size", positive >= MIN_POSITIVE && negative >= MIN_NEGATIVE,
        "正例 " + toStr(positive) + "（下限 " + toStr(MIN_POSITIVE) + "），负例 " + toStr(negative) + "（下限 " + toStr(MIN_NEGATIVE) + "）");
    const r = capture(join(dir, exeName("rv64_encode_probe")), list1(table), root, 120000000000, 65536)?;
    const ws = words(r.out);
    const ok = r.code == 0 && listLen(ws) == 4 && (listGet(ws, 0) catch "") == "PASS_RV64_ENCODINGS";
    if (check(t, "probe", ok, "退出码 " + toStr(r.code) + "：" + r.out + r.err)) {
        check(t, "counts", (listGet(ws, 1) catch "") == toStr(positive) && (listGet(ws, 2) catch "") == toStr(negative),
            "探针核对 " + (listGet(ws, 1) catch "?") + "／" + (listGet(ws, 2) catch "?") + "，表里 " + toStr(positive) + "／" + toStr(negative));
        check(t, "random-roundtrip", (listGet(ws, 3) catch "0") != "0", "随机往返一个也没认出");
        print("PASS RV64 encodings " + toStr(positive) + ", rejected " + toStr(negative) + ", random " + (listGet(ws, 3) catch "?"));
    }
    return summary(t, "rv64-encodings");
}

function main(args: []string): int {
    return run(args) catch (e) {
        eprint("test_rv64_encodings: " + e.message);
        return 1;
    };
}
