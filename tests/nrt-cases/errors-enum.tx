// D3 v0.19 结构化错误：错误 enum、T | E、? 同种传播与放宽、catch 绑定与 switch 穷尽、
// .message/.cause、errAs、errWrap、toStr 原因链、相等、作 struct 字段。
enum ConfigError extends Error {
    Missing(path: string) = `找不到配置文件 ${path}`,
    BadLine(path: string, line: int, reason: string) = `${path}:${line}：${reason}`,
    Io(path: string, cause: Error) = `读取 ${path} 失败`,
    Empty = "配置为空",
}

enum NetError extends Error {
    Timeout(ms: int) = `超时 ${ms}ms`,
}

struct Report {
    name: string,
    problem: ConfigError,
}

function readNum(path: string): int | Error {
    if (path == "bad") { return err("磁盘已满"); }
    return 7;
}

function load(path: string, mode: int): int | ConfigError {
    if (mode == 0) { return ConfigError.Missing(path); }
    if (mode == 1) { return ConfigError.BadLine(path, 3, "缺少等号"); }
    if (mode == 2) {
        const n = readNum(path) catch (e) { return ConfigError.Io(path, e); };
        return n;
    }
    if (mode == 3) { return ConfigError.Empty; }
    return 42;
}

function same(path: string, mode: int): int | ConfigError {
    const n = load(path, mode)?;
    return n + 1;
}

function widen(path: string, mode: int): int | Error {
    const n = load(path, mode)?;
    return n * 2;
}

function describe(e: ConfigError): string {
    return switch (e) {
        case Missing(p) => "missing " + p,
        case BadLine(p, line, why) => `bad ${p} line ${line}: ${why}`,
        case Io(p, cause) => "io " + p + " / " + cause.message,
        case Empty => "empty",
    };
}

function describeNet(e: NetError): string {
    return switch (e) {
        case Timeout(ms) => `timeout ${ms}`,
    };
}

function net(ms: int): int | NetError {
    if (ms > 100) { return NetError.Timeout(ms); }
    return ms;
}

function either(ms: int): int | Error {
    const v = net(ms)?;
    return v;
}

function causeMsg(e: Error): string? {
    const c: Error = e.cause?;
    return c.message;
}

function kindOf(e: Error): string {
    const ce = errAs<ConfigError>(e);
    if (ce != None) { return "config:" + describe(ce catch ConfigError.Empty); }
    const ne = errAs<NetError>(e);
    if (ne != None) { return "net:" + describeNet(ne catch NetError.Timeout(0)); }
    return "plain";
}

function tryLoad(mode: int): string {
    const r = same("a.conf", mode) catch (e) {
        return describe(e) + " | " + e.message + " | " + toStr(e);
    };
    return "ok " + toStr(r);
}

function tryIo(): string {
    const r = load("bad", 2) catch (e) {
        return toStr(e) + " / cause=" + (causeMsg(e) catch "无");
    };
    return "ok " + toStr(r);
}

function tryWiden(mode: int): string {
    const r = widen("a.conf", mode) catch (e) {
        return kindOf(e) + " | " + toStr(e);
    };
    return "ok " + toStr(r);
}

function tryEither(ms: int): string {
    const r = either(ms) catch (e) {
        return kindOf(e) + " | " + e.message;
    };
    return "ok " + toStr(r);
}

export function main(args: []string): int {
    let mode = 0;
    while (mode < 5) {
        print(toStr(mode) + " " + tryLoad(mode));
        mode = mode + 1;
    }
    print(tryIo());
    print(tryWiden(0));
    print(tryWiden(4));
    print(tryEither(500));
    print(tryEither(5));
    print(kindOf(err("x")));

    const w = errWrap(err("底层"), "上层失败");
    print(toStr(w) + " / " + w.message + " / " + (causeMsg(w) catch "无"));
    const w2 = errWrap(NetError.Timeout(9), "重试失败");
    print(toStr(w2) + " / " + kindOf(w2));
    print("plain cause=" + (causeMsg(err("单层")) catch "无"));

    const a1 = ConfigError.Missing("x");
    const a2 = ConfigError.Missing("x");
    const a3 = ConfigError.Missing("y");
    print("eq " + toStr(a1 == a2) + " " + toStr(a1 == a3) + " " + toStr(a1 != a3) + " " + toStr(ConfigError.Empty == ConfigError.Empty));
    const e1: Error = ConfigError.Empty;
    const e2: Error = err("配置为空");
    print("eq-msg " + toStr(e1 == e2));

    const rep = Report { name: "r", problem: ConfigError.BadLine("b.conf", 9, "重复键") };
    print(rep.name + ": " + rep.problem.message + " / " + describe(rep.problem));
    return 0;
}
