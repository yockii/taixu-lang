// 协议端到端测试取文件与目录的修改时间（导出面同 mtime_os_windows.tx）：Linux 经 statx（各架构都有，龙芯上没有 newfstatat），
// 跟随符号链接（同 Python 的 Path.stat）；得纳秒。
declare function statx(dirfd: i32, path: string, flags: i32, mask: u32, buf: Bytes): i32 from syscall "statx";

const AT_FDCWD: int = -100;
const STATX_MTIME: int = 64;
// struct statx：stx_mtime（struct statx_timestamp：i64 秒、u32 纳秒、i32 保留）在 112；整个结构 256 字节。
const MTIME_AT: int = 112;

// path 的修改时间；取不到得 −1。
export function mtimeOf(path: string): int {
    const buf = bytesNew(256);
    if (statx(AT_FDCWD as i32, path, 0 as i32, STATX_MTIME as u32, buf) != 0) {
        return -1;
    }
    const sec = bytesGetLE<int>(buf, MTIME_AT) ?? -1;
    const nsec = bytesGetLE<u32>(buf, MTIME_AT + 8) ?? 0;
    return sec * 1000000000 + (nsec as int);
}
