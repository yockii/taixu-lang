// ffi-mem 用例页分配的 macOS 实现：经 libSystem（macOS 不提供稳定的系统调用接口）；MAP_ANON｜MAP_PRIVATE（0x1002），arm64 上
// 一页 16 KiB，mprotect、munmap 按整页生效。
declare function mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: i64): usize from "libSystem";
declare function mprotect(addr: usize, len: usize, prot: i32): i32 from "libSystem";
declare function munmap(addr: usize, len: usize): i32 from "libSystem";

export function pageAlloc(): int {
    const p = mmap(0, 4096, 3, 4098, -1, 0) as int;
    if (p == -1) { return 0; }
    return p;
}

export function pageProtect(p: int, prot: int): bool {
    let bits: i32 = 3;
    if (prot == 0) { bits = 0; } else if (prot == 1) { bits = 1; }
    return mprotect(p as usize, 4096, bits) == 0;
}

export function pageFree(p: int): void {
    munmap(p as usize, 4096);
}

export function writableChecked(): bool {
    return true;
}
