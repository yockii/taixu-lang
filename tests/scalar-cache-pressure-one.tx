function pressure(n: int): int {
    let i = 0; const step = 1;
    let a = 0; let b = 0; let c = 0; let d = 0; let e = 0;
    let f = 0; let g = 0; let h = 0; let j = 0; let k = 0;
    while (i < n) {
        a = i + n; b = a + n; c = b + n; d = c + n; e = d + n;
        f = e + n; g = f + n; h = g + n; j = h + n; k = j + n;
        if (a + b + c + d + e + f + g + h + j + k < 0) { return -1; }
        i = i + step;
    }
    return i;
}
function main(args: []string): int {
    print(toStr(pressure(0)) + " " + toStr(pressure(1)) + " " + toStr(pressure(37)));
    return 0;
}
