import { x509VerifyServer } from "std/x509_verify";
import { p256Hex } from "std/crypto/p256_field";

test "macOS SSL：独占内存锚与系统信任隔离" {
    const fixture = readFile("tests/vectors/x509-paths.txt") catch panic("path fixture"); let count = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); if (listGet(p, 1) != "direct") { continue; }
        const roots: List<Bytes> = listNew(); const chain: List<Bytes> = listNew();
        listPush(roots, p256Hex(listGet(p, 3))); listPush(chain, p256Hex(listGet(p, 4)));
        x509VerifyServer(chain, "EXAMPLE.TEST.", 1794456000, roots) catch (e) { panic(e.message); };
        listPush(chain, listGet(roots, 0)); let rejected = false;
        x509VerifyServer(chain, "example.test", 1794456000, listNew()) catch (e) { rejected = true; };
        assert(rejected, "server supplied self root does not become a system anchor");
        rejected = false;
        x509VerifyServer(chain, "other.test", 1794456000, roots) catch (e) { rejected = true; };
        assert(rejected, "wrong hostname"); count = count + 1;
    }
    assert(count == 1, "direct fixture exercised");
}
