// LoongArch64 指令表与反汇编：一个 32 位指令字译成一行文本。
// - 指令表是本子集的唯一清单：助记符、操作码（引用 la64_encode 的常量）、格式与操作数的寄存器类别。编码表的生成
//   （scripts/la64-encodings.tx）、核对探针与反汇编都从这里取指令，操作码只在 la64_encode 写一处。
// - 文本与 tests/la64/encodings.txt 的汇编列逐字相同：寄存器写 psABI 的角色名（$a0、$t0、$fa0、$fcc0，r21 写 $r21），
//   立即数写十进制，跳转目标写相对本条指令的字节偏移（beq $a0, $a1, 8）；fcmp 的条件写进助记符（fcmp.cune.d）。
// - 严格：按固定位认出指令、取出字段，再交给同一个编码函数重编，须与原字逐位相同才出文本（AM 的 rd 与 rj 同号、保留位
//   不为零的字都过不去）；认不出的字一律得 .inst 0x%08x，不猜。
import { LA64_F_2R, LA64_F_3R, LA64_F_UI5, LA64_F_UI6, LA64_F_SI12, LA64_F_UI12, LA64_F_SI14, LA64_F_SI20, LA64_F_BSTR, LA64_F_CODE } from "./la64_encode";
import { LA64_F_JIRL, LA64_F_B16, LA64_F_B21, LA64_F_BC21, LA64_F_B26, LA64_F_AM, LA64_F_FCMP, LA64_F_CF2GR, LA64_F_FSEL } from "./la64_encode";
import { la64R2, la64R3, la64Shift, la64Si12, la64Ui12, la64Si14, la64Si20, la64Bstr, la64Code, la64Jirl, la64B16, la64B21, la64Bc21, la64B26, la64Am, la64Fcmp, la64Movcf2gr, la64Fsel } from "./la64_encode";
import { LA64_ADD_W, LA64_ADD_D, LA64_SUB_W, LA64_SUB_D, LA64_SLT, LA64_SLTU, LA64_MASKEQZ, LA64_MASKNEZ, LA64_NOR, LA64_AND, LA64_OR, LA64_XOR } from "./la64_encode";
import { LA64_SLL_W, LA64_SRL_W, LA64_SRA_W, LA64_SLL_D, LA64_SRL_D, LA64_SRA_D, LA64_MUL_W, LA64_MUL_D, LA64_MULH_D, LA64_MULH_DU } from "./la64_encode";
import { LA64_DIV_W, LA64_MOD_W, LA64_DIV_WU, LA64_MOD_WU, LA64_DIV_D, LA64_MOD_D, LA64_DIV_DU, LA64_MOD_DU, LA64_EXT_W_H, LA64_EXT_W_B } from "./la64_encode";
import { LA64_SLLI_W, LA64_SLLI_D, LA64_SRLI_W, LA64_SRLI_D, LA64_SRAI_W, LA64_SRAI_D, LA64_BSTRINS_D, LA64_BSTRPICK_D } from "./la64_encode";
import { LA64_SLTI, LA64_SLTUI, LA64_ADDI_W, LA64_ADDI_D, LA64_LU52I_D, LA64_ANDI, LA64_ORI, LA64_XORI } from "./la64_encode";
import { LA64_LU12I_W, LA64_LU32I_D, LA64_PCADDI, LA64_PCALAU12I, LA64_PCADDU12I, LA64_PCADDU18I } from "./la64_encode";
import { LA64_LL_W, LA64_SC_W, LA64_LL_D, LA64_SC_D, LA64_LDPTR_W, LA64_STPTR_W, LA64_LDPTR_D, LA64_STPTR_D } from "./la64_encode";
import { LA64_LD_B, LA64_LD_H, LA64_LD_W, LA64_LD_D, LA64_ST_B, LA64_ST_H, LA64_ST_W, LA64_ST_D, LA64_LD_BU, LA64_LD_HU, LA64_LD_WU } from "./la64_encode";
import { LA64_FLD_S, LA64_FST_S, LA64_FLD_D, LA64_FST_D } from "./la64_encode";
import { LA64_LDX_B, LA64_LDX_H, LA64_LDX_W, LA64_LDX_D, LA64_STX_B, LA64_STX_H, LA64_STX_W, LA64_STX_D, LA64_LDX_BU, LA64_LDX_HU, LA64_LDX_WU } from "./la64_encode";
import { LA64_FLDX_S, LA64_FLDX_D, LA64_FSTX_S, LA64_FSTX_D, LA64_AMSWAP_DB_W, LA64_AMSWAP_DB_D, LA64_AMADD_DB_W, LA64_AMADD_DB_D } from "./la64_encode";
import { LA64_BREAK, LA64_SYSCALL, LA64_DBAR, LA64_IBAR, LA64_BEQZ, LA64_BNEZ, LA64_BCEQZ, LA64_BCNEZ, LA64_JIRL, LA64_B, LA64_BL } from "./la64_encode";
import { LA64_BEQ, LA64_BNE, LA64_BLT, LA64_BGE, LA64_BLTU, LA64_BGEU } from "./la64_encode";
import { LA64_FADD_D, LA64_FSUB_D, LA64_FMUL_D, LA64_FDIV_D, LA64_FMAX_D, LA64_FMIN_D, LA64_FABS_D, LA64_FNEG_D, LA64_FSQRT_D, LA64_FMOV_D } from "./la64_encode";
import { LA64_MOVGR2FR_W, LA64_MOVGR2FR_D, LA64_MOVFR2GR_S, LA64_MOVFR2GR_D, LA64_MOVCF2GR, LA64_FCVT_S_D, LA64_FCVT_D_S, LA64_FTINTRZ_L_D, LA64_FFINT_D_L } from "./la64_encode";
import { LA64_FCMP_D, LA64_FSEL } from "./la64_encode";

export struct La64Inst {
    name: string,
    op: int,
    fmt: int,
    // 操作数的寄存器类别，按文本次序：g 通用、f 浮点、c 条件标志（只列寄存器操作数）。
    cls: string,
}

let table: List<Ref<La64Inst>> = listNew();

function add(name: string, op: int, fmt: int, cls: string): void { listPush(table, new La64Inst { name: name, op: op, fmt: fmt, cls: cls }); }
const FCMP_NAMES: List<string> = strSplit("caf saf clt slt ceq seq cle sle cun sun cult sult cueq sueq cule sule cne sne - - cor sor - - cune sune", " ");

function build(): void {
    if (listLen(table) > 0) { return; }
    add("add.w", LA64_ADD_W, LA64_F_3R, "ggg"); add("add.d", LA64_ADD_D, LA64_F_3R, "ggg");
    add("sub.w", LA64_SUB_W, LA64_F_3R, "ggg"); add("sub.d", LA64_SUB_D, LA64_F_3R, "ggg");
    add("slt", LA64_SLT, LA64_F_3R, "ggg"); add("sltu", LA64_SLTU, LA64_F_3R, "ggg");
    add("maskeqz", LA64_MASKEQZ, LA64_F_3R, "ggg"); add("masknez", LA64_MASKNEZ, LA64_F_3R, "ggg");
    add("nor", LA64_NOR, LA64_F_3R, "ggg"); add("and", LA64_AND, LA64_F_3R, "ggg"); add("or", LA64_OR, LA64_F_3R, "ggg"); add("xor", LA64_XOR, LA64_F_3R, "ggg");
    add("sll.w", LA64_SLL_W, LA64_F_3R, "ggg"); add("srl.w", LA64_SRL_W, LA64_F_3R, "ggg"); add("sra.w", LA64_SRA_W, LA64_F_3R, "ggg");
    add("sll.d", LA64_SLL_D, LA64_F_3R, "ggg"); add("srl.d", LA64_SRL_D, LA64_F_3R, "ggg"); add("sra.d", LA64_SRA_D, LA64_F_3R, "ggg");
    add("mul.w", LA64_MUL_W, LA64_F_3R, "ggg"); add("mul.d", LA64_MUL_D, LA64_F_3R, "ggg");
    add("mulh.d", LA64_MULH_D, LA64_F_3R, "ggg"); add("mulh.du", LA64_MULH_DU, LA64_F_3R, "ggg");
    add("div.w", LA64_DIV_W, LA64_F_3R, "ggg"); add("mod.w", LA64_MOD_W, LA64_F_3R, "ggg");
    add("div.wu", LA64_DIV_WU, LA64_F_3R, "ggg"); add("mod.wu", LA64_MOD_WU, LA64_F_3R, "ggg");
    add("div.d", LA64_DIV_D, LA64_F_3R, "ggg"); add("mod.d", LA64_MOD_D, LA64_F_3R, "ggg");
    add("div.du", LA64_DIV_DU, LA64_F_3R, "ggg"); add("mod.du", LA64_MOD_DU, LA64_F_3R, "ggg");
    add("ext.w.h", LA64_EXT_W_H, LA64_F_2R, "gg"); add("ext.w.b", LA64_EXT_W_B, LA64_F_2R, "gg");
    add("slli.w", LA64_SLLI_W, LA64_F_UI5, "gg"); add("srli.w", LA64_SRLI_W, LA64_F_UI5, "gg"); add("srai.w", LA64_SRAI_W, LA64_F_UI5, "gg");
    add("slli.d", LA64_SLLI_D, LA64_F_UI6, "gg"); add("srli.d", LA64_SRLI_D, LA64_F_UI6, "gg"); add("srai.d", LA64_SRAI_D, LA64_F_UI6, "gg");
    add("bstrins.d", LA64_BSTRINS_D, LA64_F_BSTR, "gg"); add("bstrpick.d", LA64_BSTRPICK_D, LA64_F_BSTR, "gg");
    add("slti", LA64_SLTI, LA64_F_SI12, "gg"); add("sltui", LA64_SLTUI, LA64_F_SI12, "gg");
    add("addi.w", LA64_ADDI_W, LA64_F_SI12, "gg"); add("addi.d", LA64_ADDI_D, LA64_F_SI12, "gg"); add("lu52i.d", LA64_LU52I_D, LA64_F_SI12, "gg");
    add("andi", LA64_ANDI, LA64_F_UI12, "gg"); add("ori", LA64_ORI, LA64_F_UI12, "gg"); add("xori", LA64_XORI, LA64_F_UI12, "gg");
    add("lu12i.w", LA64_LU12I_W, LA64_F_SI20, "g"); add("lu32i.d", LA64_LU32I_D, LA64_F_SI20, "g"); add("pcaddi", LA64_PCADDI, LA64_F_SI20, "g");
    add("pcalau12i", LA64_PCALAU12I, LA64_F_SI20, "g"); add("pcaddu12i", LA64_PCADDU12I, LA64_F_SI20, "g"); add("pcaddu18i", LA64_PCADDU18I, LA64_F_SI20, "g");
    add("ll.w", LA64_LL_W, LA64_F_SI14, "gg"); add("sc.w", LA64_SC_W, LA64_F_SI14, "gg"); add("ll.d", LA64_LL_D, LA64_F_SI14, "gg"); add("sc.d", LA64_SC_D, LA64_F_SI14, "gg");
    add("ldptr.w", LA64_LDPTR_W, LA64_F_SI14, "gg"); add("stptr.w", LA64_STPTR_W, LA64_F_SI14, "gg");
    add("ldptr.d", LA64_LDPTR_D, LA64_F_SI14, "gg"); add("stptr.d", LA64_STPTR_D, LA64_F_SI14, "gg");
    add("ld.b", LA64_LD_B, LA64_F_SI12, "gg"); add("ld.h", LA64_LD_H, LA64_F_SI12, "gg"); add("ld.w", LA64_LD_W, LA64_F_SI12, "gg"); add("ld.d", LA64_LD_D, LA64_F_SI12, "gg");
    add("st.b", LA64_ST_B, LA64_F_SI12, "gg"); add("st.h", LA64_ST_H, LA64_F_SI12, "gg"); add("st.w", LA64_ST_W, LA64_F_SI12, "gg"); add("st.d", LA64_ST_D, LA64_F_SI12, "gg");
    add("ld.bu", LA64_LD_BU, LA64_F_SI12, "gg"); add("ld.hu", LA64_LD_HU, LA64_F_SI12, "gg"); add("ld.wu", LA64_LD_WU, LA64_F_SI12, "gg");
    add("fld.s", LA64_FLD_S, LA64_F_SI12, "fg"); add("fst.s", LA64_FST_S, LA64_F_SI12, "fg"); add("fld.d", LA64_FLD_D, LA64_F_SI12, "fg"); add("fst.d", LA64_FST_D, LA64_F_SI12, "fg");
    add("ldx.b", LA64_LDX_B, LA64_F_3R, "ggg"); add("ldx.h", LA64_LDX_H, LA64_F_3R, "ggg"); add("ldx.w", LA64_LDX_W, LA64_F_3R, "ggg"); add("ldx.d", LA64_LDX_D, LA64_F_3R, "ggg");
    add("stx.b", LA64_STX_B, LA64_F_3R, "ggg"); add("stx.h", LA64_STX_H, LA64_F_3R, "ggg"); add("stx.w", LA64_STX_W, LA64_F_3R, "ggg"); add("stx.d", LA64_STX_D, LA64_F_3R, "ggg");
    add("ldx.bu", LA64_LDX_BU, LA64_F_3R, "ggg"); add("ldx.hu", LA64_LDX_HU, LA64_F_3R, "ggg"); add("ldx.wu", LA64_LDX_WU, LA64_F_3R, "ggg");
    add("fldx.s", LA64_FLDX_S, LA64_F_3R, "fgg"); add("fldx.d", LA64_FLDX_D, LA64_F_3R, "fgg"); add("fstx.s", LA64_FSTX_S, LA64_F_3R, "fgg"); add("fstx.d", LA64_FSTX_D, LA64_F_3R, "fgg");
    add("amswap_db.w", LA64_AMSWAP_DB_W, LA64_F_AM, "ggg"); add("amswap_db.d", LA64_AMSWAP_DB_D, LA64_F_AM, "ggg");
    add("amadd_db.w", LA64_AMADD_DB_W, LA64_F_AM, "ggg"); add("amadd_db.d", LA64_AMADD_DB_D, LA64_F_AM, "ggg");
    add("break", LA64_BREAK, LA64_F_CODE, ""); add("syscall", LA64_SYSCALL, LA64_F_CODE, ""); add("dbar", LA64_DBAR, LA64_F_CODE, ""); add("ibar", LA64_IBAR, LA64_F_CODE, "");
    add("beqz", LA64_BEQZ, LA64_F_B21, "g"); add("bnez", LA64_BNEZ, LA64_F_B21, "g");
    add("bceqz", LA64_BCEQZ, LA64_F_BC21, "c"); add("bcnez", LA64_BCNEZ, LA64_F_BC21, "c");
    add("jirl", LA64_JIRL, LA64_F_JIRL, "gg"); add("b", LA64_B, LA64_F_B26, ""); add("bl", LA64_BL, LA64_F_B26, "");
    add("beq", LA64_BEQ, LA64_F_B16, "gg"); add("bne", LA64_BNE, LA64_F_B16, "gg"); add("blt", LA64_BLT, LA64_F_B16, "gg");
    add("bge", LA64_BGE, LA64_F_B16, "gg"); add("bltu", LA64_BLTU, LA64_F_B16, "gg"); add("bgeu", LA64_BGEU, LA64_F_B16, "gg");
    add("fadd.d", LA64_FADD_D, LA64_F_3R, "fff"); add("fsub.d", LA64_FSUB_D, LA64_F_3R, "fff"); add("fmul.d", LA64_FMUL_D, LA64_F_3R, "fff"); add("fdiv.d", LA64_FDIV_D, LA64_F_3R, "fff");
    add("fmax.d", LA64_FMAX_D, LA64_F_3R, "fff"); add("fmin.d", LA64_FMIN_D, LA64_F_3R, "fff");
    add("fabs.d", LA64_FABS_D, LA64_F_2R, "ff"); add("fneg.d", LA64_FNEG_D, LA64_F_2R, "ff"); add("fsqrt.d", LA64_FSQRT_D, LA64_F_2R, "ff"); add("fmov.d", LA64_FMOV_D, LA64_F_2R, "ff");
    add("movgr2fr.w", LA64_MOVGR2FR_W, LA64_F_2R, "fg"); add("movgr2fr.d", LA64_MOVGR2FR_D, LA64_F_2R, "fg");
    add("movfr2gr.s", LA64_MOVFR2GR_S, LA64_F_2R, "gf"); add("movfr2gr.d", LA64_MOVFR2GR_D, LA64_F_2R, "gf");
    add("movcf2gr", LA64_MOVCF2GR, LA64_F_CF2GR, "gc");
    add("fcvt.s.d", LA64_FCVT_S_D, LA64_F_2R, "ff"); add("fcvt.d.s", LA64_FCVT_D_S, LA64_F_2R, "ff");
    add("ftintrz.l.d", LA64_FTINTRZ_L_D, LA64_F_2R, "ff"); add("ffint.d.l", LA64_FFINT_D_L, LA64_F_2R, "ff");
    let c = 0;
    while (c < 26) {
        const n = listGet(FCMP_NAMES, c) catch "-";
        if (n != "-") { add("fcmp." + n + ".d", LA64_FCMP_D | (c << 15), LA64_F_FCMP, "cff"); }
        c = c + 1;
    }
    add("fsel", LA64_FSEL, LA64_F_FSEL, "fffc");
}

/// 指令表：条数与第 i 条的各项（编码表生成与探针用）。
export function la64InstCount(): int { build(); return listLen(table); }
export function la64Inst(i: int): Ref<La64Inst> { build(); return listGet(table, i) catch new La64Inst { name: "", op: 0, fmt: 0, cls: "" }; }
/// 按助记符找指令，找不到得 −1。
export function la64InstFind(name: string): int {
    build();
    let i = 0;
    for (e in table) { if (e.name == name) { return i; } i = i + 1; }
    return -1;
}

/// 各格式中不属于操作数字段的位（与操作码一起认指令）。
export function la64FixedMask(fmt: int): int {
    if (fmt == LA64_F_2R) { return 0xfffffc00; }
    if (fmt == LA64_F_3R || fmt == LA64_F_UI5 || fmt == LA64_F_CODE || fmt == LA64_F_AM) { return 0xffff8000; }
    if (fmt == LA64_F_UI6) { return 0xffff0000; }
    if (fmt == LA64_F_SI12 || fmt == LA64_F_UI12 || fmt == LA64_F_BSTR) { return 0xffc00000; }
    if (fmt == LA64_F_SI14) { return 0xff000000; }
    if (fmt == LA64_F_SI20) { return 0xfe000000; }
    if (fmt == LA64_F_BC21) { return 0xfc000300; }
    if (fmt == LA64_F_FCMP) { return 0xffff8018; }
    if (fmt == LA64_F_CF2GR) { return 0xffffff00; }
    if (fmt == LA64_F_FSEL) { return 0xfffc0000; }
    return 0xfc000000; // JIRL、B16、B21、B26
}

/// 按文本次序的字段编码第 i 条指令（字段个数与格式不符得 −1）。字段次序：2R rd rj；3R rd rj rk；移位 rd rj ui；SI12／UI12
/// rd rj imm；SI14 rd rj 偏移；SI20 rd imm；BSTR rd rj msbd lsbd；CODE code；JIRL rd rj 偏移；B16 rj rd 偏移；B21 rj 偏移；
/// BC21 cj 偏移；B26 偏移；AM rd rk rj；FCMP cd fj fk；CF2GR rd cj；FSEL fd fj fk ca。
export function la64EncodeFields(i: int, fs: List<int>): int {
    const e = la64Inst(i);
    const n = listLen(fs);
    const a = listGet(fs, 0) catch 0;
    const b = listGet(fs, 1) catch 0;
    const c = listGet(fs, 2) catch 0;
    const d = listGet(fs, 3) catch 0;
    const fmt = e.fmt;
    if (fmt == LA64_F_2R && n == 2) { return la64R2(e.op, a, b); }
    if (fmt == LA64_F_3R && n == 3) { return la64R3(e.op, a, b, c); }
    if (fmt == LA64_F_UI5 && n == 3) { return la64Shift(e.op, a, b, c, 32); }
    if (fmt == LA64_F_UI6 && n == 3) { return la64Shift(e.op, a, b, c, 64); }
    if (fmt == LA64_F_SI12 && n == 3) { return la64Si12(e.op, a, b, c); }
    if (fmt == LA64_F_UI12 && n == 3) { return la64Ui12(e.op, a, b, c); }
    if (fmt == LA64_F_SI14 && n == 3) { return la64Si14(e.op, a, b, c); }
    if (fmt == LA64_F_SI20 && n == 2) { return la64Si20(e.op, a, b); }
    if (fmt == LA64_F_BSTR && n == 4) { return la64Bstr(e.op, a, b, c, d); }
    if (fmt == LA64_F_CODE && n == 1) { return la64Code(e.op, a); }
    if (fmt == LA64_F_JIRL && n == 3) { return la64Jirl(a, b, c); }
    if (fmt == LA64_F_B16 && n == 3) { return la64B16(e.op, a, b, c); }
    if (fmt == LA64_F_B21 && n == 2) { return la64B21(e.op, a, b); }
    if (fmt == LA64_F_BC21 && n == 2) { return la64Bc21(e.op, a, b); }
    if (fmt == LA64_F_B26 && n == 1) { return la64B26(e.op, a); }
    if (fmt == LA64_F_AM && n == 3) { return la64Am(e.op, a, b, c); }
    if (fmt == LA64_F_FCMP && n == 3) { return la64Fcmp((e.op >>> 15) & 31, a, b, c); }
    if (fmt == LA64_F_CF2GR && n == 2) { return la64Movcf2gr(a, b); }
    if (fmt == LA64_F_FSEL && n == 4) { return la64Fsel(a, b, c, d); }
    return -1;
}

function bits(w: int, lo: int, n: int): int { return (w >>> lo) & ((1 << n) - 1); }
function sext(v: int, n: int): int { return (v << (64 - n)) >> (64 - n); }

/// 从指令字按格式取出文本次序的字段（la64EncodeFields 的逆）。
function fields(fmt: int, w: int): List<int> {
    const rd = bits(w, 0, 5);
    const rj = bits(w, 5, 5);
    const rk = bits(w, 10, 5);
    let out: List<int> = listNew();
    if (fmt == LA64_F_2R) { listPush(out, rd); listPush(out, rj); return out; }
    if (fmt == LA64_F_3R) { listPush(out, rd); listPush(out, rj); listPush(out, rk); return out; }
    if (fmt == LA64_F_UI5) { listPush(out, rd); listPush(out, rj); listPush(out, bits(w, 10, 5)); return out; }
    if (fmt == LA64_F_UI6) { listPush(out, rd); listPush(out, rj); listPush(out, bits(w, 10, 6)); return out; }
    if (fmt == LA64_F_SI12) { listPush(out, rd); listPush(out, rj); listPush(out, sext(bits(w, 10, 12), 12)); return out; }
    if (fmt == LA64_F_UI12) { listPush(out, rd); listPush(out, rj); listPush(out, bits(w, 10, 12)); return out; }
    if (fmt == LA64_F_SI14) { listPush(out, rd); listPush(out, rj); listPush(out, sext(bits(w, 10, 14), 14) * 4); return out; }
    if (fmt == LA64_F_SI20) { listPush(out, rd); listPush(out, sext(bits(w, 5, 20), 20)); return out; }
    if (fmt == LA64_F_BSTR) { listPush(out, rd); listPush(out, rj); listPush(out, bits(w, 16, 6)); listPush(out, bits(w, 10, 6)); return out; }
    if (fmt == LA64_F_CODE) { listPush(out, bits(w, 0, 15)); return out; }
    if (fmt == LA64_F_JIRL) { listPush(out, rd); listPush(out, rj); listPush(out, sext(bits(w, 10, 16), 16) * 4); return out; }
    if (fmt == LA64_F_B16) { listPush(out, rj); listPush(out, rd); listPush(out, sext(bits(w, 10, 16), 16) * 4); return out; }
    if (fmt == LA64_F_B21) { listPush(out, rj); listPush(out, sext((bits(w, 0, 5) << 16) | bits(w, 10, 16), 21) * 4); return out; }
    if (fmt == LA64_F_BC21) { listPush(out, bits(w, 5, 3)); listPush(out, sext((bits(w, 0, 5) << 16) | bits(w, 10, 16), 21) * 4); return out; }
    if (fmt == LA64_F_B26) { listPush(out, sext((bits(w, 0, 10) << 16) | bits(w, 10, 16), 26) * 4); return out; }
    if (fmt == LA64_F_AM) { listPush(out, rd); listPush(out, rk); listPush(out, rj); return out; }
    if (fmt == LA64_F_FCMP) { listPush(out, bits(w, 0, 3)); listPush(out, rj); listPush(out, rk); return out; }
    if (fmt == LA64_F_CF2GR) { listPush(out, rd); listPush(out, bits(w, 5, 3)); return out; }
    if (fmt == LA64_F_FSEL) { listPush(out, rd); listPush(out, rj); listPush(out, rk); listPush(out, bits(w, 15, 3)); return out; }
    return out;
}

const GPR: List<string> = strSplit("zero ra tp sp a0 a1 a2 a3 a4 a5 a6 a7 t0 t1 t2 t3 t4 t5 t6 t7 t8 r21 fp s0 s1 s2 s3 s4 s5 s6 s7 s8", " ");

/// 寄存器名：g 通用（$a0 等）、f 浮点（$fa0..$fa7、$ft0..$ft15、$fs0..$fs7）、c 条件标志（$fcc0..$fcc7）。
export function la64RegName(cls: string, n: int): string {
    if (cls == "f") {
        if (n < 8) { return "$fa" + toStr(n); }
        if (n < 24) { return "$ft" + toStr(n - 8); }
        return "$fs" + toStr(n - 24);
    }
    if (cls == "c") { return "$fcc" + toStr(n); }
    return "$" + (listGet(GPR, n) catch "?");
}

/// 第 i 条指令按文本次序的字段写成一行汇编（与编码表的汇编列同一写法）。
export function la64FormatFields(i: int, fs: List<int>): string {
    const e = la64Inst(i);
    let s = e.name;
    let k = 0;
    const nreg = len(e.cls);
    for (v in fs) {
        if (k == 0) { s = s + " "; } else { s = s + ", "; }
        if (k < nreg) { s = s + la64RegName(strSub(e.cls, k, 1), v); } else { s = s + toStr(v); }
        k = k + 1;
    }
    return s;
}

const HEX: string = "0123456789abcdef";
function hex(v: int, width: int): string {
    let s = "";
    let x = v;
    while (x != 0 || len(s) < width) {
        s = strSub(HEX, x & 15, 1) + s;
        x = x >>> 4;
    }
    return s;
}

/// 认出指令字是表中哪一条（字段重编须逐位相同），认不出得 −1。
export function la64Decode(word: int): int {
    build();
    const w = word & 0xffffffff;
    let i = 0;
    for (e in table) {
        if ((w & la64FixedMask(e.fmt)) == e.op) {
            if (la64EncodeFields(i, fields(e.fmt, w)) == w) { return i; }
            return -1;
        }
        i = i + 1;
    }
    return -1;
}

/// 反汇编一个指令字（只看低 32 位）：子集内得一行汇编文本，否则得 .inst 0x%08x。
export function la64Disasm(word: int): string {
    const w = word & 0xffffffff;
    const i = la64Decode(w);
    if (i < 0) { return ".inst 0x" + hex(w, 8); }
    return la64FormatFields(i, fields(la64Inst(i).fmt, w));
}
