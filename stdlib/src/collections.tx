// ============================================================================
// std/collections —— List 高阶与构造工具（V0.23-S1 扩批；STD-04）。
//
// **无用户泛型的诚实边界**（S1 白名单）：本模块按元素类型分族——int 族
// 全量（map/filter/fold/take/drop/reverse/range）＋string 族 reverse；
// 其余元素类型请直接用六内建（listNew/Push/Pop/Get/Set/Len）。
// 全部纯函数（入参 List 只读不写）；高阶面承接 D25 函数类型（箭头/具名
// 双形态同型调用）。全部确定性；test 块见 tests/collections-fx.tx。
// ============================================================================

// range：[lo, hi) 步长 1 整数序列（hi <= lo 时为空表）。
export function range(lo: int, hi: int): List<int> {
    const out: List<int> = listNew();
    let i: int = lo;
    while (i < hi) {
        listPush(out, i);
        i = i + 1;
    }
    return out;
}

// reverseInt：倒序新表（入参不动）。
export function reverseInt(xs: List<int>): List<int> {
    const out: List<int> = listNew();
    let i: int = listLen(xs) - 1;
    while (i >= 0) {
        listPush(out, listGet(xs, i) catch 0);
        i = i - 1;
    }
    return out;
}

// takeInt：前 n 个（n 越界取全）；dropInt：去前 n 个。
export function takeInt(xs: List<int>, n: int): List<int> {
    const out: List<int> = listNew();
    let i: int = 0;
    while (i < n && i < listLen(xs)) {
        listPush(out, listGet(xs, i) catch 0);
        i = i + 1;
    }
    return out;
}

export function dropInt(xs: List<int>, n: int): List<int> {
    const out: List<int> = listNew();
    let i: int = n;
    while (i < listLen(xs)) {
        listPush(out, listGet(xs, i) catch 0);
        i = i + 1;
    }
    return out;
}

// mapInt：逐元素映射（f 纯函数约定——库不强制）。
export function mapInt(xs: List<int>, f: (int) => int): List<int> {
    const out: List<int> = listNew();
    let i: int = 0;
    while (i < listLen(xs)) {
        listPush(out, f(listGet(xs, i) catch 0));
        i = i + 1;
    }
    return out;
}

// filterInt：谓词保留（pred 纯函数约定）。
export function filterInt(xs: List<int>, pred: (int) => bool): List<int> {
    const out: List<int> = listNew();
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch 0;
        if (pred(v)) {
            listPush(out, v);
        }
        i = i + 1;
    }
    return out;
}

// foldInt：左折叠（init 为种子；f(acc, x) 依序累计）。
export function foldInt(xs: List<int>, init: int, f: (int, int) => int): int {
    let acc: int = init;
    let i: int = 0;
    while (i < listLen(xs)) {
        acc = f(acc, listGet(xs, i) catch 0);
        i = i + 1;
    }
    return acc;
}

// sumInt／maxInt：折叠的常用定式（空表 sum=0／max=0）。
export function sumInt(xs: List<int>): int {
    return foldInt(xs, 0, (a: int, b: int): int => a + b);
}

export function maxInt(xs: List<int>): int {
    let m: int = 0;
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch 0;
        if (i == 0 || v > m) {
            m = v;
        }
        i = i + 1;
    }
    return m;
}
