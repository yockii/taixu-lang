const BK_ASSIGN: int = 14;
const BK_IF: int = 15;
const BK_ELSE: int = 16;
const BK_WHILE: int = 17;
const BK_FOR: int = 18;
const BK_INIT: int = 19;
const BK_COND: int = 20;
