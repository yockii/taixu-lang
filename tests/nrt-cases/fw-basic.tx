// O4 第一步（定宽数值）：字面量按期望取型（含负号与可选）、赋值类位置的无损扩宽、
// as 在数值类型之间转换（收窄越界 trap 见 fw-narrow 等）、wrapTo 截断、比较按公共类型
// （u64 用无符号序）、toStr、i64/f64 别名、泛型实例与容器。

struct Pixel {
    r: u8,
    g: u8,
    b: u8,
}

function widen(x: i32): int {
    return x;
}

function total(p: Pixel): int {
    const r: int = p.r;
    const g: int = p.g;
    const b: int = p.b;
    return r + g + b;
}

function first<T>(xs: List< T>): T? {
    return listGet(xs, 0);
}

export function main(args: []string): int {
    const a: i8 = -128;
    const b: u8 = 255;
    const c: i32 = -2147483648;
    const d: u32 = 4294967295;
    const big: u64 = wrapTo<u64>(-1);
    print(toStr(a) + " " + toStr(b) + " " + toStr(c) + " " + toStr(d));
    print(toStr(big) + " " + toStr(wrapTo<u64>(-2)) + " " + toStr(wrapTo<usize>(9223372036854775807)));

    // 无损扩宽：绑定初值、实参、返回值；i64/f64 是 int/float 的别名。
    const n: int = b;
    const z: i64 = n;
    print(toStr(n + 1) + " " + toStr(widen(c)) + " " + toStr(widen(a)) + " " + toStr(z));
    const p = Pixel { r: 10, g: 20, b: 30 };
    print(toStr(total(p)));

    // as：收窄带检查；整数与浮点互转；u64 转浮点按无符号。
    const x: int = 1000;
    print(toStr(x as i16) + " " + toStr((x as u16) as int) + " " + toStr(b as i32));
    print(toStr(3.9 as i32) + " " + toStr((-3.9) as i8) + " " + toStr(1.5e10 as u64) + " " + toStr(0.5 as u8));
    print(toStr(big as float) + " " + toStr((16777217 as f32) as float) + " " + toStr(c as float));
    const e: f32 = 0.1;
    const w: f64 = e;
    print(toStr(e as float) + " " + toStr((0.1 as f32) == e) + " " + toStr(w));

    // wrapTo：取低位按目标类型的宽度与符号解释。
    print(toStr(wrapTo<u8>(x)) + " " + toStr(wrapTo<i8>(200)) + " " + toStr(wrapTo<i32>(0x80004005)) + " " + toStr(wrapTo<u32>(-1)) + " " + toStr(wrapTo<u16>(70000)));

    // 比较：同型、与字面量、按公共类型；u64 用无符号序。
    const h: u64 = wrapTo<u64>(-2);
    print(toStr(h < big) + " " + toStr(big > 5) + " " + toStr(h >= 5) + " " + toStr(b == 255) + " " + toStr(a < n) + " " + toStr(d > c) + " " + toStr(e < 0.2));

    // 容器、可选、下标、泛型实例。
    const xs: List< i32> = listNew();
    listPush(xs, c);
    listPush(xs, 7);
    const i: u8 = 1;
    const got: i32 = listGet(xs, i) catch 0;
    const maybe: u16? = 9;
    print(toStr(listLen(xs)) + " " + toStr(got) + " " + toStr(maybe catch 0) + " " + toStr(first(xs) catch 0));
    return 0;
}
