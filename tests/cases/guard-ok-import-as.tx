// D3 v0.51 §6.1-6：import { a as b }——本模块里用 b 称呼被导入模块的 a，函数、struct、常量、enum、泛型函数、
// 接口、泛型 struct 都可改名；改名后本模块可以另有同名的 a。
import { greet as hello, Pt as Point, LIMIT as MAX, Color as C, idT as ident, Named as N, Box as B } from "./guard-ok-import-as-lib";

struct Dog { n: string }

function dogName(self: Dog): string {
    return self.n;
}

function show(x: N): string {
    return x.name();
}

function greet(): string {
    return "local";
}

export function main(args: []string): int {
    const p: Point = Point { x: 1, y: 2 };
    const c = C.Green;
    const b: B<int> = B<int> { v: 4 };
    print(hello("tx") + " " + toStr(p.x + p.y) + " " + toStr(MAX) + " " + toStr(MAX * 2));
    print(toStr(c == C.Green) + " " + toStr(ident(3)) + ident("s") + " " + toStr(b.v) + " " + show(Dog { n: "d" }) + " " + greet());
    return 0;
}
