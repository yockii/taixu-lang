// runProcess、procSpawn 的子进程只拿到标准三件（D3 v0.40）：经 libSystem 打开一个不带 O_CLOEXEC 的描述符 N，子进程里
// /dev/fd/N 不存在；procSpawn 带调试控制通道时两端照样留下。D3 v0.39 及以前 runProcess 的 posix_spawn 不设
// POSIX_SPAWN_CLOEXEC_DEFAULT，看得到 N（procSpawn 已设）。
declare function open(path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
declare function getpid(): i32 from "libSystem";

function shArgs(script: string): List< string> {
    const a: List< string> = listNew();
    listPush(a, "-c");
    listPush(a, script);
    return a;
}

function verdict(r: int, ok: string): string {
    if (r == 0) { return ok; }
    if (r == 7) { return "inherited"; }
    return "code " + toStr(r);
}

export function main(args: []string): int {
    const fd: int = open("/dev/null", 0, 0);
    if (fd < 3) { print("open failed"); return 1; }
    const probe = "test -e /dev/fd/" + toStr(fd) + " && exit 7; exit 0";
    print("runProcess " + verdict(runProcess("/bin/sh", shArgs(probe), "") catch -1, "closed"));
    print("runProcess+stderr " + verdict(runProcess("/bin/sh", shArgs(probe), "/dev/null") catch -1, "closed"));
    const h = procSpawn("/bin/sh", shArgs(probe), "", 0) catch -1;
    const r = procWait(h, -1) catch -2;
    procClose(h);
    print("procSpawn " + verdict(r, "closed"));
    // 调试控制通道的两端须留下（号在 TAIXU_DEBUG_CHANNEL 里），N 须关掉。
    const ctl = "c=${TAIXU_DEBUG_CHANNEL%,*}; e=${TAIXU_DEBUG_CHANNEL#*,}; test -e /dev/fd/$c || exit 5; test -e /dev/fd/$e || exit 6; " + probe;
    const h2 = procSpawn("/bin/sh", shArgs(ctl), "", 2) catch -1;
    const r2 = procWait(h2, -1) catch -2;
    procClose(h2);
    print("procSpawn+ctl " + verdict(r2, "closed, channel kept"));
    // 父进程关了 2 号时，stderr 文件不得落在 2 号上随 exec 关掉：子进程写 stderr 的内容须进文件（D3 v0.39 及以前丢失）。
    const errPath = "/tmp/taixu-proc-child-handles-" + toStr(getpid()) + ".txt";
    close(2);
    runProcess("/bin/sh", shArgs("echo to-stderr >&2"), errPath) catch -1;
    print("stderr after close(2): " + (readFile(errPath) catch "<none>"));
    removeFile(errPath) catch panic("remove");
    return 0;
}
