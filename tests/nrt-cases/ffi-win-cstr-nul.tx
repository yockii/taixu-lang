// 第 5 轮 FFI（D3 v0.23，Windows）：string 实参含 NUL 字节不能作为 C 字符串，调用桩 trap 4019（ffi_arg）。
declare function lstrlenA(s: string): i32 from "kernel32";

function main(args: []string): int {
    print("before " + toStr(lstrlenA("ok")));
    const b = bytesNew(3);
    bytesSet(b, 0, 97);
    bytesSet(b, 1, 0);
    bytesSet(b, 2, 98);
    const s = bytesToStr(b) catch "";
    print("len " + toStr(len(s)));
    print("after " + toStr(lstrlenA(s)));
    return 0;
}
