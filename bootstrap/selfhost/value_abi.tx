// Private fixed-layout descriptor; no ABI or language change.
export const ABI_REVISION: int = 1;
export const POINTER_BYTES: int = 8;
export const TAG_INT: int = 1;
export const TAG_FLOAT: int = 2;
export const TAG_BOOL: int = 3;
export const VALUE_BYTES: int = 16;
export const VALUE_ALIGNMENT: int = 8;
export const VALUE_TAG_OFFSET: int = 0;
export const VALUE_TAG_BYTES: int = 1;
export const VALUE_PAYLOAD_OFFSET: int = 8;
export const VALUE_PAYLOAD_BYTES: int = 8;
export const VALUE_OBJECT_INDEX_BYTES: int = 4;
export const VALUE_OBJECT_SECOND_OFFSET: int = 12;
export const RT_ENTRY_BYTES: int = 16;
export const RT_ENTRY_ALIGNMENT: int = 8;
export const RT_FN_OFFSET: int = 0;
export const RT_REGCOUNT_OFFSET: int = 8;
export const RT_STATE_OFFSET: int = 12;

export function valueAbiCompatible(): bool {
    if (ABI_REVISION != 1) { return false; }
    if (POINTER_BYTES != 8) { return false; }
    if (VALUE_BYTES != 16) { return false; }
    if (VALUE_ALIGNMENT != 8) { return false; }
    if (VALUE_TAG_OFFSET != 0) { return false; }
    if (VALUE_TAG_BYTES != 1) { return false; }
    if (VALUE_PAYLOAD_OFFSET != 8) { return false; }
    if (VALUE_PAYLOAD_BYTES != 8) { return false; }
    if (VALUE_OBJECT_INDEX_BYTES != 4) { return false; }
    if (VALUE_OBJECT_SECOND_OFFSET != 12) { return false; }
    if (RT_ENTRY_BYTES != 16) { return false; }
    if (RT_ENTRY_ALIGNMENT != 8) { return false; }
    if (RT_FN_OFFSET != 0) { return false; }
    if (RT_REGCOUNT_OFFSET != 8) { return false; }
    if (RT_STATE_OFFSET != 12) { return false; }
    return true;
}
