// Native window handlers; only trap text/program source location remains in the host.
import { StructuredBuffer, asStructuredMissing } from "./assemble";
import { nr, nd, nb, ni, nm, nmd, nmb, nt, nmov, nl, nj, nc, nret, no } from "./native_emit";
export const CVT_KINDS: int = 26;
export function scalarHandlerNames(): List<string> {
    const names: List<string> = listNew();
    listPush(names, "__tx_native_handlers_abi_v1");
    listPush(names, "__tx_ldbool"); listPush(names, "__tx_ldnone"); listPush(names, "__tx_move"); listPush(names, "__tx_istag");
    listPush(names, "__tx_not"); listPush(names, "__tx_neg"); listPush(names, "__tx_bnot"); listPush(names, "__tx_i2f"); listPush(names, "__tx_f2i");
    listPush(names, "__tx_arith_slow"); listPush(names, "__tx_compare_slow"); listPush(names, "__tx_eq_slow"); listPush(names, "__tx_jbool");
    // 定宽数值转换（字节码 cvt＝52 的种类 1..CVT_KINDS，一种一个入口；scalar_ops cvtOpsEmit）。
    let k = 1;
    while (k <= CVT_KINDS) { listPush(names, "__tx_cvt" + toStr(k)); k = k + 1; }
    // 定宽数值运算族（O4 第二步，scalar_fw fwOpsEmit）：一个入口，操作码随 r9d。
    listPush(names, "__tx_fw_slow");
    return names;
}
function pointer(b: Ref<StructuredBuffer>, base: int, idx: int, out: int): void {
    nmov(b, nd(idx), nd(idx)); nt(b, "shl", nr(idx), ni(4)); nmov(b, nr(out), nr(base)); nt(b, "add", nr(out), nr(idx));
}
function finish(b: Ref<StructuredBuffer>, frame: int, destination: int, value: int): void {
    nmov(b, nr(1), nm(4, destination)); nmov(b, nr(2), nr(4)); nt(b, "add", nr(2), ni(value));
    nc(b, "__tx_native_value_replace_v1"); nt(b, "add", nr(4), ni(frame)); nret(b);
}
function simple(b: Ref<StructuredBuffer>, name: string, kind: int): void {
    nl(b, name); nt(b, "sub", nr(4), ni(56)); pointer(b, 1, 2, 10); nmov(b, nm(4, 48), nr(10));
    if (kind == 1) {
        nt(b, "test", nd(8), nd(8)); no(b, "sete", 1, nb(11), asStructuredMissing()); nt(b, "movzx", nd(11), nb(11)); nt(b, "xor", nd(11), ni(1)); nmov(b, nr(10), ni(3));
    } else if (kind == 2) { nmov(b, nr(10), ni(4)); nmov(b, nr(11), ni(0)); }
    else {
        pointer(b, 1, 8, 11);
        if (kind == 3) { nmov(b, nr(10), nm(11, 0)); nmov(b, nr(11), nm(11, 8)); }
        else { nt(b, "movzx", nd(10), nmb(11, 0)); nt(b, "and", nd(9), ni(255)); nt(b, "cmp", nd(10), nd(9)); no(b, "sete", 1, nb(11), asStructuredMissing()); nt(b, "movzx", nd(11), nb(11)); nmov(b, nr(10), ni(3)); }
    }
    nmov(b, nm(4, 32), nr(10)); nmov(b, nm(4, 40), nr(11)); finish(b, 56, 48, 32);
}
function unary(b: Ref<StructuredBuffer>, name: string, op: int): void {
    nl(b, name); nt(b, "sub", nr(4), ni(104));
    nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 64), nd(9));
    nmov(b, nd(10), nmd(4, 144)); pointer(b, 1, 10, 2);
    nmov(b, nd(1), ni(op)); nmov(b, nr(8), nr(4)); nt(b, "add", nr(8), ni(32)); nc(b, "__tx_native_scalar_unary_v1");
    nt(b, "test", nd(0), nd(0)); nj(b, "jne", name + "_error");
    nmov(b, nr(1), nm(4, 48)); nmov(b, nd(10), nmd(4, 64)); pointer(b, 1, 10, 11); nmov(b, nm(4, 72), nr(11)); finish(b, 104, 72, 32);
    nl(b, name + "_error"); nmov(b, nd(1), ni(op)); nmov(b, nd(2), nd(0)); nmov(b, nd(8), nmd(4, 56)); nmov(b, nd(9), nmd(4, 60)); nc(b, "__tx_native_handler_error_v1");
    // The error adapter is noreturn, but preserve stack validity if a broken adapter returns.
    nt(b, "add", nr(4), ni(104)); nret(b);
}
function binary(b: Ref<StructuredBuffer>, name: string, compare: bool): void {
    nl(b, name); nt(b, "sub", nr(4), ni(120)); nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 68), nd(9));
    nmov(b, nd(10), nmd(4, 160)); nmov(b, nmd(4, 64), nd(10));
    nmov(b, nd(10), nmd(4, 168)); nmov(b, nmd(4, 104), nd(10)); pointer(b, 1, 10, 11); nmov(b, nm(4, 88), nr(11)); nt(b, "movzx", nd(10), nmb(11, 0)); nmov(b, nmd(4, 80), nd(10));
    nmov(b, nd(10), nmd(4, 176)); nmov(b, nmd(4, 108), nd(10)); pointer(b, 1, 10, 11); nmov(b, nm(4, 96), nr(11)); nt(b, "movzx", nd(10), nmb(11, 0)); nmov(b, nmd(4, 84), nd(10));
    if (compare == false) {
        nt(b, "cmp", nmd(4, 68), ni(5)); nj(b, "jne", name + "_numeric"); nt(b, "cmp", nmd(4, 80), ni(6)); nj(b, "jne", name + "_numeric"); nt(b, "cmp", nmd(4, 84), ni(6)); nj(b, "je", name + "_string");
    }
    nl(b, name + "_numeric"); nmov(b, nd(1), nmd(4, 68)); nmov(b, nr(2), nm(4, 88)); nmov(b, nr(8), nm(4, 96)); nmov(b, nr(9), nr(4)); nt(b, "add", nr(9), ni(32)); nc(b, "__tx_native_scalar_binary_v1");
    nt(b, "test", nd(0), nd(0)); nj(b, "jne", name + "_error");
    nmov(b, nr(1), nm(4, 48)); nmov(b, nd(10), nmd(4, 64)); pointer(b, 1, 10, 11); nmov(b, nm(4, 72), nr(11)); finish(b, 120, 72, 32);
    nl(b, name + "_error");
    if (compare) {
        nt(b, "cmp", nmd(4, 80), ni(1)); nj(b, "je", name + "_mismatch"); nt(b, "cmp", nmd(4, 80), ni(2)); nj(b, "je", name + "_mismatch"); nmov(b, nd(0), ni(8));
    } else {
        nt(b, "cmp", nmd(4, 68), ni(9)); nj(b, "jne", name + "_mismatch"); nt(b, "cmp", nmd(4, 80), ni(2)); nj(b, "jne", name + "_mismatch"); nt(b, "cmp", nmd(4, 84), ni(2)); nj(b, "jne", name + "_mismatch"); nmov(b, nd(0), ni(7));
    }
    nl(b, name + "_mismatch"); nmov(b, nd(1), nmd(4, 68)); nmov(b, nd(2), nd(0)); nmov(b, nd(8), nmd(4, 56)); nmov(b, nd(9), nmd(4, 60)); nc(b, "__tx_native_handler_error_v1"); nt(b, "add", nr(4), ni(120)); nret(b);
    if (compare == false) {
        nl(b, name + "_string"); nmov(b, nr(1), nm(4, 48)); nmov(b, nd(2), nmd(4, 56)); nmov(b, nd(8), nmd(4, 60)); nmov(b, nd(9), nmd(4, 64)); nmov(b, nd(10), nmd(4, 104)); nmov(b, nmd(4, 32), nd(10)); nmov(b, nd(10), nmd(4, 108)); nmov(b, nmd(4, 40), nd(10)); nc(b, "__tx_str_concat"); nt(b, "add", nr(4), ni(120)); nret(b);
    }
}
// 定宽数值运算族的窗口入口（同 __tx_arith_slow 的约定：r9d＝操作码，栈参 a/b/c）；状态非 0 时按（操作码, 状态）trap。
function fwBinary(b: Ref<StructuredBuffer>, name: string): void {
    nl(b, name); nt(b, "sub", nr(4), ni(120)); nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 68), nd(9));
    nmov(b, nd(10), nmd(4, 160)); nmov(b, nmd(4, 64), nd(10));
    nmov(b, nd(10), nmd(4, 168)); pointer(b, 1, 10, 11); nmov(b, nm(4, 88), nr(11));
    nmov(b, nd(10), nmd(4, 176)); pointer(b, 1, 10, 11); nmov(b, nm(4, 96), nr(11));
    nmov(b, nd(1), nmd(4, 68)); nmov(b, nr(2), nm(4, 88)); nmov(b, nr(8), nm(4, 96)); nmov(b, nr(9), nr(4)); nt(b, "add", nr(9), ni(32)); nc(b, "__tx_native_scalar_fw_v1");
    nt(b, "test", nd(0), nd(0)); nj(b, "jne", name + "_error");
    nmov(b, nr(1), nm(4, 48)); nmov(b, nd(10), nmd(4, 64)); pointer(b, 1, 10, 11); nmov(b, nm(4, 72), nr(11)); finish(b, 120, 72, 32);
    nl(b, name + "_error"); nmov(b, nd(1), nmd(4, 68)); nmov(b, nd(2), nd(0)); nmov(b, nd(8), nmd(4, 56)); nmov(b, nd(9), nmd(4, 60)); nc(b, "__tx_native_handler_error_v1");
    nt(b, "add", nr(4), ni(120)); nret(b);
}

export function scalarHandlersEmit(b: Ref<StructuredBuffer>): void {
    nl(b, "__tx_native_handlers_abi_v1"); nmov(b, nd(0), ni(1)); nret(b);
    binary(b, "__tx_arith_slow", false); binary(b, "__tx_compare_slow", true);
    fwBinary(b, "__tx_fw_slow");
    simple(b, "__tx_ldbool", 1); simple(b, "__tx_ldnone", 2); simple(b, "__tx_move", 3); simple(b, "__tx_istag", 4);
    unary(b, "__tx_not", 11); unary(b, "__tx_neg", 10); unary(b, "__tx_bnot", 43); unary(b, "__tx_i2f", 36); unary(b, "__tx_f2i", 37);
    let k = 1;
    while (k <= CVT_KINDS) { unary(b, "__tx_cvt" + toStr(k), 100 + k); k = k + 1; }
    nl(b, "__tx_jbool"); nmov(b, nd(10), nmd(4, 40)); pointer(b, 1, 9, 11); nt(b, "movzx", nd(0), nmb(11, 0)); nt(b, "cmp", nd(0), ni(3)); nj(b, "jne", "__tx_jbool_error");
    nmov(b, nr(11), nm(11, 8)); nt(b, "test", nr(11), nr(11)); no(b, "sete", 1, nb(0), asStructuredMissing()); nt(b, "movzx", nd(0), nb(0)); nt(b, "xor", nd(0), ni(1));
    nt(b, "test", nd(10), nd(10)); nj(b, "jne", "__tx_jbool_return"); nt(b, "xor", nd(0), ni(1)); nl(b, "__tx_jbool_return"); nret(b);
    nl(b, "__tx_jbool_error"); nmov(b, nd(9), nd(8)); nmov(b, nd(8), nd(2)); nmov(b, nd(2), ni(1)); nmov(b, nd(1), ni(16)); nj(b, "jmp", "__tx_native_handler_error_v1");
    nl(b, "__tx_eq_slow"); nt(b, "sub", nr(4), ni(104)); nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 64), nd(9));
    nmov(b, nd(10), nmd(4, 152)); pointer(b, 1, 10, 2); nmov(b, nd(10), nmd(4, 144)); pointer(b, 1, 10, 11); nmov(b, nr(1), nr(11)); nmov(b, nd(8), ni(0)); nc(b, "__tx_native_equal_v1");
    nt(b, "cmp", nd(0), ni(2)); nj(b, "jae", "__tx_eq_slow_error"); nmov(b, nm(4, 32), ni(3)); nmov(b, nd(0), nd(0)); nmov(b, nm(4, 40), nr(0));
    nmov(b, nr(1), nm(4, 48)); nmov(b, nd(10), nmd(4, 64)); pointer(b, 1, 10, 11); nmov(b, nm(4, 72), nr(11)); finish(b, 104, 72, 32);
    nl(b, "__tx_eq_slow_error"); nmov(b, nd(1), ni(12)); nmov(b, nd(2), nd(0)); nmov(b, nd(8), nmd(4, 56)); nmov(b, nd(9), nmd(4, 60)); nc(b, "__tx_native_handler_error_v1"); nt(b, "add", nr(4), ni(104)); nret(b);
}
