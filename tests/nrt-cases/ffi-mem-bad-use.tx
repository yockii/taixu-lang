// 外部内存区（D3 v0.48 §6.8-22）前端负例（使用）：不可比较、不是句柄、不进外部函数签名、async 与生成器里不能创建、
// 类型实参须为不含串字段的外部结构体、实参类型、捕获后不可发往线程。
declare struct POINT { x: i32, y: i32 }
declare struct NAMED { name: string, x: i32 }
declare function Bad(m: FfiMem): i32 from "k";

function same(a: FfiMem, b: FfiMem): bool {
    return a == b;
}

function bits(m: FfiMem): int {
    return handleBits(m);
}

function forge(): int {
    const m = handleFromBits<FfiMem>(0);
    return 0;
}

async function inAsync(a: int): int {
    const m = ffiMem(a, 4, false) catch (e) { return 0; };
    return 1;
}

function* inGen(a: int): int {
    const m = ffiMem(a, 4, false) catch (e) { return; };
    yield 1;
}

function layouts(a: int, m: FfiMem): int {
    const s = ffiMemOf<NAMED>(a, false) catch (e) { return 0; };
    const t = ffiMemOf<int>(a, false) catch (e) { return 0; };
    const p = ffiMemGet(m, 0);
    const b = ffiMemRead(m, "x", 4);
    ffiMemWrite(m, 0, 5);
    return 1;
}

function send(m: FfiMem): int {
    const t = threadSpawn((): int => {
            ffiMemEnd(m);
            return 1;
        });
    return 0;
}

function main(args: []string): int {
    return 0;
}
