// D3 v0.49 §6.3-3：块形 catch (e) 在循环里以 continue／break 结束也算离开，跨越的 defer 照常执行；
// 两个分支各自 continue、break 的 if 同样算离开。
function parse(s: string): int | Error {
    if (s == "x" || s == "") {
        return err("坏行 '" + s + "'");
    }
    return len(s);
}

export function main(args: []string): int {
    args;
    let total: int = 0;
    for (line in ["ab", "x", "abc", "stop", "zz"]) {
        defer print("defer " + line);
        if (line == "stop") {
            const n: int = parse("x") catch (e) {
                print("在 stop 处 break");
                break;
            };
            total += n;
        }
        const n: int = parse(line) catch (e) {
            print("跳过：" + toStr(e));
            continue;
        };
        total += n;
    }
    print("total " + toStr(total));
    const words: List<string> = listNew();
    for (w in ["a", "", "bb", "x", "ccc"]) {
        listPush(words, w);
    }
    let i: int = 0;
    let kept: int = 0;
    while (i < listLen(words)) {
        const w: string = listTryGet(words, i) ?? "";
        i += 1;
        const v: int = parse(w) catch (e) {
            if (w == "") {
                continue;
            } else {
                break;
            }
        };
        kept += v;
    }
    print("kept " + toStr(kept) + " i " + toStr(i));
    return 0;
}
