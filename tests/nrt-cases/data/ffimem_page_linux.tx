// ffi-mem 用例页分配的 Linux 实现：from syscall，产物保持静态；匿名私有映射一页，mprotect 改保护，munmap 归还。五个 Linux 目标的
// PROT_*、MAP_PRIVATE｜MAP_ANONYMOUS（0x22）数值相同；页大于 4096 的内核上按整页生效。
declare function mmap(addr: usize, len: usize, prot: i32, flags: i32, fd: i32, off: i64): isize from syscall "mmap";
declare function mprotect(addr: usize, len: usize, prot: i32): isize from syscall "mprotect";
declare function munmap(addr: usize, len: usize): isize from syscall "munmap";

export function pageAlloc(): int {
    const p = mmap(0, 4096, 3, 34, -1, 0) as int;
    if (p < 0) { return 0; }
    return p;
}

export function pageProtect(p: int, prot: int): bool {
    let bits: i32 = 3;
    if (prot == 0) { bits = 0; } else if (prot == 1) { bits = 1; }
    return mprotect(p as usize, 4096, bits) == 0;
}

export function pageFree(p: int): void {
    munmap(p as usize, 4096);
}

export function writableChecked(): bool {
    return false;
}
