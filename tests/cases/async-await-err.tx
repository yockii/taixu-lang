// V0.9-A1 e2e：await 产出 T | Error——任务内 err 原样穿透联合通道。
function main(args: []string): int {
    const b = boom();
    const h = handle(b);
    print("spawned");
    return 0;
}

async function boom(): int {
    return err("boom!");
}

async function handle(f: Future<int>): int {
    const v = await f catch (e) {
        print("caught:");
        print(e.message);
        return -1;
    };
    print("unreachable");
    print(toStr(v));
    return v;
}
