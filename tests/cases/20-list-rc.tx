// LANG-07 RC 验收（V0.7-S2，D20 §六）：循环 push/pop 零滞留——string 元素随 RC 释放。
export function main(args: []string): int {
    const l: List<string> = listNew();
    let i: int = 0;
    while (i < 500) {
        listPush(l, toStr(i)); // 每轮新串入表（RETAIN）
        const p = listPop(l) catch ""; // 移交出表；p 下轮覆写时释放
        if (len(p) == 0) {
            return 1;
        }
        i = i + 1;
    }
    if (listLen(l) != 0) {
        return 2;
    }
    print("list-rc ok");
    return 0;
}
