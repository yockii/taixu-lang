// std/file 系统面的 macOS 目标文件（导出面同 file_sys_linux.tx）：经 libSystem（D3 §6.8-7），语义同 Linux 版——打开带
// O_CLOEXEC，新建文件权限 0666（再受 umask 约束）；只读打开后经 fstat 拒绝目录；读、写遇 EINTR 重试。含 NUL 的路径按失败
// 处理。libSystem 失败时返回 -1、错误码经 ffiLastError 读（D3 §6.8-15）。open 是 C 变参函数，mode 按变参约定传（D3 §6.8-21）。
import { nulFree } from "./sys_text";

declare function open(path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function read(fd: i32, buf: Bytes, n: usize): isize from "libSystem";
declare function write(fd: i32, buf: Bytes, n: usize): isize from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
declare function fstat(fd: i32, st: Bytes): i32 from "libSystem";
declare function lseek(fd: i32, off: int, whence: i32): int from "libSystem";

const EINTR: int = 4;
// O_RDONLY｜O_CLOEXEC；O_WRONLY｜O_CREAT｜O_TRUNC｜O_CLOEXEC；O_WRONLY｜O_CREAT｜O_APPEND｜O_CLOEXEC（macOS 的标志值）。
const OPEN_READ: int = 16777216;
const OPEN_WRITE: int = 16778753;
const OPEN_APPEND: int = 16777737;
const MODE_0666: int = 438;
// struct stat（64 位 inode 布局，144 字节；x86_64 链接 fstat$INODE64）：st_mode 为偏移 4 的 u16。
const STAT_SIZE: int = 144;
const S_IFMT: int = 61440;
const S_IFDIR: int = 16384;

export function sysFileOpen(path: string, mode: int): int {
    if (!nulFree(path) || len(path) == 0) {
        return -1;
    }
    let flags: int = OPEN_READ;
    if (mode == 1) {
        flags = OPEN_WRITE;
    } else if (mode == 2) {
        flags = OPEN_APPEND;
    }
    let fd: int = open(path, wrapTo<i32>(flags), wrapTo<u32>(MODE_0666));
    while (fd < 0 && ffiLastError() == EINTR) {
        fd = open(path, wrapTo<i32>(flags), wrapTo<u32>(MODE_0666));
    }
    if (fd < 0) {
        return -1;
    }
    if (mode == 0) {
        const st = bytesNew(STAT_SIZE);
        if (fstat(wrapTo<i32>(fd), st) != 0 || ((bytesGetLE<u16>(st, 4) ?? 0) & S_IFMT) == S_IFDIR) {
            close(wrapTo<i32>(fd));
            return -1;
        }
    }
    const h = __rtHandleAdd(fd);
    if (h < 0) {
        close(wrapTo<i32>(fd));
        return -1;
    }
    return h;
}

export function sysFileRead(h: int, buf: Bytes, n: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    while (true) {
        const r: int = read(wrapTo<i32>(fd), buf, wrapTo<usize>(n));
        if (r >= 0) {
            return r;
        }
        if (ffiLastError() != EINTR) {
            return -1;
        }
    }
    return -1;
}

// 从 data 的 off 处写至多 n 字节，返回实际写出的字节数（off > 0 时先切出这一段）。
export function sysFileWrite(h: int, data: Bytes, off: int, n: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    if (n == 0) {
        return 0;
    }
    let src: Bytes = data;
    if (off > 0) {
        src = bytesSlice(data, off, n);
    }
    while (true) {
        const r: int = write(wrapTo<i32>(fd), src, wrapTo<usize>(n));
        if (r >= 0) {
            return r;
        }
        if (ffiLastError() != EINTR) {
            return -1;
        }
    }
    return -1;
}

export function sysFileSeek(h: int, offset: int, whence: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    const r = lseek(wrapTo<i32>(fd), offset, wrapTo<i32>(whence));
    if (r < 0) {
        return -1;
    }
    return r;
}

// close 被信号打断时不重试（同 Linux 版：描述符的状态此时不确定，重试可能关掉别人新打开的）。
export function sysFileClose(h: int): void {
    const fd = __rtHandleTake(h);
    if (fd >= 0) {
        close(wrapTo<i32>(fd));
    }
}
