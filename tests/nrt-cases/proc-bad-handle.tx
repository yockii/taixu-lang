// 第 6 轮 6c-3（TOOL-103）：关闭后的句柄随即失效，再用即 trap 4010（伴文件 proc-bad-handle.toolchain）。
function main(args: []string): int {
    if (len(args) > 0) { return 0; }
    const argv: List< string> = listNew();
    listPush(argv, "child");
    const h = procSpawn(selfExePath(), argv, "", 0) catch -1;
    print("spawned: " + toStr(h > 0));
    const code = procWait(h, 10000) catch -1;
    print("child exit: " + toStr(code));
    procClose(h);
    print("closed");
    const again = procWait(h, 0) catch -1;
    print("unreachable " + toStr(again));
    return 0;
}
