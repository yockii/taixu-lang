// tree —— 树形控件守护：选中行→折叠分支→再展开；
// 状态行打印选中标签与可见行数。零新事件 kind：点击经 hitZone/重放 id 直达，
// 折叠/展开由坐标命中分支符号列（pump 消费面在本测试内联——控件为纯数据面）。
import { Tree, TreeNode, treeNew, treeVisible, treeToggle, treeHit, drawTreeC, Canvas, canvasNew, paintText } from "gui/components";
import { appNew, appClose, pump, onEvent, defaultSpec } from "gui/app";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { EventRecord } from "std/events";

const TREE_ID: int = 9;

struct Model {
    surface: int,
    tree: Ref<Tree>,
    toggled: int,
}

function render(surface: int, w: int, h: int, m: Ref<Model>): void {
    surfaceClear(surface, 0x202040);
    const cv: Ref<Canvas> = canvasNew(surface, w, h);
    drawTreeC(cv, m.tree);
    const vis: List<int> = treeVisible(m.tree);
    paintText(cv, 4, h - 14, 0xFFFFFF, "visible=" + toStr(listLen(vis)) + " sel=" + toStr(m.tree.selected));
}

export function main(args: []string): int {
    args;
    const nodes: List<Ref<TreeNode>> = listNew();
    listPush(nodes, new TreeNode { label: "src", depth: 0, branch: true });
    listPush(nodes, new TreeNode { label: "app.tx", depth: 1, branch: false });
    listPush(nodes, new TreeNode { label: "components.tx", depth: 1, branch: false });
    listPush(nodes, new TreeNode { label: "docs", depth: 0, branch: true });
    listPush(nodes, new TreeNode { label: "guide.md", depth: 1, branch: false });
    const m: Ref<Model> = new Model { surface: 0, tree: treeNew(TREE_ID, 8, 8, 160, nodes), toggled: 0 };
    const spec = defaultSpec("taixu tree", 200, 120);
    const app = appNew(spec);
    m.surface = surfaceOpen(spec.w, spec.h) catch 0;
    // 点击消费：行选中；分支符号列（缩进起 12px 内）→ 折叠/展开翻转。
    onEvent(app, TREE_ID, (rec: EventRecord): void => {
            if (rec.kind == 3) {
                const row: int = treeHit(m.tree, rec.x, rec.y);
                if (row >= 0) {
                    const indent: int = m.tree.x + 2;
                    if (rec.x >= indent && rec.x < indent + 12) {
                        treeToggle(m.tree, treeVisible(m.tree), row);
                        m.toggled = m.toggled + 1;
                    } else {
                        m.tree.selected = row;
                    }
                    app.dirty = true;
                }
            }
        });
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            render(m.surface, app.w, app.h, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    const vis: List<int> = treeVisible(m.tree);
    const selRow = listTryGet(vis, m.tree.selected) catch -1;
    let selLabel: string = "none";
    if (selRow >= 0) {
        const n = listTryGet(m.tree.nodes, selRow) catch new TreeNode { label: "?", depth: 0, branch: false };
        selLabel = n.label;
    }
    print("visible=" + toStr(listLen(vis)) + " sel=" + selLabel + " toggled=" + toStr(m.toggled) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
