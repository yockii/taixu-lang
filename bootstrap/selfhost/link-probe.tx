// link-probe.tx —— link_pe.tx 批 D 探针：装配态（asm-probe 前半同链）＋shim obj
// → PE 字节落盘。用法：link-probe <file.s> <shim.obj> <out.exe>
import { assembleText } from "./assemble";
import { linkExe, exeBytesList, lkIsFailed, lkGetMissing } from "./link_pe";

function main(args: []string): int {
    if (len(args) < 3) {
        eprint("用法: link-probe <file.s> <shim.obj> <out.exe>");
        return 64;
    }
    eprint("[probe] start");
    const src: string = readFile(args[0]) catch "";
    if (len(src) == 0) {
        eprint("s read fail");
        return 1;
    }
    eprint("[probe] s read len=" + toStr(len(src)));
    const obj: string = readFile(args[1]) catch "";
    if (len(obj) == 0) {
        eprint("obj read fail");
        return 1;
    }
    eprint("[probe] obj read len=" + toStr(len(obj)));
    eprint("[probe] assembling...");
    assembleText(src);
    eprint("[probe] assembled, linking...");
    const rc = linkExe(obj, 0);
    if (rc != 0) {
        eprint("link fail: " + lkGetMissing());
        return 2;
    }
    writeFileBytes(args[2], exeBytesList()) catch (e) {
        eprint("write fail: " + e.message);
        return 3;
    };
    print("exe " + toStr(listLen(exeBytesList())) + "B");
    return 0;
}
