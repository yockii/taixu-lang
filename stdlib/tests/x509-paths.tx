import { x509VerifyServer } from "std/x509_verify";
import { p256Hex } from "std/crypto/p256_field";
import { parseInt } from "std/strconv";

test "服务证书路径：独立跨实现接受与约束拒绝" {
    const fixture = readFile("tests/vectors/x509-paths.txt") catch panic("path fixture"); let accepted = 0; let rejected = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const roots: List<Bytes> = listNew(); const chain: List<Bytes> = listNew();
        listPush(roots, p256Hex(listGet(p, 3)));
        for (encoded in strSplit(listGet(p, 4), ",")) { listPush(chain, p256Hex(encoded)); }
        const time = parseInt(listGet(p, 2)) catch panic("time"); let failed = false;
        x509VerifyServer(chain, "example.test", time, roots) catch (e) { failed = true; };
        if (listGet(p, 0) == "ok") { assert(!failed, "accept " + listGet(p, 1)); accepted = accepted + 1; }
        else { assert(failed, "reject " + listGet(p, 1)); rejected = rejected + 1; }
    }
    assert(accepted == 4 && rejected == 14, "all fixed path cases");
}
