function total(nums: [4]int): int {
    let t: int = 0;
    for (v in nums) {
        t = t + v;
    }
    return t;
}

export function main(args: []string): int {
    const nums: List<int> = listNew();
    nums.push(1);
    nums.push(2);
    nums.push(3);
    let acc: int = 0;
    for (x in nums) {
        if (x == 2) { continue; }
        acc = acc + x;
        if (x == 3) { break; }
    }
    print(toStr(acc));
    let bytes: int = 0;
    for (b in "A太") {
        bytes = bytes + b;
    }
    print(toStr(bytes));
    print(toStr(total([4, 5, 6, 7])));
    const sl: []int = [9, 8];
    let s2: int = 0;
    for (v in sl) {
        s2 = s2 + v;
    }
    print(toStr(s2));
    let pairs: int = 0;
    for (x in nums) {
        for (y in nums) {
            pairs = pairs + 1;
        }
    }
    print(toStr(pairs));
    return 0;
}
