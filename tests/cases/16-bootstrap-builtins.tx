// BOOT-02：自举层内建——byteAt（越界 None）与 utf8Encode（非法码点 Error）。
export function main(args: []string): int {
    const s: string = "太a";
    const b0 = byteAt(s, 0) catch -1; // 太 的首字节 0xE5
    const b1 = byteAt(s, 3) catch -1; // 'a'
    const oob1 = byteAt(s, 4) catch -1; // 越界 → None → catch 默认
    const oob2 = byteAt(s, 0 - 1) catch -1; // 负索引 → None
    print("bytes: " + toStr(b0) + "," + toStr(b1) + "," + toStr(oob1) + "," + toStr(oob2));

    const e1 = utf8Encode(0x592A) catch "?"; // U+592A = 太
    const e2 = utf8Encode(0xD800) catch "?"; // 代理区段 → Error → catch 默认
    const e3 = utf8Encode(0x110000) catch "?"; // 越界 → Error
    print("enc: " + e1 + "," + e2 + "," + e3);
    return 0;
}
