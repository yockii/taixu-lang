// Linux x86-64 OS boundary for the existing private-window native kernel.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferSection, asBufferLabel, asBufferByte, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";

function reg(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function imm(n: int): Ref<Operand> { return asStructuredImm(n); }
function name(n: string): Ref<Operand> { return asStructuredTarget(n); }
function emit(b: Ref<StructuredBuffer>, op: string, count: int, x: Ref<Operand>, y: Ref<Operand>): void {
    asBufferInstruction(b, op, count, x, y, asStructuredMissing(), 1);
}
function one(b: Ref<StructuredBuffer>, op: string, x: Ref<Operand>): void { emit(b, op, 1, x, asStructuredMissing()); }
function zero(b: Ref<StructuredBuffer>, op: string): void { emit(b, op, 0, asStructuredMissing(), asStructuredMissing()); }
function label(b: Ref<StructuredBuffer>, n: string): void { asBufferLabel(b, n, 1); }

export function linuxMemoryExports(b: Ref<StructuredBuffer>, withMove: bool): void {
    asBufferSection(b, 0, 1);
    const names: List<string> = listNew(); listPush(names, "memcpy"); listPush(names, "memset");
    if (withMove) { listPush(names, "memmove"); }
    let i = 0;
    while (i < listLen(names)) {
        const n = listGet(names, i) catch "";
        label(b, n);
        // SysV (rdi,rsi,rdx) -> private (rcx,rdx,r8), with shadow space.
        emit(b, "mov", 2, reg(1), reg(7)); emit(b, "mov", 2, reg(8), reg(2));
        emit(b, "mov", 2, reg(2), reg(6)); emit(b, "sub", 2, reg(4), imm(40));
        one(b, "call", name("__tx_linux_" + n));
        emit(b, "add", 2, reg(4), imm(40)); zero(b, "ret"); i = i + 1;
    }
}

export function linuxPageAdapters(b: Ref<StructuredBuffer>): void {
    asBufferSection(b, 0, 1);
    label(b, "__tx_linux_page_alloc");
    // mmap(0, length, PROT_READ|WRITE, MAP_PRIVATE|ANONYMOUS, -1, 0).
    // Mappings up to 256KB (small-block pages, which carving touches at once,
    // and mid-size blocks) add MAP_POPULATE: one syscall builds the page
    // table instead of one fault per page. Contents stay all zero.
    // rdi/rsi are nonvolatile in the private ABI; syscall destroys rcx/r11.
    one(b, "push", reg(7)); one(b, "push", reg(6));
    emit(b, "mov", 2, reg(6), reg(2)); emit(b, "xor", 2, reg(7), reg(7));
    emit(b, "mov", 2, reg(2), imm(3)); emit(b, "mov", 2, reg(10), imm(34));
    emit(b, "cmp", 2, reg(6), imm(262144)); one(b, "ja", name("__tx_linux_map_lazy"));
    emit(b, "or", 2, reg(10), imm(32768)); label(b, "__tx_linux_map_lazy");
    emit(b, "mov", 2, reg(8), imm(-1)); emit(b, "xor", 2, reg(9), reg(9));
    emit(b, "mov", 2, reg(0), imm(9)); zero(b, "syscall");
    emit(b, "cmp", 2, reg(0), imm(-4095)); one(b, "jb", name("__tx_linux_map_ok"));
    emit(b, "xor", 2, reg(0), reg(0)); label(b, "__tx_linux_map_ok");
    one(b, "pop", reg(6)); one(b, "pop", reg(7)); zero(b, "ret");

    label(b, "__tx_linux_page_free");
    one(b, "push", reg(7)); one(b, "push", reg(6));
    emit(b, "mov", 2, reg(7), reg(1)); emit(b, "mov", 2, reg(6), reg(2));
    emit(b, "mov", 2, reg(0), imm(11)); zero(b, "syscall");
    one(b, "pop", reg(6)); one(b, "pop", reg(7)); zero(b, "ret");
}

export function linuxMemoryPanic(b: Ref<StructuredBuffer>, entry: string, data: string, message: string): void {
    linuxAbort(b, entry, data, message, 134);
}

export function linuxAbort(b: Ref<StructuredBuffer>, entry: string, data: string, message: string, status: int): void {
    asBufferSection(b, 0, 1); label(b, entry);
    emit(b, "mov", 2, reg(0), imm(1)); emit(b, "mov", 2, reg(7), imm(2));
    emit(b, "lea", 2, reg(6), asStructuredMem(2, -1, -1, 0, 0, 1, data));
    emit(b, "mov", 2, reg(2), imm(len(message) + 1)); zero(b, "syscall");
    emit(b, "mov", 2, reg(0), imm(231)); emit(b, "mov", 2, reg(7), imm(status)); zero(b, "syscall");
    zero(b, "ud2");
    asBufferSection(b, 1, 1); label(b, data);
    let i = 0;
    while (i < len(message)) { asBufferByte(b, byteAt(message, i) catch 0, 1); i = i + 1; }
    asBufferByte(b, 10, 1);
}
