// ============================================================================
// std/image —— PNG 解码（"仅 BMP"之墙）。纯 .tx，
// 零宿主 extern；IDAT 解压经 std/compress inflate（确定性红线——向量锚
// tests/image-fx.tx，fixture 由独立实现生成后冻结）。
//
// 支持面：bit depth 8 × color type 0/2/3/4/6（灰度/RGB/调色板/灰α/RGBA）；
// filter 0–4 全还原（None/Sub/Up/Average/Paeth）；PLTE/tRNS；多 IDAT 拼接；
// CRC32 逐块校验（std/compress crc32——坏块结构化拒绝）。
// **登记不实施**（README 如实注记）：bit depth 16、行间 Adam7 interlace、
// 附加块（gAMA/iCCP 等一律安全跳过——PNG 规范 ancillary 语义）。
// 输出＝RGBA8 像素面（宽×高×4 的 List<int>，行主序）＋宽高。
// ============================================================================

// IDAT 为 zlib 包装流（RFC 1950）——经 std/compress zlibDecompress
// 解压（头校验＋adler32 尾随校验）；块 CRC 面用 crc32。
import { zlibDecompress, crc32 } from "std/compress";

const MAX_PIXELS: int = 16777216; // 4096×4096 上限（解压炸弹同款守卫）

export struct PngImage {
    width: int,
    height: int,
    pixels: List<int>, // RGBA8 行主序，len = w*h*4，元素 0..255
}

export function decodePngHex(hex: string): PngImage | Error {
    return decodePng(hexBytes(hex));
}

export function decodePng(data: List<int>): PngImage | Error {
    const n: int = listLen(data);
    if (n < 57) {
        return err("png: 流过短（签名＋最小 IHDR/IDAT/IEND）");
    }
    // 签名：89 50 4E 47 0D 0A 1A 0A。
    if ((listTryGet(data, 0) catch 0) != 0x89 || (listTryGet(data, 1) catch 0) != 0x50
        || (listTryGet(data, 2) catch 0) != 0x4E || (listTryGet(data, 3) catch 0) != 0x47
        || (listTryGet(data, 4) catch 0) != 0x0D || (listTryGet(data, 5) catch 0) != 0x0A
        || (listTryGet(data, 6) catch 0) != 0x1A || (listTryGet(data, 7) catch 0) != 0x0A) {
        return err("png: magic 不符");
    }
    let width: int = 0;
    let height: int = 0;
    let colorType: int = -1;
    let interlace: int = -1;
    const palette: List<int> = listNew();
    let palCount: int = 0;
    const trns: List<int> = listNew();
    let trnsGray: int = -1;
    let trnsR: int = -1;
    let trnsG: int = -1;
    let trnsB: int = -1;
    const idat: List<int> = listNew();
    let sawIEND: bool = false;
    let p: int = 8;
    while (p < n && !sawIEND) {
        if (p + 8 > n) {
            return err("png: 块头截断");
        }
        const clen: int = u32be(data, p);
        let ctype: string = "";
        ctype = typeStr(data, p + 4);
        if (p + 12 + clen > n) {
            return err("png: 块数据截断");
        }
        const dstart: int = p + 8;
        // CRC32（type＋data 逐块校验）。
        const crced: List<int> = listNew();
        let ci: int = 0;
        while (ci < 4 + clen) {
            listPush(crced, listTryGet(data, p + 4 + ci) catch 0);
            ci = ci + 1;
        }
        if (crc32(crced) != u32be(data, dstart + clen)) {
            return err("png: CRC32 校验失败");
        }
        if (ctype == "IHDR") {
            if (clen != 13) {
                return err("png: IHDR 长度非法");
            }
            width = u32be(data, dstart);
            height = u32be(data, dstart + 4);
            const depth: int = listTryGet(data, dstart + 8) catch 0;
            colorType = listTryGet(data, dstart + 9) catch 0;
            const compression: int = listTryGet(data, dstart + 10) catch 0;
            const filterMethod: int = listTryGet(data, dstart + 11) catch 0;
            interlace = listTryGet(data, dstart + 12) catch 0;
            if (depth != 8) {
                return err("png: bit depth 8 限定（16 登记不实施）");
            }
            if (colorType != 0 && colorType != 2 && colorType != 3 && colorType != 4 && colorType != 6) {
                return err("png: color type 非法");
            }
            if (compression != 0 || filterMethod != 0) {
                return err("png: 压缩/滤波方法非法");
            }
            if (interlace != 0) {
                return err("png: Adam7 interlace 登记不实施");
            }
            if (width <= 0 || height <= 0 || width * height > MAX_PIXELS) {
                return err("png: 尺寸越界");
            }
        } else if (ctype == "PLTE") {
            if (clen % 3 != 0 || clen > 768) {
                return err("png: PLTE 长度非法");
            }
            palCount = clen / 3;
            let i: int = 0;
            while (i < clen) {
                listPush(palette, listTryGet(data, dstart + i) catch 0);
                i = i + 1;
            }
        } else if (ctype == "tRNS") {
            if (colorType == 0) {
                if (clen != 2) {
                    return err("png: tRNS 长度非法");
                }
                trnsGray = ((listTryGet(data, dstart) catch 0) << 8 | (listTryGet(data, dstart + 1) catch 0)) & 0xFF;
            } else if (colorType == 2) {
                if (clen != 6) {
                    return err("png: tRNS 长度非法");
                }
                trnsR = ((listTryGet(data, dstart) catch 0) << 8 | (listTryGet(data, dstart + 1) catch 0)) & 0xFF;
                trnsG = ((listTryGet(data, dstart + 2) catch 0) << 8 | (listTryGet(data, dstart + 3) catch 0)) & 0xFF;
                trnsB = ((listTryGet(data, dstart + 4) catch 0) << 8 | (listTryGet(data, dstart + 5) catch 0)) & 0xFF;
            } else if (colorType == 3) {
                if (clen > palCount) {
                    return err("png: tRNS 超调色板");
                }
                let i: int = 0;
                while (i < clen) {
                    listPush(trns, listTryGet(data, dstart + i) catch 0);
                    i = i + 1;
                }
            } else {
                return err("png: tRNS 不适用该 color type");
            }
        } else if (ctype == "IDAT") {
            let i: int = 0;
            while (i < clen) {
                listPush(idat, listTryGet(data, dstart + i) catch 0);
                i = i + 1;
            }
        } else if (ctype == "IEND") {
            sawIEND = true;
        }
        // 其余块（ancillary/私用）安全跳过。
        p = dstart + clen + 4;
    }
    if (!sawIEND) {
        return err("png: 缺 IEND");
    }
    if (width <= 0 || height <= 0) {
        return err("png: 缺 IHDR");
    }
    if (colorType == 3 && palCount == 0) {
        return err("png: 调色板类型缺 PLTE");
    }
    if (listLen(idat) == 0) {
        return err("png: 缺 IDAT");
    }
    const raw: List<int> = zlibDecompress(idat)?;
    const px: List<int> = unfilterToRgba(raw, width, height, colorType,
        palette, palCount, trns, trnsGray, trnsR, trnsG, trnsB)?;
    const img: PngImage = { width: width, height: height, pixels: px };
    return img;
}

// —— filter 0–4 全还原 → RGBA8 展开 ——

function unfilterToRgba(raw: List<int>, w: int, h: int, colorType: int,
    palette: List<int>, palCount: int, trns: List<int>, trnsGray: int,
    trnsR: int, trnsG: int, trnsB: int): List<int> | Error {
    let channels: int = 4;
    if (colorType == 0 || colorType == 3) {
        channels = 1;
    } else if (colorType == 4) {
        channels = 2;
    } else if (colorType == 2) {
        channels = 3;
    }
    const stride: int = w * channels;
    const need: int = h * (stride + 1);
    if (listLen(raw) != need) {
        return err("png: 解压后行长不符");
    }
    const out: List<int> = listNew();
    let prev: List<int> = listNew();
    let y: int = 0;
    while (y < h) {
        const ft: int = listTryGet(raw, y * (stride + 1)) catch 0;
        if (ft < 0 || ft > 4) {
            return err("png: 非法 filter 类型");
        }
        const cur: List<int> = listNew();
        let x: int = 0;
        while (x < stride) {
            const base: int = y * (stride + 1) + 1;
            const filt: int = listTryGet(raw, base + x) catch 0;
            let lv: int = 0;
            if (x >= channels) {
                lv = listTryGet(cur, x - channels) catch 0;
            }
            const uv: int = listTryGet(prev, x) catch 0;
            let ul: int = 0;
            if (x >= channels) {
                ul = listTryGet(prev, x - channels) catch 0;
            }
            let v: int = filt;
            if (ft == 1) {
                v = filt + lv;
            } else if (ft == 2) {
                v = filt + uv;
            } else if (ft == 3) {
                v = filt + ((lv + uv) >>> 1);
            } else if (ft == 4) {
                v = filt + paeth(lv, uv, ul);
            }
            listPush(cur, v & 0xFF);
            x = x + 1;
        }
        if (expandRow(cur, w, colorType, palette, palCount, trns, trnsGray,
                trnsR, trnsG, trnsB, out) != 0) {
            return err("png: 调色板索引越界");
        }
        prev = cur;
        y = y + 1;
    }
    return out;
}

// Paeth 预测器（PNG 规范 §6）。
function paeth(a: int, b: int, c: int): int {
    const pp: int = a + b - c;
    const pa: int = absOf(pp - a);
    const pb: int = absOf(pp - b);
    const pc: int = absOf(pp - c);
    if (pa <= pb && pa <= pc) {
        return a;
    }
    if (pb <= pc) {
        return b;
    }
    return c;
}

function absOf(v: int): int {
    if (v < 0) {
        return -v;
    }
    return v;
}

// 单行展开为 RGBA8（tRNS 透明键/调色板 alpha 在此收口）；0＝ok，-1＝索引越界。
function expandRow(cur: List<int>, w: int, colorType: int, palette: List<int>,
    palCount: int, trns: List<int>, trnsGray: int, trnsR: int, trnsG: int,
    trnsB: int, out: List<int>): int {
    let x: int = 0;
    while (x < w) {
        if (colorType == 0) {
            const g: int = listTryGet(cur, x) catch 0;
            let alpha: int = 255;
            if (trnsGray == g) {
                alpha = 0;
            }
            pushRgba(out, g, g, g, alpha);
        } else if (colorType == 2) {
            const r: int = listTryGet(cur, x * 3) catch 0;
            const g: int = listTryGet(cur, x * 3 + 1) catch 0;
            const b: int = listTryGet(cur, x * 3 + 2) catch 0;
            let alpha: int = 255;
            if (trnsR == r && trnsG == g && trnsB == b) {
                alpha = 0;
            }
            pushRgba(out, r, g, b, alpha);
        } else if (colorType == 3) {
            const idx: int = listTryGet(cur, x) catch 0;
            if (idx >= palCount) {
                return -1; // 规范：越界索引按错误处理。
            }
            const r: int = listTryGet(palette, idx * 3) catch 0;
            const g: int = listTryGet(palette, idx * 3 + 1) catch 0;
            const b: int = listTryGet(palette, idx * 3 + 2) catch 0;
            const alpha: int = listTryGet(trns, idx) catch 255;
            pushRgba(out, r, g, b, alpha);
        } else if (colorType == 4) {
            const g: int = listTryGet(cur, x * 2) catch 0;
            const a: int = listTryGet(cur, x * 2 + 1) catch 0;
            pushRgba(out, g, g, g, a);
        } else {
            const r: int = listTryGet(cur, x * 4) catch 0;
            const g: int = listTryGet(cur, x * 4 + 1) catch 0;
            const b: int = listTryGet(cur, x * 4 + 2) catch 0;
            const a: int = listTryGet(cur, x * 4 + 3) catch 0;
            pushRgba(out, r, g, b, a);
        }
        x = x + 1;
    }
    return 0;
}

function pushRgba(out: List<int>, r: int, g: int, b: int, a: int): void {
    listPush(out, r & 0xFF);
    listPush(out, g & 0xFF);
    listPush(out, b & 0xFF);
    listPush(out, a & 0xFF);
}

// —— 字节取数助手 ——

function u32be(data: List<int>, at: int): int {
    return ((listTryGet(data, at) catch 0) << 24) | ((listTryGet(data, at + 1) catch 0) << 16)
    | ((listTryGet(data, at + 2) catch 0) << 8) | (listTryGet(data, at + 3) catch 0);
}

function typeStr(data: List<int>, at: int): string {
    let s: string = "";
    let i: int = 0;
    while (i < 4) {
        s = s + (utf8Encode(listTryGet(data, at + i) catch 0) catch "");
        i = i + 1;
    }
    return s;
}

function hexBytes(hex: string): List<int> {
    const t: List<int> = listNew();
    const n: int = len(hex);
    let i: int = 0;
    while (i + 1 < n) {
        const hi: int = hexVal(byteTryAt(hex, i) catch -1);
        const lo: int = hexVal(byteTryAt(hex, i + 1) catch -1);
        if (hi >= 0 && lo >= 0) {
            listPush(t, hi * 16 + lo);
        }
        i = i + 2;
    }
    return t;
}

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    if (b >= 65 && b <= 70) {
        return b - 55;
    }
    return -1;
}

// ============================================================================
// BMP（2026-10-26，GUI 引擎 G0）：读 24/32 位非压缩（BI_RGB），写 24 位。像素面为自顶向下的紧凑
// RGB（宽×高×3 的 Bytes），GUI 定格三伴的 .bmp 与引擎读图共用。
// 读：高为正（自底向上）与为负（自顶向下）都收；32 位只取低三字节 BGR（alpha 不取）；调色板、
// 压缩、位面不为 1 一律拒绝。先核对全部行都落在输入之内、解码面不超过 64 MiB，再分配。
// 写：BITMAPINFOHEADER，自底向上，BGR，行按 4 字节对齐，分辨率 2835 像素/米（72 DPI）。
// ============================================================================

const BMP_MAX_DECODED: int = 67108864; // 解码面上限 64 MiB
const BMP_MAX_SIDE: int = 1073741824; // 边长上限 2^30：之后的乘积都在 int 之内

export struct BmpImage {
    width: int,
    height: int,
    rgb: Bytes, // 自顶向下的紧凑 RGB，长度 width*height*3
}

export function decodeBmp(data: Bytes): BmpImage | Error {
    const n: int = bytesLen(data);
    if (n < 54 || (bytesGet(data, 0) catch 0) != 66 || (bytesGet(data, 1) catch 0) != 77) {
        return err("bmp: 头过短或 magic 不符");
    }
    const dataOff: int = bytesGetLE<u32>(data, 10) catch 0;
    const headerSize: int = bytesGetLE<u32>(data, 14) catch 0;
    if (headerSize < 40) {
        return err("bmp: 不支持的信息头（须为 BITMAPINFOHEADER 或更新的形式）");
    }
    const w: int = bytesGetLE<i32>(data, 18) catch 0;
    const hRaw: int = bytesGetLE<i32>(data, 22) catch 0;
    const planes: int = bytesGetLE<u16>(data, 26) catch 0;
    const bpp: int = bytesGetLE<u16>(data, 28) catch 0;
    const compression: int = bytesGetLE<u32>(data, 30) catch 0;
    if (planes != 1) {
        return err("bmp: 位面数须为 1");
    }
    if (compression != 0) {
        return err("bmp: 不支持压缩形式（只收 BI_RGB）");
    }
    if (bpp != 24 && bpp != 32) {
        return err("bmp: 不支持的位深 " + toStr(bpp) + "（只收 24、32）");
    }
    if (w <= 0 || hRaw == 0) {
        return err("bmp: 宽须为正、高不能为 0");
    }
    const bottomUp: bool = hRaw > 0;
    let h: int = hRaw;
    if (!bottomUp) {
        h = -hRaw;
    }
    if (w > BMP_MAX_SIDE || h > BMP_MAX_SIDE || w * h * 3 > BMP_MAX_DECODED) {
        return err("bmp: 解码面超过 64 MiB");
    }
    const step: int = bpp / 8;
    const rowRaw: int = w * step;
    const rowStride: int = (rowRaw + 3) / 4 * 4;
    if (dataOff + (h - 1) * rowStride + rowRaw > n) {
        return err("bmp: 像素数据截断");
    }
    const rgb = bytesNew(w * h * 3);
    let y: int = 0;
    while (y < h) {
        let srcRow: int = y;
        if (bottomUp) {
            srcRow = h - 1 - y;
        }
        const rowOff: int = dataOff + srcRow * rowStride;
        let x: int = 0;
        while (x < w) {
            const off: int = rowOff + x * step;
            const dst: int = (y * w + x) * 3;
            bytesSet(rgb, dst, bytesGet(data, off + 2) catch 0);
            bytesSet(rgb, dst + 1, bytesGet(data, off + 1) catch 0);
            bytesSet(rgb, dst + 2, bytesGet(data, off) catch 0);
            x = x + 1;
        }
        y = y + 1;
    }
    const img: BmpImage = { width: w, height: h, rgb: rgb };
    return img;
}

export function encodeBmp(width: int, height: int, rgb: Bytes): Bytes | Error {
    if (width <= 0 || height <= 0 || width > BMP_MAX_SIDE || height > BMP_MAX_SIDE) {
        return err("bmp: 宽高须在 1..2^30");
    }
    if (bytesLen(rgb) != width * height * 3) {
        return err("bmp: 像素长度须为 宽×高×3");
    }
    const rowRaw: int = width * 3;
    const rowStride: int = (rowRaw + 3) / 4 * 4;
    const pixelBytes: int = rowStride * height;
    const fileSize: int = 54 + pixelBytes;
    if (fileSize > 4294967295) {
        return err("bmp: 文件超过 4 GiB");
    }
    const out = bytesNew(fileSize);
    bytesSet(out, 0, 66);
    bytesSet(out, 1, 77);
    bytesSetLE<u32>(out, 2, fileSize as u32);
    bytesSetLE<u32>(out, 10, 54); // 像素数据偏移
    bytesSetLE<u32>(out, 14, 40); // BITMAPINFOHEADER
    bytesSetLE<i32>(out, 18, width as i32);
    bytesSetLE<i32>(out, 22, height as i32);
    bytesSetLE<u16>(out, 26, 1); // 位面
    bytesSetLE<u16>(out, 28, 24);
    bytesSetLE<u32>(out, 34, pixelBytes as u32);
    bytesSetLE<i32>(out, 38, 2835);
    bytesSetLE<i32>(out, 42, 2835);
    let y: int = 0;
    while (y < height) {
        const src: int = (height - 1 - y) * rowRaw;
        const dst: int = 54 + y * rowStride;
        let x: int = 0;
        while (x < rowRaw) {
            bytesSet(out, dst + x, bytesGet(rgb, src + x + 2) catch 0);
            bytesSet(out, dst + x + 1, bytesGet(rgb, src + x + 1) catch 0);
            bytesSet(out, dst + x + 2, bytesGet(rgb, src + x) catch 0);
            x = x + 3;
        }
        y = y + 1;
    }
    return out;
}
