// 测试专用：单独导出页堆（kernel_alloc_check.tx 的三个分配器例程与账本、.bss 状态），供 macOS 上的页堆 C 驱动链接。
// Windows、Linux 的驱动链接整个检测内核（objcopy 弱化其 __tx_trap）；macOS 没有 GNU objcopy，内核又是交给太虚链接器的
// ELF 对象，驱动改链这个 Mach-O 目标文件，__tx_trap 与 __tx_mac_* 由驱动自己定义。
import { allocCheckEmit, allocCheckBss } from "./selfhost/kernel_alloc_check";
import { asBufferSection } from "./selfhost/assemble";
import { probeBuffer, probeWrite } from "./native_probe_object";
import { targetParseAnalysis } from "./selfhost/target";
// 用法：--target <目标> <输出>。
function main(args: []string): int {
    if (len(args) != 3 || args[0] != "--target") { return 64; }
    const t = targetParseAnalysis(args[1]);
    if (t < 0) { return 64; }
    const buf = probeBuffer(t);
    const failures: List<string> = listNew();
    allocCheckEmit(buf, failures, t);
    if (listLen(failures) > 0) { eprint(listGet(failures, 0) catch ""); return 66; }
    asBufferSection(buf, 3, 1);
    allocCheckBss(buf);
    asBufferSection(buf, 0, 1);
    const exports: List<string> = listNew();
    listPush(exports, "__tx_native_mem_alloc"); listPush(exports, "__tx_native_mem_free"); listPush(exports, "__tx_native_mem_realloc");
    return probeWrite(buf, t, args[2], exports);
}
