// ============================================================================
// stdlib 用例：std/time（V0.9-S1；D27 §一）——纯函数段全断言（墙钟观测面
// timeNowMs 不断言——确定性纪律 D27 §一）。
// 运行：taixu test tests/time.tx
// ============================================================================

import { formatMs } from "std/time";

test "time：formatMs 毫秒/秒/分段的纯函数呈现" {
    assert(formatMs(0) == "<1ms", "0 → <1ms");
    assert(formatMs(-5) == "<1ms", "负时长→<1ms");
    assert(formatMs(1) == "1ms", "1ms");
    assert(formatMs(999) == "999ms", "毫秒段上界");
    assert(formatMs(1000) == "1s", "整秒收敛（1.0s→1s）");
    assert(formatMs(1500) == "1.5s", "十分位秒");
    assert(formatMs(59000) == "59s", "秒段上界");
    assert(formatMs(61000) == "1m 1s", "分段整秒");
    assert(formatMs(61500) == "1m 1.5s", "分段十分位");
}
