function add(a: int, b: int): int { return a + b; }
function div(a: int, b: int): int | Error {
    if (b == 0) { return err("division by zero"); }
    return a / b;
}
test "add 基本行为" {
    assert(add(2, 3) == 5, "2 + 3 应为 5");
}
test "div 错误通道" {
    assert((div(1, 0) catch -1) == -1, "除零应产生故障");
}
test "故意失败" {
    assert(add(1, 1) == 3, "1 + 1 应为 3（本用例故意失败）");
}
export function main(args: []string): int { return 0; }
