// libSystem 蹦床的 A64 探针（macOS 适配 M4c，设计 A5）：把 unix_sys.tx 的 A64 蹦床（macSysEmit）与一个 rtfn 写的主函数
// 链接成 Mach-O arm64。在 Apple Silicon 上于空目录里运行：经蹦床建文件、查权限位、设取描述符标志、读写、删除，核对变参
// （open／openat 的 mode、fcntl 的第三个实参在栈上）、−errno 的换算（含清 errno 的指针形）、read 的字节数封顶与取线程号；全部相符打印
// “a64 sys ok” 并 exit(0)，第 k 项不符即 exit(k)。装载时还核对表里每个函数都能在 libSystem 里绑定。
// 用法：a64_sys_probe <输出目录>。
import { RtFn, RtOp, L, I, A } from "./selfhost/rtfn_base";
import { rtBegin, rtFailed, rtEnd, rtSet, rtOp, rtIf, rtLabel, rtLoad, rtCallList, rtCall1, rtCall2, rtCall3, rtRet } from "./selfhost/rtfn";
import { StructuredBuffer, asBufferNewA64, asBufferSection, asBufferLabel, asBufferByte, asBufferZero, asStructuredBegin, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { a64BufferSubmit } from "./selfhost/a64_asm";
import { elfWriteObject, elfObjectOk, elfObjectBytes, elfObjectError } from "./selfhost/emit_elf_object";
import { linkMachO, machoBytes, machoError, machoImportReset, machoIdentifierFor } from "./selfhost/link_macho";
import { nrtBaseReset, nrtLastError } from "./selfhost/nrt_base";
import { macSysEmit } from "./selfhost/unix_sys";
import { T_ARM64_MACOS } from "./selfhost/target";

const MODULE: string = "bootstrap/a64_sys_probe.tx";
// macOS 的数值：O_WRONLY 1、O_CREAT 0x200、O_TRUNC 0x400、O_EXCL 0x800；AT_FDCWD −2；F_GETFD 1、F_SETFD 2；ENOENT 2。
const O_CREATE_WRITE: int = 1537;
const O_CREATE_EXCL: int = 2560;
let failures: List<string> = listNew();

function done(f: Ref<RtFn>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

// check(k)：x 与 want 不等时经蹦床 exit(k)（也核对不返回的蹦床）。
function check(f: Ref<RtFn>, k: int, x: Ref<RtOp>, want: Ref<RtOp>): void {
    const ok = "ok" + toStr(k);
    rtIf(f, x, "eq", want, ok);
    rtCall1(f, "", "__tx_mac_exit", I(k));
    rtLabel(f, ok);
}

function call4(f: Ref<RtFn>, result: string, target: string, a: Ref<RtOp>, c: Ref<RtOp>, d: Ref<RtOp>, e: Ref<RtOp>): void {
    const xs: List<Ref<RtOp>> = listNew(); listPush(xs, a); listPush(xs, c); listPush(xs, d); listPush(xs, e);
    rtCallList(f, result, target, xs);
}

function cstr(b: Ref<StructuredBuffer>, label: string, text: string): void {
    asBufferSection(b, 1, 1);
    asBufferLabel(b, label, 1);
    let k = 0;
    while (k < len(text)) { asBufferByte(b, byteAt(text, k) catch 0, 1); k = k + 1; }
    asBufferByte(b, 0, 1);
    asBufferSection(b, 0, 1);
}

function mainFn(b: Ref<StructuredBuffer>): void {
    const f = rtBegin(b, "a64_main", "argc argv", "fd x m", 4, MODULE);
    // 1..4 open 的 mode（变参）：新建 0600，fstat 的 st_mode（偏移 4，2 字节）低 9 位须为 0600。
    rtCall3(f, "fd", "__tx_mac_open", A("p_file1"), I(O_CREATE_WRITE), I(384));
    rtIf(f, L("fd"), "ge", I(0), "opened");
    check(f, 1, I(0), I(1));
    rtLabel(f, "opened");
    rtCall2(f, "x", "__tx_mac_fstat", L("fd"), A("p_stat")); check(f, 2, L("x"), I(0));
    rtLoad(f, "m", A("p_stat"), 4, 2);
    rtOp(f, "m", L("m"), "and", I(511)); check(f, 3, L("m"), I(384));
    rtCall3(f, "x", "__tx_mac_write", L("fd"), A("p_file1"), I(3)); check(f, 4, L("x"), I(3));
    // 5..8 fcntl 的第三个实参（变参）：置上 FD_CLOEXEC 再读回 1，清掉再读回 0。
    rtCall3(f, "x", "__tx_mac_fcntl", L("fd"), I(2), I(1)); check(f, 5, L("x"), I(0));
    rtCall3(f, "x", "__tx_mac_fcntl", L("fd"), I(1), I(0)); check(f, 6, L("x"), I(1));
    rtCall3(f, "x", "__tx_mac_fcntl", L("fd"), I(2), I(0)); check(f, 7, L("x"), I(0));
    rtCall3(f, "x", "__tx_mac_fcntl", L("fd"), I(1), I(0)); check(f, 8, L("x"), I(0));
    rtCall1(f, "x", "__tx_mac_close", L("fd")); check(f, 9, L("x"), I(0));
    // 10..12 openat 的 mode（第四个实参，变参）：O_CREAT|O_EXCL|O_RDONLY，mode 0400。
    call4(f, "fd", "__tx_mac_openat", I(-2), A("p_file2"), I(O_CREATE_EXCL), I(256));
    rtIf(f, L("fd"), "ge", I(0), "opened2");
    check(f, 10, I(0), I(1));
    rtLabel(f, "opened2");
    rtCall2(f, "x", "__tx_mac_fstat", L("fd"), A("p_stat")); check(f, 11, L("x"), I(0));
    rtLoad(f, "m", A("p_stat"), 4, 2);
    rtOp(f, "m", L("m"), "and", I(511)); check(f, 12, L("m"), I(256));
    rtCall1(f, "x", "__tx_mac_close", L("fd")); check(f, 13, L("x"), I(0));
    // 14..16 −errno：再次 O_EXCL 建同名文件为 −EEXIST；打开不存在的路径为 −ENOENT（int 形与指针形）。
    call4(f, "x", "__tx_mac_openat", I(-2), A("p_file2"), I(O_CREATE_EXCL), I(256)); check(f, 14, L("x"), I(-17));
    rtCall3(f, "x", "__tx_mac_open", A("p_missing"), I(0), I(0)); check(f, 15, L("x"), I(-2));
    rtCall1(f, "x", "__tx_mac_opendir", A("p_missing")); check(f, 16, L("x"), I(-2));
    // 17 取线程号：非零。
    rtCall1(f, "x", "__tx_mac_gettid", I(0));
    rtIf(f, L("x"), "ne", I(0), "tid");
    check(f, 17, I(0), I(1));
    rtLabel(f, "tid");
    // 20..22 字节数超过 INT_MAX 的 read：蹦床封顶为 1 GiB，读回文件的 3 字节（不封顶时 macOS 返回 −EINVAL）。
    rtCall3(f, "fd", "__tx_mac_open", A("p_file1"), I(0), I(0));
    rtIf(f, L("fd"), "ge", I(0), "opened3");
    check(f, 20, I(0), I(1));
    rtLabel(f, "opened3");
    rtCall3(f, "x", "__tx_mac_read", L("fd"), A("p_stat"), I(3221225472)); check(f, 21, L("x"), I(3));
    rtCall1(f, "x", "__tx_mac_close", L("fd")); check(f, 22, L("x"), I(0));
    // 18..19 删除两个文件。
    rtCall3(f, "x", "__tx_mac_unlinkat", I(-2), A("p_file1"), I(0)); check(f, 18, L("x"), I(0));
    rtCall3(f, "x", "__tx_mac_unlinkat", I(-2), A("p_file2"), I(0)); check(f, 19, L("x"), I(0));
    rtCall3(f, "x", "__tx_mac_write", I(1), A("p_msg"), I(11));
    rtRet(f, I(0));
    done(f);
}

function main(args: []string): int {
    if (len(args) < 1) { eprint("usage: a64_sys_probe <outdir>"); return 64; }
    nrtBaseReset(T_ARM64_MACOS);
    const b = asBufferNewA64();
    asBufferSection(b, 0, 1);
    macSysEmit(b);
    if (len(nrtLastError()) > 0) { eprint("unix_sys: " + nrtLastError()); return 69; }
    mainFn(b);
    if (listLen(failures) > 0) { eprint("rtfn: " + (listGet(failures, 0) catch "")); return 69; }
    cstr(b, "p_file1", "a64-sys-1.tmp");
    cstr(b, "p_file2", "a64-sys-2.tmp");
    cstr(b, "p_missing", "a64-sys-missing/x");
    cstr(b, "p_msg", "a64 sys ok\n");
    asBufferSection(b, 3, 1);
    asBufferLabel(b, "p_stat", 1);
    asBufferZero(b, 144, 1);
    asBufferSection(b, 0, 1);
    asStructuredBegin();
    a64BufferSubmit(b);
    if (asFailedAs() != 0) { eprint("asm: " + asLastErrAs()); return 65; }
    const exports: List<string> = listNew(); listPush(exports, "a64_main");
    const r = elfWriteObject(exports);
    if (elfObjectOk(r) != 1) { eprint("elf: " + elfObjectError(r)); return 66; }
    const objects: List<Bytes> = listNew(); listPush(objects, elfObjectBytes(r));
    const path = args[0] + "/sys_ok";
    machoImportReset();
    machoIdentifierFor(path);
    if (linkMachO(objects, "a64_main") != 0) { eprint("link: " + machoError()); return 67; }
    writeFileBytes(path, machoBytes()) catch (e) { eprint(e.message); return 68; };
    print("PASS_A64_SYS");
    return 0;
}
