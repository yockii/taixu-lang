// D3 v0.21：async 函数内可以用 defer，但 defer 体内不能 await——任务挂起中被取消时
// defer 在取消清理里执行，不能再挂起。
async function work(f: Future< int>): int {
    defer {
        const v = await f catch 0;
        print(toStr(v));
    }
    return 1;
}

async function one(): int {
    return 1;
}

export function main(args: []string): int {
    const g = work(one());
    return 0;
}
