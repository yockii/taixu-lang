// ============================================================================
// std/text —— 文本工具（V0.23-S1 扩批；STD-04）。
//
// 与 std/string 的分工：string.tx＝查找/切分/大小写（字符面）；text.tx＝
// 版面与统计（填充/截断/缩进/行列计数——展示层预处理面）。字节序语义与
// string.tx 同（ASCII 判定；多字节文本按字节处理——中文内容 padding 后
// 宽度按字节计，展示层自行折算）。全部确定性。
// ============================================================================

import { split } from "./string";

// repeat：s 重复 n 次（n <= 0 → 空串）。
export function repeat(s: string, n: int): string {
    let out: string = "";
    let i: int = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

// startsWith／endsWith：前后缀判定（字节序列；len 语义与 string.tx 一致）。
export function startsWith(s: string, prefix: string): bool {
    const m = len(prefix);
    if (m > len(s)) {
        return false;
    }
    return strSub(s, 0, m) == prefix;
}

export function endsWith(s: string, suffix: string): bool {
    const m = len(suffix);
    const n = len(s);
    if (m > n) {
        return false;
    }
    return strSub(s, n - m, m) == suffix;
}

// padStart／padEnd：填充到目标宽度（s 本身更宽则原样；pad 空串时返回原串）。
export function padStart(s: string, width: int, pad: string): string {
    const n = len(s);
    if (n >= width || len(pad) == 0) {
        return s;
    }
    let fill: string = "";
    while (len(fill) < width - n) {
        fill = fill + pad;
    }
    return strSub(fill, 0, width - n) + s;
}

export function padEnd(s: string, width: int, pad: string): string {
    const n = len(s);
    if (n >= width || len(pad) == 0) {
        return s;
    }
    let fill: string = "";
    while (len(fill) < width - n) {
        fill = fill + pad;
    }
    return s + strSub(fill, 0, width - n);
}

// truncate：超宽截断并追加省略号（suffix 计入宽度内；不超宽原样）。
export function truncate(s: string, max: int, suffix: string): string {
    const m = len(suffix);
    if (len(s) <= max) {
        return s;
    }
    if (max <= m) {
        return strSub(suffix, 0, max);
    }
    return strSub(s, 0, max - m) + suffix;
}

// indent：逐行加前缀（按 '\n' 分行后重接——空行也缩进）。
export function indent(s: string, prefix: string): string {
    const lines = split(s, "\n");
    let out: string = "";
    let i: int = 0;
    while (i < listLen(lines)) {
        if (i > 0) {
            out = out + "\n";
        }
        out = out + prefix + (listGet(lines, i) catch "");
        i = i + 1;
    }
    return out;
}

// lineCount：行数（'\n' 计数＋1；空串为 1——空内容也算一行）。
export function lineCount(s: string): int {
    let n: int = 1;
    let i: int = 0;
    while (i < len(s)) {
        if ((byteAt(s, i) catch 0) == '\n') {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// wordCount：词数（ASCII 空白分隔——空格/\t/\r/\n；连续空白计一段）。
export function wordCount(s: string): int {
    let count: int = 0;
    let inWord: bool = false;
    let i: int = 0;
    while (i < len(s)) {
        const ch = byteAt(s, i) catch 32;
        const isWs = ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n';
        if (isWs) {
            inWord = false;
        } else {
            if (!inWord) {
                count = count + 1;
            }
            inWord = true;
        }
        i = i + 1;
    }
    return count;
}
