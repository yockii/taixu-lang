import { reaperStart, reaperSelfPid, reaperSweep, reaperError } from "../../bootstrap/selfhost/mcp_reaper";
function main(args: []string): int {
    if (len(args) > 1) { print(toStr(reaperSelfPid())); return 41; }
    if (len(args) != 1) { return 64; }
    assert(reaperStart(), "parent reaping verified");
    const a: List< string> = listNew(); listPush(a, args[0]); listPush(a, "child");
    const h = procSpawn(args[0], a, "", 0) catch (e) { print(e.message); return 1; };
    const data = bytesNew(64); let pid = 0; let complete = false; const until = monoNs() + 2000000000;
    while (!complete && monoNs() < until) {
        const n = procRead(h, 1, data); let i = 0;
        while (i < n) {
            const c = bytesGet(data, i) catch 0; i = i + 1;
            if (c == 10) { complete = true; }
            else { assert(c >= 48 && c <= 57, "pid digits"); pid = pid * 10 + c - 48; }
        }
    }
    assert(complete && pid > 0, "actual child PID");
    if (hostTarget() == "linux") {
        let exited = false; const deadline = monoNs() + 2000000000;
        while (!exited && monoNs() < deadline) {
            const state = readFile("/proc/" + toStr(pid) + "/stat") catch "";
            exited = strIndexOf(state, ") Z ") >= 0;
        }
        assert(exited, "observe waitable exit without consuming it");
        const owners: List< int> = listNew(); listPush(owners, pid);
        assert(reaperSweep(owners) && len(reaperError()) == 0, "managed exit must stay available to procWait");
    }
    assert((procWait(h, 2000) catch -999) == 41, "exact child status retained");
    procClose(h);
    assert(!reaperSweep(listNew()) && len(reaperError()) == 0, "no child remains");
    print("PASS_REAPER_PROTECTED_STATUS_AND_DRAIN"); return 0;
}
