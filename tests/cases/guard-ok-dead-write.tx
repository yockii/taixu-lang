// D3 v0.51 §6.4-5：对 struct 拷贝的字段写入之后再被读取、写回、返回、被闭包捕获、defer 读取，或经句柄
// 改的是共享对象，都不报 3036；循环里的写入被下一轮读到也不报。
struct In { v: int }
struct T { id: int, score: int, inner: In, arr: [2]int, r: Ref<In> }

function writeBack(xs: List<T>): void {
    let t = listGet(xs, 0);
    t.score = 100;
    listSet(xs, 0, t);
}

function loopRead(xs: List<T>): int {
    let t = listGet(xs, 0);
    let i = 0;
    let seen = 0;
    while (i < 3) {
        if (i > 0) { seen += t.score; }
        t.score = i;
        i += 1;
    }
    return seen;
}

function captured(xs: List<T>): () => int {
    let t = listGet(xs, 0);
    t.score = 3;
    return (): int => t.score;
}

function deferred(xs: List<T>): void {
    let t = listGet(xs, 0);
    defer { print("defer " + toStr(t.score)); }
    t.score = 1;
}

function viaRef(xs: List<T>): void {
    let t = listGet(xs, 0);
    t.r.v = 7;
}

function returned(xs: List<T>): T {
    let t = listGet(xs, 0);
    for (k in range(3)) {
        t.score += k;
        t.inner.v = k;
        t.arr[1] = k;
    }
    return t;
}

export function main(args: []string): int {
    const xs: List<T> = listNew();
    listPush(xs, T { id: 1, score: 0, inner: In { v: 0 }, arr: [0, 0], r: new In { v: 0 } });
    writeBack(xs);
    const f = captured(xs);
    deferred(xs);
    viaRef(xs);
    const t = returned(xs);
    print(toStr(listGet(xs, 0).score) + " " + toStr(loopRead(xs)) + " " + toStr(f()) + " " + toStr(listGet(xs, 0).r.v) + " " + toStr(t.score) + toStr(t.inner.v) + toStr(t.arr[1]));
    return 0;
}
