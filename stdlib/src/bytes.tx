// ============================================================================
// std/bytes —— 字节缓冲与字符串构建（Go bytes/strings.
// Builder 心智）。
//
// Builder：累积拼接分段持有＋一次性 join（string + 链的 O(n²) 反模式根治）。
// hex 编解码（Go encoding/hex 对位）：**文本十六进制域（ASCII）**——语言面
// string 恒良构 UTF-8（D3 §一），任意字节序列无字面构造通道；hexDecode 解出的
// 字节须是良构 UTF-8，否则结构化 Error（任意二进制用 Bytes——如实登记）。
// hexEncode 为字节面（UTF-8 编码字节逐位十六进制），两者对任意串往返。
// ============================================================================

struct Builder {
    parts: List<string>,
}

// newBuilder：构造。
export function newBuilder(): Ref<Builder> {
    return new Builder { parts: listNew() };
}

// writeString：追加串。
export function writeString(b: Ref<Builder>, s: string): void {
    listPush(b.parts, s);
}

// writeInt：追加整数（toStr 面）。
export function writeInt(b: Ref<Builder>, v: int): void {
    listPush(b.parts, toStr(v));
}

// writeByte：追加单字节（0..127 原样；128..255 经码点编码即 UTF-8 序列——
// 与 writeString 同语义，如实注记）。
export function writeByte(b: Ref<Builder>, v: int): void {
    if (v < 0 || v > 255) {
        return;
    }
    listPush(b.parts, utf8Encode(v) catch "");
}

// writeLn：追加串＋换行（log 心智）。
export function writeLn(b: Ref<Builder>, s: string): void {
    listPush(b.parts, s + "\n");
}

// builderLen：累计字节长度（O(parts) 求和——无缓存字段面，如实注记）。
export function builderLen(b: Ref<Builder>): int {
    let n: int = 0;
    let i: int = 0;
    while (i < listLen(b.parts)) {
        n = n + len(listTryGet(b.parts, i) catch "");
        i = i + 1;
    }
    return n;
}

// build：一次性 join。
export function build(b: Ref<Builder>): string {
    let out: string = "";
    let i: int = 0;
    while (i < listLen(b.parts)) {
        out = out + (listTryGet(b.parts, i) catch "");
        i = i + 1;
    }
    return out;
}

// reset：清空（复用面）。
export function reset(b: Ref<Builder>): void {
    b.parts = listNew();
}

// —— hex（文本十六进制域；小写；decode 非法输入 Error）——

const HEX: string = "0123456789abcdef";

// hexEncode：字节面 → 小写十六进制（UTF-8 编码字节逐位——ASCII 输入恒
// 2× 长度）。
export function hexEncode(s: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < len(s)) {
        const b = byteTryAt(s, i) catch 0;
        out = out + (utf8Encode(byteTryAt(HEX, b / 16) catch 48) catch "");
        out = out + (utf8Encode(byteTryAt(HEX, b % 16) catch 48) catch "");
        i = i + 1;
    }
    return out;
}

// hexDecode：偶长十六进制 → 串；奇长/非法字符 Error，解出的字节不是良构 UTF-8 也 Error（UTF-8 良构红线——见头注）。
// 与 hexEncode 对任意串往返（2026-10-27：此前逐字节拒 ≥0x80，hexDecode(hexEncode("你好")) 得 Error）。
export function hexDecode(s: string): string | Error {
    const n = len(s);
    if (n % 2 != 0) {
        return err("odd length");
    }
    const out = bytesNew(n / 2);
    let i: int = 0;
    while (i < n) {
        const hi = hexVal(byteTryAt(s, i) catch -1);
        const lo = hexVal(byteTryAt(s, i + 1) catch -1);
        if (hi < 0 || lo < 0) {
            return err("bad hex");
        }
        bytesSet(out, i / 2, hi * 16 + lo);
        i = i + 2;
    }
    const text = bytesToStr(out) catch (e) {
        return err("decoded bytes are not UTF-8（UTF-8 良构红线）");
    };
    return text;
}

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    if (b >= 65 && b <= 70) {
        return b - 55;
    }
    return -1;
}
