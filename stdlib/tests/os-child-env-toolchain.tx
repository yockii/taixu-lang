// ============================================================================
// stdlib 用例：子进程继承当前环境（核心 D3 v0.39）——std/os 的 setenv 之后起的子进程（runProcess、procSpawn）看到改后的值。
// runProcess、procSpawn 与 hostTarget 只在工具链构建里可用，verify 对 -toolchain.tx 结尾的用例加 --toolchain。
// 运行：taixu test --toolchain tests/os-child-env-toolchain.tx（原生编译器）
// ============================================================================

import { getenv, setenv } from "std/os";

// 检查 TX_CHILD_ENV 是否等于 want 的 shell 与实参：等于时退出码 0，否则 3（Windows 经 %ComSpec%，类 Unix 经 /bin/sh）。
function shellPath(): string {
    if (hostTarget() == "windows") { return getenv("ComSpec"); }
    return "/bin/sh";
}

function checkArgs(want: string): List<string> {
    const args: List<string> = listNew();
    if (hostTarget() == "windows") {
        listPush(args, "/d");
        listPush(args, "/c");
        listPush(args, "if \"%TX_CHILD_ENV%\"==\"" + want + "\" (exit 0) else (exit 3)");
    } else {
        listPush(args, "-c");
        listPush(args, "test \"$TX_CHILD_ENV\" = " + want + " || exit 3");
    }
    return args;
}

// runProcess 起子进程。
function childSees(want: string): int {
    return runProcess(shellPath(), checkArgs(want), "") catch -1;
}

// procSpawn 起子进程（工具链的另一条起进程路径），等它退出。
function spawnedSees(want: string): int {
    const h = procSpawn(shellPath(), checkArgs(want), "", 0) catch -1;
    if (h < 0) { return -1; }
    const code = procWait(h, -1) catch -2;
    procClose(h);
    return code;
}

test "os：setenv 之后起的子进程看到当前环境" {
    setenv("TX_CHILD_ENV", "first") catch panic("setenv 失败");
    assert(childSees("first") == 0, "子进程看到 setenv 设的值");
    setenv("TX_CHILD_ENV", "second") catch panic("改写失败");
    assert(childSees("second") == 0, "子进程看到改写后的值");
    assert(childSees("first") == 3, "子进程看不到旧值");
    assert(spawnedSees("second") == 0, "procSpawn 的子进程看到当前值");
    setenv("TX_CHILD_ENV", "third") catch panic("再改写失败");
    assert(spawnedSees("third") == 0, "procSpawn 的子进程看到改写后的值");
    assert(spawnedSees("second") == 3, "procSpawn 的子进程看不到旧值");
}
