export function main(args: []string): int {
    const xs: [3]int = [1, 2, 3];
    const ys: []int = [10, 20, 30, 40];
    let total: int = 0;
    for (let i = 0; i < len(xs); i = i + 1) { total = total + xs[i]; }
    const shared: []int = ys;
    shared[1] = 99;
    print("total=" + toStr(total) + ",ys[1]=" + toStr(ys[1]));
    const nested: [2] [2]int = [[1, 2], [3, 4]];
    print("nested=" + toStr(nested[1] [0]));
    return 0;
}
