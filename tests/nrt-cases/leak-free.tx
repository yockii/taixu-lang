// 泄漏检查（TOOL-84 第一步，泄漏检查设计 §四）：以 --leak-check 构建，各种对象图在退出时都应释放干净——
// 用 Weak 指回父节点的树、模块级变量持有的 List 与 Map、闭包、枚举链、字符串拼接、Bytes 与 List<u8> 互转、
// 子线程与 Shared。期望输出照常、没有泄漏报告、退出码 0。
struct Node {
    name: string,
    parent: Weak< Node>?,
    kids: List< Ref< Node>>,
}

enum Chain {
    Nil,
    Cons(v: int, next: Ref< Chain>),
}

let registry: List< Ref< Node>> = listNew();
let names: Map< string, int> = mapNew();

function tree(depth: int, parent: Weak< Node>?): Ref< Node> {
    const n: Ref< Node> = new Node { name: "d" + toStr(depth), parent: parent, kids: listNew() };
    if (depth > 0) {
        listPush(n.kids, tree(depth - 1, weak(n)));
        listPush(n.kids, tree(depth - 1, weak(n)));
    }
    return n;
}

function count(n: Ref< Node>): int {
    let c = 1;
    for (k in n.kids) {
        c = c + count(k);
    }
    return c;
}

function chain(n: int): Ref< Chain> {
    let head: Ref< Chain> = new Chain.Nil();
    let i = 0;
    while (i < n) {
        head = new Chain.Cons(i, head);
        i = i + 1;
    }
    return head;
}

function main(args: []string): int {
    const root = tree(6, None);
    listPush(registry, root);
    print("tree " + toStr(count(root)));
    mapSet(names, "root", count(root));
    const adders: List< (int) => int> = listNew();
    let i = 0;
    while (i < 5) {
        const base = i;
        listPush(adders, (x: int): int => x + base);
        i = i + 1;
    }
    let s = 0;
    for (f in adders) {
        s = s + f(10);
    }
    print("closures " + toStr(s));
    const c = chain(1000);
    let text = "";
    let j = 0;
    while (j < 50) {
        text = text + toStr(j);
        j = j + 1;
    }
    print("text " + toStr(len(text)));
    const b = bytesFromStr("abc");
    const l = bytesAsList(b);
    listPush(l, 100 as u8);
    print("bytes " + (bytesToStr(listAsBytes(l)) catch "?"));
    const sh = sharedNew(bytesFromStr("shared"));
    const t = threadSpawn((): int => bytesLen(sharedGet(sh)) + count(tree(3, None)));
    print("thread " + toStr(threadJoin(t) catch -1));
    print("map " + toStr(mapGet(names, "root") catch -1));
    return 0;
}
