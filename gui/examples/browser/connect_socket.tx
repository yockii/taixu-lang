import { BrowserAddress, dnsCheckpoint, dnsAdd } from "./dns_common";
import { ByteSocket, socketOpen, socketConnectScoped, socketFinishConnect, socketPoll, socketClose } from "std/net_socket";
import { monotonicNs, deadlineRemainingMs } from "std/deadline";

export function browserAddressOrder(addresses: List<BrowserAddress>): List<BrowserAddress> | Error {
    const unique: List<BrowserAddress> = listNew(); for (address in addresses) { dnsAdd(unique, address.ip, address.scope)?; }
    if (listLen(unique) == 0) { return err("browser connect: empty address set"); }
    const first = bytesLen(listGet(unique, 0).ip); const preferred: List<BrowserAddress> = listNew(); const alternate: List<BrowserAddress> = listNew();
    for (address in unique) { if (bytesLen(address.ip) == first) { listPush(preferred, address); } else { listPush(alternate, address); } }
    const out: List<BrowserAddress> = listNew(); let i = 0;
    while (i < listLen(preferred) || i < listLen(alternate)) {
        if (i < listLen(preferred)) { listPush(out, listGet(preferred, i)); } if (i < listLen(alternate)) { listPush(out, listGet(alternate, i)); } i = i + 1;
    } return out;
}

export function browserConnectAddresses(addresses: List<BrowserAddress>, port: int, deadline: int, cancelled: () => bool): Ref<ByteSocket> | Error {
    dnsCheckpoint(deadline, cancelled)?; if (port < 1 || port > 65535) { return err("browser connect: invalid port"); }
    const ordered = browserAddressOrder(addresses)?; const pending: List<Ref<ByteSocket>> = listNew(); let winner: Ref<ByteSocket>? = None;
    defer { const kept = winner; for (socket in pending) { if (kept == None) { socketClose(socket); } else if (socket.handle != kept.handle) { socketClose(socket); } } }
    let next = 0; let launch = monotonicNs()?; let lastError = "browser connect: all addresses failed"; let waitIndex = 0;
    while (true) {
        dnsCheckpoint(deadline, cancelled)?; let live = 0;
        for (socket in pending) {
            if (socket.state == 3) { continue; }
            const connected = socketFinishConnect(socket) catch (e) { lastError = e.message; socketClose(socket); launch = monotonicNs()?; continue; };
            if (connected) { winner = socket; return socket; } live = live + 1;
        }
        const now = monotonicNs()?;
        if (next < listLen(ordered) && (live == 0 || now >= launch)) {
            const address = listGet(ordered, next); next = next + 1; let version = 4; if (bytesLen(address.ip) == 16) { version = 6; }
            const socket = socketOpen(version, false) catch (e) { lastError = e.message; continue; }; listPush(pending, socket);
            const connected = socketConnectScoped(socket, address.ip, port, address.scope) catch (e) { lastError = e.message; socketClose(socket); launch = now; continue; };
            if (connected) { winner = socket; return socket; } launch = now + 250000000; continue;
        }
        if (live == 0 && next == listLen(ordered)) { return err(lastError); }
        let milliseconds = deadlineRemainingMs(deadline)?; if (milliseconds > 25) { milliseconds = 25; }
        if (next < listLen(ordered)) { const until = (launch - now + 999999) / 1000000; if (until < milliseconds && until > 0) { milliseconds = until; } }
        let searched = 0;
        while (searched < listLen(pending)) {
            const socket = listGet(pending, waitIndex % listLen(pending)); waitIndex = waitIndex + 1; searched = searched + 1;
            if (socket.state == 3) { continue; }
            socketPoll(socket, true, milliseconds) catch (e) { lastError = e.message; socketClose(socket); launch = monotonicNs()?; break; }; break;
        }
    } return err("browser connect: unreachable state");
}
