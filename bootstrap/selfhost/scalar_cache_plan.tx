import { ScalarCandidates } from "./scalar_candidates";
import { ScalarBlock, ScalarLoop } from "./scalar_loops";

// Regions come from scalarLoops (ordered headers, nested or disjoint), and
// call PCs from the ordered IR. Count root-interval membership once per call.
export function scalarCacheHotCalls(blocks: List<Ref<ScalarBlock>>, regions: List<Ref<ScalarLoop>>, calls: List<int>): int {
    let ri = 0; let count = 0;
    for (pc in calls) {
        while (ri < listLen(regions)) {
            const region = listGet(regions, ri) catch panic("scalar cache region");
            if (region.parent >= 0) { ri = ri + 1; continue; }
            const first = (listGet(blocks, region.header) catch panic("scalar cache header")).first;
            const last = (listGet(blocks, region.last) catch panic("scalar cache last")).last;
            if (pc > last) { ri = ri + 1; continue; }
            if (pc >= first) { count = count + 1; } break;
        }
    }
    return count;
}

export function scalarCachePlan(candidates: ScalarCandidates, hotCalls: int): List<int> {
    if (hotCalls != 0) { return listNew(); }
    return scalarCacheSlots(candidates);
}

// A slot that holds a float in any region keeps its value slot: in r12/r13 every
// read needs a GP-to-XMM move and every write one back, both on the loop-carried
// path, while CPUs that rename stack memory forward the slot store to the next
// load at almost no cost. Floats in registers belong in XMM; only int and bool
// slots use the GP lanes.
function floatSlot(candidates: ScalarCandidates, slot: int): bool {
    for (value in candidates.values) { if (value.slot == slot && value.tag == 2) { return true; } }
    return false;
}

// Two persistent payload registers. Every remaining slot retains its normal
// location. Nested regions must not double-count the same static reads.
export function scalarCacheSlots(candidates: ScalarCandidates): List<int> {
    const out: List<int> = listNew(); if (candidates.limited) { return out; }
    let best = -1; let score = -1;
    for (value in candidates.values) {
        if (floatSlot(candidates, value.slot)) { continue; }
        if (value.reads > score || (value.reads == score && value.slot < best)) { best = value.slot; score = value.reads; }
    }
    if (best < 0) { return out; } listPush(out, best);
    let second = -1; score = -1;
    for (value in candidates.values) {
        if (floatSlot(candidates, value.slot)) { continue; }
        if (value.slot != best && (value.reads > score || (value.reads == score && value.slot < second))) { second = value.slot; score = value.reads; }
    }
    if (second >= 0) { listPush(out, second); } return out;
}
