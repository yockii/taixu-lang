// 协议资源预检，不替代 JSON 校验，不改变通用 jsonParse 的深栈语义。
// 引号／escape 状态内不计结构；计数是节点分配数的保守上界，输入字节仍由传输层限额。
export function jsonEnvelopeWithin(data: Bytes, maximum: int): bool {
    let tokens = 0; let quoted = false; let escaped = false; let atom = false; let i = 0;
    while (i < bytesLen(data)) {
        const c = bytesGet(data, i) catch 0; i = i + 1;
        if (quoted) {
            if (escaped) { escaped = false; }
            else if (c == 92) { escaped = true; }
            else if (c == 34) { quoted = false; }
            continue;
        }
        if (c == 34) { quoted = true; atom = false; tokens = tokens + 1; }
        else if (c == 123 || c == 91 || c == 125 || c == 93 || c == 58 || c == 44) { tokens = tokens + 1; atom = false; }
        else if (c == 32 || c == 9 || c == 10 || c == 13) { atom = false; }
        else if (!atom) { atom = true; tokens = tokens + 1; }
        if (tokens > maximum) { return false; }
    }
    return true;
}
