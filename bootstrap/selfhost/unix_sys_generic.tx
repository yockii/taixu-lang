// macOS 系统接口里内存生成器用的两件的可移植版（rtfn 写）：语义与导出名同 unix_sys.tx 的 macPageAdapters
// 与 macAbort。libSystem 一律经蹦床 __tx_mac_<名>（uxMac；结果非负成功、负值为 −errno）。Linux 的页适配器同样有可移植版
// （linuxPageAdaptersGenericEmit，：aarch64-linux 只用它；x86_64 上 --generic=linuxsys 选用）。
// - __tx_mac_page_alloc(_, size, _, _) → mmap(0, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANON, −1, 0)，失败（结果落在
//   −4095..−1）为 0；__tx_mac_page_free(p, size) → munmap(p, size) 的结果。调用约定同 Linux 的 __tx_linux_page_alloc／free
//   （VirtualAlloc／VirtualFree 的替身，只用前两个实参）。
// - macAbortGenericEmit：致命终局的生成助手。手写版 macAbort 在调用处就地发出“入口标号＋写 stderr＋_exit”，被 panic、memmove
//   的两个越界出口与 strOom 共用；这里同样按（入口名、数据标号、消息、退出码）发出一个不带参数、不返回的例程，调用方经 call
//   进入（rtfn 里是 rtCall0）。手写版先把栈按 16 字节对齐，以便手写汇编从任意栈状态跳入；rtfn 的例程不自己对齐——x86 上蹦床
//   会再对齐（unix_sys.tx 的 enter），A64 的 sp 始终 16 字节对齐，所以从手写汇编跳入同样安全。
import { StructuredBuffer, asBufferSection } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtEnd, rtFailed, rtLabel, rtIf, rtSet, rtRet, rtRetVoid, rtRdataBytes } from "./rtfn";
import { uxMac, uxSys } from "./unix_sys";

const MODULE: string = "bootstrap/selfhost/unix_sys_generic.tx";
// macOS 的 PROT_READ|PROT_WRITE、MAP_PRIVATE|MAP_ANON（0x1002）。
const PROT_RW: int = 3;
const MAP_PRIVATE_ANON: int = 4098;

function done(f: Ref<RtFn>, failures: List<string>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

/// 发出 macOS 的页适配器；rtfn 的失败记进 failures。t 为目标编号（只有 macOS 用）。
export function macPageAdaptersGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, t: int): void {
    asBufferSection(b, 0, 1);
    let f = rtBegin(b, "__tx_mac_page_alloc", "a size c d", "r", 6, MODULE);
    const margs: List<Ref<RtOp>> = listNew();
    listPush(margs, I(0)); listPush(margs, L("size")); listPush(margs, I(PROT_RW)); listPush(margs, I(MAP_PRIVATE_ANON)); listPush(margs, I(-1)); listPush(margs, I(0));
    uxMac(f, "r", "mmap", margs);
    rtIf(f, L("r"), "ult", I(-4095), "ok");
    rtRet(f, I(0));
    rtLabel(f, "ok");
    rtRet(f, L("r"));
    done(f, failures);
    f = rtBegin(b, "__tx_mac_page_free", "p size", "r", 2, MODULE);
    const uargs: List<Ref<RtOp>> = listNew(); listPush(uargs, L("p")); listPush(uargs, L("size"));
    uxMac(f, "r", "munmap", uargs);
    rtRet(f, L("r"));
    done(f, failures);
}

// Linux 的 PROT_READ|PROT_WRITE 同上；MAP_PRIVATE|MAP_ANONYMOUS（0x22）、MAP_POPULATE（0x8000），x86_64 与通用号表的架构相同。
const LINUX_MAP_PRIVATE_ANON: int = 34;
const LINUX_MAP_POPULATE: int = 32768;
// 不超过它的映射加 MAP_POPULATE（小块页与中块切分时随即全部触及，一次系统调用建好页表，省去逐页缺页；内容仍全零）。
const POPULATE_MAX: int = 262144;

/// 发出 Linux 的页适配器（语义同 runtime_linux.tx 的 linuxPageAdapters）：__tx_linux_page_alloc(_, size, _, _) →
/// mmap(0, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS[|MAP_POPULATE], −1, 0)，失败为 0；
/// __tx_linux_page_free(p, size) → munmap(p, size) 的结果。系统调用号按 x86_64 写，rtfn 按目标翻译。
export function linuxPageAdaptersGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, t: int): void {
    asBufferSection(b, 0, 1);
    let f = rtBegin(b, "__tx_linux_page_alloc", "a size c d", "fl r", 6, MODULE);
    rtSet(f, "fl", I(LINUX_MAP_PRIVATE_ANON));
    rtIf(f, L("size"), "ugt", I(POPULATE_MAX), "lazy");
    rtSet(f, "fl", I(LINUX_MAP_PRIVATE_ANON | LINUX_MAP_POPULATE));
    rtLabel(f, "lazy");
    const margs: List<Ref<RtOp>> = listNew();
    listPush(margs, I(0)); listPush(margs, L("size")); listPush(margs, I(PROT_RW)); listPush(margs, L("fl")); listPush(margs, I(-1)); listPush(margs, I(0));
    uxSys(f, t, "r", 9, margs);
    rtIf(f, L("r"), "ult", I(-4095), "ok");
    rtRet(f, I(0));
    rtLabel(f, "ok");
    rtRet(f, L("r"));
    done(f, failures);
    f = rtBegin(b, "__tx_linux_page_free", "p size", "r", 2, MODULE);
    const uargs: List<Ref<RtOp>> = listNew(); listPush(uargs, L("p")); listPush(uargs, L("size"));
    uxSys(f, t, "r", 11, uargs);
    rtRet(f, L("r"));
    done(f, failures);
}

/// 发出致命终局 entry()：stderr 写 message 与换行（写的结果不看）后 _exit(status)，不返回；消息字节放在只读数据的 data 标号下。
export function macAbortGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, entry: string, data: string, message: string, status: int): void {
    asBufferSection(b, 0, 1);
    const f = rtBegin(b, entry, "", "", 3, MODULE);
    const wargs: List<Ref<RtOp>> = listNew(); listPush(wargs, I(2)); listPush(wargs, A(data)); listPush(wargs, I(len(message) + 1));
    uxMac(f, "", "write", wargs);
    const xargs: List<Ref<RtOp>> = listNew(); listPush(xargs, I(status));
    uxMac(f, "", "_exit", xargs);
    rtRetVoid(f);
    done(f, failures);
    rtRdataBytes(b, data, message + "\n");
}
