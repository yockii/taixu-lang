// 异步 trap（死锁）：调度泵无进展轮且存在未决任务（A 等 F_B、B 等 F_A 的等待环）
// → sched_deadlock，退出码 3。
let lst: List<Future<int>> = listNew();

function main(args: []string): int {
    const fa = alpha();
    const fb = beta(fa);
    listPush(lst, fb);
    print("spawned");
    const faDone = await fa;
    const fbDone = await fb;
    return 0;
}

async function alpha(): int {
    const f = (listTryGet(lst, 0) catch err("none"))?;
    const v = await f;
    return v;
}

async function beta(fa: Future<int>): int {
    const l: List<Future<int>> = listNew();
    listPush(l, fa);
    const i = taskAwaitAny(l) catch -1;
    return i;
}
