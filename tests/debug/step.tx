// 调试基准（第 6 轮 6c-0）：单步进入、越过、跳出。
function inner(x: int): int {
    const t = x + 1;
    return t * 2;
}

function outer(x: int): int {
    const u = inner(x);
    const w = inner(u);
    return w;
}

export function main(args: []string): int {
    const a = outer(1);
    const b = outer(a);
    print(toStr(a + b));
    return 0;
}
