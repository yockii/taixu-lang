// 定宽数值运算族（O4 第二步，docs/design/v052-fixed-width-step2-v0.1-20261016.md §八）。
// 字节码操作码 FW_OP_BASE + 种类×16 + 运算，三地址 R[A] = op(R[B], R[C])（一元运算 C＝B）。
// 种类同 SEB1 定宽种类码：1 i8、2 i16、3 i32、4 u8、5 u16、6 u32、7 u64、8 isize、9 usize、10 f32，
// 11 int（只用于 wrapAdd/wrapSub）。运算：0 加、1 减、2 乘、3 除、4 取余、5 取负、6 按位取反、
// 7 <<、8 >>（有符号算术、无符号逻辑）、9 >>>（类型宽度内的逻辑右移）、10 环绕加、11 环绕减、12 环绕乘。
// 只有用了定宽运算的程序才会产生；冻结的 Zig 加载器不认，遇到即拒绝。

export const FW_OP_BASE: int = 256;
export const FW_OP_LAST: int = 256 + 11 * 16 + 12;

export const FW_ADD: int = 0;
export const FW_SUB: int = 1;
export const FW_MUL: int = 2;
export const FW_DIV: int = 3;
export const FW_MOD: int = 4;
export const FW_NEG: int = 5;
export const FW_BNOT: int = 6;
export const FW_SHL: int = 7;
export const FW_SHR: int = 8;
export const FW_USHR: int = 9;
export const FW_WADD: int = 10;
export const FW_WSUB: int = 11;
export const FW_WMUL: int = 12;

export function fwOpCode(t: int, o: int): int { return FW_OP_BASE + t * 16 + o; }
export function fwOpType(op: int): int { return (op - FW_OP_BASE) / 16; }
export function fwOpOp(op: int): int { return (op - FW_OP_BASE) % 16; }

export function fwKindSigned(t: int): bool { return t == 1 || t == 2 || t == 3 || t == 8 || t == 11; }

// 宽度（位）：isize/usize 随目标指针宽度，现有目标均为 64 位。
export function fwKindBits(t: int): int {
    if (t == 1 || t == 4) { return 8; }
    if (t == 2 || t == 5) { return 16; }
    if (t == 3 || t == 6 || t == 10) { return 32; }
    return 64;
}

// 合法组合（装载校验与发射共用）：整数种类全部运算，取负只限有符号；f32 只有加减乘除；int 只有环绕加减。
export function isFwOp(op: int): bool {
    if (op < FW_OP_BASE + 16 || op > FW_OP_LAST) { return false; }
    const t = fwOpType(op);
    const o = fwOpOp(op);
    if (o > FW_WMUL) { return false; }
    if (t == 10) { return o <= FW_DIV; }
    if (t == 11) { return o == FW_WADD || o == FW_WSUB; }
    if (o == FW_NEG) { return fwKindSigned(t); }
    return true;
}

export function fwKindName(t: int): string {
    if (t == 1) { return "i8"; }
    if (t == 2) { return "i16"; }
    if (t == 3) { return "i32"; }
    if (t == 4) { return "u8"; }
    if (t == 5) { return "u16"; }
    if (t == 6) { return "u32"; }
    if (t == 7) { return "u64"; }
    if (t == 8) { return "isize"; }
    if (t == 9) { return "usize"; }
    if (t == 10) { return "f32"; }
    return "int";
}
