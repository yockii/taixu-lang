// Test-only export of the bounded pipe write (procTryWrite) for the independent try-io driver.
// macOS 另带 SIGPIPE 处置（__tx_tool_nopipe、__tx_tool_cas 与 .bss 状态字 __tx_nrt_nopipe）；libSystem 调用由 C 驱动提供。
import { emitToolTryIo } from "./selfhost/tool_try_io";
import { emitToolWrWindows, emitToolNoPipeProbe } from "./selfhost/tool_rt";
import { toolFailReset, toolLastError } from "./selfhost/tool_base";
import { asBufferSection, asBufferLabel, asBufferZero } from "./selfhost/assemble";
import { probeBuffer, probeWrite } from "./native_probe_object";
import { targetParseAnalysis, tKernel32, tMacos } from "./selfhost/target";
function main(args: []string): int {
    if (len(args) != 3 || args[0] != "--target") { return 64; }
    const t = targetParseAnalysis(args[1]);
    if (t < 0) { return 64; }
    toolFailReset(); const buf = probeBuffer(t); emitToolTryIo(buf, t);
    if (tKernel32(t)) { emitToolWrWindows(buf); }
    if (tMacos(t)) {
        emitToolNoPipeProbe(buf);
        asBufferSection(buf, 3, 1); asBufferLabel(buf, "__tx_nrt_nopipe", 1); asBufferZero(buf, 8, 1); asBufferSection(buf, 0, 1);
    }
    if (len(toolLastError()) > 0) { eprint(toolLastError()); return 65; }
    const exports: List<string> = listNew(); listPush(exports, "__tx_tool_try_wr");
    if (tKernel32(t)) { listPush(exports, "__tx_tool_wr"); }
    return probeWrite(buf, t, args[2], exports);
}
