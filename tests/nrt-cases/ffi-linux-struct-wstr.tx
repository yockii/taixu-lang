// wstr 字段（Linux）：外部结构体的 wstr 字段是 UTF-16（Windows），Linux 目标调用以它为 Ref 参数的库函数报 3033（同 wstr 参数）。
declare struct NAMED { name: wstr, n: i32 }
declare function takeNamed(p: Ref<NAMED>): i32 from "libc.so.6";

function main(args: []string): int {
    const v = new NAMED { name: "abc", n: 1 };
    print(toStr(takeNamed(v)));
    return 0;
}
