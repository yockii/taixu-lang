// 线程第 4c 步（Linux 动态产物）：进程里有 libc 时线程经 pthread_create 创建；共享的 Atomic 计数与 Shared 读在
// pthread 线程里同样成立。
declare function getpid(): i32 from "libc.so.6";

struct Pool {
    count: Atomic< int>,
    names: List< string>,
}

function main(args: []string): void {
    const names: List< string> = listNew();
    listPush(names, "甲");
    listPush(names, "乙");
    const p = sharedNew(new Pool { count: atomicNew(0), names: names });
    const ths: List< Thread< int>> = listNew();
    let i = 0;
    while (i < 6) {
        listPush(ths, threadSpawn((): int => {
                const q = sharedGet(p);
                let k = 0;
                while (k < 5000) {
                    atomicAdd(q.count, 1);
                    k = k + 1;
                }
                return listLen(q.names);
            }));
        i = i + 1;
    }
    let n = 0;
    for (th in ths) {
        n = n + (threadJoin(th) catch 0);
    }
    print("count " + toStr(atomicLoad(sharedGet(p).count)) + " names " + toStr(n) + " pid " + toStr(getpid() > 0));
}
