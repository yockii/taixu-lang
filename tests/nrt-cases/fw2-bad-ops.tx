// O4 第二步：定宽运算的编译期拒绝——无符号取负、没有公共类型、浮点取余与按位取反、移位与环绕的实参类型、
// 字面量按另一侧取型时越界；超过 int 上限的整数字面量只在 u64/usize 期望下可用，其余在原位置报 1004。
export function main(args: []string): int {
    const a: u32 = 5;
    const b = -a;
    const u: u64 = 5;
    const n: int = 5;
    const c = u + n;
    const d = u & wrapTo<i8>(1);
    const f: f32 = 1.5;
    const g = f % f;
    const h = ~f;
    const k = f << 1;
    const s: u8 = 3;
    const m = s + 300;
    const w1 = wrapAdd(1, 2.0);
    const w2 = wrapAdd<float>(1, 2);
    const w3 = wrapMul(u, n);
    const big: int = 18446744073709551615;
    const neg: u64 = -18446744073709551615;
    return 0;
}
