// ============================================================================
// engine/filedialog —— 文件对话框过滤器的规整与各端形态（GUI 原生引擎 G5 第二部分；纯函数，三端共用）。
//
// 文件对话框使用结构化过滤器：
// - 用户面的过滤器是（名称，扩展名表），gui/surface 的 FileFilter 经 fdAdd 规整成 FdFilter 再交给平台层。
// - 扩展名不带点、不带通配，如 "png"；单独的 "*" 表示所有文件。空串、以点开头、含 * ? [ ] / \ ; 、空白或 NUL 的扩展名跳过；
//   扩展名全被跳过的过滤器整个跳过，全都跳过同不过滤；不 trap。匹配不分大小写（Windows、macOS 本来不分）。
// - 名称截到第一个 NUL；截完为空时显示扩展名模式（"*.png;*.jpg"）。
// - Windows 形态：名称与模式交替（平台层拼成“名称\0模式\0…\0”），"*" 记作 "*.*"，多个扩展名以分号相隔；保存对话框的
//   缺省扩展名取第一个带具体扩展名的过滤器里的第一个。
// - macOS 形态：所有扩展名合成一组（NSSavePanel 没有过滤器下拉、不显示名称），含 "*" 时不限类型。
// - XDG 门户形态：每个扩展名一个通配（门户的通配分大小写，ASCII 字母展开成 [xX]，同 Chromium），"*" 原样。
// ============================================================================

/// 规整后的过滤器：名称非空、不含 NUL；扩展名都合规、至少一个。
export struct FdFilter {
    name: string,
    exts: List<string>,
}

/// 扩展名是否合规（单独的 "*" 合规）。
export function fdExtOk(e: string): bool {
    if (e == "*") {
        return true;
    }
    const b = bytesFromStr(e);
    const n: int = bytesLen(b);
    if (n == 0 || (bytesGet(b, 0) catch 0) == 0x2E) {
        return false;
    }
    let i: int = 0;
    while (i < n) {
        const c: int = bytesGet(b, i) catch 0;
        if (c == 0 || c == 0x2A || c == 0x3F || c == 0x5B || c == 0x5D || c == 0x2F || c == 0x5C || c == 0x3B || c == 0x20 || (c >= 0x09 && c <= 0x0D)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

/// 规整一个过滤器并追加到 out；扩展名全不合规时不追加。
export function fdAdd(out: List<FdFilter>, name: string, exts: []string): void {
    const ok: List<string> = listNew();
    for (e in exts) {
        if (fdExtOk(e)) {
            listPush(ok, e);
        }
    }
    if (listLen(ok) == 0) {
        return;
    }
    const shown: string = cutNul(name);
    let f: FdFilter = { name: shown, exts: ok };
    if (shown == "") {
        f.name = fdWin32Pattern(f);
    }
    listPush(out, f);
}

/// Windows 的模式串：每个扩展名记作 "*.扩展名"（"*" 记作 "*.*"），以分号相隔。
export function fdWin32Pattern(f: FdFilter): string {
    let s: string = "";
    for (e in f.exts) {
        if (s != "") {
            s = s + ";";
        }
        if (e == "*") {
            s = s + "*.*";
        } else {
            s = s + "*." + e;
        }
    }
    return s;
}

/// Windows 形态：名称与模式交替；没有过滤器时为空表（平台层随之不给过滤串）。
export function fdWin32Parts(fs: List<FdFilter>): List<string> {
    const parts: List<string> = listNew();
    for (f in fs) {
        listPush(parts, f.name);
        listPush(parts, fdWin32Pattern(f));
    }
    return parts;
}

/// 保存对话框的缺省扩展名：第一个带具体扩展名的过滤器里的第一个；都只有 "*" 或没有过滤器时为空串。
export function fdDefExt(fs: List<FdFilter>): string {
    for (f in fs) {
        for (e in f.exts) {
            if (e != "*") {
                return e;
            }
        }
    }
    return "";
}

/// macOS 形态：所有过滤器的扩展名合成一组（面板不显示名称），按出现序、ASCII 不分大小写去重；任一过滤器含 "*" 或没有过滤器
/// 时为空表（不限类型）。
export function fdMacExts(fs: List<FdFilter>): List<string> {
    const out: List<string> = listNew();
    const seen: List<string> = listNew();
    for (f in fs) {
        for (e in f.exts) {
            if (e == "*") {
                return listNew();
            }
            const k: string = lowerAscii(e);
            let dup: bool = false;
            for (s in seen) {
                if (s == k) {
                    dup = true;
                }
            }
            if (!dup) {
                listPush(seen, k);
                listPush(out, e);
            }
        }
    }
    return out;
}

/// XDG 门户形态：一个扩展名的通配模式（门户的通配分大小写，ASCII 字母展开成 [xX]，同 Chromium）；"*" 原样。
export function fdPortalGlob(e: string): string {
    if (e == "*") {
        return "*";
    }
    const b = bytesFromStr(e);
    const out = bytesFromStr("*.");
    let i: int = 0;
    while (i < bytesLen(b)) {
        const c: int = bytesGet(b, i) catch 0;
        let lo: int = c;
        if (c >= 0x41 && c <= 0x5A) {
            lo = c + 0x20;
        }
        if (lo >= 0x61 && lo <= 0x7A) {
            bytesPush(out, 0x5B);
            bytesPush(out, lo);
            bytesPush(out, lo - 0x20);
            bytesPush(out, 0x5D);
        } else {
            bytesPush(out, c);
        }
        i = i + 1;
    }
    return bytesToStr(out) catch "*";
}

function lowerAscii(s: string): string {
    const b = bytesFromStr(s);
    const out = bytesNew(0);
    let i: int = 0;
    while (i < bytesLen(b)) {
        let c: int = bytesGet(b, i) catch 0;
        if (c >= 0x41 && c <= 0x5A) {
            c = c + 0x20;
        }
        bytesPush(out, c);
        i = i + 1;
    }
    return bytesToStr(out) catch s;
}

function cutNul(s: string): string {
    const b = bytesFromStr(s);
    let i: int = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) catch 1) == 0) {
            return bytesToStr(bytesSlice(b, 0, i)) catch "";
        }
        i = i + 1;
    }
    return s;
}
