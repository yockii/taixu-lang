import { rawName, rawNamePrefix, rawNameEqual, rawNameLess, rawNameSize, rawNameByte, rawNameHex, rawNameText } from "./selfhost/binary_name";
function main(args: []string): int {
    const data = readFile(args[0]) catch (e) { eprint(e.message); return 65; };
    const n0 = rawName(data, 0, 5); assert(n0.ok && rawNameSize(n0) == 5, "valid span"); assert(rawNameHex(n0) == "0x6173636969", "byte identity");
    assert(rawNameText(n0) == "ascii", "diagnostic text");
    assert(rawNameByte(n0, -1) == -1 && rawNameByte(n0, 5) == -1, "range rejection");
    const n1 = rawName(data, 6, 12); assert(n1.ok && rawNameSize(n1) == 12, "valid span"); assert(rawNameHex(n1) == "0xe5aebfe4b8bbe587bde695b0", "byte identity");
    assert(rawNameText(n1) == "宿主函数", "diagnostic text");
    assert(rawNameByte(n1, -1) == -1 && rawNameByte(n1, 12) == -1, "range rejection");
    const n2 = rawName(data, 19, 11); assert(n2.ok && rawNameSize(n2) == 11, "valid span"); assert(rawNameHex(n2) == "0xe5aebfe4b8bb5ff0a08080", "byte identity");
    assert(rawNameText(n2) == "宿主_𠀀", "diagnostic text");
    assert(rawNameByte(n2, -1) == -1 && rawNameByte(n2, 11) == -1, "range rejection");
    const n3 = rawName(data, 31, 1); assert(n3.ok && rawNameSize(n3) == 1, "valid span"); assert(rawNameHex(n3) == "0xff", "byte identity");
    assert(rawNameText(n3) == "0xff", "diagnostic text");
    assert(rawNameByte(n3, -1) == -1 && rawNameByte(n3, 1) == -1, "range rejection");
    const n4 = rawName(data, 33, 2); assert(n4.ok && rawNameSize(n4) == 2, "valid span"); assert(rawNameHex(n4) == "0xc0af", "byte identity");
    assert(rawNameText(n4) == "0xc0af", "diagnostic text");
    assert(rawNameByte(n4, -1) == -1 && rawNameByte(n4, 2) == -1, "range rejection");
    const n5 = rawName(data, 36, 3); assert(n5.ok && rawNameSize(n5) == 3, "valid span"); assert(rawNameHex(n5) == "0xeda080", "byte identity");
    assert(rawNameText(n5) == "0xeda080", "diagnostic text");
    assert(rawNameByte(n5, -1) == -1 && rawNameByte(n5, 3) == -1, "range rejection");
    const n6 = rawName(data, 40, 4); assert(n6.ok && rawNameSize(n6) == 4, "valid span"); assert(rawNameHex(n6) == "0xf4908080", "byte identity");
    assert(rawNameText(n6) == "0xf4908080", "diagnostic text");
    assert(rawNameByte(n6, -1) == -1 && rawNameByte(n6, 4) == -1, "range rejection");
    const n7 = rawName(data, 45, 2); assert(n7.ok && rawNameSize(n7) == 2, "valid span"); assert(rawNameHex(n7) == "0xe282", "byte identity");
    assert(rawNameText(n7) == "0xe282", "diagnostic text");
    assert(rawNameByte(n7, -1) == -1 && rawNameByte(n7, 2) == -1, "range rejection");
    const n8 = rawName(data, 48, 3); assert(n8.ok && rawNameSize(n8) == 3, "valid span"); assert(rawNameHex(n8) == "0x410042", "byte identity");
    assert(rawNameByte(n8, -1) == -1 && rawNameByte(n8, 3) == -1, "range rejection");
    const a = rawName("宿主函数", 0, len("宿主函数")); assert(rawNameEqual(a, n1), "cross source bytes");
    const pre = rawNamePrefix(rawNamePrefix(a, "tail_"), "head_"); const expected = "head_tail_宿主函数";
    assert(rawNameEqual(pre, rawName(expected, 0, len(expected))), "prefix byte equality");
    assert(rawNameText(pre) == expected, "prefix text");
    assert(!rawName(data, -1, 1).ok && !rawName(data, 0, -1).ok && !rawName(data, len(data) + 1, 0).ok && !rawName(data, 1, 9223372036854775807).ok, "invalid span rejection");
    assert(rawNameEqual(rawName(data, len(data), 0), rawName("", 0, 0)), "empty end view");
    assert(rawNameLess(rawName("A", 0, 1), rawName("B", 0, 1)) && rawNameLess(rawName("A", 0, 1), rawName("AA", 0, 2)), "raw order");
    let i = 0; while (i < 1000) { assert(rawNameText(rawName(data, 6, 12)) == "宿主函数", "reentry"); i = i + 1; }
    print("PASS_RAW_NAME_BYTE_IDENTITY_TEXT_OPAQUE_PREFIX_BOUNDS"); return 0;
}
