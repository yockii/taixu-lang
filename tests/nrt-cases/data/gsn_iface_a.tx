// generic-same-name-iface 的桩模块：模块 A 的 Item（按 x 比较）。
import { Cmp, best } from "./gsn_iface_g";

export struct Item { x: int }

function itemCompare(a: Item, b: Item): int { return a.x - b.x; }

export function fa(): string {
    const xs: List< Item> = listNew();
    listPush(xs, Item { x: 3 });
    listPush(xs, Item { x: 8 });
    listPush(xs, Item { x: 5 });
    const c: Cmp < Item > = Item { x: 4 };
    return toStr(best(xs, Item { x: 0 }).x) + "," + toStr(c.compare(Item { x: 1 }));
}
