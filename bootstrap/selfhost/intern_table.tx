// Borrowed immutable byte keys; FNV1a and linear probing, atomic prepare.
import { StructuredBuffer } from "./assemble";
import { nr, nd, nb, ni, nm, nmd, nmb, nt, nmov, nl, nj, nc, nret, no } from "./native_emit";
export function internTableEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_it_hash";
    nl(b, "__tx_it_hash"); nmov(b, nr(0), nr(2)); nt(b, "add", nr(0), nr(8)); nj(b, "jb", p + "_bad");
    nt(b, "test", nr(8), nr(8)); nj(b, "jz", p + "_start"); nt(b, "test", nr(2), nr(2)); nj(b, "jz", p + "_bad");
    nl(b, p + "_start"); nt(b, "movabs", nr(0), ni(-3750763034362895579)); nt(b, "movabs", nr(11), ni(1099511628211));
    nmov(b, nr(10), ni(0));
    nl(b, p + "_loop"); nt(b, "cmp", nr(10), nr(8)); nj(b, "jae", p + "_done");
    nt(b, "movzx", nd(9), nmb(2, 0)); nt(b, "xor", nr(0), nr(9)); nt(b, "imul", nr(0), nr(11)); nt(b, "add", nr(2), ni(1)); nt(b, "add", nr(10), ni(1)); nj(b, "jmp", p + "_loop");
    nl(b, p + "_done"); nmov(b, nr(11), ni(1)); nret(b); nl(b, p + "_bad"); nmov(b, nr(11), ni(0)); nret(b);

    // Return id or UINT32_MAX; the caller owns a well-formed native state.
    p = "__tx_it_find"; nl(b, "__tx_native_intern_find_v1"); nt(b, "cmp", nm(1, 8), ni(0)); nj(b, "je", p + "_missing");
    nt(b, "sub", nr(4), ni(72)); nmov(b, nm(4, 32), nr(1)); nmov(b, nm(4, 40), nr(2)); nmov(b, nm(4, 48), nr(8));
    nc(b, "__tx_it_hash"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_absent"); nmov(b, nm(4, 56), nr(0));
    nmov(b, nr(1), nm(4, 32)); nmov(b, nr(10), nm(1, 8)); nt(b, "sub", nr(10), ni(1)); nmov(b, nr(11), nm(1, 0)); nt(b, "and", nr(0), nr(10));
    nl(b, p + "_probe"); nmov(b, nr(11), nm(4, 32)); nmov(b, nr(11), nm(11, 0)); nmov(b, nr(9), nr(0)); nt(b, "shl", nr(9), ni(5)); nt(b, "add", nr(9), nr(11));
    nt(b, "cmp", nmd(9, 28), ni(0)); nj(b, "je", p + "_absent"); nmov(b, nr(2), nm(4, 56)); nt(b, "cmp", nr(2), nm(9, 0)); nj(b, "jne", p + "_next");
    nmov(b, nr(8), nm(4, 48)); nt(b, "cmp", nr(8), nm(9, 16)); nj(b, "jne", p + "_next");
    nmov(b, nr(1), nm(4, 40)); nmov(b, nr(2), nm(9, 8));
    nl(b, p + "_bytes"); nt(b, "test", nr(8), nr(8)); nj(b, "jz", p + "_found"); nt(b, "movzx", nd(9), nmb(1, 0)); nt(b, "movzx", nd(11), nmb(2, 0)); nt(b, "cmp", nd(9), nd(11)); nj(b, "jne", p + "_next"); nt(b, "add", nr(1), ni(1)); nt(b, "add", nr(2), ni(1)); nt(b, "sub", nr(8), ni(1)); nj(b, "jmp", p + "_bytes");
    nl(b, p + "_next"); nt(b, "add", nr(0), ni(1)); nt(b, "and", nr(0), nr(10)); nj(b, "jmp", p + "_probe");
    nl(b, p + "_found"); nmov(b, nr(11), nm(4, 32)); nmov(b, nr(11), nm(11, 0)); nt(b, "shl", nr(0), ni(5)); nt(b, "add", nr(0), nr(11)); nmov(b, nd(0), nmd(0, 24)); nj(b, "jmp", p + "_return");
    nl(b, p + "_absent"); nmov(b, nd(0), ni(-1)); nl(b, p + "_return"); nt(b, "add", nr(4), ni(72)); nret(b);
    nl(b, p + "_missing"); nmov(b, nd(0), ni(-1)); nret(b);

    p = "__tx_it_prepare"; nl(b, "__tx_native_intern_prepare_v1"); nmov(b, nr(0), nm(1, 8)); nt(b, "shr", nr(0), ni(1)); nmov(b, nr(9), nm(1, 16)); nt(b, "cmp", nr(9), nr(0)); nj(b, "jb", p + "_ok");
    nt(b, "sub", nr(4), ni(56)); nmov(b, nm(4, 32), nr(1)); nmov(b, nr(0), nm(1, 8));
    nt(b, "movabs", nr(10), ni(288230376151711743)); nt(b, "cmp", nr(0), nr(10)); nj(b, "ja", p + "_bad");
    nt(b, "shl", nr(0), ni(1)); nt(b, "cmp", nr(0), ni(16)); nj(b, "jae", p + "_alloc"); nmov(b, nr(0), ni(16));
    nl(b, p + "_alloc"); nmov(b, nm(4, 40), nr(0)); nmov(b, nr(1), nr(0)); nt(b, "shl", nr(1), ni(5)); nmov(b, nd(2), ni(8)); nc(b, "__tx_native_mem_alloc");
    nt(b, "test", nr(0), nr(0)); nj(b, "jz", p + "_bad"); nmov(b, nm(4, 48), nr(0));
    nmov(b, nr(8), nm(4, 40)); nmov(b, nr(9), nr(0)); nmov(b, nr(2), ni(0));
    nl(b, p + "_clear"); nmov(b, nm(9, 0), nr(2)); nmov(b, nm(9, 8), nr(2)); nmov(b, nm(9, 16), nr(2)); nmov(b, nm(9, 24), nr(2)); nt(b, "add", nr(9), ni(32)); nt(b, "sub", nr(8), ni(1)); nj(b, "jne", p + "_clear");
    nmov(b, nr(1), nm(4, 32)); nmov(b, nr(8), nm(1, 8)); nmov(b, nr(9), nm(1, 0)); nmov(b, nr(10), nm(4, 40)); nt(b, "sub", nr(10), ni(1)); nmov(b, nr(11), nm(4, 48));
    nl(b, p + "_rehash"); nt(b, "test", nr(8), nr(8)); nj(b, "jz", p + "_free"); nt(b, "cmp", nmd(9, 28), ni(0)); nj(b, "je", p + "_next");
    nmov(b, nr(0), nm(9, 0)); nt(b, "and", nr(0), nr(10));
    nl(b, p + "_probe"); nmov(b, nr(2), nr(0)); nt(b, "shl", nr(2), ni(5)); nt(b, "add", nr(2), nr(11)); nt(b, "cmp", nmd(2, 28), ni(0)); nj(b, "je", p + "_store"); nt(b, "add", nr(0), ni(1)); nt(b, "and", nr(0), nr(10)); nj(b, "jmp", p + "_probe");
    nl(b, p + "_store"); nmov(b, nr(0), nm(9, 0)); nmov(b, nm(2, 0), nr(0)); nmov(b, nr(0), nm(9, 8)); nmov(b, nm(2, 8), nr(0)); nmov(b, nr(0), nm(9, 16)); nmov(b, nm(2, 16), nr(0)); nmov(b, nr(0), nm(9, 24)); nmov(b, nm(2, 24), nr(0));
    nl(b, p + "_next"); nt(b, "add", nr(9), ni(32)); nt(b, "sub", nr(8), ni(1)); nj(b, "jmp", p + "_rehash");
    nl(b, p + "_free"); nmov(b, nr(1), nm(4, 32)); nt(b, "cmp", nm(1, 8), ni(0)); nj(b, "je", p + "_commit"); nmov(b, nr(1), nm(1, 0)); nc(b, "__tx_native_mem_free");
    nl(b, p + "_commit"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(0), nm(4, 48)); nmov(b, nm(1, 0), nr(0)); nmov(b, nr(0), nm(4, 40)); nmov(b, nm(1, 8), nr(0)); nmov(b, nr(0), ni(1)); nj(b, "jmp", p + "_return");
    nl(b, p + "_bad"); nmov(b, nr(0), ni(0)); nl(b, p + "_return"); nt(b, "add", nr(4), ni(56)); nret(b); nl(b, p + "_ok"); nmov(b, nr(0), ni(1)); nret(b);

    // Prepared capacity and unique keys are checked by find/prepare before materialization.
    p = "__tx_it_insert"; nl(b, "__tx_native_intern_insert_v1"); nt(b, "sub", nr(4), ni(56)); nmov(b, nm(4, 32), nr(1)); nmov(b, nm(4, 40), nr(2));
    nmov(b, nr(8), nm(2, 16)); nmov(b, nr(2), nm(2, 8)); nc(b, "__tx_it_hash");
    nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_bad"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(10), nm(1, 8)); nt(b, "shr", nr(10), ni(1)); nmov(b, nr(9), nm(1, 16)); nt(b, "cmp", nr(9), nr(10)); nj(b, "jae", p + "_bad");
    nmov(b, nr(10), nm(1, 8)); nt(b, "sub", nr(10), ni(1)); nmov(b, nr(11), nm(1, 0)); nmov(b, nr(9), nr(0)); nt(b, "and", nr(9), nr(10));
    nl(b, p + "_probe"); nmov(b, nr(8), nr(9)); nt(b, "shl", nr(8), ni(5)); nt(b, "add", nr(8), nr(11)); nt(b, "cmp", nmd(8, 28), ni(0)); nj(b, "je", p + "_store"); nt(b, "add", nr(9), ni(1)); nt(b, "and", nr(9), nr(10)); nj(b, "jmp", p + "_probe");
    nl(b, p + "_store"); nmov(b, nr(2), nm(4, 40)); nmov(b, nm(8, 0), nr(0)); nmov(b, nr(0), nm(2, 8)); nmov(b, nm(8, 8), nr(0)); nmov(b, nr(0), nm(2, 16)); nmov(b, nm(8, 16), nr(0)); nmov(b, nd(0), nmd(2, 24)); nmov(b, nmd(8, 24), nd(0)); nmov(b, nmd(8, 28), ni(1)); nmov(b, nr(0), nm(1, 16)); nt(b, "add", nr(0), ni(1)); nmov(b, nm(1, 16), nr(0)); nmov(b, nr(0), ni(1)); nj(b, "jmp", p + "_return");
    nl(b, p + "_bad"); nmov(b, nr(0), ni(0)); nl(b, p + "_return"); nt(b, "add", nr(4), ni(56)); nret(b);

    p = "__tx_it_destroy"; nl(b, "__tx_native_intern_destroy_v1"); nt(b, "sub", nr(4), ni(40)); nmov(b, nm(4, 32), nr(1)); nt(b, "cmp", nm(1, 8), ni(0)); nj(b, "je", p + "_clear"); nmov(b, nr(1), nm(1, 0)); nc(b, "__tx_native_mem_free");
    nl(b, p + "_clear"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(0), ni(0)); nmov(b, nm(1, 0), nr(0)); nmov(b, nm(1, 8), nr(0)); nmov(b, nm(1, 16), nr(0)); nt(b, "add", nr(4), ni(40)); nret(b);
}
