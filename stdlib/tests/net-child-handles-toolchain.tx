// ============================================================================
// stdlib 用例：子进程拿不到 std/net 的套接字（核心 D3 v0.40 子进程只继承标准三件；Windows 上套接字另建成不可继承）。
// 监听后经 runProcess 起一个把孙进程放到后台就退出的 shell（孙进程活约 2 秒），关掉监听再在同一端口监听须成功——孙进程若继承了
// 监听套接字，端口仍被占。runProcess 与 hostTarget 只在工具链构建里可用，verify 对 -toolchain.tx 结尾的用例加 --toolchain。
// 运行：taixu test --toolchain tests/net-child-handles-toolchain.tx（原生编译器）
// ============================================================================

import { tcpListen, tcpClose } from "std/net";
import { getenv } from "std/os";

test "net：runProcess 的后台孙进程拿不到监听套接字" {
    let port: int = 47260;
    let l: int = -1;
    while (l < 0 && port < 47276) {
        l = tcpListen(port) catch -1;
        if (l < 0) { port = port + 1; }
    }
    assert(l >= 0, "监听建立");
    let shell: string = "/bin/sh";
    const args: List<string> = listNew();
    if (hostTarget() == "windows") {
        shell = getenv("ComSpec");
        listPush(args, "/d");
        listPush(args, "/c");
        listPush(args, "start /b ping -n 3 127.0.0.1 >nul 2>nul");
    } else {
        listPush(args, "-c");
        listPush(args, "sleep 2 >/dev/null 2>&1 &");
    }
    assert((runProcess(shell, args, "") catch -1) == 0, "子进程正常退出");
    tcpClose(l);
    const again: int = tcpListen(port) catch -1;
    assert(again >= 0, "关掉监听后同一端口可立即重新监听");
    tcpClose(again);
}
