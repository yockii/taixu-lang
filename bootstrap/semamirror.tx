    if (b == 46) { return "readFileBytes(string): Bytes | Error"; }
    if (b == 47) { return "embedBytes(字符串字面量): Bytes"; }
    if (b == 48) { return "errAs<错误enum>(Error): 错误enum?"; }
    if (b == 49) { return "errWrap(Error, string): Error"; }
    if (b == 50) { return "hostTarget(): string"; }
    if (b == 79) { return "hostArch(): string"; }
    if (b == 51) { return "getEnv(string): string?"; }
    if (b == 86) { return "setEnv(string, string): void | Error"; }
