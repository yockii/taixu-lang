struct Counter {
    n: int,
}
export function main(args: []string): int {
    let snap: int = 10;
    const getSnap: () => int = (): int => snap;
    snap = 99;
    print(toStr(getSnap()));
    const c = new Counter { n: 1 };
    const bump: () => int = (): int => { c.n = c.n + 1; return c.n; };
    print(toStr(bump()));
    print(toStr(bump()));
    print(toStr(c.n));
    return 0;
}
