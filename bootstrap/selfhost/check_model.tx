// 检查路径的进程内平面数据（6d-6a，分析生命周期与缓存设计 §二）。
// 不保存语义类型图；普通编译仍使用完整 SEB1/FAB1。
export struct CheckModule {
    path: string,
    display: string,
    nodeCount: int,
    astbin: string,
    specs: List<string>,
    targets: List<int>,
    std: bool,
}

export struct CheckDiag {
    code: int, module: int, line: int, col: int, msg: string,
}

export struct CheckEmbed {
    module: int, line: int, col: int, raw: string,
}

export struct CheckResult {
    hasMain: bool,
    diags: List<Ref<CheckDiag>>,
    anaInts: List<int>,
    anaNames: List<string>,
    detInts: List<int>,
    detStrs: List<string>,
    embeds: List<Ref<CheckEmbed>>,
}
