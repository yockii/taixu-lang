// ============================================================================
// stdlib 用例：std/os 的参数与 main(args) 同源（核心 D3 v0.41）——逐项相同，含空参数、空格、引号、反斜杠与多字节；
// 越界得 ""。此前 Linux 读 /proc/self/cmdline、macOS 经 sysctl、Windows 按两态规则自己切分，三端都丢掉空参数。
// 本程序带 --child 起自己（runProcess、selfExePath 只在工具链构建里可用，verify 对 -toolchain.tx 结尾的用例加 --toolchain）。
// 运行：taixu run --toolchain tests/os-args-toolchain.tx（原生编译器）
// ============================================================================

import { args, argsLen, argAt } from "std/os";

function child(a: []string): int {
    const o = args();
    if (argsLen() != len(a) || listLen(o) != len(a)) {
        print("个数 main=" + toStr(len(a)) + " argsLen=" + toStr(argsLen()) + " args=" + toStr(listLen(o)));
        return 1;
    }
    let i: int = 0;
    while (i < len(a)) {
        const x = listGet(o, i) catch "<none>";
        if (x != a[i] || argAt(i) != a[i]) {
            print("第 " + toStr(i) + " 项 main=[" + a[i] + "] args=[" + x + "] argAt=[" + argAt(i) + "]");
            return 1;
        }
        i = i + 1;
    }
    if (argAt(len(a)) != "" || argAt(-1) != "") {
        print("越界不是空串");
        return 1;
    }
    print("same " + toStr(len(a)));
    return 0;
}

export function main(a: []string): int {
    // 只有不带参数时才起子进程；带别的参数直接返回，不会再起自己。
    if (len(a) > 0) {
        if (a[0] != "--child") {
            return 2;
        }
        return child(a);
    }
    const xs: List<string> = listNew();
    listPush(xs, "--child");
    listPush(xs, "");
    listPush(xs, "a b");
    listPush(xs, "太虚 🙂");
    listPush(xs, "x\"y");
    listPush(xs, "back\\");
    listPush(xs, "\\\"q");
    listPush(xs, "tab\there");
    listPush(xs, "");
    print("child " + toStr(runProcess(selfExePath(), xs, "") catch -1));
    return 0;
}
