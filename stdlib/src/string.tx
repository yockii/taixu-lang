// ============================================================================
// std/string —— 字符串工具（V0.7-S3，D20 §四-2；STD-02）。
//
// V0.38-S1 Unicode 化（STD-06）：toUpper/toLower/trim 走**显式范围表**
// （ASCII＋Latin-1 Supplement＋Latin Extended-A＋Greek＋Cyrillic 主区间——
// 覆盖面如实注记：表外码点原样保留；全 Unicode 特例折叠（ß→SS/İ 等）
// 不在表，登记 v0.39+ 判据式扩面）。其余函数按字节/码点处理。全部函数
// 确定性（表驱动纯函数）；行为注记见各函数头注。
// ============================================================================

// —— 判定与查找 ——

// contains：子串是否存在（字节序列匹配）。
export function contains(s: string, sub: string): bool {
    return indexOf(s, sub) >= 0;
}

// indexOf：首次出现的字节下标；不存在返回 -1。空子串恒为 0（前缀心智）。
export function indexOf(s: string, sub: string): int {
    const n = len(s);
    const m = len(sub);
    if (m == 0) {
        return 0;
    }
    if (m > n) {
        return -1;
    }
    let i: int = 0;
    while (i <= n - m) {
        let j: int = 0;
        let ok = true;
        while (j < m) {
            if ((byteAt(s, i + j) catch -1) != (byteAt(sub, j) catch -2)) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if (ok) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// —— 切分与拼接 ——

// split：按分隔符切分（**保留空段**，JS split 心智）；sep 为空返回单元素原串。
export function split(s: string, sep: string): List<string> {
    const out: List<string> = listNew();
    const m = len(sep);
    if (m == 0) {
        listPush(out, s);
        return out;
    }
    const n = len(s);
    let start: int = 0;
    let i: int = 0;
    while (i <= n - m) {
        let j: int = 0;
        let ok = true;
        while (j < m) {
            if ((byteAt(s, i + j) catch -1) != (byteAt(sep, j) catch -2)) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if (ok) {
            listPush(out, sliceBetween(s, start, i));
            start = i + m;
            i = start;
        } else {
            i = i + 1;
        }
    }
    listPush(out, sliceBetween(s, start, n));
    return out;
}

// [from, to) 字节区间重建字符串（byteAt＋码点感知重组——多字节序列原样保留）。
function sliceBetween(s: string, from: int, to: int): string {
    let out: string = "";
    let i: int = from;
    while (i < to) {
        const cp = decodeCpAt(s, i);
        if (cp < 0) {
            i = i + 1; // 非良构字节跳过（源恒为良构 UTF-8；防御面）
            continue;
        }
        const n = seqLenAt(s, i);
        out = out + (utf8Encode(cp) catch "");
        i = i + n;
    }
    return out;
}

// join：以 sep 连接列表（sep 为空即直接连接）。
export function join(parts: List<string>, sep: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < listLen(parts)) {
        if (i > 0) {
            out = out + sep;
        }
        out = out + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return out;
}

// —— 替换 ——

// replace：**首次出现**替换一次（TS/JS replace 语义，TS 优先原则）；
// 全量替换以 while 循环消费（含 old 为空时返回原串）。
export function replace(s: string, old: string, rep: string): string {
    const at = indexOf(s, old);
    if (len(old) == 0 || at < 0) {
        return s;
    }
    return sliceBetween(s, 0, at) + rep + sliceBetween(s, at + len(old), len(s));
}

// —— 修剪（Unicode 空白——V0.38-S1：ASCII 空白＋NBSP/全角空格等主区间）——

function isAsciiSpace(b: int): bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

// isSpaceCp：Unicode 空白码点（显式集——0x0009..0x000D/0x0020/0x0085/
// 0x00A0/0x1680/0x2000..0x200A/0x2028/0x2029/0x202F/0x205F/0x3000——
// 覆盖面如实注记）。
function isSpaceCp(cp: int): bool {
    if (cp >= 9 && cp <= 13) {
        return true;
    }
    if (cp == 32 || cp == 133 || cp == 160 || cp == 5760) {
        return true;
    }
    if (cp >= 8192 && cp <= 8202) {
        return true;
    }
    if (cp == 8232 || cp == 8233 || cp == 8239 || cp == 8287 || cp == 12288) {
        return true;
    }
    return false;
}

export function trimStart(s: string): string {
    let i: int = 0;
    while (i < len(s)) {
        const cp = decodeCpAt(s, i);
        if (cp < 0 || !isSpaceCp(cp)) {
            break;
        }
        i = i + seqLenAt(s, i);
    }
    return sliceBetween(s, i, len(s));
}

export function trimEnd(s: string): string {
    let e: int = len(s);
    while (e > 0) {
        // e 前最后一个码点起点（续字节回退）。
        let p = e - 1;
        while (p > 0 && (byteAt(s, p) catch 0) >= 128 && (byteAt(s, p) catch 0) < 192) {
            p = p - 1;
        }
        const cp = decodeCpAt(s, p);
        if (cp < 0 || !isSpaceCp(cp)) {
            break;
        }
        e = p;
    }
    return sliceBetween(s, 0, e);
}

// trim：两端修剪。
export function trim(s: string): string {
    return trimEnd(trimStart(s));
}

// —— 大小写（V0.38-S1 Unicode 化：显式范围表——ASCII＋Latin-1＋Latin
// Extended-A＋Greek＋Cyrillic；表外码点原样保留。纯 .tx 表驱动＝interp/AOT
// 双路逐位一致＋跨平台确定性；特例折叠（ß→SS/İ 等）不在表——v0.39+ 判据
// 式扩面登记）。——

export function toLower(s: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < len(s)) {
        const cp = decodeCpAt(s, i);
        if (cp < 0) {
            i = i + 1;
            continue;
        }
        out = out + (utf8Encode(lowerCp(cp)) catch "");
        i = i + seqLenAt(s, i);
    }
    return out;
}

export function toUpper(s: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < len(s)) {
        const cp = decodeCpAt(s, i);
        if (cp < 0) {
            i = i + 1;
            continue;
        }
        out = out + (utf8Encode(upperCp(cp)) catch "");
        i = i + seqLenAt(s, i);
    }
    return out;
}

// ============================================================================
// 大小写范围表（显式区间判定＝表；排序、无重叠——确定性锚。覆盖面：
// Basic Latin／Latin-1 Supplement／Latin Extended-A 偶奇位／Greek／Cyrillic
// 主区间——来源 UnicodeData.txt 主区间提取，如实注记）。
// ============================================================================

// upperCp：码点大写映射（表外原样）。
function upperCp(cp: int): int {
    // Basic Latin：a..z。
    if (cp >= 97 && cp <= 122) {
        return cp - 32;
    }
    // Latin-1：à..þ（224..254，÷247 除外）。
    if (cp >= 224 && cp <= 254 && cp != 247) {
        return cp - 32;
    }
    // Latin Extended-A：偶数位小写（256..375）。
    if (cp >= 256 && cp <= 375 && cp % 2 == 0) {
        return cp - 1;
    }
    // Greek：α..ω（945..969）。
    if (cp >= 945 && cp <= 969) {
        return cp - 32;
    }
    // Cyrillic：а..я（1072..1103）。
    if (cp >= 1072 && cp <= 1103) {
        return cp - 32;
    }
    return cp;
}

// lowerCp：码点小写映射（表外原样）。
function lowerCp(cp: int): int {
    // Basic Latin：A..Z。
    if (cp >= 65 && cp <= 90) {
        return cp + 32;
    }
    // Latin-1：À..Þ（192..222，×215 除外）。
    if (cp >= 192 && cp <= 222 && cp != 215) {
        return cp + 32;
    }
    // Latin Extended-A：奇数位大写（257..376）。
    if (cp >= 257 && cp <= 376 && cp % 2 == 1) {
        return cp + 1;
    }
    // Greek：Α..Ρ（913..929）＋Σ..Ω（931..937）。
    if (cp >= 913 && cp <= 929) {
        return cp + 32;
    }
    if (cp >= 931 && cp <= 937) {
        return cp + 32;
    }
    // Cyrillic：А..Я（1040..1071）。
    if (cp >= 1040 && cp <= 1071) {
        return cp + 32;
    }
    return cp;
}

// ============================================================================
// 码点读取（与 json.tx 同款算术掩码；本地副本——跨文件私有函数不可见）
// ============================================================================

function seqLenAt(s: string, i: int): int {
    const bopt = byteAt(s, i);
    if (bopt == None) {
        return 0;
    }
    const b = bopt catch 0;
    if (b < 128) {
        return 1;
    }
    if (b >= 194 && b <= 223) {
        return 2;
    }
    if (b >= 224 && b <= 239) {
        return 3;
    }
    if (b >= 240 && b <= 244) {
        return 4;
    }
    return 0;
}

function decodeCpAt(s: string, i: int): int {
    const n = seqLenAt(s, i);
    if (n == 0) {
        return -1;
    }
    const bopt = byteAt(s, i);
    if (bopt == None) {
        return -1;
    }
    const b = bopt catch -1;
    if (n == 1) {
        return b;
    }
    const b2opt = byteAt(s, i + 1);
    if (b2opt == None) {
        return -1;
    }
    const b2 = b2opt catch -1;
    if (b2 < 128 || b2 >= 192) {
        return -1;
    }
    if (n == 2) {
        return (b % 32) * 64 + (b2 % 64);
    }
    const b3opt = byteAt(s, i + 2);
    if (b3opt == None) {
        return -1;
    }
    const b3 = b3opt catch -1;
    if (b3 < 128 || b3 >= 192) {
        return -1;
    }
    if (n == 3) {
        return (b % 16) * 4096 + (b2 % 64) * 64 + (b3 % 64);
    }
    const b4opt = byteAt(s, i + 3);
    if (b4opt == None) {
        return -1;
    }
    const b4 = b4opt catch -1;
    if (b4 < 128 || b4 >= 192) {
        return -1;
    }
    return (b % 8) * 262144 + (b2 % 64) * 4096 + (b3 % 64) * 64 + (b4 % 64);
}
