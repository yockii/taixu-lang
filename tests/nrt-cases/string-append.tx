// 字符串原地追加（docs/design/v052-string-append-v0.1-20261016.md）：唯一持有时在原对象上按容量追加，
// 别的持有者（别名、列表元素、闭包捕获、驻留字面量）一律看不到变化；内容逐字节正确。

function digest(s: string): int {
    let h = 0;
    let i = 0;
    while (i < len(s)) {
        h = (h * 31 + (byteAt(s, i) catch 0)) % 1000000007;
        i = i + 1;
    }
    return h;
}

function joinParts(parts: List< string>, sep: string): string {
    let out = "";
    let i = 0;
    while (i < listLen(parts)) {
        if (i > 0) { out = out + sep; }
        out = out + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return out;
}

export function main(args: []string): int {
    // 两段与链式累加，内容与长度。
    let s = "";
    let i = 0;
    while (i < 1000) {
        s = s + toStr(i % 10);
        i = i + 1;
    }
    let c = "x";
    i = 0;
    while (i < 500) {
        c = c + "-" + toStr(i) + ";";
        i = i + 1;
    }
    print(toStr(len(s)) + " " + toStr(digest(s)) + " " + strSub(s, 995, 5));
    print(toStr(len(c)) + " " + toStr(digest(c)) + " " + strSub(c, 0, 12));

    // 别名：t 与 s 共享时追加不得改到 t。
    let a = "base";
    a = a + "1";
    const t = a;
    a = a + "2";
    a = a + "3" + "4";
    print(t + " " + a);

    // 列表元素与闭包捕获。
    let b = "list";
    b = b + "0";
    const l: List< string> = listNew();
    listPush(l, b);
    b = b + "1";
    const f = (): string => b;
    b = b + "2";
    print((listGet(l, 0) catch "?") + " " + f() + " " + b);

    // 驻留字面量：从字面量起步累加后，同一字面量不变。
    let k = "lit";
    k = k + "A";
    k = k + "B" + "C";
    print(k + " " + "lit" + " " + toStr(len("lit")));

    // 自追加与右侧引用自身。
    let d = "ab";
    d = d + d;
    d = d + "|" + d;
    print(d);

    // 非 ASCII 追加后的按字节操作、查找与比较。
    let u = "a";
    u = u + "é";
    u = u + "中" + "z";
    print(toStr(len(u)) + " " + toStr(strIndexOf(u, "中")) + " " + strSub(u, 1, 2) + " " + toStr(u == "aé中z"));

    // 纯 ASCII 缓存：strSub 先在对象上记下“纯 ASCII”，原地追加非 ASCII 后须按码点重新计算。
    let w = "ab";
    w = w + "c";
    const w0 = strSub(w, 1, 2);
    w = w + "é";
    w = w + "x" + "y";
    print(w0 + " " + strSub(w, 3, 2) + " " + toStr(len(w)));

    // 每轮多处累加（标准库 join 的写法）与独立构造逐字节比较。
    const parts: List< string> = listNew();
    i = 0;
    while (i < 300) {
        listPush(parts, "p" + toStr(i));
        i = i + 1;
    }
    const joined = joinParts(parts, ",");
    let manual = "p0";
    i = 1;
    while (i < 300) {
        manual = manual + ",p" + toStr(i);
        i = i + 1;
    }
    print(toStr(len(joined)) + " " + toStr(joined == manual) + " " + strSub(joined, 0, 11));
    return 0;
}
