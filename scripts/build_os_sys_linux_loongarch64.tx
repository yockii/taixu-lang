// build_os_linux.tx 用的系统调用（loongarch64 的号，Linux v7.3 号表；只许写在 _linux_loongarch64 文件里）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux、_linux_aarch64 与
// _linux_loongarch64 三个文件（B16 导出面相同）；种子换代后改成 from syscall "名字" 合成一份。
declare function sysLxOpenat(dir: int, path: string, flags: int, mode: int): int from syscall 56;
declare function sysLxWrite(fd: int, buf: Bytes, n: int): int from syscall 64;
declare function sysLxClose(fd: int): int from syscall 57;
declare function sysLxUnlinkat(dir: int, path: string, flags: int): int from syscall 35;
// 龙芯没有 renameat，取 renameat2（标志 0，语义相同）。
declare function sysLxRenameat2(olddir: int, oldpath: string, newdir: int, newpath: string, flags: int): int from syscall 276;

export function lxOpenat(dir: int, path: string, flags: int, mode: int): int { return sysLxOpenat(dir, path, flags, mode); }
export function lxWrite(fd: int, buf: Bytes, n: int): int { return sysLxWrite(fd, buf, n); }
export function lxClose(fd: int): int { return sysLxClose(fd); }
export function lxUnlinkat(dir: int, path: string, flags: int): int { return sysLxUnlinkat(dir, path, flags); }
export function lxRenameat(olddir: int, oldpath: string, newdir: int, newpath: string): int { return sysLxRenameat2(olddir, oldpath, newdir, newpath, 0); }
