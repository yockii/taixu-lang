// dpi-scale —— 帧级 DPI 缩放守护（臂①）：
// 重放脚本 `scale 150` 指令声明 DPI（宿主单点——txp_window_scale/txp_gui_query
// 恒脚本声明值）→ app.k 装配 → surface 物理面（DIP×k）＋canvas k 因子出帧
// →resize 重排重渲染。**重放确定性锚＝同脚本同 golden 跨宿主显示器 DPI
// 形态**（150% 开发机与 100% 机回放产物逐字节一致）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/dpi-scale.txt TAIXU_FRAME=1 taixu run tests/dpi-scale.tx
import { Canvas, canvasDpi, blockPainter, paintFillRect, paintText } from "gui/components";
import { appNew, appClose, pump, onResize, defaultSpec } from "gui/app";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent, dipToPxK } from "gui/surface";

struct Model {
    surface: int,
    phys_w: int,
    phys_h: int,
}

function render(cv: Ref<Canvas>, w: int, h: int, m: Ref<Model>): void {
    m.phys_w = cv.clip_w;
    m.phys_h = cv.clip_h;
    surfaceClear(cv.h, 0x202040);
    // DIP 坐标×k 出物理帧：150% 下头部条 24 DIP→36 物理像素。
    paintFillRect(cv, 0, 0, w, 24, 0x30305A);
    paintText(cv, 8, 7, 0xFFFFFF, "dpi scale probe");
    paintFillRect(cv, 8, 32, w - 16, h - 40, 0x182032);
    paintText(cv, 12, 38, 0xC0C8E0, "frame at k/100");
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, phys_w: 0, phys_h: 0 };
    const spec = defaultSpec("dpi probe", 200, 100);
    const app = appNew(spec);
    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpenDip(w, h, app.k) catch 0;
        });
    let presents: int = 0;
    let frame: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = canvasDpi(m.surface, dipToPxK(app.w, app.k), dipToPxK(app.h, app.k), blockPainter(), app.k);
            render(cv, app.w, app.h, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("scale=" + toStr(app.k) + " phys=" + toStr(m.phys_w) + "x" + toStr(m.phys_h) + " resize_count=" + toStr(app.resize_count) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
