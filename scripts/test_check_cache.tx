// 原生检查缓存的门：冷／热逐项差分、工作计数、完整语料和连续 200 个结构变更。
// 第五节（模块缓存）。
//
// 以 --toolchain --leak-check 构建 bootstrap/selfhost/check-cache-probe.tx，再按组写配置（入口、目标 0 windows／1 linux、逐版的覆盖层）
// 运行探针。探针对每一版各做一次冷检查、一次缓存未命中与一次命中的检查，三者的诊断与分析逐项相同才输出该版的工作计数
// {"revision":k,"miss":[…],"hit":[…]}（解析的源、解码的 AST、检查的模块体等六项），不同即以非零退出、在 stderr 说明。本门核对：
// 每组探针退出 0、stderr 为空、每版一行；完整命中不解析源、不解码 AST、不检查模块体；各组的计数合乎变更的范围。
// 组：behavior（导入图、泛型、嵌入文件的元数据、嵌入次序、实例上限、六个进阶用例）、corpus（分析门的语料，同 test_ana.tx 的 corpus 组，
// 外加编译器自己）、soak（200 次结构变更只重查改了的模块）。
//
// 探针或构建超时（构建 600 s、每组 3600 s）记该项 FAIL（exit=timeout）、余下照跑；探针的行缺字段时记该项 FAIL。配置为紧凑的
// UTF-8 JSON。语料按字节序排列（同 test_ana.tx）。未给 --work 时自建的临时目录全部通过即删除、有失败则保留并指明。
//
// 运行（仓根）：taixu run --toolchain scripts/test_check_cache.tx --compiler <taixu> [--work <目录>] [--only behavior,corpus,soak]
// 任何 FAIL 时退出码 1。
import { absolute, deleteTree, exeName, join, kindOf, mkdirs, nat } from "./build_lib";
import { osRealPath } from "./build_os";
import { captureRaw, linesOf } from "./test_lib";
import { sorted, tailChars } from "./test_text";
import { lossyText } from "./check_lib";
import { Jv, jInt, jParse, jQuote } from "./test_json";
import { at, item } from "./test_jv";

const SEC: int = 1000000000;
const MAX_OUTPUT: int = 1073741824;
// 分析门（scripts/test_ana.tx）的语料：三个夹具目录、LSP 与分析夹具的全部 .tx，外加编译器自己。
const ANA_CORPUS_DIRS: []string = ["tests/cases", "tests/nrt-cases", "examples", "tests/lsp", "tests/ana"];

struct Ctx {
    root: string,
    work: string,
    exe: string,
    bad: int,
}

// 一版覆盖层：paths／texts 一一对应；entry（换入口，corpus 组）、toolchain（−1 不写）、remove／write（删、写嵌入的文件）、
// mustCode（期望的诊断码，0 不写）为可选项。
struct Rev {
    entry: string,
    paths: List<string>,
    texts: List<string>,
    toolchain: int,
    remove: string,
    write: string,
    mustCode: int,
}

// 一份文件：相对名与内容（初版与各次变更都按此给出）。
struct Src {
    name: string,
    text: string,
}

function check(c: Ref<Ctx>, name: string, ok: bool, detail: string): void {
    let line = "FAIL ";
    if (ok) {
        line = "PASS ";
    }
    line = line + name;
    if (len(detail) > 0) {
        line = line + " " + detail;
    }
    print(line);
    if (!ok) {
        c.bad = c.bad + 1;
    }
}

function strs(xs: []string): List<string> {
    const out: List<string> = listNew();
    for (x in xs) {
        listPush(out, x);
    }
    return out;
}

function noStrs(): List<string> {
    const xs: List<string> = listNew();
    return xs;
}

function rev(paths: List<string>, texts: List<string>): Rev {
    return Rev { entry: "", paths: paths, texts: texts, toolchain: -1, remove: "", write: "", mustCode: 0 };
}

function src(name: string, text: string): Src {
    return Src { name: name, text: text };
}

function quoteList(xs: List<string>): string {
    let s = "[";
    let k = 0;
    for (x in xs) {
        if (k > 0) {
            s = s + ",";
        }
        s = s + jQuote(x);
        k = k + 1;
    }
    return s + "]";
}

// 配置的一版（键依次为 entry、paths、texts、toolchain、remove、write、must_code，缺省的不写）。
function revJson(r: Rev): string {
    let s = "{";
    if (len(r.entry) > 0) {
        s = s + "\"entry\":" + jQuote(r.entry) + ",";
    }
    s = s + "\"paths\":" + quoteList(r.paths) + ",\"texts\":" + quoteList(r.texts);
    if (r.toolchain >= 0) {
        if (r.toolchain == 1) {
            s = s + ",\"toolchain\":true";
        } else {
            s = s + ",\"toolchain\":false";
        }
    }
    if (len(r.remove) > 0) {
        s = s + ",\"remove\":" + jQuote(r.remove);
    }
    if (len(r.write) > 0) {
        s = s + ",\"write\":" + jQuote(r.write);
    }
    if (r.mustCode != 0) {
        s = s + ",\"must_code\":" + toStr(r.mustCode);
    }
    return s + "}";
}

// rows[k][key][i]；缺席或不是整数得 None。
function cnt(r: Ref<Jv>?, key: string, i: int): int? {
    return jInt(item(at(r, key), i));
}

function cntIs(r: Ref<Jv>?, key: string, i: int, want: int): bool {
    const v = cnt(r, key, i);
    return v != None && (v ?? 0) == want;
}

function cntSame(r: Ref<Jv>?, key: string, i: int, j: int): bool {
    const a = cnt(r, key, i);
    const b = cnt(r, key, j);
    return a != None && b != None && (a ?? 0) == (b ?? 1);
}

function rowAt(rows: List<Ref<Jv>>, k: int): Ref<Jv>? {
    if (k < 0 || k >= listLen(rows)) {
        return None;
    }
    return listGet(rows, k) catch None;
}

function noRows(): List<Ref<Jv>> {
    const xs: List<Ref<Jv>> = listNew();
    return xs;
}

// 逐行解析进 rows；不是 UTF-8 或有一行解析不了即为假（整组作废）。
function parseRows(out: Bytes, rows: List<Ref<Jv>>): bool {
    const text = bytesToStr(out) catch (e) {
        return false;
    };
    for (line in linesOf(text)) {
        const v = jParse(line) catch (e) {
            return false;
        };
        listPush(rows, v);
    }
    return true;
}

// 写配置、运行探针、记日志；得各版的计数行，失败得空表。
function run(c: Ref<Ctx>, name: string, entry: string, revisions: List<Rev>, target: int): List<Ref<Jv>> {
    let body = "{\"entry\":" + jQuote(entry) + ",\"target\":" + toStr(target) + ",\"revisions\":[";
    let k = 0;
    for (r in revisions) {
        if (k > 0) {
            body = body + ",";
        }
        body = body + revJson(r);
        k = k + 1;
    }
    body = body + "]}";
    const config = nat(join(c.work, name + ".json"));
    writeFile(config, body) catch (e) {
        check(c, name + " cold/miss/hit", false, "exit=None " + e.message);
        return noRows();
    };
    const p = captureRaw(c.exe, strs([config]), c.root, 3600 * SEC, 10 * SEC, MAX_OUTPUT) catch (e) {
        check(c, name + " cold/miss/hit", false, "exit=None " + e.message);
        return noRows();
    };
    const both = bytesNew(0);
    bytesAppend(both, p.out);
    bytesAppend(both, p.err);
    writeFileBytes(nat(join(c.work, name + ".log")), both) catch (e) {
        eprint("写不了 " + name + ".log：" + e.message);
    };
    let ok = p.code == 0 && bytesLen(p.err) == 0;
    const rows = noRows();
    if (parseRows(p.out, rows)) {
        ok = ok && listLen(rows) == listLen(revisions);
    } else {
        ok = false;
    }
    let detail = "";
    if (!ok) {
        let code = toStr(p.code);
        if (p.timedOut) {
            code = "timeout";
        }
        detail = "exit=" + code + " " + tailChars(lossyText(p.err), 1800);
    }
    check(c, name + " cold/miss/hit", ok, detail);
    if (!ok) {
        return noRows();
    }
    // 完整命中既不解析源、不解码 AST，也不检查模块体。
    let hits = true;
    for (r in rows) {
        if (!(cntIs(r, "hit", 0, 0) && cntIs(r, "hit", 1, 0) && cntIs(r, "hit", 2, 0) && cntSame(r, "hit", 3, 5))) {
            hits = false;
        }
    }
    check(c, name + " hit counters", hits, "");
    return rows;
}

// 在 folder 里写下初版，得初版与逐次变更后的各版（同名替换、次序不变）。
function versions(folder: string, initial: List<Src>, changes: List<List<Src>>): List<Rev> {
    mkdirs(folder);
    const names: List<string> = listNew();
    const texts: List<string> = listNew();
    for (f in initial) {
        writeFile(nat(join(folder, f.name)), f.text) catch (e) {
            eprint("写不了 " + f.name + "：" + e.message);
        };
        listPush(names, f.name);
        listPush(texts, f.text);
    }
    const out: List<Rev> = listNew();
    listPush(out, snapshot(folder, names, texts));
    for (change in changes) {
        for (f in change) {
            let i = 0;
            let found = false;
            while (i < listLen(names)) {
                if ((listGet(names, i) catch "") == f.name) {
                    listSet(texts, i, f.text);
                    found = true;
                }
                i = i + 1;
            }
            if (!found) {
                listPush(names, f.name);
                listPush(texts, f.text);
            }
        }
        listPush(out, snapshot(folder, names, texts));
    }
    return out;
}

function snapshot(folder: string, names: List<string>, texts: List<string>): Rev {
    const paths: List<string> = listNew();
    for (n in names) {
        listPush(paths, nat(join(folder, n)));
    }
    const copy: List<string> = listNew();
    for (t in texts) {
        listPush(copy, t);
    }
    return rev(paths, copy);
}

function one(name: string, text: string): List<Src> {
    const xs: List<Src> = listNew();
    listPush(xs, src(name, text));
    return xs;
}

// s 里的 a 全部换成 b（同 Python 的 str.replace）。
function replaceAll(s: string, a: string, b: string): string {
    const parts = strSplit(s, a);
    if (listLen(parts) < 2) {
        return s;
    }
    let out = listGet(parts, 0) catch "";
    let i = 1;
    while (i < listLen(parts)) {
        out = out + b + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return out;
}

// 读文本并统一换行（同 Python 的 read_text：\r\n 与单独的 \r 都成 \n）。
function readText(p: string): string {
    const b = readFile(p) catch "";
    return replaceAll(replaceAll(b, "\r\n", "\n"), "\r", "\n");
}

function behavior(c: Ref<Ctx>): void {
    let entryText = "import { value } from \"./left\";\nimport { other } from \"./right\";\nfunction main(args: []string): int { return value() + other(); }\n";
    const left = "import { leaf } from \"./leaf\";\nexport function value(): int { return leaf(); }\n";
    const leaf = "export function leaf(): int { return 1; }\n";
    const initial: List<Src> = listNew();
    listPush(initial, src("main.tx", entryText));
    listPush(initial, src("left.tx", left));
    listPush(initial, src("leaf.tx", leaf));
    listPush(initial, src("right.tx", "export function other(): int { return 7; }\n"));
    listPush(initial, src("extra.tx", "export function extra(): int { return 9; }\n"));
    const changes: List<List<Src>> = listNew();
    listPush(changes, one("main.tx", entryText + "const added: int = 1;\n"));
    listPush(changes, one("left.tx", replaceAll(left, "return leaf();", "return leaf() + 1;")));
    listPush(changes, one("leaf.tx", replaceAll(leaf, "return 1;", "return 2;")));
    listPush(changes, one("main.tx", entryText));
    listPush(changes, one("main.tx", "import { extra } from \"./extra\";\n" + entryText));
    listPush(changes, one("main.tx", entryText));
    let revisions = versions(nat(join(c.work, "graph")), initial, changes);
    let target = 0;
    while (target < 2) {
        const name = "graph-" + toStr(target);
        const rows = run(c, name, nat(join(c.work, "graph/main.tx")), revisions, target);
        if (listLen(rows) > 0) {
            const want: []int = [4, 1, 2, 3, 1];
            let same = listLen(rows) >= 5;
            let k = 0;
            while (same && k < 5) {
                same = cntIs(rowAt(rows, k), "miss", 2, want[k]);
                k = k + 1;
            }
            check(c, name + " affected bodies only", same, "");
            let graph = true;
            k = 5;
            while (k < listLen(rows)) {
                if (!cntSame(rowAt(rows, k), "miss", 2, 5)) {
                    graph = false;
                }
                k = k + 1;
            }
            check(c, name + " changed import graph", graph, "");
        }
        target = target + 1;
    }

    entryText = "import { identity } from \"./generic\";\nimport { other } from \"./right\";\nfunction main(args: []string): int { return other(); }\n";
    const gInit: List<Src> = listNew();
    listPush(gInit, src("main.tx", entryText));
    listPush(gInit, src("generic.tx", "export function identity<T>(x: T): T { const copy = x; return copy; }\n"));
    listPush(gInit, src("right.tx", "export function other(): int { return 2; }\n"));
    const gChanges: List<List<Src>> = listNew();
    listPush(gChanges, one("main.tx", replaceAll(entryText, "return other();", "return identity<int>(1);")));
    listPush(gChanges, one("main.tx", replaceAll(entryText, "return other();", "return len(identity<string>(\"x\"));")));
    revisions = versions(nat(join(c.work, "generic")), gInit, gChanges);
    target = 0;
    while (target < 2) {
        const name = "generic-" + toStr(target);
        const rows = run(c, name, nat(join(c.work, "generic/main.tx")), revisions, target);
        if (listLen(rows) > 0) {
            const r1 = rowAt(rows, 1);
            const e = cnt(r1, "miss", 4);
            check(c, name + " new semantic edge", e != None && (e ?? 0) >= 1 && cntIs(r1, "miss", 3, 1), "");
            check(c, name + " caller affects definition facts", cntIs(rowAt(rows, 2), "miss", 2, 2), "");
        }
        target = target + 1;
    }

    let folder = nat(join(c.work, "metadata"));
    const noChanges: List<List<Src>> = listNew();
    revisions = versions(folder, one("main.tx", "function main(args: []string): int { return bytesLen(embedBytes(\"payload.bin\")); }\n"), noChanges);
    const asset = nat(join(folder, "payload.bin"));
    writeFile(asset, "x") catch (e) {
        eprint("写不了 payload.bin：" + e.message);
    };
    const first = listGet(revisions, 0) catch rev(noStrs(), noStrs());
    listPush(revisions, Rev { entry: "", paths: first.paths, texts: first.texts, toolchain: -1, remove: asset, write: "", mustCode: 0 });
    listPush(revisions, Rev { entry: "", paths: first.paths, texts: first.texts, toolchain: -1, remove: "", write: asset, mustCode: 0 });
    const mrows = run(c, "metadata", nat(join(folder, "main.tx")), revisions, 0);
    if (listLen(mrows) > 0) {
        let cached = true;
        let k = 1;
        while (k < listLen(mrows)) {
            const r = rowAt(mrows, k);
            if (!(cntIs(r, "miss", 0, 0) && cntIs(r, "miss", 1, 0) && cntIs(r, "miss", 2, 0))) {
                cached = false;
            }
            k = k + 1;
        }
        check(c, "metadata changes with cached semantics", cached, "");
    }

    folder = nat(join(c.work, "embed-order"));
    let text = "import { load } from \"./generic\";\nfunction main(args: []string): int { const a = embedBytes(\"root-missing.bin\"); return load<int>(1) + bytesLen(a); }\n";
    const eInit: List<Src> = listNew();
    listPush(eInit, src("main.tx", text));
    listPush(eInit, src("generic.tx", "export function load<T>(x: T): int { return bytesLen(embedBytes(\"generic-missing.bin\")); }\n"));
    const eChanges: List<List<Src>> = listNew();
    listPush(eChanges, one("main.tx", text + "const bigger: int = 1;\n"));
    listPush(eChanges, one("main.tx", text));
    const eRows = run(c, "embed-order", nat(join(folder, "main.tx")), versions(folder, eInit, eChanges), 0);

    folder = nat(join(c.work, "instance-limit"));
    text = "struct Pair<A, B> { a: A, b: B, }\nfunction duplicate<T>(x: T): Ref<Pair<T, T>> { return new Pair<T, T> { a: x, b: x }; }\nfunction main(args: []string): int {\nconst v0 = 1;\n";
    let i = 1;
    while (i < 22) {
        text = text + "const v" + toStr(i) + " = duplicate(v" + toStr(i - 1) + ");\n";
        i = i + 1;
    }
    text = text + "return 0;\n}\n";
    const iChanges: List<List<Src>> = listNew();
    listPush(iChanges, one("main.tx", text + "const changed: int = 1;\n"));
    const iRevs: List<Rev> = listNew();
    for (r in versions(folder, one("main.tx", text), iChanges)) {
        listPush(iRevs, Rev { entry: "", paths: r.paths, texts: r.texts, toolchain: -1, remove: "", write: "", mustCode: 3020 });
    }
    const iRows = run(c, "instance-limit", nat(join(folder, "main.tx")), iRevs, 0);

    const cases: []string = ["tests/ana/closure.tx", "tests/nrt-cases/iface-values.tx", "tests/nrt-cases/iface-generics.tx",
        "tests/nrt-cases/iface-bad-defcheck.tx", "tests/nrt-cases/gen-generic.tx", "tests/nrt-cases/gen-more.tx"];
    let index = 0;
    while (index < len(cases)) {
        const entry = nat(join(c.root, cases[index]));
        const body = readText(entry);
        const revs: List<Rev> = listNew();
        let n = 1;
        while (n <= 2) {
            listPush(revs, rev(strs([entry]), strs([body + "\n" + "const cacheProbeExtra: int = " + toStr(n) + ";\n"])));
            n = n + 1;
        }
        const aRows = run(c, "advanced-" + toStr(index), entry, revs, 0);
        index = index + 1;
    }
}

function endsTx(n: string): bool {
    return len(n) > 3 && (byteAt(n, len(n) - 3) ?? 0) == 46 && (byteAt(n, len(n) - 2) ?? 0) == 116 && (byteAt(n, len(n) - 1) ?? 0) == 120;
}

// [(toolchain, 相对名)]：同 test_ana.tx 的 corpus 组。
function corpus(c: Ref<Ctx>): List<Rev> {
    const out: List<Rev> = listNew();
    for (d in ANA_CORPUS_DIRS) {
        const dir = nat(join(c.root, d));
        const names = localListDir(dir, "") catch noStrs();
        for (n in sorted(names)) {
            if (endsTx(n) && localEntryKind(dir, n) == 1) {
                const stem = bytesToStr(bytesSlice(bytesFromStr(n), 0, len(n) - 3)) catch n;
                let tc = 0;
                if (localEntryKind(dir, stem + ".toolchain") == 1) {
                    tc = 1;
                }
                listPush(out, Rev { entry: nat(join(c.root, d + "/" + n)), paths: noStrs(), texts: noStrs(), toolchain: tc, remove: "", write: "",
                        mustCode: 0 });
            }
        }
    }
    listPush(out, Rev { entry: nat(join(c.root, "bootstrap/taixu.tx")), paths: noStrs(), texts: noStrs(), toolchain: 1, remove: "", write: "",
            mustCode: 0 });
    return out;
}

function soak(c: Ref<Ctx>): void {
    const folder = nat(join(c.work, "soak"));
    const text = "import { leaf } from \"./leaf\";\nfunction main(args: []string): int { return leaf(); }\n";
    const leaf = "export function leaf(): int { return 1; }\n";
    const init: List<Src> = listNew();
    listPush(init, src("main.tx", text));
    listPush(init, src("leaf.tx", leaf));
    const noChanges: List<List<Src>> = listNew();
    const revisions = versions(folder, init, noChanges);
    const paths = (listGet(revisions, 0) catch rev(noStrs(), noStrs())).paths;
    let i = 0;
    while (i < 200) {
        let consts = "";
        let j = 0;
        while (j < 1 + i % 2) {
            if (j > 0) {
                consts = consts + "\n";
            }
            consts = consts + "const cacheProbe" + toStr(j) + ": int = " + toStr(i + j) + ";";
            j = j + 1;
        }
        listPush(revisions, rev(paths, strs([text + "\n" + consts + "\n", leaf])));
        i = i + 1;
    }
    const rows = run(c, "soak-200", nat(join(folder, "main.tx")), revisions, 0);
    if (listLen(rows) > 0) {
        let reuse = true;
        let k = 1;
        while (k < listLen(rows)) {
            const r = rowAt(rows, k);
            if (!(cntIs(r, "miss", 0, 1) && cntIs(r, "miss", 2, 1) && cntIs(r, "miss", 3, 1))) {
                reuse = false;
            }
            k = k + 1;
        }
        check(c, "200 structural changes reuse independent module", reuse, "");
    }
}

function freshDir(prefix: string): string | Error {
    const base = osRealPath(tempDir());
    let k = 0;
    while (k < 1000) {
        const p = nat(join(base, prefix + toStr(monoNs() % 1000000000) + "-" + toStr(k)));
        if (kindOf(p) == 0) {
            makeDir(p)?;
            return p;
        }
        k = k + 1;
    }
    return err("建不了临时目录 " + prefix);
}

function main(argv: []string): int {
    let compiler = "";
    let work = "";
    let root = "";
    let only = "behavior,corpus,soak";
    let i = 0;
    while (i + 1 < len(argv)) {
        if (argv[i] == "--compiler") {
            compiler = argv[i + 1];
        } else if (argv[i] == "--work") {
            work = argv[i + 1];
        } else if (argv[i] == "--root") {
            root = argv[i + 1];
        } else if (argv[i] == "--only") {
            only = argv[i + 1];
        }
        i = i + 2;
    }
    if (len(compiler) == 0) {
        eprint("用法：taixu run --toolchain scripts/test_check_cache.tx --compiler <taixu> [--work <目录>] [--only behavior,corpus,soak]");
        return 2;
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    root = absolute(nat(root));
    compiler = absolute(nat(compiler));
    let ownWork = false;
    if (len(work) == 0) {
        work = freshDir("taixu-cache-") catch (e) {
            eprint(e.message);
            return 2;
        };
        ownWork = true;
    } else {
        work = absolute(nat(work));
        mkdirs(work);
    }
    const groups = strSplit(only, ",");
    const c = new Ctx { root: root, work: work, exe: nat(join(work, "probe/" + exeName("check-cache-probe"))), bad: 0 };
    const out = nat(join(work, "probe"));
    const b = captureRaw(compiler, strs(["build", "bootstrap/selfhost/check-cache-probe.tx", "--toolchain", "--leak-check", "--out", out]), root,
        600 * SEC, 10 * SEC, MAX_OUTPUT) catch (e) {
        check(c, "build --leak-check probe", false, e.message);
        return 1;
    };
    const both = bytesNew(0);
    bytesAppend(both, b.out);
    bytesAppend(both, b.err);
    writeFileBytes(nat(join(work, "build.log")), both) catch (e) {
        eprint("写不了 build.log：" + e.message);
    };
    let detail = "";
    if (b.code != 0) {
        detail = tailChars(lossyText(b.err), 1200);
        if (b.timedOut) {
            detail = "timeout " + detail;
        }
    }
    check(c, "build --leak-check probe", b.code == 0, detail);
    if (b.code != 0) {
        return 1;
    }
    if (inGroups(groups, "behavior")) {
        behavior(c);
    }
    if (inGroups(groups, "corpus")) {
        let target = 0;
        while (target < 2) {
            const rows = run(c, "corpus-" + toStr(target), nat(join(root, "examples/hello.tx")), corpus(c), target);
            target = target + 1;
        }
    }
    if (inGroups(groups, "soak")) {
        soak(c);
    }
    if (c.bad == 0) {
        print("SUMMARY PASS");
        if (ownWork) {
            deleteTree(work);
        }
        return 0;
    }
    print("SUMMARY FAIL=" + toStr(c.bad));
    if (ownWork) {
        eprint("工作目录保留在 " + work);
    }
    return 1;
}

function inGroups(groups: List<string>, g: string): bool {
    for (x in groups) {
        if (x == g) {
            return true;
        }
    }
    return false;
}
