import { x509VerifyServer } from "std/x509_verify";
import { p256Hex } from "std/crypto/p256_field";

function certificates(): List<Bytes> {
    const fixture = readFile("tests/vectors/x509.txt") catch panic("certificate fixture"); const out: List<Bytes> = listNew();
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const fields = strSplit(line, " "); if (listGet(fields, 0) == "good") { listPush(out, p256Hex(listGet(fields, 1))); }
    }
    return out;
}

function one(cert: Bytes): List<Bytes> { const out: List<Bytes> = listNew(); listPush(out, cert); return out; }
function rejected(chain: List<Bytes>, host: string, time: int, roots: List<Bytes>): bool {
    let fail = false; x509VerifyServer(chain, host, time, roots) catch (e) { fail = true; }; return fail;
}

test "Windows SSL：独占内存信任根与服务路径" {
    const certs = certificates(); const root = listGet(certs, 0); const leaf = listGet(certs, 1); const roots = one(root); const chain = one(leaf);
    x509VerifyServer(chain, "example.test", 1794456000, roots) catch (e) { panic(e.message); };
    listPush(chain, root);
    x509VerifyServer(chain, "EXAMPLE.TEST.", 1794456000, roots) catch (e) { panic(e.message); };
    assert(rejected(chain, "example.test", 1794456000, listNew()), "server-sent self root is not system trust");
    assert(rejected(chain, "example.test", 1794456000, one(listGet(certs, 2))), "explicit roots are exclusive");
}

test "Windows SSL：域名、时间、签名和输入约束拒绝" {
    const certs = certificates(); const root = listGet(certs, 0); const leaf = listGet(certs, 1); const roots = one(root); const chain = one(leaf);
    assert(rejected(chain, "other.test", 1794456000, roots), "wrong identity");
    assert(rejected(chain, "example.test", 0, roots), "not yet valid");
    assert(rejected(chain, "example.test", 2600000000, roots), "expired");
    const tampered = bytesSlice(leaf, 0, bytesLen(leaf)); const last = bytesLen(tampered) - 1;
    bytesSet(tampered, last, (bytesGet(tampered, last) catch 0) ^ 1);
    assert(rejected(one(tampered), "example.test", 1794456000, roots), "bad signature");
    assert(rejected(one(listGet(certs, 3)), "example.test", 1794456000, one(listGet(certs, 2))), "certificate without server SAN");
    assert(rejected(listNew(), "example.test", 1794456000, roots), "empty chain");
    assert(rejected(chain, "example.test", -11644473601, roots), "FILETIME range");
}
