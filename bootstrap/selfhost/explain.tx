// 诊断码与运行期码解释表（`taixu explain [码]`；去 Zig 第 6 轮 6a）。
// 输出格式同 Zig CLI 的 explain（`码 [域:名] 解释` 换行 `修复建议：…`）；码表按 D3 v0.23 刷新并补齐
// 3026–3034、3101、3102、4016–4020。编译器源码里出现的每个诊断码与 nrt.tx 的每个运行期码都须在表内
// （scripts/test-native-cli.py 的 explain 段检查）。

function row(rows: List<string>, code: int, domain: string, name: string, text: string, fix: string): void {
    listPush(rows, toStr(code) + "\t" + domain + "\t" + name + "\t" + text + "\t" + fix);
}

function explainRows(): List<string> {
    const r: List<string> = listNew();
    // —— 1xxx 词法 ——
    row(r, 1001, "lex", "illegal_char", "源码含未定义的字符", "反引号只用于模板串、单引号只用于字符字面量；@、# 等不是太虚的记号");
    row(r, 1002, "lex", "unterminated_string", "字符串、模板串、字符字面量或块注释未闭合", "补上收尾的引号或 */（普通字符串不能跨行）");
    row(r, 1003, "lex", "bad_escape", "转义序列非法", "字符串支持 \\n \\t \\r \\\\ \\\" \\0 \\u{XXXX}；模板串另有 \\` 与 \\$");
    row(r, 1004, "lex", "bad_number", "数字字面量格式或范围非法", "检查前缀（0x/0o/0b）、分隔符 _ 的位置与 64 位范围；超过 int 上限、不超过 2^64−1 的整数字面量只能用在期望 u64/usize 的位置");
    row(r, 1005, "lex", "bad_char_lit", "字符字面量无效", "'x' 为单字节字符（int 码点）；转义集 \\n \\t \\r \\\\ \\' \\0；空、多字符、多字节与 \\u{...} 均拒绝");
    // —— 2xxx 语法 ——
    row(r, 2001, "parse", "unexpected_token", "当前位置出现语法不期待的记号", "对照 D3 §5 产生式检查结构；常见：语句须以分号收束、比较不能连写");
    row(r, 2002, "parse", "expected_token", "缺少语法要求的记号", "按诊断中的期望补齐（如类型参数的 >、参数列表的 )）");
    row(r, 2003, "parse", "bare_literal_stmt", "裸字面量作为语句首记号（与块语法歧义）", "对象字面量需上下文类型（绑定、参数或括号包裹），或写类型名前缀 Point { ... }");
    // —— 3xxx 语义 ——
    row(r, 3001, "sema", "undefined_symbol", "引用了未声明的符号；或在不带 --toolchain 的构建里调用了工具链专用内建（runProcess、procSpawn、stdinRead、currentDir 等），或在标准库之外调用了 __rt 开头的内部内建", "检查拼写与 export（默认模块私有）；相对导入省略 .tx 扩展名；工具链专用内建只给编译器这类工具链程序用，构建时加 --toolchain（只能原生构建）；__rt 内建改用标准库的公开接口");
    row(r, 3002, "sema", "type_mismatch", "类型不匹配", "对照诊断中的期望与实际类型；数值类型之间用 as 转换（定宽类型只在无损方向自动扩宽），跨类型比较是错误");
    row(r, 3003, "sema", "duplicate_symbol", "同名重复声明", "重命名其一（没有重载）");
    row(r, 3004, "sema", "const_assignment", "对 const 的深层字段赋值", "const 对值类型深层冻结；需要可变字段用 Ref<T>（const 只锁重绑）或改 let");
    row(r, 3005, "sema", "discarded_failure", "失败值（T? / T | Error）作为语句被丢弃", "必须 ? 传播、catch 处理、绑定或传参（裸写 readFile(p); 是错误）");
    row(r, 3006, "sema", "channel_mismatch", "? 传播通道与函数返回类型不一致", "Error 传播要求返回 U | Error；None 传播要求 U?；跨通道先 catch 显式桥接");
    row(r, 3007, "sema", "not_exhaustive", "对 enum 的 switch 不穷尽", "覆盖全部变体或加 else => 臂");
    row(r, 3008, "link", "bad_import", "导入路径不存在、写法与磁盘不一致、导出符号缺失或导入形态不支持", "用 ./ ../ 相对路径、std/ 标准库路径或 gui/ GUI 框架路径（需 TAIXU_GUI_ROOT 或同级的 taixu-gui/src）；被导入符号需 export");
    row(r, 3009, "link", "cyclic_import", "模块循环导入", "抽出共享声明到第三个模块，打破环");
    row(r, 3010, "sema", "bad_main", "入口模块缺少 main", "提供 function main(args: []string): int（也可返回 int | Error）");
    row(r, 3011, "sema", "arity_mismatch", "实参个数不符", "对照函数签名与内建签名（如 assert(bool, string) 两参）");
    row(r, 3012, "sema", "missing_return", "非 void 函数存在未 return 的路径", "所有控制流路径 return 或经 ? 传播离开");
    row(r, 3013, "sema", "bad_cast", "as 转换不合法", "as 只用于数值类型之间（含定宽类型）；句柄与整数互转用 handleBits/handleFromBits；其余类型没有 as");
    row(r, 3014, "sema", "condition_not_bool", "条件不是 bool", "没有真值转换；写显式比较（len(s) > 0 而非 len(s)）");
    row(r, 3015, "sema", "unknown_field", "字段不存在或访问目标不是 struct、enum 或 Error", "检查字段拼写；Error 有 message 与 cause；方法语法按约定名查找同名函数");
    row(r, 3016, "sema", "bad_lvalue", "赋值目标不是名字起头的后缀链", "只能对绑定、字段、元素赋值；表达式的结果不能被赋值");
    row(r, 3017, "sema", "struct_literal_arity", "struct 字面量字段数不符", "字段必须全量初始化（缺字段与多字段都是错误）");
    row(r, 3018, "sema", "arm_type_mismatch", "switch 各臂类型不一致", "switch 是表达式：全部臂的类型必须一致");
    row(r, 3019, "sema", "variant_not_found", "enum 变体不存在或字段不符", "构造用限定名 Expr.Add(l, r)；无字段变体不加括号");
    row(r, 3020, "sema", "bad_type_expr", "类型表达式非法", "检查嵌套规则：Ref 不能套 Ref、可选不能嵌套、数组长度 1..65535、联合右侧只能是 Error 或错误 enum");
    row(r, 3021, "sema", "immutable_binding", "对不可变绑定重新赋值", "const 绑定不可重绑（Ref 的堆对象字段仍可变）；需要重绑用 let");
    row(r, 3022, "sema", "not_iterable", "for-in 目标类型不可迭代", "可迭代：List、string（按字节）、数组、切片、Map 与 Set、Gen；双变量只用于 Map；其余改用计数循环");
    row(r, 3023, "sema", "closure_capture_readonly", "闭包捕获的外部名字在闭包体内被赋值（捕获为值快照、只读）", "捕获值快照不可回写；需要可变状态改用 Ref<T> 的堆对象字段");
    row(r, 3024, "sema", "await_outside_async", "await 出现在 async 上下文之外，或出现在 defer、生成器体内", "把所在函数改为 async function 或 async 箭头；defer 与生成器体内不能 await");
    row(r, 3025, "sema", "bad_await", "await 操作数须为 Future<T>", "只 await async 函数或 async 箭头的调用结果；await 产出 T | Error，照常 ?/catch 处理");
    row(r, 3026, "sema", "bad_defer", "defer 用法不合法", "defer 体内不能 return、不能用 break/continue 跳出、不能 ?、不能 await；可能失败的调用在体内 catch");
    row(r, 3027, "sema", "bad_error_enum", "错误 enum 的声明或构造不合法", "每个变体都要带消息（字面量，或只插值本变体字段的模板串）；错误 enum 不能用 new，构造写 E.V(…)");
    row(r, 3028, "sema", "bad_failure_union", "失败联合的组成或失败侧的传播不合法", "T | E 的 E 须为 Error 或错误 enum，T 不能是错误、可选或失败联合；? 只允许同种传播或放宽为 Error；async 函数的失败侧只能是 Error");
    row(r, 3029, "sema", "bad_err_as", "errAs 的类型实参不合法", "写 errAs<E>(e)：类型实参必须显式写出且为错误 enum");
    row(r, 3030, "sema", "constraint_unmet", "类型不满足接口或泛型约束，或接口值用法不合法", "按诊断补齐缺少的方法或改正签名（实现函数名为类型名小写开头加方法名）；接口值不能 ==、switch、取字段或再包 Ref/Weak");
    row(r, 3031, "sema", "constrained_template", "带约束的泛型模板体使用了约束之外的操作", "对类型参数只能调用约束接口里的方法，以及赋值、传参、存储与 ==");
    row(r, 3032, "sema", "bad_generator", "生成器规则不满足", "元素类型不能是 void、可选、失败联合、Error 或错误 enum；yield 只作语句、只能直接写在生成器体内；生成器体内不能 ?、带值 return、直接调用 taskAwaitAny；Gen 不能 ==");
    row(r, 3033, "sema", "bad_ffi", "外部函数（FFI）的声明、封送、目标或按目标文件不合法", "模块级 declare function 必须带 from；无 from 的宿主声明已退场；签名只用封送类型（定宽数值、bool、string（UTF-8 C 串，原 cstr 已并入）/wstr、Bytes、句柄、Ref<外部结构体>、回调）；C 变参函数的变参写成 ...名: 类型（常见 C 变参函数的定参个数须与 C 原型一致），from syscall 不能有变参；带 from 的外部函数不能 export；按目标文件（x_<系统>_<架构>、x_<系统>、类 Unix 的 x_unix、x）的导出面须一致，可没有同名基础文件；wstr 只用于 Windows，from syscall 只用于 Linux（macOS 经 from \"libSystem\"）；--static 时不能调用 from \"库\"");
    row(r, 3034, "sema", "fixed_width", "定宽数值的用法不合法：字面量越界、两侧没有公共类型、无符号取负，或使用了保留的类型名", "字面量须在类型范围内；两侧没有能无损容纳的公共类型（如 u64 与有符号类型）时先用 as 显式转换；无符号取补码写 wrapSub<T>(0, x)；i8…u64 与 i/u 后接数字的名字不能作类型名");
    row(r, 3035, "sema", "not_sendable", "值不能跨线程发送：线程函数的捕获或结果含有绑定在本线程上的成分（Weak、Future、Gen、Thread、平台句柄；Atomic 只能经 Shared 跨线程），或线程函数有参数、是 async 函数或生成器；sharedNew 的实参不可共享（同上，但允许 Atomic）", "threadSpawn 的实参是无参、非 async 的函数值；捕获与结果经深拷贝跨线程，报错指出的成分换成可发送的数据（例如句柄留在原线程、只发送数据）；Atomic 放进 sharedNew 的对象图再发送 Shared 句柄。函数值、接口值可以发送，它们的捕获与具体类型在发送时核对（运行期 4021）");
    row(r, 3100, "codegen", "jump_offset_overflow", "跳转偏移超界：单函数指令数超出跳转编码域（±2^31）", "把超大循环体或函数体拆成多个函数");
    row(r, 3101, "codegen", "operand_overflow", "中间码操作数超出编码范围：单函数寄存器超过 65535 个（局部槽、临时槽或调用参数过多）、字段号超过 32767、常量或外部函数过多，或闭包值调用链使帧过大", "拆分函数，减少单个函数里的局部变量、参数与字面量；大块数据移到数据文件");
    row(r, 3102, "codegen", "embed_failed", "embedBytes 读不到文件或文件超过 64MB", "路径相对当前源文件；确认文件存在且不超过 64MB");
    // —— 4xxx 运行期 ——
    row(r, 4001, "runtime", "div_by_zero", "除数为零", "先检查除数，或让函数返回 T | Error 并用 err(...) 表达可恢复失败");
    row(r, 4002, "runtime", "out_of_bounds", "数组、切片或列表索引越界", "先用 len/listLen 检查边界");
    row(r, 4003, "runtime", "stack_overflow", "调用栈或值槽栈深度超限", "检查无限递归；深递归改写为循环");
    row(r, 4004, "runtime", "int_overflow", "整数算术溢出（int 与定宽整数，消息写明类型）", "检查值域、换更宽的类型或拆分计算；需要环绕语义时显式用 wrapAdd/wrapSub/wrapMul（int 也可用 imul）");
    row(r, 4005, "runtime", "f2i_overflow", "浮点转整数越界或为 NaN", "先检查值域再 as");
    row(r, 4006, "runtime", "bad_opcode", "未定义的操作码或损坏的产物", "重新编译；持续出现请回报");
    row(r, 4007, "runtime", "resource_depth", "值克隆或比较的嵌套深度超限", "嵌套值过深（上限 1024）；改经 Ref 间接");
    row(r, 4008, "runtime", "panicked", "panic 主动触发", "panic 为不可恢复退出；可恢复失败用 T | Error 加 err(...)");
    row(r, 4009, "runtime", "assert_failed", "assert 断言失败", "检查断言条件与消息中的应然描述");
    row(r, 4010, "runtime", "bad_type", "运行期类型不符合指令期待；或内建的实参在运行期不合法：工具链进程句柄已 procClose、从未有效或属于别的线程，流号、选项位或 ioWait 的来源位不对，listAsBytes 的列表不是紧凑的 List<u8>", "trap 的消息写明了是哪一种：进程句柄只在创建它的线程里用、procClose 之后不再用，流号与位集合按 D3 §7 的表；不属于这些情况的通常是编译器缺陷——请回报并附源码");
    row(r, 4011, "runtime", "not_exhaustive", "switch 跳转表未覆盖该变体", "同 3007；若源码已穷尽则是编译器缺陷，请回报");
    row(r, 4012, "runtime", "corrupt_code", "产物结构损坏，或运行期状态损坏（如引用计数下溢：对象被多释放了一次）", "重新编译；持续出现请回报。运行期状态损坏是运行时或编译器的缺陷，正常代码不会触发——请附源码回报");
    row(r, 4013, "runtime", "extern", "宿主 extern 函数未注册（不带 from 的 declare function；原生产物不提供宿主 extern）", "原生产物改用 from \"库\"／from syscall 的外部函数，或用标准库；当前编译器在语义阶段以 3033 拒绝宿主 extern");
    row(r, 4014, "runtime", "sched_deadlock", "调度泵没有进展且仍有未决任务", "检查任务依赖环：await 的 Future 永不完成；超时用 std/task 的 timeout 包装");
    row(r, 4015, "runtime", "exit_pending", "main 结束时仍有未决任务", "退出前 await 或收割全部任务，或显式 taskCancel");
    row(r, 4016, "runtime", "shift_count", "移位计数不在 0..宽度−1（int 为 0..63）", "先检查计数（太虚不做 JS 式的计数掩码）");
    row(r, 4017, "runtime", "gen_running", "生成器运行中再对它取值或关闭", "生成器体内不要直接或间接对自身取值");
    row(r, 4018, "runtime", "narrow_range", "as 收窄越界", "先检查范围；需要取低位时用 wrapTo<T>(x)");
    row(r, 4019, "runtime", "ffi_arg", "外部函数的 string/wstr 实参含 NUL 字节", "C 字符串遇 NUL 即截断；先检查，或改用 Bytes 加长度");
    row(r, 4020, "runtime", "ffi_callback", "回调不在外部函数调用期间、或不在太虚运行时所在的线程上被调用", "回调只能在本线程的那次外部调用期间被调用（如 qsort 的比较函数、EnumWindows）");
    row(r, 4022, "runtime", "frozen_write", "写入了冻结的对象：Shared 里的对象图深度不可变，取出后任何写操作（字段赋值、下标赋值、listPush／listSet 等、bytesSet 等，以及 stdinRead、procRead 读入冻结的 Bytes，把冻结的 Bytes 或冻结的外部结构体 Ref 交给外部函数或系统调用）都会 trap", "要改就先拷一份（例如把要改的部分重新构造成新对象），或把可变状态放进 Atomic<int>（以后的 Mutex<T>）；Shared 只放建成后不再改的数据");
    row(r, 4024, "runtime", "ffi_buffer_borrow", "外部函数调用期间，回调经 Bytes 或其 List<u8> 别名改变了仍被 C 借用的缓冲区的长度（bytesPush、非空的 bytesAppend、listPush、listInsert、非空表的 listPop、listRemoveAt），与当时的容量无关", "借用期内只做原地读写（bytesGet／bytesSet／listGet／listSet）；要增减长度就改用独立的缓冲，或等外部调用返回后再改。冻结的 Bytes 仍拒绝交给 C；C 在返回后保留指针不在安全契约之内");
    row(r, 4023, "runtime", "leak", "--leak-check 构建的程序退出时仍有对象存活：强引用成环（结构体、List、闭包互相持有），或运行期少放了计数；报告按种类与分配位置汇总，退出码 23", "把反向的引用（子指向父、观察者指回主体）改成 Weak<T>，或在退出前把环断开（字段置 None、清空 List）；位置指向标准库或 prelude 内部时看调用它的那一行");
    row(r, 4021, "runtime", "unsendable", "发送或共享的数据含不可发送的成分：经函数值（闭包的捕获）或接口值（装入的具体类型）带入的 Weak、Future、Gen、Thread 或平台句柄，发送时还有 Atomic——编译期看不到这两种值里装的东西，threadSpawn、线程结果与 sharedNew 按类型号表核对", "不要把捕获了这些成分的闭包、装着这类值的接口值发给别的线程；句柄、Weak 留在原线程，只发送数据；Atomic 经 sharedNew 共享");
    return r;
}

function fields(rowText: string): List<string> {
    return strSplit(rowText, "\t");
}

function head(f: List<string>): string {
    return (listGet(f, 0) catch "") + " [" + (listGet(f, 1) catch "") + ":" + (listGet(f, 2) catch "") + "] " + (listGet(f, 3) catch "");
}

// 码的十进制文本（去前导零）；不是 1 到 9 位的数字返回 ""（同 Zig CLI 按 u32 解析）。
function codeText(arg: string): string {
    if (len(arg) == 0 || len(arg) > 9) { return ""; }
    let v = 0;
    let i = 0;
    while (i < len(arg)) {
        const c = byteAt(arg, i) catch 0;
        if (c < 48 || c > 57) { return ""; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return toStr(v);
}

// 运行期错误名（trap 行 `[runtime:名]`）对应的码；不在表内得 0。
export function runtimeCodeOf(name: string): int {
    for (r in explainRows()) {
        const f = fields(r);
        if ((listGet(f, 1) catch "") == "runtime" && (listGet(f, 2) catch "") == name) {
            const t = listGet(f, 0) catch "";
            let v = 0;
            let i = 0;
            while (i < len(t)) {
                v = v * 10 + ((byteAt(t, i) catch 48) - 48);
                i = i + 1;
            }
            return v;
        }
    }
    return 0;
}

// `taixu explain`：无参数列出全表；一个参数给出该码的解释与修复建议；未知码 stderr 报错、退出 64。
export function explainCommand(args: []string): int {
    const rows = explainRows();
    if (len(args) == 1) {
        for (r in rows) { print(head(fields(r))); }
        return 0;
    }
    if (len(args) != 2) {
        eprint("用法: taixu explain [诊断码]");
        return 64;
    }
    const code = codeText(args[1]);
    if (code == "") {
        eprint("taixu: explain 需要数字诊断码（如 3005；无参数列出全表）");
        return 64;
    }
    for (r in rows) {
        const f = fields(r);
        if ((listGet(f, 0) catch "") == code) {
            print(head(f));
            print("修复建议：" + (listGet(f, 4) catch ""));
            return 0;
        }
    }
    eprint("taixu: 未知诊断码 " + code + "（1xxx 词法 / 2xxx 语法 / 3xxx 语义 / 4xxx 运行时；无参数列出全表）");
    return 64;
}
