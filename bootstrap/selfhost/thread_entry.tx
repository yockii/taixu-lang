// 线程入口蹦床的架构层（目标分层 X3b）：pthread 按各架构的 C 约定调用
// __tx_thread_entry，第一个实参＝线程记录（同私有约定的第一个实参）；Linux 静态产物经 clone 起的线程不经这里（各 Linux 组合
// 文件的 __tx_thread_clone）。外壳保存 C 约定要求被调方保存、而 __tx_thread_main 会改写的寄存器后调用，返回 0／NULL。
// 同一架构的各系统共用一个外壳；Windows 的线程入口带帧事件，在各自的组合文件里（windows_x64.tx、windows_a64.tx）。
import { Operand, StructuredBuffer, asBufferLabel, asBufferInstruction, asBufferBoundaryBegin, asBufferFunctionEnd, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget } from "./assemble";
import { a64Emit, a64B, a64Mem, a64MovImm } from "./a64_asm";
import { a64AddSubImm, a64LdStPair, a64BranchReg } from "./a64_encode";
import { la64Emit, la64B, la64MovImm } from "./la64_asm";
import { la64Si12, la64Jirl, LA64_ADDI_D, LA64_LD_D, LA64_ST_D } from "./la64_encode";
import { rv64Emit, rv64Br, rv64MovImm, rv64Mem } from "./rv64_asm";
import { rv64I, RV64_ADDI, RV64_LD, RV64_SD, RV64_JALR } from "./rv64_encode";

const MODULE: string = "bootstrap/selfhost/thread_entry.tx";

function ins(b: Ref<StructuredBuffer>, mn: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void {
    asBufferInstruction(b, mn, n, a, c, asStructuredMissing(), 1);
}
function r64(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function r32(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function none(): Ref<Operand> { return asStructuredMissing(); }

/// x86_64 SysV（Linux、macOS）：rdi＝记录，转成私有约定的 rcx；保存 rbx 后调用。入口 rsp≡8，push 后 sub 32 使调用点 16 对齐。
export function x64SysvThreadEntry(b: Ref<StructuredBuffer>): void {
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_entry", "thread-entry");
    asBufferLabel(b, "__tx_thread_entry", 1);
    ins(b, "push", 1, r64(3), none());
    ins(b, "mov", 2, r64(1), r64(7));
    ins(b, "sub", 2, r64(4), asStructuredImm(32));
    ins(b, "call", 1, asStructuredTarget("__tx_thread_main"), none());
    ins(b, "add", 2, r64(4), asStructuredImm(32));
    ins(b, "pop", 1, r64(3), none());
    ins(b, "xor", 2, r32(0), r32(0));
    ins(b, "ret", 0, none(), none());
    asBufferFunctionEnd(b);
}

/// A64 AAPCS（Linux、macOS）：x0＝记录，存帧记录与 x19（__tx_thread_main 把它设为本线程的值槽窗口）
/// 后调用，返回 NULL。
export function a64ThreadEntry(b: Ref<StructuredBuffer>): void {
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_entry", "thread-entry");
    asBufferLabel(b, "__tx_thread_entry", 1);
    a64Emit(b, a64LdStPair(2, 0, 0, 29, 30, 31, -32, 3), "stp x29, x30, [sp, #-32]!");
    a64Emit(b, a64AddSubImm(1, 0, 0, 29, 31, 0, 0), "mov x29, sp");
    a64Mem(b, 3, 0, 19, 31, 16);
    a64B(b, 1, "__tx_thread_main");
    a64Mem(b, 3, 1, 19, 31, 16);
    a64Emit(b, a64LdStPair(2, 0, 1, 29, 30, 31, 32, 1), "ldp x29, x30, [sp], #32");
    a64MovImm(b, 0, 0);
    a64Emit(b, a64BranchReg(2, 30), "ret");
    asBufferFunctionEnd(b);
}

/// 龙芯 LP64D：a0＝记录，存 ra、fp 与 s0（值槽窗口）后调用，返回 NULL。帧记录同 rtfn：fp 指向 [旧 fp, ra] 这一对。
export function la64ThreadEntry(b: Ref<StructuredBuffer>): void {
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_entry", "thread-entry");
    asBufferLabel(b, "__tx_thread_entry", 1);
    la64Emit(b, la64Si12(LA64_ADDI_D, 3, 3, -32), "addi.d sp, sp, -32");
    la64Emit(b, la64Si12(LA64_ST_D, 1, 3, 24), "st.d ra, sp, 24");
    la64Emit(b, la64Si12(LA64_ST_D, 22, 3, 16), "st.d fp, sp, 16");
    // fp 为进入时的 sp（帧记录在 fp−16、fp−8，psABI 的约定）。
    la64Emit(b, la64Si12(LA64_ADDI_D, 22, 3, 32), "addi.d fp, sp, 32");
    la64Emit(b, la64Si12(LA64_ST_D, 23, 3, 8), "st.d s0, sp, 8");
    la64B(b, 1, "__tx_thread_main");
    la64Emit(b, la64Si12(LA64_LD_D, 23, 3, 8), "ld.d s0, sp, 8");
    la64Emit(b, la64Si12(LA64_LD_D, 22, 3, 16), "ld.d fp, sp, 16");
    la64Emit(b, la64Si12(LA64_LD_D, 1, 3, 24), "ld.d ra, sp, 24");
    la64Emit(b, la64Si12(LA64_ADDI_D, 3, 3, 32), "addi.d sp, sp, 32");
    la64MovImm(b, 4, 0);
    la64Emit(b, la64Jirl(0, 1, 0), "ret");
    asBufferFunctionEnd(b);
}

/// RISC-V LP64D：同龙芯，帧记录在进入时的 sp 下方（s0＝进入时的 sp），另存值槽窗口 s1。
export function rv64ThreadEntry(b: Ref<StructuredBuffer>): void {
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_entry", "thread-entry");
    asBufferLabel(b, "__tx_thread_entry", 1);
    rv64Emit(b, rv64I(RV64_ADDI, 2, 2, -32), "addi sp, sp, -32");
    rv64Mem(b, RV64_SD, 1, 2, 24);
    rv64Mem(b, RV64_SD, 8, 2, 16);
    rv64Emit(b, rv64I(RV64_ADDI, 8, 2, 32), "addi s0, sp, 32");
    rv64Mem(b, RV64_SD, 9, 2, 8);
    rv64Br(b, 1, "__tx_thread_main");
    rv64Mem(b, RV64_LD, 9, 2, 8);
    rv64Mem(b, RV64_LD, 8, 2, 16);
    rv64Mem(b, RV64_LD, 1, 2, 24);
    rv64Emit(b, rv64I(RV64_ADDI, 2, 2, 32), "addi sp, sp, 32");
    rv64MovImm(b, 10, 0);
    rv64Emit(b, rv64I(RV64_JALR, 0, 1, 0), "ret");
    asBufferFunctionEnd(b);
}
