// D3 v0.22：生成器不能失败——体内不能用 ? 传播、return 不能带值、不能直接调用 taskAwaitAny（3032）；
// 不能 await（3024）；Gen 不可比较（3032）。可能失败的调用用 catch 就地处理。
function parse(s: string): int | Error {
    if (s == "") { return err("empty"); }
    return len(s);
}

function* lengths(xs: List< string>, fs: List< Future< int>>, f: Future< int>): int {
    for (x in xs) {
        yield parse(x)?;
    }
    const first = taskAwaitAny(fs) catch -1;
    const v = await f catch -1;
    return 0;
}

export function main(args: []string): int {
    const xs: List< string> = listNew();
    const fs: List< Future< int>> = listNew();
    return 0;
}
