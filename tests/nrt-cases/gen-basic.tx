// D3 v0.22：生成器 function* / yield / Gen<T>。调用只建生成器、不执行函数体；genNext 取下一个
// 产出值，取完得 None 且之后恒为 None；for-in 逐个取值；g.next() 与 genNext(g) 同义。
// 生成器函数的类型就是普通函数类型 (参数) => Gen<T>，经函数值调用同样创建生成器。

function* range(from: int, to: int): int {
    print("range start " + toStr(from));
    let i = from;
    while (i < to) {
        yield i;
        i = i + 1;
    }
    print("range end");
}

function* words(text: string): string {
    const parts = strSplit(text, " ");
    for (w in parts) {
        if (w == "stop") {
            return;
        }
        yield w + "!";
    }
}

function* empty(): int {
    print("empty body runs");
}

// 生成器里迭代别的生成器。
function* squares(n: int): int {
    for (x in range(0, n)) {
        yield x * x;
    }
}

struct Point {
    x: int,
    y: int,
}

// 值类型元素：产出的是拷贝，生成器之后改自己的局部不影响已取出的值。
function* points(): Point {
    let p = Point { x: 1, y: 2 };
    yield p;
    p.x = 10;
    yield p;
}

function* pick<T>(xs: List< T>, every: int): T {
    let i = 0;
    while (i < listLen(xs)) {
        yield listGet(xs, i) catch panic("unreachable");
        i = i + every;
    }
}

function sum(g: Gen< int>): int {
    let total = 0;
    for (x in g) {
        total = total + x;
    }
    return total;
}

export function main(args: []string): int {
    const g = range(1, 4);
    print("created");
    print(toStr(genNext(g) catch -1));
    print(toStr(g.next() catch -1));
    print(toStr(genNext(g) catch -1));
    print(toStr(genNext(g) catch -1));
    print(toStr(genNext(g) catch -1));

    for (w in words("a b stop c")) {
        print(w);
    }
    const e = empty();
    print("empty created");
    if (genNext(e) == None) { print("empty done"); }
    if (genNext(e) == None) { print("empty still done"); }

    print("sum " + toStr(sum(squares(5))));

    let line = "";
    for (p in points()) {
        line = line + "(" + toStr(p.x) + "," + toStr(p.y) + ")";
    }
    print(line);

    const names: List< string> = listNew();
    listPush(names, "ann");
    listPush(names, "bob");
    listPush(names, "cid");
    listPush(names, "dan");
    for (n in pick(names, 2)) {
        print("pick " + n);
    }

    const maker: (int, int) => Gen< int> = range;
    print("via fn value " + toStr(sum(maker(10, 12))));

    // 生成器存进 List，交替取值。
    const gens: List< Gen< int>> = listNew();
    listPush(gens, range(100, 102));
    listPush(gens, range(200, 203));
    let round = 0;
    while (round < 4) {
        let k = 0;
        while (k < listLen(gens)) {
            const gk = listGet(gens, k) catch panic("unreachable");
            const v = genNext(gk);
            if (v != None) { print("round " + toStr(round) + ": " + toStr(v catch -1)); }
            k = k + 1;
        }
        round = round + 1;
    }
    return 0;
}
