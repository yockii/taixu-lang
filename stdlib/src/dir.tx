// ============================================================================
// std/dir —— 目录创建递归层（D3 v0.17 makeDir 之上；LANG-18）。
//
// makeDir 内建只建单层且对已存在的目录幂等；本模块按 `/` 与 `\` 逐级前缀
// 调用它，得到 mkdir -p 语义。纯 .tx、无宿主 extern——原生运行时（NRT）
// 产物可直接使用。std/fs 的 fsMkdirs 经平台层（第 5 轮起原生也可用），本模块只依赖内建。
// ============================================================================

// makeDirAll：逐级创建 path 的全部缺失目录；已存在的目录视为成功。
// 盘符前缀（如 `C:`）与开头的分隔符不单独创建；任一级失败即返回该级 Error。
// `\` 一律按分隔符处理（Windows 路径形）；POSIX 上名字本身含 `\` 的路径不受支持。
export function makeDirAll(path: string): void | Error {
    if (len(path) == 0) {
        return makeDir(path);
    }
    let i: int = 1;
    while (i < len(path)) {
        const c = byteAt(path, i) catch 0;
        if (c == 47 || c == 92) {
            const prev = byteAt(path, i - 1) catch 0;
            if (prev != 58 && prev != 47 && prev != 92) {
                makeDir(strBytePrefix(path, i))?;
            }
        }
        i = i + 1;
    }
    return makeDir(path);
}

// 前 n 字节（分隔符均为 ASCII，前缀恒落在码点边界上）。
function strBytePrefix(s: string, n: int): string {
    let cps: int = 0;
    let at: int = 0;
    while (at < n) {
        const lead = byteAt(s, at) catch 0;
        if (lead >= 240) { at = at + 4; }
        else if (lead >= 224) { at = at + 3; }
        else if (lead >= 192) { at = at + 2; }
        else { at = at + 1; }
        cps = cps + 1;
    }
    return strSub(s, 0, cps);
}
