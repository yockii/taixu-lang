// 07 闭包与函数类型：唯一箭头形式、捕获＝值快照、fn 类型字段直调、事件订阅。
import { EventRecord, listenersNew, on, off, dispatch } from "std/events";

struct Counter {
    hits: int,
}

struct Button {
    id: int,
    onClick: (int) => string, // 函数类型字段：存回调
}

function makeAdder(n: int): (int) => int {
    return (x: int): int => x + n; // 捕获形参 n（值快照；闭包体内只读）
}

function main(args: []string): int {
    const add10 = makeAdder(10);
    print("add10:" + toStr(add10(5)));

    // 要可变共享状态 → 捕获 Ref（共享句柄，字段可变）
    const c: Ref<Counter> = new Counter { hits: 0 };
    const btn = new Button {
        id: 7,
        onClick: (t: int): string => {
            c.hits = c.hits + 1;
            return "clicked:" + toStr(t) + " hits=" + toStr(c.hits);
        },
    };
    print(btn.onClick(7));
    print(btn.onClick(8));

    // std/events：handler 即闭包；同一 target 按注册序派发
    const table = listenersNew();
    const log: List<string> = listNew();
    const first = (e: EventRecord): void => {
        log.push("first x=" + toStr(e.x));
    };
    const second = (e: EventRecord): void => {
        log.push("second x=" + toStr(e.x));
    };
    const token = on(table, 1, first);
    on(table, 1, second);
    const n = dispatch(table, { kind: 0, target: 1, x: 5, y: 0, mods: 0 });
    off(table, token); // 注销 first
    dispatch(table, { kind: 0, target: 1, x: 6, y: 0, mods: 0 });
    print("dispatched:" + toStr(n));
    for (line in log) {
        print(line);
    }
    return 0;
}
