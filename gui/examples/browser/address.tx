// Bounded Unicode address editing, separate from window/clipboard operations.
import { Input, inputSelLo, inputSelHi, inputDeleteSelection, inputBackspace } from "gui/components";

function next(text: string, at: int): int { const c = byteAt(text, at); if (c < 128) { return at + 1; } if (c < 224) { return at + 2; } if (c < 240) { return at + 3; } return at + 4; }
function valid(text: string): bool {
    if (len(text) > 4096) { return false; } let i = 0;
    while (i < len(text)) { const b = byteAt(text, i); if (b < 32 || b == 127) { return false; } i = i + 1; } return true;
}
export function addressPrefix(input: Ref<Input>, end: int): string {
    let out = ""; let i = 0; while (i < end && i < listLen(input.chars)) { out = out + listGet(input.chars, i); i = i + 1; } return out;
}
export function addressSelection(input: Ref<Input>): string {
    const lo = inputSelLo(input); const hi = inputSelHi(input); if (lo < 0) { return ""; }
    let out = ""; let i = lo; while (i < hi) { out = out + listGet(input.chars, i); i = i + 1; } return out;
}
export function addressInsert(input: Ref<Input>, text: string): bool {
    if (!valid(text)) { return false; } let lo = inputSelLo(input); let hi = inputSelHi(input);
    if (lo < 0) { lo = input.cursor; hi = input.cursor; }
    let bytes = len(text); let i = 0;
    while (i < listLen(input.chars)) { if (i < lo || i >= hi) { bytes = bytes + len(listGet(input.chars, i)); } i = i + 1; }
    if (bytes > 4096) { return false; }
    const fresh: List<string> = listNew(); i = 0;
    while (i < lo) { listPush(fresh, listGet(input.chars, i)); i = i + 1; }
    let at = 0; while (at < len(text)) { const end = next(text, at); listPush(fresh, strSlice(text, at, end)); at = end; }
    const cursor = listLen(fresh); i = hi;
    while (i < listLen(input.chars)) { listPush(fresh, listGet(input.chars, i)); i = i + 1; }
    input.chars = fresh; input.cursor = cursor; input.anchor = -1; input.select = false; return true;
}
export function addressSet(input: Ref<Input>, text: string): bool {
    if (!valid(text)) { return false; } input.anchor = 0; input.cursor = listLen(input.chars); return addressInsert(input, text);
}
export function addressSelectAll(input: Ref<Input>): void { input.anchor = 0; input.cursor = listLen(input.chars); input.select = false; }
export function addressMove(input: Ref<Input>, key: int, shift: bool): void {
    if (shift && input.anchor < 0) { input.anchor = input.cursor; }
    if (key == 36) { input.cursor = 0; } else if (key == 35) { input.cursor = listLen(input.chars); }
    else if (key == 37 && input.cursor > 0) { input.cursor = input.cursor - 1; }
    else if (key == 39 && input.cursor < listLen(input.chars)) { input.cursor = input.cursor + 1; }
    if (!shift) { input.anchor = -1; } input.select = false;
}
export function addressDelete(input: Ref<Input>, backward: bool, word: bool): void {
    if (inputDeleteSelection(input)) { return; }
    if (backward && !word) { inputBackspace(input); return; }
    if (backward) {
        const end = input.cursor; let start = end;
        while (start > 0 && listGet(input.chars, start - 1) == " ") { start = start - 1; }
        while (start > 0) {
            const ch = listGet(input.chars, start - 1); const b = byteAt(ch, 0);
            if (len(ch) == 1 && !((b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95)) { if (start == end) { start = start - 1; } break; } start = start - 1;
        }
        input.anchor = start; inputDeleteSelection(input); return;
    }
    if (input.cursor < listLen(input.chars)) { input.anchor = input.cursor + 1; inputDeleteSelection(input); }
}
// Binary search measured prefixes, keeping long URL hit tests bounded by O(n log n).
export function addressCaretAt(input: Ref<Input>, x: int, measure: (string) => int): int {
    let low = 0; let high = listLen(input.chars);
    while (low < high) { const middle = (low + high + 1) / 2; if (measure(addressPrefix(input, middle)) <= x) { low = middle; } else { high = middle - 1; } } return low;
}
