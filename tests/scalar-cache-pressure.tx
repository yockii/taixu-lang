function stress(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) {
        const a = sum + 1; const b = sum + 2; const c = sum + 3; const d = sum + 4; const e = sum + 5;
        const f = sum + 6; const g = sum + 7; const h = sum + 8; const j = sum + 9; const k = sum + 10;
        sum = (a + b + c + d + e + f + g + h + j + k) % 1000003;
        i = i + 1;
    }
    return sum;
}
function main(args: []string): int {
    print(toStr(stress(0))); print(toStr(stress(1))); print(toStr(stress(37))); return 0;
}
