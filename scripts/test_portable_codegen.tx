// 可移植渲染器的对照（gate.tx 的 portable-codegen 步）：同一编译器把语料各编两遍——缺省渲染器（emitmirror）与
// --codegen=portable（arm64 后端用的同一份渲染逻辑，此处落地为 x86_64）——各跑一遍（语料运行器 scripts/test_nrt_products.tx），可选再跑
// --leak-check 与 --debug 两种；每个用例的结果须相同（通过、失败、跳过、编译期拒绝一一对应）。门里用 --standard-normal／--standard-leak／
// --standard-debug 复用 products、leak、instrumented 三步已有的报告，标准语料不重跑。
// 运行（仓根）：taixu run --toolchain scripts/test_portable_codegen.tx --compiler <taixu> --work <目录> [--leak-check] [--debug]
//   [--standard-normal <报告>] [--standard-leak <报告>] [--standard-debug <报告>] [--root <仓库>] [用例…]
// 每遍语料至多 6 小时（语料运行器另外逐例限时）。
import { absolute, join, kindOf, mkdirs, nat } from "./build_lib";
import { osRealPath } from "./build_os";
import { Rows, loadRows, runCorpus } from "./test_corpus";
import { headChars, sorted } from "./test_text";

struct Opts {
    compiler: string,
    work: string,
    root: string,
    leak: bool,
    debug: bool,
    normal: string,
    leakReport: string,
    debugReport: string,
    cases: List<string>,
}

function parse(argv: []string): Ref<Opts> | Error {
    const o = new Opts { compiler: "", work: "", root: "", leak: false, debug: false, normal: "", leakReport: "", debugReport: "", cases: listNew() };
    let i = 0;
    while (i < len(argv)) {
        const a = argv[i];
        if (a == "--leak-check") {
            o.leak = true;
            i = i + 1;
            continue;
        }
        if (a == "--debug") {
            o.debug = true;
            i = i + 1;
            continue;
        }
        if (len(a) < 2 || (byteAt(a, 0) ?? 0) != 45 || (byteAt(a, 1) ?? 0) != 45) {
            listPush(o.cases, a);
            i = i + 1;
            continue;
        }
        if (i + 1 >= len(argv)) {
            return err(a + " 缺值");
        }
        const v = argv[i + 1];
        if (a == "--compiler") {
            o.compiler = v;
        } else if (a == "--work") {
            o.work = v;
        } else if (a == "--root") {
            o.root = v;
        } else if (a == "--standard-normal") {
            o.normal = v;
        } else if (a == "--standard-leak") {
            o.leakReport = v;
        } else if (a == "--standard-debug") {
            o.debugReport = v;
        } else {
            return err("未知参数：" + a);
        }
        i = i + 2;
    }
    if (len(o.compiler) == 0 || len(o.work) == 0) {
        return err("用法：taixu run --toolchain scripts/test_portable_codegen.tx --compiler <taixu> --work <目录> [--leak-check] [--debug] "
            + "[--standard-normal|--standard-leak|--standard-debug <报告>] [--root <仓库>] [用例…]");
    }
    return o;
}

// 跑一遍语料：label 为 standard 或 portable，tag 为 normal、leak-check 或 debug。
function corpus(o: Ref<Opts>, label: string, tag: string, extra: List<string>): Ref<Rows> | Error {
    const report = nat(join(o.work, label + "-" + tag + ".json"));
    const args: List<string> = listNew();
    for (x in extra) {
        listPush(args, x);
    }
    if (tag != "normal") {
        listPush(args, "--" + tag);
    }
    for (c in o.cases) {
        listPush(args, c);
    }
    runCorpus(o.compiler, o.root, nat(join(o.work, "run-" + label + "-" + tag)), report, args)?;
    return loadRows(report);
}

function statusOf(r: Ref<Rows>, c: string, absent: string): string {
    return mapGet(r.status, c) ?? absent;
}

function run(argv: []string): int | Error {
    const o = parse(argv)?;
    if (len(o.root) == 0) {
        o.root = currentDir() catch ".";
    }
    o.root = osRealPath(absolute(nat(o.root)));
    o.compiler = osRealPath(absolute(nat(o.compiler)));
    if (!mkdirs(absolute(nat(o.work)))) {
        return err("建不了工作目录：" + o.work);
    }
    o.work = osRealPath(absolute(nat(o.work)));
    const tags: List<string> = listNew();
    listPush(tags, "normal");
    if (o.leak) {
        listPush(tags, "leak-check");
    }
    if (o.debug) {
        listPush(tags, "debug");
    }
    let bad = 0;
    for (tag in tags) {
        let label = "--" + tag;
        let given = o.debugReport;
        if (tag == "normal") {
            label = "normal";
            given = o.normal;
        } else if (tag == "leak-check") {
            given = o.leakReport;
        }
        let std = new Rows { status: mapNew(), detail: mapNew() };
        if (len(given) > 0 && kindOf(nat(given)) != 0 && listLen(o.cases) == 0) {
            std = loadRows(nat(given))?;
        } else {
            std = corpus(o, "standard", tag, listNew())?;
        }
        const flags: List<string> = listNew();
        listPush(flags, "--build-flag=--codegen=portable");
        const por = corpus(o, "portable", tag, flags)?;
        const counts: Map<string, int> = mapNew();
        for (c in mapKeys(por.status)) {
            const s = mapGet(por.status, c) ?? "";
            mapSet(counts, s, (mapGet(counts, s) ?? 0) + 1);
        }
        let line = label + ":";
        for (s in sorted(mapKeys(counts))) {
            line = line + " " + s + "=" + toStr(mapGet(counts, s) ?? 0);
        }
        print(line);
        const all: Map<string, bool> = mapNew();
        for (c in mapKeys(std.status)) {
            mapSet(all, c, true);
        }
        for (c in mapKeys(por.status)) {
            mapSet(all, c, true);
        }
        for (c in sorted(mapKeys(all))) {
            const a = statusOf(std, c, "?");
            const b = statusOf(por, c, "?");
            if (a != b) {
                print("  DIFF " + c + " standard=" + a + " portable=" + b + " " + headChars(mapGet(por.detail, c) ?? "", 300));
                bad = bad + 1;
            }
        }
        for (c in sorted(mapKeys(std.status))) {
            const s = statusOf(std, c, "");
            if (s != "PASS" && s != "COMPILE_REJECT" && s != "SKIP") {
                print("  standard renderer itself: " + c + " " + s);
            }
        }
    }
    if (bad == 0) {
        print("SUMMARY PASS portable-codegen");
        return 0;
    }
    print("SUMMARY FAIL portable-codegen");
    return 1;
}

function main(argv: []string): int {
    return run(argv) catch (e) {
        eprint("test_portable_codegen: " + e.message);
        return 1;
    };
}
