// dialog —— 文件对话框守护（臂③；#17；G5 第二部分增保存、过滤器改结构化）：
// 重放脚本 `dialog <path>` 指令入结果队列→打开与保存对话框重放态按调用序逐次
// 弹出（打开、保存各命中一次）→第三次队列空＝取消（空串）——**无头通道结构性不触 OS
// 弹窗**（回放禁真弹窗铁律）；真窗非重放态走原生对话框（Windows comdlg32；
// 可见冒烟手工执行，不入断言集）。帧面＝三次选择结果回显窗口。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/dialog.txt TAIXU_FRAME=1 taixu run tests/dialog.tx
import { Canvas, canvasDpi, blockPainter, paintFillRect, paintText } from "gui/components";
import { App, appNew, appClose, pump, defaultSpec } from "gui/app";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent, dipToPxK, dialogOpenFile, dialogSaveFile } from "gui/surface";

struct Model {
    surface: int,
    picks: List<string>,
}

function render(cv: Ref<Canvas>, w: int, h: int, m: Ref<Model>, app: Ref<App>): void {
    surfaceClear(cv.h, 0x202040);
    paintFillRect(cv, 0, 0, w, 24, 0x30305A);
    paintText(cv, 8, 7, 0xFFFFFF, "file dialog probe");
    // 三次选择：打开、保存由重放脚本供给（共用一个队列），第三次队列空＝取消；过滤器在重放态不起作用。
    const p0: string = dialogOpenFile(app.hwnd, "open file 1", [{ name: "Taixu 源码", exts: ["tx"] }, { name: "所有文件", exts: ["*"] }]);
    const p1: string = dialogSaveFile(app.hwnd, "save file 2", [{ name: "Taixu 源码", exts: ["tx"] }], "plan v40.tx");
    const p2: string = dialogOpenFile(app.hwnd, "open file 3", []);
    listPush(m.picks, p0);
    listPush(m.picks, p1);
    listPush(m.picks, p2);
    paintText(cv, 8, 32, 0xC0C8E0, "pick1=" + p0);
    paintText(cv, 8, 46, 0xC0C8E0, "pick2=" + p1);
    paintText(cv, 8, 60, 0xC0C8E0, "pick3=" + p2);
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, picks: listNew() };
    const spec = defaultSpec("dialog probe", 280, 100);
    const app = appNew(spec);
    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    let presents: int = 0;
    let frame: int = 0;
    let pick0: string = "";
    let pick1: string = "";
    let pick2: string = "";
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = canvasDpi(m.surface, dipToPxK(app.w, app.k), dipToPxK(app.h, app.k), blockPainter(), app.k);
            render(cv, app.w, app.h, m, app);
            pick0 = listTryGet(m.picks, 0) catch "";
            pick1 = listTryGet(m.picks, 1) catch "";
            pick2 = listTryGet(m.picks, 2) catch "";
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("pick1=" + pick0 + " pick2=" + pick1 + " pick3=" + pick2 + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
