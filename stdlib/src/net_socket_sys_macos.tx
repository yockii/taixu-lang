import { socketAddressScoped } from "./net_socket_addr";

declare function socket(family: i32, kind: i32, protocol: i32): i32 from "libSystem";
declare function close(socket: i32): i32 from "libSystem";
declare function fcntl(socket: i32, command: i32, ...arg: i32): i32 from "libSystem";
declare function setsockopt(socket: i32, level: i32, option: i32, value: Bytes, length: u32): i32 from "libSystem";
declare function getsockopt(socket: i32, level: i32, option: i32, value: Bytes, length: Bytes): i32 from "libSystem";
declare function connect(socket: i32, address: Bytes, length: u32): i32 from "libSystem";
declare function recv(socket: i32, data: Bytes, length: usize, flags: i32): isize from "libSystem";
declare function send(socket: i32, data: Bytes, length: usize, flags: i32): isize from "libSystem";
declare function poll(descriptors: Bytes, count: u32, timeout: i32): i32 from "libSystem";

export function sysByteOpen(version: int, datagram: bool): int {
    let family = 2; if (version == 6) { family = 30; } let kind = 1; if (datagram) { kind = 2; }
    const fd = socket(family as i32, kind as i32, 0 as i32); if (fd < 0 as i32) { return -ffiLastError(); }
    const one = bytesNew(4); bytesSetLE<i32>(one, 0, 1 as i32);
    const flags = fcntl(fd, 3 as i32, 0 as i32);
    if (flags < 0 as i32 || fcntl(fd, 2 as i32, 1 as i32) < 0 as i32 || fcntl(fd, 4 as i32, flags | (4 as i32)) < 0 as i32
        || setsockopt(fd, 65535 as i32, 4130 as i32, one, 4 as u32) != 0 as i32) {
        const code = ffiLastError(); close(fd); return -code;
    }
    return fd as int;
}
export function sysByteClose(fd: int): void { close(fd as i32); }
export function sysByteConnect(fd: int, ip: Bytes, port: int, scope: int): int {
    const address = socketAddressScoped(ip, port, 30, true, scope) catch (e) { return -22; };
    if (connect(fd as i32, address, bytesLen(address) as u32) == 0 as i32) { return 0; }
    const code = ffiLastError(); if (code == 36 || code == 37 || code == 4) { return 1; } if (code == 56) { return 0; } return -code;
}
function ioResult(result: isize): int {
    if (result >= 0 as isize) { return result as int; } const code = ffiLastError(); if (code == 35 || code == 4) { return -2; } return -code;
}
export function sysByteRead(fd: int, data: Bytes): int { return ioResult(recv(fd as i32, data, bytesLen(data) as usize, 0 as i32)); }
export function sysByteWrite(fd: int, data: Bytes): int { return ioResult(send(fd as i32, data, bytesLen(data) as usize, 0 as i32)); }
export function sysBytePoll(fd: int, writable: bool, timeoutMs: int): int {
    const descriptor = bytesNew(8); bytesSetLE<i32>(descriptor, 0, fd as i32); let event = 1; if (writable) { event = 4; } bytesSetLE<i16>(descriptor, 4, event as i16);
    const result = poll(descriptor, 1 as u32, timeoutMs as i32);
    if (result < 0 as i32) { const code = ffiLastError(); if (code == 4) { return 0; } return -code; }
    if ((((bytesGetLE<i16>(descriptor, 6) catch (32 as i16)) as int) & 32) != 0) { return -9; } if (result > 0 as i32) { return 1; } return 0;
}
export function sysByteError(fd: int): int {
    const error = bytesNew(4); const length = bytesNew(4); bytesSetLE<u32>(length, 0, 4 as u32);
    if (getsockopt(fd as i32, 65535 as i32, 4103 as i32, error, length) != 0 as i32) { return -ffiLastError(); } return (bytesGetLE<i32>(error, 0) catch (-1 as i32)) as int;
}
