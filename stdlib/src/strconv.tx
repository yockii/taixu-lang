// ============================================================================
// std/strconv —— 整数/浮点与字符串互转（V0.37-M1；STD-05）。纯 .tx——
// 确定性与 stdlib 使命宣言（内核自举/性能线，stdlib 上层支持库）。
// parseInt：可选前导 −、10 进制、空串/非法字符/超 i64 面 → Error；
// parseFloat：[−]digits[.digits] 基础形（e 指数形 v0.38 S1 评估——登记）；
// formatInt(v, base)：base 2..16，负号前缀；formatFloat(f)：toStr 直通道
//（精度形 formatFloatF(f, digits)：四舍五入到 digits 位小数——std/math 同
// 源 round）。
// **V0.39-G0 位运算重写评估结论（弧 G1-c 清单——落册不重写）**：parseInt 的
// 溢出判界维持**除法形**——有符号溢出检测靠 `v > (i64max - d) / 10` 形态的
// 预判，位运算无益（无环绕加法指令、无 carry 旗标；imul 环绕语义反而丢掉
// 溢出信息）；formatInt 的幂二进制基（2/4/8/16）位移化＝低优先评估位，维持
// 通用除法/取模循环（base 3..15 非幂二进制路径占主导，特判收益不抵面）。
// ============================================================================

import { pow, round } from "std/math";

export function parseInt(s: string): int | Error {
    if (len(s) == 0) {
        return err("empty");
    }
    let i: int = 0;
    let neg: bool = false;
    if ((byteAt(s, 0) catch -1) == '-') {
        neg = true;
        i = 1;
        if (len(s) == 1) {
            return err("no digits");
        }
    }
    let v: int = 0;
    while (i < len(s)) {
        const c: int = byteAt(s, i) catch -1;
        if (c < 48 || c > 57) {
            return err("bad digit");
        }
        const d: int = c - 48;
        // i64 溢出面：|v| > (边界−d)/10 即越界（除法判界免乘溢出）。
        const limit: int = 9223372036854775807;
        if (v > (limit - d) / 10) {
            return err("i64 overflow");
        }
        v = v * 10 + d;
        i = i + 1;
    }
    if (neg) {
        return -v;
    }
    return v;
}

export function parseFloat(s: string): float | Error {
    if (len(s) == 0) {
        return err("empty");
    }
    let i: int = 0;
    let neg: bool = false;
    if ((byteAt(s, 0) catch -1) == '-') {
        neg = true;
        i = 1;
    }
    let sawDigit: bool = false;
    let ip: float = 0.0;
    while (i < len(s)) {
        const c: int = byteAt(s, i) catch -1;
        if (c < 48 || c > 57) {
            break;
        }
        ip = ip * 10.0 + (c - 48) as float;
        sawDigit = true;
        i = i + 1;
    }
    let fp: float = 0.0;
    let fscale: float = 0.1;
    if (i < len(s) && (byteAt(s, i) catch -1) == '.') {
        i = i + 1;
        while (i < len(s)) {
            const c: int = byteAt(s, i) catch -1;
            if (c < 48 || c > 57) {
                break;
            }
            fp = fp + (c - 48) as float * fscale;
            fscale = fscale * 0.1;
            sawDigit = true;
            i = i + 1;
        }
    }
    if (!sawDigit) {
        return err("no digits");
    }
    if (i != len(s)) {
        return err("bad char");
    }
    let r: float = ip + fp;
    if (neg) {
        r = -r;
    }
    return r;
}

const DIGITS: string = "0123456789abcdef";

export function formatInt(v: int, base: int): string | Error {
    if (base < 2 || base > 16) {
        return err("base 2..16");
    }
    if (v == 0) {
        return "0";
    }
    let neg: bool = false;
    let n: int = v;
    if (n < 0) {
        neg = true;
        // i64 最小值取负溢出——经绝对值数学等价循环（% 负数语义）逐位安全。
    }
    const chars: List<int> = listNew();
    while (n != 0) {
        const r: int = n % base;
        n = n / base;
        let ri: int = r;
        if (ri < 0) {
            ri = -ri;
        }
        listPush(chars, byteAt(DIGITS, ri) catch 48);
    }
    let out: string = "";
    if (neg) {
        out = "-";
    }
    let i: int = listLen(chars) - 1;
    while (i >= 0) {
        const c = listGet(chars, i) catch 48;
        out = out + (utf8Encode(c) catch "?");
        i = i - 1;
    }
    return out;
}

export function formatFloat(f: float): string {
    return toStr(f);
}

// formatFloatF：四舍五入到 digits 位小数（std/math 同源 round——确定性；
// scale 经循环×10 精确构造——f64 内 10^n 到 10^22 精确，不走 pow 组合形
// 的 ~2ulp 误差面——执行发现：pow(10,2)=99.999… 使 3.14159→3.139…）。
export function formatFloatF(f: float, digits: int): string {
    let scale: float = 1.0;
    let i: int = 0;
    while (i < digits) {
        scale = scale * 10.0;
        i = i + 1;
    }
    const r: float = round(f * scale) / scale;
    return toStr(r);
}
