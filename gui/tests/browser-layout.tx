import { htmlParse, HtmlDocument } from "../examples/browser/html";
import { cssCompute, CssStyle } from "../examples/browser/css";
import { pageLayout, pageLinkAt, PageLayout, PageCommand } from "../examples/browser/layout";

function measure(value: string, size: int): int {
    let width = 0; let at = 0;
    while (at < len(value)) {
        const c = byteAt(value, at);
        if (c < 128) { width = width + size / 2; at = at + 1; }
        else { width = width + size; if (c < 224) { at = at + 2; } else if (c < 240) { at = at + 3; } else { at = at + 4; } }
    } return width;
}
function document(body: string): Ref<HtmlDocument> { return htmlParse("<style>*{font-size:10px;margin:0;padding:0}</style>" + body) catch panic("HTML"); }
function page(body: string, width: int): Ref<PageLayout> {
    const doc = document(body); return pageLayout(doc, cssCompute(doc) catch panic("CSS"), width, measure) catch (e) { panic(e.message); };
}
function find(page: Ref<PageLayout>, text: string): Ref<PageCommand> {
    for (c in page.commands) { if (c.kind == 1 && c.text == text) { return c; } } panic("missing text: " + text);
}
function bad(doc: Ref<HtmlDocument>, styles: List<CssStyle>, width: int, measured: (string, int) => int): bool { pageLayout(doc, styles, width, measured) catch (e) { return true; }; return false; }

function flowCase(): void {
    const body = "<style>body{width:80px}p{margin-bottom:4px}.gone{display:none}</style><body><p>Hello <a href='/n'>world 中文</a> tail</p><p id='end'>next</p><div class='gone'>secret</div></body>";
    const wide = page(body, 96); const hello = find(wide, "Hello"); const link = find(wide, "world"); const tail = find(wide, "tail");
    assert(hello.x == 0 && hello.y == 0 && hello.width == 25, "first word geometry");
    assert(link.x == 30 && link.y == 0 && link.width == 25 && link.href == "/n", "collapsed space and inline link");
    assert(find(wide, "中").x == 60 && find(wide, "文").x == 70, "CJK fits the first line");
    assert(tail.x == 0 && tail.y == 12 && find(wide, "next").y == 28 && wide.height == 44, "wrap and paragraph margin");
    assert((mapGet(wide.anchors, "end") ?? -1) == 28, "anchor position");
    const hit = pageLinkAt(wide, 31, 1); assert(hit != None, "link hit"); if (hit != None) { assert(hit.href == "/n" && hit.node == link.linkNode, "hit target"); }
    assert(pageLinkAt(wide, 0, 13) == None && pageLinkAt(wide, 55, 1) == None, "plain text and exclusive right edge");
    for (c in wide.commands) { assert(c.text != "secret", "display none subtree hidden"); }
    const narrow = page(body, 40); assert(find(narrow, "world").y == 12 && (mapGet(narrow.anchors, "end") ?? -1) == 40, "resize reflows and updates anchor");
}
function preCase(): void {
    const result = page("<pre>a  b\n\t中\r\nz</pre><ol start='3'><li>alpha<li value='9'>beta</ol><img alt='photo text'><br><a href=''>empty</a>", 60);
    assert(find(result, "a  b").width == 20 && find(result, "中").x == 20 && find(result, "z").y == 24, "pre spaces, tab and CRLF");
    assert(find(result, "3.").y == 36 && find(result, "9.").y == 48, "ordered list start and value");
    assert(find(result, "photo").y == 60 && find(result, "text").x == 30, "image alt text");
    assert(find(result, "empty").y == 72 && result.height == 84, "explicit line break");
    const hit = pageLinkAt(result, 1, 73); assert(hit != None, "empty href is still a link"); if (hit != None) { assert(hit.href == "", "empty href retained"); }
}
function geometryCase(): void {
    const long = page("abcdefghijkl中文🙂", 20);
    assert(find(long, "abcd").y == 0 && find(long, "efgh").y == 12 && find(long, "ijkl").y == 24, "long word split");
    assert(find(long, "中").y == 36 && find(long, "文").x == 10 && find(long, "🙂").y == 48 && long.height == 60, "UTF8 boundaries retained");
    const boxes = page("<div style='background:#112233;padding:2px;width:30px'><span style='background:#abcdef'>hi</span></div>", 60);
    const background = listGet(boxes.commands, 0); const content = find(boxes, "hi");
    assert(background.kind == 0 && background.color == 0x112233 && background.x == 0 && background.y == 0 && background.width == 34 && background.height == 16, "background precedes text and receives final block height");
    assert(content.x == 2 && content.y == 2 && content.background == 0xabcdef, "padding and inline background");
    const centered = page("<p style='width:40px;text-align:center'>hi</p>", 60); assert(find(centered, "hi").x == 15, "line alignment");
}
function boundsCase(): void {
    const doc = document("hello"); const styles = cssCompute(doc) catch panic("styles");
    assert(bad(doc, styles, 15, measure) && bad(doc, styles, 32769, measure), "viewport bounds");
    assert(bad(doc, listNew(), 60, measure), "style count mismatch");
    assert(bad(doc, styles, 60, (text: string, size: int): int => { return -1; }), "negative measurement");
    assert(bad(doc, styles, 60, (text: string, size: int): int => { return 1000001; }), "oversize measurement");
    let malformed = listGet(styles, 0); malformed.marginLeft = 9223372036854775807; listSet(styles, 0, malformed);
    assert(bad(doc, styles, 60, measure), "style geometry rejected before overflowing arithmetic");
    const repeated = document("<p>text</p>"); const children = listGet(repeated.nodes, 0).children; listPush(children, listGet(children, listLen(children) - 1));
    assert(bad(repeated, cssCompute(repeated) catch panic("repeated styles"), 60, measure), "repeated child rejected");
    let nested = ""; let i = 0; while (i < 200) { nested = nested + "<div>"; i = i + 1; } nested = nested + "hello";
    i = 0; while (i < 200) { nested = nested + "</div>"; i = i + 1; }
    assert(page(nested, 60).height == 12, "deep layout uses explicit stack");
}

test "Browser layout: inline flow, links, anchors and resize" { flowCase(); }
test "Browser layout: pre, lists, alt and line breaks" { preCase(); }
test "Browser layout: UTF8 words, backgrounds, padding and alignment" { geometryCase(); }
test "Browser layout: bounds and deep documents" { boundsCase(); }
export function main(args: []string): int { flowCase(); preCase(); geometryCase(); boundsCase(); print("browser layout: flow, links, boxes and bounds OK"); return 0; }
