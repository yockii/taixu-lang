// D3 v0.53：async 函数声明 `T | Error` 时调用得 Future<T>（同声明 T，两种写法都收），可与
// 声明 T 的放进同一个 List<Future<T>>；await 照旧得 T | Error。线程函数返回 T | Error 得 Thread<T>，标注写
// Thread<T | Error> 也归一为 Thread<T>；threadJoin 得 T | Error，线程的错误原样传出。
async function plain(n: int): int {
    return n + 1;
}

async function fallible(n: int): int | Error {
    if (n < 0) {
        return err("negative " + toStr(n));
    }
    return n * 2;
}

function threadOk(): int | Error {
    return 7;
}

function threadBad(): int | Error {
    return err("thread failed");
}

function main(args: []string): int {
    const fs: List<Future<int>> = listNew();
    listPush(fs, plain(1));
    listPush(fs, fallible(5));
    listPush(fs, fallible(-3));
    for (f in fs) {
        const v = await f catch (e) {
            print("error: " + e.message);
            continue;
        };
        print("value " + toStr(v));
    }
    const t: Thread<int> = threadSpawn(threadOk);
    const u: Thread<int | Error> = threadSpawn(threadBad);
    const ts: List<Thread<int>> = listNew();
    listPush(ts, t);
    listPush(ts, u);
    for (h in ts) {
        const r = threadJoin(h) catch (e) {
            print("join error: " + e.message);
            continue;
        };
        print("joined " + toStr(r));
    }
    return 0;
}
