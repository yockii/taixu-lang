// ============================================================================
// std/os —— 系统环境面（V0.38-S2；STD-07——D3 §6.8 declare function 通道）。
//
// getenv/setenv/args。exec＝**评估位登记**（进程面沙箱纪律 v0.39+ 判据式——本关不实施，stdlib-roadmap 排除面）。
//
// 语义注记：getenv 不存在返回 ""（未设置不是故障；存在性判定本关不设，空值语义如实注记）。
//
// 各目标同一实现，不按目标拆文件：环境变量与命令行参数都经核心仓内核的 __rt 内部内建。
// - 环境变量（__rtEnvGet／__rtEnvSet，核心仓线程设计 §十六）：进程级、加锁的表，任一线程 setenv 的结果别的线程都看得到，
//   之后起的子进程也继承（核心 D3 v0.39）。类 Unix 目标首次使用时拷入启动时的环境，同名取第一处（同 libc getenv 的顺序
//   扫描）；Windows 即 Get/SetEnvironmentVariableW。名字为空、含 `=` 或含 NUL、值含 NUL 时 setenv 失败，getenv 得 ""；
//   值中的非法 UTF-8 替换为 U+FFFD。
// - 命令行参数（__rtArgCount／__rtArgAt，核心 D3 v0.41）：取自进程入口保存的参数表，与 main(args) 逐项相同——同一套切分规则
//   （Windows 为 CommandLineToArgvW 的规则）、保留空参数、不含程序名；参数不是合法 UTF-8（Windows 为 UTF-16）的进程在入口
//   即拒绝启动，这里取到的恒为合法 UTF-8。此前 Linux 读 /proc/self/cmdline、macOS 经 sysctl(KERN_PROCARGS2)、Windows 按两态
//   规则自己切分 GetCommandLineW，三端都丢掉空参数。
//
// 2026-10-16 起（用户裁决：公共接口统一为 T | Error，不保留旧接口）：setenv 返回 void | Error。
// ============================================================================

// getenv：环境变量值（未设置 ""）。
export function getenv(name: string): string {
    return __rtEnvGet(name) catch "";
}

// getenvOr：未设置取默认值。
export function getenvOr(name: string, fallback: string): string {
    const v = getenv(name);
    if (len(v) == 0) {
        return fallback;
    }
    return v;
}

// setenv：设置环境变量；名字为空、含 `=` 或 NUL 等失败为 Error。
export function setenv(name: string, value: string): void | Error {
    if (__rtEnvSet(name, value) != 0) {
        return err("os: setenv failed: " + name);
    }
    return done();
}

// void | Error 的成功出口（语言没有裸 `return;` 的形式，返回一个 void 调用）。
function done(): void {
}

// argsLen：程序参数个数（argv[0] 不计；等于 main 的 len(args)）。
export function argsLen(): int {
    return __rtArgCount();
}

// args：参数列表（下标序＝命令行序，空参数保留）。
export function args(): List<string> {
    const out: List<string> = listNew();
    let i: int = 0;
    const n = __rtArgCount();
    while (i < n) {
        listPush(out, __rtArgAt(i) catch "");
        i = i + 1;
    }
    return out;
}

// argAt：第 i 个参数（越界 ""）。
export function argAt(i: int): string {
    return __rtArgAt(i) catch "";
}
