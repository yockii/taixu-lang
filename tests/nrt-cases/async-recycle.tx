// 容量批 C4d：任务记录回收与观察者条目的代数。picker 经 taskAwaitAny 同时观察 0 ms 与 50 ms 两个定时器，
// 先到的唤醒它，随即完成，记录在下一调度轮回收；q 复用这条记录，挂在 400 ms 的定时器上。50 ms 定时器到期时
// 观察集里还留着 picker 的条目：代数不符，跳过（不跳过时 q 会被白白唤醒一轮，await 复查后再挂起，输出不变）。
// q 须按自己的定时器醒来、排在 r（100 ms）之后；代数比对写错时 q 不会醒（死锁 4014）或醒得过早。
async function picker(): int {
    const l: List< Future< void> > = listNew();
    listPush(l, sleepMs(0));
    listPush(l, sleepMs(50));
    const i = taskAwaitAny(l) catch -1;
    print("picker woke " + toStr(i));
    return i;
}

async function sleeper(tag: string, ms: int): int {
    await sleepMs(ms) catch (e) {
        return -1;
    };
    print(tag + " woke");
    return ms;
}

async function chainer(p: Future < int >): int {
    const i = await p catch -1;
    await sleepMs(0) catch (e) {
        return -1;
    };
    const q = sleeper("q", 400);
    const v = await q catch -1;
    print("chainer got " + toStr(i) + " " + toStr(v));
    return 0;
}

export function main(args: []string): int {
    const p = picker();
    const c = chainer(p);
    const r = sleeper("r", 100);
    print("spawned");
    return 0;
}
