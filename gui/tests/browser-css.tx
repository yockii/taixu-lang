import { HtmlDocument, htmlParse } from "../examples/browser/html";
import { cssParse, cssCompute, cssMatches, cssColor, cssDeclarations } from "../examples/browser/css";

function byId(document: Ref<HtmlDocument>, id: string): int {
    let i = 0; for (node in document.nodes) { if ((mapGet(node.attributes, "id") catch "") == id) { return i; } i = i + 1; } panic("missing id " + id);
}
function cascadeCase(): void {
    const document = htmlParse("<style>body{font-size:20px;color:red}p{font-size:2em;color:green}.hot{font-size:2em;color:rgb(1,2,3)!important;margin-top:9px!important;background-color:blue!important}#x{color:bogus!important}</style><body><p id=x class='hot other' style='font-size:1.5em;color:red;margin:1px;background:red'>hello<span id=y>child</span></p><p id=z class=hot style='color:#abc!important'>next</p></body>") catch panic("document");
    const styles = cssCompute(document) catch panic("styles"); const x = byId(document, "x"); const y = byId(document, "y"); const z = byId(document, "z");
    const style = listGet(styles, x);
    assert(style.fontSize == 30, "relative font size computed once against parent, inline wins");
    assert(style.color == 0x010203 && style.background == 0x0000ff, "important beats normal inline; invalid declaration ignored");
    assert(style.marginTop == 9 && style.marginRight == 1 && style.marginBottom == 1 && style.marginLeft == 1, "shorthand participates in each longhand cascade");
    assert(listGet(styles, y).fontSize == 30 && listGet(styles, y).color == style.color, "inherited text properties");
    assert(listGet(styles, z).fontSize == 40 && listGet(styles, z).color == 0xaabbcc, "repeated relative declaration does not multiply; inline important wins");
    assert(cssMatches(document, x, "body > p.hot.other#x") && cssMatches(document, y, "body .hot span"), "compound, child and descendant selectors");
    assert(!cssMatches(document, y, "body > span") && !cssMatches(document, x, "p.missing"), "negative selector relations");
}
function syntaxCase(): void {
    const rules = cssParse("/* before */ p, .hot { color:#123; unknown: 'a;}b'; width: 200px } @media print { body {color:red} } a {text-decoration:underline}") catch panic("rules");
    assert(listLen(rules) == 3, "comma selectors and unknown nested at-rule ignored");
    const declarations = cssDeclarations("color:rgb(1,2,3); background:url('a;b:c'); /* ignored */ color: red ! IMPORTANT;") catch panic("declarations");
    assert(listLen(declarations) == 3 && listGet(declarations, 2).important, "quoted delimiters, comments and important marker");
    assert((cssColor("#0f8") catch -2) == 0x00ff88 && (cssColor("RGB(1, 2, 3)") catch -2) == 0x010203, "color forms");
    assert(cssColor("#oops") == None && cssColor("rgb(300,0,0)") == None, "invalid colors");
    assert(cssColor("红色") == None, "unknown Unicode color is ignored safely");
    const unicode = htmlParse("<p id=x style='font-size:巨大;color:红色'>text</p>") catch panic("Unicode values"); const unicodeStyles = cssCompute(unicode) catch panic("Unicode styles"); assert(listGet(unicodeStyles, byId(unicode, "x")).fontSize == 16, "unknown Unicode length does not split UTF-8");
    assert(listLen(cssParse("p{color:'unterminated") catch panic("incomplete")) == 0, "unfinished block ignored");
    assert(listLen(cssParse("/* unterminated") catch panic("comment")) == 0, "unfinished comment ignored");
}
function defaultsCase(): void {
    const document = htmlParse("<head><title>x</title></head><body><h1 id=h>Title</h1><a id=a href='/next'>link</a><pre id=p> x\n y</pre><div id=d hidden>hidden</div><p id=n style='margin:2px 4px 6px 8px;padding:3px;display:block'>normal</p></body>") catch panic("defaults");
    const styles = cssCompute(document) catch panic("defaults styles");
    assert(listGet(styles, byId(document, "h")).bold && listGet(styles, byId(document, "h")).fontSize == 32, "heading default");
    assert(listGet(styles, byId(document, "a")).underline && listGet(styles, byId(document, "p")).pre && listGet(styles, byId(document, "d")).display == "none", "links, pre and hidden");
    const normal = listGet(styles, byId(document, "n")); assert(normal.marginTop == 2 && normal.marginRight == 4 && normal.marginBottom == 6 && normal.marginLeft == 8 && normal.padding == 3, "box edges");
}
test "浏览器 CSS：层叠、继承、关系与长短属性" { cascadeCase(); }
test "浏览器 CSS：词法、颜色与宽容错误" { syntaxCase(); }
test "浏览器 CSS：元素默认样式与盒模型" { defaultsCase(); }
export function main(args: []string): int { cascadeCase(); syntaxCase(); defaultsCase(); print("browser css: cascade, inheritance, selectors and boxes OK"); return 0; }
