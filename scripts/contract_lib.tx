// toolchain-contract 门步（test_toolchain_contract.tx）与它的工具安全（tool_security.tx）、服务边界（service_security.tx）两段共用的部分：
// 逐项检查的计数、输出与报告行，在仓根运行编译器并分开取 stdout 与 stderr（同 subprocess.run），宽松读 JSON（解析不了得 None），
// 在工作目录写源文件。
import { join } from "./build_lib";
import { Tally, captureRaw, check } from "./test_lib";
import { Jv, jArray, jObject, jParseBytes, jPush, jSet, jString } from "./test_json";
import { hexOf, sha256Of } from "./check_lib";

export const SEC: int = 1000000000;
const DRAIN_NS: int = 10000000000;
const MAX_OUTPUT: int = 268435456;

export struct Ctx {
    t: Ref<Tally>,
    rows: Ref<Jv>,
    compiler: string,
    root: string,
    work: string,
}

export function ctxNew(t: Ref<Tally>, compiler: string, root: string, work: string): Ref<Ctx> {
    return new Ctx { t: t, rows: jArray(), compiler: compiler, root: root, work: work };
}

// 一项检查：打印 PASS／FAIL（失败带细节），并记一行报告（细节至多 1000 字节）。
export function chk(c: Ref<Ctx>, name: string, ok: bool, detail: string): bool {
    check(c.t, name, ok, cut(detail, 300));
    const row = jObject();
    jSet(row, "name", jString(name));
    let flag = jObject();
    if (ok) {
        flag = jTrue();
    } else {
        flag = jFalse();
    }
    jSet(row, "ok", flag);
    jSet(row, "detail", jString(cut(detail, 1000)));
    jPush(c.rows, row);
    return ok;
}

function jTrue(): Ref<Jv> {
    return jParseBytes(bytesFromStr("true")) catch jObject();
}

function jFalse(): Ref<Jv> {
    return jParseBytes(bytesFromStr("false")) catch jObject();
}

// s 的前 n 个字节（不在 UTF-8 字符中间断开）。
export function cut(s: string, n: int): string {
    if (len(s) <= n) {
        return s;
    }
    let k = n;
    while (k > 0 && ((byteAt(s, k) ?? 0) & 192) == 128) {
        k = k - 1;
    }
    return bytesToStr(bytesSlice(bytesFromStr(s), 0, k)) catch "";
}

// 一次运行的结果（超时退出码为 −1）。
export struct Run {
    code: int,
    out: Bytes,
    err: Bytes,
}

// 在 cwd 里运行 exe，至多 limitS 秒。起不了时退出码 −2、stderr 为原因。
export function runAt(exe: string, args: List<string>, cwd: string, limitS: int): Ref<Run> {
    const r = captureRaw(exe, args, cwd, limitS * SEC, DRAIN_NS, MAX_OUTPUT) catch (e) {
        return new Run { code: -2, out: bytesNew(0), err: bytesFromStr(e.message) };
    };
    return new Run { code: r.code, out: r.out, err: r.err };
}

// 在仓根运行编译器。
export function runC(c: Ref<Ctx>, args: List<string>, limitS: int): Ref<Run> {
    return runAt(c.compiler, args, c.root, limitS);
}

// 宽松读 JSON：解析不了得 None。
export function readJ(b: Bytes): Ref<Jv>? {
    const v = jParseBytes(b) catch (e) {
        return None;
    };
    return v;
}

// 字节转文本（不是合法 UTF-8 时逐字节按 Latin-1 拼，只用于细节与包含判断）。
export function text(b: Bytes): string {
    const s = bytesToStr(b) catch (e) {
        const out = bytesNew(0);
        let i = 0;
        while (i < bytesLen(b)) {
            const v = bytesGet(b, i) ?? 0;
            if (v < 128) {
                bytesPush(out, v);
            } else {
                bytesPush(out, 192 | (v >> 6));
                bytesPush(out, 128 | (v & 63));
            }
            i = i + 1;
        }
        return bytesToStr(out) catch "";
    };
    return s;
}

// CRLF 归一为 LF。
export function lf(b: Bytes): Bytes {
    const out = bytesNew(0);
    let i = 0;
    while (i < bytesLen(b)) {
        const v = bytesGet(b, i) ?? 0;
        if (!(v == 13 && (bytesGet(b, i + 1) ?? 0) == 10)) {
            bytesPush(out, v);
        }
        i = i + 1;
    }
    return out;
}

// 在工作目录写 <name>.tx（UTF-8、LF），返回路径。
export function source(c: Ref<Ctx>, name: string, body: string): string {
    const path = join(c.work, name + ".tx");
    writeFile(path, body) catch (e) {
        eprint("写不了 " + path + "：" + e.message);
    };
    return path;
}

export function strs(xs: []string): List<string> {
    const out: List<string> = listNew();
    for (x in xs) {
        listPush(out, x);
    }
    return out;
}

export function added(xs: List<string>, x: string): List<string> {
    const out: List<string> = listNew();
    for (y in xs) {
        listPush(out, y);
    }
    listPush(out, x);
    return out;
}

// SHA-256 的十六进制（check_lib.tx 的独立实现，不用编译器的 sha256.tx）。
export function shaHex(b: Bytes): string {
    return hexOf(sha256Of(b, 0, bytesLen(b)));
}

// s 里的 a 全部换成 b（a 非空）。
export function replaceAll(s: string, a: string, b: string): string {
    let out = "";
    let rest = s;
    let at = strFind(rest, a);
    while (at >= 0) {
        const head = bytesToStr(bytesSlice(bytesFromStr(rest), 0, at)) catch "";
        out = out + head + b;
        rest = bytesToStr(bytesSlice(bytesFromStr(rest), at + len(a), len(rest) - at - len(a))) catch "";
        at = strFind(rest, a);
    }
    return out + rest;
}

export function joinWith(xs: List<string>, sep: string): string {
    let out = "";
    let first = true;
    for (x in xs) {
        if (!first) {
            out = out + sep;
        }
        out = out + x;
        first = false;
    }
    return out;
}
