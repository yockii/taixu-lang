import { BrowserTransport, transportOpenSocket } from "./transport";
import { browserResolve } from "./dns";
import { browserConnectAddresses } from "./connect_socket";

export function browserOpen(host: string, port: int, secure: bool, deadline: int, roots: List<Bytes>, cancelled: () => bool): Ref<BrowserTransport> | Error {
    const addresses = browserResolve(host, deadline, cancelled)?;
    const socket = browserConnectAddresses(addresses, port, deadline, cancelled)?;
    return transportOpenSocket(host, socket, secure, deadline, roots, cancelled);
}
