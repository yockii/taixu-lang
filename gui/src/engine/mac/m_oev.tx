// ============================================================================
// engine/mac/m_oev —— objc_msgSend：+[NSEvent otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:
// data2:]（测试投递用：应用自定义事件，排进事件队列，与其他投递的事件保持先后）。
// ============================================================================

import { NSPOINT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, ty: usize, loc: NSPOINT, flags: usize, ts: float, wnum: int, ctx: usize, subtype: i16, d1: int, d2: int): usize from "/usr/lib/libobjc.A.dylib";

export function msgOtherEvent(nsevent: usize, wnum: int, subtype: int, d1: int, d2: int): usize {
    return objc_msgSend(nsevent, sel_registerName("otherEventWithType:location:modifierFlags:timestamp:windowNumber:context:subtype:data1:data2:"), 15, NSPOINT { x: 0.0, y: 0.0 }, 0, 0.0, wnum, 0, subtype as i16, d1, d2);
}
