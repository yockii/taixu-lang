// ============================================================================
// stdlib 用例：text 文本工具（扩批）
// 运行：taixu test tests/text-fx.tx
// ============================================================================

import { repeat, startsWith, endsWith, padStart, padEnd, truncate, indent, lineCount, wordCount } from "std/text";
import { codepointWidth, displayWidth, padStartBytes, padEndBytes, truncateBytes } from "std/text";

test "repeat 与前后缀" {
    assert(repeat("ab", 3) == "ababab", "重复 3 次");
    assert(repeat("x", 0) == "", "零次空串");
    assert(startsWith("hello.tx", "hello") && !startsWith("hello", "tx"), "前缀");
    assert(endsWith("a.tx", ".tx") && !endsWith("a.tx", ".go"), "后缀");
    assert(!startsWith("ab", "abcd"), "前缀长于原串");
}

test "padding 与截断" {
    assert(padStart("7", 3, "0") == "007", "左填充");
    assert(padEnd("7", 3, ".") == "7..", "右填充");
    assert(padStart("abcd", 3, "0") == "abcd", "超宽原样");
    assert(truncate("hello world", 8, "...") == "hello...", "截断加省略");
    assert(truncate("hi", 8, "...") == "hi", "不超宽原样");
    assert(truncate("abcdef", 2, "...") == "..", "极窄截断");
}

test "多字节文本：前后缀按字节比" {
    assert(endsWith("你好.txt", ".txt") && !endsWith("你好.txt", ".tx"), "中文文件名的后缀");
    assert(startsWith("你好abc", "你") && !startsWith("你好", "abc"), "中文前缀");
    assert(endsWith("世界", "界") && !endsWith("a", "界"), "中文后缀，后缀长于原串");
}

test "按字节的版本：宽度按字节、切点取字符边界" {
    assert(padStartBytes("7", 3, "0") == "007", "左填充");
    assert(padEndBytes("7", 3, ".") == "7..", "右填充");
    assert(padStartBytes("a", 4, "中") == "中a", "多字节填充：4 字节宽只放得下一个“中”");
    assert(padEndBytes("a", 3, "中") == "a", "放不下整字则不填");
    assert(truncateBytes("abcdef", 2, "…") == "", "省略号 3 字节放不进 2 字节宽");
    assert(truncateBytes("你好世界", 8, "...") == "你...", "8 字节宽：5 字节只够一个汉字");
    assert(truncateBytes("你好世界", 9, "...") == "你好...", "9 字节宽：两个汉字");
    assert(len(truncateBytes("你好世界你好世界", 10, "")) == 9, "结果不超过给定字节宽");
}

test "显示列宽：码点" {
    assert(codepointWidth('a') == 1 && codepointWidth('太') == 2, "ASCII 1 列，汉字 2 列");
    assert(codepointWidth(7) == 0 && codepointWidth(0x7F) == 0 && codepointWidth(0x85) == 0, "C0、DEL、C1 控制字符 0 列");
    assert(codepointWidth(0x301) == 0 && codepointWidth(0x200B) == 0 && codepointWidth(0xFE0F) == 0, "组合符号、零宽空格、变体选择符 0 列");
    assert(codepointWidth(0xAD) == 1, "软连字符按 1（同 wcwidth、glibc）");
    assert(codepointWidth(0x1160) == 0 && codepointWidth(0xD7B0) == 0, "韩文字母中声 0 列");
    assert(codepointWidth(0x1100) == 2 && codepointWidth(0xAC00) == 2, "韩文初声与音节 2 列");
    assert(codepointWidth(0xFF21) == 2 && codepointWidth(0xFF71) == 1, "全角 2 列，半角片假名 1 列");
    assert(codepointWidth(0x2026) == 1 && codepointWidth(0x3B1) == 1, "宽度不定（A 类）按 1");
    assert(codepointWidth(0x1F600) == 2, "emoji 2 列");
    assert(codepointWidth(0x2630) == 2 && codepointWidth(0x1FAE9) == 2, "Unicode 16.0 起八卦符号改宽、新增 emoji 2 列（表取自 UCD 17.0）");
    assert(codepointWidth(0x3400) == 2 && codepointWidth(0x20000) == 2 && codepointWidth(0x2FFFD) == 2, "CJK 扩展区（含未分配）2 列");
    assert(codepointWidth(0xE0001) == 0, "标签字符 0 列");
    assert(codepointWidth(0x10FFFF) == 1, "未分配的其余码点 1 列");
}

test "显示列宽：字符串" {
    assert(displayWidth("") == 0 && displayWidth("abc") == 3, "ASCII");
    assert(displayWidth("张三") == 4 && displayWidth("한글") == 4, "中文、韩文");
    assert(displayWidth("é") == 1, "e 加组合符号 1 列");
    assert(displayWidth("a😀b") == 4, "emoji 2 列");
    assert(displayWidth("Ａｱ") == 3, "全角 2 列，半角 1 列");
    assert(displayWidth("a\tb") == 2, "制表符 0 列");
}

test "按显示列宽填充" {
    assert(padEnd("张三", 8, " ") == "张三    ", "补到 8 列：两个汉字 4 列，补 4 个空格");
    assert(padStart("李", 4, " ") == "  李", "左补");
    assert(padStart("a", 4, "中") == "中 a", "宽字符放不下的一列以空格补齐");
    assert(padEnd("a", 3, "中") == "a中", "恰好放下");
    assert(padStart("ab", 5, "xy") == "xyxab", "最后一份按列截取");
    assert(padEnd("x", 4, "é") == "xééé", "pad 含组合符号按 1 列");
    assert(padStart("x", 3, "​") == "x", "零宽的 pad 不填");
    assert(padStart("张三", 3, " ") == "张三", "本身不窄于目标原样");
    assert(displayWidth(padEnd("名字", 11, "·")) == 11, "结果恰为目标列数");
}

test "按显示列宽截断" {
    assert(truncate("太虚智能编程语言", 4, "…") == "太…", "4 列：省略号 1 列，再放一个汉字");
    assert(truncate("太虚智能编程语言", 7, "...") == "太虚...", "7 列");
    assert(truncate("太虚", 4, "…") == "太虚", "不超宽原样");
    assert(truncate("abcdef", 2, "…") == "a…", "省略号 1 列");
    assert(truncate("a😀b", 2, "") == "a", "宽字符放不下就停在它前面");
    assert(truncate("ébc", 2, "") == "éb", "组合符号随前面的字符留下");
    assert(displayWidth(truncate("你好世界你好世界", 9, "…")) <= 9, "结果不超过给定列数");
}

test "缩进与计数" {
    assert(indent("a\nb", "  ") == "  a\n  b", "逐行缩进");
    assert(lineCount("a\nb\nc") == 3, "行数");
    assert(lineCount("") == 1, "空串一行");
    assert(wordCount("hello  world\nfoo") == 3, "词数（连续空白）");
    assert(wordCount("") == 0, "空串零词");
}
