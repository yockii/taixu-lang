// 第 5 轮 FFI（D3 v0.23，Linux）：from "库" 让产物动态链接（PT_INTERP、DT_NEEDED、GOT 立即绑定），
// 入口仍是自己的 _start——libc 与 libm 的定宽、浮点、string 实参与返回（空指针得空串）、errno 经
// ffiLastError（open 失败得 ENOENT 2）、qsort 的比较函数（SysV 回调外壳，回调里再调外部函数）；
// 进程经 libc 的 exit 退出，C 侧 stdio 缓冲照常刷新（管道下 puts 的输出排在最后）。
declare function strlen(s: string): usize from "libc.so.6";
declare function getpid(): i32 from "libc.so.6";
declare function atof(s: string): float from "libc.so.6";
declare function open(path: string, flags: i32): i32 from "libc.so.6";
declare function puts(s: string): i32 from "libc.so.6";
declare function getenv(name: string): string from "libc.so.6";
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "libc.so.6";
declare function memcpy(dst: Bytes, src: usize, n: usize): usize from "libc.so.6";
declare function sqrt(x: f64): f64 from "libm.so.6";
declare function powf(x: f32, y: f32): f32 from "libm.so.6";

let compares = 0;

function u32At(addr: usize): int {
    const tmp = bytesNew(4);
    memcpy(tmp, addr, 4);
    return (bytesGet(tmp, 0) catch 0) + (bytesGet(tmp, 1) catch 0) * 256;
}

function byValue(a: usize, b: usize): i32 {
    compares = compares + 1;
    const x = u32At(a);
    const y = u32At(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

function main(args: []string): int {
    print("strlen " + toStr(strlen("héllo") as int) + " pid " + toStr(getpid() > 0));
    print("atof " + toStr(atof("2.5e3")));
    print("open " + toStr(open("/taixu-no-such/file", 0)) + " errno " + toStr(ffiLastError()));
    print("getenv [" + getenv("TAIXU_FFI_NOPE") + "]");
    print("sqrt " + toStr(sqrt(2.0)) + " powf " + toStr(powf(2.0, 10.0) as float));
    const vals = [5, 3, 9, 1, 7, 2];
    const buf = bytesNew(24);
    let i = 0;
    while (i < 6) {
        bytesSet(buf, i * 4, vals[i]);
        i = i + 1;
    }
    qsort(buf, 6, 4, byValue);
    let out = "";
    i = 0;
    while (i < 6) {
        out = out + toStr(bytesGet(buf, i * 4) catch -1) + " ";
        i = i + 1;
    }
    print("sorted " + out + toStr(compares > 0));
    puts("from libc puts");
    print("last taixu line");
    return 0;
}
