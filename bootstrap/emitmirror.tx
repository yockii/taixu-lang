import { valueAbiCompatible } from "./selfhost/value_abi";
import { isDbgBi, dbgBiName, isToolBi, toolBiName } from "./selfhost/builtin_names";
import { VALUE_BYTES, VALUE_TAG_OFFSET, VALUE_PAYLOAD_OFFSET, RT_ENTRY_BYTES, RT_STATE_OFFSET } from "./selfhost/value_abi";
import { TB_MASK, TB_STACK_LIMIT, TB_NATIVE_STACK_LIMIT, TB_STR_OBJS, TB_TASK_RESUME, TB_TASK_SUSP } from "./selfhost/thread_block_abi";
import { asProducerFunctionBegin, asProducerFunctionEnd, asProducerFunctionPrologueEnd, asProducerFunctionEpilogueStart, asProducerFrame, asListingSelect, Operand, asProducerLabel, asProducerInstruction, asProducerBeginFunction, asProducerSubmitBody, asProducerRegister, asProducerInteger, asStructuredReg, asStructuredImm, asStructuredMem, asStructuredMissing, asStructuredTarget } from "./selfhost/assemble";
// emitmirror.tx —— Emitter 四步协议 .tx 消费面（BOOT-31 柱三切片 v1 ＋
// V0.45-B5 柱三升界 v2——D94 §四升界路径／D96 支持面合同）。
//
// 双模式（首记录版本标记判别）：
//  v1＝EMITDUMP 文本发射面切片（f0.dump fixture——决策/布局面 zig 侧，文本
//     面 .tx 化；probe ①段恒等锚不回退）；
//  v2＝EMITMIRROR IR 级记录流（记录只载 IR 指令＋分析事实——**帧布局与
//     临时选择入 .tx 面**：本文件内嵌 planRun 镜像算法〔regallocmirror.tx
//     V0.42-B2 5719/5719 恒等先例同源移植〕——帧偏移/寄存器指派/首触装载/
//     出口物化/保存序全部镜像端计算）。集合外形态结构化拒绝（白名单制，
//     禁静默回退——D96 §五拒绝码 E001–E011）。
//
// 自包含零 import（semamirror 同例）。
// 用法：taixu run bootstrap/emitmirror.tx <记录流路径> <out.s 路径>
// 退出码：0＝渲染成功（写入 out）；1＝结构化拒绝（EMITMIRROR-REJECT 行列
// 全部拒绝点，不写产物）；64＝用法错误。

// —— Loc 编码（regalloc.Loc 镜像：0=none 1=mem 2=gp 3=xmm）；GP 池 8
// （r8..r15）。NO＝maxInt 哨兵（last_use/no_owner 共用语义）。——

const NO: int = 2147483647;

struct Ctx {
    nativeMode: int,
    recordLine: int,
    listing: bool,
    parts: List<string>, // 产物行（v1 直写；v2 经 fnParts 函数缓冲装配）
    fnIdx: int,
    outPath: string,
    // —— 模式/程序面 ——
    ver: int, // 1＝EMITDUMP 切片；2＝EMITMIRROR IR 级
    target: string,
    framePad: int,
    entry: int,
    // —— 当前函数事实（fn 记录）——
    hasFn: int,
    sawFn: int,
    regCount: int,
    padEsc: int,
    padCache: int,
    padStrbld: int,
    padVh: int,
    isaGuard: int,
    irActive: int,
    escSiteIdx: List<int>,
    escKind: List<int>,
    escUnits: List<int>,
    escScalar: List<int>,
    escBuf: List<int>,
    escNTags: List<int>,
    escTagFirst: List<int>,
    escTagFlat: List<int>,
    sblIdx: List<int>,
    sblHeader: List<int>,
    sblCond: List<int>,
    sblExit: List<int>,
    sblAdd: List<int>,
    sblRoot: List<int>,
    sblBSlot: List<int>,
    sblPrepend: List<int>,
    sblBase: List<int>,
    resumePcs: List<int>, // 可挂起函数的恢复点（resume 记录；原生异步）
    resumeLand: List<int>, // 同序的取消落点（-1＝该点无已登记 defer）
    r12r13: int,
    frameTotal: int,
    planHighGp: int, // 本函数 plan 触 GP 下标 ≥4（→ r12/r13 保存序）
    fnParts: List<string>, // 函数体缓冲（prologue 需 plan 结果——endf 装配）
    // —— 当前 run 缓冲（run 记录开窗——live 记录收口）——
    runLen: int,
    runFused: int,
    runPc: List<int>,
    runLbls: List<int>, // run 内各 pc 的标签（随 op 位置交错渲染）
    pendLbls: List<int>, // run 开窗前挂起的标签（run 首 pc）
    runKind: List<string>,
    runNuses: List<int>,
    runU0: List<int>,
    runT0: List<int>,
    runU1: List<int>,
    runT1: List<int>,
    runDef: List<int>,
    runOt: List<int>,
    runNt: List<int>,
    runBx: List<int>,
    runVal: List<int>,
    runFval: List<string>, // loadk_float 的 fval 位型文本（逐字转录——D96 v0.2 §二-3）
    runMsgI: List<int>,
    runMsgL: List<int>,
    runMsg2I: List<int>,
    runMsg2L: List<int>,
    runMsgN: List<int>,
    runLoaded: List<int>,
    runDefined: List<int>,
    pendingLiveN: int,
    liveBmp: List<int>,
    pendingPayload: string,
    acceptPayload: int,
    // —— planRun2 输出（逐 pos 平行表＋段界物化清单）——
    pbC: List<int>,
    pbI: List<int>,
    pcC: List<int>,
    pcI: List<int>,
    pdC: List<int>,
    pdI: List<int>,
    stSlot: List<int>,
    stC: List<int>,
    stI: List<int>,
    stTag: List<int>,
    // —— 拒绝聚合 ——
    rejFn: List<int>,
    rejPc: List<int>,
    rejCode: List<string>,
    rejDetail: List<string>,
}

function begin(outPath: string): Ref<Ctx> {
    return new Ctx {
        nativeMode: emNativeMode, recordLine: 1, listing: emListingMode, parts: listNew(), fnIdx: 0, outPath: outPath,
        ver: 0, target: "", framePad: 0, entry: 0,
        hasFn: 0, sawFn: 0, regCount: 0, padEsc: 0, padCache: 0,
        padStrbld: 0, padVh: 0, isaGuard: 0, irActive: 0, r12r13: 0, frameTotal: 0, escSiteIdx: listNew(), escKind: listNew(), escUnits: listNew(), escScalar: listNew(), escBuf: listNew(), escNTags: listNew(), escTagFirst: listNew(), escTagFlat: listNew(), sblIdx: listNew(), sblHeader: listNew(), sblCond: listNew(), sblExit: listNew(), sblAdd: listNew(), sblRoot: listNew(), sblBSlot: listNew(), sblPrepend: listNew(), sblBase: listNew(), resumePcs: listNew(), resumeLand: listNew(),
        planHighGp: 0, fnParts: listNew(),
        runLen: 0, runFused: 0, runPc: listNew(), runLbls: listNew(), pendLbls: listNew(), runKind: listNew(), runNuses: listNew(),
        runU0: listNew(), runT0: listNew(), runU1: listNew(), runT1: listNew(),
        runDef: listNew(), runOt: listNew(), runNt: listNew(), runBx: listNew(),
        runVal: listNew(), runFval: listNew(), runMsgI: listNew(), runMsgL: listNew(), runMsg2I: listNew(), runMsg2L: listNew(), runMsgN: listNew(),
        runLoaded: listNew(), runDefined: listNew(), pendingLiveN: -1, liveBmp: listNew(),
        pendingPayload: "", acceptPayload: 0,
        pbC: listNew(), pbI: listNew(), pcC: listNew(), pcI: listNew(),
        pdC: listNew(), pdI: listNew(), stSlot: listNew(), stC: listNew(),
        stI: listNew(), stTag: listNew(),
        rejFn: listNew(), rejPc: listNew(), rejCode: listNew(), rejDetail: listNew(),
    };
}

// 发射一行（行尾换行符随行——finish 分治拼接即得逐字节 .s）
function emitLn(c: Ref<Ctx>, line: string): void {
    listPush(c.parts, line + "\n");
}

// v2 函数体发射（缓冲——prologue 需 plan 结果，endf 装配）
function emitFn(c: Ref<Ctx>, line: string): void {
    listPush(c.fnParts, line + "\n");
}

function iat(l: List<int>, i: int): int {
    return listGet(l, i) catch 0;
}

function sat(l: List<string>, i: int): string {
    return listGet(l, i) catch "";
}

// ============================================================================
// §A v1 共享面（EMITDUMP 文本发射切片——BOOT-31 原样保留，probe ①段锚）
// ============================================================================

function prologue(c: Ref<Ctx>, frameTotal: int, saves: List<string>): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "push", 1, asStructuredReg(0, 5), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  push rbp"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(0, 5), asStructuredReg(0, 4), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov rbp, rsp"); }
    let i: int = 0;
    const n = listLen(saves);
    while (i < n) {
        if (c.nativeMode == 1) { asProducerInstruction(0, "push", 1, asProducerRegister((listGet(saves, i) catch "")), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  push " + (listGet(saves, i) catch "")); }
        i = i + 1;
    }
    if (c.nativeMode == 1) { asProducerInstruction(0, "sub", 2, asStructuredReg(0, 4), asStructuredImm(frameTotal), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  sub rsp, " + toStr(frameTotal)); }
}

// 原生路径：寄存器 r＝当前线程块（threads §十二：TB = rbx & TB_MASK，rbx 是本帧值槽窗口）；只写 r。
function tbInto(c: Ref<Ctx>, part: int, r: int): void {
    asProducerInstruction(part, "mov", 2, asStructuredReg(0, r), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine);
    asProducerInstruction(part, "and", 2, asStructuredReg(0, r), asStructuredImm(TB_MASK), asStructuredMissing(), c.recordLine);
}

function winbase(c: Ref<Ctx>, from: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(0, 3), asProducerRegister(from), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov rbx, " + from); }
}

function label(c: Ref<Ctx>, id: int): void {
    if (c.nativeMode == 1) { asProducerLabel(0, ".L" + toStr(c.fnIdx) + "_" + toStr(id), c.recordLine); } else { emitLn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(id) + ":"); }
}

function frameLoad(c: Ref<Ctx>, off: int, tmp: string, val: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asProducerRegister(tmp), asStructuredMem(2, 3, -1, 0, off, 0, ""), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov " + tmp + ", [rbx + " + toStr(off) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asProducerRegister(val), asProducerRegister(tmp), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov " + val + ", " + tmp); }
}

function arithAdd(c: Ref<Ctx>, a: string, b: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "add", 2, asProducerRegister(a), asProducerRegister(b), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  add " + a + ", " + b); }
}

function trapBlock(c: Ref<Ctx>, pc: int, code: int, msgOff: int, msgLen: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "jo", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  jo .L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "jmp", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  jmp .L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend"); }
    if (c.nativeMode == 1) { asProducerLabel(0, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof", c.recordLine); } else { emitLn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof:"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(1, 1), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov ecx, " + toStr(c.fnIdx)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(1, 2), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov edx, " + toStr(pc)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(1, 8), asStructuredImm(code), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov r8d, " + toStr(code)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "lea", 2, asStructuredReg(0, 9), asStructuredMem(2, -1, -1, 0, 0, 1, ".Lmsg" + toStr(msgOff)), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  lea r9, [rip + .Lmsg" + toStr(msgOff) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(msgLen), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov dword ptr [rsp + 32], " + toStr(msgLen)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "call", 1, asStructuredTarget("__tx_trap"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  call __tx_trap"); }
    if (c.nativeMode == 1) { asProducerLabel(0, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend", c.recordLine); } else { emitLn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend:"); }
}

function constAbs(c: Ref<Ctx>, dst: string, imm: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "movabs", 2, asProducerRegister(dst), asStructuredImm(imm), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  movabs " + dst + ", " + toStr(imm)); }
}

function frameStore(c: Ref<Ctx>, off: int, val: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(2, 3, -1, 0, off, 0, ""), asProducerRegister(val), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov [rbx + " + toStr(off) + "], " + val); }
}

function tagStore(c: Ref<Ctx>, off: int, val: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(1, 3, -1, 0, off, 0, ""), asStructuredImm(val), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov dword ptr [rbx + " + toStr(off) + "], " + toStr(val)); }
}

function retLoad(c: Ref<Ctx>, tagOff: int, valOff: int, tagW: string, valW: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asProducerRegister(tagW), asStructuredMem(1, 3, -1, 0, tagOff, 0, ""), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov " + tagW + ", dword ptr [rbx + " + toStr(tagOff) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asProducerRegister(valW), asStructuredMem(2, 3, -1, 0, valOff, 0, ""), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov " + valW + ", qword ptr [rbx + " + toStr(valOff) + "]"); }
}

function frameRelease(c: Ref<Ctx>, self: string, slots: int, arg2: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(0, 1), asProducerRegister(self), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov rcx, " + self); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(1, 2), asStructuredImm(slots), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov edx, " + toStr(slots)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(1, 8), asStructuredImm(arg2), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov r8d, " + toStr(arg2)); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "call", 1, asStructuredTarget("__tx_frame_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  call __tx_frame_release"); }
}

function retStore(c: Ref<Ctx>, tagW: string, valW: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(1, 3, -1, 0, 0, 0, ""), asProducerRegister(tagW), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov dword ptr [rbx], " + tagW); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(2, 3, -1, 0, 8, 0, ""), asProducerRegister(valW), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov qword ptr [rbx + 8], " + valW); }
}

function jumpEpi(c: Ref<Ctx>): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "jmp", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  jmp .L" + toStr(c.fnIdx) + "_epi"); }
}

function epiLabel(c: Ref<Ctx>): void {
    if (c.nativeMode == 1) { asProducerLabel(0, ".L" + toStr(c.fnIdx) + "_epi", c.recordLine); } else { emitLn(c, ".L" + toStr(c.fnIdx) + "_epi:"); }
}

function epilogue(c: Ref<Ctx>, frameTotal: int, saves: List<string>): void {
    if (c.nativeMode == 1) { asProducerInstruction(0, "add", 2, asStructuredReg(0, 4), asStructuredImm(frameTotal), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  add rsp, " + toStr(frameTotal)); }
    let i: int = 0;
    const n = listLen(saves);
    while (i < n) {
        if (c.nativeMode == 1) { asProducerInstruction(0, "pop", 1, asProducerRegister((listGet(saves, i) catch "")), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  pop " + (listGet(saves, i) catch "")); }
        i = i + 1;
    }
    if (c.nativeMode == 1) { asProducerInstruction(0, "pop", 1, asStructuredReg(0, 5), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  pop rbp"); }
    if (c.nativeMode == 1) { asProducerInstruction(0, "ret", 0, asStructuredMissing(), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  ret"); }
}

// 记录字段的十进制整数（不合法得 0）；可移植渲染器共用。
export function emRecordInt(s: string): int { return toInt(s); }
function toInt(s: string): int {
    if (!isIntText(s)) { return 0; }
    let i: int = 0;
    let neg: bool = false;
    if ((byteAt(s, 0) catch 45) == 45) {
        neg = true;
        i = 1;
    }
    let v: int = 0;
    while (i < len(s)) {
        const d = (byteAt(s, i) catch 48) - 48;
        v = v * 10 - d;
        i = i + 1;
    }
    if (!neg) { v = -v; }
    return v;
}

function isIntText(s: string): bool {
    if (len(s) == 0) { return false; }
    let i: int = 0;
    let neg: bool = false;
    if ((byteAt(s, 0) catch 0) == 45) {
        neg = true;
        i = 1;
    }
    if (i >= len(s)) { return false; }
    const maxInt: int = 9223372036854775807;
    let limit: int = -maxInt;
    if (neg) { limit = limit - 1; }
    const multMin = limit / 10;
    const lastDigit = -(limit % 10);
    let v: int = 0;
    while (i < len(s)) {
        const d = (byteAt(s, i) catch 48) - 48;
        if (d < 0 || d > 9) { return false; }
        if (v < multMin || (v == multMin && d > lastDigit)) { return false; }
        v = v * 10 - d;
        i = i + 1;
    }
    return true;
}

// v1 emitFunction 步：记录分派（返回 0 继续／1 数据段拒绝／2 函数结束／3 未知拒绝）
function dispatch(c: Ref<Ctx>, rec: List<string>): int {
    const op = listGet(rec, 0) catch "";
    if (op == "begin_fn") {
        c.fnIdx = toInt(listGet(rec, 1) catch "0");
        if (c.nativeMode == 1) { asProducerLabel(0, "f_" + toStr(c.fnIdx), c.recordLine); } else { emitLn(c, "f_" + toStr(c.fnIdx) + ":"); }
        return 0;
    }
    if (op == "prologue" || op == "epilogue") {
        const ft = toInt(listGet(rec, 1) catch "0");
        let saves: List<string> = listNew();
        let i: int = 2;
        const n = listLen(rec);
        while (i < n) {
            listPush(saves, listGet(rec, i) catch "");
            i = i + 1;
        }
        if (op == "prologue") { prologue(c, ft, saves); } else { epilogue(c, ft, saves); }
        if (op == "epilogue") { return 2; }
        return 0;
    }
    if (op == "winbase") { winbase(c, listGet(rec, 1) catch "rcx"); return 0; }
    if (op == "label") { label(c, toInt(listGet(rec, 1) catch "0")); return 0; }
    if (op == "frame_load") {
        frameLoad(c, toInt(listGet(rec, 1) catch "0"), listGet(rec, 2) catch "r8", listGet(rec, 3) catch "r9");
        return 0;
    }
    if (op == "arith_add") {
        arithAdd(c, listGet(rec, 1) catch "r9", listGet(rec, 2) catch "r10");
        return 0;
    }
    if (op == "trap_block") {
        trapBlock(c, toInt(listGet(rec, 1) catch "0"), toInt(listGet(rec, 2) catch "0"), toInt(listGet(rec, 3) catch "0"), toInt(listGet(rec, 4) catch "0"));
        return 0;
    }
    if (op == "const_abs") {
        constAbs(c, listGet(rec, 1) catch "r10", toInt(listGet(rec, 2) catch "0"));
        return 0;
    }
    if (op == "frame_store") {
        frameStore(c, toInt(listGet(rec, 1) catch "0"), listGet(rec, 2) catch "r9");
        return 0;
    }
    if (op == "tag_store") {
        tagStore(c, toInt(listGet(rec, 1) catch "0"), toInt(listGet(rec, 2) catch "0"));
        return 0;
    }
    if (op == "ret_load") {
        retLoad(c, toInt(listGet(rec, 1) catch "0"), toInt(listGet(rec, 2) catch "0"), listGet(rec, 3) catch "r15d", listGet(rec, 4) catch "r14");
        return 0;
    }
    if (op == "frame_release") {
        frameRelease(c, listGet(rec, 1) catch "rbx", toInt(listGet(rec, 2) catch "0"), toInt(listGet(rec, 3) catch "0"));
        return 0;
    }
    if (op == "ret_store") {
        retStore(c, listGet(rec, 1) catch "r15d", listGet(rec, 2) catch "r14");
        return 0;
    }
    if (op == "jump_epi") { jumpEpi(c); return 0; }
    if (op == "epi_label") { epiLabel(c); return 0; }
    if (op == "emit_data") {
        return 1; // emitData 步请求——结构化拒绝（切片外）
    }
    print("emitmirror: 切片外记录 '" + op + "'——结构化拒绝（切片面＝栈帧/整数算术陷阱/常量/返回调用约定文本发射）");
    return 3;
}

// ============================================================================
// §B v2 镜像计算面（D96 §二——帧布局与临时选择入 .tx 面）
// ============================================================================

function gname(i: int): string {
    return "r" + toStr(8 + i);
}

function gname32(i: int): string {
    return "r" + toStr(8 + i) + "d";
}

function payloadOff(slot: int): int {
    return slot * VALUE_BYTES + VALUE_PAYLOAD_OFFSET;
}

function tagOff(slot: int): int {
    return slot * VALUE_BYTES + VALUE_TAG_OFFSET;
}

// releaseOld 镜像（emit_gen emitReleaseOld——win64 arg64[0]=rcx）
// 借用调用返回后：借用实参槽只清空；自有临时实参槽先释放再清空（被调方不再释放参数）。
function borrowCallCleanup(c: Ref<Ctx>, pc: int, a: int, b: int, mask: int): void {
    if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_call_direct_b_text"); return; }
    let j = 1;
    while (j < b) {
        const t = a + j;
        let borrowed = false;
        if (j <= 60) { borrowed = ((mask >>> (j - 1)) & 1) == 1; }
        if (!borrowed) { releaseOld2(c, tagOff(t), ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "ar" + toStr(j)); }
        asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, tagOff(t), 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(t), 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine);
        j = j + 1;
    }
}

// 标签 0..4（未初始化、int、float、bool、None）一定不是堆引用（__tx_is_heapref 自 5 起，store_abi.tx），先用一次
// 字节比较放过，其余照 releaseOld2 查表。只用于泄漏修复新增的热路径（泄漏检查设计 §六-7）。
function releaseOldQuick2(c: Ref<Ctx>, aOff: int, suffix: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 3, -1, 0, aOff, 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [rbx + " + toStr(aOff) + "], 4"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jbe", 1, asStructuredTarget(suffix), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jbe " + suffix); }
    releaseOld2(c, aOff, suffix);
}

function releaseOld2(c: Ref<Ctx>, aOff: int, suffix: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 2), asStructuredMem(0, 3, -1, 0, aOff, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx edx, byte ptr [rbx + " + toStr(aOff) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_is_heapref"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rip + __tx_is_heapref]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 1, 2, 0, 0, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [rcx + rdx], 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(suffix), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + suffix); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, aOff, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rbx + " + toStr(aOff) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_release"); }
    if (c.nativeMode == 1) { asProducerLabel(1, suffix, c.recordLine); } else { emitFn(c, suffix + ":"); }
}

// trap 模板（emit_gen emitTrap——__tx_trap(fn,pc,code,msg_ptr,msg_len)；win64）
function trapTpl2(c: Ref<Ctx>, pc: int, code: int, msgIdx: int, msgLen: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 1), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov ecx, " + toStr(c.fnIdx)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(pc)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(code), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(code)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 9), asStructuredMem(2, -1, -1, 0, 0, 1, ".Lmsg" + toStr(msgIdx)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea r9, [rip + .Lmsg" + toStr(msgIdx) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(msgLen), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(msgLen)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_trap"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_trap"); }
}

// —— 定宽数值运算族的内联发射（O4 第二步，设计 §七-4）——
// 快路径：两侧标签已知或经一次比较确认后，在 rax（f32 在 xmm0）里运算，溢出、除零、计数越界只多一条比较与
// 条件跳转，跳到本运算的冷路径；冷路径调用运行期例程 __tx_fw_slow 重算——它给出带类型的 trap 文案，也兜住
// 标签不符的情形——所以不为每个运算各生成一份 trap 消息块。文本模式（与 Zig emit_gen 对照）只发冷路径。
function fwR(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function fwD(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function fwImm(v: int): Ref<Operand> { return asStructuredImm(v); }
function fwPay(slot: int): Ref<Operand> { return asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""); }
function fwI2(c: Ref<Ctx>, mn: string, a: Ref<Operand>, b: Ref<Operand>): void { asProducerInstruction(1, mn, 2, a, b, asStructuredMissing(), c.recordLine); }
function fwI1(c: Ref<Ctx>, mn: string, a: Ref<Operand>): void { asProducerInstruction(1, mn, 1, a, asStructuredMissing(), asStructuredMissing(), c.recordLine); }
function fwJ(c: Ref<Ctx>, cond: string, label: string): void { asProducerInstruction(1, cond, 1, asStructuredTarget(label), asStructuredMissing(), asStructuredMissing(), c.recordLine); }

function fwSlowCall(c: Ref<Ctx>, pc: int, na: int, nb: int, nc: int, fop: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(fop), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(fop)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(na), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(na)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(nb), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(nb)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 48, 0, ""), asStructuredImm(nc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 48], " + toStr(nc)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_fw_slow"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_fw_slow"); }
}

// 窄整数的结果须落在类型范围：有符号按宽度符号扩展后不变，u8/u16 不超过上界（无符号比较，负数即越界），u32 高 32 位为零。
function fwRangeCheck(c: Ref<Ctx>, t: int, cold: string): void {
    if (t == 1 || t == 2 || t == 3) {
        let sh = 32;
        if (t == 1) { sh = 56; }
        if (t == 2) { sh = 48; }
        fwI2(c, "mov", fwR(2), fwR(0)); fwI2(c, "shl", fwR(2), fwImm(sh)); fwI2(c, "sar", fwR(2), fwImm(sh));
        fwI2(c, "cmp", fwR(2), fwR(0)); fwJ(c, "jne", cold);
    } else if (t == 4 || t == 5) {
        let hi = 255;
        if (t == 5) { hi = 65535; }
        fwI2(c, "cmp", fwR(0), fwImm(hi)); fwJ(c, "ja", cold);
    } else if (t == 6) {
        fwI2(c, "mov", fwR(2), fwR(0)); fwI2(c, "shr", fwR(2), fwImm(32)); fwJ(c, "jne", cold);
    }
}

// 截到宽度（环绕运算、<<、~、>>> 的结果）：有符号符号扩展，无符号零扩展，64 位不变。
function fwWrap(c: Ref<Ctx>, t: int): void {
    if (t == 1) { fwI2(c, "shl", fwR(0), fwImm(56)); fwI2(c, "sar", fwR(0), fwImm(56)); }
    if (t == 2) { fwI2(c, "shl", fwR(0), fwImm(48)); fwI2(c, "sar", fwR(0), fwImm(48)); }
    if (t == 3) { fwI2(c, "shl", fwR(0), fwImm(32)); fwI2(c, "sar", fwR(0), fwImm(32)); }
    if (t == 4) { fwI2(c, "and", fwR(0), fwImm(255)); }
    if (t == 5) { fwI2(c, "and", fwR(0), fwImm(65535)); }
    if (t == 6) { fwI2(c, "mov", fwD(0), fwD(0)); }
}

function fwBitsOf(t: int): int {
    if (t == 1 || t == 4) { return 8; }
    if (t == 2 || t == 5) { return 16; }
    if (t == 3 || t == 6) { return 32; }
    return 64;
}

function renderFwop(c: Ref<Ctx>, pc: int, rec: List<string>): void {
    const na = toInt(listGet(rec, 3) catch "0");
    const nb = toInt(listGet(rec, 4) catch "0");
    const nc = toInt(listGet(rec, 5) catch "0");
    const fop = toInt(listGet(rec, 6) catch "0");
    const t1 = toInt(listGet(rec, 7) catch "0");
    const t2 = toInt(listGet(rec, 8) catch "0");
    const dnr = toInt(listGet(rec, 9) catch "0");
    if (c.nativeMode != 1) { fwSlowCall(c, pc, na, nb, nc, fop); return; }
    const t = (fop - 256) / 16;
    const o = (fop - 256) % 16;
    const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
    const cold = lbl + "fwc";
    const done = lbl + "fwd";
    let want = 1;
    if (t == 10) { want = 2; }
    const unary = o == 5 || o == 6;
    if (t1 != want) {
        fwI2(c, "movzx", fwD(0), asStructuredMem(0, 3, -1, 0, tagOff(nb), 0, "")); fwI2(c, "cmp", fwD(0), fwImm(want)); fwJ(c, "jne", cold);
    }
    if (!unary && nc != nb && t2 != want) {
        fwI2(c, "movzx", fwD(0), asStructuredMem(0, 3, -1, 0, tagOff(nc), 0, "")); fwI2(c, "cmp", fwD(0), fwImm(want)); fwJ(c, "jne", cold);
    }
    let tagOut = 1;
    if (t == 10) {
        let fm = "addsd";
        if (o == 1) { fm = "subsd"; }
        if (o == 2) { fm = "mulsd"; }
        if (o == 3) { fm = "divsd"; }
        fwI2(c, "movsd", asStructuredReg(3, 0), fwPay(nb)); fwI2(c, fm, asStructuredReg(3, 0), fwPay(nc));
        fwI2(c, "cvtsd2ss", asStructuredReg(3, 0), asStructuredReg(3, 0)); fwI2(c, "cvtss2sd", asStructuredReg(3, 0), asStructuredReg(3, 0));
        fwI2(c, "movq", fwR(15), asStructuredReg(3, 0));
        tagOut = 2;
    } else {
        const wide64 = t == 7 || t == 9;
        if (o == 0 || o == 1 || o == 10 || o == 11) {
            let mn = "add";
            if (o == 1 || o == 11) { mn = "sub"; }
            fwI2(c, "mov", fwR(0), fwPay(nb)); fwI2(c, mn, fwR(0), fwPay(nc));
            if (o >= 10) { fwWrap(c, t); }
            else if (wide64) { fwJ(c, "jb", cold); }
            else if (t == 8) { fwJ(c, "jo", cold); }
            else { fwRangeCheck(c, t, cold); }
        } else if (o == 2 || o == 12) {
            if (o == 2 && wide64) {
                fwI2(c, "mov", fwR(0), fwPay(nb)); fwI2(c, "mov", fwR(1), fwPay(nc)); fwI1(c, "mul", fwR(1)); fwJ(c, "jo", cold);
            } else {
                fwI2(c, "mov", fwR(0), fwPay(nb)); fwI2(c, "imul", fwR(0), fwPay(nc));
                if (o == 12) { fwWrap(c, t); }
                else if (t == 8) { fwJ(c, "jo", cold); }
                else { fwRangeCheck(c, t, cold); }
            }
        } else if (o == 3 || o == 4) {
            fwI2(c, "mov", fwR(1), fwPay(nc)); fwI2(c, "test", fwR(1), fwR(1)); fwJ(c, "je", cold);
            if (wide64) {
                fwI2(c, "mov", fwR(0), fwPay(nb)); fwI2(c, "xor", fwD(2), fwD(2)); fwI1(c, "div", fwR(1));
            } else {
                if (t == 8) { fwI2(c, "cmp", fwR(1), fwImm(-1)); fwJ(c, "je", cold); }
                fwI2(c, "mov", fwR(0), fwPay(nb)); asProducerInstruction(1, "cqo", 0, asStructuredMissing(), asStructuredMissing(), asStructuredMissing(), c.recordLine); fwI1(c, "idiv", fwR(1));
            }
            // 余数的绝对值小于除数，无符号的商不大于被除数；只有有符号窄整数的“最小值 / −1”越界。
            if (o == 4) { fwI2(c, "mov", fwR(0), fwR(2)); }
            else if (t == 1 || t == 2 || t == 3) { fwRangeCheck(c, t, cold); }
        } else if (o == 5) {
            fwI2(c, "mov", fwR(0), fwPay(nb)); fwI1(c, "neg", fwR(0));
            if (t == 8) { fwJ(c, "jo", cold); } else { fwRangeCheck(c, t, cold); }
        } else if (o == 6) {
            fwI2(c, "mov", fwR(0), fwPay(nb)); fwI1(c, "not", fwR(0)); fwWrap(c, t);
        } else {
            // 移位 7 <<、8 >>、9 >>>：计数按无符号与“宽度−1”比较，负数与过大一并走冷路径（4016）。
            fwI2(c, "mov", fwR(1), fwPay(nc)); fwI2(c, "cmp", fwR(1), fwImm(fwBitsOf(t) - 1)); fwJ(c, "ja", cold);
            fwI2(c, "mov", fwR(0), fwPay(nb));
            const signedT = t == 1 || t == 2 || t == 3 || t == 8;
            if (o == 7) { fwI2(c, "shl", fwR(0), asStructuredReg(2, 1)); fwWrap(c, t); }
            else if (o == 8) {
                if (signedT) { fwI2(c, "sar", fwR(0), asStructuredReg(2, 1)); } else { fwI2(c, "shr", fwR(0), asStructuredReg(2, 1)); }
            } else {
                if (t == 1) { fwI2(c, "and", fwR(0), fwImm(255)); }
                if (t == 2) { fwI2(c, "and", fwR(0), fwImm(65535)); }
                if (t == 3) { fwI2(c, "mov", fwD(0), fwD(0)); }
                fwI2(c, "shr", fwR(0), asStructuredReg(2, 1));
                if (t == 1 || t == 2 || t == 3) { fwWrap(c, t); }
            }
        }
        fwI2(c, "mov", fwR(15), fwR(0));
    }
    if (dnr == 0) { releaseOld2(c, tagOff(na), lbl + "fwr"); }
    fwI2(c, "mov", fwPay(na), fwR(15));
    fwI2(c, "mov", asStructuredMem(1, 3, -1, 0, tagOff(na), 0, ""), fwImm(tagOut));
    fwJ(c, "jmp", done);
    asProducerLabel(1, cold, c.recordLine);
    fwSlowCall(c, pc, na, nb, nc, fop);
    asProducerLabel(1, done, c.recordLine);
}

function allocFor2(owners: List<int>, slot: int): int {
    const n = listLen(owners);
    let i: int = 0;
    while (i < n) {
        if ((listGet(owners, i) catch NO) == slot) { return i; }
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        if ((listGet(owners, i) catch NO) == NO) { return i; }
        i = i + 1;
    }
    return -1;
}

function releaseOwner2(owners: List<int>, slot: int): void {
    const n = listLen(owners);
    let i: int = 0;
    while (i < n) {
        if ((listGet(owners, i) catch NO) == slot) { listSet(owners, i, NO); return; }
        i = i + 1;
    }
}

// planRun2 —— regalloc.zig planRun 镜像（regallocmirror.tx V0.42-B2 同源移植；
// 输入＝当前 run 缓冲记录面，输出＝逐 pos b/c/def Loc 码＋下标平行表＋段界
// 物化清单。算法逐行同构：首扫末触＋def 标记 → hold-adjust → 主扫 GP/XMM
// 占用装填〔类冲突降级粘滞内存／池耗尽降级〕→ 位置末释放 → 装配）。
function planRun2(c: Ref<Ctx>): void {
    const rcnt = c.regCount;
    const len = c.runLen;
    const fused = c.runFused;

    let last_use: List<int> = listNew();
    let slot_cls: List<int> = listNew();
    let def_happened: List<int> = listNew();
    let last_def_tag: List<int> = listNew();
    let loc_code: List<int> = listNew();
    let loc_idx: List<int> = listNew();
    let i: int = 0;
    while (i < rcnt) {
        listPush(last_use, NO);
        listPush(slot_cls, 0);
        listPush(def_happened, 0);
        listPush(last_def_tag, 0);
        listPush(loc_code, 0);
        listPush(loc_idx, 0);
        i = i + 1;
    }

    // 首扫：末触位置＋def 标记（无槽位哨兵见 emNoSlot）。
    let p: int = 0;
    while (p < len) {
        const nu = iat(c.runNuses, p);
        let ui: int = 0;
        while (ui < nu) {
            let sl: int = emNoSlot();
            if (ui == 0) { sl = iat(c.runU0, p); } else { sl = iat(c.runU1, p); }
            if (sl != emNoSlot() && sl < rcnt) {
                listSet(last_use, sl, p);
            }
            ui = ui + 1;
        }
        let fused_cmp0: int = 0;
        if (fused == 1 && p + 1 == len - 1) { fused_cmp0 = 1; }
        const dv0 = iat(c.runDef, p);
        if (dv0 != emNoSlot() && fused_cmp0 == 0 && dv0 < rcnt) {
            listSet(last_use, dv0, p);
            listSet(def_happened, dv0, 1);
            listSet(last_def_tag, dv0, iat(c.runNt, p));
        }
        p = p + 1;
    }
    // hold-adjust：段界需物化的 def 槽位寄存器持到段尾。
    let i2: int = 0;
    while (i2 < rcnt) {
        if (iat(def_happened, i2) == 1 && i2 < listLen(c.liveBmp) && iat(c.liveBmp, i2) != 0) {
            listSet(last_use, i2, len - 1);
        }
        i2 = i2 + 1;
    }

    // 主扫：GP/XMM 占用表＋逐位置装填。
    let gp_owner: List<int> = listNew();
    let xmm_owner: List<int> = listNew();
    i = 0;
    while (i < 8) { listPush(gp_owner, NO); i = i + 1; }
    i = 0;
    while (i < 6) { listPush(xmm_owner, NO); i = i + 1; }

    p = 0;
    while (p < len) {
        const nu = iat(c.runNuses, p);
        let fused_cmp: int = 0;
        if (fused == 1 && p + 1 == len - 1) { fused_cmp = 1; }
        let ui: int = 0;
        while (ui < nu) {
            let sl: int = emNoSlot();
            if (ui == 0) { sl = iat(c.runU0, p); } else { sl = iat(c.runU1, p); }
            if (sl == emNoSlot() || sl >= rcnt) { ui = ui + 1; continue; }
            let stag: int = 0;
            if (ui == 0) { stag = iat(c.runT0, p); } else { stag = iat(c.runT1, p); }
            let ucls: int = 1;
            if (stag == 2) { ucls = 2; }
            if (iat(slot_cls, sl) == 3) {
                if (iat(loc_code, sl) == 0) { listSet(loc_code, sl, 1); }
                ui = ui + 1;
                continue;
            }
            if (iat(slot_cls, sl) != 0 && iat(slot_cls, sl) != ucls) {
                listSet(slot_cls, sl, 3);
                const lc0 = iat(loc_code, sl);
                if (lc0 == 2) { releaseOwner2(gp_owner, sl); }
                if (lc0 == 3) { releaseOwner2(xmm_owner, sl); }
                listSet(loc_code, sl, 1);
                ui = ui + 1;
                continue;
            }
            listSet(slot_cls, sl, ucls);
            if (iat(loc_code, sl) != 0) { ui = ui + 1; continue; }
            let want_xmm: int = 0;
            if (ucls == 2) { want_xmm = 1; }
            let got: int = -1;
            if (want_xmm == 1) { got = allocFor2(xmm_owner, sl); } else { got = allocFor2(gp_owner, sl); }
            if (got >= 0) {
                if (want_xmm == 1) {
                    listSet(xmm_owner, got, sl);
                    listSet(loc_code, sl, 3);
                    listSet(loc_idx, sl, got);
                } else {
                    listSet(gp_owner, got, sl);
                    listSet(loc_code, sl, 2);
                    listSet(loc_idx, sl, got);
                }
            } else {
                listSet(loc_code, sl, 1);
            }
            ui = ui + 1;
        }
        const dv = iat(c.runDef, p);
        if (dv != emNoSlot() && fused_cmp == 0 && dv < rcnt) {
            const dtag = iat(c.runNt, p);
            let dcls: int = 1;
            if (dtag == 2) { dcls = 2; }
            if (iat(slot_cls, dv) == 3) {
                if (iat(loc_code, dv) == 0) { listSet(loc_code, dv, 1); }
            } else {
                if (iat(slot_cls, dv) != 0 && iat(slot_cls, dv) != dcls) {
                    listSet(slot_cls, dv, 3);
                    const lc1 = iat(loc_code, dv);
                    if (lc1 == 2) { releaseOwner2(gp_owner, dv); }
                    if (lc1 == 3) { releaseOwner2(xmm_owner, dv); }
                    listSet(loc_code, dv, 1);
                } else {
                    if (iat(slot_cls, dv) == 0) { listSet(slot_cls, dv, dcls); }
                    if (iat(loc_code, dv) == 0) {
                        let want2: int = 0;
                        if (dcls == 2) { want2 = 1; }
                        let got2: int = -1;
                        if (want2 == 1) { got2 = allocFor2(xmm_owner, dv); } else { got2 = allocFor2(gp_owner, dv); }
                        if (got2 >= 0) {
                            if (want2 == 1) {
                                listSet(xmm_owner, got2, dv);
                                listSet(loc_code, dv, 3);
                                listSet(loc_idx, dv, got2);
                            } else {
                                listSet(gp_owner, got2, dv);
                                listSet(loc_code, dv, 2);
                                listSet(loc_idx, dv, got2);
                            }
                        } else {
                            listSet(loc_code, dv, 1);
                        }
                    }
                }
            }
        }
        // 位置末：末触已过的槽释放寄存器。
        i = 0;
        while (i < 8) {
            const ow = iat(gp_owner, i);
            if (ow != NO && iat(last_use, ow) <= p) { listSet(gp_owner, i, NO); }
            i = i + 1;
        }
        i = 0;
        while (i < 6) {
            const ow = iat(xmm_owner, i);
            if (ow != NO && iat(last_use, ow) <= p) { listSet(xmm_owner, i, NO); }
            i = i + 1;
        }
        p = p + 1;
    }

    // 装配：逐 pos b/c/def Loc＋段界物化清单（regallocmirror E 行同构——
    // 本移植直接写平行表）。
    c.pbC = listNew(); c.pbI = listNew(); c.pcC = listNew(); c.pcI = listNew();
    c.pdC = listNew(); c.pdI = listNew();
    c.stSlot = listNew(); c.stC = listNew(); c.stI = listNew(); c.stTag = listNew();
    p = 0;
    while (p < len) {
        const nu = iat(c.runNuses, p);
        let ui: int = 0;
        while (ui < 2) {
            let code: int = 0;
            let idx: int = 0;
            if (ui < nu) {
                let sl: int = emNoSlot();
                if (ui == 0) { sl = iat(c.runU0, p); } else { sl = iat(c.runU1, p); }
                if (sl != emNoSlot() && sl < rcnt) {
                    code = iat(loc_code, sl);
                    idx = iat(loc_idx, sl);
                }
            }
            if (ui == 0) { listPush(c.pbC, code); listPush(c.pbI, idx); }
            else { listPush(c.pcC, code); listPush(c.pcI, idx); }
            ui = ui + 1;
        }
        const dv = iat(c.runDef, p);
        let fused_cmp2: int = 0;
        if (fused == 1 && p + 1 == len - 1) { fused_cmp2 = 1; }
        if (dv != emNoSlot() && fused_cmp2 == 0 && dv < rcnt) {
            listPush(c.pdC, iat(loc_code, dv));
            listPush(c.pdI, iat(loc_idx, dv));
        } else {
            listPush(c.pdC, 0);
            listPush(c.pdI, 0);
        }
        p = p + 1;
    }
    i = 0;
    while (i < rcnt) {
        if (iat(def_happened, i) == 1) {
            const lc = iat(loc_code, i);
            if (lc == 2 || lc == 3) {
                if (i < listLen(c.liveBmp) && iat(c.liveBmp, i) != 0) {
                    listPush(c.stSlot, i);
                    listPush(c.stC, lc);
                    listPush(c.stI, iat(loc_idx, i));
                    listPush(c.stTag, iat(last_def_tag, i));
                    if (lc == 2 && iat(loc_idx, i) >= 4) { c.planHighGp = 1; }
                }
            }
        }
        i = i + 1;
    }
    // r12/r13 占用检测（emitFunction ir_uses_r12r13 同款——b/c/def/stores 全扫描）。
    i = 0;
    while (i < listLen(c.pbC)) {
        if (iat(c.pbC, i) == 2 && iat(c.pbI, i) >= 4) { c.planHighGp = 1; }
        if (iat(c.pcC, i) == 2 && iat(c.pcI, i) >= 4) { c.planHighGp = 1; }
        if (iat(c.pdC, i) == 2 && iat(c.pdI, i) >= 4) { c.planHighGp = 1; }
        i = i + 1;
    }
}

// 操作数首触装载镜像（emit_gen irOperandReg——返回寄存器名；none/mem＝空串）
function operandReg2(c: Ref<Ctx>, slot: int, code: int, idx: int): string {
    if (code == 2) {
        if (iat(c.runLoaded, slot) == 0) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(gname(idx)), asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + gname(idx) + ", [rbx + " + toStr(payloadOff(slot)) + "]"); }
            listSet(c.runLoaded, slot, 1);
        }
        return gname(idx);
    }
    if (code == 3) {
        if (iat(c.runLoaded, slot) == 0) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asStructuredReg(3, 2 + idx), asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd xmm" + toStr(2 + idx) + ", [rbx + " + toStr(payloadOff(slot)) + "]"); }
            listSet(c.runLoaded, slot, 1);
        }
        return "xmm" + toStr(2 + idx);
    }
    return "";
}

// ALU 第二操作数形态镜像（emit_gen irCForm——未装载＝mem 形态空串）
function cForm2(c: Ref<Ctx>, slot: int, code: int, idx: int): string {
    if (code == 2 && iat(c.runLoaded, slot) != 0) { return gname(idx); }
    if (code == 3 && iat(c.runLoaded, slot) != 0) { return "xmm" + toStr(2 + idx); }
    return "";
}

// def 落点簿记镜像（emit_gen irDefMark——ot==0 → release-old＋tag 先行落盘）
function defMark2(c: Ref<Ctx>, pc: int, slot: int, dcode: int, didx: int, ot: int, nt: int): void {
    if (ot == 0) {
        releaseOld2(c, tagOff(slot), ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "nrl");
        if (dcode == 2 || dcode == 3) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(slot), 0, ""), asStructuredImm(nt), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(slot)) + "], " + toStr(nt)); }
        }
    }
    if (dcode == 2 || dcode == 3) {
        listSet(c.runLoaded, slot, 1);
        listSet(c.runDefined, slot, 1);
    }
}

// GP 值写入 def 落点镜像（emit_gen irStoreGp——reg 驻留＝零发射）
function storeGp2(c: Ref<Ctx>, slot: int, dcode: int, didx: int, reg: string, tag: int): void {
    if (dcode == 2) { return; }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asProducerRegister(reg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(slot)) + "], " + reg); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(slot), 0, ""), asStructuredImm(tag), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(slot)) + "], " + toStr(tag)); }
}

// XMM 值写入 def 落点镜像（emit_gen irStoreXmm——xmm 驻留＝零发射；mem＝movq rax 中转＋tag 双写）
function storeXmm2(c: Ref<Ctx>, slot: int, dcode: int, didx: int, xmm: string, tag: int): void {
    if (dcode == 3) { return; }
    if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(0, 0), asProducerRegister(xmm), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq rax, " + xmm); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(slot)) + "], rax"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(slot), 0, ""), asStructuredImm(tag), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(slot)) + "], " + toStr(tag)); }
}

// fval 位型文本校验（D96 v0.2 §二-6——非空纯十进制数字串，≤20 位＝u64 十进制上界）
function isDigitText(s: string): bool {
    const n = len(s);
    if (n == 0 || n > 20) { return false; }
    let i: int = 0;
    while (i < n) {
        const d = (byteAt(s, i) catch 0) - 48;
        if (d < 0 || d > 9) { return false; }
        i = i + 1;
    }
    return true;
}

// 出口物化渲染（emit_gen irEmitExitStores 同构——planRun2 stSlot/stC/stI/stTag 平行表）
function renderExitStores2(c: Ref<Ctx>): void {
    let k: int = 0;
    while (k < listLen(c.stSlot)) {
        const slot = iat(c.stSlot, k);
        const sc = iat(c.stC, k);
        const si = iat(c.stI, k);
        const stag = iat(c.stTag, k);
        if (sc == 2) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asProducerRegister(gname(si)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(slot)) + "], " + gname(si)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(slot), 0, ""), asStructuredImm(stag), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(slot)) + "], " + toStr(stag)); }
        } else {
            if (sc == 3) {
                if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(0, 0), asStructuredReg(3, 2 + si), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq rax, xmm" + toStr(2 + si)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(slot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(slot)) + "], rax"); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(slot), 0, ""), asStructuredImm(stag), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(slot)) + "], " + toStr(stag)); }
            }
        }
        k = k + 1;
    }
}

// 融合裸比较（emit_gen irEmitBareCompare 同构——stores 先行由调用方负责）
function renderBareCompare2(c: Ref<Ctx>, pos: int): void {
    const kind = sat(c.runKind, pos);
    const u0 = iat(c.runU0, pos);
    const u1 = iat(c.runU1, pos);
    const breg = operandReg2(c, u0, iat(c.pbC, pos), iat(c.pbI, pos));
    const creg = cForm2(c, u1, iat(c.pcC, pos), iat(c.pcI, pos));
    let isF: int = 0;
    if (kind == "lt_f" || kind == "le_f" || kind == "eq_f") { isF = 1; }
    if (isF == 1) {
        if (breg != "") {
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asProducerRegister(breg), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd " + breg + ", " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asProducerRegister(breg), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd " + breg + ", [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asStructuredReg(3, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd xmm0, [rbx + " + toStr(payloadOff(u0)) + "]"); }
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asStructuredReg(3, 0), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd xmm0, " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asStructuredReg(3, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd xmm0, [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        }
    } else {
        if (breg != "") {
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asProducerRegister(breg), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp " + breg + ", " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asProducerRegister(breg), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp " + breg + ", qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, [rbx + " + toStr(payloadOff(u0)) + "]"); }
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 0), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rax, " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rax, qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        }
    }
}

// 融合分支 jcc（emit_gen 融合分支臂同构——int/eq 单 jcc；float NaN 防护双 jcc＋fall 标签）
function renderFusedBranch2(c: Ref<Ctx>, pos: int): void {
    const kind = sat(c.runKind, pos);
    const cmpKind = sat(c.runKind, pos - 1);
    const pc = iat(c.runPc, pos);
    let tgt = ".L" + toStr(c.fnIdx) + "_" + toStr(iat(c.runBx, pos));
    const sredir: string = sblRedirectTarget(c, iat(c.runPc, pos), iat(c.runBx, pos));
    if (sredir != "") { tgt = sredir; }
    const fall = ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "fnf";
    let jt: int = 0;
    if (kind == "jt_b") { jt = 1; }
    if (cmpKind == "lt_i") {
        if (jt == 1) { if (c.nativeMode == 1) { asProducerInstruction(1, "jl", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jl " + tgt); } } else { if (c.nativeMode == 1) { asProducerInstruction(1, "jge", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jge " + tgt); } }
        return;
    }
    if (cmpKind == "le_i") {
        if (jt == 1) { if (c.nativeMode == 1) { asProducerInstruction(1, "jle", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jle " + tgt); } } else { if (c.nativeMode == 1) { asProducerInstruction(1, "jg", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jg " + tgt); } }
        return;
    }
    if (cmpKind == "eq_i" || cmpKind == "eq_b") {
        if (jt == 1) { if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + tgt); } } else { if (c.nativeMode == 1) { asProducerInstruction(1, "jne", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jne " + tgt); } }
        return;
    }
    if (cmpKind == "lt_f") {
        if (jt == 1) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(fall), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + fall); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "jb", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jb " + tgt); }
            if (c.nativeMode == 1) { asProducerLabel(1, fall, c.recordLine); } else { emitFn(c, fall + ":"); }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + tgt); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "jae", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jae " + tgt); }
        }
        return;
    }
    if (cmpKind == "le_f") {
        if (jt == 1) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(fall), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + fall); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "jbe", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jbe " + tgt); }
            if (c.nativeMode == 1) { asProducerLabel(1, fall, c.recordLine); } else { emitFn(c, fall + ":"); }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + tgt); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "ja", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ja " + tgt); }
        }
        return;
    }
    if (cmpKind == "eq_f") {
        if (jt == 1) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(fall), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + fall); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + tgt); }
            if (c.nativeMode == 1) { asProducerLabel(1, fall, c.recordLine); } else { emitFn(c, fall + ":"); }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "jp", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jp " + tgt); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "jne", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jne " + tgt); }
        }
        return;
    }
    addRej(c, c.fnIdx, pc, "E009", "fused_cmp_pair_" + cmpKind);
}

// 段内条件跳转（emit_gen jf_b/jt_b 臂同构——cmp 0〔gp 驻留或 mem 形〕＋jcc）
function renderBranch2(c: Ref<Ctx>, pos: int): void {
    const kind = sat(c.runKind, pos);
    const u0 = iat(c.runU0, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    let jcc: string = "je";
    if (kind == "jt_b") { jcc = "jne"; }
    if (dbc == 2) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asProducerRegister(gname(dbi)), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp " + gname(dbi) + ", 0"); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp qword ptr [rbx + " + toStr(payloadOff(u0)) + "], 0"); }
    }
    // A16 修复（V0.49-S4-②）：IR 段内条件跳转＝emit_gen .jf_b/.jt_b IR 臂
    // 逐字节——直跳 .L{fn}_{bx}，无 strbld 出口重定向（重定向仅存在于
    // zig 融合分支位与 legacy jt/jf 臂——renderFusedBranch2/jcc/jcc_u）。
    if (c.nativeMode == 1) { asProducerInstruction(1, jcc, 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(iat(c.runBx, pos))), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + jcc + " .L" + toStr(c.fnIdx) + "_" + toStr(iat(c.runBx, pos))); }
}

// 物化比较（emit_gen lt_i..eq_f 非融合臂同构——setcc＋movzx；float 加 setnp 无序防护）
function renderCompare2(c: Ref<Ctx>, pos: int): void {
    const kind = sat(c.runKind, pos);
    const pc = iat(c.runPc, pos);
    const u0 = iat(c.runU0, pos);
    const u1 = iat(c.runU1, pos);
    const dslot = iat(c.runDef, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const dcc = iat(c.pcC, pos);
    const dci = iat(c.pcI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    let isF: int = 0;
    if (kind == "lt_f" || kind == "le_f" || kind == "eq_f") { isF = 1; }
    let mn: string = "sete";
    if (kind == "lt_i") { mn = "setl"; }
    if (kind == "le_i") { mn = "setle"; }
    if (kind == "lt_f") { mn = "setb"; }
    if (kind == "le_f") { mn = "setbe"; }
    const breg = operandReg2(c, u0, dbc, dbi);
    const creg = cForm2(c, u1, dcc, dci);
    defMark2(c, pc, dslot, ddc, ddi, ot, nt);
    if (isF == 1) {
        if (breg != "") {
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asProducerRegister(breg), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd " + breg + ", " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asProducerRegister(breg), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd " + breg + ", [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asStructuredReg(3, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd xmm0, [rbx + " + toStr(payloadOff(u0)) + "]"); }
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asStructuredReg(3, 0), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd xmm0, " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "ucomisd", 2, asStructuredReg(3, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ucomisd xmm0, [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        }
        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 1, asStructuredReg(2, 0), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " al"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "setnp", 1, asStructuredReg(2, 1), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  setnp cl"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "and", 2, asStructuredReg(2, 0), asStructuredReg(2, 1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  and al, cl"); }
    } else {
        if (breg != "") {
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asProducerRegister(breg), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp " + breg + ", " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asProducerRegister(breg), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp " + breg + ", qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, [rbx + " + toStr(payloadOff(u0)) + "]"); }
            if (creg != "") {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 0), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rax, " + creg); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rax, qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
            }
        }
        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 1, asStructuredReg(2, 0), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " al"); }
    }
    let dreg32: string = "eax";
    if (ddc == 2) { dreg32 = gname32(ddi); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asProducerRegister(dreg32), asStructuredReg(2, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx " + dreg32 + ", al"); }
    if (ddc != 2) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], 3"); }
    }
}

// float 算术（emit_gen add_f/sub_f/mul_f 臂同构——无陷阱面）
function renderFloatArith2(c: Ref<Ctx>, pos: int): void {
    const kind = sat(c.runKind, pos);
    const u0 = iat(c.runU0, pos);
    const u1 = iat(c.runU1, pos);
    const dslot = iat(c.runDef, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const dcc = iat(c.pcC, pos);
    const dci = iat(c.pcI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    let mn: string = "mulsd";
    if (kind == "add_f") { mn = "addsd"; }
    if (kind == "sub_f") { mn = "subsd"; }
    const breg = operandReg2(c, u0, dbc, dbi);
    const creg = cForm2(c, u1, dcc, dci);
    defMark2(c, iat(c.runPc, pos), dslot, ddc, ddi, ot, nt);
    let acc: string = "xmm0";
    if (ddc == 3) { acc = "xmm" + toStr(2 + ddi); }
    if (breg != "") {
        if (breg != acc) { if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asProducerRegister(acc), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd " + acc + ", " + breg); } }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asProducerRegister(acc), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd " + acc + ", [rbx + " + toStr(payloadOff(u0)) + "]"); }
    }
    if (creg != "") {
        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 2, asProducerRegister(acc), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " " + acc + ", " + creg); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 2, asProducerRegister(acc), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " " + acc + ", [rbx + " + toStr(payloadOff(u1)) + "]"); }
    }
    storeXmm2(c, dslot, ddc, ddi, acc, 2);
}

// float 取负（emit_gen neg_f 臂同构——GP 中转符号位翻转；V0.49-S4-②
// 闭包扩面：neg_f 由不可达登记转支持〔sugar-map-iter fn13 闭包可达实证〕）
function renderNegF2(c: Ref<Ctx>, pos: int): void {
    const u0 = iat(c.runU0, pos);
    const dslot = iat(c.runDef, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    const breg = operandReg2(c, u0, dbc, dbi);
    defMark2(c, iat(c.runPc, pos), dslot, ddc, ddi, ot, nt);
    let acc: string = "xmm0";
    if (ddc == 3) { acc = "xmm" + toStr(2 + ddi); }
    if (breg != "") {
        if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(0, 0), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq rax, " + breg); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asProducerRegister(acc), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd " + acc + ", [rbx + " + toStr(payloadOff(u0)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(0, 0), asProducerRegister(acc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq rax, " + acc); }
    }
    if (c.nativeMode == 1) { asProducerInstruction(1, "movabs", 2, asStructuredReg(0, 2), asStructuredImm((-9223372036854775807 - 1)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movabs rdx, -9223372036854775808"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "xor", 2, asStructuredReg(0, 0), asStructuredReg(0, 2), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  xor rax, rdx"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asProducerRegister(acc), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq " + acc + ", rax"); }
    storeXmm2(c, dslot, ddc, ddi, acc, 2);
}

// int→float 转换（emit_gen i2f_f 臂同构——GP 源→XMM 目的单指令）
function renderI2f2(c: Ref<Ctx>, pos: int): void {
    const u0 = iat(c.runU0, pos);
    const dslot = iat(c.runDef, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    const breg = operandReg2(c, u0, dbc, dbi);
    defMark2(c, iat(c.runPc, pos), dslot, ddc, ddi, ot, nt);
    let acc: string = "xmm0";
    if (ddc == 3) { acc = "xmm" + toStr(2 + ddi); }
    if (breg != "") {
        if (c.nativeMode == 1) { asProducerInstruction(1, "cvtsi2sd", 2, asProducerRegister(acc), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cvtsi2sd " + acc + ", " + breg); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "cvtsi2sd", 2, asProducerRegister(acc), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cvtsi2sd " + acc + ", qword ptr [rbx + " + toStr(payloadOff(u0)) + "]"); }
    }
    storeXmm2(c, dslot, ddc, ddi, acc, 2);
}

// float 常量装载（emit_gen loadk_float 臂同构——fval 位型文本逐字转录）
function renderLoadkFloat2(c: Ref<Ctx>, pos: int): void {
    const dslot = iat(c.runDef, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    defMark2(c, iat(c.runPc, pos), dslot, ddc, ddi, ot, nt);
    const bits = sat(c.runFval, pos);
    if (ddc == 3) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "movabs", 2, asStructuredReg(0, 0), asStructuredImm(asProducerInteger(bits)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movabs rax, " + bits); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(3, 2 + ddi), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq xmm" + toStr(2 + ddi) + ", rax"); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "movabs", 2, asStructuredReg(0, 0), asStructuredImm(asProducerInteger(bits)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movabs rax, " + bits); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(2), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], 2"); }
    }
}

// 当前 run 渲染（live 收口——planRun2＋逐 op 发射规则＋出口物化；
// 批一：分支/float 臂＋融合对渲染序——D96 v0.2 §二-4/§二-5）
function renderRun2(c: Ref<Ctx>): void {
    if (c.runLen <= 0) { return; }
    planRun2(c);
    let branchEnd: int = 0;
    const lastKind = sat(c.runKind, c.runLen - 1);
    if (lastKind == "jf_b" || lastKind == "jt_b") { branchEnd = 1; }
    let pos: int = 0;
    while (pos < c.runLen) {
        const pc = iat(c.runPc, pos);
        if (c.listing) { c.recordLine = pc + 2; }
        // run 内标签（位置对齐——每 pc 恒一标签）
        if (pos < listLen(c.runLbls) && iat(c.runLbls, pos) == pc) {
            emitSblMat2(c, pc);
            if (c.nativeMode == 1) { asProducerLabel(1, ".L" + toStr(c.fnIdx) + "_" + toStr(pc), c.recordLine); } else { emitFn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + ":"); }
        }
        const kind = sat(c.runKind, pos);
        // 融合对：裸比较在 len-2（出口物化先行）、jcc 在 len-1
        if (c.runFused == 1 && pos == c.runLen - 2) {
            renderExitStores2(c);
            renderBareCompare2(c, pos);
            pos = pos + 1;
            continue;
        }
        if (c.runFused == 1 && pos == c.runLen - 1) {
            renderFusedBranch2(c, pos);
            pos = pos + 1;
            continue;
        }
        // 非融合分支尾：出口物化先于 cmp/jcc（emit_gen is_last and branch_like）
        if (branchEnd == 1 && pos == c.runLen - 1) {
            renderExitStores2(c);
            renderBranch2(c, pos);
            pos = pos + 1;
            continue;
        }
        const u0 = iat(c.runU0, pos);
        const u1 = iat(c.runU1, pos);
        const dslot = iat(c.runDef, pos);
        const dbc = iat(c.pbC, pos);
        const dbi = iat(c.pbI, pos);
        const dcc = iat(c.pcC, pos);
        const dci = iat(c.pcI, pos);
        const ddc = iat(c.pdC, pos);
        const ddi = iat(c.pdI, pos);
        const ot = iat(c.runOt, pos);
        const nt = iat(c.runNt, pos);
        if (kind == "move") {
            const breg = operandReg2(c, u0, dbc, dbi);
            defMark2(c, pc, dslot, ddc, ddi, ot, nt);
            if (ddc == 2) {
                if (breg != "" && breg != gname(ddi)) {
                    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(gname(ddi)), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + gname(ddi) + ", " + breg); }
                } else {
                    if (breg == "") {
                        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(gname(ddi)), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + gname(ddi) + ", [rbx + " + toStr(payloadOff(u0)) + "]"); }
                    }
                }
            } else {
                if (ddc == 3) {
                    if (breg != "") { if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asStructuredReg(3, 2 + ddi), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd xmm" + toStr(2 + ddi) + ", " + breg); } }
                    else { if (c.nativeMode == 1) { asProducerInstruction(1, "movsd", 2, asStructuredReg(3, 2 + ddi), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movsd xmm" + toStr(2 + ddi) + ", [rbx + " + toStr(payloadOff(u0)) + "]"); } }
                } else {
                    if (breg != "") {
                        if (dbc == 3) {
                            if (c.nativeMode == 1) { asProducerInstruction(1, "movq", 2, asStructuredReg(0, 0), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movq rax, " + breg); }
                            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
                        } else {
                            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], " + breg); }
                        }
                    } else {
                        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, [rbx + " + toStr(payloadOff(u0)) + "]"); }
                        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
                    }
                    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(iat(c.runT0, pos)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], " + toStr(iat(c.runT0, pos))); }
                }
            }
        } else {
            if (kind == "loadk_int") {
                defMark2(c, pc, dslot, ddc, ddi, ot, nt);
                if (ddc == 2) {
                    if (c.nativeMode == 1) { asProducerInstruction(1, "movabs", 2, asProducerRegister(gname(ddi)), asStructuredImm(iat(c.runVal, pos)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movabs " + gname(ddi) + ", " + toStr(iat(c.runVal, pos))); }
                } else {
                    if (c.nativeMode == 1) { asProducerInstruction(1, "movabs", 2, asStructuredReg(0, 0), asStructuredImm(iat(c.runVal, pos)), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movabs rax, " + toStr(iat(c.runVal, pos))); }
                    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
                    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], 1"); }
                }
            } else {
                if (kind == "add_i" || kind == "sub_i" || kind == "mul_i") {
                    let mn = "imul";
                    if (kind == "add_i") { mn = "add"; }
                    if (kind == "sub_i") { mn = "sub"; }
                    const breg = operandReg2(c, u0, dbc, dbi);
                    const creg = cForm2(c, u1, dcc, dci);
                    defMark2(c, pc, dslot, ddc, ddi, ot, nt);
                    let dreg = "rax";
                    if (ddc == 2) { dreg = gname(ddi); }
                    if (breg != "") {
                        if (breg != dreg) { if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(dreg), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + dreg + ", " + breg); } }
                    } else {
                        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(dreg), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + dreg + ", [rbx + " + toStr(payloadOff(u0)) + "]"); }
                    }
                    if (creg != "") {
                        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 2, asProducerRegister(dreg), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " " + dreg + ", " + creg); }
                    } else {
                        if (c.nativeMode == 1) { asProducerInstruction(1, mn, 2, asProducerRegister(dreg), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mn + " " + dreg + ", qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
                    }
                    if (c.nativeMode == 1) { asProducerInstruction(1, "jo", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jo .L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof"); }
                    storeGp2(c, dslot, ddc, ddi, dreg, 1);
                    if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp .L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend"); }
                    if (c.nativeMode == 1) { asProducerLabel(1, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof", c.recordLine); } else { emitFn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tof:"); }
                    trapTpl2(c, pc, 4004, iat(c.runMsgI, pos), iat(c.runMsgL, pos));
                    if (c.nativeMode == 1) { asProducerLabel(1, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend", c.recordLine); } else { emitFn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "tend:"); }
                } else {
                    // 值形批（D96 v0.3 §一 1a——五 kind 发射臂逐字节对齐 emit_gen）
                    if (kind == "div_i" || kind == "mod_i") {
                        renderDivMod2(c, pos);
                    } else {
                        if (kind == "neg_i" || kind == "not_b") {
                            renderNegNot2(c, pos);
                        } else {
                            if (kind == "neg_f") {
                                renderNegF2(c, pos);
                            } else {
                                if (kind == "ldbool" || kind == "ldnone") {
                                    renderLdbool2(c, pos, kind);
                                } else {
                                    // 批一扩面（D96 v0.2 §一 1a）：比较/float/转换/常量族
                                    if (kind == "lt_i" || kind == "le_i" || kind == "eq_i" || kind == "eq_b"
                                        || kind == "lt_f" || kind == "le_f" || kind == "eq_f") {
                                        renderCompare2(c, pos);
                                    } else {
                                        if (kind == "add_f" || kind == "sub_f" || kind == "mul_f") {
                                            renderFloatArith2(c, pos);
                                        } else {
                                            if (kind == "i2f_f") {
                                                renderI2f2(c, pos);
                                            } else {
                                                if (kind == "loadk_float") {
                                                    renderLoadkFloat2(c, pos);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        pos = pos + 1;
    }
    // 出口物化（非分支尾——分支尾已在臂内先行；irEmitExitStores 同构）
    if (branchEnd == 0) { renderExitStores2(c); }
    // run 内标签表清空（下一 run 重开）
    c.runLbls = listNew();
}

// 挂起标签冲刷（非 run pc 的标签——lop 渲染前落位）
function flushPendLbls(c: Ref<Ctx>): void {
    let i: int = 0;
    const savedLine = c.recordLine;
    while (i < listLen(c.pendLbls)) {
        if (c.listing) { c.recordLine = iat(c.pendLbls, i) + 2; }
        emitSblMat2(c, iat(c.pendLbls, i));
        if (c.nativeMode == 1) { asProducerLabel(1, ".L" + toStr(c.fnIdx) + "_" + toStr(iat(c.pendLbls, i)), c.recordLine); } else { emitFn(c, ".L" + toStr(c.fnIdx) + "_" + toStr(iat(c.pendLbls, i)) + ":"); }
        i = i + 1;
    }
    c.pendLbls = listNew();
    c.recordLine = savedLine;
}

// —— 值形批渲染臂（D96 v0.3 §一 1a；emit_gen 对应臂逐字节）——

// div_i/mod_i：irCheck（debug 门控不发射）→defMark→双陷阱面（tdz 4001/tov 4004）
// →idiv 序→def 双臂；div_i 溢出陷阱后直落 tidv（emit_gen 死代码形逐字节保留）。
function renderDivMod2(c: Ref<Ctx>, pos: int): void {
    const u0 = iat(c.runU0, pos);
    const u1 = iat(c.runU1, pos);
    const dslot = iat(c.runDef, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const dcc = iat(c.pcC, pos);
    const dci = iat(c.pcI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const pc = iat(c.runPc, pos);
    const kind = sat(c.runKind, pos);
    const breg = operandReg2(c, u0, dbc, dbi);
    const creg = cForm2(c, u1, dcc, dci);
    defMark2(c, pc, dslot, ddc, ddi, ot, nt);
    if (breg != "") {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, " + breg); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, [rbx + " + toStr(payloadOff(u0)) + "]"); }
    }
    if (creg != "") {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asProducerRegister(creg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, " + creg); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, payloadOff(u1), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, qword ptr [rbx + " + toStr(payloadOff(u1)) + "]"); }
    }
    const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 1), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rcx, 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(lbl + "tdz"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + lbl + "tdz"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 1), asStructuredImm(-1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rcx, -1"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jne", 1, asStructuredTarget(lbl + "tidv"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jne " + lbl + "tidv"); }
    if (kind == "div_i") {
        // 除数为 -1：商为 -被除数；neg 只在被除数为最小值时置 OF，即“最小值 / -1”溢出（D3 §617）。
        if (c.nativeMode == 1) { asProducerInstruction(1, "neg", 1, asStructuredReg(0, 0), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  neg rax"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jo", 1, asStructuredTarget(lbl + "tov"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jo " + lbl + "tov"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(lbl + "thv"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + lbl + "thv"); }
        if (c.nativeMode == 1) { asProducerLabel(1, lbl + "tov", c.recordLine); } else { emitFn(c, lbl + "tov:"); }
        trapTpl2(c, pc, 4004, iat(c.runMsg2I, pos), iat(c.runMsg2L, pos));
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "xor", 2, asStructuredReg(1, 0), asStructuredReg(1, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  xor eax, eax"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(lbl + "thv"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + lbl + "thv"); }
    }
    if (c.nativeMode == 1) { asProducerLabel(1, lbl + "tidv", c.recordLine); } else { emitFn(c, lbl + "tidv:"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cqo", 0, asStructuredMissing(), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cqo"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "idiv", 1, asStructuredReg(0, 1), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  idiv rcx"); }
    if (kind == "mod_i") {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredReg(0, 2), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, rdx"); }
    }
    if (c.nativeMode == 1) { asProducerLabel(1, lbl + "thv", c.recordLine); } else { emitFn(c, lbl + "thv:"); }
    if (ddc == 2) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(gname(ddi)), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + gname(ddi) + ", rax"); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rbx + " + toStr(payloadOff(dslot)) + "], rax"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], 1"); }
    }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(lbl + "tend"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + lbl + "tend"); }
    if (c.nativeMode == 1) { asProducerLabel(1, lbl + "tdz", c.recordLine); } else { emitFn(c, lbl + "tdz:"); }
    trapTpl2(c, pc, 4001, iat(c.runMsgI, pos), iat(c.runMsgL, pos));
    if (c.nativeMode == 1) { asProducerLabel(1, lbl + "tend", c.recordLine); } else { emitFn(c, lbl + "tend:"); }
}

// neg_i/not_b：单 use →dreg（gp/rax）→neg/xor 1→irStoreGp 同构（int/bool tag）。
function renderNegNot2(c: Ref<Ctx>, pos: int): void {
    const u0 = iat(c.runU0, pos);
    const dslot = iat(c.runDef, pos);
    const dbc = iat(c.pbC, pos);
    const dbi = iat(c.pbI, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const pc = iat(c.runPc, pos);
    const kind = sat(c.runKind, pos);
    const breg = operandReg2(c, u0, dbc, dbi);
    defMark2(c, pc, dslot, ddc, ddi, ot, nt);
    let dreg = "rax";
    if (ddc == 2) { dreg = gname(ddi); }
    if (breg != "") {
        if (breg != dreg) { if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(dreg), asProducerRegister(breg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + dreg + ", " + breg); } }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(dreg), asStructuredMem(2, 3, -1, 0, payloadOff(u0), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + dreg + ", [rbx + " + toStr(payloadOff(u0)) + "]"); }
    }
    if (kind == "neg_i") {
        // 最小值取负溢出 trap 4004（D3 §620；消息随记录，同 add_i）。
        const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
        if (c.nativeMode == 1) { asProducerInstruction(1, "neg", 1, asProducerRegister(dreg), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  neg " + dreg); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jo", 1, asStructuredTarget(lbl + "ngo"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jo " + lbl + "ngo"); }
        storeGp2(c, dslot, ddc, ddi, dreg, 1);
        if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(lbl + "nge"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + lbl + "nge"); }
        if (c.nativeMode == 1) { asProducerLabel(1, lbl + "ngo", c.recordLine); } else { emitFn(c, lbl + "ngo:"); }
        trapTpl2(c, pc, 4004, iat(c.runMsgI, pos), iat(c.runMsgL, pos));
        if (c.nativeMode == 1) { asProducerLabel(1, lbl + "nge", c.recordLine); } else { emitFn(c, lbl + "nge:"); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "xor", 2, asProducerRegister(dreg), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  xor " + dreg + ", 1"); }
        storeGp2(c, dslot, ddc, ddi, dreg, 3);
    }
}

// ldbool/ldnone（IR 形）：def gp 32 位立即数／mem payload+tag 双写；值经 bx 域
//（ldbool）／恒 0（ldnone——A9 执行发现：emit_gen v=0、tag 4）。
function renderLdbool2(c: Ref<Ctx>, pos: int, kind: string): void {
    const dslot = iat(c.runDef, pos);
    const ddc = iat(c.pdC, pos);
    const ddi = iat(c.pdI, pos);
    const ot = iat(c.runOt, pos);
    const nt = iat(c.runNt, pos);
    const pc = iat(c.runPc, pos);
    let v: int = iat(c.runBx, pos);
    let tagv: int = 3;
    if (kind == "ldnone") { v = 0; tagv = 4; }
    defMark2(c, pc, dslot, ddc, ddi, ot, nt);
    if (ddc == 2) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asProducerRegister(gname32(ddi)), asStructuredImm(v), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov " + gname32(ddi) + ", " + toStr(v)); }
    } else {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(dslot), 0, ""), asStructuredImm(v), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(payloadOff(dslot)) + "], " + toStr(v)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(dslot), 0, ""), asStructuredImm(tagv), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(dslot)) + "], " + toStr(tagv)); }
    }
}

// 条件 retain（emit_gen emitRetainIfHeap 逐字节——reg 形）。
function emitRetainIfHeap2(c: Ref<Ctx>, reg: string, suffix: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 0), asStructuredMem(0, (asProducerRegister(reg)).num, -1, 0, 0, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx eax, byte ptr [" + reg + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 10), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_is_heapref"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea r10, [rip + __tx_is_heapref]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 10, 0, 0, 0, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [r10 + rax], 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(suffix), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + suffix); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asProducerRegister(reg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, " + reg); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_retain"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_retain"); }
    if (c.nativeMode == 1) { asProducerLabel(1, suffix, c.recordLine); } else { emitFn(c, suffix + ":"); }
}

// 条件 retain（emit_gen emitRetainIfHeapRaw 逐字节——槽偏移形）。
function emitRetainIfHeapRaw2(c: Ref<Ctx>, off: int, suffix: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 0), asStructuredMem(0, 3, -1, 0, off, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx eax, byte ptr [rbx + " + toStr(off) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 10), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_is_heapref"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea r10, [rip + __tx_is_heapref]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 10, 0, 0, 0, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [r10 + rax], 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(suffix), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + suffix); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, off, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rbx + " + toStr(off) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_retain"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_retain"); }
    if (c.nativeMode == 1) { asProducerLabel(1, suffix, c.recordLine); } else { emitFn(c, suffix + ":"); }
}

// 条件 release（emit_gen emitReleaseIfHeap 逐字节）。
function emitReleaseIfHeap2(c: Ref<Ctx>, reg: string, suffix: string): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 0), asStructuredMem(0, (asProducerRegister(reg)).num, -1, 0, 0, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx eax, byte ptr [" + reg + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 10), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_is_heapref"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea r10, [rip + __tx_is_heapref]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 10, 0, 0, 0, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [r10 + rax], 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(suffix), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + suffix); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asProducerRegister(reg), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, " + reg); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_release"); }
    if (c.nativeMode == 1) { asProducerLabel(1, suffix, c.recordLine); } else { emitFn(c, suffix + ":"); }
}

// strbld 出口物化垫（emit_gen emitStrbldMat 逐字节——出口 pc 标号前挂载）。
function emitSblMat2(c: Ref<Ctx>, pc: int): void {
    const n = listLen(c.sblIdx);
    let si: int = 0;
    while (si < n) {
        if (iat(c.sblExit, si) == pc && iat(c.sblIdx, si) == si) {
            const base = iat(c.sblBase, si) + si * 48;
            const addpc = iat(c.sblAdd, si);
            if (c.nativeMode == 1) { asProducerLabel(1, ".Lstrb" + toStr(c.fnIdx) + "_" + toStr(si), c.recordLine); } else { emitFn(c, ".Lstrb" + toStr(c.fnIdx) + "_" + toStr(si) + ":"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(1, 4, -1, 0, base + 24, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp dword ptr [rsp + " + toStr(base + 24) + "], 0"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_" + toStr(pc)), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je .L" + toStr(c.fnIdx) + "_" + toStr(pc)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, 4, -1, 0, base, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rsp + " + toStr(base) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(addpc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(addpc)); }
            if (iat(c.sblPrepend, si) == 1) {
                if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_strb_finish_pre"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_strb_finish_pre"); }
            } else {
                if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_strb_finish"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_strb_finish"); }
            }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 4, -1, 0, base + 32, 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov [rsp + " + toStr(base + 32) + "], rax"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, iat(c.sblRoot, si) * VALUE_BYTES, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rbx + " + toStr(iat(c.sblRoot, si) * VALUE_BYTES) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_release"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 4, -1, 0, base + 32, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, [rsp + " + toStr(base + 32) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, iat(c.sblRoot, si) * VALUE_BYTES + VALUE_PAYLOAD_OFFSET, 0, ""), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(iat(c.sblRoot, si) * VALUE_BYTES + VALUE_PAYLOAD_OFFSET) + "], rax"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, iat(c.sblRoot, si) * VALUE_BYTES, 0, ""), asStructuredImm(6), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(iat(c.sblRoot, si) * VALUE_BYTES) + "], 6"); }
            return;
        }
        si = si + 1;
    }
}

// strbld 出口重定向判据（emit_gen strbldRedirect 同源——cond pc＋exit target）。
function sblRedirectTarget(c: Ref<Ctx>, pc: int, target: int): string {
    // A16 修复（V0.49-S4-②）：对齐 strbldRedirect 双条件——cond_pc==pc 且
    // exit_pc==target（单条件版会在非出口目标的条件跳转误重定向——
    // sugar-forin fn1 pc82 显影；运行语义碰巧恒等但字节面分叉）。
    const n = listLen(c.sblIdx);
    let si: int = 0;
    while (si < n) {
        if (iat(c.sblCond, si) == pc && iat(c.sblExit, si) == target && iat(c.sblIdx, si) == si) {
            return ".Lstrb" + toStr(c.fnIdx) + "_" + toStr(si);
        }
        si = si + 1;
    }
    return "";
}

// callbi 通用路序列（emit_gen .callbi 通用路逐字节——7 指令）。
// —— Bytes 内联快路径（D3 v0.18；仅原生模式）——
// bytesLen/bytesGet/bytesSet/bytesPush 的常见情形直接读写对象跨度；类型不符、
// 越界、值不在 0..255、push 需要扩容时一律跳到通用 callbi，由内核给出同一
// 结果或同一 trap。Bytes 与 string 同为 Obj72 字节对象：__tx_str_bytes 返回
// &ptr（+0 ptr、+8 len、+16 cap；cap 为 0 表示未经 reserve，按 len 计）。
function bxI2(c: Ref<Ctx>, mn: string, x: Ref<Operand>, y: Ref<Operand>): void {
    asProducerInstruction(1, mn, 2, x, y, asStructuredMissing(), c.recordLine);
}
function bxJ(c: Ref<Ctx>, mn: string, target: string): void {
    asProducerInstruction(1, mn, 1, asStructuredTarget(target), asStructuredMissing(), asStructuredMissing(), c.recordLine);
}
function bxGuard(c: Ref<Ctx>, slot: int, tag: int, known: int, target: string): void {
    if (known == tag) { return; }
    bxI2(c, "movzx", asStructuredReg(1, 0), asStructuredMem(0, 3, -1, 0, tagOff(slot), 0, ""));
    bxI2(c, "cmp", asStructuredReg(1, 0), asStructuredImm(tag));
    bxJ(c, "jne", target);
}
function emitBytesInline(c: Ref<Ctx>, pc: int, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
    const slow = lbl + "bis";
    bxGuard(c, a + 1, 17, t1, slow);
    if (biId != 38) { bxGuard(c, a + 2, 1, t2, slow); }
    if (biId == 40) { bxGuard(c, a + 3, 1, -1, slow); }
    bxI2(c, "mov", asStructuredReg(1, 1), asStructuredMem(1, 3, -1, 0, payloadOff(a + 1), 0, ""));
    // bytesSet/bytesPush 取写用访问器（线程第 4b 步：冻结的 Bytes 返回 0，转通用路由内建报 4022）。
    let bytesFn = "__tx_str_bytes";
    if (biId == 40 || biId == 41) { bytesFn = "__tx_str_bytes_w"; }
    asProducerInstruction(1, "call", 1, asStructuredTarget(bytesFn), asStructuredMissing(), asStructuredMissing(), c.recordLine);
    bxI2(c, "test", asStructuredReg(0, 0), asStructuredReg(0, 0));
    bxJ(c, "je", slow);
    if (biId == 41) {
        // D3 v0.34：外部调用借用中的 Bytes（对象头 flags 位 64，在 &ptr−32）不在这里改长度，转通用路由 bytesPush 报 4024。
        bxI2(c, "mov", asStructuredReg(1, 10), asStructuredMem(1, 0, -1, 0, -32, 0, ""));
        bxI2(c, "and", asStructuredReg(1, 10), asStructuredImm(64));
        bxJ(c, "jne", slow);
    }
    if (biId == 38) { // bytesLen
        bxI2(c, "mov", asStructuredReg(0, 15), asStructuredMem(2, 0, -1, 0, 8, 0, ""));
        releaseOld2(c, tagOff(a), lbl + "bll");
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredReg(0, 15));
        bxI2(c, "mov", asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(1));
    } else if (biId == 39) { // bytesGet：界内得 int，越界（含负数，无符号比较）得 None
        bxI2(c, "mov", asStructuredReg(0, 2), asStructuredMem(2, 3, -1, 0, payloadOff(a + 2), 0, ""));
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 8, 0, ""));
        bxI2(c, "cmp", asStructuredReg(0, 2), asStructuredReg(0, 1));
        bxJ(c, "jae", lbl + "bin");
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 0, 0, ""));
        bxI2(c, "movzx", asStructuredReg(1, 15), asStructuredMem(0, 1, 2, 0, 0, 0, ""));
        releaseOld2(c, tagOff(a), lbl + "brl");
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredReg(0, 15));
        bxI2(c, "mov", asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(1));
        bxJ(c, "jmp", lbl + "bie");
        asProducerLabel(1, lbl + "bin", c.recordLine);
        releaseOld2(c, tagOff(a), lbl + "binx");
        bxI2(c, "mov", asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(4));
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredImm(0));
    } else if (biId == 40) { // bytesSet：越界或值不在 0..255 走通用路（trap）；结果槽不写
        bxI2(c, "mov", asStructuredReg(0, 2), asStructuredMem(2, 3, -1, 0, payloadOff(a + 2), 0, ""));
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 8, 0, ""));
        bxI2(c, "cmp", asStructuredReg(0, 2), asStructuredReg(0, 1));
        bxJ(c, "jae", slow);
        bxI2(c, "mov", asStructuredReg(0, 8), asStructuredMem(2, 3, -1, 0, payloadOff(a + 3), 0, ""));
        bxI2(c, "cmp", asStructuredReg(0, 8), asStructuredImm(255));
        bxJ(c, "ja", slow);
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 0, 0, ""));
        bxI2(c, "mov", asStructuredMem(0, 1, 2, 0, 0, 0, ""), asStructuredReg(2, 8));
    } else { // bytesPush：值不在 0..255 或 len ≥ cap（含 cap＝0）走通用路；结果槽不写
        bxI2(c, "mov", asStructuredReg(0, 8), asStructuredMem(2, 3, -1, 0, payloadOff(a + 2), 0, ""));
        bxI2(c, "cmp", asStructuredReg(0, 8), asStructuredImm(255));
        bxJ(c, "ja", slow);
        bxI2(c, "mov", asStructuredReg(0, 2), asStructuredMem(2, 0, -1, 0, 8, 0, ""));
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 16, 0, ""));
        bxI2(c, "cmp", asStructuredReg(0, 2), asStructuredReg(0, 1));
        bxJ(c, "jae", slow);
        bxI2(c, "mov", asStructuredReg(0, 1), asStructuredMem(2, 0, -1, 0, 0, 0, ""));
        bxI2(c, "mov", asStructuredMem(0, 1, 2, 0, 0, 0, ""), asStructuredReg(2, 8));
        bxI2(c, "add", asStructuredReg(0, 2), asStructuredImm(1));
        bxI2(c, "mov", asStructuredMem(2, 0, -1, 0, 8, 0, ""), asStructuredReg(0, 2));
    }
    bxJ(c, "jmp", lbl + "bie");
    asProducerLabel(1, slow, c.recordLine);
    emitCallbiGeneric2(c, c.fnIdx, pc, a, biId, nargs);
    asProducerLabel(1, lbl + "bie", c.recordLine);
}

// —— 紧凑列表的 listGet/listSet/listLen 内联快路径（O4 第二步 2c1b；仅原生模式）——
// codegen 只对静态类型为紧凑列表的调用发 71..73；直调内核叶子例程按种类码读写元素，越界、冻结、非紧凑时
// 走通用 callbi（运行期同 16..18），由内建给出同一结果或同一 trap。
function emitCompactListInline(c: Ref<Ctx>, pc: int, a: int, biId: int, nargs: int, t1: int, t2: int): void {
    if (c.nativeMode != 1) { emitCallbiGeneric2(c, c.fnIdx, pc, a, biId, nargs); return; }
    const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
    const slow = lbl + "cls";
    bxGuard(c, a + 1, 15, t1, slow);
    if (biId != 73) { bxGuard(c, a + 2, 1, t2, slow); }
    bxI2(c, "mov", asStructuredReg(1, 1), asStructuredMem(1, 3, -1, 0, payloadOff(a + 1), 0, ""));
    if (biId == 73) {
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_list_clen1"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        bxI2(c, "test", asStructuredReg(0, 0), asStructuredReg(0, 0));
        bxJ(c, "js", slow);
        bxI2(c, "mov", asStructuredReg(0, 15), asStructuredReg(0, 0));
        releaseOld2(c, tagOff(a), lbl + "cll");
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredReg(0, 15));
        bxI2(c, "mov", asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(1));
    } else if (biId == 71) {
        bxI2(c, "mov", asStructuredReg(0, 2), asStructuredMem(2, 3, -1, 0, payloadOff(a + 2), 0, ""));
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_list_cget1"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        bxI2(c, "test", asStructuredReg(1, 8), asStructuredReg(1, 8));
        bxJ(c, "je", slow);
        bxI2(c, "mov", asStructuredReg(0, 15), asStructuredReg(0, 0));
        bxI2(c, "mov", asStructuredReg(0, 14), asStructuredReg(0, 8));
        releaseOld2(c, tagOff(a), lbl + "cgl");
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, tagOff(a), 0, ""), asStructuredReg(0, 14));
        bxI2(c, "mov", asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredReg(0, 15));
    } else {
        bxI2(c, "mov", asStructuredReg(0, 2), asStructuredMem(2, 3, -1, 0, payloadOff(a + 2), 0, ""));
        bxI2(c, "lea", asStructuredReg(0, 8), asStructuredMem(2, 3, -1, 0, tagOff(a + 3), 0, ""));
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_list_cset1"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        bxI2(c, "test", asStructuredReg(1, 0), asStructuredReg(1, 0));
        bxJ(c, "je", slow);
    }
    bxJ(c, "jmp", lbl + "bie");
    asProducerLabel(1, slow, c.recordLine);
    emitCallbiGeneric2(c, c.fnIdx, pc, a, biId, nargs);
    asProducerLabel(1, lbl + "bie", c.recordLine);
}

// D3 v0.23 FFI：有调用桩的外部函数（extern 序）；callbi 64+序 的通用路改调 __tx_ffi_<序>，
// 实参寄存器与栈参照旧（桩只读前四个），其余 callbi 与不用 FFI 的程序不变。
const emFfiStubs: List<int> = listNew();
export function emSetFfiStubs(xs: List<int>): void {
    while (listLen(emFfiStubs) > 0) { listRemoveAt(emFfiStubs, listLen(emFfiStubs) - 1); }
    let i = 0;
    while (i < listLen(xs)) { listPush(emFfiStubs, listGet(xs, i) catch -1); i = i + 1; }
}
// 记录版本：v2＝Zig AOT（TXC v4 含义：外部函数编号从 64 起，字段选择子标志 0x80、字段号 7 位）；
// v3＝原生 emit_record（TXC v6 含义：外部函数编号从 4096 起，标志 0x8000、字段号 15 位）。
let emRecV3: int = 0;
function emExternBase(): int {
    if (emRecV3 == 1) { return 4096; }
    return 64;
}
function emFldIdx(fc: int): int {
    if (emRecV3 == 1) { return fc & 32767; }
    return fc & 127;
}
// “无槽”哨兵：v2 记录（寄存器 ≤256）为 255；v3 记录（原生，寄存器编号 0–65534，C3b）为 65535。
function emNoSlot(): int {
    if (emRecV3 == 1) { return 65535; }
    return 255;
}
function emFldAuto(fc: int): int {
    if (emRecV3 == 1) { return fc & 32768; }
    return fc & 128;
}
function callbiTarget(biId: int): string { return emCallbiTargetFor(biId, emExternBase()); }
// callbi 的调用目标；externBase 为外部函数编号的起点（v3 记录 4096）。可移植渲染器共用。
export function emCallbiTargetFor(biId: int, externBase: int): string {
    // 调试检查点（第 6 轮 6c，调试实施设计 §四-2）：直调程序对象里的 __tx_dbg_* 例程，不经内核。
    if (isDbgBi(biId)) { return "__tx_dbg_" + dbgBiName(biId); }
    // 工具链进程与标准输入内建（第 6 轮 6c-3，TOOL-103）：直调程序对象里的 __tx_tool_* 例程，不经内核。
    if (isToolBi(biId)) { return "__tx_tool_" + toolBiName(biId); }
    const base = externBase;
    if (biId >= base) {
        let i = 0;
        while (i < listLen(emFfiStubs)) {
            if ((listGet(emFfiStubs, i) catch -1) == biId - base) { return "__tx_ffi_" + toStr(biId - base); }
            i = i + 1;
        }
    }
    return "__tx_callbi";
}

function emitCallbiGeneric2(c: Ref<Ctx>, fnIdx: int, pc: int, a: int, biId: int, nargs: int): void {
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(fnIdx)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(a), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(a)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(biId), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(biId)); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(nargs), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(nargs)); }
    const tgt = callbiTarget(biId);
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget(tgt), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call " + tgt); }
}

// legacy lop 渲染（白名单四形——D96 §一表末）
// emitCallTail 镜像（emit_gen emitCallTail 逐字节——查表＋越界/栈满
// 守卫＋dfill 填 None＋write_state 模块状态写＋间接 call r10）。
// 值槽栈惰性提交（2d，线程设计 §十七）：调用序列的上界检查失败时先请内核提交更多值槽栈（rdx＝需要的末端），
// 成功则从 retry 标号重做整条调用序列（序列里的易失寄存器全部重算），失败才落到 trap 4003。只在原生模式发射。
function stackRetryLabel(c: Ref<Ctx>, retry: string): void {
    if (c.nativeMode == 1) { asProducerLabel(1, retry, c.recordLine); }
}
function stackMoreRetry(c: Ref<Ctx>, retry: string): void {
    if (c.nativeMode != 1) { return; }
    asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 2), asStructuredMissing(), c.recordLine);
    asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_stack_more"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
    asProducerInstruction(1, "test", 2, asStructuredReg(1, 0), asStructuredReg(1, 0), asStructuredMissing(), c.recordLine);
    asProducerInstruction(1, "jne", 1, asStructuredTarget(retry), asStructuredMissing(), asStructuredMissing(), c.recordLine);
}
function emitCallTail2(c: Ref<Ctx>, pc: int, a: int, b: int, so: string, oob: string, writeState: int, tag: string): void {
    const base = tagOff(a);
    const fill = ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "_fill" + tag;
    const fillend = ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "_fillend" + tag;
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(1, 2), asStructuredMem(1, -1, -1, 0, 0, 1, "__tx_rt_table_len"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp edx, dword ptr [rip + __tx_rt_table_len]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jae", 1, asStructuredTarget(oob), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jae " + oob); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 10), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_rt_table_ptr"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r10, [rip + __tx_rt_table_ptr]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "shl", 2, asStructuredReg(1, 2), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  shl edx, 4"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 10), asStructuredMem(2, 10, 2, 0, 0, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea r10, [r10 + rdx]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredMem(1, 10, -1, 0, 12, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, dword ptr [r10 + 12]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 11), asStructuredMem(1, 10, -1, 0, 8, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r11d, dword ptr [r10 + 8]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 10), asStructuredMem(2, 10, -1, 0, 0, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r10, [r10]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, base, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rax, [rbx + " + toStr(base) + "]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "shl", 2, asStructuredReg(1, 11), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  shl r11d, 4"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 2), asStructuredMem(2, 0, 11, 0, 0, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rdx, [rax + r11]"); }
    if (c.nativeMode == 1) { tbInto(c, 1, 1); asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 2), asStructuredMem(2, 1, -1, 0, TB_STACK_LIMIT, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rdx, [rip + __tx_stack_limit]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "ja", 1, asStructuredTarget(so), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ja " + so); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 4), asStructuredMem(2, 1, -1, 0, TB_NATIVE_STACK_LIMIT, 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rsp, [rip + __tx_native_stack_limit]"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jbe", 1, asStructuredTarget(so), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jbe " + so); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 1), asStructuredImm(b * VALUE_BYTES), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov ecx, " + toStr(b * VALUE_BYTES)); }
    if (c.nativeMode == 1) { asProducerLabel(1, fill, c.recordLine); } else { emitFn(c, fill + ":"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(1, 11), asStructuredReg(1, 1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp r11d, ecx"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jbe", 1, asStructuredTarget(fillend), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jbe " + fillend); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 0, 1, 0, 0, 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rax + rcx], 4"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 0, 1, 0, 8, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rax + rcx + 8], 0"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "add", 2, asStructuredReg(1, 1), asStructuredImm(16), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  add ecx, 16"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(fill), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + fill); }
    if (c.nativeMode == 1) { asProducerLabel(1, fillend, c.recordLine); } else { emitFn(c, fillend + ":"); }
    if (writeState == 1) {
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 0, -1, 0, 0, 0, ""), asStructuredImm(9), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rax], 9"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 0, -1, 0, 8, 0, ""), asStructuredReg(1, 9), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rax + 8], r9d"); }
    }
    if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rax"); }
    if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredReg(0, 10), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call r10"); }
}
function renderLop2(c: Ref<Ctx>, rec: List<string>): void {
    const pc = toInt(listGet(rec, 1) catch "0");
    if (c.listing) { c.recordLine = pc + 2; }
    flushPendLbls(c);
    const form = listGet(rec, 2) catch "";
    if (form == "loadk_fnv") {
        const a = toInt(listGet(rec, 3) catch "0");
        const idx = toInt(listGet(rec, 4) catch "0");
        const norel = toInt(listGet(rec, 5) catch "0");
        if (norel == 0) { releaseOld2(c, tagOff(a), ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "nr"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(12), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(a)) + "], 12"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, payloadOff(a), 0, ""), asStructuredImm(idx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(payloadOff(a)) + "], " + toStr(idx)); }
        return;
    }
    if (form == "dfree") {
        // 调用前释放并清空调用者帧里实参之后的死临时（emit_record 只对可能持有堆引用的槽发出）。标签 0..4 先放过；
        // 非堆值留在槽里（调用后的槽型只要求非堆），真放了一份计数才清成 None（泄漏检查设计 §六-7）。
        const a = toInt(listGet(rec, 3) catch "0");
        const dl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "df" + toStr(a);
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [rbx + " + toStr(tagOff(a)) + "], 4"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jbe", 1, asStructuredTarget(dl), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jbe " + dl); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 2), asStructuredMem(0, 3, -1, 0, tagOff(a), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx edx, byte ptr [rbx + " + toStr(tagOff(a)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_is_heapref"), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rip + __tx_is_heapref]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredMem(0, 1, 2, 0, 0, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp byte ptr [rcx + rdx], 0"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "je", 1, asStructuredTarget(dl), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  je " + dl); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "lea", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, tagOff(a), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  lea rcx, [rbx + " + toStr(tagOff(a)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_release"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(a)) + "], 4"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(payloadOff(a)) + "], 0"); }
        if (c.nativeMode == 1) { asProducerLabel(1, dl, c.recordLine); } else { emitFn(c, dl + ":"); }
        return;
    }
    if (form == "ldnone") {
        const a = toInt(listGet(rec, 3) catch "0");
        const norel = toInt(listGet(rec, 4) catch "0");
        if (norel == 0) { releaseOld2(c, tagOff(a), ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "nr"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(4), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(a)) + "], 4"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(payloadOff(a)) + "], 0"); }
        return;
    }
    if (form == "ldbool") {
        // 值形批（D96 v0.3 §一 1b）——emit_gen legacy ldbool 臂逐字节：
        // releaseOld（norel 面）＋tag 3 先行＋payload=bx!=0。
        const a = toInt(listGet(rec, 3) catch "0");
        const v = toInt(listGet(rec, 4) catch "0");
        const norel = toInt(listGet(rec, 5) catch "0");
        if (norel == 0) { releaseOld2(c, tagOff(a), ".L" + toStr(c.fnIdx) + "_" + toStr(pc) + "nr"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(a)) + "], 3"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredImm(v), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(payloadOff(a)) + "], " + toStr(v)); }
        return;
    }
    if (form == "band" || form == "bor" || form == "bxor" || form == "imul" || form == "shl" || form == "shr" || form == "sar") {
        // 位运算族（V0.39-G0；A9 band 先例的族级补齐——V0.49-S4-② 闭包预验
        // 显影 37-bitops E002 八处）：emit_gen 位运算臂 int 内联直译逐字节——
        // tag 双守卫（cmp 1）＋按 op 助记（and/or/xor/imul＋移位 shl/shr/
        // sar rax, cl——计数 0..63 ja sht 守卫）＋r15＋releaseOld〔无条件——
        // 该臂无 dnr 门，与 ldbool/ldnone 异〕＋int 写回＋__tx_arith_slow
        // opEnum=40..47 慢路（win rcx/edx/r8d/r9d＋栈参 [rsp+32/40/48]）；
        // 移位 shift_count 陷阱 4016（msg idx/len 随记录）。band 无溢出面＝
        // 零 msg 注册。
        const a = toInt(listGet(rec, 3) catch "0");
        const nb = toInt(listGet(rec, 4) catch "0");
        const nc = toInt(listGet(rec, 5) catch "0");
        let isShift: int = 0;
        if (form == "shl" || form == "shr" || form == "sar") { isShift = 1; }
        const midx = toInt(listGet(rec, 6) catch "0");
        const mlen = toInt(listGet(rec, 7) catch "0");
        let mnemonic: string = "and";
        if (form == "bor") { mnemonic = "or"; }
        if (form == "bxor") { mnemonic = "xor"; }
        if (form == "imul") { mnemonic = "imul"; }
        if (form == "shl") { mnemonic = "shl"; }
        if (form == "shr") { mnemonic = "shr"; }
        if (form == "sar") { mnemonic = "sar"; }
        let opEnum: int = 40;
        if (form == "bor") { opEnum = 41; }
        if (form == "bxor") { opEnum = 42; }
        if (form == "shl") { opEnum = 44; }
        if (form == "shr") { opEnum = 45; }
        if (form == "sar") { opEnum = 46; }
        if (form == "imul") { opEnum = 47; }
        const lbl = ".L" + toStr(c.fnIdx) + "_" + toStr(pc);
        if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 0), asStructuredMem(0, 3, -1, 0, tagOff(nb), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx eax, byte ptr [rbx + " + toStr(tagOff(nb)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(1, 0), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp eax, 1"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jne", 1, asStructuredTarget(lbl + "slow"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jne " + lbl + "slow"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "movzx", 2, asStructuredReg(1, 0), asStructuredMem(0, 3, -1, 0, tagOff(nc), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  movzx eax, byte ptr [rbx + " + toStr(tagOff(nc)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(1, 0), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp eax, 1"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jne", 1, asStructuredTarget(lbl + "slow"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jne " + lbl + "slow"); }
        if (isShift == 1) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredMem(2, 3, -1, 0, payloadOff(nc), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, qword ptr [rbx + " + toStr(payloadOff(nc)) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "cmp", 2, asStructuredReg(0, 1), asStructuredImm(63), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  cmp rcx, 63"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "ja", 1, asStructuredTarget(lbl + "sht"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  ja " + lbl + "sht"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(nb), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, qword ptr [rbx + " + toStr(payloadOff(nb)) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, mnemonic, 2, asStructuredReg(0, 0), asStructuredReg(2, 1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mnemonic + " rax, cl"); }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(nb), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rax, qword ptr [rbx + " + toStr(payloadOff(nb)) + "]"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, mnemonic, 2, asStructuredReg(0, 0), asStructuredMem(2, 3, -1, 0, payloadOff(nc), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  " + mnemonic + " rax, qword ptr [rbx + " + toStr(payloadOff(nc)) + "]"); }
        }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 15), asStructuredReg(0, 0), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r15, rax"); }
        releaseOld2(c, tagOff(a), lbl + "inl");
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredReg(0, 15), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + " + toStr(payloadOff(a)) + "], r15"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredImm(1), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx + " + toStr(tagOff(a)) + "], 1"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(lbl + "end"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp " + lbl + "end"); }
        if (isShift == 1) {
            if (c.nativeMode == 1) { asProducerLabel(1, lbl + "sht", c.recordLine); } else { emitFn(c, lbl + "sht:"); }
            trapTpl2(c, pc, 4016, midx, mlen);
        }
        if (c.nativeMode == 1) { asProducerLabel(1, lbl + "slow", c.recordLine); } else { emitFn(c, lbl + "slow:"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(opEnum), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(opEnum)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(a), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(a)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(nb), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(nb)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 48, 0, ""), asStructuredImm(nc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 48], " + toStr(nc)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_arith_slow"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_arith_slow"); }
        if (c.nativeMode == 1) { asProducerLabel(1, lbl + "end", c.recordLine); } else { emitFn(c, lbl + "end:"); }
        return;
    }
    if (form == "bnot") {
        // 位非（V0.39-G0）一元直译（V0.49-S4-② 族级补齐）：emit_gen .bnot 臂
        // 逐字节——tag 守卫＋not rax＋r15＋releaseOld＋int 写回＋bad_type
        // 陷阱 4010（msg idx/len 随记录）。
        const a = toInt(listGet(rec, 3) catch "0");
        const nb = toInt(listGet(rec, 4) catch "0");
