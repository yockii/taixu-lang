import { jsonParse, jsonStringify } from "std/json";
import { mapNew, mapSet, mapLen, mapKeys, mapGet, objToMap } from "std/map_set";

export function main(args: []string): int {
    const m = mapNew();
    m.set("b", jsonParse("2") catch panic("no"));
    m.set("a", jsonParse("1") catch panic("no"));
    let acc: string = "";
    for (k, v in m) {
        acc = acc + k + "=" + jsonStringify(v) + ";";
    }
    print(acc);
    let keys: string = "";
    for (k in m) {
        keys = keys + k + ",";
    }
    print(keys);
    print(toStr(m.len()));
    const j = jsonParse(`{"x": 1, "y": "二"}`) catch panic("bad");
    const om = objToMap(j) catch panic("not obj");
    let kv: string = "";
    for (key, val in om) {
        kv = kv + key + ":" + jsonStringify(val) + " ";
    }
    print(kv);
    return 0;
}
