// ============================================================================
// stdlib 用例：text 文本工具（V0.23-S1 扩批；STD-04）
// 运行：taixu test tests/text-fx.tx
// ============================================================================

import { repeat, startsWith, endsWith, padStart, padEnd, truncate, indent, lineCount, wordCount } from "std/text";

test "repeat 与前后缀" {
    assert(repeat("ab", 3) == "ababab", "重复 3 次");
    assert(repeat("x", 0) == "", "零次空串");
    assert(startsWith("hello.tx", "hello") && !startsWith("hello", "tx"), "前缀");
    assert(endsWith("a.tx", ".tx") && !endsWith("a.tx", ".go"), "后缀");
    assert(!startsWith("ab", "abcd"), "前缀长于原串");
}

test "padding 与截断" {
    assert(padStart("7", 3, "0") == "007", "左填充");
    assert(padEnd("7", 3, ".") == "7..", "右填充");
    assert(padStart("abcd", 3, "0") == "abcd", "超宽原样");
    assert(truncate("hello world", 8, "...") == "hello...", "截断加省略");
    assert(truncate("hi", 8, "...") == "hi", "不超宽原样");
    assert(truncate("abcdef", 2, "...") == "..", "极窄截断");
}

test "缩进与计数" {
    assert(indent("a\nb", "  ") == "  a\n  b", "逐行缩进");
    assert(lineCount("a\nb\nc") == 3, "行数");
    assert(lineCount("") == 1, "空串一行");
    assert(wordCount("hello  world\nfoo") == 3, "词数（连续空白）");
    assert(wordCount("") == 0, "空串零词");
}
