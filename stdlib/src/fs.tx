// ============================================================================
// std/fs —— 文件读写包装（V0.9-S1；D27 §一；STD-03）。
//
// readFile/writeFile 内建的模块面包装＋按行读取（readLines——`/` 换行切分，
// 经 List 面 for-in 消费；行尾 `\r` 保留按字节面——Windows CRLF 由消费方
// 裁剪或按字面比较）。依赖宿主文件系统——e2e 用临时文件面（verify ⑤）。
//
// V0.38-S2 扩全（exists/mkdir/mkdirs/remove/rename/stat/readDir/cwd）：
// 宿主 txp_fs_* 表（platform.fsops 唯一实现体——interp/AOT shim 同表分发，
// math_host 先例）。**确定性红线**：readDir 原始序＝系统序——出口经
// std/sort.stringSort 排序后返回（跨平台逐字节确定）。
//
// D3 v0.23 平台层：系统调用部分经 import "./fs_sys" 按目标解析为
// fs_sys_windows.tx（kernel32）／fs_sys_linux.tx（from syscall，无 libc）／fs_sys_macos.tx（libSystem）。
// 系统面仍以 0／−1 码返回，本文件把失败转成 Error。
//
// 2026-10-16 起（用户裁决：公共接口统一为 T | Error，不保留旧接口）：fsMkdir/fsMkdirs/fsRemove/
// fsRename 返回 void | Error，statSize 返回 int | Error，statIsDir 返回 bool | Error（路径不存在为
// Error），cwd 返回 string | Error；fsExists 仍为 bool。
// ============================================================================

import { sortString } from "std/sort";
import { sysExists, sysMkdir, sysMkdirs, sysRemove, sysRename, sysStatSize, sysStatIsDir, sysCwd, sysListDir } from "./fs_sys";

// exists：路径存在判定（文件或目录）。
export function fsExists(path: string): bool {
    return sysExists(path);
}

// mkdir：单级建目录（父级须存在；已存在为 Error）。
export function fsMkdir(path: string): void | Error {
    if (sysMkdir(path) != 0) {
        return err("fs: mkdir failed: " + path);
    }
    return done();
}

// mkdirs：逐级建目录（已存在视为成功）。
export function fsMkdirs(path: string): void | Error {
    if (sysMkdirs(path) != 0) {
        return err("fs: mkdirs failed: " + path);
    }
    return done();
}

// remove：删文件（或空目录）；非空目录与不存在均为 Error。
export function fsRemove(path: string): void | Error {
    if (sysRemove(path) != 0) {
        return err("fs: remove failed: " + path);
    }
    return done();
}

// rename：改名/移动（目标存在行为＝系统语义，如实注记）。
export function fsRename(from: string, to: string): void | Error {
    if (sysRename(from, to) != 0) {
        return err("fs: rename failed: " + from + " -> " + to);
    }
    return done();
}

// statSize：文件字节大小。
export function statSize(path: string): int | Error {
    const n = sysStatSize(path);
    if (n < 0) {
        return err("fs: stat failed: " + path);
    }
    return n;
}

// statIsDir：是否目录；路径不存在为 Error。
export function statIsDir(path: string): bool | Error {
    const k = sysStatIsDir(path);
    if (k < 0) {
        return err("fs: no such path: " + path);
    }
    return k == 1;
}

// cwd：当前工作目录。
export function cwd(): string | Error {
    const d = sysCwd();
    if (len(d) == 0) {
        return err("fs: cwd failed");
    }
    return d;
}

// readDir：目录条目名列表（`.`/`..` 不含；**排序后返回**＝确定性红线）。
// 打开失败返回 Error（空目录返回空表——两态可分）。
export function readDir(path: string): List<string> | Error {
    const names = sysListDir(path)?;
    return sortString(names);
}
// 读整文件（readFile 别名面；失败通道原样穿透）。
export function fsReadAll(path: string): string | Error {
    return readFile(path);
}

// 写整文件覆盖（writeFile 别名面；失败通道原样穿透）。
export function fsWriteAll(path: string, content: string): void | Error {
    return writeFile(path, content);
}

// 按行读取：`\n` 切分为行列表（**不含行尾 `\n`**；`\r` 保留字节面；尾行无
// 换行符亦成行、以换行结尾不产生尾空行）。消费＝for-in（List 下标序＝行序）。
export function fsReadLines(path: string): List<string> | Error {
    const text = readFile(path)?;
    const lines: List<string> = listNew();
    let start: int = 0;
    let i: int = 0;
    while (i < len(text)) {
        const b = byteAt(text, i) catch 10;
        if (b == '\n') {
            listPush(lines, byteSliceOf(text, start, i));
            i = i + 1;
            start = i;
            continue;
        }
        i = i + 1;
    }
    if (start < len(text)) {
        listPush(lines, byteSliceOf(text, start, len(text))); // 尾行（无换行）
    }
    return lines;
}

// void | Error 的成功出口（语言没有裸 `return;` 的形式，返回一个 void 调用）。
function done(): void {
}

// —— 内部：字节面切片（与 std/path 同手法；模块内复制避免跨模块私有依赖）——
function byteSliceOf(s: string, from: int, to: int): string {
    let out: string = "";
    let i: int = from;
    while (i < to && i < len(s)) {
        const b = byteAt(s, i) catch 0;
        if (b < 128) {
            out = out + (utf8Encode(b) catch "");
            i = i + 1;
            continue;
        }
        let n: int = 2;
        let cp: int = b - 192;
        if (b >= 240) {
            n = 4;
            cp = b - 240;
        } else if (b >= 224) {
            n = 3;
            cp = b - 224;
        }
        let ok: bool = true;
        let k: int = 1;
        while (k < n) {
            const cb = byteAt(s, i + k) catch -1;
            if (cb < 128 || cb >= 192) {
                ok = false;
            } else {
                cp = cp * 64 + (cb - 128);
            }
            k = k + 1;
        }
        if (ok && i + n <= to) {
            out = out + (utf8Encode(cp) catch "");
            i = i + n;
        } else {
            out = out + (utf8Encode(0xFFFD) catch "?");
            i = i + 1;
        }
    }
    return out;
}
