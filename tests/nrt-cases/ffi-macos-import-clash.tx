// macOS 适配 M2（设计稿 F2，伴文件 .macos）：导入槽按名字归属一个库，与运行时经 libSystem 导入的符号同名的外部函数
// 不能来自别的库（构建尾部 ffiPrepare 报 3033）；同名而来自 libSystem 的照常共用一个导入槽。
declare function write(fd: i32, buf: Bytes, n: usize): isize from "/usr/lib/libz.1.dylib";

function main(args: []string): int {
    write(1, bytesNew(0), 0);
    return 0;
}
