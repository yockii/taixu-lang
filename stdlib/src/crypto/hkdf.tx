// HKDF-SHA-256，RFC 5869。Expand 的输出长度不超过 255 个摘要块。
import { hmacSha256 } from "./hmac";

export function hkdfExtractSha256(salt: Bytes, inputKey: Bytes): Bytes {
    if (bytesLen(salt) == 0) { return hmacSha256(bytesNew(32), inputKey); }
    return hmacSha256(salt, inputKey);
}

export function hkdfExpandSha256(prk: Bytes, info: Bytes, length: int): Bytes | Error {
    if (bytesLen(prk) < 32) { return err("hkdf: SHA-256 PRK must contain at least 32 bytes"); }
    if (length < 0 || length > 8160) { return err("hkdf: SHA-256 output length must be 0..8160"); }
    const out = bytesNew(length);
    let block = bytesNew(0);
    let offset = 0;
    let counter = 1;
    while (offset < length) {
        const input = bytesSlice(block, 0, bytesLen(block));
        bytesAppend(input, info);
        const suffix = bytesNew(1);
        bytesSet(suffix, 0, counter);
        bytesAppend(input, suffix);
        block = hmacSha256(prk, input);
        let n = 32;
        if (n > length - offset) { n = length - offset; }
        bytesCopy(out, offset, block, 0, n);
        offset = offset + n;
        counter = counter + 1;
    }
    return out;
}

export function hkdfSha256(salt: Bytes, inputKey: Bytes, info: Bytes, length: int): Bytes | Error {
    return hkdfExpandSha256(hkdfExtractSha256(salt, inputKey), info, length);
}
