// emit-record-probe.tx —— emit_record.tx 批 C 探针（V0.50-S5-①；记录流锚驱动）。
// 用法：taixu run bootstrap/selfhost/emit-record-probe.tx <in.txc> <out.records>
// 对 .txc：decodeToDump → recordDump → 记录流写 <out.records>（与 zig 链
// emitdump 逐字节 diff 的 .tx 侧产物）。ASCII 域安全（记录流无高字节）。
import { recordDump } from "./emit_record";
import { decodeToDump } from "./bytecode";

function main(args: []string): int {
    if (len(args) < 2) {
        eprint("用法: emit-record-probe <in.txc> <out.records>");
        return 64;
    }
    const txc: string = readFile(args[0]) catch "";
    if (len(txc) == 0) {
        eprint("read fail");
        return 1;
    }
    const dump = decodeToDump(txc);
    if (len(dump) == 0) {
        eprint("decode fail");
        return 2;
    }
    const rec = recordDump(dump);
    const bytes: List<int> = listNew();
    let i = 0;
    while (i < len(rec)) {
        listPush(bytes, byteAt(rec, i) catch 0);
        i = i + 1;
    }
    writeFileBytes(args[1], bytes) catch (e) {
        eprint("write fail: " + e.message);
        return 3;
    };
    print("records " + toStr(len(rec)) + "B");
    return 0;
}
