// bench/algo/qsort —— 快速排序（LCG 种子 50,000 个整数；递归分区）。
// 校验和＝排序后 Σ i*xs[i] mod 1000003（确定性随机源）。
function lcg(state: int): int {
    return (state * 1103515245 + 12345) % 2147483648;
}

function partition(xs: List<int>, lo: int, hi: int): int {
    const pivot: int = listGet(xs, hi) catch 0;
    let i: int = lo;
    let j: int = lo;
    while (j < hi) {
        if ((listGet(xs, j) catch 0) < pivot) {
            const t: int = listGet(xs, i) catch 0;
            listSet(xs, i, listGet(xs, j) catch 0);
            listSet(xs, j, t);
            i = i + 1;
        }
        j = j + 1;
    }
    const t2: int = listGet(xs, i) catch 0;
    listSet(xs, i, listGet(xs, hi) catch 0);
    listSet(xs, hi, t2);
    return i;
}

function qsort(xs: List<int>, lo: int, hi: int): void {
    if (lo < hi) {
        const p: int = partition(xs, lo, hi);
        qsort(xs, lo, p - 1);
        qsort(xs, p + 1, hi);
    }
}

export function main(args: []string): int {
    const xs: List<int> = listNew();
    let state: int = 42;
    let i: int = 0;
    while (i < 50000) {
        state = lcg(state);
        listPush(xs, state % 1000000);
        i = i + 1;
    }
    qsort(xs, 0, listLen(xs) - 1);
    let checksum: int = 0;
    i = 0;
    while (i < listLen(xs)) {
        checksum = checksum + (i * (listGet(xs, i) catch 0)) % 1000003;
        i = i + 1;
    }
    print(toStr(checksum % 1000003));
    return 0;
}
