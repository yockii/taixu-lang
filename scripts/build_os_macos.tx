// 构建驱动的 macOS 系统原语（导出面同 build_os_linux.tx）：macOS 没有稳定的系统调用接口，经 libSystem（D3 §6.8-7；
// 同编译器的 mcp_scratch_os_macos.tx）。AT_FDCWD −2、AT_REMOVEDIR 0x80，open 的标志位按 macOS 的值。
import { realPath } from "../bootstrap/selfhost/real_path";
declare function open(path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function write(fd: i32, buf: Bytes, n: usize): isize from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
declare function unlinkat(fd: i32, path: string, flags: i32): i32 from "libSystem";
declare function rename(from: string, to: string): i32 from "libSystem";

// O_WRONLY｜O_CREAT（0x200）｜O_TRUNC（0x400）｜O_CLOEXEC（0x1000000）。
const OPEN_WRITE: int = 16778753;
const EINTR: int = 4;
// 一次写出至多 16 MiB（只在不是整块时切出这一段）。
const CHUNK: int = 16777216;

// 删除空目录（不递归，不跟随链接）。
export function osRemoveDir(path: string): bool {
    return unlinkat(-2, path, 128) == 0;
}

// 改名；目标已存在时原子地替换它（同一文件系统内）。
export function osRename(from: string, to: string): bool {
    return rename(from, to) == 0;
}

// 真实路径：同编译器的 real_path 模块（服务信任根、MCP 暂存区共用一份实现）；local* 内建拒绝路径里的链接，解析不了时原样
// 返回，由随后的检查报错。
export function osRealPath(path: string): string {
    return realPath(path);
}

// 新建或截断 path 并写出 data 的全部内容；exec 为真时权限 0755，否则 0644（都再受 umask 约束）。
export function osWriteFile(path: string, data: Bytes, exec: bool): bool {
    let mode: u32 = 420;
    if (exec) {
        mode = 493;
    }
    const fd = open(path, OPEN_WRITE as i32, mode);
    if (fd < 0) {
        return false;
    }
    const total = bytesLen(data);
    let off: int = 0;
    let ok: bool = true;
    while (off < total) {
        let n: int = total - off;
        if (n > CHUNK) {
            n = CHUNK;
        }
        let src: Bytes = data;
        if (off > 0 || n < total) {
            src = bytesSlice(data, off, n);
        }
        const r = write(fd, src, n as usize) as int;
        if (r < 0 && ffiLastError() == EINTR) {
            continue;
        }
        if (r <= 0) {
            ok = false;
            break;
        }
        off = off + r;
    }
    if (close(fd) != 0) {
        ok = false;
    }
    return ok;
}
