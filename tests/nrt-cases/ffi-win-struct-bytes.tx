// Bytes 字段（D3 v0.46，Windows）：外部结构体的 Bytes 字段是数据区指针。ntdll 的 RtlUnicodeStringToAnsiString 从 UNICODE_STRING 的
// Buffer（输入，UTF-16LE）转写进 ANSI_STRING 的 Buffer（输出，调用方给的 Bytes，不另分配）；Length 由 C 写、经 Ref 拷回，
// Buffer 字段拷回时跳过（C 写的是 Bytes 自己的数据区）。缓冲不够时得 STATUS_BUFFER_OVERFLOW，Bytes 长度不变。
declare struct ANSI_STRING { length: u16, maxLength: u16, buffer: Bytes }
declare struct UNICODE_STRING { length: u16, maxLength: u16, buffer: Bytes }
declare function RtlUnicodeStringToAnsiString(dst: Ref<ANSI_STRING>, src: Ref<UNICODE_STRING>, alloc: u8): i32 from "ntdll";

function utf16(s: string): Bytes {
    const src = bytesFromStr(s);
    const out = bytesNew(0);
    let i = 0;
    while (i < bytesLen(src)) {
        bytesPush(out, bytesGet(src, i) catch 0);
        bytesPush(out, 0);
        i = i + 1;
    }
    return out;
}

function main(args: []string): int {
    const wide = utf16("Taixu-42");
    const src = new UNICODE_STRING { length: bytesLen(wide) as u16, maxLength: bytesLen(wide) as u16, buffer: wide };
    const out = bytesNew(16);
    const dst = new ANSI_STRING { length: 0, maxLength: 16, buffer: out };
    const st = RtlUnicodeStringToAnsiString(dst, src, 0);
    print("status " + toStr(st) + " length " + toStr(dst.length) + " text [" + (bytesToStr(bytesSlice(out, 0, dst.length as int)) catch "?") + "] buf " + toStr(bytesLen(dst.buffer)));
    const small = bytesNew(4);
    const tight = new ANSI_STRING { length: 0, maxLength: 4, buffer: small };
    const st2 = RtlUnicodeStringToAnsiString(tight, src, 0);
    print("overflow " + toStr(st2 == -2147483643) + " small " + toStr(bytesLen(small)));
    return 0;
}
