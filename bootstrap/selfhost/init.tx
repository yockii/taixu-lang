// `taixu init <项目名> [--template=console|library]`，或 `taixu init <模板> <项目名>`
// 项目脚手架。已存在的文件不覆盖；GUI 脚手架由外部 GUI 库提供。

import { filePath } from "./file_path";

function cpCountI(s: string): int {
    let pos = 0;
    let count = 0;
    while (pos < len(s)) {
        const c = byteAt(s, pos) catch 0;
        if (c >= 240) { pos = pos + 4; }
        else if (c >= 224) { pos = pos + 3; }
        else if (c >= 192) { pos = pos + 2; }
        else { pos = pos + 1; }
        count = count + 1;
    }
    return count;
}

function isSafeName(name: string): bool {
    if (len(name) == 0) { return false; }
    let i = 0;
    while (i < len(name)) {
        const c = byteAt(name, i) catch 0;
        const ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45;
        if (!ok) { return false; }
        i = i + 1;
    }
    return true;
}

function isTemplate(t: string): bool {
    return t == "console" || t == "library";
}

// 逐级建目录（已存在不算错）。
function ensureDir(dir: string): void {
    const parts = strSplit(dir, "/");
    let acc = "";
    for (p in parts) {
        if (len(acc) > 0) { acc = acc + "/"; }
        acc = acc + p;
        if (entryKind(filePath(acc)) != 2) {
            makeDir(filePath(acc)) catch (e) {};
        }
    }
}

function dirOf(path: string): string {
    const parts = strSplit(path, "/");
    let acc = "";
    let i = 0;
    while (i + 1 < listLen(parts)) {
        if (i > 0) { acc = acc + "/"; }
        acc = acc + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return acc;
}

// `taixu init` 的参数（args[0] 为子命令名）。返回退出码；-64 为用法错误（调用方打印用法）。
export function initCommand(args: []string): int {
    let name = "";
    let template = "console";
    let second = "";
    let i = 1;
    while (i < len(args)) {
        const a = args[i];
        if (strIndexOf(a, "--template=") == 0) { template = strSub(a, 11, cpCountI(a) - 11); }
        else if (strIndexOf(a, "-") == 0) { return -64; } // 其余选项（含 --help）一律报用法，不当作项目名
        else if (len(name) == 0) { name = a; }
        else if (len(second) == 0) { second = a; }
        else { return -64; }
        i = i + 1;
    }
    if (len(second) > 0) {
        if (!isTemplate(name)) { return -64; }
        template = name;
        name = second;
    } else if (template == "console" && name == "library") {
        eprint("提示: '" + name + "' 是模板名——建 " + name + " 项目写作 `taixu init " + name + " <项目名>`");
    }
    if (len(name) == 0) { return -64; }
    if (!isSafeName(name)) {
        eprint("taixu init: 项目名须为 [A-Za-z0-9_-]+（不可为路径片段）");
        return 64;
    }
    const paths: List<string> = listNew();
    const datas: List<string> = listNew();
    if (template == "console") {
        listPush(paths, name + "/main.tx");
        listPush(datas, consoleMain(name));
    } else if (template == "library") {
        listPush(paths, name + "/src/" + name + ".tx");
        listPush(datas, libraryLib(name));
        listPush(paths, name + "/tests/smoke.tx");
        listPush(datas, libraryTest(name));
    } else {
        eprint("taixu init: --template 须为 console|library");
        return 64;
    }
    let written = 0;
    let k = 0;
    while (k < listLen(paths)) {
        const p = listGet(paths, k) catch "";
        k = k + 1;
        if (entryKind(filePath(p)) == 1) { continue; }
        ensureDir(dirOf(p));
        writeFile(filePath(p), listGet(datas, k - 1) catch "") catch (e) {
            eprint("taixu init: 写盘失败");
            return 3;
        };
        written = written + 1;
    }
    print("init: " + toStr(written) + " 个文件写入 " + name + "（模板 " + template + "）");

    return 0;
}

// —— 模板（由 src/tools/devtools.zig 的 runInit 逐字转写）——

function consoleMain(name: string): string {
    let t = "";
    t = t + "// " + name + "/main.tx —— console 模板（taixu init）\n";
    t = t + "export function main(args: []string): int {\n";
    t = t + "    args;\n";
    t = t + "    print(\"hello from " + name + "\");\n";
    t = t + "    return 0;\n";
    t = t + "}\n";
    return t;
}

function libraryLib(name: string): string {
    let t = "";
    t = t + "// " + name + "/src/" + name + ".tx —— library 模板（taixu init；std 模块形态）\n";
    t = t + "\n";
    t = t + "/// 计算整数平方（示例导出函数）。\n";
    t = t + "export function square(n: int): int {\n";
    t = t + "    return n * n;\n";
    t = t + "}\n";
    t = t + "\n";
    t = t + "test \"square\" {\n";
    t = t + "    assert(square(7) == 49, \"square(7) != 49\");\n";
    t = t + "}\n";
    return t;
}

function libraryTest(name: string): string {
    let t = "";
    t = t + "// " + name + "/tests/smoke.tx —— 库冒烟测试（taixu test）\n";
    t = t + "import { square } from \"../src/" + name + "\";\n";
    t = t + "\n";
    t = t + "test \"smoke\" {\n";
    t = t + "    assert(square(3) == 9, \"square(3) != 9\");\n";
    t = t + "}\n";
    return t;
}
