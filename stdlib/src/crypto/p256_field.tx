// P-256 内部固定 18×15 位 Montgomery 域。秘密运算只用固定循环、公开下标和掩码选择。
import { rsaZeros, rsaDecode, rsaEncode, rsaNprime, rsaR2 } from "./rsa_math";

export struct P256Field { modulus: List<int>, nprime: int, r2: List<int>, power: Bytes }

// 只用于公开曲线常数。
export function p256Hex(text: string): Bytes {
    const out = bytesNew(len(text) / 2); let i = 0;
    while (i < bytesLen(out)) {
        let a = byteAt(text, i * 2) - 48; let b = byteAt(text, i * 2 + 1) - 48;
        if (a >= 49) { a = a - 39; } if (b >= 49) { b = b - 39; }
        bytesSet(out, i, a * 16 + b); i = i + 1;
    }
    return out;
}

function field(modulus: string, power: string): Ref<P256Field> {
    const n = rsaDecode(p256Hex(modulus), 18);
    return new P256Field { modulus: n, nprime: rsaNprime(n), r2: rsaR2(n), power: p256Hex(power) };
}

export function p256Prime(): Ref<P256Field> {
    return field("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff", "ffffffff00000001000000000000000000000000fffffffffffffffffffffffd");
}

export function p256Order(): Ref<P256Field> {
    return field("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc63254f");
}

function reduce(f: Ref<P256Field>, wide: List<int>): List<int> {
    const candidate = rsaZeros(18); let borrow = 0; let i = 0;
    while (i < 18) {
        const v = listGet(wide, i) - listGet(f.modulus, i) - borrow;
        borrow = (v >> 63) & 1; listSet(candidate, i, v + borrow * 32768); i = i + 1;
    }
    const mask = -((((listGet(wide, 18) - borrow) >> 63) & 1) ^ 1);
    const out = rsaZeros(18); i = 0;
    while (i < 18) {
        const original = listGet(wide, i);
        listSet(out, i, original ^ ((original ^ listGet(candidate, i)) & mask)); i = i + 1;
    }
    return out;
}

export function p256Mul(f: Ref<P256Field>, a: List<int>, b: List<int>): List<int> {
    const t = rsaZeros(20); let i = 0;
    while (i < 18) {
        let carry = 0; let j = 0;
        while (j < 18) {
            const v = listGet(t, j) + listGet(a, j) * listGet(b, i) + carry;
            listSet(t, j, v & 32767); carry = v >> 15; j = j + 1;
        }
        const high = listGet(t, 18) + carry; listSet(t, 18, high & 32767); listSet(t, 19, high >> 15);
        const m = (listGet(t, 0) * f.nprime) & 32767; carry = 0; j = 0;
        while (j < 18) {
            const v = listGet(t, j) + m * listGet(f.modulus, j) + carry;
            if (j > 0) { listSet(t, j - 1, v & 32767); } carry = v >> 15; j = j + 1;
        }
        const v = listGet(t, 18) + carry;
        listSet(t, 17, v & 32767); listSet(t, 18, listGet(t, 19) + (v >> 15)); listSet(t, 19, 0); i = i + 1;
    }
    return reduce(f, t);
}

export function p256Small(f: Ref<P256Field>, value: int): List<int> {
    const v = rsaZeros(18); listSet(v, 0, value); return p256Mul(f, v, f.r2);
}

export function p256Decode(f: Ref<P256Field>, value: Bytes): List<int> { return p256Mul(f, rsaDecode(value, 18), f.r2); }
export function p256Encode(f: Ref<P256Field>, value: List<int>): Bytes {
    const one = rsaZeros(18); listSet(one, 0, 1); return rsaEncode(p256Mul(f, value, one), 32);
}

export function p256Add(f: Ref<P256Field>, a: List<int>, b: List<int>): List<int> {
    const wide = rsaZeros(19); let carry = 0; let i = 0;
    while (i < 18) {
        const v = listGet(a, i) + listGet(b, i) + carry;
        listSet(wide, i, v & 32767); carry = v >> 15; i = i + 1;
    }
    listSet(wide, 18, carry); return reduce(f, wide);
}

export function p256Sub(f: Ref<P256Field>, a: List<int>, b: List<int>): List<int> {
    const out = rsaZeros(18); let borrow = 0; let i = 0;
    while (i < 18) {
        const v = listGet(a, i) - listGet(b, i) - borrow;
        borrow = (v >> 63) & 1; listSet(out, i, v + borrow * 32768); i = i + 1;
    }
    const mask = -borrow; let carry = 0; i = 0;
    while (i < 18) {
        const v = listGet(out, i) + (listGet(f.modulus, i) & mask) + carry;
        listSet(out, i, v & 32767); carry = v >> 15; i = i + 1;
    }
    return out;
}

export function p256Zero(value: List<int>): int {
    let bits = 0; let i = 0;
    while (i < 18) { bits = bits | listGet(value, i); i = i + 1; }
    return (((bits | -bits) >> 63) & 1) ^ 1;
}

export function p256Select(bit: int, yes: List<int>, no: List<int>): List<int> {
    const mask = -bit; const out = rsaZeros(18); let i = 0;
    while (i < 18) { const v = listGet(no, i); listSet(out, i, v ^ ((v ^ listGet(yes, i)) & mask)); i = i + 1; }
    return out;
}

export function p256Swap(a: List<int>, b: List<int>, bit: int): void {
    const mask = -bit; let i = 0;
    while (i < 18) {
        const av = listGet(a, i); const bv = listGet(b, i); const change = (av ^ bv) & mask;
        listSet(a, i, av ^ change); listSet(b, i, bv ^ change); i = i + 1;
    }
}

export function p256Inverse(f: Ref<P256Field>, a: List<int>): List<int> {
    let out = p256Small(f, 1); let bit = 255;
    while (bit >= 0) {
        out = p256Mul(f, out, out);
        const b = bytesGet(f.power, 31 - bit / 8) catch panic("p256: public exponent bounds");
        if (((b >> (bit % 8)) & 1) != 0) { out = p256Mul(f, out, a); } bit = bit - 1;
    }
    return out;
}
