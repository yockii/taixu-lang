// D3 v0.37 Bytes 批量操作（LANG-32）：区间拷贝（同一对象两个方向的重叠、长度为 0、两个对象之间）、填充、定宽数值的
// 小端与大端往返（有符号扩展、u64 全位、f32／float 位型）、读越界得 None。期望值由独立计算给出（Python struct）。
function dec(b: Bytes): string {
    let acc = "";
    let i = 0;
    while (i < bytesLen(b)) {
        if (i > 0) { acc = acc + " "; }
        acc = acc + toStr(bytesGet(b, i) catch -1);
        i = i + 1;
    }
    return acc;
}

function sub(b: Bytes, from: int, count: int): Bytes { return bytesSlice(b, from, count); }

export function main(args: []string): int {
    const b = bytesNew(8);
    let i = 0;
    while (i < 8) {
        bytesSet(b, i, i + 1);
        i = i + 1;
    }
    bytesCopy(b, 2, b, 0, 5);
    print("fwd " + dec(b));
    bytesCopy(b, 0, b, 3, 5);
    print("back " + dec(b));
    bytesCopy(b, 8, b, 0, 0);
    print("empty " + dec(b));
    const c = bytesNew(3);
    bytesCopy(c, 1, b, 6, 2);
    print("other " + dec(c));
    bytesFill(b, 1, 3, 255);
    print("fill " + dec(b));
    bytesFill(b, 0, 0, 7);
    print("fill0 " + dec(b));

    const w = bytesNew(16);
    bytesSetLE<u32>(w, 0, 0x01020304);
    bytesSetBE<u32>(w, 4, 0x01020304);
    print("u32 " + dec(sub(w, 0, 8)));
    print("get " + toStr(bytesGetLE<u32>(w, 4) catch 0) + " " + toStr(bytesGetBE<u32>(w, 0) catch 0) + " " + toStr(bytesGetLE<u16>(w, 1) catch 0));
    bytesSetLE<i16>(w, 8, -2);
    print("i16 " + toStr(bytesGetLE<i16>(w, 8) catch 0) + " " + toStr(bytesGetLE<u16>(w, 8) catch 0) + " " + toStr(bytesGetLE<i8>(w, 9) catch 0));
    bytesSetBE<i32>(w, 8, -123456789);
    print("i32 " + toStr(bytesGetBE<i32>(w, 8) catch 0) + " " + toStr(bytesGetLE<i32>(w, 8) catch 0));
    bytesSetLE<u64>(w, 0, 18446744073709551615);
    print("u64 " + toStr(bytesGetLE<u64>(w, 0) catch 0) + " " + toStr(bytesGetLE<int>(w, 0) catch 0));
    bytesSetBE<int>(w, 8, -9000000000);
    print("int " + toStr(bytesGetBE<int>(w, 8) catch 0) + " " + toStr(bytesGetLE<int>(w, 8) catch 0));
    bytesSetLE<f32>(w, 0, 1.5);
    print("f32 " + toStr(bytesGetLE<u32>(w, 0) catch 0) + " " + toStr(bytesGetLE<f32>(w, 0) catch 0.0));
    bytesSetBE<float>(w, 8, -0.1);
    print("f64 " + toStr(bytesGetBE<float>(w, 8) catch 0.0) + " " + toStr(bytesGetBE<u64>(w, 8) catch 0));
    print("oob " + toStr(bytesGetLE<u32>(w, 13) catch 7) + " " + toStr(bytesGetLE<u32>(w, 12) catch 7) + " " + toStr(bytesGetLE<u8>(w, -1) catch 7) + " " + toStr(bytesGetLE<u8>(w, 16) catch 7));
    return 0;
}
