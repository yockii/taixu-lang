// LANG-07 正向全景（V0.7-S2）：List 六内建＋嵌套 List＋Ref 元素句柄语义。
struct Counter {
    v: int,
}

function sumAll(xs: List<int>): int {
    let acc: int = 0;
    let i: int = 0;
    while (i < listLen(xs)) {
        acc = acc + (listGet(xs, i) catch 0);
        i = i + 1;
    }
    return acc;
}

export function main(args: []string): int {
    const nums: List<int> = listNew();
    let i: int = 0;
    while (i < 5) {
        listPush(nums, i * i);
        i = i + 1;
    }
    print(toStr(sumAll(nums))); // 0+1+4+9+16 = 30
    listSet(nums, 2, 100); // 索引写（RETAIN 新 / RELEASE 旧）
    print(toStr(sumAll(nums))); // 126

    const words: List<string> = listNew();
    listPush(words, "太");
    listPush(words, "虚");
    const w = listPop(words) catch ""; // 尾弹出（所有权移交）
    print(w + (listPop(words) catch "")); // 虚太
    print(toStr(listLen(words))); // 0

    const nested: List<List<int>> = listNew();
    const inner: List<int> = listNew();
    listPush(inner, 7);
    listPush(nested, inner); // 句柄入表
    const got = listGet(nested, 0) catch inner;
    print(toStr(listGet(got, 0) catch 0)); // 7

    const cs: List<Ref<Counter>> = listNew();
    const spare: Ref<Counter> = new Counter { v: 0 };
    listPush(cs, new Counter { v: 41 });
    listPush(cs, new Counter { v: 42 });
    const c = listPop(cs) catch spare; // Ref 元素移交
    print(toStr(c.v)); // 42
    return 0;
}
