// Indexed weak registry, no Obj layout assumptions; two-table growth is atomic.
import { StructuredBuffer } from "./assemble";
import { nr, nd, ni, nm, nmd, nt, nmov, nl, nj, nc, nret, nfn, nleaf, nframe, nunframe, nfnEnd } from "./native_emit";
// 各例程登记为手写函数（runtime-manual，PE 规范化 P3 第 7 项）。notify 的越界早退是叶函数、指令不变，逐个通知的循环
// （入口即 sub rsp, 56）外提为 __tx_wt_notify_walk，早退之后跳过去。
const MODULE: string = "bootstrap/selfhost/weak_table.tx";
export function weakTableEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_wt_link";
    nfn(b, MODULE, "__tx_native_weak_link_v1"); nframe(b, 88);
    nmov(b, nm(4, 32), nr(1)); nmov(b, nd(2), nd(2)); nmov(b, nd(8), nd(8));
    nmov(b, nm(4, 40), nr(2)); nmov(b, nm(4, 48), nr(8));
    nt(b, "cmp", nd(2), ni(-1)); nj(b, "je", p + "_bad"); nt(b, "cmp", nd(8), ni(-1)); nj(b, "je", p + "_bad");
    nmov(b, nr(10), nm(1, 16)); nt(b, "cmp", nr(8), nr(10)); nj(b, "jae", p + "_capacity");
    nmov(b, nr(11), nm(1, 8)); nmov(b, nr(0), nr(8)); nt(b, "shl", nr(0), ni(3)); nt(b, "add", nr(11), nr(0));
    nt(b, "cmp", nmd(11, 0), ni(-1)); nj(b, "jne", p + "_bad");
    nl(b, p + "_capacity"); nmov(b, nr(0), nr(2)); nt(b, "cmp", nr(0), nr(8)); nj(b, "jae", p + "_need"); nmov(b, nr(0), nr(8));
    nl(b, p + "_need"); nt(b, "add", nr(0), ni(1)); nt(b, "cmp", nr(0), nr(10)); nj(b, "jbe", p + "_commit");
    nt(b, "cmp", nr(10), ni(16)); nj(b, "jae", p + "_grow"); nmov(b, nr(10), ni(16));
    nl(b, p + "_grow"); nt(b, "cmp", nr(10), nr(0)); nj(b, "jae", p + "_alloc"); nt(b, "shl", nr(10), ni(1)); nj(b, "jmp", p + "_grow");
    nl(b, p + "_alloc"); nmov(b, nm(4, 56), nr(10)); nmov(b, nr(1), nr(10)); nt(b, "shl", nr(1), ni(3)); nmov(b, nd(2), ni(8)); nc(b, "__tx_native_mem_alloc");
    nt(b, "test", nr(0), nr(0)); nj(b, "jz", p + "_bad"); nmov(b, nm(4, 64), nr(0));
    nmov(b, nr(1), nm(4, 56)); nt(b, "shl", nr(1), ni(3)); nmov(b, nd(2), ni(8)); nc(b, "__tx_native_mem_alloc");
    nt(b, "test", nr(0), nr(0)); nj(b, "jz", p + "_rollback"); nmov(b, nm(4, 72), nr(0));
    nmov(b, nr(10), nm(4, 64)); nmov(b, nr(11), nm(4, 56)); nmov(b, nr(2), ni(-1));
    nl(b, p + "_init"); nmov(b, nm(10, 0), nr(2)); nmov(b, nm(0, 0), nr(2)); nt(b, "add", nr(10), ni(8)); nt(b, "add", nr(0), ni(8)); nt(b, "sub", nr(11), ni(1)); nj(b, "jne", p + "_init");
    nmov(b, nr(1), nm(4, 32)); nmov(b, nr(8), nm(1, 16)); nt(b, "test", nr(8), nr(8)); nj(b, "jz", p + "_swap");
    nmov(b, nr(9), nm(1, 0)); nmov(b, nr(11), nm(1, 8)); nmov(b, nr(10), nm(4, 64)); nmov(b, nr(2), nm(4, 72));
    nl(b, p + "_copy"); nmov(b, nr(0), nm(9, 0)); nmov(b, nm(10, 0), nr(0)); nmov(b, nr(0), nm(11, 0)); nmov(b, nm(2, 0), nr(0));
    nt(b, "add", nr(9), ni(8)); nt(b, "add", nr(11), ni(8)); nt(b, "add", nr(10), ni(8)); nt(b, "add", nr(2), ni(8)); nt(b, "sub", nr(8), ni(1)); nj(b, "jne", p + "_copy");
    nmov(b, nr(1), nm(1, 0)); nc(b, "__tx_native_mem_free"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(1), nm(1, 8)); nc(b, "__tx_native_mem_free");
    nl(b, p + "_swap"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(0), nm(4, 64)); nmov(b, nm(1, 0), nr(0)); nmov(b, nr(0), nm(4, 72)); nmov(b, nm(1, 8), nr(0)); nmov(b, nr(0), nm(4, 56)); nmov(b, nm(1, 16), nr(0));
    nl(b, p + "_commit"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(2), nm(4, 40)); nmov(b, nr(8), nm(4, 48));
    nmov(b, nr(10), nm(1, 8)); nmov(b, nr(11), nr(8)); nt(b, "shl", nr(11), ni(3)); nt(b, "add", nr(10), nr(11));
    nmov(b, nmd(10, 0), nd(2)); nmov(b, nmd(10, 4), ni(-1));
    nmov(b, nr(9), nm(1, 0)); nt(b, "shl", nr(2), ni(3)); nt(b, "add", nr(9), nr(2)); nmov(b, nd(0), nmd(9, 4));
    nt(b, "cmp", nd(0), ni(-1)); nj(b, "je", p + "_first"); nt(b, "shl", nr(0), ni(3)); nt(b, "add", nr(0), nm(1, 8)); nmov(b, nmd(0, 4), nd(8)); nj(b, "jmp", p + "_tail");
    nl(b, p + "_first"); nmov(b, nmd(9, 0), nd(8)); nl(b, p + "_tail"); nmov(b, nmd(9, 4), nd(8)); nmov(b, nr(0), ni(1)); nj(b, "jmp", p + "_return");
    nl(b, p + "_rollback"); nmov(b, nr(1), nm(4, 64)); nc(b, "__tx_native_mem_free");
    nl(b, p + "_bad"); nmov(b, nr(0), ni(0)); nl(b, p + "_return"); nunframe(b, 88);
    nfnEnd(b);

    p = "__tx_wt_unlink"; nfn(b, MODULE, "__tx_native_weak_unlink_v1"); nleaf(b);
    nmov(b, nd(2), nd(2)); nmov(b, nd(8), nd(8)); nt(b, "cmp", nr(2), nm(1, 16)); nj(b, "jae", p + "_return"); nt(b, "cmp", nr(8), nm(1, 16)); nj(b, "jae", p + "_return");
    nmov(b, nr(10), nr(8)); nt(b, "shl", nr(10), ni(3)); nt(b, "add", nr(10), nm(1, 8)); nmov(b, nd(11), nmd(10, 0)); nt(b, "cmp", nd(11), nd(2)); nj(b, "jne", p + "_return");
    nmov(b, nr(9), nr(2)); nt(b, "shl", nr(9), ni(3)); nt(b, "add", nr(9), nm(1, 0)); nmov(b, nr(11), nr(9)); nmov(b, nd(0), ni(-1));
    nl(b, p + "_walk"); nmov(b, nd(2), nmd(11, 0)); nt(b, "cmp", nd(2), nd(8)); nj(b, "je", p + "_found"); nt(b, "cmp", nd(2), ni(-1)); nj(b, "je", p + "_return");
    nmov(b, nd(0), nd(2)); nt(b, "shl", nr(2), ni(3)); nt(b, "add", nr(2), nm(1, 8)); nmov(b, nr(11), nr(2)); nt(b, "add", nr(11), ni(4)); nj(b, "jmp", p + "_walk");
    nl(b, p + "_found"); nmov(b, nd(2), nmd(10, 4)); nmov(b, nmd(11, 0), nd(2)); nmov(b, nd(2), nmd(9, 4)); nt(b, "cmp", nd(2), nd(8)); nj(b, "jne", p + "_clear"); nmov(b, nmd(9, 4), nd(0));
    nl(b, p + "_clear"); nmov(b, nr(0), ni(-1)); nmov(b, nm(10, 0), nr(0)); nl(b, p + "_return"); nret(b);
    nfnEnd(b);

    p = "__tx_wt_notify"; nfn(b, MODULE, "__tx_native_weak_notify_v1"); nleaf(b); nmov(b, nd(2), nd(2)); nt(b, "cmp", nr(2), nm(1, 16)); nj(b, "jae", p + "_empty");
    nj(b, "jmp", p + "_walk"); nl(b, p + "_empty"); nret(b);
    nfnEnd(b);
    nfn(b, MODULE, p + "_walk"); nframe(b, 56); nmov(b, nm(4, 32), nr(1)); nmov(b, nm(4, 40), nr(2));
    nmov(b, nr(10), nr(2)); nt(b, "shl", nr(10), ni(3)); nt(b, "add", nr(10), nm(1, 0)); nmov(b, nd(0), nmd(10, 0)); nmov(b, nr(11), ni(-1)); nmov(b, nm(10, 0), nr(11)); nmov(b, nm(4, 48), nr(0));
    nl(b, p + "_loop"); nmov(b, nd(2), nmd(4, 48)); nt(b, "cmp", nd(2), ni(-1)); nj(b, "je", p + "_done");
    nmov(b, nr(10), nr(2)); nt(b, "shl", nr(10), ni(3)); nmov(b, nr(1), nm(4, 32)); nt(b, "add", nr(10), nm(1, 8)); nmov(b, nd(0), nmd(10, 4)); nmov(b, nm(4, 48), nr(0));
    nmov(b, nr(11), ni(-1)); nmov(b, nm(10, 0), nr(11)); nmov(b, nd(1), nmd(4, 40)); nc(b, "__tx_store_weak_dead_v1"); nj(b, "jmp", p + "_loop");
    nl(b, p + "_done"); nunframe(b, 56);
    nfnEnd(b);

    p = "__tx_wt_destroy"; nfn(b, MODULE, "__tx_native_weak_destroy_v1"); nframe(b, 40); nmov(b, nm(4, 32), nr(1)); nt(b, "cmp", nm(1, 16), ni(0)); nj(b, "je", p + "_clear");
    nmov(b, nr(1), nm(1, 0)); nc(b, "__tx_native_mem_free"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(1), nm(1, 8)); nc(b, "__tx_native_mem_free");
    nl(b, p + "_clear"); nmov(b, nr(1), nm(4, 32)); nmov(b, nr(0), ni(0)); nmov(b, nm(1, 0), nr(0)); nmov(b, nm(1, 8), nr(0)); nmov(b, nm(1, 16), nr(0)); nunframe(b, 40);
    nfnEnd(b);
}
