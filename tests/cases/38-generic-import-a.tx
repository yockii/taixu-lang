// 38-generic-import 的桩模块：显式导入泛型 struct 并实例化，导出一个 Box< Q> 值。
import { Box, Pair, Q, unbox } from "./38-generic-import-g";

export function fa(): string {
    const b = Box<int> { v: 5 };
    const bb = Box<Box<int>> { v: b };
    const q = Box<Q> { v: Q { n: 7 } };
    const p = Pair<string, Q> { first: "a", second: Q { n: 1 } };
    return toStr(unbox(b)) + "," + toStr(bb.v.v) + "," + toStr(unbox(q).n) + "," + p.first + toStr(p.second.n);
}

export function mkQ(): Box<Q> { return Box<Q> { v: Q { n: 9 } }; }
