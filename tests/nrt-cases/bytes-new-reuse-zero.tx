// bytesNew 交出的字节全零，复用释放过的块时同样如此：小块（≤ 16384 字节）从空闲链复用、由 bytesNew 清零；大块经分配器的大块
// 缓存复用、由分配器清零，bytesNew 不再清。各尺寸先写满 255 再释放，随即按同尺寸新建、数非零字节：大块释放即进缓存，同尺寸的
// 新建按页对齐后的总长命中它（16385 与 20000 对齐后也同长，4 KiB 页为 20480、16 KiB 页为 32768）。缓存命中若不清零，大块各行
// 的非零数会等于整块长度。
function dirty(n: int): void {
    const b = bytesNew(n);
    bytesFill(b, 0, n, 255);
}

function nonzero(b: Bytes): int {
    let c = 0;
    let i = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) catch 1) != 0) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

export function main(args: []string): int {
    const sizes = [1, 16, 100, 16384, 16385, 20000, 1048576];
    for (n in sizes) {
        dirty(n);
        const b = bytesNew(n);
        print(toStr(n) + " " + toStr(bytesLen(b)) + " " + toStr(nonzero(b)));
    }
    return 0;
}
