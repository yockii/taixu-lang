// 控制台门的 macOS 系统原语（console_os_unix.tx 用；导出面同 console_sys_linux.tx）：macOS 没有稳定的系统调用接口，经 libSystem；
// 失败的 errno 经 __error() 取（读那个地址上的 4 字节）。
declare function posix_openpt(flags: i32): i32 from "libSystem";
declare function grantpt(fd: i32): i32 from "libSystem";
declare function unlockpt(fd: i32): i32 from "libSystem";
declare function ptsname_r(fd: i32, buf: Bytes, n: usize): i32 from "libSystem";
declare function open(path: string, flags: i32, ...mode: u32): i32 from "libSystem";
declare function poll(fds: Bytes, n: u32, ms: i32): i32 from "libSystem";
declare function read(fd: i32, buf: Bytes, n: usize): isize from "libSystem";
declare function close(fd: i32): i32 from "libSystem";
declare function setsid(): i32 from "libSystem";
declare function isatty(fd: i32): i32 from "libSystem";
declare function __error(): isize from "libSystem";
declare function memcpy(dst: Bytes, src: isize, n: usize): isize from "libSystem";

// 主端 O_RDWR｜O_NOCTTY（posix_openpt 只认这两个）；从端另加 O_CLOEXEC。
const OPEN_MASTER: int = 131074;
const OPEN_PTY: int = 16908290;
const POLLIN: int = 1;

export const EIO: int = 5;
export const EINTR: int = 4;

// 一对 PTY：主端、从端与从端的路径。
export struct Pty {
    master: int,
    slave: int,
    path: string,
}

function errno(): int {
    const b = bytesNew(4);
    const p = memcpy(b, __error(), 4);
    return (bytesGetLE<i32>(b, 0) ?? 0) as int;
}

// posix_openpt、grantpt、unlockpt、ptsname_r 并打开从端（同 os.openpty）。
export function ptyOpen(): Ref<Pty> | Error {
    const master = posix_openpt(OPEN_MASTER as i32) as int;
    if (master < 0) {
        return err("posix_openpt failed: errno " + toStr(errno()));
    }
    const name = bytesNew(128);
    if (grantpt(master as i32) != 0 || unlockpt(master as i32) != 0 || ptsname_r(master as i32, name, 128) != 0) {
        const e = errno();
        const c = close(master as i32);
        return err("unlocking the PTY failed: errno " + toStr(e));
    }
    let n = 0;
    while (n < 128 && (bytesGet(name, n) ?? 0) != 0) {
        n = n + 1;
    }
    const path = bytesToStr(bytesSlice(name, 0, n)) catch "";
    const slave = open(path, OPEN_PTY as i32, 0) as int;
    if (slave < 0) {
        const e = errno();
        const c = close(master as i32);
        return err("open " + path + " failed: errno " + toStr(e));
    }
    return new Pty { master: master, slave: slave, path: path };
}

// 等 fd 可读至多 ms 毫秒：可读（含挂断）为正，超时 0，出错为 −errno。
export function waitReadable(fd: int, ms: int): int {
    const fds = bytesNew(8);
    bytesSetLE<i32>(fds, 0, fd as i32);
    bytesSetLE<i16>(fds, 4, POLLIN as i16);
    const r = poll(fds, 1, ms as i32) as int;
    if (r < 0) {
        return -errno();
    }
    return r;
}

// 读至多 n 字节：读到的字节数，流尾 0，出错为 −errno。
export function readFd(fd: int, buf: Bytes, n: int): int {
    const r = read(fd as i32, buf, n as usize) as int;
    if (r < 0) {
        return -errno();
    }
    return r;
}

export function closeFd(fd: int): void {
    const c = close(fd as i32);
}

// 自成会话（同 Python 的 start_new_session）；失败为 −errno。
export function newSession(): int {
    if ((setsid() as int) < 0) {
        return -errno();
    }
    return 0;
}

// 描述符 n 是不是终端。
export function isTty(n: int): bool {
    return isatty(n as i32) == 1;
}
