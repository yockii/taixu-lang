// 门步 on-demand-link 的工具链样例（--toolchain 编译）：起自己当子进程（带实参 child），等它退出、按退出码判定。
// 它在各目标上放入的内核函数与导入见 tests/odl/<目标>.txt。
export function main(args: []string): int {
    if (len(args) > 0 && args[0] == "child") { return 7; }
    const kids: List<string> = listNew();
    listPush(kids, "child");
    const h = procSpawn(selfExePath(), kids, "", 0) catch (e) {
        eprint(e.message);
        return 1;
    };
    const code = procWait(h, 30000) ?? -1;
    procClose(h);
    if (code != 7) {
        eprint("child exit " + toStr(code));
        return 1;
    }
    print("spawned");
    return 0;
}
