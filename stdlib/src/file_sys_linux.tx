// std/file 系统面的 Linux 目标文件（导出面同 file_sys.tx）：全部经 from syscall（x86_64 调用号），产物保持
// 静态、不依赖 libc。打开带 O_CLOEXEC，新建文件权限 0666（再受 umask 约束）；只读打开后经 fstat 拒绝目录
// （与 Windows 一致）。读、写遇 EINTR 重试。含 NUL 的路径按失败处理。
import { u16At, nulFree } from "./sys_text";

declare function lxRead(fd: int, buf: Bytes, n: int): int from syscall 0;
declare function lxWrite(fd: int, buf: Bytes, n: int): int from syscall 1;
declare function lxClose(fd: int): int from syscall 3;
declare function lxFstat(fd: int, st: Bytes): int from syscall 5;
declare function lxLseek(fd: int, off: int, whence: int): int from syscall 8;
declare function lxOpenat(dir: int, path: string, flags: int, mode: int): int from syscall 257;

const AT_FDCWD: int = -100;
const EINTR: int = 4;
// O_RDONLY｜O_CLOEXEC；O_WRONLY｜O_CREAT｜O_TRUNC｜O_CLOEXEC；O_WRONLY｜O_CREAT｜O_APPEND｜O_CLOEXEC。
const OPEN_READ: int = 524288;
const OPEN_WRITE: int = 524865;
const OPEN_APPEND: int = 525377;
const MODE_0666: int = 438;
// struct stat（x86_64，144 字节）：st_mode 在偏移 24。
const STAT_SIZE: int = 144;
const S_IFMT: int = 61440;
const S_IFDIR: int = 16384;

export function sysFileOpen(path: string, mode: int): int {
    if (!nulFree(path) || len(path) == 0) {
        return -1;
    }
    let flags: int = OPEN_READ;
    if (mode == 1) {
        flags = OPEN_WRITE;
    } else if (mode == 2) {
        flags = OPEN_APPEND;
    }
    let fd: int = lxOpenat(AT_FDCWD, path, flags, MODE_0666);
    while (fd == -EINTR) {
        fd = lxOpenat(AT_FDCWD, path, flags, MODE_0666);
    }
    if (fd < 0) {
        return -1;
    }
    if (mode == 0) {
        const st = bytesNew(STAT_SIZE);
        if (lxFstat(fd, st) != 0 || ((u16At(st, 24) + u16At(st, 26) * 65536) & S_IFMT) == S_IFDIR) {
            lxClose(fd);
            return -1;
        }
    }
    const h = __rtHandleAdd(fd);
    if (h < 0) {
        lxClose(fd);
        return -1;
    }
    return h;
}

export function sysFileRead(h: int, buf: Bytes, n: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    while (true) {
        const r = lxRead(fd, buf, n);
        if (r != -EINTR) {
            if (r < 0) {
                return -1;
            }
            return r;
        }
    }
    return -1;
}

// 从 data 的 off 处写至多 n 字节，返回实际写出的字节数（off > 0 时先切出这一段）。
export function sysFileWrite(h: int, data: Bytes, off: int, n: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    if (n == 0) {
        return 0;
    }
    let src: Bytes = data;
    if (off > 0) {
        src = bytesSlice(data, off, n);
    }
    while (true) {
        const r = lxWrite(fd, src, n);
        if (r != -EINTR) {
            if (r < 0) {
                return -1;
            }
            return r;
        }
    }
    return -1;
}

export function sysFileSeek(h: int, offset: int, whence: int): int {
    const fd = __rtHandlePeek(h);
    if (fd < 0) {
        return -2;
    }
    const r = lxLseek(fd, offset, whence);
    if (r < 0) {
        return -1;
    }
    return r;
}

// close 被信号打断时不重试（Linux 上描述符此时已释放，重试可能关掉别人新打开的）。
export function sysFileClose(h: int): void {
    const fd = __rtHandleTake(h);
    if (fd >= 0) {
        lxClose(fd);
    }
}
