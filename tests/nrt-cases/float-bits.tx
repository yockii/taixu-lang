// D3 v0.23：floatToBits(x: float): int 取 IEEE 双精度的 64 位模式（有符号 int 承载，最高位为符号位），
// floatFromBits(b: int): float 由位模式构造；运行期只换标签、载荷不变（codegen 直发 cvt 种类 25/26）。
// std/math 的纯太虚实现用它们做位操作。
function main(args: []string): int {
    print(toStr(floatToBits(1.0)) + " " + toStr(floatToBits(-2.0)) + " " + toStr(floatToBits(0.5)));
    const z = 0.0;
    print(toStr(floatToBits(z)) + " " + toStr(floatToBits(-z)) + " " + toStr(floatToBits(1.0 / z)) + " " + toStr(floatToBits(5e-324)));
    print(toStr(floatFromBits(4607182418800017408)) + " " + toStr(floatFromBits(1)) + " " + toStr(floatFromBits(9218868437227405312)));
    const nan = floatFromBits(9221120237041090560);
    print(toStr(nan != nan) + " " + toStr(1.0 / floatFromBits(-9223372036854775807 - 1)));
    let x = 3.141592653589793;
    let i = 0;
    while (i < 5) {
        const b = floatToBits(x);
        print(toStr(b) + " " + toStr(floatFromBits(b) == x) + " " + toStr((b >>> 52) & 2047));
        x = x * -1000.0;
        i = i + 1;
    }
    const f: f32 = 0.1;
    print(toStr(floatToBits(f)) + " " + toStr(floatToBits(0.1)));
    return 0;
}
