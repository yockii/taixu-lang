// x86_64-windows 的手写入口与原语（目标分层 X3b）：只有这几处直接用机器指令，
// 其余例程都经 rtfn 发出。aarch64-windows 的同名例程见 windows_a64.tx。
// - 入口：PE 的 AddressOfEntryPoint 指向 __tx_entry，它调用 __tx_native_entry（Windows 上不带参数；该例程以 ExitProcess 结束、
//   不返回）。
// - 线程局部：PE 隐式 TLS——gs 指向 TEB，TEB＋0x58 为 ThreadLocalStoragePointer（各模块的 TLS 块表），本模块的下标由加载器写进
//   __tx_tls_index（内核的 IMAGE_TLS_DIRECTORY64 给出它的地址），槽在 TLS 块的 [0]。
// - 栈探测：__tx_chkstk，微软 __chkstk 的约定。
// - 线程入口：CreateThread 以平台约定调用、返回到 kernel32——是普通的被调函数，带帧事件，展开信息由此生成。
import { Operand, StructuredBuffer, asBufferLabel, asBufferInstruction, asBufferFunctionBegin, asBufferFunctionPrologueEnd, asBufferFunctionEpilogueStart, asBufferFrame, asBufferFunctionEnd, asManualBegin, asManualLeaf, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem, asStructuredSegMem } from "./assemble";

const MODULE: string = "bootstrap/selfhost/windows_x64.tx";

function ins(b: Ref<StructuredBuffer>, mn: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void {
    asBufferInstruction(b, mn, n, a, c, asStructuredMissing(), 1);
}

/// x86_64-windows 的进程入口（PE 规范化 P3，同 aarch64-windows 由内核提供）：系统按平台约定调用，入口 rsp≡8（mod 16），
/// sub 40 使调用点 16 对齐并留出 32 字节影子区；__tx_native_entry 以 ExitProcess 结束、不返回，尾声照常写出以便展开信息描述。
export function windowsX64Start(b: Ref<StructuredBuffer>): void {
    const none = asStructuredMissing();
    asBufferFunctionBegin(b, MODULE, "__tx_entry", "process-thread-entry");
    asBufferLabel(b, "__tx_entry", 1);
    asBufferFrame(b, "allocate-stack", 4, 40);
    asBufferFunctionPrologueEnd(b);
    asBufferInstruction(b, "call", 1, asStructuredTarget("__tx_native_entry"), none, none, 1);
    asBufferFunctionEpilogueStart(b);
    asBufferFrame(b, "release-stack", 4, 40);
    asBufferFrame(b, "return", -1, 8);
    asBufferFunctionEnd(b);
}

/// __tx_chkstk（x86_64-windows，微软 __chkstk 的约定）：rax＝要分配的字节数，从调用方的 rsp 起逐页下移、各读一次（落在保护页上即由
/// 系统扩栈），直到越过新栈顶；只改 r10、r11 与标志位，rax 与 rsp 不变（调用方随后 sub rsp, rax）。叶函数（登记为 runtime-manual），
/// 不需要展开信息。
export function windowsX64Chkstk(b: Ref<StructuredBuffer>): void {
    const none = asStructuredMissing();
    asManualBegin(b, MODULE, "__tx_chkstk"); asManualLeaf(b);
    asBufferInstruction(b, "lea", 2, asStructuredReg(0, 11), asStructuredMem(2, 4, -1, 0, 8, 0, ""), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 10), asStructuredReg(0, 11), none, 1);
    asBufferInstruction(b, "sub", 2, asStructuredReg(0, 10), asStructuredReg(0, 0), none, 1);
    asBufferLabel(b, "__tx_chkstk_page", 1);
    asBufferInstruction(b, "sub", 2, asStructuredReg(0, 11), asStructuredImm(4096), none, 1);
    asBufferInstruction(b, "cmp", 2, asStructuredReg(0, 10), asStructuredMem(3, 11, -1, 0, 0, 0, ""), none, 1);
    asBufferInstruction(b, "cmp", 2, asStructuredReg(0, 11), asStructuredReg(0, 10), none, 1);
    asBufferInstruction(b, "ja", 1, asStructuredTarget("__tx_chkstk_page"), none, none, 1);
    asBufferInstruction(b, "ret", 0, none, none, none, 1);
    asBufferFunctionEnd(b);
}

/// __tx_tls_tb_get() → 本线程的线程块（外来线程为 0）；__tx_tls_tb_set(tb)。只写 rax/rcx/rdx。经 TEB 的 TLS 表与 __tx_tls_index 取槽。
/// 两个都是叶函数，登记为手写函数（runtime-manual，PE 规范化 P3 第 7 项）。
export function windowsX64TlsLeaves(b: Ref<StructuredBuffer>): void {
    const r = asStructuredReg(0, 0);
    asManualBegin(b, MODULE, "__tx_tls_tb_get"); asManualLeaf(b);
    ins(b, "mov", 2, asStructuredReg(1, 0), asStructuredMem(1, -1, -1, 0, 0, 1, "__tx_tls_index"));
    ins(b, "mov", 2, asStructuredReg(0, 1), asStructuredSegMem("gs", 88));
    ins(b, "mov", 2, r, asStructuredMem(2, 1, 0, 3, 0, 0, ""));
    ins(b, "mov", 2, r, asStructuredMem(2, 0, -1, 0, 0, 0, ""));
    ins(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    asBufferFunctionEnd(b);
    asManualBegin(b, MODULE, "__tx_tls_tb_set"); asManualLeaf(b);
    ins(b, "mov", 2, asStructuredReg(1, 0), asStructuredMem(1, -1, -1, 0, 0, 1, "__tx_tls_index"));
    ins(b, "mov", 2, asStructuredReg(0, 2), asStructuredSegMem("gs", 88));
    ins(b, "mov", 2, asStructuredReg(0, 2), asStructuredMem(2, 2, 0, 3, 0, 0, ""));
    ins(b, "mov", 2, asStructuredMem(2, 2, -1, 0, 0, 0, ""), asStructuredReg(0, 1));
    ins(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    asBufferFunctionEnd(b);
}

/// 线程入口：系统以平台约定调用（rcx＝记录，同私有约定的第一个实参），保存 rbx 后转入 __tx_thread_main，返回 0。入口 rsp≡8，
/// push 后 sub 32 使调用点 16 对齐。带帧事件（返回值在尾声之前置 0，尾声是 x64 展开器认得的 add／pop／ret），同 aarch64-windows
/// 的线程入口（PE 规范化 P3）。
export function windowsX64ThreadEntry(b: Ref<StructuredBuffer>): void {
    asBufferFunctionBegin(b, MODULE, "__tx_thread_entry", "process-thread-entry");
    asBufferLabel(b, "__tx_thread_entry", 1);
    asBufferFrame(b, "push-nonvolatile", 3, 8);
    asBufferFrame(b, "allocate-stack", 4, 32);
    asBufferFunctionPrologueEnd(b);
    ins(b, "call", 1, asStructuredTarget("__tx_thread_main"), asStructuredMissing());
    ins(b, "xor", 2, asStructuredReg(1, 0), asStructuredReg(1, 0));
    asBufferFunctionEpilogueStart(b);
    asBufferFrame(b, "release-stack", 4, 32);
    asBufferFrame(b, "pop-nonvolatile", 3, 8);
    asBufferFrame(b, "return", -1, 8);
    asBufferFunctionEnd(b);
}
