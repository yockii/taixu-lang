function div(a: int, b: int): int | Error {
    if (b == 0) { return err("division by zero"); }
    return a / b;
}
function firstByte(s: string): int? {
    if (len(s) == 0) { return None; }
    return len(s);
}
export function main(args: []string): int {
    const a: int = div(9, 3) catch -1;
    const b: int = div(1, 0) catch -1;
    const maybe: int? = div(4, 2) catch None;
    const strict: int | Error = firstByte("taixu") catch err("empty");
    const fb: int = firstByte("") catch 0;
    if (maybe == None) { print("maybe none"); }
    const n = strict catch 0;
    print(toStr(a) + "," + toStr(b) + "," + toStr(n) + "," + toStr(fb));
    return 0;
}
