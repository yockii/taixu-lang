// login —— 多窗口应用面示范（臂④；#18）：
// **登录→主窗顺序流＋并行多窗事件按窗路由**＝实测场景原样验收场。三窗
// 生命周期：登录窗（win 0）与状态窗（win 1）并行开启（各自 App 独立
// pump——事件按 hwnd 路由）；登录成功关登录窗、开主窗（win 2，创建序
// 下标）；主窗登出＝全会话终局。重放脚本 `win <idx>` 指令行按创建序路由
// 数据行（无头通道的按窗注入面；真窗并行＝每 App 独立 hwnd 独立挂起槽，
// 引擎零新面）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/login.txt TAIXU_FRAME=13 taixu run examples/login.tx
// 真窗交互：taixu run examples/login.tx --auto=6000（有界冒烟——登录/
// 状态双窗并行出现，超时自动关全部在册窗）。
import { Canvas, Button, Input, button, input, paintFillRect, paintText, drawButtonC, drawInputC, inputValue } from "gui/components";
import { App, appNew, appClose, pump, onClick, hitZone, textCursor, inputOnKeys, isHover, syncFocus, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { FontBundle, fontUi, fontFree, textCanvasK } from "gui/text";

// —— 组件 id（登录窗 11..13／状态窗 21／主窗 31——窗间互斥不复用）——
const ID_USER: int = 11;
const ID_PASS: int = 12;
const ID_LOGIN: int = 13;
const ID_REFRESH: int = 21;
const ID_LOGOUT: int = 31;

struct Model {
    surface: int,
    user_inp: Ref<Input>,
    pass_inp: Ref<Input>,
    login_btn: Ref<Button>,
    refresh_btn: Ref<Button>,
    logout_btn: Ref<Button>,
    err: string,
    status_clicks: int,
    status_gen: int,
    logged: bool,
    logged_out: bool,
    s_login: int,
    s_status: int,
    s_main: int,
    main_open: bool,
    presents: int,
    main_app: Ref<App>, // 主窗 App（登录成功时改写——经 Ref 持可变态）
    font: int, // 三窗共用的字体句柄
}

// —— 登录窗（win 0）——
function renderLogin(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x202040);
    paintText(cv, 16, 14, 0xFFFFFF, "sign in");
    paintText(cv, 16, 44, 0xD8DCE8, "user");
    syncFocus(app, m.user_inp);
    m.user_inp.x = 60;
    m.user_inp.y = 40;
    drawInputC(cv, m.user_inp);
    paintText(cv, 16, 72, 0xD8DCE8, "pass");
    syncFocus(app, m.pass_inp);
    m.pass_inp.x = 60;
    m.pass_inp.y = 68;
    drawInputC(cv, m.pass_inp);
    m.login_btn.x = 60;
    m.login_btn.y = 100;
    m.login_btn.hovered = isHover(app, ID_LOGIN);
    drawButtonC(cv, m.login_btn);
    if (len(m.err) > 0) {
        paintText(cv, 16, 130, 0xE0A0A0, m.err);
    }
    hitZone(app, ID_USER, m.user_inp.x, m.user_inp.y, m.user_inp.w, 18);
    hitZone(app, ID_PASS, m.pass_inp.x, m.pass_inp.y, m.pass_inp.w, 18);
    hitZone(app, ID_LOGIN, m.login_btn.x, m.login_btn.y, m.login_btn.w, m.login_btn.h);
    textCursor(app, ID_USER);
    textCursor(app, ID_PASS);
}

// —— 状态窗（win 1，与登录窗并行）——
function renderStatus(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x182838);
    paintText(cv, 12, 12, 0xFFFFFF, "server status");
    paintText(cv, 12, 34, 0xC0C8E0, "gen=" + toStr(m.status_gen) + " online");
    m.refresh_btn.x = 12;
    m.refresh_btn.y = 56;
    m.refresh_btn.hovered = isHover(app, ID_REFRESH);
    drawButtonC(cv, m.refresh_btn);
    hitZone(app, ID_REFRESH, m.refresh_btn.x, m.refresh_btn.y, m.refresh_btn.w, m.refresh_btn.h);
}

// —— 主窗（win 2，登录成功后开）——
function renderMain(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x203038);
    paintText(cv, 16, 14, 0xFFFFFF, "welcome, " + inputValue(m.user_inp));
    paintText(cv, 16, 40, 0xC0C8E0, "session gen=" + toStr(m.status_gen));
    m.logout_btn.x = 16;
    m.logout_btn.y = 64;
    m.logout_btn.hovered = isHover(app, ID_LOGOUT);
    drawButtonC(cv, m.logout_btn);
    hitZone(app, ID_LOGOUT, m.logout_btn.x, m.logout_btn.y, m.logout_btn.w, m.logout_btn.h);
}

/// 单窗一帧（surface/canvas 装配＋绘制＋present——presents 计数入 m）。
function frameWindow(win: Ref<App>, surf_h: int, draw: (Ref<Canvas>) => void, m: Ref<Model>): void {
    if (surf_h == 0) {
        return;
    }
    const cv = textCanvasK(surf_h, win.w, win.h, m.font, 14, win.k);
    draw(cv);
    const rc: int = windowPresent(win.hwnd, surf_h);
    if (rc == 0) {
        m.presents = m.presents + 1;
    }
}

/// 各窗绘制面（surface 装配＋frameWindow——presents 计数入 m）。
function renderLoginSurface(app: Ref<App>, m: Ref<Model>): void {
    frameWindow(app, m.s_login, (cv: Ref<Canvas>): void => {
            renderLogin(cv, app, m);
        }, m);
    app.dirty = false;
}

function renderStatusSurface(app: Ref<App>, m: Ref<Model>): void {
    frameWindow(app, m.s_status, (cv: Ref<Canvas>): void => {
            renderStatus(cv, app, m);
        }, m);
    app.dirty = false;
}

function renderMainSurface(app: Ref<App>, m: Ref<Model>): void {
    frameWindow(app, m.s_main, (cv: Ref<Canvas>): void => {
            renderMain(cv, app, m);
        }, m);
    app.dirty = false;
}

export function main(args: []string): int {
    args;
    const login = appNew(defaultSpec("taixu login", 260, 170));
    const m: Ref<Model> = new Model {
        surface: 0,
        user_inp: input(ID_USER, 0, 0, 120, ""),
        pass_inp: input(ID_PASS, 0, 0, 120, ""),
        login_btn: button(ID_LOGIN, 0, 0, 72, 22, "sign in"),
        refresh_btn: button(ID_REFRESH, 0, 0, 72, 22, "refresh"),
        logout_btn: button(ID_LOGOUT, 0, 0, 72, 22, "logout"),
        err: "",
        status_clicks: 0,
        status_gen: 1,
        logged: false,
        logged_out: false,
        s_login: 0,
        s_status: 0,
        s_main: 0,
        main_open: false,
        presents: 0,
        main_app: login, // 哑占位（main_open=false 期间不泵不绘）
        font: 0,
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb: Ref<FontBundle> = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(login);
        return 1;
    };
    m.font = fb.handle;
    // 窗 0＝登录窗、窗 1＝状态窗（并行双窗——创建序即重放 win 下标）。
    const status = appNew(defaultSpec("taixu status", 200, 100));
    m.s_login = surfaceOpenDip(login.spec.w, login.spec.h, login.k) catch 0;
    m.s_status = surfaceOpenDip(status.spec.w, status.spec.h, status.k) catch 0;
    // 事件装配（窗间互斥 id——按窗 App 分发天然隔离）。
    inputOnKeys(login, m.user_inp, (v: string): void => {});
    inputOnKeys(login, m.pass_inp, (v: string): void => {});
    onClick(login, ID_LOGIN, (rec: EventRecord): void => {
            if (rec.kind != 3) {
                return;
            }
            if (len(inputValue(m.user_inp)) == 0) {
                m.err = "user required";
                return;
            }
            if (len(inputValue(m.pass_inp)) < 4) {
                m.err = "pass too short";
                return;
            }
            m.err = "";
            m.logged = true;
            login.running = false; // 顺序流：登录窗关
            // 主窗开（创建序下标 2——重放 win 2 行自此可达）。
            m.main_app = appNew(defaultSpec("taixu main", 280, 120));
            m.s_main = surfaceOpenDip(m.main_app.spec.w, m.main_app.spec.h, m.main_app.k) catch 0;
            onClick(m.main_app, ID_LOGOUT, (rec2: EventRecord): void => {
                    if (rec2.kind != 3) {
                        return;
                    }
                    m.logged_out = true;
                    m.main_app.running = false;
                    status.running = false; // 登出＝全会话终局
                });
            m.main_open = true;
        });
    onClick(status, ID_REFRESH, (rec: EventRecord): void => {
            if (rec.kind != 3) {
                return;
            }
            m.status_clicks = m.status_clicks + 1;
            m.status_gen = m.status_gen + 1;
        });
    // 并行泵循环（每 App 独立 pump——事件按窗路由；帧号＝全局 present 计数；
    // 一窗关闭不阻断他窗同拍消费）。
    let frame: int = 0;
    while (login.running || status.running || (m.main_open && m.main_app.running)) {
        if (login.running) {
            if (pump(login, 16) && login.dirty) {
                renderLoginSurface(login, m);
            }
        }
        if (status.running) {
            if (pump(status, 16) && status.dirty) {
                renderStatusSurface(status, m);
            }
        }
        if (m.main_open && m.main_app.running) {
            if (pump(m.main_app, 16) && m.main_app.dirty) {
                renderMainSurface(m.main_app, m);
            }
        }
        frame = frame + 1;
        if (frame > 100000) {
            login.running = false;
            status.running = false;
            if (m.main_open) {
                m.main_app.running = false;
            }
        }
    }
    print("user=" + inputValue(m.user_inp) + " logged=" + toStr(m.logged) + " status_clicks=" + toStr(m.status_clicks) + " gen=" + toStr(m.status_gen) + " main=" + toStr(m.main_open) + " logged_out=" + toStr(m.logged_out) + " presents=" + toStr(m.presents));
    appClose(login);
    appClose(status);
    if (m.main_open) {
        appClose(m.main_app);
    }
    surfaceClose(m.s_login);
    surfaceClose(m.s_status);
    if (m.main_open) {
        surfaceClose(m.s_main);
    }
    fontFree(fb);
    return 0;
}
