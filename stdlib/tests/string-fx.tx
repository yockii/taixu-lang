// ============================================================================
// stdlib 用例：字符串工具（V0.7-S3；D20 §四-2——ASCII 大小写先行，字节/码点行为）
// 运行：taixu test tests/string-fx.tx
// ============================================================================

import { split, join, contains, indexOf, replace, trimStart, trimEnd, toLower, toUpper } from "std/string";

test "split：保留空段与尾部段" {
    const a = split("a,b,,c", ",");
    assert(listLen(a) == 4, "应切 4 段");
    assert((listGet(a, 0) catch "") == "a", "段 0");
    assert((listGet(a, 2) catch "") == "", "空段保留");
    assert((listGet(a, 3) catch "") == "c", "段 3");
    const noSep = split("solo", ",");
    assert(listLen(noSep) == 1 && (listGet(noSep, 0) catch "") == "solo", "无分隔符返回原串");
    const multi = split("x::y", "::");
    assert(listLen(multi) == 2 && (listGet(multi, 1) catch "") == "y", "多字节分隔符");
}

test "join 与 split 往返" {
    const parts: List<string> = listNew();
    listPush(parts, "a");
    listPush(parts, "b");
    assert(join(parts, "-") == "a-b", "join 基本形");
    assert(join(parts, "") == "ab", "空 sep 直连");
    assert(join(split("1.2.3", "."), ".") == "1.2.3", "split→join 往返");
}

test "contains/indexOf：字节匹配与边界" {
    assert(contains("taixu", "ix"), "应包含 ix");
    assert(!contains("taixu", "xy"), "不应包含 xy");
    assert(indexOf("taixu", "ix") == 2, "ix 首现于 2");
    assert(indexOf("taixu", "zz") == -1, "缺失为 -1");
    assert(indexOf("abc", "") == 0, "空子串为 0");
    assert(contains("太虚语言", "虚"), "多字节文本内 ASCII 查找");
}

test "replace：首次出现（TS 语义）" {
    assert(replace("a-b-c", "-", "+") == "a+b-c", "仅替换首次");
    assert(replace("abc", "z", "q") == "abc", "无命中返回原串");
    assert(replace("abc", "", "x") == "abc", "空 old 返回原串");
}

test "trim 与大小写（ASCII 先行）" {
    assert(trimStart("  \t x") == "x", "trimStart");
    assert(trimEnd("x \r\n") == "x", "trimEnd");
    assert(trimStart("") == "", "空串");
    assert(toLower("AbC") == "abc", "toLower ASCII");
    assert(toUpper("aBc") == "ABC", "toUpper ASCII");
    assert(toLower("太虚") == "太虚", "非 ASCII 原样");
    assert(toUpper("太虚A") == "太虚A", "混合文本仅 ASCII 映射");
}
