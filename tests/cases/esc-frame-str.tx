// esc-frame-str —— V0.23-P1 柱①③运行期命中负载（D59）：堆引用字段 struct
// 的循环内帧分配（heap-field struct → 标量资格剥夺 → 柱①帧形态）＋二元
// 拼接结果栈缓冲（柱③）。TAIXU_TX_ESC_STATS=1 运行期计数：frame_creates
// 应＝轮数、heap_payload_allocs 应＝0（esc 关形态＝10000——负向锚）。
struct Row { name: string, n: int }

function work(k: int): int {
    let total: int = 0;
    let i: int = 0;
    while (i < k) {
        const r: Ref<Row> = new Row { name: "row", n: i };
        total = total + r.n + len(r.name);
        const s: string = "r" + toStr(i);
        total = total + len(s);
        i = i + 1;
    }
    return total;
}

export function main(args: []string): int {
    print(toStr(work(10000)));
    return 0;
}
