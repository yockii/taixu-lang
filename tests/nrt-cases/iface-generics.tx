// D3 v0.20 泛型约束：T extends 接口（调用点按约束检查实参类型，定义处按约束检查模板体）、泛型接口、
// 约束可取接口类型本身、泛型 struct 的约束；模板体内 for-in。
interface Hashable {
    hash(): int;
}

interface Comparable<T> {
    compare(other: T): int;
}

struct Point { x: int, y: int }

function pointHash(p: Point): int { return p.x * 31 + p.y; }
function intHash(x: int): int { return x * 7; }
function intCompare(a: int, b: int): int { return a - b; }
function stringCompare(a: string, b: string): int { return len(a) - len(b); }

function hashAll<T extends Hashable>(xs: List< T>): int {
    let h: int = 0;
    for (x in xs) {
        h = h + x.hash();
    }
    return h;
}

function maxOf<T extends Comparable< T>>(xs: List< T>, first: T): T {
    let best: T = first;
    for (x in xs) {
        if (x.compare(best) > 0) { best = x; }
    }
    return best;
}

struct Box<T> { v: T }
function boxHash<T extends Hashable>(b: Box< T>): int { return b.v.hash() + 1; }

function main(args: []string): int {
    const ps: List< Ref< Point>> = listNew();
    print(toStr(boxHash(Box< Point> { v: Point { x: 1, y: 2 } })));
    const ns: List< int> = listNew();
    listPush(ns, 5);
    listPush(ns, 9);
    listPush(ns, 2);
    print(toStr(hashAll(ns)));
    print(toStr(maxOf(ns, 0)));
    const ss: List< string> = listNew();
    listPush(ss, "ab");
    listPush(ss, "abcd");
    listPush(ss, "a");
    print(maxOf(ss, ""));
    const b = Box< int> { v: 10 };
    print(toStr(boxHash(b)));
    const hs: List< Hashable> = listNew();
    listPush(hs, Point { x: 1, y: 1 });
    listPush(hs, 3);
    print(toStr(hashAll(hs)));
    return 0;
}
