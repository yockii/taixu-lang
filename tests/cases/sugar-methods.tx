struct Point { x: int, y: int }

function magnitude(p: Point): int {
    return p.x * p.x + p.y * p.y;
}

function sum(l: List<int>): int {
    let acc: int = 0;
    for (x in l) {
        acc = acc + x;
    }
    return acc;
}

export function main(args: []string): int {
    const p: Point = { x: 3, y: 4 };
    const nums: List<int> = listNew();
    nums.push(3);
    nums.push(4);
    nums.push(nums.len());
    print(toStr(nums.get(2) catch 0));
    nums.set(0, 10);
    print(`mag=${p.magnitude()} sum=${sum(nums)}`);
    print(toStr(nums.pop() catch 0));
    return 0;
}
