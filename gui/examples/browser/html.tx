// 宽容的 HTML 子集文档；节点以索引连接，没有父子 Ref 环，不执行脚本。
import { toLower, trim } from "std/string";
import { encode } from "std/utf8";
import { newBuilder, writeString, build } from "std/bytes";

export struct HtmlNode { tag: string, text: string, attributes: Map<string, string>, parent: int, children: List<int> }
export struct HtmlDocument { nodes: List<Ref<HtmlNode>>, title: string, styles: List<string>, baseHref: string }
struct Tag { name: string, closing: bool, attributes: Map<string, string>, next: int }

function space(c: int): bool { return c == 9 || c == 10 || c == 12 || c == 13 || c == 32; }
function alpha(c: int): bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
function nameByte(c: int): bool { return alpha(c) || (c >= 48 && c <= 57) || c == 45 || c == 58 || c == 95; }
function starts(source: string, at: int, word: string): bool {
    if (at < 0 || at > len(source) - len(word)) { return false; }
    let i = 0; while (i < len(word)) { if (byteAt(source, at + i) != byteAt(word, i)) { return false; } i = i + 1; } return true;
}
function lowerStarts(source: string, at: int, word: string): bool {
    if (at < 0 || at > len(source) - len(word)) { return false; }
    let i = 0; while (i < len(word)) { let b = byteAt(source, at + i); if (b >= 65 && b <= 90) { b = b + 32; } if (b != byteAt(word, i)) { return false; } i = i + 1; } return true;
}
function findFrom(source: string, word: string, start: int): int {
    let i = start; while (i <= len(source) - len(word)) { if (byteAt(source, i) == byteAt(word, 0) && starts(source, i, word)) { return i; } i = i + 1; } return -1;
}
function scalar(value: int): string {
    let cp = value; if (cp == 0 || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { cp = 65533; }
    const c1: List<int> = [8364, 129, 8218, 402, 8222, 8230, 8224, 8225, 710, 8240, 352, 8249, 338, 141, 381, 143, 144, 8216, 8217, 8220, 8221, 8226, 8211, 8212, 732, 8482, 353, 8250, 339, 157, 382, 376];
    if (cp >= 128 && cp <= 159) { cp = listGet(c1, cp - 128); } return encode(cp);
}
function named(name: string): string {
    if (name == "amp" || name == "AMP") { return "&"; } if (name == "lt" || name == "LT") { return "<"; }
    if (name == "gt" || name == "GT") { return ">"; } if (name == "quot" || name == "QUOT") { return "\""; }
    if (name == "apos") { return "'"; } if (name == "nbsp") { return encode(160); }
    if (name == "copy") { return encode(169); } if (name == "reg") { return encode(174); } if (name == "hellip") { return encode(8230); }
    if (name == "ndash") { return encode(8211); } if (name == "mdash") { return encode(8212); }
    if (name == "laquo") { return encode(171); } if (name == "raquo") { return encode(187); } return "";
}
// 结果按段持有、末尾一次拼接（std/bytes 的 Builder），实体再多也是线性的。
export function htmlEntities(source: string, attribute: bool): string {
    const out = newBuilder(); let chunk = 0; let i = 0;
    while (i < len(source)) {
        if (byteAt(source, i) != 38) { i = i + 1; continue; }
        let end = i + 1; let replacement = "";
        if (end < len(source) && byteAt(source, end) == 35) {
            end = end + 1; let base = 10; if (end < len(source) && (byteAt(source, end) == 120 || byteAt(source, end) == 88)) { base = 16; end = end + 1; }
            const digits = end; let value = 0;
            while (end < len(source)) {
                const c = byteAt(source, end); let digit = -1;
                if (c >= 48 && c <= 57) { digit = c - 48; } else if (base == 16 && c >= 65 && c <= 70) { digit = c - 55; } else if (base == 16 && c >= 97 && c <= 102) { digit = c - 87; }
                if (digit < 0) { break; } if (value <= 1114111) { value = value * base + digit; } end = end + 1;
            }
            if (end > digits) { replacement = scalar(value); if (end < len(source) && byteAt(source, end) == 59) { end = end + 1; } }
        } else {
            const start = end; while (end < len(source) && end - start <= 16 && (alpha(byteAt(source, end)) || (byteAt(source, end) >= 48 && byteAt(source, end) <= 57))) { end = end + 1; }
            const entity = strSlice(source, start, end); const semicolon = end < len(source) && byteAt(source, end) == 59;
            if (semicolon) { replacement = named(entity); end = end + 1; }
            else if (entity == "amp" || entity == "lt" || entity == "gt" || entity == "quot" || entity == "nbsp") {
                if (!attribute || end == len(source) || byteAt(source, end) != 61) { replacement = named(entity); }
            }
        }
        if (len(replacement) == 0) { i = i + 1; continue; }
        writeString(out, strSlice(source, chunk, i)); writeString(out, replacement); i = end; chunk = end;
    } writeString(out, strSlice(source, chunk, len(source))); return build(out);
}

function tag(source: string, start: int): Tag | Error {
    let i = start + 1; let closing = false; if (i < len(source) && byteAt(source, i) == 47) { closing = true; i = i + 1; }
    const empty = Tag { name: "", closing: closing, attributes: mapNew(), next: start + 1 };
    if (i >= len(source) || !alpha(byteAt(source, i))) { return empty; }
    const begin = i; while (i < len(source) && nameByte(byteAt(source, i))) { i = i + 1; }
    const name = toLower(strSlice(source, begin, i)); const attributes: Map<string, string> = mapNew(); let count = 0;
    while (i < len(source)) {
        while (i < len(source) && space(byteAt(source, i))) { i = i + 1; } if (i == len(source)) { break; }
        if (byteAt(source, i) == 62) { i = i + 1; break; } if (byteAt(source, i) == 47) { i = i + 1; continue; }
        const keyStart = i;
        while (i < len(source) && !space(byteAt(source, i)) && byteAt(source, i) != 61 && byteAt(source, i) != 62 && byteAt(source, i) != 47) { i = i + 1; }
        if (i == keyStart) { i = i + 1; continue; }
        const key = toLower(strSlice(source, keyStart, i)); while (i < len(source) && space(byteAt(source, i))) { i = i + 1; } let value = "";
        if (i < len(source) && byteAt(source, i) == 61) {
            i = i + 1; while (i < len(source) && space(byteAt(source, i))) { i = i + 1; }
            if (i < len(source) && (byteAt(source, i) == 34 || byteAt(source, i) == 39)) {
                const quote = byteAt(source, i); i = i + 1; const valueStart = i; while (i < len(source) && byteAt(source, i) != quote) { i = i + 1; }
                value = strSlice(source, valueStart, i); if (i < len(source)) { i = i + 1; }
            } else { const valueStart = i; while (i < len(source) && !space(byteAt(source, i)) && byteAt(source, i) != 62) { i = i + 1; } value = strSlice(source, valueStart, i); }
        }
        // 超过 128 个的属性与超长属性名照常读过、不保存，不使整页失败。
        count = count + 1; if (count <= 128 && len(key) <= 1024 && !mapHas(attributes, key)) { mapSet(attributes, key, htmlEntities(value, true)); }
    } return Tag { name: name, closing: closing, attributes: attributes, next: i };
}
function oneOf(name: string, names: string): bool { return strFind(" " + names + " ", " " + name + " ") >= 0; }
function block(name: string): bool { return oneOf(name, "address article aside blockquote div dl fieldset footer form h1 h2 h3 h4 h5 h6 header hr main nav ol p pre section table ul"); }
function voidTag(name: string): bool { return oneOf(name, "area base br col embed hr img input link meta param source track wbr"); }
function close(stack: List<int>, document: Ref<HtmlDocument>, name: string): void {
    let i = listLen(stack) - 1;
    while (i > 0) { if (listGet(document.nodes, listGet(stack, i)).tag == name) { while (listLen(stack) > i) { listPop(stack); } return; } i = i - 1; }
}
// HTML5 的省略结束标签：开新的同类元素时，向上闭合最近一个未闭合的 open 中的元素，遇到 boundary 中的元素即止。
function implied(stack: List<int>, document: Ref<HtmlDocument>, open: string, boundary: string): void {
    let at = listLen(stack) - 1;
    while (at > 0) { const name = listGet(document.nodes, listGet(stack, at)).tag; if (oneOf(name, boundary)) { return; } if (oneOf(name, open)) { close(stack, document, name); return; } at = at - 1; }
}
function append(document: Ref<HtmlDocument>, parent: int, name: string, text: string, attributes: Map<string, string>): int | Error {
    if (listLen(document.nodes) >= 50000) { return err("browser html: node count limit"); }
    const index = listLen(document.nodes); listPush(document.nodes, new HtmlNode { tag: name, text: text, attributes: attributes, parent: parent, children: listNew() });
    if (parent >= 0) { listPush(listGet(document.nodes, parent).children, index); } return index;
}
function text(document: Ref<HtmlDocument>, parent: int, value: string): void | Error {
    if (len(value) == 0) { return done(); } append(document, parent, "#text", value, mapNew())?; return done();
}
function rawEnd(source: string, start: int, name: string): int {
    const needle = "</" + name; let i = start;
    while (i < len(source)) {
        if (byteAt(source, i) == 60 && lowerStarts(source, i, needle)) {
            const end = i + len(needle); if (end == len(source) || space(byteAt(source, end)) || byteAt(source, end) == 62 || byteAt(source, end) == 47) { return i; }
        } i = i + 1;
    } return len(source);
}

export function htmlParse(source: string): Ref<HtmlDocument> | Error {
    if (len(source) > 16777216) { return err("browser html: source limit"); }
    const document = new HtmlDocument { nodes: listNew(), title: "", styles: listNew(), baseHref: "" };
    append(document, -1, "#document", "", mapNew())?; const stack: List<int> = [0]; let i = 0;
    while (i < len(source)) {
        // 节点数到上限就截断（每轮至多新增元素与其文本两个节点），已解析的部分照常呈现。
        if (listLen(document.nodes) >= 49998) { break; }
        const parent = listGet(stack, listLen(stack) - 1);
        if (byteAt(source, i) != 60) { const start = i; while (i < len(source) && byteAt(source, i) != 60) { i = i + 1; } text(document, parent, htmlEntities(strSlice(source, start, i), false))?; continue; }
        if (starts(source, i, "<!--")) { const end = findFrom(source, "-->", i + 4); if (end < 0) { break; } i = end + 3; continue; }
        if (starts(source, i, "<!") || starts(source, i, "<?")) { while (i < len(source) && byteAt(source, i) != 62) { i = i + 1; } if (i < len(source)) { i = i + 1; } continue; }
        const token = tag(source, i)?; const tagStart = i; i = token.next;
        if (len(token.name) == 0) {
            // 连续的字面角括号一次归为文本，不逐字符拼接已有节点。
            while (i < len(source)) {
                if (byteAt(source, i) == 60 && i + 1 < len(source)) { const next = byteAt(source, i + 1); if (alpha(next) || next == 47 || next == 33 || next == 63) { break; } }
                i = i + 1;
            } text(document, parent, htmlEntities(strSlice(source, tagStart, i), false))?; continue;
        }
        if (token.closing) { close(stack, document, token.name); continue; }
        if (block(token.name)) { close(stack, document, "p"); }
        if (token.name == "li") { implied(stack, document, "li", "ul ol"); }
        else if (token.name == "td" || token.name == "th") { implied(stack, document, "td th", "tr table"); }
        else if (token.name == "tr") { implied(stack, document, "tr", "table tbody thead tfoot"); }
        else if (token.name == "option") { implied(stack, document, "option", "select datalist optgroup"); }
        else if (token.name == "dd" || token.name == "dt") { implied(stack, document, "dd dt", "dl"); }
        if (oneOf(token.name, "h1 h2 h3 h4 h5 h6")) { const current = listGet(document.nodes, listGet(stack, listLen(stack) - 1)).tag; if (oneOf(current, "h1 h2 h3 h4 h5 h6")) { close(stack, document, current); } }
        const node = append(document, listGet(stack, listLen(stack) - 1), token.name, "", token.attributes)?;
        if (token.name == "base" && len(document.baseHref) == 0) { document.baseHref = mapGet(token.attributes, "href") catch ""; }
        if (oneOf(token.name, "script style title textarea")) {
            const end = rawEnd(source, i, token.name); let value = strSlice(source, i, end);
            if (token.name == "title" || token.name == "textarea") { value = htmlEntities(value, false); }
            text(document, node, value)?;
            if (token.name == "title" && len(document.title) == 0) { document.title = trim(value); }
            if (token.name == "style") { listPush(document.styles, value); } i = end;
            if (i < len(source)) { i = (tag(source, i)?).next; } continue;
        }
        // 超过深度上限的元素照样插入但不压栈，后续内容挂在当前父节点下（同 Blink 的最大树深处理），不使整页失败。
        if (!voidTag(token.name) && listLen(stack) < 256) { listPush(stack, node); }
    } return document;
}
export function htmlTextContent(document: Ref<HtmlDocument>, index: int): string {
    let out = ""; const pending: List<int> = [index];
    while (listLen(pending) > 0) {
        const node = listGet(document.nodes, listPop(pending)); if (node.tag == "#text") { out = out + node.text; }
        let i = listLen(node.children) - 1; while (i >= 0) { listPush(pending, listGet(node.children, i)); i = i - 1; }
    } return out;
}
function done(): void {}
