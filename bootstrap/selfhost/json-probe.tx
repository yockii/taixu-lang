// json-probe.tx —— json_parse.tx 的差分探针（第 6 轮 6c-4a，调试实施设计 §六）。用法：json-probe <用例文件>
// 用例文件每行一个用例：字母 x 后跟十六进制编码的输入字节（空输入也占一行）；每个用例输出一行规范形：
//   n、t、f、i<十进制>、d<数的原文>、s<串的十六进制>、[元素,…]、{<键的十六进制>:<值>,…}；解析失败为 ERR。
// scripts/test-native-json.py 生成用例，并以 Python json（补上 Zig std.json 的规则）给出期望。
import { JsonValue, jsonParse, JSON_NULL, JSON_BOOL, JSON_INT, JSON_NUM, JSON_STR, JSON_ARR, JSON_OBJ } from "./json_parse";

const HEX: string = "0123456789abcdef";

function hexDigit(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return 0;
}

function unhex(line: string): Bytes {
    const b = bytesNew(0);
    let i = 1;
    while (i + 1 < len(line)) {
        bytesPush(b, hexDigit(byteAt(line, i) catch 48) * 16 + hexDigit(byteAt(line, i + 1) catch 48));
        i = i + 2;
    }
    return b;
}

function put(out: Bytes, s: string): void {
    bytesAppend(out, bytesFromStr(s));
}

function putHex(out: Bytes, s: string): void {
    let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 0;
        bytesPush(out, byteAt(HEX, c >> 4) catch 48);
        bytesPush(out, byteAt(HEX, c & 15) catch 48);
        i = i + 1;
    }
}

// 标量直接写；数组与对象只写开括号，返回 true 让调用方入栈。
function putOpen(out: Bytes, v: Ref<JsonValue>): bool {
    if (v.kind == JSON_NULL) { put(out, "n"); return false; }
    if (v.kind == JSON_BOOL) {
        if (v.i == 1) { put(out, "t"); } else { put(out, "f"); }
        return false;
    }
    if (v.kind == JSON_INT) { put(out, "i" + toStr(v.i)); return false; }
    if (v.kind == JSON_NUM) { put(out, "d" + v.s); return false; }
    if (v.kind == JSON_STR) {
        put(out, "s");
        putHex(out, v.s);
        return false;
    }
    if (v.kind == JSON_ARR) { put(out, "["); } else { put(out, "{"); }
    return true;
}

// 规范形（显式栈，深嵌套不递归）。
function canon(root: Ref<JsonValue>): string {
    const out = bytesNew(0);
    const vs: List<Ref<JsonValue>> = listNew();
    const ks: List<int> = listNew();
    if (putOpen(out, root)) {
        listPush(vs, root);
        listPush(ks, 0);
    }
    while (listLen(vs) > 0) {
        const d = listLen(vs) - 1;
        const top = listGet(vs, d) catch root;
        const k = listGet(ks, d) catch 0;
        if (k >= listLen(top.items)) {
            if (top.kind == JSON_ARR) { put(out, "]"); } else { put(out, "}"); }
            listRemoveAt(vs, d);
            listRemoveAt(ks, d);
        } else {
            if (k > 0) { put(out, ","); }
            if (top.kind == JSON_OBJ) {
                putHex(out, listGet(top.keys, k) catch "");
                put(out, ":");
            }
            listSet(ks, d, k + 1);
            const child = listGet(top.items, k) catch root;
            if (putOpen(out, child)) {
                listPush(vs, child);
                listPush(ks, 0);
            }
        }
    }
    return bytesToStr(out) catch "?";
}

function runCase(line: string): string {
    const v = jsonParse(unhex(line)) catch (e) { return "ERR"; };
    return canon(v);
}

function main(args: []string): int {
    if (len(args) < 1) {
        eprint("用法: json-probe <用例文件>");
        return 64;
    }
    const text = readFile(args[0]) catch (e) {
        eprint(e.message);
        return 1;
    };
    const lines = strSplit(text, "\n");
    let i = 0;
    while (i < listLen(lines)) {
        const line = listGet(lines, i) catch "";
        if (len(line) > 0) { print(runCase(line)); }
        i = i + 1;
    }
    return 0;
}
