// 08 定时器、超时与组级取消：sleepMs、std/task 的 timeout 与 taskGroupCancel。
// 输出只依赖两种确定的定时器：0ms（同刻到期，按登记序唤醒）与远未到期的长定时器
// （60000ms，只作为被超时或取消的一方出场，程序不会真的等它）。
import { taskGroupNew, taskGroupAdd, taskGroupCancel, timeout } from "std/task";

// sleepMs(0)：下一轮即到期——两个任务同刻登记，唤醒序＝登记序。
async function sleeper(tag: string): int {
    await sleepMs(0) catch (e) {
        print(tag + " sleep err: " + e.message);
        return -1;
    };
    print("woke-" + tag);
    return 0;
}

// 远未到期的长任务：只作为 timeout／组取消的落败者。
async function stalled(tag: string): int {
    const s = sleepMs(60000);
    await s catch (e) {
        print(tag + ": " + e.message);
        return -1;
    };
    return 0;
}

// timeout(f, 0)：立即判超时，落败的任务被 taskCancel（取消即清理）。
async function withTimeout(): int {
    const slow = stalled("timeout-loser");
    const v = await timeout(slow, 0) catch (e) {
        print("timeout err: " + e.message);
        return 0;
    };
    print("unreachable:" + toStr(v));
    return 0;
}

// taskGroupCancel(tg)：按登记序逐个 taskCancel，
// 之后 await 组内任务得 err("task cancelled")。
async function batch(): int {
    const tg = taskGroupNew();
    const f = stalled("group-loser");
    const slot = taskGroupAdd(tg, f); // 返回组内槽位号（登记序）
    print("added slot:" + toStr(slot));
    taskGroupCancel(tg) catch (e) { // 组级取消：void | Error
        print("cancel failed: " + e.message);
        return 1;
    };
    const out = await f catch (e) {
        print("cancelled: " + e.message);
        return 0;
    };
    print("unreachable:" + toStr(out));
    return 0;
}

export function main(args: []string): int {
    const a = sleeper("a");
    const b = sleeper("b");
    withTimeout();
    batch();
    return 0;
}
