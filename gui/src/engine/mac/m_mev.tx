// ============================================================================
// engine/mac/m_mev —— objc_msgSend：+[NSEvent mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:]（测试投递用）。
// ============================================================================

import { NSPOINT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, ty: usize, loc: NSPOINT, flags: usize, ts: float, wnum: int, ctx: usize, evnum: int, clicks: int, pressure: f32): usize from "/usr/lib/libobjc.A.dylib";

export function msgMouseEvent(nsevent: usize, ty: int, x: float, y: float, flags: int, wnum: int): usize {
    return objc_msgSend(nsevent, sel_registerName("mouseEventWithType:location:modifierFlags:timestamp:windowNumber:context:eventNumber:clickCount:pressure:"), ty as usize, NSPOINT { x: x, y: y }, flags as usize, 0.0, wnum, 0, 0, 1, 1.0);
}
