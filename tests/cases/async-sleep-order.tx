// 定时器 e2e：定时器同刻登记序——两任务同刻 sleepMs(0)，
// 唤醒序＝登记序（deadline 升序/同刻登记序——确定性红线时间维度延伸）。
function main(args: []string): int {
    const a = sleeper("a");
    const b = sleeper("b");
    const c = join(a, b);
    print("spawned");
    const aDone = await a;
    const bDone = await b;
    const cDone = await c;
    return 0;
}

async function sleeper(tag: string): int {
    await sleepMs(0) catch (e) {
        print(tag + " sleep err: " + e.message);
        return -1;
    };
    print("woke-" + tag);
    return 0;
}

async function join(a: Future<int>, b: Future<int>): int {
    const x = await a catch -1;
    const y = await b catch -1;
    return x + y;
}
