// 编译器自身所在的宿主（M0 实施说明 §三-6）：hostTarget() 在编译器里恒指宿主，只用于“在宿主上执行，所以目标就是
// 宿主”的地方（run、test、dap、mcp、lsp 的分析目标、build 等的缺省目标）。hostTarget 是工具链专用内建，所以单放一个
// 模块——内核生成器等不带 --toolchain 构建的程序只引 target.tx。
import { targetParseAnalysis, targetFlag } from "./target";

// 宿主目标按“架构-系统”三元组取（macOS 适配 M4f）：同一系统名在 x86_64 与 arm64 宿主上是两个目标。
export function hostTargetId(): int { return targetParseAnalysis(hostArch() + "-" + hostTarget()); }
/// 命令行 `--target=`（target.tx 的 targetFlag），不带架构的系统名按本宿主的架构取。
export function targetFlagHost(arg: string): int { return targetFlag(arg, hostArch()); }
