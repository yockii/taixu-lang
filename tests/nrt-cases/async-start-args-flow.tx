// 回归：async_start（以及同样把实参交给任务持有的 gen_new）的第 4 个起的实参经 &&、??、catch 跨块求值。
// 原生发射的块级活跃集合曾漏掉 async_start 的被调值与第 4 个起的实参（node.uses 只放前 3 个，块级补充列表漏了 op38）：
// 前一块的寄存器段在段末不写回它们，任务拿到的是槽里的旧值（普通构建 true 29 得 false 8；--debug 全量写回所以不现）。
async function work(a: int, b: int, c: int, d: bool, e: int, f: int): int {
    print("async " + toStr(a) + " " + toStr(b) + " " + toStr(c) + " " + toStr(d) + " " + toStr(e) + " " + toStr(f));
    return 0;
}

function* steps(a: int, b: int, c: int, d: bool, e: int, f: int): string {
    yield "gen " + toStr(a) + " " + toStr(b) + " " + toStr(c) + " " + toStr(d) + " " + toStr(e) + " " + toStr(f);
}

function maybe(n: int): int? {
    if (n > 3) { return n * 10; }
    return None;
}

function start(n: int, raw: Bytes): void {
    const k = n * 7 + 1;
    const fut = work(k, k + 1, k + 2, k > 2 && k < 90, maybe(n) ?? (k * 3 + 5), bytesGet(raw, n) catch (k - 1));
    for (s in steps(k, k + 1, k + 2, k > 2 && k < 90, maybe(n) ?? (k * 3 + 5), bytesGet(raw, n) catch (k - 1))) {
        print(s);
    }
}

function main(args: []string): int {
    const raw = bytesFromStr("abcdefg");
    start(len(args) + 1, raw);
    start(len(args) + 5, raw);
    start(len(args) + 20, raw);
    return 0;
}
