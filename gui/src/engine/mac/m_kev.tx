// ============================================================================
// engine/mac/m_kev —— objc_msgSend：+[NSEvent keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:]（测试投递用）。
// ============================================================================

import { NSPOINT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, ty: usize, loc: NSPOINT, flags: usize, ts: float, wnum: int, ctx: usize, chars: usize, plain: usize, repeat: u8, code: u16): usize from "/usr/lib/libobjc.A.dylib";

export function msgKeyEvent(nsevent: usize, ty: int, flags: int, wnum: int, chars: usize, plain: usize, code: int): usize {
    return objc_msgSend(nsevent, sel_registerName("keyEventWithType:location:modifierFlags:timestamp:windowNumber:context:characters:charactersIgnoringModifiers:isARepeat:keyCode:"), ty as usize, NSPOINT { x: 0.0, y: 0.0 }, flags as usize, 0.0, wnum, 0, chars, plain, 0, code as u16);
}
