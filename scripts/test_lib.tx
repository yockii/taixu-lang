// 太虚写的门步共用的部分（用户裁决 2026-10-25：新增门步用太虚写，现有 Python 测试脚本逐步迁移）：逐项检查的计数与输出、
// 分开取 stdout 与 stderr 且限时的子进程运行。输出格式同 Python 门步（PASS／FAIL 逐项，末行 SUMMARY），gate.tx 只看退出码。
import { byteSub } from "./build_lib";

export struct Tally {
    pass: int,
    fail: int,
}

export function tallyNew(): Ref<Tally> {
    return new Tally { pass: 0, fail: 0 };
}

export function check(t: Ref<Tally>, name: string, ok: bool, detail: string): bool {
    if (ok) {
        t.pass = t.pass + 1;
        print("PASS " + name);
    } else {
        t.fail = t.fail + 1;
        print("FAIL " + name + "：" + detail);
    }
    return ok;
}

// 末行 SUMMARY；返回门步的退出码（有失败项为 1）。
export function summary(t: Ref<Tally>, step: string): int {
    if (t.fail == 0) {
        print("SUMMARY PASS " + step + ": " + toStr(t.pass) + " checks, 0 failed");
        return 0;
    }
    print("SUMMARY FAIL " + step + ": " + toStr(t.pass + t.fail) + " checks, " + toStr(t.fail) + " failed");
    return 1;
}

// 一次子进程运行的结果：退出码（超时为 −1）、stdout、stderr（各自完整；不是合法 UTF-8 时为空串并置 binary）。
export struct Outcome {
    code: int,
    out: string,
    err: string,
    timedOut: bool,
    binary: bool,
}

// 在 cwd 里运行 exe，同时排空 stdout 与 stderr，至多 limitNs 纳秒（超时即结束子进程）；每个流至多留 maxBytes 字节的末尾。
export function capture(exe: string, args: List<string>, cwd: string, limitNs: int, maxBytes: int): Ref<Outcome> | Error {
    const h = procSpawn(exe, args, cwd, 0) catch (e) {
        return err("起不了 " + exe + "：" + e.message);
    };
    let out = bytesNew(0);
    let errs = bytesNew(0);
    const buf = bytesNew(65536);
    const deadline = monoNs() + limitNs;
    let code: int = 0;
    let timedOut: bool = false;
    let outOpen: bool = true;
    let errOpen: bool = true;
    let ended: bool = false;
    while (true) {
        if (!ended) {
            const w = procWait(h, 0);
            if (w != None) {
                code = w ?? -1;
                ended = true;
            }
        }
        if (!ended && !timedOut && monoNs() >= deadline) {
            timedOut = true;
            procKill(h);
        }
        if (ended && !outOpen && !errOpen) {
            break;
        }
        let mask: int = 0;
        if (outOpen) {
            mask = mask | 2;
        }
        if (errOpen) {
            mask = mask | 4;
        }
        if (mask == 0) {
            const waited = procWait(h, 100);
            continue;
        }
        const ready = ioWait(h, mask, 100);
        if ((ready & 2) != 0) {
            const n = procRead(h, 1, buf);
            if (n < 0) {
                outOpen = false;
            } else if (n > 0) {
                out = keepTail(out, bytesSlice(buf, 0, n), maxBytes);
            }
        }
        if ((ready & 4) != 0) {
            const n = procRead(h, 2, buf);
            if (n < 0) {
                errOpen = false;
            } else if (n > 0) {
                errs = keepTail(errs, bytesSlice(buf, 0, n), maxBytes);
            }
        }
    }
    procClose(h);
    const r = new Outcome { code: code, out: "", err: "", timedOut: timedOut, binary: false };
    if (timedOut) {
        r.code = -1;
    }
    r.out = bytesToStr(out) catch (e) {
        r.binary = true;
        return r;
    };
    r.err = bytesToStr(errs) catch (e) {
        r.binary = true;
        return r;
    };
    return r;
}

function keepTail(t: Bytes, chunk: Bytes, maxBytes: int): Bytes {
    bytesAppend(t, chunk);
    if (bytesLen(t) > maxBytes) {
        return bytesSlice(t, bytesLen(t) - maxBytes, maxBytes);
    }
    return t;
}

// 按行切开（去掉行尾的 \r；末尾的空行不算）。
export function linesOf(s: string): List<string> {
    const out: List<string> = listNew();
    for (line in strSplit(s, "\n")) {
        if (len(line) > 0 && (byteAt(line, len(line) - 1) catch 0) == 13) {
            // len 是字节数，strSub 按码点计：去掉 \r 须按字节切（含非 ASCII 的行用 strSub 会越界 trap）。
            listPush(out, byteSub(line, 0, len(line) - 1));
        } else {
            listPush(out, line);
        }
    }
    if (listLen(out) > 0 && len(listGet(out, listLen(out) - 1) catch "") == 0) {
        const last = listPop(out);
    }
    return out;
}
