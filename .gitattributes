# 统一仓库与工作区行尾为 LF（检出字节稳定：源码、夹具与期望输出逐字节比较）。
* text=auto eol=lf

# 太虚源码的 GitHub 语言标记。
*.tx linguist-language=太虚 linguist-detectable

# 显式二进制（行尾永不触碰）
*.bmp -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.exe -text
*.obj -text
*.o -text
*.dll -text
*.so -text
*.zip -text
*.tar -text
*.gz -text
*.txc -text
*.wasm -text
*.dat -text

# 用例的嵌入二进制数据与序列化夹具保持原字节。
tests/nrt-cases/data/*.bin binary
tests/perf/behavior.sein whitespace=-blank-at-eol

# GitHub 语言统计排除门、测试、基准与文档；仍保留文件及正常 diff。
/scripts/** -linguist-detectable
/tests/** -linguist-detectable
/bench/** -linguist-detectable
/spike/** -linguist-detectable
/docs/** -linguist-detectable
/stdlib/tests/** -linguist-detectable
/stdlib/verify -linguist-detectable
/stdlib/verify.py -linguist-detectable
