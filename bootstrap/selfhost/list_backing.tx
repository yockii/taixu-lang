// Stable List descriptor ABI v1; no Zig union layout or host growth algorithm.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
import { listCompactJump } from "./list_compact";
import { tSysV } from "./target";
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function d(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function m(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
function md(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { op(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
function call(b: Ref<StructuredBuffer>, name: string): void { jump(b, "call", name); }
export function listBackingEmit(b: Ref<StructuredBuffer>, t: int): void {
    let copy = "memcpy"; if (tSysV(t)) { copy = "__tx_linux_memcpy"; }
    // Conversion shares the append engine with a temporary None, then drops it.
    // 紧凑列表（form 3）不转为通用形态。
    lab(b, "__tx_native_list_generic_v1"); two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_lb_generic_bad");
    two(b, "cmp", md(1, 24), i(3)); jump(b, "je", "__tx_lb_generic_bad");
    two(b, "cmp", md(1, 24), i(1)); jump(b, "je", "__tx_lb_generic_ok");
    two(b, "sub", r(4), i(72)); mov(b, m(4, 32), r(1)); mov(b, m(4, 40), i(4)); mov(b, m(4, 48), i(0));
    two(b, "lea", r(2), m(4, 40)); mov(b, d(8), i(0)); call(b, "__tx_native_list_append_v1");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_lb_generic_done");
    mov(b, r(1), m(4, 32)); mov(b, r(0), m(1, 8)); two(b, "sub", r(0), i(1)); mov(b, m(1, 8), r(0)); mov(b, r(0), i(1));
    lab(b, "__tx_lb_generic_done"); two(b, "add", r(4), i(72)); op(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    lab(b, "__tx_lb_generic_ok"); mov(b, r(0), i(1)); op(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    lab(b, "__tx_lb_generic_bad"); mov(b, r(0), i(0)); op(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    lab(b, "__tx_native_list_destroy_v1"); two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_lb_destroy_null");
    two(b, "sub", r(4), i(40)); mov(b, m(4, 32), r(1)); two(b, "cmp", m(1, 16), i(0)); jump(b, "je", "__tx_lb_destroy_clear");
    mov(b, r(1), m(1, 0)); call(b, "__tx_native_mem_free");
    lab(b, "__tx_lb_destroy_clear"); mov(b, r(1), m(4, 32)); mov(b, r(0), i(0));
    mov(b, m(1, 0), r(0)); mov(b, m(1, 8), r(0)); mov(b, m(1, 16), r(0)); mov(b, m(1, 24), r(0)); mov(b, md(1, 24), i(1));
    two(b, "add", r(4), i(40));
    lab(b, "__tx_lb_destroy_null"); op(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    lab(b, "__tx_native_list_append_v1"); listCompactJump(b, "__tx_lb_full", "__tx_native_list_cappend_v1"); two(b, "sub", r(4), i(104)); mov(b, m(4, 32), r(1));
    two(b, "test", r(1), r(1)); jump(b, "jz", "__tx_lb_fail");
    two(b, "test", r(2), r(2)); jump(b, "jz", "__tx_lb_fail");
    mov(b, r(0), m(2, 0)); mov(b, m(4, 40), r(0)); mov(b, r(9), m(2, 8)); mov(b, m(4, 48), r(9));
    two(b, "movabs", r(11), i(1152921504606846975)); mov(b, r(10), m(1, 8));
    two(b, "cmp", r(10), r(11)); jump(b, "jae", "__tx_lb_fail");
    two(b, "cmp", r(10), m(1, 16)); jump(b, "ja", "__tx_lb_fail");
    mov(b, r(9), m(1, 16)); two(b, "cmp", r(9), r(11)); jump(b, "ja", "__tx_lb_fail");
    two(b, "cmp", m(1, 16), i(0)); jump(b, "je", "__tx_lb_form");
    two(b, "cmp", m(1, 0), i(0)); jump(b, "je", "__tx_lb_fail");
    lab(b, "__tx_lb_form"); mov(b, d(10), md(1, 24)); mov(b, m(4, 72), r(10));
    two(b, "cmp", d(10), i(1)); jump(b, "je", "__tx_lb_choose");
    two(b, "cmp", d(10), i(2)); jump(b, "jne", "__tx_lb_fail");
    mov(b, d(9), md(1, 28)); two(b, "cmp", d(9), i(1)); jump(b, "jb", "__tx_lb_fail");
    two(b, "cmp", d(9), i(3)); jump(b, "ja", "__tx_lb_fail");
    lab(b, "__tx_lb_choose"); two(b, "and", d(0), i(255));
    two(b, "test", d(8), d(8)); jump(b, "jz", "__tx_lb_generic");
    two(b, "cmp", d(0), i(1)); jump(b, "jb", "__tx_lb_generic");
    two(b, "cmp", d(0), i(3)); jump(b, "ja", "__tx_lb_generic");
    two(b, "cmp", d(10), i(2)); jump(b, "jne", "__tx_lb_empty");
    two(b, "cmp", d(0), md(1, 28)); jump(b, "jne", "__tx_lb_generic");
    mov(b, m(4, 96), i(2)); jump(b, "jmp", "__tx_lb_raw");
    lab(b, "__tx_lb_empty"); two(b, "cmp", m(1, 8), i(0)); jump(b, "jne", "__tx_lb_generic");
    mov(b, m(4, 96), i(3));
    lab(b, "__tx_lb_raw"); mov(b, m(4, 56), i(2)); mov(b, m(4, 64), r(0));
    two(b, "cmp", d(0), i(3)); jump(b, "jne", "__tx_lb_capacity");
    mov(b, r(9), i(0)); two(b, "cmp", m(4, 48), i(0)); jump(b, "je", "__tx_lb_bool"); mov(b, r(9), i(1));
    lab(b, "__tx_lb_bool"); mov(b, m(4, 48), r(9)); jump(b, "jmp", "__tx_lb_capacity");
    lab(b, "__tx_lb_generic"); mov(b, m(4, 56), i(1)); mov(b, m(4, 64), i(0)); mov(b, m(4, 96), i(1));
    lab(b, "__tx_lb_capacity"); mov(b, r(0), m(4, 56)); two(b, "cmp", r(0), m(4, 72)); jump(b, "jne", "__tx_lb_allocate");
    mov(b, r(0), m(1, 8)); two(b, "cmp", r(0), m(1, 16)); jump(b, "jae", "__tx_lb_allocate");
    mov(b, r(0), m(1, 0)); mov(b, m(4, 88), r(0)); mov(b, r(0), m(1, 16)); mov(b, m(4, 80), r(0)); jump(b, "jmp", "__tx_lb_append");
    lab(b, "__tx_lb_allocate"); mov(b, r(0), m(1, 16)); mov(b, r(10), m(1, 8)); two(b, "add", r(10), i(1));
    two(b, "cmp", r(0), r(10)); jump(b, "jae", "__tx_lb_min"); two(b, "shl", r(0), i(1));
    two(b, "cmp", r(0), r(11)); jump(b, "jbe", "__tx_lb_min"); mov(b, r(0), r(11));
    lab(b, "__tx_lb_min"); two(b, "cmp", r(0), i(8)); jump(b, "jae", "__tx_lb_alloc"); mov(b, r(0), i(8));
    lab(b, "__tx_lb_alloc"); mov(b, m(4, 80), r(0)); mov(b, r(1), r(0)); two(b, "shl", r(1), i(3));
    two(b, "cmp", m(4, 56), i(2)); jump(b, "je", "__tx_lb_alloc_call"); two(b, "shl", r(1), i(1));
    lab(b, "__tx_lb_alloc_call"); mov(b, r(2), i(8)); call(b, "__tx_native_mem_alloc");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_lb_fail"); mov(b, m(4, 88), r(0));
    mov(b, r(11), m(4, 32)); mov(b, r(8), m(11, 8)); two(b, "test", r(8), r(8)); jump(b, "jz", "__tx_lb_append");
    mov(b, r(9), m(4, 56)); two(b, "cmp", r(9), m(4, 72)); jump(b, "jne", "__tx_lb_convert");
    two(b, "shl", r(8), i(3)); two(b, "cmp", r(9), i(2)); jump(b, "je", "__tx_lb_copy"); two(b, "shl", r(8), i(1));
    lab(b, "__tx_lb_copy"); mov(b, r(1), m(4, 88)); mov(b, r(2), m(11, 0)); call(b, copy); jump(b, "jmp", "__tx_lb_append");
    lab(b, "__tx_lb_convert"); mov(b, r(2), m(11, 0)); mov(b, d(9), md(11, 28)); mov(b, r(10), m(4, 88));
    lab(b, "__tx_lb_convert_loop"); mov(b, r(0), m(2, 0));
    two(b, "cmp", d(9), i(3)); jump(b, "jne", "__tx_lb_convert_store");
    two(b, "test", r(0), r(0)); jump(b, "jz", "__tx_lb_convert_store"); mov(b, r(0), i(1));
    lab(b, "__tx_lb_convert_store"); mov(b, m(10, 0), r(9)); mov(b, m(10, 8), r(0));
    two(b, "add", r(10), i(16)); two(b, "add", r(2), i(8)); two(b, "sub", r(8), i(1)); jump(b, "jne", "__tx_lb_convert_loop");
    lab(b, "__tx_lb_append"); mov(b, r(11), m(4, 32)); mov(b, r(10), m(11, 8)); two(b, "shl", r(10), i(3));
    two(b, "cmp", m(4, 56), i(2)); jump(b, "je", "__tx_lb_append_raw");
    two(b, "shl", r(10), i(1)); two(b, "add", r(10), m(4, 88)); mov(b, r(0), m(4, 40)); mov(b, m(10, 0), r(0)); two(b, "add", r(10), i(8)); jump(b, "jmp", "__tx_lb_append_bits");
    lab(b, "__tx_lb_append_raw"); two(b, "add", r(10), m(4, 88));
    lab(b, "__tx_lb_append_bits"); mov(b, r(0), m(4, 48)); mov(b, m(10, 0), r(0));
    mov(b, r(0), m(4, 88)); two(b, "cmp", r(0), m(11, 0)); jump(b, "je", "__tx_lb_commit");
    two(b, "cmp", m(11, 16), i(0)); jump(b, "je", "__tx_lb_commit"); mov(b, r(1), m(11, 0)); call(b, "__tx_native_mem_free");
    lab(b, "__tx_lb_commit"); mov(b, r(11), m(4, 32)); mov(b, r(0), m(4, 88)); mov(b, m(11, 0), r(0));
    mov(b, r(0), m(4, 80)); mov(b, m(11, 16), r(0)); mov(b, r(0), m(11, 8)); two(b, "add", r(0), i(1)); mov(b, m(11, 8), r(0));
    mov(b, r(0), m(4, 56)); mov(b, md(11, 24), d(0)); mov(b, r(0), m(4, 64)); mov(b, md(11, 28), d(0)); mov(b, r(0), m(4, 96)); jump(b, "jmp", "__tx_lb_done");
    lab(b, "__tx_lb_fail"); mov(b, r(0), i(0));
    lab(b, "__tx_lb_done"); two(b, "add", r(4), i(104)); op(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
}
