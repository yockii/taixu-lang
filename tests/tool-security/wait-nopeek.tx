// procWait 在 waitid 不可用时（沙箱的 ENOSYS）退回 wait4，回收主进程后按组补杀（Linux）。
// procSpawnLimited 起 sh：sh 在同一进程组留下后台 sleep，把它的 PID 写进 args[0] 指定的文件后退出。
// 打印 procWait 的结果；组内 sleep 是否已被清理由门核对（tool_security_checks.py 用 seccomp 屏蔽 waitid 运行）。
export function main(args: []string): int {
    const argv: List< string> = listNew();
    listPush(argv, "-c");
    listPush(argv, "sleep 300 & echo $! > " + args[0]);
    const h = procSpawnLimited("/bin/sh", argv, "", 0, 268435456, 30) catch (e) { eprint(e.message); return 2; };
    // 等满 10 s 仍未退出得 None，记为 9999（不是任何退出码）。
    const code = procWait(h, 10000) catch 9999;
    print("wait " + toStr(code));
    procClose(h);
    return 0;
}
