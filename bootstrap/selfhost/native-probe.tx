// native-probe.tx —— 原生链 .s 落盘探针（S5-③/P8 调试面）。
import { decodeToDump } from "./bytecode";
import { recordDump, recordMsgCount } from "./emit_record";
import { emitRecords, emSOut, emReady } from "../emitmirror";
function main(args: []string): int {
    const txc: string = readFile(args[0]) catch "";
    const dump: string = decodeToDump(txc);
    const recs: string = recordDump(dump);
    if (emitRecords(recs) != 0 || emReady() != 1) { eprint("emit fail"); return 1; }
    writeFile(args[1], emSOut()) catch (e) { eprint("write fail"); return 2; };
    print("s len=" + toStr(len(emSOut())) + " msgs=" + toStr(recordMsgCount()));
    return 0;
}
