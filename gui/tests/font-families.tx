// font-families —— 混合字体解析**回放红线**用例。
// 回放/帧定格态 fontFromFamilies 恒回落嵌入字体（宿主单点强制——.tx 零分
// 支）：嵌入字体与 fontFamily 列表两画布同文同位渲染，sha256 必须恒等
//（eq=1——跨机恒定）。真窗显示路径不受本用例约束（系统字体按 fontFamily
// 生效——人看屏面，语义判据）。纯无头面（present 仅产 FRAME 伴行）。
import { Canvas, paintText } from "gui/components";
import { fontEmbedded, fontFromFamilies, fontFree, textCanvas } from "gui/text";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256, eventWindowOpen, windowPresent } from "gui/surface";

export function main(args: []string): int {
    args;
    const fams: List<string> = listNew();
    listPush(fams, "Microsoft YaHei");
    listPush(fams, "Noto Sans CJK SC");
    listPush(fams, "PingFang SC");
    const fa = fontEmbedded() catch (e) {
        print("font fail: " + e.message);
        return 1;
    };
    const fb = fontFromFamilies(fams) catch (e) {
        print("font fail: " + e.message);
        return 1;
    };
    const sa = surfaceOpen(240, 80) catch (e) {
        print("surface fail: " + e.message);
        return 1;
    };
    const sb = surfaceOpen(240, 80) catch (e) {
        print("surface fail: " + e.message);
        return 1;
    };
    surfaceClear(sa, 0x202040);
    surfaceClear(sb, 0x202040);
    const ca = textCanvas(sa, 240, 80, fa.handle, 14);
    const cb = textCanvas(sb, 240, 80, fb.handle, 14);
    paintText(ca, 8, 10, 0xFFFFFF, "太虚字体红线 Taixu");
    paintText(cb, 8, 10, 0xFFFFFF, "太虚字体红线 Taixu");
    const ha: string = surfaceSha256(sa);
    const hb: string = surfaceSha256(sb);
    let eq: int = 0;
    if (ha == hb) {
        eq = 1;
    }
    print("eq=" + toStr(eq));
    // present（脚本化窗口＝无头通道帧界面——本调用仅产 FRAME 定格伴行）。
    const hwnd: int = eventWindowOpen("font-families", 240, 80);
    const rc: int = windowPresent(hwnd, sa);
    print("present_rc=" + toStr(rc));
    surfaceClose(sa);
    surfaceClose(sb);
    fontFree(fa);
    fontFree(fb);
    return 0;
}
