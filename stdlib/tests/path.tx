// ============================================================================
// stdlib 用例：std/path（V0.9-S1；D27 §一）——纯函数面全断言。
// 运行：taixu test tests/path.tx
// ============================================================================

import { pathJoin, pathBase, pathDir, pathExt, pathNormalize } from "std/path";

test "path：join 分隔符三态（双斜杠/单斜杠/补斜杠）" {
    assert(pathJoin("a", "b") == "a/b", "两侧无斜杠→补");
    assert(pathJoin("a/", "b") == "a/b", "左有→不重复");
    assert(pathJoin("a", "/b") == "a/b", "右有→不重复");
    assert(pathJoin("a//", "/b") == "a/b", "双斜杠→归一");
    assert(pathJoin("", "b") == "b", "空 base→rel");
    assert(pathJoin("a", "") == "a", "空 rel→base");
}

test "path：base/dir/ext 三段" {
    assert(pathBase("a/b/c.tx") == "c.tx", "base 取末段");
    assert(pathBase("c.tx") == "c.tx", "无斜杠→整串");
    assert(pathBase("a/b/") == "", "尾斜杠→空 base");
    assert(pathDir("a/b/c.tx") == "a/b/", "dir 含尾斜杠");
    assert(pathDir("c.tx") == "", "无斜杠→空 dir");
    assert(pathExt("a/b.c.tx") == ".tx", "ext 取最后一个点");
    assert(pathExt("a/b") == "", "无点→空");
    assert(pathExt("a/.hide") == "", "首字符点（隐藏文件）→空");
}

test "path：normalize 消解与 .. 弹栈" {
    assert(pathNormalize("a//b/./c") == "a/b/c", "并斜杠＋点段");
    assert(pathNormalize("a/b/../c") == "a/c", ".. 弹上一段");
    assert(pathNormalize("../a") == "../a", "相对开头 .. 保留");
    assert(pathNormalize("a/..") == "", "全弹空");
}
