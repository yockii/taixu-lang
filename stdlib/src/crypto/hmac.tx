// HMAC-SHA-256，RFC 2104／4231。输入与结果均为原始 Bytes，不修改调用方缓冲。
import { sha256Sum } from "../hash";

export function hmacSha256(key: Bytes, data: Bytes): Bytes {
    let material = key;
    if (bytesLen(material) > 64) { material = sha256Sum(material); }
    const inner = bytesNew(64);
    const outer = bytesNew(64);
    let i = 0;
    while (i < 64) {
        let b = 0;
        if (i < bytesLen(material)) { b = bytesGet(material, i) catch panic("hmac: internal byte bounds"); }
        bytesSet(inner, i, b ^ 54);
        bytesSet(outer, i, b ^ 92);
        i = i + 1;
    }
    bytesAppend(inner, data);
    bytesAppend(outer, sha256Sum(inner));
    return sha256Sum(outer);
}
