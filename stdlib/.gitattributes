# 统一仓库与工作区行尾为 LF（检出字节稳定性——V0.42 BUILD-10）
* text=auto eol=lf

# 太虚源码的 GitHub 语言标记。
*.tx linguist-language=太虚 linguist-detectable

# 显式二进制面（行尾永不触碰）
*.bmp -text
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.ico -text
*.ttf -text
*.otf -text
*.woff -text
*.woff2 -text
*.exe -text
*.obj -text
*.o -text
*.dll -text
*.so -text
*.vsix -text
*.zip -text
*.txc -text
*.wasm -text
*.dat -text

# 测试数据与验证驱动不计入 GitHub 语言统计。
/tests/** -linguist-detectable
/verify -linguist-detectable
/verify.py -linguist-detectable
