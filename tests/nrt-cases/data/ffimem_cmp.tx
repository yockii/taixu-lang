// ffi-mem-callback 的比较函数：C（qsort）在回调里交来两个元素的地址，各按外部结构体 I32 建区读出——同 WndProc 里经 lParam 读
// MINMAXINFO 的写法。回调返回即弹出本帧的区，比较次数远超 64 也不会占满区栈。
// 外部内存区只许在声明了 from 外部函数的模块里创建；只声明不调用的外部函数充当平台层（见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

declare struct I32 { v: i32 }

let calls = 0;

export function compareCalls(): int {
    return calls;
}

function at(addr: usize): int {
    const m = ffiMemOf<I32>(addr as int, false) catch (e) { return 0; };
    return ffiMemGet<I32>(m, 0).v as int;
}

export function byValue(a: usize, b: usize): i32 {
    calls = calls + 1;
    const x = at(a);
    const y = at(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}
