// ============================================================================
// stdlib 用例：std/random（V0.9-S1；D27 §一）——同种子同序列红线（可断言面）。
// 运行：taixu test tests/random.tx
// ============================================================================

import { randomNew, randomNext, randomRange, randomFloat } from "std/random";

test "random：同种子同序列（确定性红线）" {
    const a = randomNew(42);
    const b = randomNew(42);
    let i: int = 0;
    while (i < 16) {
        assert(randomNext(a) == randomNext(b), "同种子第 " + toStr(i) + " 步序列恒等");
        i = i + 1;
    }
}

test "random：不同种子序列不同；值域 0..2^63-1（splitmix64/V0.39-G0）" {
    const a = randomNew(1);
    const b = randomNew(2);
    let diff: bool = false;
    let i: int = 0;
    while (i < 8) {
        const va = randomNext(a);
        const vb = randomNext(b);
        if (va != vb) { diff = true; }
        assert(va >= 0 && va <= 9223372036854775807, "63 位非负值域");
        i = i + 1;
    }
    assert(diff, "种子 1/2 前 8 步应出现差异");
}

test "random：splitmix64 新序列锚（V0.39-G0 重立——序列变更＝行为变更登记）" {
    const r = randomNew(42);
    const v0 = randomNext(r);
    const v1 = randomNext(r);
    const v2 = randomNext(r);
    assert(v0 == 6839728766377637706, "种子 42 第 0 步锚");
    assert(v1 == 1474913046063446145, "种子 42 第 1 步锚");
    assert(v2 == 2569641874231381929, "种子 42 第 2 步锚");
}

test "random：range 边界与 float 值域；种子归一" {
    const r = randomNew(7);
    let i: int = 0;
    while (i < 32) {
        const v = randomRange(r, 10, 13);
        assert(v >= 10 && v < 13, "半开区间 [10,13)");
        const f = randomFloat(r);
        assert(f >= 0.0 && f < 1.0, "float [0,1)");
        i = i + 1;
    }
    assert(randomRange(r, 5, 5) == 5, "空区间→lo");
    const z = randomNew(0);
    const z2 = randomNew(0);
    assert(randomNext(z) == randomNext(z2), "非法种子归一同轨");
}
