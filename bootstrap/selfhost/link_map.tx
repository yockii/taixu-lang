// Both renderers consume the same owned link facts, bound to the complete image.
import { BinaryName, rawNameText, rawNameHex, rawNameEqualText, rawNameTextHash } from "./binary_name";
import { LinkMapData, LinkMapSymbol, linkMapData } from "./link_map_data";
import { jsonQuote } from "./json_text";
import { jsonStart, TOOLCHAIN_VERSION } from "./toolchain";
import { sha256Hex } from "./sha256";
import { mapHex, mapJoin } from "./link_map_format";
import { mapFunctionCoverage, mapFunctionsJson, mapFunctionsText } from "./link_map_function_render";

export function linkMapFinish(image: Bytes): Ref<LinkMapData> {
    const d = linkMapData(); if (d.ok) { d.imageBytes = bytesLen(image); d.sha256 = sha256Hex(image); } return d;
}
export function linkMapHex(v: int): string { return mapHex(v); }
function number(v: int): string { return jsonQuote(toStr(v)); }
function optional(v: int): string { if (v < 0) { return "null"; } return number(v); }
function index(v: int): string { if (v < 0) { return "null"; } return toStr(v); }
function utf8(n: Ref<BinaryName>): string {
    if (!n.ok) { return "null"; } const text = rawNameText(n);
    if (!rawNameEqualText(n, text, rawNameTextHash(text))) { return "null"; } return jsonQuote(text);
}
function raw(n: Ref<BinaryName>): string { if (!n.ok) { return "null"; } return jsonQuote(rawNameHex(n)); }
function symbolJson(r: Ref<LinkMapSymbol>, base: int): string {
    let value = "null"; let rva = "null"; let size = "null";
    if (r.hasDeclaredSize) {
        const half: u64 = (r.declaredSize >>> 1) as u64;
        const low: u64 = (r.declaredSize & 1) as u64;
        size = jsonQuote(toStr(half + half + low));
    }
    if (r.valueKind != "undefined") { value = jsonQuote(linkMapHex(r.value)); }
    if (r.valueKind == "link-va") { rva = jsonQuote(linkMapHex(r.value - base)); }
    return "{\"id\":" + toStr(r.id) + ",\"name_utf8\":" + utf8(r.name) + ",\"name_bytes\":" + raw(r.name)
    + ",\"origin\":" + jsonQuote(r.origin) + ",\"object_index\":" + index(r.objectIndex) + ",\"symbol_index\":" + index(r.symbolIndex)
    + ",\"input_section_index\":" + index(r.sectionIndex) + ",\"input_section_utf8\":" + utf8(r.sectionName) + ",\"input_section_bytes\":" + raw(r.sectionName)
    + ",\"input_section_offset\":" + optional(r.sectionOffset) + ",\"output_section\":" + index(r.outputSection)
    + ",\"binding\":" + jsonQuote(r.binding) + ",\"symbol_type\":" + jsonQuote(r.symbolType) + ",\"state\":" + jsonQuote(r.state)
    + ",\"value_kind\":" + jsonQuote(r.valueKind) + ",\"value\":" + value + ",\"image_relative_va\":" + rva + ",\"declared_size\":" + size + "}";
}
export function linkMapJson(d: Ref<LinkMapData>): string {
    const parts: List<string> = listNew();
    listPush(parts, jsonStart("link-map/6") + ",\"toolchain_version\":" + jsonQuote(TOOLCHAIN_VERSION) + ",\"ok\":" + toStr(d.ok));
    if (!d.ok) { listPush(parts, ",\"error\":" + jsonQuote(d.error) + ",\"map\":null}"); }
    else {
        let symbols = "null"; let symbolCoverage = "omitted-by-scope";
        if (d.scope == "all") { symbols = number(listLen(d.symbols)); symbolCoverage = "complete"; }
        listPush(parts, ",\"error\":null,\"map\":{\"target\":" + jsonQuote(d.target) + ",\"scope\":" + jsonQuote(d.scope)
            + ",\"numeric_encoding\":\"decimal-string/u64;hex-string/u64;sp_delta=decimal-string/i64\""
            + ",\"image\":{\"bytes\":" + number(d.imageBytes) + ",\"sha256\":" + jsonQuote(d.sha256) + ",\"preferred_base\":" + jsonQuote(linkMapHex(d.imageBase)) + ",\"entry\":" + jsonQuote(linkMapHex(d.entry)) + ",\"runtime_load_bias\":null}"
            + ",\"coverage\":{" + mapFunctionCoverage(d) + ",\"symbols\":" + jsonQuote(symbolCoverage)
            + ",\"unwind\":null,\"cpu_profile\":null,\"order\":\"program-then-input-producer-order\",\"truncated\":false,\"layout\":" + jsonQuote(layout(d.target)) + "},\"sections\":[");
        let first = true;
        for (s in d.sections) {
            if (!first) { listPush(parts, ","); } first = false;
            listPush(parts, "{\"index\":" + toStr(s.index) + ",\"name_utf8\":" + utf8(s.name) + ",\"name_bytes\":" + raw(s.name) + ",\"link_va\":" + jsonQuote(linkMapHex(s.va))
                + ",\"file_offset\":" + optional(s.fileOffset) + ",\"file_bytes\":" + number(s.fileBytes) + ",\"memory_bytes\":" + number(s.memoryBytes) + "}");
        }
        listPush(parts, "]" + mapFunctionsJson(d) + ",\"symbols_total\":" + symbols + ",\"symbols\":["); first = true;
        for (r in d.symbols) { if (!first) { listPush(parts, ","); } first = false; listPush(parts, symbolJson(r, d.imageBase)); }
        listPush(parts, "]}}");
    }
    return mapJoin(parts, 0, listLen(parts));
}
function layout(target: string): string {
    if (target == "x86_64-linux") { return "elf-load-groups-with-separate-bss-tail"; }
    if (target == "x86_64-macos" || target == "aarch64-macos") { return "macho-producer-sections"; } return "pe-sections";
}
function layoutNote(target: string): string {
    const kind = layout(target);
    if (kind == "pe-sections") { return "PE 为实际节头"; }
    if (kind == "macho-producer-sections") { return "Mach-O 为四个生产节，与 __text／__const／__data／__bss 一一对应，BSS 不占文件"; }
    return "ELF 为生产载荷组，BSS 单列虚拟尾，不声称存在节头表";
}
export function linkMapText(d: Ref<LinkMapData>): string {
    if (!d.ok) { return "链接映射未完成：" + d.error + "\n"; }
    const parts: List<string> = listNew();
    listPush(parts, "太虚链接映射 link-map/6  " + d.target + "  视图 " + d.scope + "\n产物 " + toStr(d.imageBytes) + " bytes  SHA-256 " + d.sha256
        + "\n首选基址 " + linkMapHex(d.imageBase) + "  入口 " + linkMapHex(d.entry) + "\n数值为链接值，实际加载偏移未测；系统栈展开与 CPU 归因尚未提供。\n输出节（VA / 文件偏移 / 文件字节 / 内存字节）：\n");
    listPush(parts, "布局 " + layout(d.target) + "（" + layoutNote(d.target) + "）\n");
    for (s in d.sections) { listPush(parts, toStr(s.index) + "  " + jsonQuote(rawNameText(s.name)) + "  " + linkMapHex(s.va) + "  " + optional(s.fileOffset) + "  " + toStr(s.fileBytes) + "  " + toStr(s.memoryBytes) + "\n"); }
    listPush(parts, mapFunctionsText(d));
    if (d.scope != "all") { listPush(parts, "原始符号已按视图省略，总数未收集；使用 --map-scope=all 获取。\n"); return mapJoin(parts, 0, listLen(parts)); }
    listPush(parts, "全部符号 " + toStr(listLen(d.symbols)) + "（生成/输入顺序，未截断；偏移单位 bytes，绝对值与节偏移不当作 VA）\nID  数值种类  数值  状态  来源:对象:符号  输入节:偏移  名字\n");
    for (r in d.symbols) {
        let value = "-"; if (r.valueKind != "undefined") { value = linkMapHex(r.value); }
        listPush(parts, toStr(r.id) + "  " + r.valueKind + "  " + value + "  " + r.state + "  " + r.origin + ":" + index(r.objectIndex) + ":" + index(r.symbolIndex)
            + "  " + index(r.sectionIndex) + ":" + optional(r.sectionOffset) + "  " + jsonQuote(rawNameText(r.name)) + "\n");
    }
    return mapJoin(parts, 0, listLen(parts));
}
