// generic-same-name 的桩模块：泛型模板，被两个模块以各自的同名 struct/enum 实例化。
export struct Box < T > { v: T }
export struct Pair < A, B > { first: A, second: B }
export function unbox < T > (b: Box < T >): T { return b.v; }
export function firstOf < T > (xs: List< T>, d: T): T { return listGet(xs, 0) catch d; }
export function apply < T > (f: (T) => int, x: T): int { return f(x); }
