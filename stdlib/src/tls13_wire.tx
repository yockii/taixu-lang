// TLS 网络整数、向量与握手字段；所有位置都按 Bytes 字节计。
import { parseIp } from "./ip";

export struct Tls13Cursor { data: Bytes, offset: int }
export struct Tls13Extension { kind: int, data: Bytes }
export struct Tls13ServerHello { retry: bool, group: int, key: Bytes, cookie: Bytes }

export function tls13Cursor(data: Bytes): Ref<Tls13Cursor> { return new Tls13Cursor { data: data, offset: 0 }; }
export function tls13Take(cursor: Ref<Tls13Cursor>, n: int): Bytes | Error {
    if (n < 0 || cursor.offset < 0 || cursor.offset > bytesLen(cursor.data) - n) { return err("tls13: truncated vector"); }
    const out = bytesSlice(cursor.data, cursor.offset, n); cursor.offset = cursor.offset + n; return out;
}
export function tls13Read(cursor: Ref<Tls13Cursor>, width: int): int | Error {
    if (width < 1 || width > 4) { return err("tls13: invalid integer width"); }
    const raw = tls13Take(cursor, width)?; let value = 0;
    for (b in bytesAsList(raw)) { value = value * 256 + (b as int); } return value;
}
export function tls13Vector(cursor: Ref<Tls13Cursor>, width: int): Bytes | Error { return tls13Take(cursor, tls13Read(cursor, width)?); }
export function tls13End(cursor: Ref<Tls13Cursor>): void | Error {
    if (cursor.offset != bytesLen(cursor.data)) { return err("tls13: trailing vector bytes"); } return done();
}
export function tls13Integer(value: int, width: int): Bytes {
    const out = bytesNew(width); let n = value; let i = width - 1;
    while (i >= 0) { bytesSet(out, i, n & 255); n = n >> 8; i = i - 1; } return out;
}
export function tls13Wrap(data: Bytes, width: int): Bytes {
    const out = tls13Integer(bytesLen(data), width); bytesAppend(out, data); return out;
}
export function tls13Message(kind: int, body: Bytes): Bytes {
    const out = tls13Integer(kind, 1); bytesAppend(out, tls13Wrap(body, 3)); return out;
}
export function tls13PlainRecord(kind: int, content: Bytes, version: int): Bytes {
    const out = tls13Integer(kind, 1); bytesAppend(out, tls13Integer(version, 2)); bytesAppend(out, tls13Wrap(content, 2)); return out;
}
export function tls13PlainRecords(kind: int, content: Bytes, version: int): List<Bytes> {
    const out: List<Bytes> = listNew(); let offset = 0;
    while (offset < bytesLen(content)) {
        let count = bytesLen(content) - offset; if (count > 16384) { count = 16384; }
        listPush(out, tls13PlainRecord(kind, bytesSlice(content, offset, count), version)); offset = offset + count;
    } return out;
}
export function tls13Extension(kind: int, body: Bytes): Bytes {
    const out = tls13Integer(kind, 2); bytesAppend(out, tls13Wrap(body, 2)); return out;
}

export function tls13Extensions(data: Bytes): List<Tls13Extension> | Error {
    const cursor = tls13Cursor(data); const out: List<Tls13Extension> = listNew(); const seen: Map<int, bool> = mapNew();
    while (cursor.offset < bytesLen(data)) {
        const kind = tls13Read(cursor, 2)?; const body = tls13Vector(cursor, 2)?;
        if (mapHas(seen, kind)) { return err("tls13: duplicate extension"); } mapSet(seen, kind, true);
        listPush(out, Tls13Extension { kind: kind, data: body });
    }
    return out;
}

export function tls13Hostname(hostname: string): string | Error {
    let host = hostname;
    if (len(host) > 0 && byteAt(host, len(host) - 1) == 46) { host = strSlice(host, 0, len(host) - 1); }
    if (bytesLen(parseIp(host) catch bytesNew(0)) > 0) { return host; }
    if (len(host) < 1 || len(host) > 253) { return err("tls13: invalid reference hostname"); }
    let numeric = true;
    for (label in strSplit(host, ".")) {
        if (len(label) < 1 || len(label) > 63 || byteAt(label, 0) == 45 || byteAt(label, len(label) - 1) == 45) { return err("tls13: invalid DNS label"); }
        for (b in label) {
            if (!((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 45)) { return err("tls13: hostname requires ASCII A-labels"); }
            if (b < 48 || b > 57) { numeric = false; }
        }
    }
    if (numeric) { return err("tls13: invalid numeric IP reference"); } return host;
}

export function tls13ClientHello(host: string, random: Bytes, session: Bytes, group: int, publicKey: Bytes, cookie: Bytes): Bytes | Error {
    if (bytesLen(random) != 32 || bytesLen(session) > 32 || (group != 29 && group != 23) || bytesLen(cookie) > 65500) { return err("tls13: invalid ClientHello inputs"); }
    if ((group == 29 && bytesLen(publicKey) != 32) || (group == 23 && bytesLen(publicKey) != 65)) { return err("tls13: invalid client key share"); }
    const hostname = tls13Hostname(host)?;
    const exts = bytesNew(0);
    if (bytesLen(parseIp(hostname) catch bytesNew(0)) == 0) {
        const name = tls13Integer(0, 1); bytesAppend(name, tls13Wrap(bytesFromStr(hostname), 2)); bytesAppend(exts, tls13Extension(0, tls13Wrap(name, 2)));
    }
    const groups = tls13Integer(29, 2); bytesAppend(groups, tls13Integer(23, 2)); bytesAppend(exts, tls13Extension(10, tls13Wrap(groups, 2)));
    const signatures = tls13Integer(2052, 2); bytesAppend(signatures, tls13Integer(1027, 2)); bytesAppend(exts, tls13Extension(13, tls13Wrap(signatures, 2)));
    const certSignatures = bytesSlice(signatures, 0, bytesLen(signatures)); bytesAppend(certSignatures, tls13Integer(1025, 2));
    bytesAppend(certSignatures, tls13Integer(1283, 2)); // ECDSA P-384/SHA-384 certificates; CertificateVerify list stays separate.
    bytesAppend(exts, tls13Extension(50, tls13Wrap(certSignatures, 2)));
    bytesAppend(exts, tls13Extension(16, tls13Wrap(tls13Wrap(bytesFromStr("http/1.1"), 1), 2)));
    bytesAppend(exts, tls13Extension(43, tls13Wrap(tls13Integer(772, 2), 1)));
    const share = tls13Integer(group, 2); bytesAppend(share, tls13Wrap(publicKey, 2)); bytesAppend(exts, tls13Extension(51, tls13Wrap(share, 2)));
    if (bytesLen(cookie) > 0) { bytesAppend(exts, tls13Extension(44, tls13Wrap(cookie, 2))); }
    if (bytesLen(exts) > 65535) { return err("tls13: ClientHello extensions exceed vector limit"); }
    const body = tls13Integer(771, 2); bytesAppend(body, random); bytesAppend(body, tls13Wrap(session, 1));
    bytesAppend(body, tls13Wrap(tls13Integer(4865, 2), 2)); bytesAppend(body, tls13Wrap(tls13Integer(0, 1), 1)); bytesAppend(body, tls13Wrap(exts, 2));
    return tls13Message(1, body);
}

export function tls13ParseServerHello(body: Bytes, session: Bytes, offeredGroup: int): Tls13ServerHello | Error {
    const cursor = tls13Cursor(body);
    if (tls13Read(cursor, 2)? != 771) { return err("tls13: invalid ServerHello legacy version"); }
    const random = tls13Take(cursor, 32)?;
    // RFC 8446 HRR random，按公开字节比较。
    const retry = bytesEqual(random, retryRandom());
    if (!bytesEqual(tls13Vector(cursor, 1)?, session) || tls13Read(cursor, 2)? != 4865 || tls13Read(cursor, 1)? != 0) { return err("tls13: ServerHello changed session, suite or compression"); }
    const extensions = tls13Extensions(tls13Vector(cursor, 2)?)?; tls13End(cursor)?;
    let version = false; let group = 0; let key = bytesNew(0); let cookie = bytesNew(0);
    for (extension in extensions) {
        const value = tls13Cursor(extension.data);
        if (extension.kind == 43) { if (tls13Read(value, 2)? != 772) { return err("tls13: server did not select TLS 1.3"); } version = true; }
        else if (extension.kind == 51) {
            group = tls13Read(value, 2)?;
            if (group != 29 && group != 23) { return err("tls13: unsupported server group"); }
            if (retry) { if (group == offeredGroup) { return err("tls13: retry requested an existing key share"); } }
            else {
                if (group != offeredGroup) { return err("tls13: server selected an unoffered key share"); } key = tls13Vector(value, 2)?;
                if ((group == 29 && bytesLen(key) != 32) || (group == 23 && bytesLen(key) != 65)) { return err("tls13: invalid server key share length"); }
            }
        } else if (extension.kind == 44 && retry) { cookie = tls13Vector(value, 2)?; if (bytesLen(cookie) < 1 || bytesLen(cookie) > 65500) { return err("tls13: invalid retry cookie"); } }
        else { return err("tls13: unexpected ServerHello extension"); }
        tls13End(value)?;
    }
    if (!version || (!retry && group == 0) || (retry && group == 0 && bytesLen(cookie) == 0)) { return err("tls13: missing ServerHello extension"); }
    return Tls13ServerHello { retry: retry, group: group, key: key, cookie: cookie };
}

function retryRandom(): Bytes {
    const out = bytesNew(0);
    for (b in [207, 33, 173, 116, 229, 154, 97, 17, 190, 29, 140, 2, 30, 101, 184, 145, 194, 162, 17, 22, 122, 187, 140, 94, 7, 158, 9, 226, 200, 168, 51, 156]) { listPush(bytesAsList(out), b as u8); } return out;
}

function done(): void {}
