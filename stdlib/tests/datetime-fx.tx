// ============================================================================
// stdlib 用例：datetime 格式化（V0.23-S1 扩批；STD-04——确定性纯函数面）
// 运行：taixu test tests/datetime-fx.tx
// ============================================================================

import { isLeap, daysInMonth, dateOf, timeOf, formatEpochMs, dayOfWeekEpoch } from "std/datetime";

test "闰年与月天数" {
    assert(isLeap(2000) && isLeap(2024), "世纪四百年闰");
    assert(!isLeap(1900) && !isLeap(2023), "平年");
    assert(daysInMonth(2024, 2) == 29 && daysInMonth(2023, 2) == 28, "二月");
    assert(daysInMonth(2024, 4) == 30 && daysInMonth(2024, 1) == 31, "大小月");
}

test "epoch → 日期时间（已知锚点）" {
    // 1970-01-01T00:00:00Z ＝ 0ms。
    assert(dateOf(0) == "1970-01-01", "epoch 原点");
    assert(timeOf(0) == "00:00:00", "零点");
    // 2000-02-29T12:34:56Z ＝ 951827696000ms（闰日锚点）。
    assert(formatEpochMs(951827696000) == "2000-02-29 12:34:56", "闰日锚");
    // 2026-09-16T00:00:00Z（当日零点）。
    assert(dateOf(1789516800000) == "2026-09-16", "近期锚");
    assert(formatEpochMs(-5) == "1970-01-01 00:00:00", "负毫秒钳 0");
}

test "星期位移" {
    // 1970-01-01 为周四（epoch 日 0 → 位移 0）。
    assert(dayOfWeekEpoch(0) == 0, "epoch 0＝周四");
    assert(dayOfWeekEpoch(86400000) == 1, "次日位移 1");
}
