// drivermirror.tx —— 驱动/build 编排决策镜像（BOOT-32 最小 spike；D95 §二）。
//
// 消费「argv 决策输入（ASCII）＋事实文件（verbatim 整读整写）」，按编排决策
// 规则独立产出 DRIVERDUMP v1 决策序列——与 dev-driver-dump（zig 侧真实编排
// 记录器）同负载逐字节对账：
//   - CLI 解析决策：kind／旗标（--bytecode/--frontend）／-o 输出；
//   - 管线调度决策：缺省前端＝.tx 镜像链（V0.42-B1-⑤b）、require_main、
//     阶段调度 load/sein/mirror/loader/codegen/serialize；
//   - 事实透传：facts 文件（entry/module 行——loadGraph 产物）整读整写，
//     零切片（S1 strSub 码点/len 字节混合语义——CJK 路径行禁切，D95 §三）。
//
// 输入：args[0]＝argv 文件（单行 ASCII：argv build --bytecode <entry> [-o <out>]
//       [--frontend={tx|zig}]）；args[1]＝facts 文件（dump 的 entry/module 行）；
//       args[2]＝输出路径。
//
// 用法：taixu run bootstrap/drivermirror.tx <argv 文件> <facts 文件> <输出>

struct Ctx {
    parts: List<string>,
    kind: string,
    frontend: string,
    outArg: string,
    entry: string,
    haveEntry: bool,
    outPath: string,
}

function begin(outPath: string): Ref<Ctx> {
    return new Ctx { parts: listNew(), kind: "", frontend: "", outArg: "", entry: "", haveEntry: false, outPath: outPath };
}

function emitLn(c: Ref<Ctx>, line: string): void {
    listPush(c.parts, line + "\n");
}

function joinRange(parts: List<string>, lo: int, hi: int): string {
    if (hi - lo <= 0) { return ""; }
    if (hi - lo == 1) { return listGet(parts, lo) catch ""; }
    const mid = lo + (hi - lo) / 2;
    return joinRange(parts, lo, mid) + joinRange(parts, mid, hi);
}

export function main(args: []string): int {
    if (len(args) < 3) {
        print("drivermirror: 用法 taixu run bootstrap/drivermirror.tx <argv 文件> <facts 文件> <输出>");
        return 64;
    }
    const argvText = readFile(args[0]) catch (e) {
        print("drivermirror: argv 读入失败: " + e.message);
        return 1;
    };
    const facts = readFile(args[1]) catch (e) {
        print("drivermirror: facts 读入失败: " + e.message);
        return 1;
    };
    const c = begin(args[2]);

    // —— CLI 解析（argv 文件＝单行 ASCII；strIndexOf 空格定位逐段切）——
    // 段切以 strIndexOf（码点）+ strSub（码点）一致语义；ASCII 面 len 同值。
    let rest: string = argvText;
    let sawArgv: bool = false;
    let haveBytecode: bool = false;
    let rejected: bool = false;
    while (true) {
        const sp = strIndexOf(rest, " ");
        let tok: string = rest;
        if (sp >= 0) {
            tok = strSub(rest, 0, sp);
            rest = strSub(rest, sp + 1, len(rest) - sp - 1);
        }
        if (len(tok) == 0) {
            if (sp < 0) { break; }
            continue;
        }
        if (sawArgv == false) {
            if (tok != "argv") {
                print("drivermirror: argv 文件首记须为 'argv'——结构化拒绝");
                rejected = true;
                break;
            }
            sawArgv = true;
            continue;
        }
        if (tok == "build") {
            c.kind = "build";
            continue;
        }
        if (tok == "--bytecode") {
            haveBytecode = true;
            continue;
        }
        if (tok == "-o") {
            const sp2 = strIndexOf(rest, " ");
            if (sp2 < 0) {
                // 尾行换行符剥离（末 token 防双 \n）
                const nl = strIndexOf(rest, "\n");
                if (nl >= 0) {
                    c.outArg = strSub(rest, 0, nl);
                } else {
                    c.outArg = rest;
                }
                rest = "";
            } else {
                c.outArg = strSub(rest, 0, sp2);
                rest = strSub(rest, sp2 + 1, len(rest) - sp2 - 1);
            }
            continue;
        }
        if (len(tok) >= 11) {
            if (strSub(tok, 0, 11) == "--frontend=") {
                c.frontend = strSub(tok, 11, len(tok));
                continue;
            }
        }
        // 其余位置实参＝入口（display 以 facts 面为准）
    }
    if (rejected) { return 1; }
    if (sawArgv == false) {
        print("drivermirror: 输入缺 argv 记录——结构化拒绝");
        return 1;
    }
    if (c.kind != "build") {
        print("drivermirror: 子命令在 spike 决策面外（仅 build）——结构化拒绝（D95 §三）");
        return 1;
    }
    if (haveBytecode == false) {
        print("drivermirror: spike 决策面＝build --bytecode（缺 --bytecode）——结构化拒绝");
        return 1;
    }
    if (len(c.frontend) == 0) { c.frontend = "tx"; } // 缺省前端＝.tx 镜像链
    if (c.frontend != "tx") {
        print("drivermirror: 前端 '" + c.frontend + "' 在 spike 决策面外——结构化拒绝（D95 §三）");
        return 1;
    }

    // —— 决策序列落盘（DRIVERDUMP v1；facts 整读整写零切片）——
    emitLn(c, "DRIVERDUMP v1");
    emitLn(c, "kind " + c.kind);
    emitLn(c, "frontend " + c.frontend);
    emitLn(c, "require_main true");
    emitLn(c, "stage load");
    emitLn(c, "stage sein");
    emitLn(c, "stage mirror");
    emitLn(c, "stage loader");
    emitLn(c, "stage codegen");
    emitLn(c, "stage serialize");
    emitLn(c, "out " + c.outArg);
    const head = joinRange(c.parts, 0, listLen(c.parts));
    // facts＝entry+module 行（zig loadGraph 序 verbatim）——置于 require_main
    // 之后、stages 之前？dump 序＝…require_main/entry/module*/stage*/out——
    // 因此输出＝head（至 require_main）＋facts＋tail（stages+out）。
    const tailStart = strIndexOf(head, "stage load");
    const headOnly = strSub(head, 0, tailStart);
    const tail = strSub(head, tailStart, len(head) - tailStart);
    const out = headOnly + facts + tail;
    writeFile(c.outPath, out) catch (e) {
        print("drivermirror: 写出失败: " + e.message);
        return 1;
    };
    return 0;
}
