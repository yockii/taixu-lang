// ana_dev.tx —— 隐藏开发命令 dev-check 的分析节输出与自检（第 6 轮 6d-3a1，LSP 与 MCP 实施设计 §四-2）。
import { drvCheck, drvCheckFull, drvDiagOut, drvLastSeb1, drvAnaInts, drvAnaNames, drvAnaDetInts, drvAnaDetStrs, drvModulePathList, drvModuleTextList, drvModuleDisplayList } from "./driver";
import { anaResolve, anaJsonLines, anaDetails } from "./ana_index";

// 上一次检查实际使用的源文本快照；`<prelude>` 取调用方的内嵌 prelude。
export function anaModuleTexts(ovPaths: List<string>, ovTexts: List<string>, prelude: string): List<string> {
    const out: List<string> = listNew();
    const captured = drvModuleTextList(); let i = 0;
    for (p in drvModulePathList()) {
        let text = listGet(captured, i) catch "";
        if (p == "<prelude>") { text = prelude; }
        listPush(out, text);
        i = i + 1;
    }
    return out;
}

// 上一次检查的分析节，每个出现一行 JSON（见 anaJsonLines）。
export function anaDevLines(ovPaths: List<string>, ovTexts: List<string>, prelude: string): List<string> {
    const occs = anaResolve(drvAnaInts(), drvAnaNames(), anaModuleTexts(ovPaths, ovTexts, prelude));
    return anaJsonLines(occs, drvModuleDisplayList(), anaDetails(drvAnaDetInts(), drvAnaDetStrs()));
}

function bytesPrefix(a: string, b: string): bool {
    const n = len(a);
    if (len(b) < n) { return false; }
    let i = 0;
    while (i < n) {
        if ((byteAt(a, i) catch -1) != (byteAt(b, i) catch -2)) { return false; }
        i = i + 1;
    }
    return true;
}

function anaSameInts(a: List<int>, b: List<int>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) {
        if ((listGet(a, i) catch -1) != (listGet(b, i) catch -2)) { return false; }
        i = i + 1;
    }
    return true;
}

function anaSameStrs(a: List<string>, b: List<string>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) {
        if ((listGet(a, i) catch "") != (listGet(b, i) catch "")) { return false; }
        i = i + 1;
    }
    return true;
}

// 原序列化入口保留 6d-3a1 的字节前缀门；再逐项核对进程内检查的诊断和 ANA1/ANT1，防止空文本使旧门虚过。
// 通过返回空串，状态停在带分析节的进程内检查。
export function anaDevSelfCheck(entry: string, t: int): string {
    drvCheckFull(entry, t, false);
    const diag0 = drvDiagOut();
    const seb0 = drvLastSeb1();
    drvCheckFull(entry, t, true);
    if (drvDiagOut() != diag0) { return "带分析节时诊断不同"; }
    const seb1 = drvLastSeb1();
    if (len(seb0) != 0 || len(seb1) != 0) {
        if (!bytesPrefix(seb0, seb1)) { return "带分析节时 SEB1 在 ANA1 之前的部分不同"; }
        const n = len(seb0);
        const tag = "ANA1 ";
        let k = 0;
        while (k < len(tag)) {
            if ((byteAt(seb1, n + k) catch -1) != (byteAt(tag, k) catch -2)) { return "带分析节时 SEB1 的尾部不是 ANA1"; }
            k = k + 1;
        }
    }
    const ai = drvAnaInts(); const an = drvAnaNames();
    const di = drvAnaDetInts(); const ds = drvAnaDetStrs();
    drvCheck(entry, t, false);
    if (drvDiagOut() != diag0) { return "进程内检查与序列化检查的诊断不同"; }
    if (listLen(drvAnaInts()) != 0 || listLen(drvAnaDetInts()) != 0) { return "未启用分析时返回了分析数组"; }
    drvCheck(entry, t, true);
    if (drvDiagOut() != diag0) { return "进程内分析检查与序列化检查的诊断不同"; }
    if (!anaSameInts(ai, drvAnaInts()) || !anaSameStrs(an, drvAnaNames())) { return "进程内检查与序列化检查的 ANA1 不同"; }
    if (!anaSameInts(di, drvAnaDetInts()) || !anaSameStrs(ds, drvAnaDetStrs())) { return "进程内检查与序列化检查的 ANT1 不同"; }
    return "";
}
