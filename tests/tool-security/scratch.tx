import { scratchCreate, scratchUse, scratchProduct, scratchClean } from "../../bootstrap/selfhost/mcp_scratch";
import { serviceConfigure } from "../../bootstrap/selfhost/service_files";
import { scratchPathSafe } from "../../bootstrap/selfhost/mcp_scratch_path";
function exhausted(): bool {
    scratchProduct() catch (e) { return strIndexOf(e.message, "capacity_exhausted") >= 0; }; return false;
}
function main(args: []string): int {
    assert(scratchPathSafe("C:/tools/太虚/tmp", true), "ordinary Win32 spelling");
    for (path in["C:/tmp./x", "C:/tmp /x", "C:/NUL.txt/x", "C:/COM¹/x", "C:/LPT³.txt/x", "C:/tmp?/x", "//invalid/share", "C:relative"]) {
        assert(!scratchPathSafe(path, true), "reject Win32/NT spelling ambiguity");
    }
    args; const roots: List< string> = listNew(); const libs: List< string> = listNew();
    assert(serviceConfigure(roots, libs, libs), "local startup");
    const root = scratchCreate(123) catch (e) { print(e.message); return 1; };
    assert(scratchUse(root), "parent-owned root");
    const files: List< string> = listNew(); let i = 0;
    while (i < 64) {
        const file = scratchProduct() catch (e) { print(e.message); return 2; };
        listPush(files, file); writeFile(file, "controlled") catch (e) { print(e.message); return 3; }; i = i + 1;
    }
    assert(exhausted(), "fixed live slot budget");
    const first = listGet(files, 0) catch "";
    removeFile(first) catch (e) { print(e.message); return 4; };
    const reused = scratchProduct() catch (e) { print(e.message); return 5; };
    assert(reused == first, "reuse exclusive vacant slot");
    writeFile(root + "/unknown.txt", "preserve me") catch (e) { print(e.message); return 6; };
    assert(!scratchClean(root), "unknown entries prevent recursive cleanup");
    assert((readFile(root + "/unknown.txt") catch "") == "preserve me", "unknown data preserved");
    removeFile(root + "/unknown.txt") catch (e) { print(e.message); return 7; };
    assert(scratchClean(root) && localEntryKind(root, "") == 0, "bounded files and empty directory removed");
    print("PASS_SCRATCH_EXCLUSIVE_CAPACITY_REUSE_CONSERVATIVE_CLEANUP"); return 0;
}
