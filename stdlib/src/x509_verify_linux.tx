import { x509VerifyServerPath } from "./x509_path";
import { x509SystemRoots } from "./x509_roots";
import { x509CheckServerInputs } from "./x509_verify_common";

export function x509VerifyServer(chain: List<Bytes>, hostname: string, nowSecs: int, roots: List<Bytes>): void | Error {
    x509CheckServerInputs(chain, hostname, roots)?;
    let anchors = roots; if (listLen(anchors) == 0) { anchors = x509SystemRoots()?; }
    return x509VerifyServerPath(chain, hostname, nowSecs, anchors);
}
