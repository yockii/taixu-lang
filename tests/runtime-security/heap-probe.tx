// 页堆的产物级正控制（scripts/test-heap-check.py）：外部库越过 Bytes 末尾写、或保留地址等太虚释放后再写。
// Bytes 的数据区按长度分配：16 字节的区紧贴保护页，10 字节的区后面是 6 字节块尾空隙。
declare function tx_hc_poke(b: Bytes, offset: usize): void from "heap_probe";
declare function tx_hc_keep(b: Bytes): void from "heap_probe";
declare function tx_hc_poke_kept(offset: usize): void from "heap_probe";

function spill(n: int, offset: int): int {
    const b = bytesNew(n);
    tx_hc_poke(b, offset as usize);
    return bytesLen(b);
}

function keep(): int {
    const b = bytesNew(16);
    tx_hc_keep(b);
    return bytesLen(b);
}

function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    const mode = args[0];
    if (mode == "clean") { print("len " + toStr(spill(16, 15))); }
    if (mode == "slack") { print("len " + toStr(spill(10, 10))); }
    if (mode == "guard") { print("len " + toStr(spill(16, 16))); }
    if (mode == "use-after-free") {
        print("len " + toStr(keep()));
        tx_hc_poke_kept(0);
    }
    print("PASS_HEAP_PROBE " + mode);
    return 0;
}
