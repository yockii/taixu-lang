// 分析节黄金用例：泛型函数与泛型 struct 的体（经实例的副本得到身份，多个实例去重）、带约束模板在定义处检查的副本。
// 有意保留紧凑的泛型写法（wrap<T>(…)，fmt 会写成 wrap < T > (…)），data/ana_lib.tx 是 fmt 的写法。
interface Sized {
    size(): int;
}

struct Box<T> {
    item: T,
    count: int,
}

struct Bag {
    n: int,
}

function bagSize(b: Bag): int {
    return b.n;
}

function wrap<T>(v: T): Box< T> {
    const out = Box< T> { item: v, count: 1 };
    return out;
}

function countOf<T>(b: Box< T>): int {
    let c = b.count;
    c = c + 1;
    return c;
}

function total<T extends Sized>(xs: List< T>): int {
    let sum = 0;
    for (x in xs) {
        sum = sum + x.size();
    }
    return sum;
}

function unused<T extends Sized>(x: T): int {
    const s = x.size();
    return s;
}

function neverCalled<T>(x: T): T {
    const y = x;
    return y;
}

function main(args: []string): int {
    const a = wrap(1);
    const b = wrap("s");
    const bags: List< Bag> = listNew();
    listPush(bags, Bag { n: 2 });
    return countOf(a) + countOf(b) + a.item + total(bags);
}
