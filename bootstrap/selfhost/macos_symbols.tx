// macOS 的 libSystem 链接名与库名（macOS 适配 M2 设计 E3、F1，docs/design/v052-macos-m2-runtime-v0.1-20261024.md）。
// Apple 的 C 头文件把一部分函数改名链接（__DARWIN_INODE64、__DARWIN_EXTSN、__DARWIN_1050），不带后缀的同名函数
// 仍然导出，却是旧结构或旧语义。x86_64 上三类都有；arm64 上只有 __DARWIN_EXTSN（realpath、syslog）。下表取自测试机上
// Apple clang（-arch x86_64／-arch arm64，-mmacosx-version-min=13.0）产物的 nm -u（2026-10-24），内核的蹦床与外部函数
// 从 libSystem 导入都经它，太虚里声明的 stat 与 C 程序拿到的是同一个函数。
import { T_X64_MACOS, tMacos } from "./target";

export const MAC_LIBSYSTEM: string = "/usr/lib/libSystem.B.dylib";

// 64 位 inode 版（struct stat、struct dirent、struct statfs 的新布局）。
const INODE64: string = "alphasort fdopendir fstat fstatat fstatfs fstatx_np fts_children fts_close fts_open fts_open_b fts_read fts_set ftw getfsstat getmntinfo getmntinfo_r_np glob glob_b lstat lstatx_np nftw opendir readdir readdir_r rewinddir scandir scandir_b seekdir stat statfs statx_np telldir";

// 两个架构上都改名的（POSIX 新语义版）。
const EXTSN: string = "realpath syslog";

function inList(list: string, name: string): bool {
    for (x in strSplit(list, " ")) { if (x == name) { return true; } }
    return false;
}

/// libSystem 函数 name 在目标 t 上的链接名（不含前导下划线）。
export function macLinkName(name: string, t: int): string {
    if (!tMacos(t)) { return name; }
    if (inList(EXTSN, name)) { return name + "$DARWIN_EXTSN"; }
    if (t != T_X64_MACOS) { return name; }
    if (inList(INODE64, name)) { return name + "$INODE64"; }
    if (name == "select" || name == "pselect") { return name + "$1050"; }
    return name;
}

/// from "库" 的库名 → 安装名：简写 "libSystem" 展开，其余原样（是否合法见 macInstallNameOk）。
export function macDylib(lib: string): string {
    if (lib == "libSystem") { return MAC_LIBSYSTEM; }
    return lib;
}

/// macOS 上 from "库" 只收安装名：/ 开头的绝对路径，@executable_path/、@loader_path/ 开头的装载路径，或 "libSystem"。
/// @rpath/ 要求产物带 LC_RPATH，现在没有设定 rpath 的途径，不收（写了只会在装载时失败）。
export function macInstallNameOk(lib: string): bool {
    if (lib == "libSystem") { return true; }
    if (strIndexOf(lib, "/") == 0 && len(lib) > 1) { return true; }
    return strIndexOf(lib, "@executable_path/") == 0 || strIndexOf(lib, "@loader_path/") == 0;
}
