// Obj72 对象记录与视图的可移植版（rtfn 写，macOS 适配 M4 设计 A8）：语义与导出名同 object_record.tx。
// 规格 ObjectSpec64：{种类 u32@0, u32@4, u32@8, 载荷种类 u32@12, 字段@16 @24 @32, u32@40, u32@44, @48, @56}。
// 对象 Obj72：{flags u32@0, u32@4, u32@8, 种类 u32@12, 载荷种类 u32@16, 弱引用头 u32@20, u32@24, u32@28, 指针@32, 长度@40, @48, @56, @64}。
// 载荷种类 k（0..12）与对象种类的对应：0 → 1、2；1 → 3、5；2 → 4、5；k ≥ 3 → k+3（7、8 另查 @24 ≤ @32 与 form@44 的范围）。
// 9 生成器（D3 v0.22，种类 12）、10 线程句柄（13）、11 Shared 句柄（14）、12 Atomic<int>（15），说明见 object_record.tx。
import { StructuredBuffer } from "./assemble";
import { RtFn, L, I } from "./rtfn_base";
import { rtBegin, rtEnd, rtFailed, rtSet, rtOp, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtRet, rtRetVoid } from "./rtfn";

const MODULE: string = "bootstrap/selfhost/object_record_generic.tx";
const M32: int = 4294967295;

function done(f: Ref<RtFn>, failures: List<string>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

function copy4(f: Ref<RtFn>, dst: string, dOff: int, src: string, sOff: int): void {
    rtLoad(f, "x", L(src), sOff, 4);
    rtStore(f, L(dst), dOff, L("x"), 4);
}

function copy8(f: Ref<RtFn>, dst: string, dOff: int, src: string, sOff: int): void {
    rtLoad(f, "x", L(src), sOff, 8);
    rtStore(f, L(dst), dOff, L("x"), 8);
}

// object_init(obj, spec) → 1 并写好对象记录；obj 或 spec 为空、规格不合法时为 0（不写）。规格先整份拍快照（s0..s7）再校验与写出。
function initFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_object_init_v1", "obj spec", "s0 s1 s2 s3 s4 s5 s6 s7 sp kind pk x y", 0, MODULE);
    rtIf(f, L("obj"), "eq", I(0), "bad");
    rtIf(f, L("spec"), "eq", I(0), "bad");
    rtLoad(f, "s0", L("spec"), 0, 8);
    rtLoad(f, "s1", L("spec"), 8, 8);
    rtLoad(f, "s2", L("spec"), 16, 8);
    rtLoad(f, "s3", L("spec"), 24, 8);
    rtLoad(f, "s4", L("spec"), 32, 8);
    rtLoad(f, "s5", L("spec"), 40, 8);
    rtLoad(f, "s6", L("spec"), 48, 8);
    rtLoad(f, "s7", L("spec"), 56, 8);
    rtAddrOf(f, "sp", "s0");
    rtLoad(f, "kind", L("sp"), 0, 4);
    rtLoad(f, "pk", L("sp"), 12, 4);
    rtIf(f, L("kind"), "ult", I(1), "bad");
    rtIf(f, L("kind"), "ugt", I(15), "bad");
    rtIf(f, L("pk"), "ugt", I(12), "bad");
    rtIf(f, L("pk"), "eq", I(0), "kind0");
    rtIf(f, L("pk"), "eq", I(1), "kind1");
    rtIf(f, L("pk"), "eq", I(2), "kind2");
    // k ≥ 3：对象种类须为 k+3。
    rtOp(f, "x", L("pk"), "add", I(3));
    rtIf(f, L("kind"), "ne", L("x"), "bad");
    rtIf(f, L("pk"), "eq", I(7), "list");
    rtIf(f, L("pk"), "eq", I(8), "list");
    rtJump(f, "write");
    rtLabel(f, "list");
    rtLoad(f, "x", L("sp"), 24, 8);
    rtLoad(f, "y", L("sp"), 32, 8);
    rtIf(f, L("x"), "ugt", L("y"), "bad");
    rtLoad(f, "x", L("sp"), 44, 4);
    rtIf(f, L("pk"), "eq", I(8), "form8");
    // 载荷种类 7 的 form：1 通用、2 原始、3 紧凑。
    rtIf(f, L("x"), "ult", I(1), "bad");
    rtIf(f, L("x"), "ugt", I(3), "bad");
    rtJump(f, "write");
    rtLabel(f, "form8");
    rtIf(f, L("x"), "ugt", I(2), "bad");
    rtJump(f, "write");
    rtLabel(f, "kind0");
    rtIf(f, L("kind"), "eq", I(1), "write");
    rtIf(f, L("kind"), "eq", I(2), "write");
    rtJump(f, "bad");
    rtLabel(f, "kind1");
    rtIf(f, L("kind"), "eq", I(3), "write");
    rtIf(f, L("kind"), "eq", I(5), "write");
    rtJump(f, "bad");
    rtLabel(f, "kind2");
    rtIf(f, L("kind"), "eq", I(4), "write");
    rtIf(f, L("kind"), "eq", I(5), "write");
    rtJump(f, "bad");
    rtLabel(f, "write");
    rtStore(f, L("obj"), 0, I(0), 4);
    copy4(f, "obj", 4, "sp", 4);
    copy4(f, "obj", 8, "sp", 8);
    copy4(f, "obj", 12, "sp", 0);
    copy4(f, "obj", 16, "sp", 12);
    rtStore(f, L("obj"), 20, I(-1), 4);
    copy4(f, "obj", 24, "sp", 40);
    copy4(f, "obj", 28, "sp", 44);
    copy8(f, "obj", 32, "sp", 16);
    copy8(f, "obj", 40, "sp", 24);
    copy8(f, "obj", 48, "sp", 32);
    copy8(f, "obj", 56, "sp", 48);
    copy8(f, "obj", 64, "sp", 56);
    rtRet(f, I(1));
    rtLabel(f, "bad");
    rtRet(f, I(0));
    done(f, failures);
}

// object_payload(obj, out)：先把 out 的 80 字节清零，再按载荷种类填载荷视图（payload_abi 的 PAYLOAD_*）；帧对象（flags 位 4）
// 不报背板。
function payloadFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_object_payload_v1", "obj out", "pk x y", 0, MODULE);
    let at = 0;
    while (at < 80) { rtStore(f, L("out"), at, I(0), 8); at = at + 8; }
    copy4(f, "out", 28, "obj", 0);
    rtStore(f, L("out"), 32, I(4), 8);
    rtStore(f, L("out"), 72, I(1), 4);
    rtLoad(f, "pk", L("obj"), 16, 4);
    rtIf(f, L("pk"), "eq", I(1), "values");
    rtIf(f, L("pk"), "eq", I(2), "values");
    rtIf(f, L("pk"), "eq", I(3), "values");
    // 生成器（D3 v0.22，种类 12）：@32／@40 为快照值槽。
    rtIf(f, L("pk"), "eq", I(9), "values");
    rtIf(f, L("pk"), "eq", I(4), "slice");
    rtIf(f, L("pk"), "eq", I(7), "list");
    rtIf(f, L("pk"), "eq", I(8), "future");
    rtJump(f, "frame");
    rtLabel(f, "values");
    rtLoad(f, "x", L("obj"), 32, 8);
    rtStore(f, L("out"), 0, L("x"), 8);
    rtLoad(f, "y", L("obj"), 40, 8);
    rtStore(f, L("out"), 8, L("y"), 8);
    rtStore(f, L("out"), 24, I(1), 4);
    rtIf(f, L("y"), "eq", I(0), "frame");
    rtStore(f, L("out"), 16, L("x"), 8);
    rtJump(f, "frame");
    rtLabel(f, "slice");
    rtStore(f, L("out"), 32, I(10), 8);
    rtLoad(f, "x", L("obj"), 24, 4);
    rtStore(f, L("out"), 40, L("x"), 8);
    rtOp(f, "x", L("out"), "add", I(32));
    rtStore(f, L("out"), 0, L("x"), 8);
    rtStore(f, L("out"), 8, I(1), 8);
    rtJump(f, "frame");
    rtLabel(f, "future");
    rtOp(f, "x", L("obj"), "add", I(56));
    rtStore(f, L("out"), 0, L("x"), 8);
    rtStore(f, L("out"), 8, I(1), 8);
    rtStore(f, L("out"), 24, I(1), 4);
    rtLoad(f, "x", L("obj"), 48, 8);
    rtIf(f, L("x"), "eq", I(0), "frame");
    copy8(f, "out", 16, "obj", 32);
    rtJump(f, "frame");
    rtLabel(f, "list");
    copy8(f, "out", 48, "obj", 32);
    copy8(f, "out", 56, "obj", 40);
    copy8(f, "out", 64, "obj", 48);
    rtLoad(f, "y", L("obj"), 28, 4);
    rtStore(f, L("out"), 72, L("y"), 4);
    copy4(f, "out", 76, "obj", 24);
    rtStore(f, L("out"), 24, I(2), 4);
    rtIf(f, L("y"), "ne", I(1), "frame");
    copy8(f, "out", 0, "obj", 32);
    copy8(f, "out", 8, "obj", 40);
    rtLabel(f, "frame");
    rtLoad(f, "x", L("obj"), 0, 4);
    rtOp(f, "x", L("x"), "and", I(4));
    rtIf(f, L("x"), "eq", I(0), "out");
    rtStore(f, L("out"), 16, I(0), 8);
    rtStore(f, L("out"), 24, I(0), 4);
    rtLabel(f, "out");
    rtRetVoid(f);
    done(f, failures);
}

// clone_view／equal_view(obj, kind u32, out) → 视图种类，并把 32 字节视图写进 out（先清零）。
// clone：标签 7、8、9 是复合（字段 1、枚举 2），10 数组 3；载荷种类不符为 5；其余 0。
// equal：标签 5、6 是字节（载荷种类须为 0）1，7 字段 2，8 枚举 3，10 数组 4；不符或其余为 0。
function viewFn(b: Ref<StructuredBuffer>, failures: List<string>, clone: bool): void {
    let name = "__tx_native_object_equal_view_v1";
    if (clone) { name = "__tx_native_object_clone_view_v1"; }
    const f = rtBegin(b, name, "obj kind out", "pk r x", 0, MODULE);
    rtStore(f, L("out"), 0, I(0), 8);
    rtStore(f, L("out"), 8, I(0), 8);
    rtStore(f, L("out"), 16, I(0), 8);
    rtStore(f, L("out"), 24, I(0), 8);
    rtOp(f, "kind", L("kind"), "and", I(M32));
    rtLoad(f, "pk", L("obj"), 16, 4);
    if (!clone) {
        rtIf(f, L("kind"), "eq", I(5), "bytes");
        rtIf(f, L("kind"), "eq", I(6), "bytes");
    }
    rtIf(f, L("kind"), "eq", I(7), "compound");
    rtIf(f, L("kind"), "eq", I(8), "compound");
    if (clone) { rtIf(f, L("kind"), "eq", I(9), "compound"); }
    rtIf(f, L("kind"), "eq", I(10), "array");
    rtJump(f, "none");
    if (!clone) {
        rtLabel(f, "bytes");
        rtIf(f, L("pk"), "ne", I(0), "none");
        rtSet(f, "r", I(1));
        rtJump(f, "span");
    }
    rtLabel(f, "compound");
    rtIf(f, L("pk"), "eq", I(1), "fields");
    rtIf(f, L("pk"), "eq", I(2), "enum");
    rtJump(f, "bad");
    rtLabel(f, "fields");
    if (!clone) { rtIf(f, L("kind"), "ne", I(7), "none"); }
    copy4(f, "out", 4, "obj", 4);
    if (clone) { rtSet(f, "r", I(1)); } else { rtSet(f, "r", I(2)); }
    rtJump(f, "span");
    rtLabel(f, "enum");
    if (clone) {
        rtSet(f, "r", I(2));
        copy4(f, "out", 4, "obj", 4);
    } else {
        rtIf(f, L("kind"), "ne", I(8), "none");
        rtSet(f, "r", I(3));
    }
    rtJump(f, "meta");
    rtLabel(f, "array");
    rtIf(f, L("pk"), "ne", I(3), "bad");
    if (clone) {
        rtSet(f, "r", I(3));
        copy4(f, "out", 4, "obj", 4);
    } else {
        rtSet(f, "r", I(4));
    }
    rtLabel(f, "meta");
    copy4(f, "out", 8, "obj", 24);
    rtLabel(f, "span");
    rtStore(f, L("out"), 0, L("r"), 4);
    copy8(f, "out", 16, "obj", 32);
    copy8(f, "out", 24, "obj", 40);
    rtRet(f, L("r"));
    rtLabel(f, "bad");
    if (clone) { rtRet(f, I(5)); }
    rtLabel(f, "none");
    rtRet(f, I(0));
    done(f, failures);
}

// weak_dead(obj, rc u32, target u32)：rc 非零、对象是弱引用盒（种类 9、载荷种类 6）且指向 target 时把“已死”位 @28 置 1。
function weakDeadFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_object_weak_dead_v1", "obj rc target", "x", 0, MODULE);
    rtOp(f, "rc", L("rc"), "and", I(M32));
    rtIf(f, L("rc"), "eq", I(0), "out");
    rtLoad(f, "x", L("obj"), 12, 4);
    rtIf(f, L("x"), "ne", I(9), "out");
    rtLoad(f, "x", L("obj"), 16, 4);
    rtIf(f, L("x"), "ne", I(6), "out");
    rtLoad(f, "x", L("obj"), 24, 4);
    rtOp(f, "target", L("target"), "and", I(M32));
    rtIf(f, L("x"), "ne", L("target"), "out");
    rtStore(f, L("obj"), 28, I(1), 4);
    rtLabel(f, "out");
    rtRetVoid(f);
    done(f, failures);
}

/// 发出对象记录的五个函数；rtfn 的失败记进 failures。t 为目标编号（只在语义随目标不同时用；这里不用）。
export function objectRecordGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, t: int): void {
    initFn(b, failures);
    payloadFn(b, failures);
    viewFn(b, failures, true);
    viewFn(b, failures, false);
    weakDeadFn(b, failures);
}
