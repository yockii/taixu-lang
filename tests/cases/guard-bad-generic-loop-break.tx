// 泛型函数体从循环之外开始检查：在循环里首次实例化时，函数体顶层的 break 原先被放过（跳转没有目标）。
function first<T>(xs: List<T>, d: T): T {
    break;
    return listTryGet(xs, 0) ?? d;
}

export function main(args: []string): int {
    args;
    const xs: List<int> = listNew();
    listPush(xs, 7);
    let i: int = 0;
    while (i < 2) {
        print(toStr(first(xs, 0)));
        i = i + 1;
    }
    return 0;
}
