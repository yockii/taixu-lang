// D3 v0.51 §6.6-1：期望类型为 List<T>（含 List<T>?）时数组字面量构造新 List——元素按 T 检查（定宽字面量
// 按 T 取值），[] 得空表；绑定、实参、返回值、struct 字段、嵌套 List<List<T>> 都适用；每次求值都是新表。
struct Bag { items: List<int> }

function total(xs: List<int>): int {
    let s = 0;
    for (x in xs) { s += x; }
    return s;
}

function mk(): List<string> {
    return ["p", "q"];
}

export function main(args: []string): int {
    const empty: List<int> = [];
    const nums: List<u8> = [1, 2, 255];
    const nested: List<List<int>> = [[1], [2, 3]];
    const b = Bag { items: [4, 5] };
    listPush(b.items, 6);
    let fresh = 0;
    let k = 0;
    while (k < 2) {
        const l: List<int> = [k];
        listPush(l, 9);
        fresh += listLen(l);
        k += 1;
    }
    const maybe: List<int>? = [8];
    print(toStr(listLen(empty)) + " " + toStr(listLen(nums)) + " " + toStr(listGet(nums, 2)) + " " + toStr(listLen(listGet(nested, 1))));
    print(toStr(total([1, 2, 3])) + " " + listGet(mk(), 1) + " " + toStr(total(b.items)) + " " + toStr(fresh) + " " + toStr(listLen(maybe ?? [])));
    const os: List<int?> = [1, None, 3];
    print(toStr(listLen(os)) + " " + toStr(listGet(os, 1) == None));
    return 0;
}
