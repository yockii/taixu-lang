// D3 v0.53：test 块同 main，可直接 await；test 结束时取消未完成的任务，挂起中的
// 先执行已登记的 defer。
async function double(n: int): int {
    (await sleepMs(0))?;
    return n * 2;
}

async function stuck(): void {
    defer {
        print("stuck defer");
    }
    (await sleepMs(600000))?;
}

test "test 块里直接 await" {
    detach stuck();
    const v = await double(21) catch 0;
    assert(v == 42, "double");
    print("awaited " + toStr(v));
}
