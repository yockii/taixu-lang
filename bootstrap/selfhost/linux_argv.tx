// Linux CRT argv is already split into byte strings; preserve every byte.
import { StructuredBuffer, asStructuredMem } from "./assemble";
import { nr, nd, ni, nm, nmd, nmb, nt, nmov, nl, nj, nc, nret, no } from "./native_emit";
function im(base: int, index: int, scale: int): Ref<Operand> { return asStructuredMem(2, base, index, scale, 0, 0, ""); }
import { Operand } from "./assemble";
export function linuxArgvEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_la";
    nl(b, "__tx_native_argv_acquire"); nt(b, "sub", nr(4), ni(104));
    nmov(b, nm(4, 32), nr(1)); nmov(b, nm(4, 40), nr(2)); nmov(b, nd(8), nd(8)); nmov(b, nm(4, 48), nr(8)); nmov(b, nm(4, 56), nr(9));
    nt(b, "test", nd(8), nd(8)); nj(b, "js", p + "_bad"); nj(b, "jz", p + "_size_start"); nt(b, "test", nr(9), nr(9)); nj(b, "jz", p + "_bad");
    nl(b, p + "_size_start"); nmov(b, nr(10), nr(8)); nt(b, "add", nr(10), ni(1)); nt(b, "shl", nr(10), ni(3)); nmov(b, nm(4, 64), nr(10)); nmov(b, nr(0), ni(0));
    nl(b, p + "_size"); nt(b, "cmp", nr(0), nm(4, 48)); nj(b, "jae", p + "_alloc"); nmov(b, nr(9), nm(4, 56)); nmov(b, nr(9), im(9, 0, 3)); nt(b, "test", nr(9), nr(9)); nj(b, "jz", p + "_bad");
    nl(b, p + "_strlen"); nt(b, "movzx", nd(11), nmb(9, 0)); nt(b, "add", nr(10), ni(1)); nj(b, "jb", p + "_bad"); nt(b, "test", nd(11), nd(11)); nj(b, "jz", p + "_next"); nt(b, "add", nr(9), ni(1)); nj(b, "jb", p + "_bad"); nj(b, "jmp", p + "_strlen");
    nl(b, p + "_next"); nt(b, "add", nr(0), ni(1)); nj(b, "jmp", p + "_size");
    nl(b, p + "_alloc"); nmov(b, nr(1), nr(10)); nmov(b, nd(2), ni(8)); nc(b, "__tx_native_mem_alloc"); nt(b, "test", nr(0), nr(0)); nj(b, "jz", p + "_oom"); nmov(b, nm(4, 72), nr(0)); nmov(b, nr(10), nr(0)); nt(b, "add", nr(10), nm(4, 64)); nmov(b, nr(8), ni(0));
    nl(b, p + "_copy"); nt(b, "cmp", nr(8), nm(4, 48)); nj(b, "jae", p + "_commit"); nmov(b, nr(9), nm(4, 56)); nmov(b, nr(9), im(9, 8, 3)); nmov(b, im(0, 8, 3), nr(10));
    nl(b, p + "_bytes"); nt(b, "movzx", nd(11), nmb(9, 0)); nmov(b, nmb(10, 0), asStructuredReg(2, 11)); nt(b, "add", nr(10), ni(1)); nt(b, "add", nr(9), ni(1)); nt(b, "test", nd(11), nd(11)); nj(b, "jne", p + "_bytes"); nt(b, "add", nr(8), ni(1)); nj(b, "jmp", p + "_copy");
    nl(b, p + "_commit"); nmov(b, im(0, 8, 3), ni(0)); nmov(b, nr(1), nm(4, 32)); nmov(b, nm(1, 0), nr(0)); nmov(b, nr(1), nm(4, 40)); nmov(b, nmd(1, 0), nd(8)); nmov(b, nr(0), ni(0)); nj(b, "jmp", p + "_done");
    nl(b, p + "_bad"); nmov(b, nr(0), ni(5)); nj(b, "jmp", p + "_done"); nl(b, p + "_oom"); nmov(b, nr(0), ni(2));
    nl(b, p + "_done"); nt(b, "add", nr(4), ni(104)); nret(b);
}
import { asStructuredReg } from "./assemble";
