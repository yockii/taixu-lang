// ============================================================================
// engine/mac/m_rrect_macos_x86_64 —— NSRect(id, SEL)（如 frame）：x86_64 上 32 字节的 NSRect 是内存类，经隐藏指针返回，须用 objc_msgSend_stret。
// ============================================================================

import { NSRECT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend_stret(o: usize, s: usize): NSRECT from "/usr/lib/libobjc.A.dylib";

export function msgRetRect(o: usize, s: string): NSRECT {
    return objc_msgSend_stret(o, sel_registerName(s));
}
