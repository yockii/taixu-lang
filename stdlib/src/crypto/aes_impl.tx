// AES-128 内部实现，FIPS 197。域运算固定轮次，无秘密索引表。
function at(data: Bytes, index: int): int { return bytesGet(data, index) catch panic("aes: internal bounds"); }

function xtime(x: int): int { return ((x << 1) & 255) ^ (27 & -(x >> 7)); }

function multiply(x: int, y: int): int {
    let a = x; let b = y; let product = 0; let i = 0;
    while (i < 8) {
        product = product ^ (a & -(b & 1));
        a = xtime(a); b = b >> 1; i = i + 1;
    }
    return product;
}

function rotate(x: int, n: int): int { return ((x << n) | (x >> (8 - n))) & 255; }

function substitute(x: int): int {
    const x2 = multiply(x, x);
    const x4 = multiply(x2, x2);
    const x8 = multiply(x4, x4);
    const x16 = multiply(x8, x8);
    const x32 = multiply(x16, x16);
    const x64 = multiply(x32, x32);
    const x128 = multiply(x64, x64);
    const a = multiply(multiply(multiply(multiply(multiply(multiply(x2, x4), x8), x16), x32), x64), x128);
    return a ^ rotate(a, 1) ^ rotate(a, 2) ^ rotate(a, 3) ^ rotate(a, 4) ^ 99;
}

// 调用方先核对密钥为 16 字节。
export function aes128Expand(key: Bytes): Bytes {
    const schedule = bytesNew(176);
    bytesCopy(schedule, 0, key, 0, 16);
    const temp = bytesNew(4);
    let i = 16; let rcon = 1;
    while (i < 176) {
        bytesCopy(temp, 0, schedule, i - 4, 4);
        if (i % 16 == 0) {
            const first = at(temp, 0);
            bytesSet(temp, 0, substitute(at(temp, 1)) ^ rcon);
            bytesSet(temp, 1, substitute(at(temp, 2)));
            bytesSet(temp, 2, substitute(at(temp, 3)));
            bytesSet(temp, 3, substitute(first));
            rcon = xtime(rcon);
        }
        let j = 0;
        while (j < 4) { bytesSet(schedule, i + j, at(schedule, i + j - 16) ^ at(temp, j)); j = j + 1; }
        i = i + 4;
    }
    return schedule;
}

function addKey(state: Bytes, schedule: Bytes, round: int): void {
    let i = 0;
    while (i < 16) { bytesSet(state, i, at(state, i) ^ at(schedule, round * 16 + i)); i = i + 1; }
}

function mixColumns(state: Bytes): void {
    let col = 0;
    while (col < 4) {
        const i = col * 4;
        const a = at(state, i); const b = at(state, i + 1); const c = at(state, i + 2); const d = at(state, i + 3);
        const sum = a ^ b ^ c ^ d;
        bytesSet(state, i, a ^ sum ^ xtime(a ^ b));
        bytesSet(state, i + 1, b ^ sum ^ xtime(b ^ c));
        bytesSet(state, i + 2, c ^ sum ^ xtime(c ^ d));
        bytesSet(state, i + 3, d ^ sum ^ xtime(d ^ a));
        col = col + 1;
    }
}

// 调用方先核对 schedule 为 176 字节、block 为 16 字节；结果缓冲独立。
export function aes128Block(schedule: Bytes, block: Bytes): Bytes {
    let state = bytesSlice(block, 0, 16);
    addKey(state, schedule, 0);
    let round = 1;
    while (round <= 10) {
        const shifted = bytesNew(16);
        let col = 0;
        while (col < 4) {
            let row = 0;
            while (row < 4) {
                bytesSet(shifted, col * 4 + row, substitute(at(state, ((col + row) % 4) * 4 + row)));
                row = row + 1;
            }
            col = col + 1;
        }
        state = shifted;
        if (round < 10) { mixColumns(state); }
        addKey(state, schedule, round);
        round = round + 1;
    }
    return state;
}
