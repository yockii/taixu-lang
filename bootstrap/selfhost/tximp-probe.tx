// tximp-probe——txImports 协议直测（临时）。
import { parseSourceBin } from "../parser";
import { txImports } from "../semamirror";
function main(args: []string): int {
    const src: string = readFile(args[0]) catch (e) { print("read fail"); return 1; };
    const bin = parseSourceBin(src);
    print("magic=" + strSub(bin, 0, 5));
    const head = txImports(bin);
    print("head=[" + head + "]");
    return 0;
}
