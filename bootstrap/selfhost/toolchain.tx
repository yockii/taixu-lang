// 对外产品版本、诊断码表和应用数据 schema；关口号不参与产品版本比较。
export const TOOLCHAIN_VERSION: string = "0.3.0-beta.1";
export const DIAGNOSTIC_VERSION: string = "1";
export const VERSION_GATE: string = "V0.52";

// schema 参数仅由工具链内的固定调用点提供；不是用户输入。
export function jsonStart(schema: string): string {
    return "{\"schema\":\"" + schema + "\"";
}

export function schemasJson(): string {
    return "[\"capabilities/1\",\"changes/1\",\"diag/1\",\"tests/1\",\"fmt/1\",\"doc/1\",\"bench/1\",\"disasm/1\",\"compile/1\",\"run/1\",\"mcp-disasm/1\",\"compile-profile/1\",\"link-map/6\",\"tool-error/1\"]";
}
