#!/usr/bin/env bash
set -eu
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
# 标准库验证由 verify.tx 执行（太虚写）：用 --compiler 给的原生编译器跑它，缺省取 TAIXU_NATIVE 或 PATH 上的 taixu。
TX=""
prev=""
for a in "$@"; do
  if [ "$prev" = "--compiler" ]; then TX="$a"; fi
  prev="$a"
done
if [ -z "$TX" ]; then TX="${TAIXU_NATIVE:-}"; fi
if [ -z "$TX" ]; then TX="$(command -v taixu || true)"; fi
if [ -z "$TX" ]; then
  echo "verify: 请给出 --compiler <原生 taixu>（或设 TAIXU_NATIVE）" >&2
  exit 2
fi
cd "$SELF_DIR"
exec "$TX" run --toolchain "$SELF_DIR/verify.tx" "$@"
