// 外部结构体字段的前端负例：外部结构体的回调字段只收顶层的非泛型、
// 非 async 函数名，类型须与字段一致（字面量与字段赋值同一规则）；回调字段的签名同回调形参的限制；wstr 只能用于外部结构体
// 字段与外部函数签名，普通 struct 的字段不能用。
declare type HWND;
declare struct WC { proc: (HWND, u32) => isize, name: wstr, title: string }
declare struct BADCB { cb: (string) => int }
struct Plain { name: wstr }

function good(h: HWND, m: u32): isize {
    return 0;
}

function wrongSig(h: HWND, m: int): isize {
    return 0;
}

async function later(h: HWND, m: u32): isize {
    return 0;
}

function main(args: []string): int {
    const cl = (h: HWND, m: u32): isize => 1;
    const a = new WC { proc: cl, name: "a", title: "t" };
    const b = new WC { proc: wrongSig, name: "b", title: "t" };
    const c = new WC { proc: later, name: "c", title: "t" };
    const fv = good;
    const d = new WC { proc: good, name: "d", title: "t" };
    d.proc = fv;
    d.proc = wrongSig;
    d.name = "ok";
    return 0;
}
