// NRT toStr(float): shortest round-trip digits (Burger & Dybvig free-format
// over exact big integers, IEEE round-half-even bounds), printed in plain
// decimal like Zig's "{d}": no exponent, "-" for a set sign bit, inf/nan.
// Big integers are 40 little-endian u32 limbs (1280 bits) in __tx_nrt_bn.
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtDivMod, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtCall0, rtCall1, rtCall2, rtCall3, rtRet, rtRetVoid } from "./rtfn";
import { check } from "./nrt_base";

const LIMBS: int = 40;
const BN_BYTES: int = 160;
const MASK32: int = 4294967295;

function emitBigInts(b: Ref<StructuredBuffer>): void {
    // bn_set(a, v): a = v (0 <= v < 2^63).
    let f = rtBegin(b, "__tx_nrt_bn_set", "a v", "i p", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(0));
    rtLabel(f, "zero");
    rtShift(f, "p", L("i"), "shl", 2); rtOp(f, "p", L("p"), "add", L("a")); rtStore(f, L("p"), 0, I(0), 4);
    rtOp(f, "i", L("i"), "add", I(1)); rtIf(f, L("i"), "lt", I(LIMBS), "zero");
    rtStore(f, L("a"), 0, L("v"), 4);
    rtShift(f, "p", L("v"), "shr", 32); rtStore(f, L("a"), 4, L("p"), 4);
    rtRetVoid(f); check(f);

    // bn_copy(d, a)
    f = rtBegin(b, "__tx_nrt_bn_copy", "d a", "i p x", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(0));
    rtLabel(f, "loop");
    rtShift(f, "p", L("i"), "shl", 2); rtOp(f, "x", L("p"), "add", L("a")); rtLoad(f, "x", L("x"), 0, 4);
    rtOp(f, "p", L("p"), "add", L("d")); rtStore(f, L("p"), 0, L("x"), 4);
    rtOp(f, "i", L("i"), "add", I(1)); rtIf(f, L("i"), "lt", I(LIMBS), "loop");
    rtRetVoid(f); check(f);

    // bn_mul(a, m): a *= m (0 < m <= 2^31).
    f = rtBegin(b, "__tx_nrt_bn_mul", "a m", "i p c x", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(0)); rtSet(f, "c", I(0));
    rtLabel(f, "loop");
    rtShift(f, "p", L("i"), "shl", 2); rtOp(f, "p", L("p"), "add", L("a"));
    rtLoad(f, "x", L("p"), 0, 4); rtOp(f, "x", L("x"), "imul", L("m")); rtOp(f, "x", L("x"), "add", L("c"));
    rtStore(f, L("p"), 0, L("x"), 4); rtShift(f, "c", L("x"), "shr", 32);
    rtOp(f, "i", L("i"), "add", I(1)); rtIf(f, L("i"), "lt", I(LIMBS), "loop");
    rtRetVoid(f); check(f);

    // bn_add(d, a, c): d = a + c (d may alias a).
    f = rtBegin(b, "__tx_nrt_bn_add", "d a c", "i p k x y", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(0)); rtSet(f, "k", I(0));
    rtLabel(f, "loop");
    rtShift(f, "p", L("i"), "shl", 2);
    rtOp(f, "x", L("p"), "add", L("a")); rtLoad(f, "x", L("x"), 0, 4);
    rtOp(f, "y", L("p"), "add", L("c")); rtLoad(f, "y", L("y"), 0, 4);
    rtOp(f, "x", L("x"), "add", L("y")); rtOp(f, "x", L("x"), "add", L("k"));
    rtOp(f, "p", L("p"), "add", L("d")); rtStore(f, L("p"), 0, L("x"), 4); rtShift(f, "k", L("x"), "shr", 32);
    rtOp(f, "i", L("i"), "add", I(1)); rtIf(f, L("i"), "lt", I(LIMBS), "loop");
    rtRetVoid(f); check(f);

    // bn_sub(d, a): d -= a (d >= a).
    f = rtBegin(b, "__tx_nrt_bn_sub", "d a", "i p k x y", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(0)); rtSet(f, "k", I(0));
    rtLabel(f, "loop");
    rtShift(f, "p", L("i"), "shl", 2);
    rtOp(f, "y", L("p"), "add", L("a")); rtLoad(f, "y", L("y"), 0, 4);
    rtOp(f, "p", L("p"), "add", L("d")); rtLoad(f, "x", L("p"), 0, 4);
    rtOp(f, "x", L("x"), "sub", L("y")); rtOp(f, "x", L("x"), "sub", L("k"));
    rtSet(f, "k", I(0));
    rtIf(f, L("x"), "ge", I(0), "store");
    rtOp(f, "x", L("x"), "add", I(4294967296)); rtSet(f, "k", I(1));
    rtLabel(f, "store");
    rtStore(f, L("p"), 0, L("x"), 4);
    rtOp(f, "i", L("i"), "add", I(1)); rtIf(f, L("i"), "lt", I(LIMBS), "loop");
    rtRetVoid(f); check(f);

    // bn_cmp(a, c) → -1 / 0 / 1.
    f = rtBegin(b, "__tx_nrt_bn_cmp", "a c", "i p x y", 0, "bootstrap/selfhost/nrt_float.tx");
    rtSet(f, "i", I(LIMBS - 1));
    rtLabel(f, "loop");
    rtShift(f, "p", L("i"), "shl", 2);
    rtOp(f, "x", L("p"), "add", L("a")); rtLoad(f, "x", L("x"), 0, 4);
    rtOp(f, "y", L("p"), "add", L("c")); rtLoad(f, "y", L("y"), 0, 4);
    rtIf(f, L("x"), "lt", L("y"), "less"); rtIf(f, L("x"), "gt", L("y"), "more");
    rtOp(f, "i", L("i"), "sub", I(1)); rtIf(f, L("i"), "ge", I(0), "loop");
    rtRet(f, I(0));
    rtLabel(f, "less"); rtRet(f, I(-1));
    rtLabel(f, "more"); rtRet(f, I(1)); check(f);

    // bn_pow2(a, n): a *= 2^n.
    f = rtBegin(b, "__tx_nrt_bn_pow2", "a n", "m", 2, "bootstrap/selfhost/nrt_float.tx");
    rtLabel(f, "big");
    rtIf(f, L("n"), "lt", I(31), "small");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("a"), I(2147483648));
    rtOp(f, "n", L("n"), "sub", I(31)); rtJump(f, "big");
    rtLabel(f, "small");
    rtSet(f, "m", I(1));
    rtLabel(f, "double");
    rtIf(f, L("n"), "le", I(0), "apply");
    rtOp(f, "m", L("m"), "add", L("m")); rtOp(f, "n", L("n"), "sub", I(1)); rtJump(f, "double");
    rtLabel(f, "apply");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("a"), L("m"));
    rtRetVoid(f); check(f);

    // bn_pow10(a, n): a *= 10^n.
    f = rtBegin(b, "__tx_nrt_bn_pow10", "a n", "m", 2, "bootstrap/selfhost/nrt_float.tx");
    rtLabel(f, "big");
    rtIf(f, L("n"), "lt", I(9), "small");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("a"), I(1000000000));
    rtOp(f, "n", L("n"), "sub", I(9)); rtJump(f, "big");
    rtLabel(f, "small");
    rtSet(f, "m", I(1));
    rtLabel(f, "ten");
    rtIf(f, L("n"), "le", I(0), "apply");
    rtOp(f, "m", L("m"), "imul", I(10)); rtOp(f, "n", L("n"), "sub", I(1)); rtJump(f, "ten");
    rtLabel(f, "apply");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("a"), L("m"));
    rtRetVoid(f); check(f);
}

/// Append one byte at local cursor "w".
function put(f: Ref<RtFn>, x: Ref<RtOp>): void {
    rtStore(f, L("w"), 0, x, 1); rtOp(f, "w", L("w"), "add", I(1));
}

/// "c" = bn_cmp(r + m+, s) using scratch t.
function cmpHigh(f: Ref<RtFn>): void {
    rtCall3(f, "", "__tx_nrt_bn_add", L("t"), L("r"), L("mp"));
    rtCall2(f, "c", "__tx_nrt_bn_cmp", L("t"), L("s"));
}

// single＝false：__tx_nrt_float_str(bits)，bits 为 f64 位模式；single＝真：__tx_nrt_float32_str(bits)，bits 的低 32 位为
// f32 位模式（O4 第二步 toStr(f32)：最短往返按 f32 的相邻值判定，格式同 float）。两者只有位域拆分不同。
function emitFormat(b: Ref<StructuredBuffer>, single: bool): void {
    let name = "__tx_nrt_float_str";
    let fracBits = 52;
    let expMax = 2047;
    if (single) { name = "__tx_nrt_float32_str"; fracBits = 23; expMax = 255; }
    const f = rtBegin(b, name, "bits", "ex fr e mant odd k r s mp mm t c d n out w i x dg0 dg1 dg2 dp", 3, "bootstrap/selfhost/nrt_float.tx");
    rtCall2(f, "out", "__tx_native_mem_alloc", I(400), I(1));
    rtIf(f, L("out"), "eq", I(0), "oom");
    rtSet(f, "w", L("out"));
    rtShift(f, "ex", L("bits"), "shr", fracBits); rtOp(f, "ex", L("ex"), "and", I(expMax));
    if (single) { rtOp(f, "fr", L("bits"), "and", I(8388607)); }
    else { rtShift(f, "fr", L("bits"), "shl", 12); rtShift(f, "fr", L("fr"), "shr", 12); }
    // NaN 一律写 nan、不带符号（D3 v0.36 §7：无效运算产生的 NaN 的符号与载荷由架构决定——x86 缺省带负号、arm64 不带；
    // Go、Rust、Python、Java、JS 都不打印 NaN 的符号）。无穷与有限数照旧按符号位写 "-"。
    rtIf(f, L("ex"), "ne", I(expMax), "signed");
    rtIf(f, L("fr"), "eq", I(0), "signed");
    put(f, I(110)); put(f, I(97)); put(f, I(110)); rtJump(f, "finish");
    rtLabel(f, "signed");
    if (single) {
        rtOp(f, "c", L("bits"), "and", I(2147483648));
        rtIf(f, L("c"), "eq", I(0), "positive");
    } else {
        rtIf(f, L("bits"), "ge", I(0), "positive");
    }
    put(f, I(45));
    rtLabel(f, "positive");
    rtIf(f, L("ex"), "ne", I(expMax), "finite");
    put(f, I(105)); put(f, I(110)); put(f, I(102)); rtJump(f, "finish");
    rtLabel(f, "finite");
    rtIf(f, L("ex"), "ne", I(0), "normal");
    rtIf(f, L("fr"), "ne", I(0), "subnormal");
    put(f, I(48)); rtJump(f, "finish");
    rtLabel(f, "subnormal");
    if (single) { rtSet(f, "mant", L("fr")); rtSet(f, "e", I(-149)); rtJump(f, "setup"); }
    else { rtSet(f, "mant", L("fr")); rtSet(f, "e", I(-1074)); rtJump(f, "setup"); }
    rtLabel(f, "normal");
    if (single) { rtOp(f, "mant", L("fr"), "or", I(8388608)); rtOp(f, "e", L("ex"), "sub", I(150)); }
    else { rtOp(f, "mant", L("fr"), "or", I(4503599627370496)); rtOp(f, "e", L("ex"), "sub", I(1075)); }
    rtLabel(f, "setup");
    rtOp(f, "odd", L("mant"), "and", I(1));
    rtSet(f, "r", A("__tx_nrt_bn"));
    rtOp(f, "s", L("r"), "add", I(BN_BYTES)); rtOp(f, "mp", L("s"), "add", I(BN_BYTES));
    rtOp(f, "mm", L("mp"), "add", I(BN_BYTES)); rtOp(f, "t", L("mm"), "add", I(BN_BYTES));
    rtCall2(f, "", "__tx_nrt_bn_set", L("r"), L("mant"));
    rtCall2(f, "", "__tx_nrt_bn_set", L("mp"), I(1));
    rtCall2(f, "", "__tx_nrt_bn_set", L("mm"), I(1));
    // "Unequal gaps" when the mantissa is the hidden bit alone (above the minimum exponent).
    rtSet(f, "x", I(0));
    rtIf(f, L("fr"), "ne", I(0), "gaps");
    rtIf(f, L("ex"), "le", I(1), "gaps");
    rtSet(f, "x", I(1));
    rtLabel(f, "gaps");
    rtIf(f, L("e"), "lt", I(0), "negexp");
    // e >= 0: r = mant·2^(e+1+x), s = 2·2^x, m+ = 2^(e+x), m- = 2^e.
    rtOp(f, "i", L("e"), "add", I(1)); rtOp(f, "i", L("i"), "add", L("x"));
    rtCall2(f, "", "__tx_nrt_bn_pow2", L("r"), L("i"));
    rtOp(f, "i", L("x"), "add", I(1)); rtCall2(f, "", "__tx_nrt_bn_set", L("s"), I(1)); rtCall2(f, "", "__tx_nrt_bn_pow2", L("s"), L("i"));
    rtOp(f, "i", L("e"), "add", L("x")); rtCall2(f, "", "__tx_nrt_bn_pow2", L("mp"), L("i"));
    rtCall2(f, "", "__tx_nrt_bn_pow2", L("mm"), L("e"));
    rtJump(f, "estimate");
    rtLabel(f, "negexp");
    // e < 0: r = mant·2^(1+x), s = 2^(1+x-e), m+ = 2^x, m- = 1.
    rtOp(f, "i", L("x"), "add", I(1)); rtCall2(f, "", "__tx_nrt_bn_pow2", L("r"), L("i"));
    rtOp(f, "i", L("i"), "sub", L("e")); rtCall2(f, "", "__tx_nrt_bn_set", L("s"), I(1)); rtCall2(f, "", "__tx_nrt_bn_pow2", L("s"), L("i"));
    rtCall2(f, "", "__tx_nrt_bn_pow2", L("mp"), L("x"));
    rtLabel(f, "estimate");
    // k ≈ floor(floor(log2 v) · log10 2) + 1; fixed up exactly below.
    rtSet(f, "i", I(0)); rtSet(f, "c", L("mant"));
    rtLabel(f, "bits");
    rtIf(f, L("c"), "eq", I(0), "counted");
    rtShift(f, "c", L("c"), "shr", 1); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "bits");
    rtLabel(f, "counted");
    rtOp(f, "i", L("i"), "add", L("e")); rtOp(f, "i", L("i"), "sub", I(1));
    rtOp(f, "i", L("i"), "imul", I(78913));
    rtDivMod(f, "k", "c", L("i"), I(262144));
    rtIf(f, L("c"), "ge", I(0), "floor");
    rtOp(f, "k", L("k"), "sub", I(1));
    rtLabel(f, "floor");
    rtOp(f, "k", L("k"), "add", I(1));
    rtIf(f, L("k"), "lt", I(0), "scaleup");
    rtCall2(f, "", "__tx_nrt_bn_pow10", L("s"), L("k")); rtJump(f, "fixhigh");
    rtLabel(f, "scaleup");
    rtOp(f, "i", I(0), "sub", L("k"));
    rtCall2(f, "", "__tx_nrt_bn_pow10", L("r"), L("i")); rtCall2(f, "", "__tx_nrt_bn_pow10", L("mp"), L("i")); rtCall2(f, "", "__tx_nrt_bn_pow10", L("mm"), L("i"));
    // Too small: (r + m+) reaches s (inclusive when the mantissa is even).
    rtLabel(f, "fixhigh");
    cmpHigh(f);
    rtIf(f, L("c"), "gt", I(0), "raise");
    rtIf(f, L("c"), "lt", I(0), "fixlow");
    rtIf(f, L("odd"), "ne", I(0), "fixlow");
    rtLabel(f, "raise");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("s"), I(10)); rtOp(f, "k", L("k"), "add", I(1)); rtJump(f, "fixhigh");
    // Too large: 10·(r + m+) still below s.
    rtLabel(f, "fixlow");
    cmpHigh(f);
    rtCall2(f, "", "__tx_nrt_bn_mul", L("t"), I(10));
    rtCall2(f, "c", "__tx_nrt_bn_cmp", L("t"), L("s"));
    rtIf(f, L("c"), "gt", I(0), "digits");
    rtIf(f, L("c"), "lt", I(0), "lower");
    rtIf(f, L("odd"), "eq", I(0), "digits");
    rtLabel(f, "lower");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("r"), I(10)); rtCall2(f, "", "__tx_nrt_bn_mul", L("mp"), I(10)); rtCall2(f, "", "__tx_nrt_bn_mul", L("mm"), I(10));
    rtOp(f, "k", L("k"), "sub", I(1)); rtJump(f, "fixlow");
    // Digit generation.
    rtLabel(f, "digits");
    rtAddrOf(f, "dp", "dg0"); rtSet(f, "n", I(0));
    rtLabel(f, "next");
    rtCall2(f, "", "__tx_nrt_bn_mul", L("r"), I(10)); rtCall2(f, "", "__tx_nrt_bn_mul", L("mp"), I(10)); rtCall2(f, "", "__tx_nrt_bn_mul", L("mm"), I(10));
    rtSet(f, "d", I(0));
    rtLabel(f, "quot");
    rtCall2(f, "c", "__tx_nrt_bn_cmp", L("r"), L("s"));
    rtIf(f, L("c"), "lt", I(0), "quotdone");
    rtCall2(f, "", "__tx_nrt_bn_sub", L("r"), L("s")); rtOp(f, "d", L("d"), "add", I(1)); rtJump(f, "quot");
    rtLabel(f, "quotdone");
    // tc1: r < m- (<= when even); tc2: r + m+ > s (>= when even). x = tc1, i = tc2.
    rtCall2(f, "c", "__tx_nrt_bn_cmp", L("r"), L("mm"));
    rtSet(f, "x", I(1));
    rtIf(f, L("c"), "lt", I(0), "tc2");
    rtIf(f, L("c"), "gt", I(0), "notc1");
    rtIf(f, L("odd"), "eq", I(0), "tc2");
    rtLabel(f, "notc1"); rtSet(f, "x", I(0));
    rtLabel(f, "tc2");
    cmpHigh(f);
    rtSet(f, "i", I(1));
    rtIf(f, L("c"), "gt", I(0), "decide");
    rtIf(f, L("c"), "lt", I(0), "notc2");
    rtIf(f, L("odd"), "eq", I(0), "decide");
    rtLabel(f, "notc2"); rtSet(f, "i", I(0));
    rtLabel(f, "decide");
    rtIf(f, L("x"), "ne", I(0), "low");
    rtIf(f, L("i"), "ne", I(0), "up");
    rtOp(f, "c", L("dp"), "add", L("n")); rtOp(f, "d", L("d"), "add", I(48)); rtStore(f, L("c"), 0, L("d"), 1);
    rtOp(f, "n", L("n"), "add", I(1)); rtJump(f, "next");
    rtLabel(f, "low");
    rtIf(f, L("i"), "eq", I(0), "last");
    // Both ends reachable: nearest wins; an exact half rounds to even.
    rtCall3(f, "", "__tx_nrt_bn_add", L("t"), L("r"), L("r"));
    rtCall2(f, "c", "__tx_nrt_bn_cmp", L("t"), L("s"));
    rtIf(f, L("c"), "lt", I(0), "last");
    rtIf(f, L("c"), "gt", I(0), "up");
    rtOp(f, "c", L("d"), "and", I(1)); rtIf(f, L("c"), "eq", I(0), "last");
    rtLabel(f, "up"); rtOp(f, "d", L("d"), "add", I(1));
    rtLabel(f, "last");
    rtOp(f, "c", L("dp"), "add", L("n")); rtOp(f, "d", L("d"), "add", I(48)); rtStore(f, L("c"), 0, L("d"), 1);
    rtOp(f, "n", L("n"), "add", I(1));
    // Plain decimal layout of 0.D × 10^k.
    rtIf(f, L("k"), "gt", I(0), "intpart");
    put(f, I(48)); put(f, I(46));
    rtSet(f, "i", L("k"));
    rtLabel(f, "lead");
    rtIf(f, L("i"), "ge", I(0), "frac0");
    put(f, I(48)); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "lead");
    rtLabel(f, "frac0");
    rtSet(f, "i", I(0)); rtJump(f, "tail");
    rtLabel(f, "intpart");
    rtSet(f, "i", I(0));
    rtLabel(f, "whole");
    rtIf(f, L("i"), "ge", L("k"), "point");
    rtIf(f, L("i"), "ge", L("n"), "zero");
    rtOp(f, "c", L("dp"), "add", L("i")); rtLoad(f, "c", L("c"), 0, 1); put(f, L("c")); rtJump(f, "wnext");
    rtLabel(f, "zero"); put(f, I(48));
    rtLabel(f, "wnext"); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "whole");
    rtLabel(f, "point");
    rtIf(f, L("i"), "ge", L("n"), "finish");
    put(f, I(46));
    rtLabel(f, "tail");
    rtIf(f, L("i"), "ge", L("n"), "finish");
    rtOp(f, "c", L("dp"), "add", L("i")); rtLoad(f, "c", L("c"), 0, 1); put(f, L("c"));
    rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "tail");
    rtLabel(f, "finish");
    rtOp(f, "n", L("w"), "sub", L("out"));
    rtCall3(f, "c", "__tx_store_new_str_take", L("out"), L("n"), I(0));
    rtRet(f, L("c"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRetVoid(f); check(f);
}

export function emitNrtFloat(b: Ref<StructuredBuffer>): void {
    emitBigInts(b);
    emitFormat(b, false);
    emitFormat(b, true);
}
