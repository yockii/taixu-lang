// ============================================================================
// std/bytes —— 字节缓冲与字符串构建（V0.38-S1；STD-06——Go bytes/strings.
// Builder 心智）。
//
// Builder：累积拼接分段持有＋一次性 join（string + 链的 O(n²) 反模式根治）。
// hex 编解码（Go encoding/hex 对位）：**文本十六进制域（ASCII）**——语言面
// string 恒良构 UTF-8（D3 §一），任意字节序列（≥0x80 单字节）无字面构造
// 通道；hexDecode 对 ≥0x80 结构化 Error（byte-string 构造器 v0.39+ 评估位
// ——如实登记）。hexEncode 为字节面（UTF-8 编码字节逐位十六进制）。
// ============================================================================

struct Builder {
    parts: List<string>,
}

// newBuilder：构造。
export function newBuilder(): Ref<Builder> {
    return new Builder { parts: listNew() };
}

// writeString：追加串。
export function writeString(b: Ref<Builder>, s: string): void {
    listPush(b.parts, s);
}

// writeInt：追加整数（toStr 面）。
export function writeInt(b: Ref<Builder>, v: int): void {
    listPush(b.parts, toStr(v));
}

// writeByte：追加单字节（0..127 原样；128..255 经码点编码即 UTF-8 序列——
// 与 writeString 同语义，如实注记）。
export function writeByte(b: Ref<Builder>, v: int): void {
    if (v < 0 || v > 255) {
        return;
    }
    listPush(b.parts, utf8Encode(v) catch "");
}

// writeLn：追加串＋换行（log 心智）。
export function writeLn(b: Ref<Builder>, s: string): void {
    listPush(b.parts, s + "\n");
}

// builderLen：累计字节长度（O(parts) 求和——无缓存字段面，如实注记）。
export function builderLen(b: Ref<Builder>): int {
    let n: int = 0;
    let i: int = 0;
    while (i < listLen(b.parts)) {
        n = n + len(listGet(b.parts, i) catch "");
        i = i + 1;
    }
    return n;
}

// build：一次性 join。
export function build(b: Ref<Builder>): string {
    let out: string = "";
    let i: int = 0;
    while (i < listLen(b.parts)) {
        out = out + (listGet(b.parts, i) catch "");
        i = i + 1;
    }
    return out;
}

// reset：清空（复用面）。
export function reset(b: Ref<Builder>): void {
    b.parts = listNew();
}

// —— hex（文本十六进制域；小写；decode 非法输入 Error）——

const HEX: string = "0123456789abcdef";

// hexEncode：字节面 → 小写十六进制（UTF-8 编码字节逐位——ASCII 输入恒
// 2× 长度）。
export function hexEncode(s: string): string {
    let out: string = "";
    let i: int = 0;
    while (i < len(s)) {
        const b = byteAt(s, i) catch 0;
        out = out + (utf8Encode(byteAt(HEX, b / 16) catch 48) catch "");
        out = out + (utf8Encode(byteAt(HEX, b % 16) catch 48) catch "");
        i = i + 1;
    }
    return out;
}

// hexDecode：偶长十六进制 → 串；奇长/非法字符/≥0x80 字节 Error（UTF-8
// 良构红线——见头注）。
export function hexDecode(s: string): string | Error {
    const n = len(s);
    if (n % 2 != 0) {
        return err("odd length");
    }
    let out: string = "";
    let i: int = 0;
    while (i < n) {
        const hi = hexVal(byteAt(s, i) catch -1);
        const lo = hexVal(byteAt(s, i + 1) catch -1);
        if (hi < 0 || lo < 0) {
            return err("bad hex");
        }
        const b = hi * 16 + lo;
        if (b >= 128) {
            return err("non-ascii byte（UTF-8 良构红线）");
        }
        out = out + (utf8Encode(b) catch "");
        i = i + 2;
    }
    return out;
}

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    if (b >= 65 && b <= 70) {
        return b - 55;
    }
    return -1;
}
