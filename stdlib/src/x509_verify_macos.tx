// Security.framework 服务证书策略；不改变钥匙串或系统信任设置。
import { x509CheckServerInputs } from "./x509_verify_common";

declare type CFObject;
declare struct CFOut { value: CFObject }
declare function CFDataCreate(allocator: usize, bytes: Bytes, length: isize): CFObject? from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFArrayCreateMutable(allocator: usize, capacity: isize, callbacks: usize): CFObject? from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFArrayAppendValue(array: CFObject, value: CFObject): void from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFStringCreateWithCString(allocator: usize, string: string, encoding: u32): CFObject? from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFDateCreate(allocator: usize, time: float): CFObject? from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFErrorGetCode(error: CFObject): isize from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFRelease(value: CFObject): void from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function SecCertificateCreateWithData(allocator: usize, data: CFObject): CFObject? from "/System/Library/Frameworks/Security.framework/Security";
declare function SecPolicyCreateSSL(server: u8, hostname: CFObject): CFObject? from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustCreateWithCertificates(certificates: CFObject, policies: CFObject, output: Ref<CFOut>): i32 from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustSetAnchorCertificates(trust: CFObject, anchors: CFObject): i32 from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustSetAnchorCertificatesOnly(trust: CFObject, only: u8): i32 from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustSetVerifyDate(trust: CFObject, date: CFObject): i32 from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustSetNetworkFetchAllowed(trust: CFObject, allowed: u8): i32 from "/System/Library/Frameworks/Security.framework/Security";
declare function SecTrustEvaluateWithError(trust: CFObject, error: Ref<CFOut>): u8 from "/System/Library/Frameworks/Security.framework/Security";

function owned(value: CFObject?, operation: string): CFObject | Error {
    if (value == None) { return err("x509: macOS " + operation + " failed"); } return value;
}
function checked(status: i32, operation: string): void | Error {
    if (status != 0 as i32) { return err("x509: macOS " + operation + " failed " + toStr(status)); } return done();
}
function certificate(der: Bytes): CFObject | Error {
    const data = owned(CFDataCreate(0 as usize, der, bytesLen(der) as isize), "CFDataCreate")?; defer { CFRelease(data); }
    return owned(SecCertificateCreateWithData(0 as usize, data), "SecCertificateCreateWithData");
}

// 空 roots 使用系统信任；非空只信任传入锚。所有路径候选在验证结束后释放。
export function x509VerifyServer(chain: List<Bytes>, hostname: string, nowSecs: int, roots: List<Bytes>): void | Error {
    x509CheckServerInputs(chain, hostname, roots)?;
    if (nowSecs < -62135596800 || nowSecs > 253402300799) { return err("x509: time outside calendar range"); }
    const objects: List<CFObject> = listNew(); defer { for (object in objects) { CFRelease(object); } }
    const certificates = owned(CFArrayCreateMutable(0 as usize, 0 as isize, 0 as usize), "CFArrayCreateMutable")?; defer { CFRelease(certificates); }
    const anchors = owned(CFArrayCreateMutable(0 as usize, 0 as isize, 0 as usize), "CFArrayCreateMutable anchors")?; defer { CFRelease(anchors); }
    for (der in chain) { const cert = certificate(der)?; listPush(objects, cert); CFArrayAppendValue(certificates, cert); }
    for (der in roots) { const cert = certificate(der)?; listPush(objects, cert); CFArrayAppendValue(anchors, cert); }
    let host = hostname;
    if (len(host) > 0 && byteAt(host, len(host) - 1) == 46) { host = strSlice(host, 0, len(host) - 1); }
    const name = owned(CFStringCreateWithCString(0 as usize, host, 134217984 as u32), "CFStringCreateWithCString")?; defer { CFRelease(name); }
    const policy = owned(SecPolicyCreateSSL(1 as u8, name), "SecPolicyCreateSSL")?; defer { CFRelease(policy); }
    const output = new CFOut { value: handleFromBits<CFObject>(0) };
    checked(SecTrustCreateWithCertificates(certificates, policy, output), "SecTrustCreateWithCertificates")?;
    defer { CFRelease(output.value); }
    if (listLen(roots) > 0) {
        checked(SecTrustSetAnchorCertificates(output.value, anchors), "SecTrustSetAnchorCertificates")?;
        checked(SecTrustSetAnchorCertificatesOnly(output.value, 1 as u8), "SecTrustSetAnchorCertificatesOnly")?;
    }
    const date = owned(CFDateCreate(0 as usize, (nowSecs - 978307200) as float), "CFDateCreate")?; defer { CFRelease(date); }
    checked(SecTrustSetVerifyDate(output.value, date), "SecTrustSetVerifyDate")?;
    // 禁止隐式联网补中间证书；输入链必须足够，系统已有的缓存仍由系统策略核验。
    checked(SecTrustSetNetworkFetchAllowed(output.value, 0 as u8), "SecTrustSetNetworkFetchAllowed")?;
    const error = new CFOut { value: handleFromBits<CFObject>(0) };
    const accepted = SecTrustEvaluateWithError(output.value, error);
    defer { if (handleBits(error.value) != 0) { CFRelease(error.value); } }
    if (accepted == 0 as u8) {
        let code = 0; if (handleBits(error.value) != 0) { code = CFErrorGetCode(error.value) as int; }
        return err("x509: macOS SSL policy rejected certificate " + toStr(code));
    }
    return done();
}

function done(): void {}
