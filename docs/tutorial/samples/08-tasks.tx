// 08 异步与任务：async/await、调用即排队、main 里直接 await、TaskGroup 并发上限。
// 用到 std/task：发布包里的标准库与 taixu 同目录，自动发现。
import { taskGroupNew, taskGroupAdd, taskGroupDrain } from "std/task";

async function fetchScore(id: int): int {
    return id * 10; // 声明写成功侧 T；调用方得 Future<int>
}

async function joinAll(): int {
    const a = fetchScore(1); // 调用即排队（惰性入队）
    const b = fetchScore(2); // 与 a 并发
    const va = (await a)?; // await 产出 T | Error；? 原样传播
    const vb = await b catch -1;
    print("joined:" + toStr(va + vb));
    return va + vb;
}

// TaskGroup：显式并发上限的批处理（库层，不进语言核心）
async function batch(): int {
    const tg = taskGroupNew<int>(); // 无参，须写结果类型
    taskGroupAdd(tg, fetchScore(3));
    taskGroupAdd(tg, fetchScore(4));
    taskGroupAdd(tg, fetchScore(5));
    const rs = taskGroupDrain(tg, 2); // limit=2：就绪补位→裁决→收割→补位
    const xs = (await rs catch err("drain failed"))?;
    for (v in xs) {
        print("done:" + toStr(v));
    }
    return 0;
}

function main(args: []string): int {
    const j = joinAll(); // 调用即排队，此时还没有执行
    const g = batch();
    print("main-done"); // 先打印：任务要等有人 await 才运行
    const jr = await j; // main 体内可直接 await：未完成时就地按 FIFO 跑调度泵
    const gr = await g;
    return 0; // 返回即取消仍未完成的任务——要等的都 await 了
}
