// D3 v0.48 外部内存区：按布局读越过区尾（区按 PT 建、按 MINMAXINFO 读），trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

declare struct PT { x: i32, y: i32 }
declare struct MINMAXINFO { reserved: PT, maxSize: PT, maxPosition: PT, minTrackSize: PT, maxTrackSize: PT }

function main(args: []string): int {
    const m = ffiMemOf<PT>(pageAlloc(), false) catch (e) { print(e.message); return 1; };
    print("pt " + toStr(ffiMemGet<PT>(m, 0).x));
    print("never " + toStr(ffiMemGet<MINMAXINFO>(m, 0).reserved.x));
    return 0;
}
