// bench/algo/string-build-find —— 字符串构建与查找（拼接链 5,000 段＋
// byteAt 朴素匹配扫描）。校验和＝命中总数×977＋干草堆长度 mod 1000003。
// （匹配循环自带游标推进——确定性；byteAt/len 为自举层内建。）
export function main(args: []string): int {
    const parts: List<string> = listNew();
    let i: int = 0;
    while (i < 5000) {
        listPush(parts, "item-" + toStr(i % 977) + ";");
        i = i + 1;
    }
    let hay: string = "";
    i = 0;
    while (i < listLen(parts)) {
        hay = hay + (listGet(parts, i) catch "");
        i = i + 1;
    }
    const n: int = len(hay);
    const m: int = len("item-7;");
    let hits: int = 0;
    let at: int = 0;
    while (at <= n - m) {
        let j: int = 0;
        let ok = true;
        while (j < m) {
            if ((byteAt(hay, at + j) catch -1) != (byteAt("item-7;", j) catch -2)) {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if (ok) {
            hits = hits + 1;
            at = at + m;
        } else {
            at = at + 1;
        }
    }
    print(toStr((hits * 977 + n) % 1000003));
    return 0;
}
