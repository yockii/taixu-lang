export function main(args: []string): int {
    const pi: float = 3.5;
    const e: float = 1e2;
    const sum: float = pi + e;
    print("f=" + toStr(sum));
    print("i=" + toStr(sum as int) + "," + toStr(7 as float / 2.0) + "," + toStr(2.9 as int));
    print("cmp=" + toStr(1.5 < 2.0) + toStr(2.0 <= 2.0));
    return 0;
}
