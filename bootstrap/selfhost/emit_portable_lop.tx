// 可移植渲染器的大操作（记录 lop；macOS 适配 M4 设计 A9 修订），逐条对照 emitmirror renderLop2 的原生形态。内联快路径与定宽
// 运算族在 emit_portable_inline.tx。大多数大操作是“窗口、函数号、pc、槽号…”形的内核调用；其余是标签守卫＋快路径＋慢路径。
import { PCtx, pAt, pField, pRej, pcLbl, epiLbl, tagOff, payOff, ldPay, ldPay32, ldTag, ldTagQ, stPay, stPayI, stTag, stTagQ, stTagQI, stNone, stNoneQ, guardTag, notHeapBr, releaseOld, retainAt, releaseAt, retainSlotOff, argsOf1, argsOf2, argsOf3, kcall, ints1, ints2, ints3, ints4, trap, callbiGeneric, tbInto, sblRedirect } from "./emit_portable_core";
import { pCallbiInline, pFwop } from "./emit_portable_inline";
import { retSlotsOk } from "../emitmirror";
import { G_W, G_K0, G_K1, G_T0, G_T1, G_T2, G_T3, G_SP, GArg, genAt, genLabel, genJmp, genMov, genMovI, genLd, genSt, genStI, genLea, genLdSym, genOp, genOpI, genOpO, genNegO, genNot, genDivRem, genBr, genBrI, genBrSp, genSet, genSetI, genFop, genFSet, genCall, genCallR, genRes, genRes32, gaI, gaR, gaLd, gaLea } from "./gen_ops";
import { VALUE_BYTES, RT_ENTRY_BYTES, RT_STATE_OFFSET } from "./value_abi";
import { TB_STACK_LIMIT, TB_NATIVE_STACK_LIMIT, TB_STR_OBJS, TB_TASK_SUSP } from "./thread_block_abi";

export function pLop(c: Ref<PCtx>, rec: List<string>): void {
    const pc = pField(rec, 1, 0);
    const form = listGet(rec, 2) catch "";
    const g = c.g;
    genAt(g, pc);
    const lbl = pcLbl(c, pc);
    const f3 = pField(rec, 3, 0);
    const f4 = pField(rec, 4, 0);
    const f5 = pField(rec, 5, 0);
    if (form == "loadk_fnv") {
        if (f5 == 0) { releaseOld(c, f3, lbl + "nr"); }
        stTag(c, f3, 12);
        genStI(g, 4, G_W, payOff(f3), f4);
        return;
    }
    if (form == "dfree") {
        // 调用前释放实参之后的死临时：标签 0..4 先放过，真放了一份计数才清成 None（泄漏检查设计 §六-7）。
        const dl = lbl + "df" + toStr(f3);
        ldTag(c, G_T0, f3);
        genBrI(g, "ule", G_T0, 4, dl);
        notHeapBr(c, G_T0, dl);
        genCall(g, "__tx_release", argsOf1(gaLea(G_W, tagOff(f3))));
        stNone(c, f3);
        genLabel(g, dl);
        return;
    }
    if (form == "ldnone") {
        if (f4 == 0) { releaseOld(c, f3, lbl + "nr"); }
        stNone(c, f3);
        return;
    }
    if (form == "ldbool") {
        if (f5 == 0) { releaseOld(c, f3, lbl + "nr"); }
        stTag(c, f3, 3);
        stPayI(c, f3, f4);
        return;
    }
    if (form == "band" || form == "bor" || form == "bxor" || form == "imul" || form == "shl" || form == "shr" || form == "sar") { bitOp(c, pc, rec, form); return; }
    if (form == "bnot") {
        ldTag(c, G_T0, f4);
        genBrI(g, "ne", G_T0, 1, lbl + "nb");
        ldPay(c, G_T0, f4);
        genNot(g, G_K1, G_T0);
        storeInt(c, f3, lbl + "inl");
        genJmp(g, lbl + "end");
        genLabel(g, lbl + "nb");
        trap(c, pc, 4010, f5, pField(rec, 6, 0));
        genLabel(g, lbl + "end");
        return;
    }
    if (form == "loadk_str") {
        if (f5 == 0) { releaseOld(c, f3, lbl + "nr"); }
        tbInto(c, G_T0);
        genLd(g, 8, G_T0, G_T0, TB_STR_OBJS);
        genLd(g, 4, G_T1, G_T0, f4 * 4);
        stTag(c, f3, 6);
        genSt(g, 4, G_W, payOff(f3), G_T1);
        return;
    }
    if (form == "callbi") {
        if (!pCallbiInline(c, pc, rec, f3, f4, f5)) { callbiGeneric(c, pc, f3, f4, f5); }
        return;
    }
    if (form == "call_indirect") { callIndirect(c, pc, rec); return; }
    if (form == "call_direct" || form == "call_direct_b") { callDirect(c, pc, rec, form == "call_direct_b"); return; }
    if (form == "bclear") {
        let j = 1;
        while (j <= f4 && j <= 60) {
            if (((f5 >>> (j - 1)) & 1) == 1) { stNoneQ(c, f3 + j); }
            j = j + 1;
        }
        return;
    }
    if (form == "movet" || form == "moveb") {
        let suffix = "tr";
        if (form == "moveb") { suffix = "br"; }
        releaseOld(c, f3, lbl + suffix);
        ldTagQ(c, G_T0, f4);
        ldPay(c, G_T1, f4);
        stTagQ(c, f3, G_T0);
        stPay(c, f3, G_T1);
        if (form == "movet") { stTag(c, f4, 0); }
        return;
    }
    if (form == "retx") { retx(c, pc, rec); return; }
    if (form == "ret_b" || form == "reterr_b") {
        const ra = f3;
        let rcount = c.regCount;
        let np = f4;
        if (form == "ret_b") { rcount = f4; np = f5; }
        if (!retSlotsOk(ra, rcount, np + 1, c.regCount)) { pRej(c, pc, "E009", "lop_" + form + "_slots"); return; }
        if (ra >= 1 && ra <= np) { retainSlotOff(c, tagOff(ra), lbl + "rk"); }
        genLd(g, 4, G_K1, G_W, tagOff(ra));
        ldPay(c, G_K0, ra);
        kcallW(c, "__tx_frame_release_from", ints3(rcount, ra, np + 1));
        retTail(c);
        return;
    }
    if (form == "moverc") {
        retainSlotOff(c, tagOff(f4), lbl + "sr");
        releaseOld(c, f3, lbl + "dr");
        ldTagQ(c, G_T0, f4);
        ldPay(c, G_T1, f4);
        stTagQ(c, f3, G_T0);
        stPay(c, f3, G_T1);
        return;
    }
    if (form == "moverl") {
        ldPay(c, G_K1, f4);
        releaseOld(c, f3, lbl + "mnr");
        stPay(c, f3, G_K1);
        stTag(c, f3, f5);
        return;
    }
    if (form == "jcc") {
        ldPay(c, G_T0, f3);
        let cc = "eq";
        if (f4 == 1) { cc = "ne"; }
        genBrI(g, cc, G_T0, 0, branchTarget(c, pc, f5));
        return;
    }
    if (form == "move") {
        ldPay(c, G_T0, f4);
        stPay(c, f3, G_T0);
        stTag(c, f3, f5);
        return;
    }
    if (form == "loadk_int") {
        if (f5 == 0) { releaseOld(c, f3, lbl + "nr"); }
        stTag(c, f3, 1);
        genMovI(g, G_T0, f4);
        stPay(c, f3, G_T0);
        return;
    }
    if (form == "loadk_float") {
        if (pField(rec, 6, 0) == 0) { releaseOld(c, f3, lbl + "nr"); }
        stTag(c, f3, 2);
        genStI(g, 4, G_W, payOff(f3), f4);
        genStI(g, 4, G_W, payOff(f3) + 4, f5);
        return;
    }
    if (form == "jmp") { genJmp(g, pcLbl(c, f3)); return; }
    if (form == "neg") { kcall(c, "__tx_neg", pc, ints2(f3, f4)); return; }
    if (form == "reterr") {
        if (!retSlotsOk(f3, c.regCount, 0, c.regCount)) { pRej(c, pc, "E009", "lop_reterr_slots"); return; }
        genLd(g, 4, G_K1, G_W, tagOff(f3));
        ldPay(c, G_K0, f3);
        kcallW(c, "__tx_frame_release", ints2(c.regCount, f3));
        retTail(c);
        return;
    }
    if (form == "jcc_u") {
        ldTag(c, G_T0, f3);
        genBrI(g, "ne", G_T0, 3, lbl + "nb");
        ldPay(c, G_T0, f3);
        let cc = "eq";
        if (f4 == 1) { cc = "ne"; }
        genBrI(g, cc, G_T0, 0, branchTarget(c, pc, f5));
        genJmp(g, lbl + "end");
        genLabel(g, lbl + "nb");
        trap(c, pc, 4010, pField(rec, 6, 0), pField(rec, 7, 0));
        genLabel(g, lbl + "end");
        return;
    }
    if (form == "switch_op") {
        kcall(c, "__tx_switch_tag", pc, ints2(f3, f4));
        genRes32(g, G_T0);
        let ti = 0;
        while (ti < f5) {
            genBrI(g, "eq", G_T0, ti, pcLbl(c, pField(rec, 6 + ti, 0)));
            ti = ti + 1;
        }
        return;
    }
    if (form == "newstruct" || form == "newenum" || form == "newref") {
        let sym = "__tx_newstruct";
        if (form == "newenum") { sym = "__tx_newenum"; }
        if (form == "newref") { sym = "__tx_newref"; }
        const site = pField(rec, 5, -1);
        if (site >= 0) {
            const bu = pAt(c.escBuf, site);
            if (pField(rec, 6, 0) == 1) {
                // 标量逃逸点：对象只住帧上，字段清零，槽里放 None。
                releaseOld(c, f3, lbl + "escr");
                let fi = 0;
                while (fi < pAt(c.escUnits, site)) { genStI(g, 8, G_SP, bu + fi * 8, 0); fi = fi + 1; }
                stNone(c, f3);
                return;
            }
            const args = winArgs(c, pc);
            listPush(args, gaI(f3)); listPush(args, gaI(f4)); listPush(args, gaLea(G_SP, bu));
            genCall(g, sym + "_fr", args);
            return;
        }
        kcall(c, sym, pc, ints2(f3, f4));
        return;
    }
    if (form == "getidx") { kcall(c, "__tx_getidx", pc, ints3(f3, f4, f5)); return; }
    if (form == "setidx") { kcall(c, "__tx_setidx", pc, ints3(f4, f5, f3)); return; }
    if (form == "newarr" || form == "newslice") {
        if (form == "newarr" && f5 >= 0) {
            const args = winArgs(c, pc);
            listPush(args, gaI(f3)); listPush(args, gaI(f4)); listPush(args, gaLea(G_SP, pAt(c.escBuf, f5)));
            genCall(g, "__tx_newarr_fr", args);
            return;
        }
        let sliceFlag = 0;
        if (form == "newslice") { sliceFlag = 1; }
        kcall(c, "__tx_newarrsl", pc, ints3(f3, f4, sliceFlag));
        return;
    }
    if (form == "i2f") { kcall(c, "__tx_i2f", pc, ints2(f3, f4)); return; }
    if (form == "f2i") { kcall(c, "__tx_f2i", pc, ints2(f3, f4)); return; }
    if (form == "cvt") { kcall(c, "__tx_cvt" + (listGet(rec, 5) catch "0"), pc, ints2(f3, f4)); return; }
    if (form == "fwop") { pFwop(c, pc, rec); return; }
    if (form == "not") {
        ldTag(c, G_T0, f4);
        genBrI(g, "ne", G_T0, 3, lbl + "nb");
        genLd(g, 1, G_T0, G_W, payOff(f4));
        genOpI(g, "xor", G_K1, G_T0, 1);
        releaseOld(c, f3, lbl + "inl");
        stPay(c, f3, G_K1);
        stTag(c, f3, 3);
        genJmp(g, lbl + "end");
        genLabel(g, lbl + "nb");
        trap(c, pc, 4010, f5, pField(rec, 6, 0));
        genLabel(g, lbl + "end");
        return;
    }
    if (form == "iserr" || form == "isnone") {
        let tt = 4;
        if (form == "iserr") { tt = 5; }
        ldTag(c, G_T0, f4);
        genSetI(g, "eq", G_K1, G_T0, tt);
        releaseOld(c, f3, lbl + "inl");
        stPay(c, f3, G_K1);
        stTag(c, f3, 3);
        return;
    }
    if (form == "div" || form == "mod") { divMod(c, pc, rec, form == "div"); return; }
    if (form == "add" || form == "sub" || form == "mul") { arith(c, pc, rec, form); return; }
    if (form == "lt" || form == "le" || form == "eq") { compare(c, pc, rec, form); return; }
    if (form == "clone") { kcall(c, "__tx_clone", pc, ints2(f3, f4)); return; }
    if (form == "getfld" || form == "setfld" || form == "getfldb") { field(c, pc, rec, form); return; }
    if (form == "ret") {
        if (!retSlotsOk(f3, f4, 0, c.regCount)) { pRej(c, pc, "E009", "lop_ret_slots"); return; }
        genLd(g, 4, G_K1, G_W, tagOff(f3));
        ldPay(c, G_K0, f3);
        kcallW(c, "__tx_frame_release", ints2(f4, f3));
        retTail(c);
        return;
    }
    if (form == "async_start") { kcallW(c, "__tx_task_spawn", ints4(f3, f4, c.fnIdx, pc)); return; }
    if (form == "await") {
        kcallW(c, "__tx_task_await", ints3(f3, c.fnIdx, pc));
        genRes32(g, G_T0);
        genBrI(g, "ne", G_T0, 0, epiLbl(c));
        return;
    }
    if (form == "gen_new" || form == "gen_next") { kcallW(c, "__tx_" + form, ints4(f3, f4, c.fnIdx, pc)); return; }
    if (form == "yield" || form == "gen_close") {
        let sym = "__tx_gen_close";
        if (form == "yield") { sym = "__tx_gen_yield"; }
        kcallW(c, sym, ints3(f3, c.fnIdx, pc));
        if (form == "yield") {
            genRes32(g, G_T0);
            genBrI(g, "ne", G_T0, 0, epiLbl(c));
        }
        return;
    }
    if (form == "susp_check") {
        tbInto(c, G_T0);
        genLd(g, 8, G_T0, G_T0, TB_TASK_SUSP);
        genBrI(g, "ne", G_T0, 0, epiLbl(c));
        return;
    }
    pRej(c, pc, "E009", "lop_" + form);
}

// —— 小助手 ——
function winArgs(c: Ref<PCtx>, pc: int): List<Ref<GArg>> {
    const args: List<Ref<GArg>> = listNew();
    listPush(args, gaR(G_W)); listPush(args, gaI(c.fnIdx)); listPush(args, gaI(pc));
    return args;
}
// (窗口, 整数…)：不带函数号与 pc 的内核调用（帧释放、任务、生成器）。
function kcallW(c: Ref<PCtx>, sym: string, xs: List<int>): void {
    const args: List<Ref<GArg>> = listNew();
    listPush(args, gaR(G_W));
    let i = 0;
    while (i < listLen(xs)) { listPush(args, gaI(pAt(xs, i))); i = i + 1; }
    genCall(c.g, sym, args);
}
function branchTarget(c: Ref<PCtx>, pc: int, target: int): string {
    const redir = sblRedirect(c, pc, target);
    if (len(redir) > 0) { return redir; }
    return pcLbl(c, target);
}
// 返回值（K1 标签的低 32 位、K0 载荷）写进窗口槽 0，转函数尾。
function retTail(c: Ref<PCtx>): void {
    genSt(c.g, 4, G_W, 0, G_K1);
    genSt(c.g, 8, G_W, 8, G_K0);
    genJmp(c.g, epiLbl(c));
}
// K1 里的整数写进槽 a（先释放旧值）。
function storeInt(c: Ref<PCtx>, a: int, suffix: string): void {
    releaseOld(c, a, suffix);
    stPay(c, a, G_K1);
    stTag(c, a, 1);
}

// 位运算族：两侧 int 时内联（移位计数 0..63，越界 trap 4016），否则 __tx_arith_slow。
function bitOp(c: Ref<PCtx>, pc: int, rec: List<string>, form: string): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const a = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    const nc = pField(rec, 5, 0);
    const isShift = form == "shl" || form == "shr" || form == "sar";
    let op = "and";
    let opEnum = 40;
    if (form == "bor") { op = "or"; opEnum = 41; }
    if (form == "bxor") { op = "xor"; opEnum = 42; }
    if (form == "shl") { op = "shl"; opEnum = 44; }
    if (form == "shr") { op = "shr"; opEnum = 45; }
    if (form == "sar") { op = "sar"; opEnum = 46; }
    if (form == "imul") { op = "mul"; opEnum = 47; }
    ldTag(c, G_T0, nb);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldTag(c, G_T0, nc);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldPay(c, G_T1, nc);
    if (isShift) { genBrI(g, "ugt", G_T1, 63, lbl + "sht"); }
    ldPay(c, G_T0, nb);
    genOp(g, op, G_K1, G_T0, G_T1);
    storeInt(c, a, lbl + "inl");
    genJmp(g, lbl + "end");
    if (isShift) {
        genLabel(g, lbl + "sht");
        trap(c, pc, 4016, pField(rec, 6, 0), pField(rec, 7, 0));
    }
    genLabel(g, lbl + "slow");
    kcall(c, "__tx_arith_slow", pc, ints4(opEnum, a, nb, nc));
    genLabel(g, lbl + "end");
}

function divMod(c: Ref<PCtx>, pc: int, rec: List<string>, isDiv: bool): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const na = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    const nc = pField(rec, 5, 0);
    const t1 = pField(rec, 6, 0);
    const t2 = pField(rec, 7, 0);
    const zm = pField(rec, 9, 0);
    const zl = pField(rec, 10, 0);
    const om = pField(rec, 11, 0);
    const ol = pField(rec, 12, 0);
    let slow = lbl + "slow2";
    if (isDiv) { slow = lbl + "slow"; }
    const typed = t1 == 1 && t2 == 1;
    if (!typed) {
        ldTag(c, G_T0, nb);
        genBrI(g, "ne", G_T0, 1, slow);
        ldTag(c, G_T0, nc);
        genBrI(g, "ne", G_T0, 1, slow);
    }
    ldPay(c, G_T1, nc);
    genBrI(g, "eq", G_T1, 0, lbl + "dz");
    ldPay(c, G_T0, nb);
    genBrI(g, "ne", G_T1, -1, lbl + "idiv");
    if (isDiv) {
        genNegO(g, G_T0, G_T0, lbl + "of");
        genJmp(g, lbl + "have");
        genLabel(g, lbl + "of");
        trap(c, pc, 4004, om, ol);
    } else {
        genMovI(g, G_T0, 0);
        genJmp(g, lbl + "have");
    }
    genLabel(g, lbl + "idiv");
    if (isDiv) { genDivRem(g, true, G_T0, -1, G_T0, G_T1); } else { genDivRem(g, true, -1, G_T0, G_T0, G_T1); }
    genLabel(g, lbl + "have");
    genMov(g, G_K1, G_T0);
    storeInt(c, na, lbl + "inl");
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "dz");
    trap(c, pc, 4001, zm, zl);
    if (!typed) {
        if (isDiv) {
            genLabel(g, lbl + "slow");
            ldTag(c, G_T0, nb);
            genBrI(g, "ne", G_T0, 2, lbl + "slow2");
            ldTag(c, G_T0, nc);
            genBrI(g, "ne", G_T0, 2, lbl + "slow2");
            ldPay(c, G_T0, nb);
            ldPay(c, G_T1, nc);
            genFop(g, "fdiv", G_K1, G_T0, G_T1);
            releaseOld(c, na, lbl + "finl");
            stPay(c, na, G_K1);
            stTag(c, na, 2);
            genJmp(g, lbl + "end");
        }
        genLabel(g, lbl + "slow2");
        let opEnum = 9;
        if (isDiv) { opEnum = 8; }
        kcall(c, "__tx_arith_slow", pc, ints4(opEnum, na, nb, nc));
    }
    genLabel(g, lbl + "end");
}

function arith(c: Ref<PCtx>, pc: int, rec: List<string>, form: string): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const na = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    const nc = pField(rec, 5, 0);
    const t1 = pField(rec, 6, 0);
    const t2 = pField(rec, 7, 0);
    const dnr = pField(rec, 8, 0);
    const midx = pField(rec, 9, 0);
    const mlen = pField(rec, 10, 0);
    const sbi = pField(rec, 11, -1);
    const escBuf = pField(rec, 13, -1);
    let fop = "fmul";
    if (form == "add") { fop = "fadd"; }
    if (form == "sub") { fop = "fsub"; }
    if (sbi < 0 && t1 != 0 && t1 == t2) {
        if (t1 == 1) {
            ldPay(c, G_T0, nb);
            ldPay(c, G_T1, nc);
            genOpO(g, form, G_K1, G_T0, G_T1, lbl + "tof");
            if (dnr == 0) { releaseOld(c, na, lbl + "tin"); }
            stPay(c, na, G_K1);
            stTag(c, na, 1);
            genJmp(g, lbl + "tend");
            genLabel(g, lbl + "tof");
            trap(c, pc, 4004, midx, mlen);
            genLabel(g, lbl + "tend");
            return;
        }
        if (t1 == 2) {
            ldPay(c, G_T0, nb);
            ldPay(c, G_T1, nc);
            genFop(g, fop, G_K1, G_T0, G_T1);
            if (dnr == 0) { releaseOld(c, na, lbl + "tfn"); }
            stPay(c, na, G_K1);
            stTag(c, na, 2);
            return;
        }
        if (t1 == 6 && form == "add") { concat(c, pc, na, nb, nc, escBuf); return; }
    }
    if (sbi >= 0) { strBuild(c, pc, nb, nc, sbi); }
    ldTag(c, G_T0, nb);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldTag(c, G_T0, nc);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldPay(c, G_T0, nb);
    ldPay(c, G_T1, nc);
    genOpO(g, form, G_K1, G_T0, G_T1, lbl + "of");
    storeInt(c, na, lbl + "inl");
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "of");
    trap(c, pc, 4004, midx, mlen);
    genLabel(g, lbl + "slow");
    if (form == "add") {
        ldTag(c, G_T0, nb);
        genBrI(g, "ne", G_T0, 6, lbl + "slow2");
        ldTag(c, G_T0, nc);
        genBrI(g, "ne", G_T0, 6, lbl + "slow2");
        concat(c, pc, na, nb, nc, escBuf);
        genJmp(g, lbl + "end");
    }
    ldTag(c, G_T0, nb);
    genBrI(g, "ne", G_T0, 2, lbl + "slow2");
    ldTag(c, G_T0, nc);
    genBrI(g, "ne", G_T0, 2, lbl + "slow2");
    ldPay(c, G_T0, nb);
    ldPay(c, G_T1, nc);
    genFop(g, fop, G_K1, G_T0, G_T1);
    releaseOld(c, na, lbl + "finl");
    stPay(c, na, G_K1);
    stTag(c, na, 2);
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "slow2");
    let opEnum = 7;
    if (form == "add") { opEnum = 5; }
    if (form == "sub") { opEnum = 6; }
    kcall(c, "__tx_arith_slow", pc, ints4(opEnum, na, nb, nc));
    genLabel(g, lbl + "end");
}

function concat(c: Ref<PCtx>, pc: int, na: int, nb: int, nc: int, escBuf: int): void {
    const args = winArgs(c, pc);
    listPush(args, gaI(na)); listPush(args, gaI(nb)); listPush(args, gaI(nc));
    if (escBuf >= 0) { listPush(args, gaLea(G_SP, escBuf)); genCall(c.g, "__tx_str_concat_fr", args); }
    else { genCall(c.g, "__tx_str_concat", args); }
}

// 字符串构建环（记录 sbl）的 add：首次进入时把构建槽的字节拷进帧上的缓冲，之后就地追加（或前插）；类型不符时先把已构建的
// 结果物化回构建槽，再落到通用路径。状态 [SP + base]：+0 缓冲、+8 长度、+16 容量、+24 已开始、+32 暂存、+40 暂存长度。
function strBuild(c: Ref<PCtx>, pc: int, nb: int, nc: int, sbi: int): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const base = pAt(c.sblBase, sbi) + sbi * 48;
    const prepend = pAt(c.sblPrepend, sbi) == 1;
    const sslot = pAt(c.sblBSlot, sbi);
    let tslot = nb;
    if (nb == sslot) { tslot = nc; }
    ldTag(c, G_T0, sslot);
    genBrI(g, "ne", G_T0, 6, lbl + "sbs");
    ldTag(c, G_T0, tslot);
    genBrI(g, "ne", G_T0, 6, lbl + "sbs");
    genLd(g, 4, G_T0, G_SP, base + 24);
    genBrI(g, "ne", G_T0, 0, lbl + "sbh");
    genCall(g, "__tx_str_bytes", argsOf1(gaLd(4, G_W, payOff(sslot))));
    genRes(g, G_T0);
    genBrI(g, "eq", G_T0, 0, lbl + "sbs");
    genLd(g, 8, G_T1, G_T0, 0);
    genLd(g, 8, G_T2, G_T0, 8);
    genSt(g, 8, G_SP, base + 32, G_T1);
    genSt(g, 8, G_SP, base + 40, G_T2);
    genOpI(g, "shl", G_T1, G_T2, 1);
    genOpI(g, "add", G_T1, G_T1, 64);
    genSt(g, 8, G_SP, base + 16, G_T1);
    genCall(g, "__tx_strb_alloc", argsOf1(gaR(G_T1)));
    genRes(g, G_K1);
    genSt(g, 8, G_SP, base, G_K1);
    genLd(g, 8, G_T2, G_SP, base + 40);
    genSt(g, 8, G_SP, base + 8, G_T2);
    if (prepend) {
        // 前插：已有内容放在缓冲尾部（容量 − 长度处）。
        genLd(g, 8, G_T1, G_SP, base + 16);
        genOp(g, "sub", G_T1, G_T1, G_T2);
        genOp(g, "add", G_T1, G_T1, G_K1);
        genCall(g, "__tx_strb_copy", argsOf3(gaR(G_T1), gaLd(8, G_SP, base + 32), gaLd(8, G_SP, base + 8)));
    } else {
        genCall(g, "__tx_strb_copy", argsOf3(gaR(G_K1), gaLd(8, G_SP, base + 32), gaLd(8, G_SP, base + 8)));
    }
    genStI(g, 4, G_SP, base + 24, 1);
    genLabel(g, lbl + "sbh");
    let op = "__tx_strb_append";
    if (prepend) { op = "__tx_strb_prepend"; }
    genCall(g, op, argsOf2(gaLea(G_SP, base), gaLd(4, G_W, payOff(tslot))));
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "sbs");
    genLd(g, 4, G_T0, G_SP, base + 24);
    genBrI(g, "eq", G_T0, 0, lbl + "sba");
    let fin = "__tx_strb_finish";
    if (prepend) { fin = "__tx_strb_finish_pre"; }
    genCall(g, fin, argsOf3(gaLea(G_SP, base), gaI(c.fnIdx), gaI(pc)));
    genRes(g, G_K1);
    genSt(g, 8, G_SP, base + 32, G_K1);
    genCall(g, "__tx_release", argsOf1(gaLea(G_W, tagOff(sslot))));
    stPay(c, sslot, G_K1);
    stTag(c, sslot, 6);
    genLabel(g, lbl + "sba");
}

function compare(c: Ref<PCtx>, pc: int, rec: List<string>, form: string): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const na = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    const nc = pField(rec, 5, 0);
    const t1 = pField(rec, 6, 0);
    const t2 = pField(rec, 7, 0);
    const dnr = pField(rec, 8, 0);
    if (t1 != 0 && t1 == t2 && (t1 == 1 || t1 == 2)) {
        ldPay(c, G_T0, nb);
        ldPay(c, G_T1, nc);
        if (t1 == 1) { genSet(g, form, G_K1, G_T0, G_T1); } else { genFSet(g, form, G_K1, G_T0, G_T1); }
        if (dnr == 0) { releaseOld(c, na, lbl + "tcn"); }
        stPay(c, na, G_K1);
        stTag(c, na, 3);
        return;
    }
    ldTag(c, G_T0, nb);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldTag(c, G_T0, nc);
    genBrI(g, "ne", G_T0, 1, lbl + "slow");
    ldPay(c, G_T0, nb);
    ldPay(c, G_T1, nc);
    genSet(g, form, G_K1, G_T0, G_T1);
    releaseOld(c, na, lbl + "inl");
    stPay(c, na, G_K1);
    stTag(c, na, 3);
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "slow");
    ldTag(c, G_T0, nb);
    genBrI(g, "ne", G_T0, 2, lbl + "slow2");
    ldTag(c, G_T0, nc);
    genBrI(g, "ne", G_T0, 2, lbl + "slow2");
    ldPay(c, G_T0, nb);
    ldPay(c, G_T1, nc);
    genFSet(g, form, G_K1, G_T0, G_T1);
    releaseOld(c, na, lbl + "finl");
    stPay(c, na, G_K1);
    stTag(c, na, 3);
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "slow2");
    if (form == "eq") { kcall(c, "__tx_eq_slow", pc, ints3(na, nb, nc)); }
    else {
        let opEnum = 13;
        if (form == "le") { opEnum = 14; }
        kcall(c, "__tx_compare_slow", pc, ints4(opEnum, na, nb, nc));
    }
    genLabel(g, lbl + "end");
}

// 字段读写：逃逸点（对象住帧上）直接读写帧；否则对结构体、枚举、引用对象经 __tx_obj_fields(_w) 内联，不符时 __tx_getfld／__tx_setfld。
function field(c: Ref<PCtx>, pc: int, rec: List<string>, form: string): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const fa = pField(rec, 3, 0);
    const fb = pField(rec, 4, 0);
    const fc = pField(rec, 5, 0);
    const rt = pField(rec, 6, 0);
    const fire = pField(rec, 7, 0);
    const site = pField(rec, 8, -1);
    const fidx = fc & 32767;
    const autoD = fc & 32768;
    const isGet = form != "setfld";
    const borrowed = form == "getfldb";
    if (site >= 0) {
        const bu = pAt(c.escBuf, site);
        const scalar = pAt(c.escScalar, site);
        let ftag = 0;
        if (fidx < pAt(c.escNTags, site)) { ftag = pAt(c.escTagFlat, pAt(c.escTagFirst, site) + fidx); }
        const at = bu + fidx * VALUE_BYTES;
        if (isGet) {
            if (scalar == 1) {
                genLd(g, 8, G_K1, G_SP, bu + fidx * 8);
                releaseOld(c, fa, lbl + "efl");
                stPay(c, fa, G_K1);
                stTag(c, fa, ftag);
                return;
            }
            if (ftag == 0) {
                genLea(g, G_K1, G_SP, at);
                retainAt(c, G_K1, lbl + "efkr");
            }
            releaseOld(c, fa, lbl + "efl");
            genLd(g, 8, G_T0, G_SP, at);
            genLd(g, 8, G_T1, G_SP, at + 8);
            stTagQ(c, fa, G_T0);
            stPay(c, fa, G_T1);
            return;
        }
        if (scalar == 1) {
            ldPay(c, G_T0, fa);
            genSt(g, 8, G_SP, bu + fidx * 8, G_T0);
            return;
        }
        if (ftag == 0) {
            retainSlotOff(c, tagOff(fa), lbl + "efkr");
            genLea(g, G_K1, G_SP, at);
            releaseAt(c, G_K1, lbl + "efkw");
        }
        ldTagQ(c, G_T0, fa);
        ldPay(c, G_T1, fa);
        genSt(g, 8, G_SP, at, G_T0);
        genSt(g, 8, G_SP, at + 8, G_T1);
        return;
    }
    let mn = lbl + "gf";
    if (!isGet) { mn = lbl + "sf"; }
    if (fire == 1) {
        if (rt == 0) {
            ldTag(c, G_T0, fb);
            if (autoD != 0) { genBrI(g, "ne", G_T0, 9, mn + "s"); }
            else {
                genBrI(g, "eq", G_T0, 7, mn + "ok");
                genBrI(g, "eq", G_T0, 9, mn + "ok");
                genBrI(g, "ne", G_T0, 8, mn + "s");
                genLabel(g, mn + "ok");
            }
        }
        let fieldsFn = "__tx_obj_fields";
        if (!isGet) { fieldsFn = "__tx_obj_fields_w"; }
        genCall(g, fieldsFn, argsOf1(gaLd(4, G_W, payOff(fb))));
        genRes(g, G_T0);
        genBrI(g, "eq", G_T0, 0, mn + "s");
        genLd(g, 8, G_T1, G_T0, 8);
        genBrI(g, "ule", G_T1, fidx, mn + "s");
        genLd(g, 8, G_T1, G_T0, 0);
        genOpI(g, "add", G_K1, G_T1, fidx * VALUE_BYTES);
        if (isGet) {
            if (!borrowed) { retainAt(c, G_K1, mn + "r"); }
            genLd(g, 8, G_K0, G_K1, 0);
            genLd(g, 8, G_K1, G_K1, 8);
            releaseOld(c, fa, mn + "l");
            stTagQ(c, fa, G_K0);
            stPay(c, fa, G_K1);
            genJmp(g, mn + "e");
        } else {
            // 写入后照 emitmirror 直落慢路：__tx_setfld 再写一次同一个值（结果等价）。
            retainSlotOff(c, tagOff(fa), mn + "r");
            releaseAt(c, G_K1, mn + "w");
            ldTagQ(c, G_T0, fa);
            ldPay(c, G_T1, fa);
            genSt(g, 8, G_K1, 0, G_T0);
            genSt(g, 8, G_K1, 8, G_T1);
        }
        genLabel(g, mn + "s");
    }
    if (isGet) { kcall(c, "__tx_getfld", pc, ints3(fa, fb, fc)); }
    else { kcall(c, "__tx_setfld", pc, ints3(fb, fc, fa)); }
    if (fire == 1) { genLabel(g, mn + "e"); }
}

function retx(c: Ref<PCtx>, pc: int, rec: List<string>): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const ra = pField(rec, 3, 0);
    const rcount = pField(rec, 4, 0);
    const from = pField(rec, 5, 0);
    const np = pField(rec, 6, 0);
    const mask = pField(rec, 7, -1);
    if (!retSlotsOk(ra, rcount, from, c.regCount)) { pRej(c, pc, "E009", "lop_retx_slots"); return; }
    if (from > 0 && ra >= 1 && ra <= np) { retainSlotOff(c, tagOff(ra), lbl + "rk"); }
    genLd(g, 4, G_K1, G_W, tagOff(ra));
    ldPay(c, G_K0, ra);
    let i = from;
    while (i < rcount) {
        if (i != ra && ((mask >>> (i - from)) & 1) == 1) {
            const skip = lbl + "fx" + toStr(i);
            ldTag(c, G_T0, i);
            notHeapBr(c, G_T0, skip);
            genCall(g, "__tx_release", argsOf1(gaLea(G_W, tagOff(i))));
            genLabel(g, skip);
        }
        stNoneQ(c, i);
        i = i + 1;
    }
    retTail(c);
}

// —— 调用 ——
// 值槽栈上界检查失败时先请内核提交更多值槽栈（T1＝需要的末端），成功则从 retry 重做整条调用序列。
function stackMore(c: Ref<PCtx>, retry: string): void {
    genCall(c.g, "__tx_stack_more", argsOf1(gaR(G_T1)));
    genRes32(c.g, G_T0);
    genBrI(c.g, "ne", G_T0, 0, retry);
}
// 被调窗口 K1 起、末端 T1：值槽栈与原生栈的余量检查，不足转 so。
function stackCheck(c: Ref<PCtx>, so: string): void {
    tbInto(c, G_T3);
    genLd(c.g, 8, G_T3, G_T3, TB_STACK_LIMIT);
    genBr(c.g, "ugt", G_T1, G_T3, so);
    tbInto(c, G_T3);
    genLd(c.g, 8, G_T3, G_T3, TB_NATIVE_STACK_LIMIT);
    genBrSp(c.g, "ule", G_T3, so);
}
// 把被调窗口 [K1 + 起, K1 + 止) 的槽填成 None（4 字节标签与 4 字节载荷，同 emitmirror）；止在 limReg（≥0）或常数 lim。
function fillNone(c: Ref<PCtx>, from: int, limReg: int, lim: int, fill: string, done: string): void {
    const g = c.g;
    genMovI(g, G_T1, from);
    genLabel(g, fill);
    if (limReg >= 0) { genBr(g, "ule", limReg, G_T1, done); } else { genBrI(g, "uge", G_T1, lim, done); }
    genOp(g, "add", G_T3, G_K1, G_T1);
    genStI(g, 4, G_T3, 0, 4);
    genStI(g, 4, G_T3, 8, 0);
    genOpI(g, "add", G_T1, G_T1, 16);
    genJmp(g, fill);
    genLabel(g, done);
}

function callDirect(c: Ref<PCtx>, pc: int, rec: List<string>, borrow: bool): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const a = pField(rec, 3, 0);
    const k = pField(rec, 4, 0);
    const cregs = pField(rec, 5, 0);
    const b = pField(rec, 6, 0);
    genLabel(g, lbl + "rt");
    genLdSym(g, 8, G_T1, "__tx_rt_table_ptr");
    genLd(g, 4, G_T0, G_T1, k * RT_ENTRY_BYTES + RT_STATE_OFFSET);
    genLea(g, G_K1, G_W, tagOff(a));
    genLea(g, G_T1, G_K1, cregs * VALUE_BYTES);
    stackCheck(c, lbl + "so");
    fillNone(c, b * VALUE_BYTES, -1, cregs * VALUE_BYTES, lbl + "dfill", lbl + "dfillend");
    genStI(g, 4, G_K1, 0, 9);
    genSt(g, 4, G_K1, 8, G_T0);
    genCall(g, "f_" + toStr(k), argsOf1(gaR(G_K1)));
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "so");
    stackMore(c, lbl + "rt");
    trap(c, pc, 4003, pField(rec, 7, 0), pField(rec, 8, 0));
    genLabel(g, lbl + "end");
    if (borrow) {
        // 借用（+0）实参的调用之后：不是借用的实参槽照常释放，全部清成 None。
        const mask = pField(rec, 9, 0);
        let j = 1;
        while (j < b) {
            let borrowed = false;
            if (j <= 60) { borrowed = ((mask >>> (j - 1)) & 1) == 1; }
            if (!borrowed) { releaseOld(c, a + j, lbl + "ar" + toStr(j)); }
            stNoneQ(c, a + j);
            j = j + 1;
        }
    }
}

// 被调函数号在 T0（32 位）：查函数表（越界转 oob），取函数地址、寄存器数与模块状态，建被调窗口后间接调用。
function callTail(c: Ref<PCtx>, pc: int, a: int, b: int, so: string, oob: string, writeState: bool, tag: string): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    genLdSym(g, 4, G_T1, "__tx_rt_table_len");
    genBr(g, "uge", G_T0, G_T1, oob);
    genLdSym(g, 8, G_T1, "__tx_rt_table_ptr");
    genOpI(g, "shl", G_T0, G_T0, 4);
    genOp(g, "add", G_T1, G_T1, G_T0);
    genLd(g, 4, G_T0, G_T1, 12);
    genLd(g, 4, G_T2, G_T1, 8);
    genLd(g, 8, G_K0, G_T1, 0);
    genLea(g, G_K1, G_W, tagOff(a));
    genOpI(g, "shl", G_T2, G_T2, 4);
    genOp(g, "add", G_T1, G_K1, G_T2);
    stackCheck(c, so);
    fillNone(c, b * VALUE_BYTES, G_T2, 0, lbl + "_fill" + tag, lbl + "_fillend" + tag);
    if (writeState) {
        genStI(g, 4, G_K1, 0, 9);
        genSt(g, 4, G_K1, 8, G_T0);
    }
    genCallR(g, G_K0, argsOf1(gaR(G_K1)));
}

function callIndirect(c: Ref<PCtx>, pc: int, rec: List<string>): void {
    const g = c.g;
    const lbl = pcLbl(c, pc);
    const na = pField(rec, 3, 0);
    const nb = pField(rec, 4, 0);
    genLabel(g, lbl + "rt");
    ldTag(c, G_T0, na);
    genBrI(g, "ne", G_T0, 12, lbl + "envchk");
    ldPay32(c, G_T0, na);
    genJmp(g, lbl + "fnvtail");
    genLabel(g, lbl + "envchk");
    genBrI(g, "ne", G_T0, 9, lbl + "bc");
    genCall(g, "__tx_callee_fn_env", argsOf3(gaLea(G_W, tagOff(na)), gaI(c.fnIdx), gaI(pc)));
    genRes32(g, G_T0);
    callTail(c, pc, na, nb, lbl + "so", lbl + "oob", false, "e");
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "fnvtail");
    callTail(c, pc, na, nb, lbl + "so", lbl + "oob", true, "f");
    genJmp(g, lbl + "end");
    genLabel(g, lbl + "oob");
    trap(c, pc, 4012, pField(rec, 5, 0), pField(rec, 6, 0));
    genLabel(g, lbl + "so");
    stackMore(c, lbl + "rt");
    trap(c, pc, 4003, pField(rec, 7, 0), pField(rec, 8, 0));
    genLabel(g, lbl + "bc");
    trap(c, pc, 4010, pField(rec, 9, 0), pField(rec, 10, 0));
    genLabel(g, lbl + "end");
}
