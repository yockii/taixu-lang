// multi.tx 的被导入模块（按 fmt 的写法；generic.tx 保留紧凑的泛型写法，两种都覆盖）。
export struct Point {
    x: int,
    y: int,
}

export enum Color {
    Red,
    Green,
}

let created: int = 0;

export const LIMIT: int = 3;

export function makePoint(x: int, y: int): Point {
    created = created + 1;
    return Point { x: x, y: y };
}

export function pick < T > (a: T, b: T, first: bool): T {
    if (first) { return a; }
    return b;
}
