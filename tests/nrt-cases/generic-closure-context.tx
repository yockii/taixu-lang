struct Box { value: int }
function inner<T>(value: T): int {
    const kept: List<T> = listNew(); listPush(kept, value);
    let i = 0; while (i < 3) { i = i + 1; }
    return i + listLen(kept);
}
function total<T>(values: List<T>): int {
    let sum = 0; for (value in values) { sum = sum + inner(value); } return sum;
}
function reader<T>(value: T): () => T { return (): T => { return value; }; }
function again<T>(value: T, depth: int): T { if (depth == 0) { return value; } return again(value, depth - 1); }

export function main(args: []string): int {
    const map: Map<string, int> = mapNew();
    const later = "outer capture";
    const run = (): void => {
        let i = 0; while (i < 40) { mapSet(map, "key" + toStr(i), i * 2); i = i + 1; }
        const values: List<int> = [1, 2]; assert(total(values) == 8, "nested generic locals");
        const read = reader("kept"); assert(read() == "kept", "generic instance owns its own closure");
        const readInt = reader(7); assert(readInt() == 7, "scalar capture in another instance");
        const object = new Box { value: 23 }; const readObject = reader(object);
        assert(readObject().value == 23, "reference capture in another instance");
        assert(again(19, 3) == 19, "recursive generic memo");
        assert(later == "outer capture", "capture first referenced after generic instance check");
    };
    run();
    const repeat = (): void => { mapSet(map, "key39", 81); assert(later == "outer capture", "memoized call context"); };
    repeat(); assert((mapGet(map, "key0") ?? -1) == 0 && (mapGet(map, "key39") ?? -1) == 81, "Map mutation and resize from closures");
    print("generic closure context OK"); return 0;
}
