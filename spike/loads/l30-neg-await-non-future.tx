// l30-neg-await-non-future —— BOOT-21 第十柱 3025 负例。
// zig sema 真值（2026-09-19 执行期活体捕获）：async 体内 await 非 Future
// 值（普通同步函数返回值 int）→ 单诊断 3025 "await 操作数须为 Future<T>
// （得到 int）" 落 await 记号位（12:16）。async 调用的值形态才是 Future<T>
// （D26 §二-1）；async 上下文成立故 3024 不发（与 l29 对照面）。main 未
// 调 caller——sema 逐 decl 走查，async 体检查不需要调用点（l28 同款）。
// 活体注记两件：①3025 判负后 await 表达式型回落操作数型（int）——消费面
// 按操作数型检查（catch 会跟发 3002 "须为 T? 或 T | Error"——首探形态，
// 本负载直用值避免；②await 合法形态产出 T | Error 失败联合——catch 桥接
// 见 l29 注。
function plain(): int {
    return 2;
}
async function caller(): int {
    const r = await plain();
    print(toStr(r));
    return r;
}
export function main(args: []string): int {
    print("ok");
    return 0;
}
