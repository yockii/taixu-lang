import { HtmlDocument, htmlParse, htmlEntities, htmlTextContent } from "../examples/browser/html";
import { seqLen } from "std/utf8";
import { newBuilder, writeString, build } from "std/bytes";

function first(document: Ref<HtmlDocument>, name: string): int {
    let i = 0; while (i < listLen(document.nodes)) { if (listGet(document.nodes, i).tag == name) { return i; } i = i + 1; } return -1;
}
function depth(document: Ref<HtmlDocument>): int {
    let deepest = 0; let i = 0;
    while (i < listLen(document.nodes)) { let d = 0; let at = i; while (at >= 0) { d = d + 1; at = listGet(document.nodes, at).parent; } if (d > deepest) { deepest = d; } i = i + 1; } return deepest;
}
// 第一个 name 元素的元素子节点数（不计文本）。
function children(document: Ref<HtmlDocument>, name: string): int {
    let n = 0; for (child in listGet(document.nodes, first(document, name)).children) { if (listGet(document.nodes, child).tag != "#text") { n = n + 1; } } return n;
}
function structure(): void {
    const source = "<!doctype html><html><head><TITLE>太虚 &amp; browser</TITLE><style>p{color:red}x{content:'<tag>'}</STYLE><script>if(a<b){x='&amp;'}</script></head><body><p CLASS='a' class=b>一 &lt;二&gt;<a href='next?a=1&amp;b=2'>link</a><div>block</div><ul><li>one<li>two</ul><img alt='image'><base href='/docs/'></body></html>";
    const document = htmlParse(source) catch panic("document");
    assert(document.title == "太虚 & browser" && listLen(document.styles) == 1 && listGet(document.styles, 0) == "p{color:red}x{content:'<tag>'}", "title entities and raw style");
    const p = first(document, "p"); const a = first(document, "a"); const div = first(document, "div");
    assert(p >= 0 && a >= 0 && div >= 0 && htmlTextContent(document, p) == "一 <二>link", "block start implicitly closes paragraph");
    assert((mapGet(listGet(document.nodes, p).attributes, "class") catch "") == "a", "case normalized duplicate attributes retain first");
    assert((mapGet(listGet(document.nodes, a).attributes, "href") catch "") == "next?a=1&b=2", "quoted attributes decode entities");
    assert(listGet(document.nodes, p).parent == listGet(document.nodes, div).parent, "paragraph and following div are siblings");
    const ul = first(document, "ul"); const children = listGet(document.nodes, ul).children;
    assert(listLen(children) == 2 && htmlTextContent(document, listGet(children, 0)) == "one" && htmlTextContent(document, listGet(children, 1)) == "two", "optional li closure");
    assert(document.baseHref == "/docs/" && htmlTextContent(document, first(document, "script")) == "if(a<b){x='&amp;'}", "base and inert raw script retained");
    let i = 1; while (i < listLen(document.nodes)) { const node = listGet(document.nodes, i); assert(node.parent >= 0 && node.parent < i, "parent is earlier index; no cycle"); i = i + 1; }
    let cut = 0;
    while (true) { htmlParse(strSlice(source, 0, cut)) catch panic("every character-boundary prefix"); if (cut == len(source)) { break; } cut = cut + seqLen(source, cut); }
}
function entities(): void {
    assert(htmlEntities("&lt;&gt;&amp;&quot;&apos;&nbsp;", false) == "<>&\"' ", "basic named entities");
    assert(htmlEntities("&#x1f680;|&#0;|&#xD800;|&#x110000;|&#128;|&#999999999999999999999999;", false) == "🚀|�|�|�|€|�", "numeric scalar repair and bounded huge number");
    assert(htmlEntities("&unknown; &amp= &amp;", true) == "&unknown; &amp= &", "unknown and ambiguous attribute entity preserved");
    assert(htmlEntities("a &amp b &#65 c", false) == "a & b A c", "legacy omitted semicolons");
    assert(htmlEntities("太虚 &unfinished", false) == "太虚 &unfinished", "unterminated name remains text");
}
function tolerant(): void {
    const text = htmlParse("text < 2 <!-- ignored --><p x='a>b' y=unquoted>yes</unknown><br>after") catch panic("tolerant");
    assert(strFind(htmlTextContent(text, 0), "text < 2 yesafter") == 0, "literal angle, comments, unknown end and void tag");
    const p = first(text, "p"); assert((mapGet(listGet(text.nodes, p).attributes, "x") catch "") == "a>b", "angle inside quoted attribute");
    const rcdata = htmlParse("<textarea>a<b>&amp;</TEXTAREA><div>end</div>") catch panic("RCDATA"); assert(htmlTextContent(rcdata, first(rcdata, "textarea")) == "a<b>&", "RCDATA only recognizes its own end tag");
    // 资源边界不使整页失败：超深的元素不再压栈、多余属性丢弃、节点到上限截断（同 Blink 的最大树深处理）。
    let deep = ""; let i = 0; while (i < 300) { deep = deep + "<span>"; i = i + 1; }
    const nested = htmlParse(deep + "end") catch panic("deep nesting parses");
    assert(depth(nested) <= 257 && strFind(htmlTextContent(nested, 0), "end") == 0, "bounded nesting keeps content");
    let attrs = "<p"; i = 0; while (i < 129) { attrs = attrs + " a" + toStr(i) + "=x"; i = i + 1; }
    const many = htmlParse(attrs + ">x") catch panic("many attributes parse"); const manyP = listGet(many.nodes, first(many, "p")).attributes;
    assert(mapHas(manyP, "a127") && !mapHas(manyP, "a128"), "bounded attributes keep the first 128");
    const table = htmlParse("<table><tr><td>a<td>b<tr><th>c<td>d</table><select><option>1<option>2</select><dl><dt>t<dd>d<dt>u</dl>") catch panic("implied end tags");
    assert(children(table, "table") == 2 && children(table, "tr") == 2 && children(table, "select") == 2 && children(table, "dl") == 3, "implied td/tr/option/dd/dt end tags");
    assert(listLen(listGet(table.nodes, first(table, "tr")).children) == 2, "cells of one row are siblings");
    const flood = newBuilder(); i = 0; while (i < 60000) { writeString(flood, "<br>"); i = i + 1; }
    const truncated = htmlParse(build(flood)) catch panic("node limit truncates"); assert(listLen(truncated.nodes) < 50000, "node count bounded by truncation");
    const escaped = newBuilder(); i = 0; while (i < 20000) { writeString(escaped, "&lt;a&gt;"); i = i + 1; }
    assert(len(htmlEntities(build(escaped), false)) == 60000, "many entities decode linearly");
    let angles = ""; i = 0; while (i < 1000) { angles = angles + "<"; i = i + 1; }
    const literal = htmlParse(angles) catch panic("literal angles"); assert(listLen(literal.nodes) == 2 && htmlTextContent(literal, 0) == angles, "long literal runs stay one text span");
    const unicode = htmlParse("字 <🚀> <!-- -太 -> --> <p>文</p>") catch panic("Unicode delimiters"); assert(htmlTextContent(unicode, 0) == "字 <🚀>  文", "ASCII delimiter probes never slice through a Unicode scalar");
}
test "浏览器 HTML：文档、原始文本、可省略闭合与逐前缀" { structure(); }
test "浏览器 HTML：实体解码与错误标量" { entities(); }
test "浏览器 HTML：宽容语法与资源边界" { tolerant(); }
export function main(args: []string): int { structure(); entities(); tolerant(); print("browser html: document, entities, tolerant parsing and limits OK"); return 0; }
