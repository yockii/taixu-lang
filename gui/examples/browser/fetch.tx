// 只在浏览器网络线程调用；全部跳转共用导航的绝对截止和取消信号。
import { BrowserTransport, transportWrite, transportRead, transportClose, transportShutdown } from "./transport";
import { browserOpen } from "./connect";
import { HttpAddress, HttpClientResponse, httpAddress, httpClientRequest, httpClientReceiver, httpClientFeed, httpClientFinish, httpClientRedirect } from "std/http_client";
import { HttpLimits, httpDefaultLimits } from "std/http_wire";
import { uriString } from "std/url";
import { dnsCheckpoint } from "./dns_common";

export struct BrowserPage { url: string, response: HttpClientResponse, redirects: int }

function response(transport: Ref<BrowserTransport>, address: HttpAddress, limits: HttpLimits): HttpClientResponse | Error {
    transportWrite(transport, httpClientRequest(address)?)?; const receiver = httpClientReceiver("GET", limits)?;
    while (!receiver.done) {
        const data = transportRead(transport, 65536)?; httpClientFeed(receiver, data, bytesLen(data) == 0)?;
    }
    dnsCheckpoint(transport.deadline, transport.cancelled)?; const result = httpClientFinish(receiver)?; dnsCheckpoint(transport.deadline, transport.cancelled)?;
    // 响应已按分帧确认完整；我方发 close_notify 失败（对端在 Connection: close 后直接 RST）不使已收的页面作废。
    transportShutdown(transport) catch (e) {}; return result;
}
export function browserFetch(text: string, deadline: int, roots: List<Bytes>, cancelled: () => bool): BrowserPage | Error {
    let address = httpAddress(text)?; const seen: Map<string, bool> = mapNew(); let redirects = 0;
    while (true) {
        dnsCheckpoint(deadline, cancelled)?; let key = address.uri; key.fragment = None; const identity = uriString(key);
        if (mapHas(seen, identity)) { return err("browser fetch: redirect loop"); } mapSet(seen, identity, true);
        const transport = browserOpen(address.host, address.port, address.secure, deadline, roots, cancelled)?;
        const received = response(transport, address, httpDefaultLimits()) catch (e) { transportClose(transport); return e; }; transportClose(transport);
        const next = (httpClientRedirect(address, received)?).next;
        if (next == None) { return BrowserPage { url: uriString(address.uri), response: received, redirects: redirects }; }
        if (redirects >= 10) { return err("browser fetch: redirect limit"); } redirects = redirects + 1; address = next;
    } return err("browser fetch: unreachable navigation state");
}
