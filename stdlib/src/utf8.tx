// ============================================================================
// std/utf8 —— UTF-8 码点工具面。
//
// 码点迭代/计数/编解码——std/string 码点私有件（seqLenAt/decodeCpAt）的
// 公共化收拢（json.tx/text.tx 的本地副本语义同源）。全部纯 .tx、确定性；
// 非良构字节序列入返回 None/跳过面（防御性——源恒良构 UTF-8）。
//
// 按码点的切片与查找（slice／find，D3 v0.52 起取代内建 strSub／strIndexOf）：语言里整数位置与长度一律是字节
//（len、byteAt、strSlice、strFind），只有“按字”的少数场合才用这里的码点版，O(n)。
// ============================================================================

import { indexOf } from "./string";

// —— 序列长度与解码 ——

// seqLen：i 起始字节的 UTF-8 序列长度（1..4）；非法首字节/越界 0。
export function seqLen(s: string, i: int): int {
    if (i < 0 || i >= len(s)) {
        return 0;
    }
    const bopt = byteTryAt(s, i);
    if (bopt == None) {
        return 0;
    }
    const b = bopt catch 0;
    if (b < 128) {
        return 1;
    }
    if (b >= 194 && b <= 223) {
        return 2;
    }
    if (b >= 224 && b <= 239) {
        return 3;
    }
    if (b >= 240 && b <= 244) {
        return 4;
    }
    return 0;
}

// decode：i 起始码点（U+0000..U+10FFFF）；非法/越界 None（续字节校验）。
export function decode(s: string, i: int): int? {
    const n = seqLen(s, i);
    if (n == 0) {
        return None;
    }
    const b1opt = byteTryAt(s, i);
    if (b1opt == None) {
        return None;
    }
    const b1 = b1opt catch -1;
    if (n == 1) {
        return b1;
    }
    if (i + 1 >= len(s)) {
        return None;
    }
    const b2opt = byteTryAt(s, i + 1);
    if (b2opt == None) {
        return None;
    }
    const b2 = b2opt catch -1;
    if (b2 < 128 || b2 >= 192) {
        return None;
    }
    if (n == 2) {
        return (b1 % 32) * 64 + (b2 % 64);
    }
    if (i + 2 >= len(s)) {
        return None;
    }
    const b3opt = byteTryAt(s, i + 2);
    if (b3opt == None) {
        return None;
    }
    const b3 = b3opt catch -1;
    if (b3 < 128 || b3 >= 192) {
        return None;
    }
    if (n == 3) {
        return (b1 % 16) * 4096 + (b2 % 64) * 64 + (b3 % 64);
    }
    if (i + 3 >= len(s)) {
        return None;
    }
    const b4opt = byteTryAt(s, i + 3);
    if (b4opt == None) {
        return None;
    }
    const b4 = b4opt catch -1;
    if (b4 < 128 || b4 >= 192) {
        return None;
    }
    return (b1 % 8) * 262144 + (b2 % 64) * 4096 + (b3 % 64) * 64 + (b4 % 64);
}

// —— 计数与迭代 ——

// count：码点个数（非字节数；len 为字节面）。
export function count(s: string): int {
    let n: int = 0;
    let i: int = 0;
    while (i < len(s)) {
        const sl = seqLen(s, i);
        if (sl == 0) {
            i = i + 1;
            continue;
        }
        n = n + 1;
        i = i + sl;
    }
    return n;
}

// byteLenOf：第 k 个（0 起）码点的字节长度；越界 −1。
export function byteLenOf(s: string, k: int): int {
    if (k < 0) {
        return -1;
    }
    let idx: int = 0;
    let i: int = 0;
    while (i < len(s)) {
        const sl = seqLen(s, i);
        if (sl == 0) {
            i = i + 1;
            continue;
        }
        if (idx == k) {
            return sl;
        }
        idx = idx + 1;
        i = i + sl;
    }
    return -1;
}

// codepoints：码点列表（按下标序；非法字节跳过）。
export function codepoints(s: string): List<int> {
    const out: List<int> = listNew();
    let i: int = 0;
    while (i < len(s)) {
        const cp = decode(s, i);
        if (cp == None) {
            i = i + 1;
            continue;
        }
        listPush(out, cp catch -1);
        i = i + seqLen(s, i);
    }
    return out;
}

// —— 按码点的切片与查找 ——

// slice：码点区间 [from, to) 的子串（旧内建 strSub(s, from, n) 即 slice(s, from, from + n)）。from < 0、to < from、
// to 超过码点数时 panic（同按字节的 strSlice 越界 trap、Python／Rust 切片越界报错）。
export function slice(s: string, from: int, to: int): string {
    if (from < 0 || to < from) {
        panic("utf8.slice 区间越界");
    }
    const a = offsetOf(s, from);
    const b = offsetOf(s, to);
    if (a < 0 || b < 0) {
        panic("utf8.slice 区间越界");
    }
    if (b == a) {
        return "";
    }
    // 两端都在字符边界上，字节区间转回恒为合法 UTF-8。不用内建 strSlice，新旧编译器都能编。
    return bytesToStr(bytesSlice(bytesFromStr(s), a, b - a)) catch "";
}

// find：sub 首次出现处的码点下标，没有得 −1，空串得 0（旧内建 strIndexOf 的语义）；字节下标用内建 strFind。
export function find(s: string, sub: string): int {
    const at = indexOf(s, sub);
    if (at < 0) {
        return -1;
    }
    let n: int = 0;
    let i: int = 0;
    while (i < at) {
        const sl = seqLen(s, i);
        if (sl == 0) {
            i = i + 1;
            continue;
        }
        n = n + 1;
        i = i + sl;
    }
    return n;
}

// 第 k 个码点的字节偏移；k 等于码点数时为 len(s)，更大或为负得 −1。
function offsetOf(s: string, k: int): int {
    if (k < 0) {
        return -1;
    }
    let idx: int = 0;
    let i: int = 0;
    while (idx < k) {
        if (i >= len(s)) {
            return -1;
        }
        const sl = seqLen(s, i);
        if (sl == 0) {
            i = i + 1;
            continue;
        }
        idx = idx + 1;
        i = i + sl;
    }
    return i;
}

// fromCodepoints：码点列表 → 字符串（非法码点（负/超 U+10FFFF/代理区）跳过）。
export function fromCodepoints(cps: List<int>): string {
    let out: string = "";
    let i: int = 0;
    while (i < listLen(cps)) {
        const cp = listTryGet(cps, i) catch -1;
        if (cp >= 0 && cp <= 0x10FFFF && !(cp >= 0xD800 && cp <= 0xDFFF)) {
            out = out + (utf8Encode(cp) catch "");
        }
        i = i + 1;
    }
    return out;
}

// encode：码点 → 字符串（单码点便捷形；非法返回 ""）。
export function encode(cp: int): string {
    if (cp < 0 || cp > 0x10FFFF) {
        return "";
    }
    if (cp >= 0xD800 && cp <= 0xDFFF) {
        return "";
    }
    return utf8Encode(cp) catch "";
}
