// A64 编码表核对（macOS 适配 M4 设计 A2）：tests/a64/encodings.txt 的正例逐条调用 a64_encode.tx 的编码函数，
// 与独立汇编器给出的编码比较；负例（! 开头）须得 -1。全部相符打印 PASS_A64_ENCODINGS 与条数。
import { a64AddSubImm, a64LogicalImm, a64MoveWide, a64Bitfield, a64Adr, a64AddSubShifted, a64AddSubExt, a64LogicalShifted, a64DataProc2, a64DataProc3, a64CondSelect } from "./selfhost/a64_encode";
import { a64LdStUImm, a64LdStImm9, a64LdStReg, a64LdStPair, a64AtomicAl, a64Casal, a64AcqRel, a64Branch, a64BranchCond, a64CompareBranch, a64TestBranch, a64BranchReg, a64Brk } from "./selfhost/a64_encode";
import { a64FpInt, a64FpUnary, a64FpBinary, a64Fcmp } from "./selfhost/a64_encode";

struct Num { v: int, ok: bool }

// 十进制（可带负号，含 int 的最小值：按负数累加，不经取负溢出）。
function parseDec(s: string): Ref<Num> {
    const bad = new Num { v: 0, ok: false };
    if (len(s) == 0) { return bad; }
    let neg = false;
    let i = 0;
    if ((byteAt(s, 0) catch 0) == 45) { neg = true; i = 1; }
    if (i >= len(s) || len(s) - i > 19) { return bad; }
    let v = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 0;
        if (c < 48 || c > 57) { return bad; }
        v = v * 10 - (c - 48);
        i = i + 1;
    }
    if (neg) { return new Num { v: v, ok: true }; }
    return new Num { v: -v, ok: true };
}

function parseHex(s: string): Ref<Num> {
    const bad = new Num { v: 0, ok: false };
    if (len(s) == 0 || len(s) > 8) { return bad; }
    let v = 0;
    let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 0;
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        if (c >= 97 && c <= 102) { d = c - 87; }
        if (d < 0) { return bad; }
        v = v * 16 + d;
        i = i + 1;
    }
    return new Num { v: v, ok: true };
}

function f(xs: List<int>, k: int): int { return listGet(xs, k) catch -999; }

// 按形式名分派；字段数不对得 -2（与“编不出”的 -1 区分）。
function encode(form: string, x: List<int>): int {
    const n = listLen(x);
    if (form == "addsub_imm" && n == 7) { return a64AddSubImm(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6)); }
    if (form == "logical_imm" && n == 5) { return a64LogicalImm(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4)); }
    if (form == "move_wide" && n == 5) { return a64MoveWide(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4)); }
    if (form == "bitfield" && n == 6) { return a64Bitfield(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5)); }
    if (form == "adr" && n == 3) { return a64Adr(f(x, 0), f(x, 1), f(x, 2)); }
    if (form == "addsub_shifted" && n == 8) { return a64AddSubShifted(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6), f(x, 7)); }
    if (form == "addsub_ext" && n == 8) { return a64AddSubExt(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6), f(x, 7)); }
    if (form == "logical_shifted" && n == 8) { return a64LogicalShifted(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6), f(x, 7)); }
    if (form == "dp2" && n == 5) { return a64DataProc2(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4)); }
    if (form == "dp3" && n == 7) { return a64DataProc3(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6)); }
    if (form == "cond_select" && n == 7) { return a64CondSelect(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6)); }
    if (form == "ldst_uimm" && n == 6) { return a64LdStUImm(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5)); }
    if (form == "ldst_imm9" && n == 7) { return a64LdStImm9(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6)); }
    if (form == "ldst_reg" && n == 8) { return a64LdStReg(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6), f(x, 7)); }
    if (form == "ldst_pair" && n == 8) { return a64LdStPair(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5), f(x, 6), f(x, 7)); }
    if (form == "atomic_al" && n == 5) { return a64AtomicAl(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4)); }
    if (form == "casal" && n == 4) { return a64Casal(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    if (form == "acq_rel" && n == 4) { return a64AcqRel(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    if (form == "branch" && n == 2) { return a64Branch(f(x, 0), f(x, 1)); }
    if (form == "branch_cond" && n == 2) { return a64BranchCond(f(x, 0), f(x, 1)); }
    if (form == "compare_branch" && n == 4) { return a64CompareBranch(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    if (form == "test_branch" && n == 4) { return a64TestBranch(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    if (form == "branch_reg" && n == 2) { return a64BranchReg(f(x, 0), f(x, 1)); }
    if (form == "brk" && n == 1) { return a64Brk(f(x, 0)); }
    if (form == "fp_int" && n == 6) { return a64FpInt(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4), f(x, 5)); }
    if (form == "fp_unary" && n == 4) { return a64FpUnary(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    if (form == "fp_binary" && n == 5) { return a64FpBinary(f(x, 0), f(x, 1), f(x, 2), f(x, 3), f(x, 4)); }
    if (form == "fcmp" && n == 4) { return a64Fcmp(f(x, 0), f(x, 1), f(x, 2), f(x, 3)); }
    return -2;
}

function hex8(v: int): string {
    const digits = "0123456789abcdef";
    let s = "";
    let k = 7;
    while (k >= 0) {
        const d = (v >>> (k * 4)) & 15;
        s = s + strSub(digits, d, 1);
        k = k - 1;
    }
    return s;
}

// 形式名与字段：word 列表的第 0 个是形式名，其余是十进制字段；字段不合法时 ok 为假。
struct Case { form: string, fields: List<int>, ok: bool }
function parseCase(text: string): Ref<Case> {
    const words = strSplit(text, " ");
    const out = new Case { form: listGet(words, 0) catch "", fields: listNew(), ok: true };
    let k = 1;
    while (k < listLen(words)) {
        const w = listGet(words, k) catch "";
        if (len(w) > 0) {
            const v = parseDec(w);
            if (!v.ok) { out.ok = false; } else { listPush(out.fields, v.v); }
        }
        k = k + 1;
    }
    return out;
}

function main(args: []string): int {
    if (len(args) < 1) { eprint("usage: a64_encode_probe <encodings.txt>"); return 64; }
    const text = readFile(args[0]) catch (e) { eprint(e.message); return 65; };
    const lines = strSplit(text, "\n");
    let good = 0;
    let bad = 0;
    let failures = 0;
    let i = 0;
    while (i < listLen(lines)) {
        const line = listGet(lines, i) catch "";
        i = i + 1;
        if (len(line) == 0 || (byteAt(line, 0) catch 0) == 35) { continue; }
        if ((byteAt(line, 0) catch 0) == 33) {
            const c = parseCase(strSub(line, 2, len(line) - 2));
            const got = encode(c.form, c.fields);
            if (!c.ok || got != -1) {
                failures = failures + 1;
                if (failures <= 20) { eprint("line " + toStr(i) + ": negative case encoded as " + toStr(got) + ": " + line); }
            }
            bad = bad + 1;
            continue;
        }
        const parts = strSplit(line, " | ");
        if (listLen(parts) != 3) { eprint("line " + toStr(i) + ": malformed"); return 66; }
        const c = parseCase(listGet(parts, 0) catch "");
        const want = parseHex(listGet(parts, 2) catch "");
        const got = encode(c.form, c.fields);
        if (!c.ok || !want.ok || got != want.v) {
            failures = failures + 1;
            let shown = toStr(got);
            if (got >= 0) { shown = hex8(got); }
            if (failures <= 20) { eprint("line " + toStr(i) + ": " + (listGet(parts, 1) catch "") + " want " + (listGet(parts, 2) catch "") + " got " + shown); }
        }
        good = good + 1;
    }
    if (failures > 0) { eprint("FAIL " + toStr(failures) + " of " + toStr(good + bad)); return 1; }
    print("PASS_A64_ENCODINGS " + toStr(good) + " " + toStr(bad));
    return 0;
}
