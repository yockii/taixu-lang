// ============================================================================
// std/net —— TCP 与最小 HTTP（V0.39-N1；STD-10；D86 §三）。宿主 extern
// 直通薄封装（负值→Error）＋纯函数 HTTP 向量（确定性断言面）。
//
// 确定性红线：教程/e2e 断言面只用 loopback（127.0.0.1）＋固定响应；外网
// 依赖禁用。https/UDP/IPv6/超时参数化不在面（D86 §六边界）。
//
// D3 v0.23 平台层：TCP 系统调用经 import "./net_sys" 按目标解析为
// net_sys_windows.tx（ws2_32）／net_sys_linux.tx（from syscall，无 libc）／net_sys_macos.tx（libSystem）。
//
// 2026-10-16 起（用户裁决：公共接口统一为 T | Error）：tcpRecv 返回 string | Error——""＝对端关闭，
// Error＝失败（坏句柄、max ≤ 0、系统调用失败）。
// ============================================================================

import { parseInt } from "std/strconv";

import { sysTcpConnect, sysTcpListen, sysTcpAccept, sysTcpSend, sysTcpRecv, sysTcpClose } from "./net_sys";

export struct HttpResp {
    status: int,
    headers: string,
    body: string,
}

export struct Url {
    host: string,
    port: int,
    path: string,
}

const NET_ERR: string = "net: operation failed";
const NET_PARSE: string = "net: bad url or response";

// —— TCP 薄封装（负值→Error；句柄语义见 D86 §二）——

export function tcpConnect(host: string, port: int): int | Error {
    const h = sysTcpConnect(host, port);
    if (h < 0) {
        return err(NET_ERR);
    }
    return h;
}

export function tcpListen(port: int): int | Error {
    const l = sysTcpListen(port);
    if (l < 0) {
        return err(NET_ERR);
    }
    return l;
}

export function tcpAccept(l: int): int | Error {
    const c = sysTcpAccept(l);
    if (c < 0) {
        return err(NET_ERR);
    }
    return c;
}

export function tcpSend(fd: int, data: string): int | Error {
    const n = sysTcpSend(fd, data);
    if (n < 0) {
        return err(NET_ERR);
    }
    return n;
}

// 接收至多 max 字节；""＝对端关闭，失败为 Error。
export function tcpRecv(fd: int, max: int): string | Error {
    return sysTcpRecv(fd, max);
}

export function tcpClose(fd: int): void {
    sysTcpClose(fd);
}

// —— URL 解析（http://host[:port]/path；仅 http）——

export function parseUrl(url: string): Url | Error {
    const scheme: string = "http://";
    if (len(url) <= len(scheme)) {
        return err(NET_PARSE);
    }
    if (strSub(url, 0, len(scheme)) != scheme) {
        return err(NET_PARSE);
    }
    const rest: string = strSub(url, len(scheme), len(url) - len(scheme));
    const slash: int = strIndexOf(rest, "/");
    let hostPart: string = rest;
    let path: string = "/";
    if (slash >= 0) {
        hostPart = strSub(rest, 0, slash);
        path = strSub(rest, slash, len(rest) - slash);
    }
    const colon: int = strIndexOf(hostPart, ":");
    if (colon < 0) {
        return Url { host: hostPart, port: 80, path: path };
    }
    const host: string = strSub(hostPart, 0, colon);
    const portStr: string = strSub(hostPart, colon + 1, len(hostPart) - colon - 1);
    const portR: int | Error = parseInt(portStr);
    // bare `catch {}` 块形不在实现面（探针同教训）——缺省值形＋范围判定。
    const p: int = portR catch 0;
    if (p <= 0 || p > 65535) {
        return err(NET_PARSE);
    }
    return Url { host: host, port: p, path: path };
}

// —— 纯函数段（确定性向量锚——tests/net-fx.tx）——

/// HTTP/1.0 请求行构造（Connection: close——单往返语义；Content-Length
/// 仅带 body 时出现）。
export function buildHttpRequest(method: string, path: string, host: string, body: string): string {
    if (len(body) > 0) {
        return method + " " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\nContent-Length: " + toStr(len(body)) + "\r\n\r\n" + body;
    }
    return method + " " + path + " HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
}

/// 响应解析：头与体按 \r\n\r\n 分割（缺席 body ＝""）。
export function parseHttpResponse(raw: string): HttpResp | Error {
    const sep: int = strIndexOf(raw, "\r\n\r\n");
    let head: string = raw;
    let body: string = "";
    if (sep >= 0) {
        head = strSub(raw, 0, sep);
        body = strSub(raw, sep + 4, len(raw) - sep - 4);
    }
    const sp1: int = strIndexOf(head, " ");
    if (sp1 < 0) {
        return err(NET_PARSE);
    }
    const rest: string = strSub(head, sp1 + 1, len(head) - sp1 - 1);
    const sp2: int = strIndexOf(rest, " ");
    if (sp2 < 0) {
        return err(NET_PARSE);
    }
    const statusStr: string = strSub(rest, 0, sp2);
    const statusR: int | Error = parseInt(statusStr);
    const st: int = statusR catch 0;
    if (st <= 0) {
        return err(NET_PARSE);
    }
    return HttpResp { status: st, headers: head, body: body };
}

// —— HTTP 客户端（HTTP/1.0 单往返；Connection: close 收至对端关闭）——

// 解析失败占位（exchange 统一入口——空 host 经 connect 负值→NET_ERR）。
function emptyUrl(): Url {
    return Url { host: "", port: 0, path: "/" };
}

function exchange(url: string, req: string): HttpResp | Error {
    const u: Url | Error = parseUrl(url);
    const uu: Url = u catch emptyUrl();
    const fd: int = sysTcpConnect(uu.host, uu.port);
    if (fd < 0 || len(uu.host) == 0) {
        return err(NET_ERR);
    }
    // sysTcpSend 返回 int（负值＝错误）——负值判别非 catch 通道。
    const ok: int = sysTcpSend(fd, req);
    if (ok < 0 || ok != len(req)) {
        tcpClose(fd);
        return err(NET_ERR);
    }
    const raw: string = recvAll(fd) catch (e) {
        tcpClose(fd);
        return err(NET_ERR);
    };
    tcpClose(fd);
    return parseHttpResponse(raw);
}

// 收到对端关闭为止；任一次接收失败即为 Error。
function recvAll(fd: int): string | Error {
    let raw: string = "";
    while (true) {
        const chunk: string = tcpRecv(fd, 65536)?;
        if (len(chunk) == 0) {
            return raw;
        }
        raw = raw + chunk;
    }
    return raw;
}

/// HTTP/1.0 GET。
export function httpGet(url: string): HttpResp | Error {
    const u: Url | Error = parseUrl(url);
    const uu: Url = u catch emptyUrl();
    return exchange(url, buildHttpRequest("GET", uu.path, uu.host, ""));
}

/// HTTP/1.0 POST（Content-Length 面）。
export function httpPost(url: string, body: string): HttpResp | Error {
    const u: Url | Error = parseUrl(url);
    const uu: Url = u catch emptyUrl();
    return exchange(url, buildHttpRequest("POST", uu.path, uu.host, body));
}
