// 线程第 3b 步：函数值与接口值随数据发送（线程设计 §十八）。闭包连同捕获深拷贝，接口值连同装入的具体值深拷贝，
// 到了新线程照常调用；经变量、字段传入 threadSpawn 的函数值；结果里的闭包与接口值发回调用线程。闭包引用的模块级
// let 跟随它所在的线程（每线程一份）。
interface Shape {
    area(): float;
    label(): string;
}

struct Circle {
    r: float,
}

struct Box {
    w: float,
    h: float,
    tags: List< string>,
}

struct Job {
    name: string,
    run: () => int,
}

let hits: int = 0;

function circleArea(c: Circle): float {
    return 3.0 * c.r * c.r;
}

function circleLabel(c: Circle): string {
    return "circle";
}

function boxArea(b: Box): float {
    return b.w * b.h;
}

function boxLabel(b: Box): string {
    return "box " + toStr(listLen(b.tags));
}

function adder(n: int): () => int {
    const xs: List< int> = listNew();
    listPush(xs, n);
    return (): int => {
        hits = hits + 1;
        return (listGet(xs, 0) catch 0) + hits;
    };
}

function main(args: []string): void {
    // 数据里的闭包：List 里的三个闭包各自捕获不同的值，连同 List 一起发进新线程逐个调用；它们改的 hits 是新线程的那一份。
    const fs: List< () => int> = listNew();
    listPush(fs, adder(10));
    listPush(fs, adder(20));
    const base = 5;
    listPush(fs, (): int => base * 2);
    const t1 = threadSpawn((): int => {
            let s = 0;
            for (f in fs) {
                s = s + f();
            }
            return s;
        });
    print("closures " + toStr(threadJoin(t1) catch -1) + " main hits " + toStr(hits));

    // 接口值：不同具体类型装入同一接口，连同具体值发进新线程，方法照常调用。
    const shapes: List< Shape> = listNew();
    const s1: Shape = Circle { r: 0.5 };
    listPush(shapes, s1);
    const tags: List< string> = listNew();
    listPush(tags, "a");
    listPush(tags, "b");
    const s2: Shape = Box { w: 1.5, h: 3.0, tags: tags };
    listPush(shapes, s2);
    const t2 = threadSpawn((): string => {
            let out = "";
            for (sh in shapes) {
                out = out + sh.label() + " " + toStr(sh.area()) + ";";
            }
            return out;
        });
    print(threadJoin(t2) catch "join failed");

    // 经变量、字段传入的函数值。
    const f3: () => int = adder(100);
    const t3 = threadSpawn(f3);
    const job = Job { name: "j", run: (): int => listLen(tags) * 7 };
    const t4 = threadSpawn(job.run);
    print("var " + toStr(threadJoin(t3) catch -1) + " field " + toStr(threadJoin(t4) catch -1));

    // 结果里的闭包与接口值：新线程建的闭包与接口值发回，主线程照常调用；闭包引用的 hits 是主线程的那一份。
    const t5 = threadSpawn((): Job => Job { name: "w", run: adder(1000) });
    const back = threadJoin(t5) catch job;
    hits = 50;
    print("result closure " + toStr(back.run()) + " hits " + toStr(hits));
    const t6 = threadSpawn((): Shape => {
            const ts: List< string> = listNew();
            listPush(ts, "x");
            const s: Shape = Box { w: 0.5, h: 0.5, tags: ts };
            return s;
        });
    const s6 = threadJoin(t6) catch s1;
    print("result iface " + s6.label() + " " + toStr(s6.area()));
}
