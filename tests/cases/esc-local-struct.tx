// esc-local-struct —— V0.23-P1 柱①②③恒等负载（D59）：不逃逸局部 struct
// 帧分配/标量替换＋小串栈缓冲。判据＝三路一致（interp==zig 链==直发）；
// TAIXU_AOT_ESC_STATS=1 时 frame/scalar/str 计数>0（必须命中）。
struct P { x: int, y: int }

function work(n: int): int {
    const acc: Ref<P> = new P { x: 0, y: 0 };
    let i: int = 0;
    while (i < n) {
        acc.x = acc.x + i;
        acc.y = acc.y + acc.x;
        i = i + 1;
    }
    const tag: string = "xy=" + toStr(acc.x) + "/" + toStr(acc.y);
    print(tag);
    return acc.x * 10 + acc.y;
}

struct V { a: int, b: int, c: int }

function valueCopy(n: int): int {
    const v: Ref<V> = new V { a: n, b: n * 2, c: n * 3 };
    let s: int = v.a + v.b + v.c;
    v.a = s;
    return v.a - v.c;
}

export function main(args: []string): int {
    print(toStr(work(5)));
    print(toStr(valueCopy(4)));
    const local: Ref<P> = new P { x: 100, y: -3 };
    print(toStr(local.x + local.y));
    return 0;
}
