< {"jsonrpc":"2.0","id":22,"result":[{"range":{"start":{"line":0,"character":0},"end":{"line":11,"character":0}},"newText":"// lsp-app-main.tx —— LSP 二期多模块 fixture·入口模块（TOOL-47）。\n// 伴本 scripts/lsp-e2e.py 消费：以本模块为根的模块图覆盖依赖模块 lsp-geom.tx。\nimport { Rect, area, UNIT } from \"./lsp-geom\";\n\nexport function main(args: []string): int {\n    const r: Ref< Rect> = new Rect { w: 3, h: UNIT + 3 };\n    const s = area(r);\n    const parts = strSplit(toStr(s), \"|\");\n    print(listLen(parts));\n    return 0;\n}\n"}]}
