// R1-1（V0.19-R1 插队单）：WeakBox 释放后槽位复用误杀存活弱引用。
// forget() 内局部 WeakBox 释放不注销观察表 → weak(b) LIFO 复用同槽；
// a 旧目标释放时 notifyWeakDead 误将该槽（现持有 b 的观察者）判死。
// 期望：目标仍存活，deref 三次均得 B（缺陷态为 B/DEAD/B）。
struct Node { name: string }
function forget(r: Ref<Node>): int { const w = weak(r); return 0; }
export function main(args: []string): int {
    let a = new Node { name: "A" };
    const b = new Node { name: "B" };
    forget(a);
    const wb = weak(b);
    const before = deref(wb) catch Node { name: "DEAD" };
    print(before.name);
    a = new Node { name: "replacement" };
    const after = deref(wb) catch Node { name: "DEAD" };
    print(after.name);
    print(b.name);
    return 0;
}
