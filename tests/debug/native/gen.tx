// 调试薄桩（第 6 轮 6c-2）：生成器体内的断点与步进（Zig 前端不支持生成器，没有 VM 基准）。
function * count(n: int): int {
    let i = 0;
    while (i < n) {
        yield i * 10;
        i = i + 1;
    }
}

export function main(args: []string): int {
    let s = 0;
    for (v in count(3)) {
        s = s + v;
    }
    print(toStr(s));
    return 0;
}
