// 回调与串字段（Windows）：外部结构体里放回调与串字段——
// WNDCLASSEXW 的 lpfnWndProc（回调字段）与 lpszClassName（wstr 字段，类名含中文验 UTF-16）注册窗口类，建消息专用窗口
// （HWND_MESSAGE，不显示），SendMessageW 自定义消息由窗口过程按值回应（创建、发送、销毁期间系统回调窗口过程）；字段赋值
// 换回调与类名再注册一个类；调用后结构体的回调与串字段保持原值（拷回跳过），回调字段照常可从太虚侧直接调用。
declare type HWND;
declare struct WNDCLASSEXW { cbSize: u32, style: u32, lpfnWndProc: (HWND, u32, usize, isize) => isize, cbClsExtra: i32, cbWndExtra: i32, hInstance: usize, hIcon: usize, hCursor: usize, hbrBackground: usize, lpszMenuName: usize, lpszClassName: wstr, hIconSm: usize }
declare function RegisterClassExW(wc: Ref<WNDCLASSEXW>): u16 from "user32";
declare function UnregisterClassW(cls: wstr, inst: usize): i32 from "user32";
declare function GetModuleHandleW(name: usize): usize from "kernel32";
declare function CreateWindowExW(ex: u32, cls: wstr, title: wstr, style: u32, x: i32, y: i32, w: i32, h: i32, parent: isize, menu: usize, inst: usize, param: usize): HWND? from "user32";
declare function SendMessageW(h: HWND, msg: u32, wp: usize, lp: isize): isize from "user32";
declare function DefWindowProcW(h: HWND, msg: u32, wp: usize, lp: isize): isize from "user32";
declare function DestroyWindow(h: HWND): i32 from "user32";

const WM_CREATE: u32 = 1;
const WM_DESTROY: u32 = 2;
const WM_PROBE: u32 = 0x8001;
const HWND_MESSAGE: isize = -3;

let created = 0;
let destroyed = 0;
let probes = 0;

function firstProc(h: HWND, msg: u32, wp: usize, lp: isize): isize {
    if (msg == WM_CREATE) { created = created + 1; }
    if (msg == WM_DESTROY) { destroyed = destroyed + 1; }
    if (msg == WM_PROBE) {
        probes = probes + 1;
        return (wp as int * 10 + lp as int) as isize;
    }
    return DefWindowProcW(h, msg, wp, lp);
}

function secondProc(h: HWND, msg: u32, wp: usize, lp: isize): isize {
    if (msg == WM_PROBE) { return (wp as int * 100 + lp as int) as isize; }
    return DefWindowProcW(h, msg, wp, lp);
}

function probe(cls: string, inst: usize, wp: usize, lp: isize): string {
    const hw = CreateWindowExW(0, cls, "k1", 0, 0, 0, 0, 0, HWND_MESSAGE, 0, inst, 0);
    if (hw == None) { return "create failed"; }
    const h = hw catch handleFromBits<HWND>(0);
    const r = SendMessageW(h, WM_PROBE, wp, lp);
    DestroyWindow(h);
    return toStr(r);
}

function main(args: []string): int {
    const inst = GetModuleHandleW(0);
    const wc = new WNDCLASSEXW { cbSize: 80, style: 0, lpfnWndProc: firstProc, cbClsExtra: 0, cbWndExtra: 0, hInstance: inst, hIcon: 0, hCursor: 0, hbrBackground: 0, lpszMenuName: 0, lpszClassName: "太虚回调探针", hIconSm: 0 };
    print("register " + toStr(RegisterClassExW(wc) != 0));
    print("reply " + probe("太虚回调探针", inst, 7, 5) + " created " + toStr(created) + " destroyed " + toStr(destroyed) + " probes " + toStr(probes));
    const kept = wc.lpfnWndProc;
    print("kept " + wc.lpszClassName + " " + toStr(wc.cbSize) + " " + toStr(kept(handleFromBits<HWND>(0), WM_PROBE, 1, 2)));
    wc.lpfnWndProc = secondProc;
    wc.lpszClassName = "TaixuCallbackSecond";
    print("register2 " + toStr(RegisterClassExW(wc) != 0));
    print("reply2 " + probe("TaixuCallbackSecond", inst, 10, 7));
    print("unregister " + toStr(UnregisterClassW("太虚回调探针", inst) != 0) + " " + toStr(UnregisterClassW("TaixuCallbackSecond", inst) != 0));
    return 0;
}
