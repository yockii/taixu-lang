// ============================================================================
// std/net 平台层的共用部分（D3 v0.23；FFI 与平台层设计 §五-6）。内部模块：只由 net_sys_windows.tx、
// net_sys_linux.tx 引用。
//
// 句柄表在核心仓内核里（__rtHandleAdd／Peek／Take，核心仓线程设计 §十六）：进程级、加锁，任一线程打开的
// 套接字别的线程都能用（模块全局变量每线程一份，原先放在本模块里的 256 项表做不到）；按需倍增，上限 2^24 项。
// 句柄带代数：关闭后旧句柄失效，槽位复用时新句柄与旧的不同，重复关闭或用错句柄不会碰到别的套接字。表满时
// 新连接被关闭并报失败（Zig 宿主的原文此时漏掉套接字）。
// 地址：只收点分十进制的 IPv4（四段、每段 0..255、不带前导零）与 "localhost"（127.0.0.1）。原文经
// inet_addr，还接受 "127.1"、八进制、十六进制等历史写法；这些写法容易被误读，这里一律拒绝。原文的
// localhost 写成了主机序（实际连到 1.0.0.127），这里按本意取 127.0.0.1。
// ============================================================================

// 登记一个系统套接字，返回句柄；表满返回 −1（调用方负责关闭它）。
export function slotAlloc(raw: int): int {
    return __rtHandleAdd(raw);
}

// 句柄上的系统套接字；无效句柄返回 −1。
export function slotPeek(slot: int): int {
    return __rtHandlePeek(slot);
}

// 取出系统套接字并作废句柄；无效句柄返回 −1。
export function slotTake(slot: int): int {
    return __rtHandleTake(slot);
}

function octet(part: string): int {
    const n = len(part);
    if (n == 0 || n > 3) {
        return -1;
    }
    if (n > 1 && (byteAt(part, 0) catch 0) == 48) {
        return -1;
    }
    let v: int = 0;
    let i: int = 0;
    while (i < n) {
        const c = byteAt(part, i) catch 0;
        if (c < 48 || c > 57) {
            return -1;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (v > 255) {
        return -1;
    }
    return v;
}

// sockaddr_in（16 字节，Windows 与 Linux 同布局）：family=AF_INET，端口与地址为网络字节序；
// 地址不合法返回空 Bytes。
export function sockaddrOf(host: string, port: int): Bytes {
    let h: string = host;
    if (h == "localhost") {
        h = "127.0.0.1";
    }
    const parts = strSplit(h, ".");
    if (listLen(parts) != 4) {
        return bytesNew(0);
    }
    const sa = bytesNew(16);
    bytesSet(sa, 0, 2);
    bytesSet(sa, 2, (port >> 8) & 255);
    bytesSet(sa, 3, port & 255);
    let i: int = 0;
    while (i < 4) {
        const v = octet(listGet(parts, i) catch "");
        if (v < 0) {
            return bytesNew(0);
        }
        bytesSet(sa, 4 + i, v);
        i = i + 1;
    }
    return sa;
}

// 监听地址：INADDR_ANY 与端口（0 由系统分配）。
export function sockaddrAny(port: int): Bytes {
    const sa = bytesNew(16);
    bytesSet(sa, 0, 2);
    bytesSet(sa, 2, (port >> 8) & 255);
    bytesSet(sa, 3, port & 255);
    return sa;
}
