// timeout-async —— 异步深化验证（V0.10-A1；D29 §二/§三；verify ⑤ 段负载）。
//
// 断言面（确定性红线：定时器只用 0ms/不到期两确定形态；期望 err 亦为正路径
// ——逐案 helper 返回 1=符合预期，runner 汇总 ALL-OK）：
//   ① timeout 命中（原任务不到期）→ err("timeout")＋原任务清理；
//   ② timeout 不命中透传（f 先完成；60s 定时器收割空操作）；
//   ③ TaskGroup.cancel 组级传播 → drain 全收割（failed 计数＝组规模，零 pending）；
//   ④ 同 deadline 登记序（两 0ms sleeper 唤醒序＝登记序）；
//   ⑤ 异构选择菜谱（标记值统一＋Ref cell 载荷，taskAwaitAny 裁决下标）。
import { taskGroupNew, taskGroupAdd, taskGroupDrain, taskGroupCancel, taskGroupFailed, timeout } from "std/task";

function main(args: []string): int {
    const t = runner();
    print("spawned");
    return 0;
}

async function runner(): int {
    let score: int = 0;
    score = score + (await caseHit() catch 0);
    score = score + (await casePass() catch 0);
    score = score + (await caseGroupCancel() catch 0);
    score = score + (await caseDeadlineOrder() catch 0);
    score = score + (await caseRecipe() catch 0);
    if (score == 5) {
        print("ALL-OK 5/5");
    } else {
        print("DEGRADED: " + toStr(score));
    }
    return 0;
}

// ① timeout 命中：f 挂在不到期定时器上，timeout(f, 0) 即刻裁决 err("timeout")。
async function caseHit(): int {
    const slow = stalled(7);
    const v = await timeout(slow, 0) catch (e) {
        if (e.message == "timeout") {
            print("1 timeout err: timeout");
            return 1;
        }
        print("1 unexpected err: " + e.message);
        return 0;
    };
    print("1 WRONG value: " + toStr(v));
    return 0;
}

// ② timeout 不命中：f 先完成透传（60s 定时器排水空操作——零滞留面）。
async function casePass(): int {
    const fast = quick(42);
    const v = await timeout(fast, 60000) catch (e) {
        print("2 err: " + e.message);
        return 0;
    };
    if (v == 42) {
        print("2 passthrough: 42");
        return 1;
    }
    print("2 WRONG value: " + toStr(v));
    return 0;
}

// ③ TaskGroup.cancel：三个挂起任务组级取消 → drain 全收割零 pending。
async function caseGroupCancel(): int {
    const tg = taskGroupNew();
    taskGroupAdd(tg, stalled(1));
    taskGroupAdd(tg, stalled(2));
    taskGroupAdd(tg, stalled(3));
    taskGroupCancel(tg) catch (e) {
        print("3 cancel err: " + e.message);
        return 0;
    };
    const rs = await taskGroupDrain(tg, 2) catch (e) {
        print("3 drain err: " + e.message);
        return 0;
    };
    const n = listLen(rs);
    const failed = taskGroupFailed(tg);
    if (n == 0 && failed == 3) {
        print("3 cancelled: drained=0 failed=3");
        return 1;
    }
    print("3 WRONG drained=" + toStr(n) + " failed=" + toStr(failed));
    return 0;
}

// ④ 同 deadline 登记序：先登记 a 后登记 b → a 先唤醒（打印序＝登记序）。
async function caseDeadlineOrder(): int {
    const wa = sleeper0("a");
    const wb = sleeper0("b");
    const joined = await both(wa, wb) catch -1;
    if (joined == 0) {
        print("4 joined: 0");
        return 1;
    }
    print("4 WRONG joined: " + toStr(joined));
    return 0;
}

async function sleeper0(tag: string): int {
    await sleepMs(0) catch (e) {
        print("4 sleep err: " + e.message);
        return -1;
    };
    print("4 woke-" + tag);
    return 0;
}

async function both(a: Future<int>, b: Future<int>): int {
    const x = await a catch -1;
    const y = await b catch -1;
    return x + y;
}

// ⑤ 异构选择菜谱：string 源与 int 源经同型标记 runner 统一（载荷先写 cell
// 再完成——胜者载荷在裁决点可见；败者后到写不复读）。
async function caseRecipe(): int {
    const pick = new Pick { v: 0 };
    const wrapped: List<Future<int>> = listNew();
    listPush(wrapped, markString(pick));
    listPush(wrapped, markInt(pick));
    const which = taskAwaitAny(wrapped) catch -1;
    if (which == 1 && pick.v == 99) {
        print("5 which=1 int-source wins");
        return 1;
    }
    print("5 WRONG which=" + toStr(which) + " v=" + toStr(pick.v));
    return 0;
}

struct Pick {
    v: int,
}

// 菜谱 runner A：string 源 → 标记 int（len 载荷经 Ref cell 共享）。
async function markString(cell: Ref<Pick>): int {
    const s = strSrc();
    const got = await s catch "";
    cell.v = len(got);
    return 0;
}

// 菜谱 runner B：int 源 → 标记 int（同型——await_any 同构约束）。
async function markInt(cell: Ref<Pick>): int {
    cell.v = 99;
    return 99;
}

async function strSrc(): string {
    return "tx";
}

async function stalled(n: int): int {
    const s = sleepMs(60000);
    await s catch (e) {
        return err(e.message);
    };
    return n;
}

async function quick(n: int): int {
    return n;
}
