// lsp_builtins.tx —— LSP 的内建表（第 6 轮 6d-3b1，LSP 与 MCP 实施设计 §四-5）：hover、signatureHelp、completion 用。
//
// 签名照 D3 §7 写成 `function 名(类型…): 返回`（D3 没有形参名就不编造，同 Zig 版的形）；说明为一句话。
// scripts/test-lsp-builtins.py 核对：表与 D3 §7 的签名逐条一致，semamirror 的 builtinOf 认的、用户能写的名字表里都有，
// 表里的都认，仅 --toolchain 的标记与 builtinOf 的号段一致。`__rt` 开头的内部内建（只供标准库）不进表。

export struct Builtin {
    name: string,
    sig: string,
    doc: string,
    toolchain: bool, // 仅 --toolchain 构建可用
}

let table: List<Ref<Builtin>> = listNew();

function b(name: string, sig: string, doc: string): void {
    listPush(table, new Builtin { name: name, sig: sig, doc: doc, toolchain: false });
}

function t(name: string, sig: string, doc: string): void {
    listPush(table, new Builtin { name: name, sig: sig, doc: doc, toolchain: true });
}

function fill(): void {
    if (listLen(table) > 0) { return; }
    b("print", "function print(string): void", "标准输出一行");
    b("eprint", "function eprint(string): void", "标准错误输出一行（原样，不加前缀）");
    b("err", "function err(string): Error", "构造 Error");
    b("readFile", "function readFile(string): string | Error", "读文本文件（UTF-8）");
    b("len", "function len(string | []T | [N]T | Bytes): int", "长度（字符串与 Bytes 为字节数）");
    b("toStr", "function toStr(int | float | bool | string | Error): string", "转字符串（Error 得 \"Error: \" 加消息）");
    b("unref", "function unref(Ref<T>): T", "从堆引用整体取值拷贝");
    b("weak", "function weak(Ref<T>): Weak<T>", "构造弱引用（不拥有目标）");
    b("deref", "function deref(Weak<T>): T?", "解引用弱引用：目标存活得值拷贝，已死得 None");
    b("byteAt", "function byteAt(string, int): int?", "逐字节访问：在界得字节值，越界得 None");
    b("utf8Encode", "function utf8Encode(int): string | Error", "码点转 UTF-8 串，非法码点得 Error");
    b("listNew", "function listNew<T>(): List<T>", "空表；T 经期望类型推断");
    b("listPush", "function listPush(List<T>, T): void", "尾追加");
    b("listPop", "function listPop(List<T>): T?", "尾弹出（空表得 None）");
    b("listGet", "function listGet(List<T>, int): T?", "索引读（越界得 None）");
    b("listSet", "function listSet(List<T>, int, T): void", "索引写（越界 trap）");
    b("listLen", "function listLen(List<T>): int", "长度");
    b("listRemoveAt", "function listRemoveAt(List<T>, int): void", "索引删除（越界 trap）");
    b("listInsert", "function listInsert(List<T>, int, T): void", "插入（i 等于长度即尾加；越界 trap）");
    b("strSub", "function strSub(string, int, int): string", "按码点取子串 strSub(s, from, count)（越界 trap）");
    b("strIndexOf", "function strIndexOf(string, string): int", "子串首现的码点索引；没有得 -1");
    b("strSplit", "function strSplit(string, string): List<string>", "按分隔符切分（空分隔符 trap）");
    b("imul", "function imul(int, int): int", "64 位环绕乘");
    b("wrapTo", "function wrapTo<T>(整数): T", "截断转换：取低位按整数类型 T 解释，不检查；类型实参须写出");
    b("wrapAdd", "function wrapAdd<T>(T, T): T", "按整数类型 T 的宽度环绕加");
    b("wrapSub", "function wrapSub<T>(T, T): T", "按整数类型 T 的宽度环绕减");
    b("wrapMul", "function wrapMul<T>(T, T): T", "按整数类型 T 的宽度环绕乘");
    b("floatToBits", "function floatToBits(float): int", "双精度的 64 位模式");
    b("floatFromBits", "function floatFromBits(int): float", "由 64 位模式构造双精度值");
    b("handleBits", "function handleBits(H): int", "句柄的数值");
    b("handleFromBits", "function handleFromBits<H>(整数): H", "由数值构造句柄；类型实参须写出");
    b("ffiLastError", "function ffiLastError(): int", "最近一次库函数调用后保存的系统错误码");
    b("taskCancel", "function taskCancel(Future<T>): void", "协作式取消任务");
    b("taskCancelled", "function taskCancelled(): bool", "当前任务是否已被取消");
    b("taskAwaitAny", "function taskAwaitAny(List<Future<T>>): int | Error", "等任一任务完成或取消，得其下标");
    b("genNext", "function genNext(Gen<T>): T?", "取生成器的下一个值；结束后得 None");
    b("listDir", "function listDir(string): List<string> | Error", "目录里的条目名（不含 . 与 ..，按字节序）；打不开得 Error");
    b("entryKind", "function entryKind(string): int", "条目类型（不跟随符号链接）：0 不可判、1 文件、2 目录、3 符号链接");
    b("writeFile", "function writeFile(string, string): void | Error", "写文本文件（覆盖写）");
    b("writeFileBytes", "function writeFileBytes(string, List<int>): void | Error", "写二进制文件（覆盖写；元素须在 0..255）");
    b("bytesNew", "function bytesNew(int): Bytes", "长度为 n 的全零 Bytes");
    b("bytesLen", "function bytesLen(Bytes): int", "长度");
    b("bytesGet", "function bytesGet(Bytes, int): int?", "读字节（越界得 None）");
    b("bytesSet", "function bytesSet(Bytes, int, int): void", "写字节（越界或值不在 0..255 trap）");
    b("bytesPush", "function bytesPush(Bytes, int): void", "尾追加一个字节");
    b("bytesAppend", "function bytesAppend(Bytes, Bytes): void", "把第二个的内容追加到第一个");
    b("bytesSlice", "function bytesSlice(Bytes, int, int): Bytes", "拷贝出 bytesSlice(b, from, count)（越界 trap）");
    b("bytesEqual", "function bytesEqual(Bytes, Bytes): bool", "内容逐字节相等");
    b("bytesCopy", "function bytesCopy(Bytes, int, Bytes, int, int): void", "bytesCopy(dst, at, src, from, count)：区间拷贝，可重叠（越界 trap）");
    b("bytesFill", "function bytesFill(Bytes, int, int, int): void", "bytesFill(b, at, count, value)：区间填充（越界或值不在 0..255 trap）");
    b("bytesGetLE", "function bytesGetLE<T>(Bytes, int): T?", "按小端读定宽数值；类型实参须写出，越界得 None");
    b("bytesGetBE", "function bytesGetBE<T>(Bytes, int): T?", "按大端读定宽数值；类型实参须写出，越界得 None");
    b("bytesSetLE", "function bytesSetLE<T>(Bytes, int, T): void", "按小端写定宽数值；值须正是 T（越界 trap）");
    b("bytesSetBE", "function bytesSetBE<T>(Bytes, int, T): void", "按大端写定宽数值；值须正是 T（越界 trap）");
    b("bytesFromStr", "function bytesFromStr(string): Bytes", "字符串的 UTF-8 字节拷贝");
    b("bytesToStr", "function bytesToStr(Bytes): string | Error", "严格 UTF-8 校验后构造字符串");
    b("readFileBytes", "function readFileBytes(string): Bytes | Error", "读二进制文件");
    b("embedBytes", "function embedBytes(字符串字面量): Bytes", "编译期嵌入文件（路径相对当前源文件）");
    b("bytesAsList", "function bytesAsList(Bytes): List<u8>", "零拷贝把 Bytes 当作 List<u8> 用（同一个对象）");
    b("listAsBytes", "function listAsBytes(List<u8>): Bytes", "零拷贝把 List<u8> 当作 Bytes 用（同一个对象）");
    b("errAs", "function errAs<E>(Error): E?", "取回错误 enum 种类，不是该种类得 None；类型实参须写出");
    b("errWrap", "function errWrap(Error, string): Error", "包一层上下文，结果的 cause 为原错误");
    b("makeDir", "function makeDir(string): void | Error", "创建单层目录（已存在的目录视为成功）");
    t("writeExecutable", "function writeExecutable(string, List<int>): void | Error", "写出可执行文件");
    t("hostTarget", "function hostTarget(): string", "编译目标平台 \"windows\" 或 \"linux\"");
    t("hostArch", "function hostArch(): string", "编译目标架构 \"x86_64\" 或 \"aarch64\"");
    t("getEnv", "function getEnv(string): string?", "读环境变量；未设置得 None");
    t("setEnv", "function setEnv(string, string): void | Error", "设置环境变量（与 getEnv 同一张表）；此后起的子进程带上；名字为空、含 = 或 NUL，或值含 NUL 时得 Error");
    t("runProcess", "function runProcess(string, List<string>, string): int | Error", "启动子进程并等它结束，得退出码");
    t("tempDir", "function tempDir(): string", "临时目录");
    t("removeFile", "function removeFile(string): void | Error", "删除文件");
    t("selfExePath", "function selfExePath(): string", "当前可执行文件的路径");
    t("monoNs", "function monoNs(): int", "单调时钟纳秒");
    t("stdinRead", "function stdinRead(Bytes, int): int", "读本进程标准输入进缓冲");
    t("stdoutWrite", "function stdoutWrite(Bytes): int", "把数据原样写到本进程标准输出");
    t("procSpawnLimited", "function procSpawnLimited(string, List<string>, string, int, int, int): int | Error", "按系统内存字节数／CPU 秒数硬限额启动子进程；不是沙箱");
    t("readLocalFileBytes", "function readLocalFileBytes(string, string, int): Bytes | Error", "从本地根按句柄读取，拒绝链接与超限");
    t("localListDir", "function localListDir(string, string): List<string> | Error", "本地根内句柄式目录列举：拒绝链接、重解析点与根外；按字节排序，不含 . 与 ..");
    t("localEntryKind", "function localEntryKind(string, string): int", "本地根内句柄式类型查询：0 拒绝／不存在，1 文件，2 目录");
    t("localFileSize", "function localFileSize(string, string): int | Error", "本地根内句柄式文件大小查询");
    t("procSpawn", "function procSpawn(string, List<string>, string, int): int | Error", "起子进程，得句柄");
    t("procTryWrite", "function procTryWrite(int, int, Bytes): int", "单次非阻塞写；部分字节、暂不可写 0、关闭或错误 −1");
    t("procWrite", "function procWrite(int, int, Bytes): int", "写子进程的 stdin 或控制通道");
    t("procRead", "function procRead(int, int, Bytes): int", "不阻塞地读子进程的输出");
    t("ioWait", "function ioWait(int, int, int): int", "等所选来源之一可读");
    t("procKill", "function procKill(int): void", "强制结束子进程");
    t("procWait", "function procWait(int, int): int?", "等子进程退出，得退出码；超时得 None");
    t("procClose", "function procClose(int): void", "结束并回收子进程、释放句柄");
    t("currentDir", "function currentDir(): string | Error", "当前工作目录的绝对路径");
    t("fileSize", "function fileSize(string): int | Error", "普通文件的字节数（只取元数据）");
    b("nowMs", "function nowMs(): int", "墙钟毫秒");
    b("sleepMs", "function sleepMs(int): Future<void>", "定时器：到期后完成的 future");
    b("assert", "function assert(bool, string): void", "断言：失败即测试失败或程序 panic");
    b("panic", "function panic(string): void", "不可恢复，打印消息并以非零退出");
    b("threadSpawn", "function threadSpawn(() => T): Thread<T>", "在新线程里运行无参函数值（捕获深拷贝进去）");
    b("threadJoin", "function threadJoin(Thread<T>): T | Error", "等线程结束并取回结果");
    b("sharedNew", "function sharedNew(T): Shared<T>", "对象图深拷贝进共享区");
    b("sharedGet", "function sharedGet(Shared<T>): T", "取出冻结的共享对象图");
    b("atomicNew", "function atomicNew(int): Atomic<int>", "新的原子整数");
    b("atomicLoad", "function atomicLoad(Atomic<int>): int", "原子读");
    b("atomicStore", "function atomicStore(Atomic<int>, int): void", "原子写");
    b("atomicAdd", "function atomicAdd(Atomic<int>, int): int", "原子加，得旧值");
    b("atomicCas", "function atomicCas(Atomic<int>, int, int): bool", "比较并交换，得是否换成");
}

export function builtins(): List<Ref<Builtin>> {
    fill();
    return table;
}

export function builtinNamed(name: string): Ref<Builtin>? {
    fill();
    for (x in table) {
        if (x.name == name) { return x; }
    }
    return None;
}
