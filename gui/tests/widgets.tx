// widgets 框架用例（守护面）：T1 五件＋T2 数据面＋T3 结构
// 件的确定性绘制（Canvas 占位块轨——同组件序列 → 同像素 sha256 锚）＋逐控件
// hit 边界（含越界/边界值）。纯无头面（surface 原语软件光栅，四目标可用）。
import { Canvas, canvasNew, blockPainter, checkbox, radioGroup, progress, dropdown, groupBox, slider, scrollView, tooltip, messageBox, wrapText, drawCheckbox, drawRadioGroup, drawProgress, drawDropdown, drawDropdownList, drawSeparator, drawGroupBox, drawSlider, drawTooltip, drawMultiline, scrollDraw, drawModal, hitCheckbox, hitRadioGroup, hitDropdown, hitSlider, hitScrollbar, modalHit, keyChar, paintText, paintFillRect, sliderValueAt, EV_KEY_DOWN, EV_MOUSE_UP, KEY_BACK, KEY_RETURN } from "gui/components";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256, surfaceProject } from "gui/surface";

export function main(args: []string): int {
    args;
    const s = surfaceOpen(200, 180) catch (e) {
        print("surface open failed: " + e.message);
        return 1;
    };
    surfaceClear(s, 0x202040);
    const cv = canvasNew(s, 200, 180);

    // —— T1：checkbox（双态绘制）——
    const cb1 = checkbox(1, 6, 6, "enable", true);
    const cb2 = checkbox(2, 6, 24, "off", false);
    drawCheckbox(cv, cb1);
    drawCheckbox(cv, cb2);
    // hit 边界：盒内/标签尾/越界/边界值。
    print("cb_hit_in=" + toStr(hitCheckbox(cb1, 8, 10)));
    print("cb_hit_label=" + toStr(hitCheckbox(cb1, 6 + 16 + 30, 10)));
    print("cb_hit_out=" + toStr(hitCheckbox(cb1, 200, 10)));
    print("cb_hit_edge=" + toStr(hitCheckbox(cb1, 6 + 16 + len(cb1.label) * 8, 10)));

    // —— T1：radioGroup（线绘八边形近似；互斥）——
    const items: List<string> = listNew();
    listPush(items, "red");
    listPush(items, "green");
    listPush(items, "blue");
    const rg = radioGroup(3, 6, 44, items, 1);
    drawRadioGroup(cv, rg);
    print("rg_hit_row0=" + toStr(hitRadioGroup(rg, 10, 48)));
    print("rg_hit_row2=" + toStr(hitRadioGroup(rg, 10, 76)));
    print("rg_hit_neg=" + toStr(hitRadioGroup(rg, 10, 0)));
    print("rg_hit_over=" + toStr(hitRadioGroup(rg, 10, 200)));

    // —— T1：progress（确定 3/4＋不确定负值）——
    const pg = progress(4, 6, 92, 90, 3, 4);
    drawProgress(cv, pg);
    const pgInd = progress(5, 6, 110, 90, -1, 0);
    drawProgress(cv, pgInd);

    // —— T1：dropdown（收起＋展开两态；展开列表走浮层位 drawDropdownList）——
    const dd = dropdown(6, 110, 6, 80, items, 0);
    drawDropdown(cv, dd);
    dd.open = true;
    drawDropdownList(cv, dd);
    dd.open = false;
    print("dd_hit_field=" + toStr(hitDropdown(dd, 120, 10)));
    print("dd_hit_closed=" + toStr(hitDropdown(dd, 120, 34)));
    dd.open = true;
    print("dd_hit_row1_open=" + toStr(hitDropdown(dd, 120, 34)));
    print("dd_hit_out=" + toStr(hitDropdown(dd, 5, 34)));
    dd.open = false;

    // —— T1：separator＋groupBox（标题留隙顶边）——
    drawSeparator(cv, 110, 44, 80);
    const gb = groupBox(7, 110, 52, 80, 34, "grp");
    drawGroupBox(cv, gb);
    paintText(cv, 118, 62, 0x000000, "in");

    // —— T2：slider（knob 中位）＋tooltip 面板绘制——
    const sl = slider(8, 110, 96, 80, 0, 100, 50);
    drawSlider(cv, sl);
    print("sl_hit_in=" + toStr(hitSlider(sl, 150, 105)));
    print("sl_hit_out=" + toStr(hitSlider(sl, 300, 105)));
    print("sl_val_l=" + toStr(sliderValueAt(sl, 110)));
    print("sl_val_r=" + toStr(sliderValueAt(sl, 500)));
    const tt = tooltip("hover tip", 3);
    tt.x = 20;
    tt.y = 120;
    drawTooltip(cv, tt);

    // —— T3：multiline（双轨度量折行）＋scrollContainer 裁剪——
    const mlH: int = drawMultiline(cv, 6, 132, 88, 10, "the quick brown fox jumps", 0x000000);
    print("ml_h=" + toStr(mlH));
    const lines: List<string> = wrapText(cv, "wrap me into pieces now", 48);
    print("wrap_n=" + toStr(listLen(lines)));
    const sv = scrollView(9, 110, 120, 80, 50, 130);
    scrollDraw(cv, sv, (child: Ref<Canvas>): void => {
            paintFillRect(child, 0, 0, 200, 130, 0x30305A);
            paintText(child, 4, 6, 0xFFFFFF, "row0");
            paintText(child, 4, 60, 0xFFFFFF, "row5");
            paintText(child, 4, 120, 0xFFFFFF, "row10");
        });
    print("sv_scroll0=" + toStr(sv.scroll_y));
    print("svbar_hit=" + toStr(hitScrollbar(sv, 110 + 80 - 2, 130)));
    print("svbar_miss=" + toStr(hitScrollbar(sv, 100, 130)));

    // —— T3：messageBox（模态面板＋按钮命中区随布局重建）——
    const mbtns: List<string> = listNew();
    listPush(mbtns, "ok");
    listPush(mbtns, "cancel");
    const mb = messageBox("save?", "changes not saved", mbtns);
    drawModal(cv, mb);
    print("mb_zones=" + toStr(listLen(mb.zones)));
    print("mb_geo=" + toStr(mb.x) + "," + toStr(mb.y) + "," + toStr(mb.w) + "," + toStr(mb.h));
    // 按钮右对齐布局：ok 区在 cancel 区左侧（正命中两点＋域外点）。
    print("mb_hit_ok=" + toStr(modalHit(mb, mb.x + 60, mb.y + mb.h - 14)));
    print("mb_hit_cancel=" + toStr(modalHit(mb, mb.x + mb.w - 20, mb.y + mb.h - 14)));
    print("mb_hit_out=" + toStr(modalHit(mb, 0, 0)));

    // —— T2：基础字符集（VK 直映；修饰键限制面）——
    print("key_a=" + keyChar(65) + " key_z=" + keyChar(90) + " key_5=" + keyChar(53));
    print("key_sem=" + keyChar(186) + " key_none=" + toStr(len(keyChar(16))));
    print("kinds=" + toStr(EV_KEY_DOWN) + "," + toStr(EV_MOUSE_UP) + " keys=" + toStr(KEY_BACK) + "," + toStr(KEY_RETURN));
    print("block_width=" + toStr(blockPainter().width("abcd")));
    print("sha256=" + surfaceSha256(s));
    print(surfaceProject(s));
    surfaceClose(s);
    return 0;
}
