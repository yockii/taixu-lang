// D3 v0.51 §6.4-5：struct 类型的 let 局部是一份拷贝，对它的字段写入之后在任何路径上都再未被读取、传出、
// 返回或被闭包捕获，报 3036；含只经值类型（struct 字段、定长数组元素）走到的写入、只在某条分支上无效的写入，
// 以及被之后的整体赋值覆盖的写入。
struct In { v: int }
struct T { id: int, score: int, inner: In, arr: [2]int }

function lost(xs: List<T>): void {
    let t = listGet(xs, 0);
    t.score = 100;
}

function nested(xs: List<T>): int {
    let t = listGet(xs, 0);
    const n = t.score;
    t.inner.v = 5;
    t.arr[0] = 1;
    return n;
}

function branch(xs: List<T>, c: bool): void {
    let t = listGet(xs, 0);
    if (c) {
        t.score = 1;
    } else {
        print(toStr(t.score));
    }
}

function overwritten(xs: List<T>): int {
    let t = listGet(xs, 0);
    t.score = 2;
    t = listGet(xs, 0);
    return t.score;
}

export function main(args: []string): int {
    return 0;
}
