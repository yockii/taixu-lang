// TLS 1.3 / SHA-256 密钥调度，RFC 8446 §7；不维护握手转录或连接状态。
import { hkdfExtractSha256, hkdfExpandSha256 } from "./crypto/hkdf";
import { hmacSha256 } from "./crypto/hmac";
import { sha256Sum } from "./hash";
import { constantTimeEqual } from "./crypto/subtle";

export struct Tls13HandshakeSecrets { handshake: Bytes, client: Bytes, server: Bytes }
export struct Tls13ApplicationSecrets { master: Bytes, client: Bytes, server: Bytes }

export function tls13ExpandLabel(secret: Bytes, label: string, context: Bytes, length: int): Bytes | Error {
    if (bytesLen(secret) != 32 || len(label) < 1 || len(label) > 249 || bytesLen(context) > 255 || length < 0 || length > 8160) {
        return err("tls13: invalid HKDF label parameters");
    }
    const full = bytesFromStr("tls13 " + label);
    const info = bytesNew(3);
    bytesSet(info, 0, length / 256); bytesSet(info, 1, length % 256); bytesSet(info, 2, bytesLen(full));
    bytesAppend(info, full);
    const contextLength = bytesNew(1); bytesSet(contextLength, 0, bytesLen(context));
    bytesAppend(info, contextLength); bytesAppend(info, context);
    return hkdfExpandSha256(secret, info, length);
}

export function tls13DeriveSecret(secret: Bytes, label: string, transcriptHash: Bytes): Bytes | Error {
    if (bytesLen(transcriptHash) != 32) { return err("tls13: SHA-256 transcript must contain 32 bytes"); }
    return tls13ExpandLabel(secret, label, transcriptHash, 32);
}

export function tls13Finished(trafficSecret: Bytes, transcriptHash: Bytes): Bytes | Error {
    if (bytesLen(transcriptHash) != 32) { return err("tls13: invalid Finished transcript hash"); }
    const key = tls13ExpandLabel(trafficSecret, "finished", bytesNew(0), 32)?;
    return hmacSha256(key, transcriptHash);
}

export function tls13UpdateSecret(trafficSecret: Bytes): Bytes | Error { return tls13ExpandLabel(trafficSecret, "traffic upd", bytesNew(0), 32); }

// 无 PSK 的 32 字节 ECDH 结果；组的点校验由 ECDH 层负责，这里另拒绝全零输入。
// helloHash 包含 ClientHello 和 ServerHello（HRR 情形由握手机转换转录）。
export function tls13HandshakeSecrets(shared: Bytes, helloHash: Bytes): Tls13HandshakeSecrets | Error {
    if (bytesLen(shared) != 32 || constantTimeEqual(shared, bytesNew(32))) { return err("tls13: invalid ECDH shared secret"); }
    const early = hkdfExtractSha256(bytesNew(32), bytesNew(32));
    const derived = tls13DeriveSecret(early, "derived", sha256Sum(bytesNew(0)))?;
    const handshake = hkdfExtractSha256(derived, shared);
    return Tls13HandshakeSecrets { handshake: handshake,
        client: tls13DeriveSecret(handshake, "c hs traffic", helloHash)?, server: tls13DeriveSecret(handshake, "s hs traffic", helloHash)? };
}

// serverFinishedHash 是服务端 Finished 之后的转录；不能只传 helloHash。
export function tls13ApplicationSecrets(handshake: Bytes, serverFinishedHash: Bytes): Tls13ApplicationSecrets | Error {
    const derived = tls13DeriveSecret(handshake, "derived", sha256Sum(bytesNew(0)))?;
    const master = hkdfExtractSha256(derived, bytesNew(32));
    return Tls13ApplicationSecrets { master: master,
        client: tls13DeriveSecret(master, "c ap traffic", serverFinishedHash)?, server: tls13DeriveSecret(master, "s ap traffic", serverFinishedHash)? };
}
