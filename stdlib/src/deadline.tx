import { sysMonotonicNs } from "./clock_sys";

export function monotonicNs(): int | Error {
    const now = sysMonotonicNs(); if (now < 0) { return err("clock: monotonic clock unavailable"); } return now;
}
export function deadlineAfterMs(milliseconds: int): int | Error {
    const now = monotonicNs()?;
    if (milliseconds < 0 || milliseconds > (9223372036854775807 - now) / 1000000) { return err("clock: invalid deadline duration"); }
    return now + milliseconds * 1000000;
}
export function deadlineRemainingMs(deadline: int): int | Error {
    if (deadline < 0) { return err("clock: negative absolute deadline"); }
    const left = deadline - monotonicNs()?;
    if (left <= 0) { return 0; }
    let milliseconds = left / 1000000; if (left % 1000000 != 0) { milliseconds = milliseconds + 1; }
    if (milliseconds > 2147483647) { milliseconds = 2147483647; } return milliseconds;
}
