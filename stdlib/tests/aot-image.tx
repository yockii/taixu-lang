// V0.40-S1 AOT 双路锚：std/compress＋std/image 纯 .tx 面（STD-11/12——
// 零 extern 负载；interp↔产物 stdout 逐字节＝AOT 编译面回归锚）。
// 向量与 tests/compress-fx.tx／image-fx.tx 同源（tests/vectors/ 冻结产物）。
import { zlibDecompress, gzipCompressStore, gzipDecompress, adler32 } from "std/compress";
import { decodePngHex } from "std/image";
import { PngImage } from "std/image";

// zlib_l9:p_rep（官方向量）。
const Z: string = "78da2b49ccac285528c14126e7e71614a516176332006cd015fc";
// filters8x5（filter 0–4 全形态 fixture）。
const PNG: string = "89504e470d0a1a0a0000000d49484452000000080000000508060000007891ad55000000504944415478da6390656038a1c71a7dd09e6bdbae007ec1cd8922396b8a248f2f6d96539a3745b9763aa3862aef6941d6e89fb83013b72a2f333eccacea2595c5276af20f82b7fc4367b38055b2e2c6008023253c9036e6790000000049454e44ae426082";
const PNG_FNV: int = -8687800423744494107;
const WANT_ADLER: int = 1825576444;

export function main(args: []string): int {
    args;
    const z: List<int> = hexBytes(Z);
    const zr: List<int> = zlibDecompress(z) catch panic("zlibDecompress");
    print("zlib len=" + toStr(listLen(zr)) + " adler=" + toStr(adler32(zr)));
    assert(adler32(zr) == WANT_ADLER, "adler32 锚");
    const g: List<int> = gzipDecompress(gzipCompressStore(zr)) catch panic("gzip roundtrip");
    print("gzip roundtrip len=" + toStr(listLen(g)));
    const img: PngImage = decodePngHex(PNG) catch panic("decodePng");
    let h: int = -3750763034362895579;
    for (b in img.pixels) {
        h = imul(h ^ b, 1099511628211);
    }
    print("png " + toStr(img.width) + "x" + toStr(img.height) + " fnv=" + toStr(h));
    assert(h == PNG_FNV, "png 像素面 fnv 锚");
    return 0;
}

function hexBytes(s: string): List<int> {
    const t: List<int> = listNew();
    const n: int = len(s);
    let i: int = 0;
    while (i + 1 < n) {
        const hi: int = hexVal(byteAt(s, i) catch -1);
        const lo: int = hexVal(byteAt(s, i + 1) catch -1);
        if (hi < 0 || lo < 0) {
            panic("向量十六进制非法");
        }
        listPush(t, hi * 16 + lo);
        i = i + 2;
    }
    return t;
}

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    return -1;
}
