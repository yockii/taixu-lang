// NRT M2d: string, UTF-8, Ref/Weak and small value builtins, plus the shared
// span helpers (concatenate, digits, UTF-8 count/skip, byte search, list
// building). Messages mirror src/tools/aot_shim.zig byte for byte.
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtDivMod, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtCall5, rtCall6, rtCallList, rtRet, rtRetVoid } from "./rtfn";
import { ARITY, check, text, memcpyName, fatal, trapText, trapAt, arity, argTag, strSpan } from "./nrt_base";

export const NRT_TEXT_EXPORTS: string = "__tx_nrt_list_make __tx_nrt_list_add __tx_bi_len __tx_bi_byte_at __tx_bi_eprint __tx_bi_unref __tx_bi_weak __tx_bi_deref __tx_bi_utf8_encode __tx_bi_str_sub __tx_bi_str_index_of __tx_bi_str_split __tx_str_concat_fr __tx_str_concat_host";

function emitSpanHelpers(b: Ref<StructuredBuffer>): void {
    // __tx_nrt_cat3(ap, an, bp, bn, cp, cn, kind) → new str (1) / err (2) owning a+b+c.
    let f = rtBegin(b, "__tx_nrt_cat3", "ap an bp bn cp cn kind", "q t w", 4, "bootstrap/selfhost/nrt_text.tx");
    rtOp(f, "t", L("an"), "add", L("bn")); rtOp(f, "t", L("t"), "add", L("cn"));
    rtSet(f, "q", I(0));
    rtIf(f, L("t"), "eq", I(0), "make");
    rtCall2(f, "q", "__tx_native_mem_alloc", L("t"), I(1));
    rtIf(f, L("q"), "eq", I(0), "oom");
    rtSet(f, "w", L("q"));
    rtCall3(f, "", memcpyName(), L("w"), L("ap"), L("an")); rtOp(f, "w", L("w"), "add", L("an"));
    rtCall3(f, "", memcpyName(), L("w"), L("bp"), L("bn")); rtOp(f, "w", L("w"), "add", L("bn"));
    rtCall3(f, "", memcpyName(), L("w"), L("cp"), L("cn"));
    rtLabel(f, "make");
    rtIf(f, L("kind"), "ne", I(1), "bytes");
    rtCall3(f, "q", "__tx_store_new_str_take", L("q"), L("t"), I(0));
    rtRet(f, L("q"));
    rtLabel(f, "bytes");
    rtIf(f, L("q"), "ne", I(0), "have");
    rtSet(f, "q", I(1));
    rtLabel(f, "have");
    rtCall4(f, "q", "__tx_nrt_new_bytes", L("kind"), L("q"), L("t"), I(0));
    rtRet(f, L("q"));
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRetVoid(f); check(f);

    // __tx_nrt_digits(v, base, out) → count; digits right-aligned in out[0..32]
    // (uppercase hex, "-" for negatives). Works on the non-positive side so
    // the minimum int formats without overflow.
    f = rtBegin(b, "__tx_nrt_digits", "v base out", "c neg q r d", 0, "bootstrap/selfhost/nrt_text.tx");
    rtOp(f, "c", L("out"), "add", I(32));
    rtSet(f, "neg", I(0));
    rtIf(f, L("v"), "lt", I(0), "negative");
    rtOp(f, "v", I(0), "sub", L("v"));
    rtJump(f, "loop");
    rtLabel(f, "negative"); rtSet(f, "neg", I(1));
    rtLabel(f, "loop");
    rtDivMod(f, "q", "r", L("v"), L("base"));
    rtOp(f, "d", I(0), "sub", L("r"));
    rtIf(f, L("d"), "lt", I(10), "dec");
    rtOp(f, "d", L("d"), "add", I(55)); rtJump(f, "put");
    rtLabel(f, "dec"); rtOp(f, "d", L("d"), "add", I(48));
    rtLabel(f, "put");
    rtOp(f, "c", L("c"), "sub", I(1)); rtStore(f, L("c"), 0, L("d"), 1);
    rtSet(f, "v", L("q"));
    rtIf(f, L("v"), "ne", I(0), "loop");
    rtIf(f, L("neg"), "eq", I(0), "done");
    rtOp(f, "c", L("c"), "sub", I(1)); rtStore(f, L("c"), 0, I(45), 1);
    rtLabel(f, "done");
    rtOp(f, "d", L("out"), "add", I(32)); rtOp(f, "d", L("d"), "sub", L("c"));
    rtRet(f, L("d")); check(f);

    // __tx_nrt_utf8_count(p, n) → code points, or -1 when not valid UTF-8
    // (std.unicode.utf8CountCodepoints: no overlongs, surrogates or > U+10FFFF).
    // Like std's, eight ASCII bytes at a time first (0x8080808080808080 mask).
    f = rtBegin(b, "__tx_nrt_utf8_count", "p n", "i c x y e t lo hi", 0, "bootstrap/selfhost/nrt_text.tx");
    rtSet(f, "i", I(0)); rtSet(f, "c", I(0));
    rtLabel(f, "loop");
    rtIf(f, L("i"), "ge", L("n"), "done");
    rtOp(f, "t", L("i"), "add", I(8)); rtIf(f, L("t"), "gt", L("n"), "slow");
    rtOp(f, "t", L("p"), "add", L("i")); rtLoad(f, "x", L("t"), 0, 8);
    rtOp(f, "x", L("x"), "and", I(-9187201950435737472)); rtIf(f, L("x"), "ne", I(0), "slow");
    rtOp(f, "i", L("i"), "add", I(8)); rtOp(f, "c", L("c"), "add", I(8)); rtJump(f, "loop");
    rtLabel(f, "slow");
    rtOp(f, "t", L("p"), "add", L("i")); rtLoad(f, "x", L("t"), 0, 1);
    rtIf(f, L("x"), "lt", I(128), "one");
    rtIf(f, L("x"), "lt", I(194), "bad");
    rtSet(f, "lo", I(128)); rtSet(f, "hi", I(191));
    rtIf(f, L("x"), "lt", I(224), "two");
    rtIf(f, L("x"), "lt", I(240), "three");
    rtIf(f, L("x"), "lt", I(245), "four");
    rtLabel(f, "bad"); rtRet(f, I(-1));
    rtLabel(f, "one"); rtOp(f, "i", L("i"), "add", I(1)); rtOp(f, "c", L("c"), "add", I(1)); rtJump(f, "loop");
    rtLabel(f, "two"); rtOp(f, "e", L("i"), "add", I(2)); rtJump(f, "lead");
    rtLabel(f, "three"); rtOp(f, "e", L("i"), "add", I(3));
    rtIf(f, L("x"), "ne", I(224), "t1"); rtSet(f, "lo", I(160));
    rtLabel(f, "t1"); rtIf(f, L("x"), "ne", I(237), "lead"); rtSet(f, "hi", I(159)); rtJump(f, "lead");
    rtLabel(f, "four"); rtOp(f, "e", L("i"), "add", I(4));
    rtIf(f, L("x"), "ne", I(240), "f1"); rtSet(f, "lo", I(144));
    rtLabel(f, "f1"); rtIf(f, L("x"), "ne", I(244), "lead"); rtSet(f, "hi", I(143));
    rtLabel(f, "lead");
    rtIf(f, L("e"), "gt", L("n"), "bad");
    rtLoad(f, "y", L("t"), 1, 1);
    rtIf(f, L("y"), "lt", L("lo"), "bad"); rtIf(f, L("y"), "gt", L("hi"), "bad");
    rtOp(f, "i", L("i"), "add", I(2));
    rtLabel(f, "cont");
    rtIf(f, L("i"), "ge", L("e"), "next");
    rtOp(f, "t", L("p"), "add", L("i")); rtLoad(f, "y", L("t"), 0, 1);
    rtIf(f, L("y"), "lt", I(128), "bad"); rtIf(f, L("y"), "gt", I(191), "bad");
    rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "cont");
    rtLabel(f, "next"); rtOp(f, "c", L("c"), "add", I(1)); rtJump(f, "loop");
    rtLabel(f, "done"); rtRet(f, L("c")); check(f);

    // __tx_nrt_utf8_skip(p, k) → byte offset after k code points of valid UTF-8.
    // k >= 8 remaining code points guarantee 8 readable bytes: skip ASCII by eight.
    f = rtBegin(b, "__tx_nrt_utf8_skip", "p k", "i x t", 0, "bootstrap/selfhost/nrt_text.tx");
    rtSet(f, "i", I(0));
    rtLabel(f, "loop");
    rtIf(f, L("k"), "le", I(0), "done");
    rtIf(f, L("k"), "lt", I(8), "slow");
    rtOp(f, "t", L("p"), "add", L("i")); rtLoad(f, "x", L("t"), 0, 8);
    rtOp(f, "x", L("x"), "and", I(-9187201950435737472)); rtIf(f, L("x"), "ne", I(0), "slow");
    rtOp(f, "i", L("i"), "add", I(8)); rtOp(f, "k", L("k"), "sub", I(8)); rtJump(f, "loop");
    rtLabel(f, "slow");
    rtOp(f, "t", L("p"), "add", L("i")); rtLoad(f, "x", L("t"), 0, 1);
    rtOp(f, "i", L("i"), "add", I(1));
    rtIf(f, L("x"), "lt", I(128), "step");
    rtOp(f, "i", L("i"), "add", I(1));
    rtIf(f, L("x"), "lt", I(224), "step");
    rtOp(f, "i", L("i"), "add", I(1));
    rtIf(f, L("x"), "lt", I(240), "step");
    rtOp(f, "i", L("i"), "add", I(1));
    rtLabel(f, "step"); rtOp(f, "k", L("k"), "sub", I(1)); rtJump(f, "loop");
    rtLabel(f, "done"); rtRet(f, L("i")); check(f);

    // __tx_nrt_find(hp, hn, np, nn) → first byte position of needle (nn > 0) or -1.
    f = rtBegin(b, "__tx_nrt_find", "hp hn np nn", "i j last x y t", 0, "bootstrap/selfhost/nrt_text.tx");
    rtOp(f, "last", L("hn"), "sub", L("nn"));
    rtSet(f, "i", I(0));
    rtLabel(f, "outer");
    rtIf(f, L("i"), "gt", L("last"), "none");
    rtSet(f, "j", I(0));
    rtLabel(f, "inner");
    rtIf(f, L("j"), "ge", L("nn"), "found");
    rtOp(f, "t", L("hp"), "add", L("i")); rtOp(f, "t", L("t"), "add", L("j")); rtLoad(f, "x", L("t"), 0, 1);
    rtOp(f, "t", L("np"), "add", L("j")); rtLoad(f, "y", L("t"), 0, 1);
    rtIf(f, L("x"), "ne", L("y"), "next");
    rtOp(f, "j", L("j"), "add", I(1)); rtJump(f, "inner");
    rtLabel(f, "next"); rtOp(f, "i", L("i"), "add", I(1)); rtJump(f, "outer");
    rtLabel(f, "found"); rtRet(f, L("i"));
    rtLabel(f, "none"); rtRet(f, I(-1)); check(f);

    // __tx_nrt_list_make() → empty generic list object (kind 10, payload list 7, form 1).
    f = rtBegin(b, "__tx_nrt_list_make", "", "s0 s1 s2 s3 s4 s5 s6 s7 sp", 1, "bootstrap/selfhost/nrt_text.tx");
    rtSet(f, "s0", I(10)); rtSet(f, "s1", I(30064771072)); rtSet(f, "s2", I(0)); rtSet(f, "s3", I(0)); rtSet(f, "s4", I(0));
    rtSet(f, "s5", I(4294967296)); rtSet(f, "s6", I(4)); rtSet(f, "s7", I(0));
    rtAddrOf(f, "sp", "s0"); rtCall1(f, "s0", "__tx_native_object_create_v1", L("sp"));
    rtRet(f, L("s0")); check(f);

    // __tx_nrt_list_add(idx, tag, pay): append an owned value (ownership moves to the list).
    f = rtBegin(b, "__tx_nrt_list_add", "idx tag pay", "vt vp va", 2, "bootstrap/selfhost/nrt_text.tx");
    rtSet(f, "vt", L("tag")); rtSet(f, "vp", L("pay")); rtAddrOf(f, "va", "vt");
    rtCall2(f, "", "__tx_store_list_append", L("idx"), L("va"));
    rtRetVoid(f); check(f);
}

function emitValueBuiltins(b: Ref<StructuredBuffer>): void {
    // len(x): string bytes / array length / slice length.
    let f = rtBegin(b, "__tx_bi_len", "win fn pc a nargs", "s t o n", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", -1, "");
    rtLoad(f, "o", L("s"), 8, 4);
    rtIf(f, L("t"), "eq", I(6), "str"); rtIf(f, L("t"), "eq", I(17), "str"); rtIf(f, L("t"), "eq", I(10), "arr"); rtIf(f, L("t"), "eq", I(11), "slice");
    trapText(b, f, 4010, "len 的实参不是 string/数组/切片/Bytes");
    rtLabel(f, "str"); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8); rtJump(f, "set");
    rtLabel(f, "arr"); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 24, 4); rtJump(f, "set");
    rtLabel(f, "slice"); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 28, 4);
    rtLabel(f, "set"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(1), L("n"));
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtRetVoid(f); check(f);

    // byteAt(s, i): int? — None out of range.
    f = rtBegin(b, "__tx_bi_byte_at", "win fn pc a nargs", "s t ix i p n x", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 2);
    argTag(f, 0, "s", "t", 6, "t0");
    argTag(f, 1, "ix", "t", 1, "t1");
    rtLoad(f, "i", L("ix"), 8, 8);
    strSpan(f, "s", "p", "n");
    rtIf(f, L("i"), "lt", I(0), "none"); rtIf(f, L("i"), "ge", L("n"), "none");
    rtOp(f, "p", L("p"), "add", L("i")); rtLoad(f, "x", L("p"), 0, 1);
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(1), L("x")); rtRetVoid(f);
    rtLabel(f, "none"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(4), I(0)); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "t0", 4010, "byteAt 第一实参不是 string");
    trapAt(b, f, "t1", 4010, "byteAt 第二实参不是 int");
    rtRetVoid(f); check(f);

    // eprint(s): raw stderr line.
    f = rtBegin(b, "__tx_bi_eprint", "win fn pc a nargs", "s t p n", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", 6, "type");
    strSpan(f, "s", "p", "n");
    rtCall3(f, "", "__tx_nrt_write_line", I(2), L("p"), L("n"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(4), I(0)); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "type", 4010, "eprint 的实参不是 string");
    rtRetVoid(f); check(f);

    // unref(r): value copy of the referent.
    f = rtBegin(b, "__tx_bi_unref", "win fn pc a nargs", "s t x", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", 9, "type");
    rtOp(f, "x", L("a"), "and", I(4294967295)); rtOp(f, "x", L("x"), "add", I(1));
    rtCall5(f, "", "__tx_clone", L("win"), L("fn"), L("pc"), L("a"), L("x")); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "type", 4010, "unref 的实参不是 Ref");
    rtRetVoid(f); check(f);

    // weak(r): WeakBox (kind 9, payload weakbox 6, meta = target), linked, target flagged.
    f = rtBegin(b, "__tx_bi_weak", "win fn pc a nargs", "s t tg s0 s1 s2 s3 s4 s5 s6 s7 sp wb o fl", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", 9, "type");
    rtLoad(f, "tg", L("s"), 8, 4);
    rtSet(f, "s0", I(9)); rtSet(f, "s1", I(25769803776)); rtSet(f, "s2", I(0)); rtSet(f, "s3", I(0)); rtSet(f, "s4", I(0));
    rtSet(f, "s5", L("tg")); rtSet(f, "s6", I(4)); rtSet(f, "s7", I(0));
    rtAddrOf(f, "sp", "s0"); rtCall1(f, "wb", "__tx_native_object_create_v1", L("sp"));
    rtCall3(f, "t", "__tx_native_weak_link_v1", A("__tx_nrt_weak_state"), L("tg"), L("wb"));
    rtIf32(f, L("t"), "eq", I(0), "oom");
    rtCall1(f, "o", "__tx_native_object_address_v1", L("tg"));
    rtLoad(f, "fl", L("o"), 0, 4); rtOp(f, "fl", L("fl"), "or", I(1)); rtStore(f, L("o"), 0, L("fl"), 4);
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(14), L("wb")); rtRetVoid(f);
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "type", 4010, "weak 的实参不是 Ref");
    rtRetVoid(f); check(f);

    // deref(w): T? — dead → None; alive → value copy of the target (as unref).
    f = rtBegin(b, "__tx_bi_deref", "win fn pc a nargs", "s t o vt vp ctx ot op sa oa ca", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", 14, "type");
    rtLoad(f, "o", L("s"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    rtLoad(f, "t", L("o"), 28, 4);
    rtIf(f, L("t"), "ne", I(0), "none");
    rtSet(f, "vt", I(9)); rtLoad(f, "vp", L("o"), 24, 4);
    rtOp(f, "ctx", L("fn"), "and", I(4294967295)); rtShift(f, "t", L("pc"), "shl", 32); rtOp(f, "ctx", L("ctx"), "or", L("t"));
    rtAddrOf(f, "sa", "vt"); rtAddrOf(f, "oa", "ot"); rtAddrOf(f, "ca", "ctx");
    rtCall4(f, "", "__tx_native_clone_v1", L("sa"), I(0), L("ca"), L("oa"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("ot"), L("op")); rtRetVoid(f);
    rtLabel(f, "none"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(4), I(0)); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "type", 4010, "deref 的实参不是 Weak");
    rtRetVoid(f); check(f);

    // utf8Encode(cp): string | Error.
    const outOfRange = "utf8Encode: 码点越界 U+";
    const surrogate = "utf8Encode: 非法码点 U+";
    const outLabel = text(b, outOfRange);
    const surLabel = text(b, surrogate);
    f = rtBegin(b, "__tx_bi_utf8_encode", "win fn pc a nargs", "s t cp u n q x d0 d1 d2 d3 dp k", 7, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 1);
    argTag(f, 0, "s", "t", 1, "type");
    rtLoad(f, "cp", L("s"), 8, 8);
    rtIf(f, L("cp"), "lt", I(0), "range"); rtIf(f, L("cp"), "gt", I(1114111), "range");
    rtAddrOf(f, "q", "u");
    rtIf(f, L("cp"), "lt", I(128), "e1");
    rtIf(f, L("cp"), "lt", I(2048), "e2");
    rtIf(f, L("cp"), "lt", I(55296), "e3");
    rtIf(f, L("cp"), "le", I(57343), "surrogate");
    rtIf(f, L("cp"), "lt", I(65536), "e3");
    rtShift(f, "x", L("cp"), "shr", 18); rtOp(f, "x", L("x"), "or", I(240)); rtStore(f, L("q"), 0, L("x"), 1);
    rtShift(f, "x", L("cp"), "shr", 12); rtOp(f, "x", L("x"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 1, L("x"), 1);
    rtShift(f, "x", L("cp"), "shr", 6); rtOp(f, "x", L("x"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 2, L("x"), 1);
    rtOp(f, "x", L("cp"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 3, L("x"), 1);
    rtSet(f, "n", I(4)); rtJump(f, "make");
    rtLabel(f, "e3");
    rtShift(f, "x", L("cp"), "shr", 12); rtOp(f, "x", L("x"), "or", I(224)); rtStore(f, L("q"), 0, L("x"), 1);
    rtShift(f, "x", L("cp"), "shr", 6); rtOp(f, "x", L("x"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 1, L("x"), 1);
    rtOp(f, "x", L("cp"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 2, L("x"), 1);
    rtSet(f, "n", I(3)); rtJump(f, "make");
    rtLabel(f, "e2");
    rtShift(f, "x", L("cp"), "shr", 6); rtOp(f, "x", L("x"), "or", I(192)); rtStore(f, L("q"), 0, L("x"), 1);
    rtOp(f, "x", L("cp"), "and", I(63)); rtOp(f, "x", L("x"), "or", I(128)); rtStore(f, L("q"), 1, L("x"), 1);
    rtSet(f, "n", I(2)); rtJump(f, "make");
    rtLabel(f, "e1");
    rtStore(f, L("q"), 0, L("cp"), 1); rtSet(f, "n", I(1));
    rtLabel(f, "make");
    rtCall3(f, "q", "__tx_nrt_str_copy", L("q"), L("n"), I(1));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(6), L("q")); rtRetVoid(f);
    rtLabel(f, "range"); rtSet(f, "q", A(outLabel)); rtSet(f, "n", I(len(outOfRange))); rtJump(f, "error");
    rtLabel(f, "surrogate"); rtSet(f, "q", A(surLabel)); rtSet(f, "n", I(len(surrogate)));
    rtLabel(f, "error");
    rtAddrOf(f, "dp", "d0");
    rtCall3(f, "k", "__tx_nrt_digits", L("cp"), I(16), L("dp"));
    rtOp(f, "dp", L("dp"), "add", I(32)); rtOp(f, "dp", L("dp"), "sub", L("k"));
    const xs: List<Ref<RtOp>> = listNew();
    listPush(xs, L("q")); listPush(xs, L("n")); listPush(xs, L("dp")); listPush(xs, L("k")); listPush(xs, I(0)); listPush(xs, I(0)); listPush(xs, I(2));
    rtCallList(f, "q", "__tx_nrt_cat3", xs);
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(5), L("q")); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "type", 4010, "utf8Encode 的实参不是 int");
    rtRetVoid(f); check(f);
}

function emitStringBuiltins(b: Ref<StructuredBuffer>): void {
    // strSub(s, from, count): code-point substring; ASCII strings cache flag 8.
    let f = rtBegin(b, "__tx_bi_str_sub", "win fn pc a nargs", "s t x from cnt o p n fl clen st en q", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 3);
    argTag(f, 0, "s", "t", 6, "t0");
    argTag(f, 1, "x", "t", 1, "t1"); rtLoad(f, "from", L("x"), 8, 8);
    argTag(f, 2, "x", "t", 1, "t2"); rtLoad(f, "cnt", L("x"), 8, 8);
    rtLoad(f, "o", L("s"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    rtLoad(f, "n", L("o"), 40, 8); rtLoad(f, "p", L("o"), 32, 8); rtLoad(f, "fl", L("o"), 0, 4);
    rtSet(f, "clen", L("n"));
    rtOp(f, "t", L("fl"), "and", I(8));
    rtIf(f, L("t"), "ne", I(0), "bounds");
    rtCall2(f, "clen", "__tx_nrt_utf8_count", L("p"), L("n"));
    rtIf(f, L("clen"), "lt", I(0), "utf8");
    rtLabel(f, "bounds");
    rtIf(f, L("from"), "lt", I(0), "oob"); rtIf(f, L("cnt"), "lt", I(0), "oob"); rtIf(f, L("from"), "gt", L("clen"), "oob");
    rtOp(f, "t", L("clen"), "sub", L("from")); rtIf(f, L("cnt"), "gt", L("t"), "oob");
    rtIf(f, L("clen"), "ne", L("n"), "walk");
    rtOp(f, "fl", L("fl"), "or", I(8)); rtStore(f, L("o"), 0, L("fl"), 4);
    rtSet(f, "st", L("from")); rtOp(f, "en", L("from"), "add", L("cnt")); rtJump(f, "copy");
    rtLabel(f, "walk");
    rtCall2(f, "st", "__tx_nrt_utf8_skip", L("p"), L("from"));
    rtOp(f, "t", L("p"), "add", L("st")); rtCall2(f, "en", "__tx_nrt_utf8_skip", L("t"), L("cnt")); rtOp(f, "en", L("en"), "add", L("st"));
    rtLabel(f, "copy");
    rtOp(f, "t", L("p"), "add", L("st")); rtOp(f, "en", L("en"), "sub", L("st"));
    rtCall3(f, "q", "__tx_nrt_str_copy", L("t"), L("en"), I(1));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(6), L("q")); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "t0", 4010, "strSub 第一实参不是 string");
    trapAt(b, f, "t1", 4010, "strSub 起始不是 int");
    trapAt(b, f, "t2", 4010, "strSub 计数不是 int");
    trapAt(b, f, "utf8", 4010, "strSub 的实参不是合法 UTF-8");
    trapAt(b, f, "oob", 4002, "strSub 区间越界");
    rtRetVoid(f); check(f);

    // strIndexOf(s, needle): code-point index of the first match; -1 absent; 0 for "".
    f = rtBegin(b, "__tx_bi_str_index_of", "win fn pc a nargs", "s t w hp hn np nn r", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 2);
    argTag(f, 0, "s", "t", 6, "t0");
    argTag(f, 1, "w", "t", 6, "t1");
    strSpan(f, "s", "hp", "hn"); strSpan(f, "w", "np", "nn");
    rtSet(f, "r", I(0));
    rtIf(f, L("nn"), "eq", I(0), "set");
    rtCall4(f, "r", "__tx_nrt_find", L("hp"), L("hn"), L("np"), L("nn"));
    rtIf(f, L("r"), "lt", I(0), "set");
    rtCall2(f, "r", "__tx_nrt_utf8_count", L("hp"), L("r"));
    rtIf(f, L("r"), "ge", I(0), "set");
    rtSet(f, "r", I(0));
    rtLabel(f, "set"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(1), L("r")); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "t0", 4010, "strIndexOf 第一实参不是 string");
    trapAt(b, f, "t1", 4010, "strIndexOf 第二实参不是 string");
    rtRetVoid(f); check(f);

    // strSplit(s, sep): List<string> — pieces, then the tail.
    f = rtBegin(b, "__tx_bi_str_split", "win fn pc a nargs", "s t w hp hn sp sn l off r q x", 5, "bootstrap/selfhost/nrt_text.tx");
    arity(b, f, 2);
    argTag(f, 0, "s", "t", 6, "t0");
    argTag(f, 1, "w", "t", 6, "t1");
    strSpan(f, "s", "hp", "hn"); strSpan(f, "w", "sp", "sn");
    rtIf(f, L("sn"), "eq", I(0), "empty");
    rtCall0(f, "l", "__tx_nrt_list_make");
    rtSet(f, "off", I(0));
    rtLabel(f, "loop");
    rtOp(f, "x", L("hp"), "add", L("off")); rtOp(f, "r", L("hn"), "sub", L("off"));
    rtCall4(f, "r", "__tx_nrt_find", L("x"), L("r"), L("sp"), L("sn"));
    rtIf(f, L("r"), "lt", I(0), "tail");
    rtCall3(f, "q", "__tx_nrt_str_copy", L("x"), L("r"), I(1));
    rtCall3(f, "", "__tx_nrt_list_add", L("l"), I(6), L("q"));
    rtOp(f, "off", L("off"), "add", L("r")); rtOp(f, "off", L("off"), "add", L("sn"));
    rtJump(f, "loop");
    rtLabel(f, "tail");
    rtOp(f, "r", L("hn"), "sub", L("off"));
    rtCall3(f, "q", "__tx_nrt_str_copy", L("x"), L("r"), I(1));
    rtCall3(f, "", "__tx_nrt_list_add", L("l"), I(6), L("q"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(15), L("l")); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    trapAt(b, f, "t0", 4010, "strSplit 第一实参不是 string");
    trapAt(b, f, "t1", 4010, "strSplit 第二实参不是 string");
    trapAt(b, f, "empty", 4010, "strSplit 分隔符不能为空");
    rtRetVoid(f); check(f);

    // __tx_str_concat_fr(win, fn, pc, dst, b, c, buf): NRT keeps no frame
    // string arena; the result is the ordinary owned heap concatenation.
    f = rtBegin(b, "__tx_str_concat_fr", "win fn pc dst bs cs buf", "", 6, "bootstrap/selfhost/nrt_text.tx");
    rtCall6(f, "", "__tx_str_concat", L("win"), L("fn"), L("pc"), L("dst"), L("bs"), L("cs"));
    rtRetVoid(f); check(f);

    // __tx_str_concat_host: the native concat only falls back on a tag mismatch.
    f = rtBegin(b, "__tx_str_concat_host", "win fn pc dst bs cs", "", 5, "bootstrap/selfhost/nrt_text.tx");
    trapText(b, f, 4010, "算术操作数类型不匹配");
    rtRetVoid(f); check(f);
}

export function emitNrtText(b: Ref<StructuredBuffer>): void {
    emitSpanHelpers(b);
    emitValueBuiltins(b);
    emitStringBuiltins(b);
}
