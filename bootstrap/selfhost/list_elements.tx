// Descriptor-based List elements; ownership and traps stay at the caller boundary.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
import { listCompactJump } from "./list_compact";
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function d(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function m(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
function md(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { op(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
function call(b: Ref<StructuredBuffer>, name: string): void { jump(b, "call", name); }
function ret(b: Ref<StructuredBuffer>): void { op(b, "ret", 0, asStructuredMissing(), asStructuredMissing()); }
// rcx=view, rdx=index, r8=independent Value pointer. rax=address, r9=form,
// r10=raw elem, r11=stride; no call and no nonvolatile register is touched.
function access(b: Ref<StructuredBuffer>, p: string): void {
    two(b, "test", r(1), r(1)); jump(b, "jz", p + "_bad");
    two(b, "test", r(8), r(8)); jump(b, "jz", p + "_bad");
    mov(b, r(0), m(1, 8)); two(b, "cmp", r(2), r(0)); jump(b, "jae", p + "_bad");
    two(b, "cmp", r(0), m(1, 16)); jump(b, "ja", p + "_bad");
    two(b, "movabs", r(10), i(1152921504606846975)); mov(b, r(0), m(1, 16));
    two(b, "cmp", r(0), r(10)); jump(b, "ja", p + "_bad");
    two(b, "cmp", m(1, 0), i(0)); jump(b, "je", p + "_bad");
    mov(b, d(9), md(1, 24)); mov(b, r(11), i(16));
    two(b, "cmp", d(9), i(1)); jump(b, "je", p + "_addr");
    two(b, "cmp", d(9), i(2)); jump(b, "jne", p + "_bad");
    mov(b, d(10), md(1, 28)); two(b, "cmp", d(10), i(1)); jump(b, "jb", p + "_bad");
    two(b, "cmp", d(10), i(3)); jump(b, "ja", p + "_bad"); mov(b, r(11), i(8));
    lab(b, p + "_addr"); mov(b, r(0), r(2)); two(b, "imul", r(0), r(11)); two(b, "add", r(0), m(1, 0)); jump(b, "jb", p + "_bad");
}
function output(b: Ref<StructuredBuffer>, p: string): void {
    two(b, "cmp", d(9), i(1)); jump(b, "je", p + "_generic");
    mov(b, r(2), m(0, 0)); two(b, "cmp", d(10), i(3)); jump(b, "jne", p + "_write");
    two(b, "test", r(2), r(2)); jump(b, "jz", p + "_write"); mov(b, r(2), i(1)); jump(b, "jmp", p + "_write");
    lab(b, p + "_generic"); mov(b, r(10), m(0, 0)); mov(b, r(2), m(0, 8));
    lab(b, p + "_write"); mov(b, m(8, 0), r(10)); mov(b, m(8, 8), r(2));
}
export function listElementsEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_le_get";
    lab(b, "__tx_native_list_get_v2"); listCompactJump(b, p + "_full", "__tx_native_list_cget_v1"); access(b, p); output(b, p); mov(b, r(0), r(9)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_le_remove";
    lab(b, "__tx_native_list_remove_v2"); listCompactJump(b, p + "_full", "__tx_native_list_cremove_v1"); access(b, p); output(b, p);
    mov(b, r(10), m(1, 8)); two(b, "sub", r(10), i(1)); two(b, "imul", r(10), r(11)); two(b, "add", r(10), m(1, 0));
    lab(b, p + "_loop"); two(b, "cmp", r(0), r(10)); jump(b, "jae", p + "_done");
    mov(b, r(2), r(0)); two(b, "add", r(2), r(11)); mov(b, r(8), m(2, 0)); mov(b, m(0, 0), r(8));
    two(b, "cmp", d(9), i(2)); jump(b, "je", p + "_next"); mov(b, r(8), m(2, 8)); mov(b, m(0, 8), r(8));
    lab(b, p + "_next"); mov(b, r(0), r(2)); jump(b, "jmp", p + "_loop");
    lab(b, p + "_done"); mov(b, r(2), m(1, 8)); two(b, "sub", r(2), i(1)); mov(b, m(1, 8), r(2)); mov(b, r(0), r(9)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_le_set";
    lab(b, "__tx_native_list_prepare_set_v2"); listCompactJump(b, p + "_full", "__tx_native_list_cset_v1"); access(b, p);
    two(b, "cmp", d(9), i(1)); jump(b, "je", p + "_generic_done");
    mov(b, r(2), m(8, 0)); two(b, "and", d(2), i(255)); two(b, "cmp", d(2), d(10)); jump(b, "jne", p + "_convert");
    mov(b, r(2), m(8, 8)); two(b, "cmp", d(10), i(3)); jump(b, "jne", p + "_write");
    two(b, "test", r(2), r(2)); jump(b, "jz", p + "_write"); mov(b, r(2), i(1));
    lab(b, p + "_write"); mov(b, m(0, 0), r(2)); mov(b, r(0), i(2)); ret(b);
    lab(b, p + "_convert"); two(b, "sub", r(4), i(40)); call(b, "__tx_native_list_generic_v1"); two(b, "add", r(4), i(40)); ret(b);
    lab(b, p + "_generic_done"); mov(b, r(0), i(1)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);

    p = "__tx_le_insert";
    lab(b, "__tx_native_list_insert_v2"); listCompactJump(b, p + "_full", "__tx_native_list_cinsert_v1"); two(b, "test", r(1), r(1)); jump(b, "jz", p + "_bad");
    two(b, "cmp", r(2), m(1, 8)); jump(b, "ja", p + "_bad");
    two(b, "sub", r(4), i(72)); mov(b, m(4, 32), r(1)); mov(b, m(4, 40), r(2));
    mov(b, r(2), r(8)); mov(b, d(8), d(9)); call(b, "__tx_native_list_append_v1");
    two(b, "test", r(0), r(0)); jump(b, "jz", p + "_return"); mov(b, m(4, 48), r(0));
    mov(b, r(1), m(4, 32)); mov(b, r(11), i(8)); two(b, "cmp", md(1, 24), i(2)); jump(b, "je", p + "_addr"); mov(b, r(11), i(16));
    lab(b, p + "_addr"); mov(b, r(0), m(1, 8)); two(b, "sub", r(0), i(1)); two(b, "imul", r(0), r(11)); two(b, "add", r(0), m(1, 0));
    mov(b, r(8), m(4, 40)); two(b, "imul", r(8), r(11)); two(b, "add", r(8), m(1, 0));
    mov(b, r(10), m(0, 0)); mov(b, m(4, 64), r(10));
    two(b, "cmp", r(11), i(8)); jump(b, "je", p + "_loop"); mov(b, m(4, 56), r(10)); mov(b, r(10), m(0, 8)); mov(b, m(4, 64), r(10));
    lab(b, p + "_loop"); two(b, "cmp", r(0), r(8)); jump(b, "je", p + "_store");
    mov(b, r(2), r(0)); two(b, "sub", r(2), r(11)); mov(b, r(10), m(2, 0)); mov(b, m(0, 0), r(10));
    two(b, "cmp", r(11), i(8)); jump(b, "je", p + "_next"); mov(b, r(10), m(2, 8)); mov(b, m(0, 8), r(10));
    lab(b, p + "_next"); mov(b, r(0), r(2)); jump(b, "jmp", p + "_loop");
    lab(b, p + "_store"); two(b, "cmp", r(11), i(8)); jump(b, "je", p + "_store_bits"); mov(b, r(10), m(4, 56)); mov(b, m(0, 0), r(10)); two(b, "add", r(0), i(8));
    lab(b, p + "_store_bits"); mov(b, r(10), m(4, 64)); mov(b, m(0, 0), r(10)); mov(b, r(0), m(4, 48));
    lab(b, p + "_return"); two(b, "add", r(4), i(72)); ret(b);
    lab(b, p + "_bad"); mov(b, r(0), i(0)); ret(b);
}
