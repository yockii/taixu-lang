// D3 v0.49 §5 assign_stmt、§6.5-4：复合赋值 += -= *= /= %= &= |= ^=；左值只求值一次
// （下标里的调用只调一次），string 的 += 即拼接，字段、Ref 字段、数组元素、for 的初始化段与更新段都可用。
struct P { x: int, tags: List<string> }

let calls: int = 0;

function idx(i: int): int {
    calls += 1;
    return i;
}

export function main(args: []string): int {
    args;
    let i: int = 10;
    i += 5;
    i -= 3;
    i *= 4;
    i /= 6;
    i %= 5;
    print("i=" + toStr(i));
    let b: int = 12;
    b &= 10;
    b |= 1;
    b ^= 3;
    print("b=" + toStr(b));
    let s: string = "太";
    s += "虚";
    print(s);
    let p: P = { x: 1, tags: listNew() };
    p.x += 41;
    print("p.x=" + toStr(p.x));
    let arr: [3]int = [1, 2, 3];
    arr[idx(1)] += 10;
    arr[2] *= 7;
    arr[idx(0) + idx(0)] -= 1;
    print("arr=" + toStr(arr[0]) + "," + toStr(arr[1]) + "," + toStr(arr[2]) + " calls=" + toStr(calls));
    let sum: int = 0;
    for (let k: int = 0; k < 5; k += 1) {
        sum += k;
    }
    let m: int = 0;
    for (m += 100; m < 103; m += 1) {
        sum += 1;
    }
    print("sum=" + toStr(sum) + " m=" + toStr(m));
    const r = new P { x: 3, tags: listNew() };
    r.x += 4;
    print("r.x=" + toStr(r.x));
    let f: float = 1.5;
    f *= 2.0;
    print("f=" + toStr(f));
    let g: i32 = 7;
    g += 1;
    print("g=" + toStr(g));
    return 0;
}
