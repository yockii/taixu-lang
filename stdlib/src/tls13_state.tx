import { Tls13RecordKeys } from "./tls13_record";
import { X509Certificate } from "./x509_types";

// phase：0 未启动、1 ServerHello、2 EE、3 CR/Certificate、4 CV、5 Finished、6 应用。
export struct Tls13Client {
    host: string, nowSecs: int, roots: List<Bytes>, phase: int, failed: bool,
    random: Bytes, session: Bytes, group: int, privateKey: Bytes, publicKey: Bytes,
    retried: bool, sentCcs: bool, clientAuth: bool,
    transcript: Bytes, incoming: Bytes, handshake: Bytes,
    readKeys: Ref<Tls13RecordKeys>?, writeKeys: Ref<Tls13RecordKeys>?,
    handshakeSecret: Bytes, serverHandshake: Bytes, clientHandshake: Bytes,
    serverTraffic: Bytes, clientTraffic: Bytes,
    certificate: Ref<X509Certificate>?, localClosed: bool, peerClosed: bool,
}
export struct Tls13Progress { outbound: List<Bytes>, application: List<Bytes>, ready: bool, peerClosed: bool }

export function tls13Progress(): Tls13Progress { return Tls13Progress { outbound: listNew(), application: listNew(), ready: false, peerClosed: false }; }
export function tls13Fail(state: Ref<Tls13Client>, message: string): Error {
    state.failed = true; tls13Wipe(state.privateKey); tls13Wipe(state.handshakeSecret); tls13Wipe(state.clientHandshake); tls13Wipe(state.serverHandshake);
    tls13Wipe(state.clientTraffic); tls13Wipe(state.serverTraffic);
    tls13RetireKeys(state.readKeys); tls13RetireKeys(state.writeKeys);
    if (len(message) >= 7 && strSlice(message, 0, 7) == "tls13: ") { return err(message); } return err("tls13: " + message);
}
export function tls13Transcript(state: Ref<Tls13Client>, message: Bytes): void | Error {
    if (bytesLen(state.transcript) > 2097152 - bytesLen(message)) { return tls13Fail(state, "transcript limit"); }
    bytesAppend(state.transcript, message); return done();
}
export function tls13Wipe(data: Bytes): void { let i = 0; while (i < bytesLen(data)) { bytesSet(data, i, 0); i = i + 1; } }
// 密钥切换也须处理旧缓冲；持有旧 Ref 的调用方同时看到清零与不可复用状态。
export function tls13RetireKeys(keys: Ref<Tls13RecordKeys>?): void {
    if (keys != None) { keys.failed = true; tls13Wipe(keys.key); tls13Wipe(keys.iv); }
}
function done(): void {}
