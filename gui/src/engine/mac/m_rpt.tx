// ============================================================================
// engine/mac/m_rpt —— objc_msgSend：NSPoint(id, SEL)（如 -[NSEvent locationInWindow]；x86_64 上两个 double 在 XMM0、XMM1，arm64 是 HFA，都不用 _stret）。
// ============================================================================

import { NSPOINT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize): NSPOINT from "/usr/lib/libobjc.A.dylib";

export function msgRetPoint(o: usize, s: string): NSPOINT {
    return objc_msgSend(o, sel_registerName(s));
}
