const add: (int, int) => int = (a: int, b: int): int => a + b;

function makeAdder(n: int): (int) => int {
    return (x: int): int => x + n;
}

export function main(args: []string): int {
    print(toStr(add(2, 3)));
    const add5 = makeAdder(5);
    print(toStr(add5(10)));
    const named: (int, int) => int = add;
    print(toStr(named(7, 8)));
    const zero: () => int = (): int => 42;
    print(toStr(zero()));
    return 0;
}
