export function main(args: []string): int {
    const ok: string = readFile("03-readfile-data.txt") catch (e) {
        print("不应失败: " + e.message);
        return 1;
    };
    print("ok len=" + toStr(len(ok)));
    const miss: string = readFile("no-such-file.txt") catch (e) {
        print("miss: " + e.message);
        return 0;
    };
    print(miss);
    return 0;
}
