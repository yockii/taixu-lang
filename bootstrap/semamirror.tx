    if (b == 2053) { return "__rtArgCount(): int"; }
    if (b == 2054) { return "__rtArgAt(int): string?"; }
    if (b == 3584) { return "stdinRead(Bytes, int): int"; }
    if (b == 3585) { return "stdoutWrite(Bytes): int"; }
    if (b == 3586) { return "procSpawn(string, List<string>, string, int): int | Error"; }
    if (b == 3595) { return "procSpawnLimited(string, List<string>, string, int, int, int): int | Error"; }
    if (b == 3587) { return "procWrite(int, int, Bytes): int"; }
    if (b == 3599) { return "procTryWrite(int, int, Bytes): int"; }
