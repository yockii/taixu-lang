// hit-scan —— 重放命中扫描哨兵行守护（feedback #6 缺口收容）：
// 重放/脚本行 target=-1＝哨兵——坐标经 resolveHit 与真窗同路径换算。此前的
// target=id 直达通道不经过命中扫描，dd 命中区罩住输入框（固定注册序先到
// 先得）一类真窗缺陷 17 案全绿拦不住。本用例双相构造重叠注册形态：
//   A 相＝occluder(12) 先于 input(11) 注册（bug 形态）→ 坐标点击命中
//         occluder＝守护红 Demonstrant（feedback #6 症状的无头确定性重现）；
//   B 相＝input(21) 先于 occluder(22) 注册（修复形态）→ 坐标点击命中输入框。
// golden 锚定命中归属：哨兵通道被拆（回退 target 直达）或 resolveHit 序被
// 破坏时计数归零/翻转——用例红。
//
// 确定性校验：TAIXU_REPLAY=tests/hit-scan.txt taixu run tests/hit-scan.tx
import { Canvas, canvasNew, text, drawText, EV_MOUSE_DOWN } from "gui/components";
import { App, appNew, appClose, pump, hitZone, onClick, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";

const ID_IN_A: int = 11;
const ID_OCL_A: int = 12;
const ID_IN_B: int = 21;
const ID_OCL_B: int = 22;

struct Model {
    surface: int,
    dd_a: int, // A 相点击落入 occluder 的次数（bug 形态＝1）
    in_a: int, // A 相点击落入 input 的次数
    in_b: int, // B 相点击落入 input 的次数（修复形态＝1）
    ocl_b: int, // B 相点击落入 occluder 的次数
}

function render(surface: int, w: int, h: int): void {
    surfaceClear(surface, 0x202040);
    const cv: Ref<Canvas> = canvasNew(surface, w, h);
    cv;
    drawText(surface, text(1, 8, 4, "hit-scan guard: -1 routes via resolveHit"));
}

function downCounter(m: Ref<Model>, slot: int): (EventRecord) => void {
    if (slot == 0) {
        return (rec: EventRecord): void => {
            if (rec.kind == EV_MOUSE_DOWN) {
                m.dd_a = m.dd_a + 1;
            }
        };
    }
    if (slot == 1) {
        return (rec: EventRecord): void => {
            if (rec.kind == EV_MOUSE_DOWN) {
                m.in_a = m.in_a + 1;
            }
        };
    }
    if (slot == 2) {
        return (rec: EventRecord): void => {
            if (rec.kind == EV_MOUSE_DOWN) {
                m.in_b = m.in_b + 1;
            }
        };
    }
    return (rec: EventRecord): void => {
        if (rec.kind == EV_MOUSE_DOWN) {
            m.ocl_b = m.ocl_b + 1;
        }
    };
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, dd_a: 0, in_a: 0, in_b: 0, ocl_b: 0 };
    const spec = defaultSpec("taixu hit-scan guard", 320, 220);
    const app = appNew(spec);
    m.surface = surfaceOpen(spec.w, spec.h) catch 0;
    onClick(app, ID_OCL_A, downCounter(m, 0));
    onClick(app, ID_IN_A, downCounter(m, 1));
    onClick(app, ID_IN_B, downCounter(m, 2));
    onClick(app, ID_OCL_B, downCounter(m, 3));
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            render(m.surface, app.w, app.h);
            // A 相：occluder(12) 注册在前（bug 形态——form dd 固定展开注册
            // 同构）；B 相：input(21) 注册在前（修复形态）。resolveHit 线性
            // 扫描先注册先命中——注册序即被守护面。
            hitZone(app, ID_OCL_A, 40, 100, 120, 18);
            hitZone(app, ID_IN_A, 40, 100, 120, 18);
            hitZone(app, ID_IN_B, 40, 140, 120, 18);
            hitZone(app, ID_OCL_B, 40, 140, 120, 18);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("scanA_dd=" + toStr(m.dd_a) + " scanA_in=" + toStr(m.in_a) + " scanB_in=" + toStr(m.in_b) + " scanB_ocl=" + toStr(m.ocl_b) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
