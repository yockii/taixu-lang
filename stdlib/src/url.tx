// URI 解析与相对引用，RFC 3986。语法解析不做 DNS，也不表示地址已通过 HTTP 连接策略校验。
import { ipLiteral } from "./url_ip";

export struct Uri {
    scheme: string,
    authority: string?,
    path: string,
    query: string?,
    fragment: string?,
}

export struct QueryParam {
    name: string,
    value: string,
    hasEquals: bool,
}

function bad(): Error { return err("url: invalid URI"); }
function alpha(c: int): bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122); }
function digit(c: int): bool { return c >= 48 && c <= 57; }
function hx(c: int): int {
    if (digit(c)) { return c - 48; }
    if (c >= 65 && c <= 70) { return c - 55; }
    if (c >= 97 && c <= 102) { return c - 87; }
    return -1;
}
function unreserved(c: int): bool {
    return alpha(c) || digit(c) || c == 45 || c == 46 || c == 95 || c == 126;
}
function sub(c: int): bool {
    return c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61;
}
function starts(s: string, p: string): bool { return len(s) >= len(p) && strSlice(s, 0, len(p)) == p; }

// extra 中的 ASCII 分隔符是本组件额外允许的字符，百分号必须是完整的两位十六进制。
function component(s: string, extra: string): bool {
    let i = 0;
    while (i < len(s)) {
        const c = byteAt(s, i);
        if (c == 37) {
            if (i + 2 >= len(s) || hx(byteAt(s, i + 1)) < 0 || hx(byteAt(s, i + 2)) < 0) { return false; }
            i = i + 3;
        } else {
            if (!unreserved(c) && !sub(c) && strFind(extra, strSlice(s, i, i + 1)) < 0) { return false; }
            i = i + 1;
        }
    }
    return true;
}

function authorityOk(raw: string): bool {
    let host = raw;
    const at = strFind(host, "@");
    if (at >= 0) {
        if (!component(strSlice(host, 0, at), ":")) { return false; }
        host = strSlice(host, at + 1, len(host));
        if (strFind(host, "@") >= 0) { return false; }
    }
    let port = "";
    if (starts(host, "[")) {
        const end = strFind(host, "]");
        if (end < 0 || !ipLiteral(strSlice(host, 1, end))) { return false; }
        const tail = strSlice(host, end + 1, len(host));
        if (len(tail) > 0) {
            if (!starts(tail, ":")) { return false; }
            port = strSlice(tail, 1, len(tail));
        }
    } else {
        const colon = strFind(host, ":");
        if (colon >= 0) { port = strSlice(host, colon + 1, len(host)); host = strSlice(host, 0, colon); }
        if (!component(host, "")) { return false; }
    }
    for (c in port) { if (!digit(c)) { return false; } }
    return true;
}

/// 解析 ASCII URI／相对引用，默认最多 64 KiB。原始 Unicode 先经 escapeComponent 等显式编码。
export function parseUri(s: string): Uri | Error { return parseUriLimit(s, 65536); }

export function parseUriLimit(s: string, maxBytes: int): Uri | Error {
    if (maxBytes < 0 || len(s) > maxBytes) { return err("url: URI exceeds byte limit"); }
    for (c in s) { if (c <= 32 || c >= 127) { return bad(); } }
    let rest = s;
    let fragment: string? = None;
    const hash = strFind(rest, "#");
    if (hash >= 0) { fragment = strSlice(rest, hash + 1, len(rest)); rest = strSlice(rest, 0, hash); }
    let query: string? = None;
    const q = strFind(rest, "?");
    if (q >= 0) { query = strSlice(rest, q + 1, len(rest)); rest = strSlice(rest, 0, q); }
    let scheme = "";
    const colon = strFind(rest, ":");
    const slash = strFind(rest, "/");
    if (colon >= 0 && (slash < 0 || colon < slash)) {
        scheme = strSlice(rest, 0, colon);
        if (len(scheme) == 0 || !alpha(byteAt(scheme, 0))) { return bad(); }
        for (c in scheme) { if (!alpha(c) && !digit(c) && c != 43 && c != 45 && c != 46) { return bad(); } }
        rest = strSlice(rest, colon + 1, len(rest));
    }
    let authority: string? = None;
    if (starts(rest, "//")) {
        rest = strSlice(rest, 2, len(rest));
        let end = strFind(rest, "/");
        if (end < 0) { end = len(rest); }
        const a = strSlice(rest, 0, end);
        if (!authorityOk(a)) { return bad(); }
        authority = a;
        rest = strSlice(rest, end, len(rest));
    }
    if (!component(rest, ":@/") || !component(query catch "", ":@/?") || !component(fragment catch "", ":@/?")) { return bad(); }
    return Uri { scheme: scheme, authority: authority, path: rest, query: query, fragment: fragment };
}

/// 保留未给组件与空组件的差别；调用方手工构造的 Uri 应先由 parseUri 校验后再用于网络。
export function uriString(u: Uri): string {
    let s = "";
    if (len(u.scheme) > 0) { s = u.scheme + ":"; }
    if (u.authority != None) { s = s + "//" + (u.authority catch ""); }
    s = s + u.path;
    if (u.query != None) { s = s + "?" + (u.query catch ""); }
    if (u.fragment != None) { s = s + "#" + (u.fragment catch ""); }
    return s;
}

function lastSlash(s: string): int {
    let i = len(s);
    while (i > 0) { i = i - 1; if (byteAt(s, i) == 47) { return i; } }
    return -1;
}

// RFC 3986 §5.2.4。百分号在此不解码，查询与片段不进入此算法。
function dots(path: string): string {
    let input = path;
    let output = "";
    while (len(input) > 0) {
        if (starts(input, "../")) { input = strSlice(input, 3, len(input)); }
        else if (starts(input, "./")) { input = strSlice(input, 2, len(input)); }
        else if (starts(input, "/./")) { input = strSlice(input, 2, len(input)); }
        else if (input == "/.") { input = "/"; }
        else if (starts(input, "/../") || input == "/..") {
            if (input == "/..") { input = "/"; }
            else { input = strSlice(input, 3, len(input)); }
            const slash = lastSlash(output);
            if (slash >= 0) { output = strSlice(output, 0, slash); }
            else { output = ""; }
        } else if (input == "." || input == "..") { input = ""; }
        else {
            let end = 0;
            if (starts(input, "/")) { end = 1; }
            while (end < len(input) && byteAt(input, end) != 47) { end = end + 1; }
            output = output + strSlice(input, 0, end);
            input = strSlice(input, end, len(input));
        }
    }
    return output;
}

/// 以绝对 base 为基准解析 reference，严格模式（http:g 不改作相对路径）。
export function resolveUri(base: string, reference: string): Uri | Error {
    const b = parseUri(base)?;
    const r = parseUri(reference)?;
    if (len(b.scheme) == 0) { return err("url: base URI must be absolute"); }
    let scheme = r.scheme;
    let authority = r.authority;
    let path = r.path;
    let query = r.query;
    if (len(r.scheme) > 0) { path = dots(r.path); }
    else {
        scheme = b.scheme;
        if (r.authority != None) { path = dots(r.path); }
        else {
            authority = b.authority;
            if (len(r.path) == 0) { path = b.path; if (r.query == None) { query = b.query; } }
            else if (starts(r.path, "/")) { path = dots(r.path); }
            else {
                let prefix = "";
                const slash = lastSlash(b.path);
                if (slash >= 0) { prefix = strSlice(b.path, 0, slash + 1); }
                else if (b.authority != None) { prefix = "/"; }
                path = dots(prefix + r.path);
            }
        }
    }
    return Uri { scheme: scheme, authority: authority, path: path, query: query, fragment: r.fragment };
}

/// 只保留 unreserved，按 UTF-8 字节编码；form=true 时空格编码为 +。
export function escapeComponent(s: string, form: bool): string {
    const b = bytesFromStr(s);
    const hex = "0123456789ABCDEF";
    let out = "";
    let i = 0;
    while (i < bytesLen(b)) {
        const c = bytesGet(b, i) catch panic("url: internal byte bounds");
        if (unreserved(c)) { out = out + (bytesToStr(bytesSlice(b, i, 1)) catch ""); }
        else if (form && c == 32) { out = out + "+"; }
        else { out = out + "%" + strSlice(hex, c >> 4, (c >> 4) + 1) + strSlice(hex, c & 15, (c & 15) + 1); }
        i = i + 1;
    }
    return out;
}

/// 百分号可表示任意字节。form=true 才把 + 解为空格。
export function decodePercent(s: string, form: bool): Bytes | Error {
    const b = bytesFromStr(s);
    const out = bytesNew(bytesLen(b));
    let i = 0;
    let n = 0;
    while (i < bytesLen(b)) {
        let c = bytesGet(b, i) catch panic("url: internal byte bounds");
        if (c == 37) {
            if (i + 2 >= bytesLen(b)) { return err("url: incomplete percent escape"); }
            const a = hx(bytesGet(b, i + 1) catch panic("url: internal byte bounds"));
            const d = hx(bytesGet(b, i + 2) catch panic("url: internal byte bounds"));
            if (a < 0 || d < 0) { return err("url: invalid percent escape"); }
            c = a * 16 + d;
            i = i + 2;
        } else if (form && c == 43) { c = 32; }
        bytesSet(out, n, c);
        n = n + 1;
        i = i + 1;
    }
    return bytesSlice(out, 0, n);
}

export function unescapeComponent(s: string, form: bool): string | Error { return bytesToStr(decodePercent(s, form)?); }

/// 查询项保留重复名、顺序和缺席的等号；空查询不产生空项。
export function parseQuery(raw: string, form: bool): List<QueryParam> | Error {
    const out: List<QueryParam> = listNew();
    if (len(raw) == 0) { return out; }
    for (part in strSplit(raw, "&")) {
        const eq = strFind(part, "=");
        let key = part;
        let value = "";
        if (eq >= 0) { key = strSlice(part, 0, eq); value = strSlice(part, eq + 1, len(part)); }
        listPush(out, QueryParam { name: unescapeComponent(key, form)?, value: unescapeComponent(value, form)?, hasEquals: eq >= 0 });
    }
    return out;
}

export function encodeQuery(params: List<QueryParam>, form: bool): string {
    let out = "";
    let first = true;
    for (p in params) {
        if (!first) { out = out + "&"; }
        out = out + escapeComponent(p.name, form);
        if (p.hasEquals) { out = out + "=" + escapeComponent(p.value, form); }
        first = false;
    }
    return out;
}
