// D3 v0.20：跨模块的实现关系——泛型实例体与约束检查先在模板模块找方法，找不到再到实参类型的声明模块找；
// 装箱在当前模块找，同样回落到类型的声明模块。
import { Hashable, Named, hashAll, names } from "./data/iface_algo";
import { Pt, mkPt } from "./data/iface_shapes";

function main(args: []string): int {
    const ps: List< Ref< Pt>> = listNew();
    const qs: List< Named> = listNew();
    listPush(qs, mkPt(1, 2));
    listPush(qs, mkPt(3, 4));
    print(names(qs));
    const hs: List< Hashable> = listNew();
    listPush(hs, mkPt(1, 2));
    listPush(hs, mkPt(3, 4));
    print(toStr(hashAll(hs)));
    return 0;
}
