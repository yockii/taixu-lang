// 线程第 4c 步：共享块的计数。反复建、发送、嵌套、物化、放手共享块；线程结束时模块级变量里仍持有的句柄与借用
// 载荷的对象由线程收尾放手（每个线程的模块级 let 各一份）。
let kept: List< Shared< List< string>>> = listNew();

function holdInThread(s: Shared< List< string>>): int {
    listPush(kept, s);
    const xs = sharedGet(s);
    return listLen(xs) + listLen(kept);
}

function main(args: []string): void {
    let total = 0;
    let round = 0;
    while (round < 200) {
        const xs: List< string> = listNew();
        listPush(xs, "r" + toStr(round));
        listPush(xs, "数据");
        const s = sharedNew(xs);
        const t = threadSpawn((): int => holdInThread(s));
        total = total + (threadJoin(t) catch 0);
        const again = sharedNew(s);
        total = total + listLen(sharedGet(sharedGet(again)));
        round = round + 1;
    }
    print("total " + toStr(total) + " main kept " + toStr(listLen(kept)));
}
