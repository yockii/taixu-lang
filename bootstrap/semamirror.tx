 -1, module_idx: 0, name: "", fnames: listNew(), ftys: listNew(), aLine: 0, aCol: 0 } }, dIdl: new IfaceDecl { name: "", exported: false, tps: listNew(), tcs: listNew(), mnames: listNew(), msigs: listNew(), line: 0, col: 0 } }, fx: new FfiS { hNames: listNew(), xsSer: listNew(), xsSi: listNew(), xsDecl: listNew(), xsMod: listNew(), xsSize: listNew(), xsAlign: listNew(), xsOff: listNew(), cbSigs: listNew(), cbKinds: listNew(), cbFns: listNew(), lastK: 0, lastA: 0, used: false, dFx: new FfiX { mode: 0, lib: "", nr: 0, mod: -1, line: 0, col: 0, pk: listNew(), pa: listNew(), rk: 0, ra: 0, nfix: 0 }, dHd: new HandleDecl { name: "", exported: false, line: 0, col: 0 } } };
    // 单例基元类型（zig 侧静态单例同构——serial 0..5 恒定）。
    s.tInt = mkTyS(s, 0, None, None, 0, None, None, None);
    s.tFloat = mkTyS(s, 1, None, None, 0, None, None, None);
    s.tBool = mkTyS(s, 2, None, None, 0, None, None, None);
    s.tString = mkTyS(s, 3, None, None, 0, None, None, None);
    s.tVoid = mkTyS(s, 4, None, None, 0, None, None, None);
    s.tErr = mkTyS(s, 5, None, None, 0, None, None, None);
    s.curRet = s.tVoid;
    // 哨兵（可选展开缺省；守卫路径外不触）。
    s.dT = mkTyS(s, 0, None, None, 0, None, None, None);
    s.dummySi = newStructT(s, -1, "");
    s.dummyEi = newEnumT(s, -1, "");
    s.dummySig = newSig(s, listNew(), s.tInt, false);
    (s.dummyFE.sig) = s.dummySig;
    return s;
}

function mkTyS(s: Ref<Sm>, tag: int, inner: Ref<Ty>?, elem: Ref<Ty>?, alen: int, si: Ref<StructT>?, ei: Ref<EnumT>?, sig: Ref<Sig>?): Ref<Ty> {
    const t = new Ty { serial: listLen(s.tys), tag: tag, inner: inner, elem: elem, alen: alen, si: si, ei: ei, sig: sig };
    listPush(s.tys, t);
    listPush(s.tyPool, -1);
    return t;
}

function newStructT(s: Ref<Sm>, module_idx: int, name: string): Ref<StructT> {
    const si = new StructT { serial: listLen(s.sts), module_idx: module_idx, name: name, fnames: listNew(), ftys: listNew(), aLine: 0, aCol: 0 };
    listPush(s.sts, si);
    listPush(s.stPool, -1);
    return si;
}

function newEnumT(s: Ref<Sm>, module_idx: int, name: string): Ref<EnumT> {
    const ei = new EnumT { isErr: false, serial: listLen(s.ens), module_idx: module_idx, name: name, vars: listNew(), aLine: 0, aCol: 0 };
    listPush(s.ens, ei);
    listPush(s.enPool, -1);
    return ei;
}

function newSig(s: Ref<Sm>, params: List<Ref<Ty>>, ret: Ref<Ty>, isAsync: bool): Ref<Sig> {
    const sig = new Sig { serial: listLen(s.sgs), params: params, ret: ret, isAsync: isAsync };
    listPush(s.sgs, sig);
    listPush(s.sgPool, -1);
    return sig;
}

function tOpt(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 6, inner, None, 0, None, None, None); }
function tErrunion(s: Ref<Sm>, ok: Ref<Ty>): Ref<Ty> { return mkTyS(s, 7, ok, None, 0, None, None, None); }
// D3 v0.19：失败侧为错误 enum 的失败联合（ei 位载失败侧；None＝Error）。
function tErrunionE(s: Ref<Sm>, ok: Ref<Ty>, et: Ref<EnumT>): Ref<Ty> { return mkTyS(s, 7, ok, None, 0, None, et, None); }
function tRef(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 8, inner, None, 0, None, None, None); }
function tWeak(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 9, inner, None, 0, None, None, None); }
function tList(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 10, inner, None, 0, None, None, None); }
function tSlice(s: Ref<Sm>, elem: Ref<Ty>): Ref<Ty> { return mkTyS(s, 12, None, elem, 0, None, None, None); }
function tArr(s: Ref<Sm>, elem: Ref<Ty>, ln: int): Ref<Ty> { return mkTyS(s, 11, None, elem, ln, None, None, None); }
function tStruct(s: Ref<Sm>, si: Ref<StructT>): Ref<Ty> { return mkTyS(s, 13, None, None, 0, si, None, None); }
function tEnum(s: Ref<Sm>, ei: Ref<EnumT>): Ref<Ty> { return mkTyS(s, 14, None, None, 0, None, ei, None); }
function tFn(s: Ref<Sm>, sig: Ref<Sig>): Ref<Ty> { return mkTyS(s, 15, None, None, 0, None, None, sig); }
function tFuture(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 16, inner, None, 0, None, None, None); }
// Bytes（D3 v0.18）：按需构造的叶类型，按 tag 相等；不建单例以免移动既有类型序号。
function tBytes(s: Ref<Sm>): Ref<Ty> { return mkTyS(s, 17, None, None, 0, None, None, None); }
// Gen<T>（D3 v0.22）：生成器句柄，inner 位载元素类型。
function tGen(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 20, inner, None, 0, None, None, None); }
// Thread<T>（线程第 2 步）：线程句柄，inner 位载线程函数的结果类型。
function tThread(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 23, inner, None, 0, None, None, None); }
// Shared<T>（线程第 4c 步）：跨线程共享的句柄，inner 位载内容类型；Atomic<int>：原子整数，inner 恒为 int。
function tShared(s: Ref<Sm>, inner: Ref<Ty>): Ref<Ty> { return mkTyS(s, 24, inner, None, 0, None, None, None); }
function tAtomic(s: Ref<Sm>): Ref<Ty> { return mkTyS(s, 25, s.tInt, None, 0, None, None, None); }

// —— 定宽数值（O4 第一步；docs/design/v052-fixed-width-numerics-v0.1-20261015.md）——
// tag 21＝定宽数值，alen 载种类码：1 i8、2 i16、3 i32、4 u8、5 u16、6 u32、7 u64、8 isize、9 usize、10 f32；
// i64/f64 是 int/float 的别名。nkOf 把 int 记 11、float 记 12，判定统一按种类码。
function tFw(s: Ref<Sm>, k: int): Ref<Ty> { return mkTyS(s, 21, None, None, k, None, None, None); }
// D3 v0.23 FFI：tag 22＝declare type 不透明句柄，alen 载句柄序（s.fx.hNames）；运行期即指针宽整数。
function tHandle(s: Ref<Sm>, h: int): Ref<Ty> { return mkTyS(s, 22, None, None, h, None, None, None); }

function fwKindByName(n: string): int {
    if (n == "i8") { return 1; }
    if (n == "i16") { return 2; }
    if (n == "i32") { return 3; }
    if (n == "u8") { return 4; }
    if (n == "u16") { return 5; }
    if (n == "u32") { return 6; }
    if (n == "u64") { return 7; }
    if (n == "isize") { return 8; }
    if (n == "usize") { return 9; }
    if (n == "f32") { return 10; }
    if (n == "i64") { return 11; }
    if (n == "f64") { return 12; }
    return 0;
}

function fwName(k: int): string {
    if (k == 1) { return "i8"; }
    if (k == 2) { return "i16"; }
    if (k == 3) { return "i32"; }
    if (k == 4) { return "u8"; }
    if (k == 5) { return "u16"; }
    if (k == 6) { return "u32"; }
    if (k == 7) { return "u64"; }
    if (k == 8) { return "isize"; }
    if (k == 9) { return "usize"; }
    if (k == 10) { return "f32"; }
    if (k == 11) { return "int"; }
    return "float";
}

function nkOf(t: Ref<Ty>): int {
    if (t.tag == 0) { return 11; }
    if (t.tag == 1) { return 12; }
    if (t.tag == 21) { return t.alen; }
    return 0;
}

function nkTy(s: Ref<Sm>, c: int): Ref<Ty> {
    if (c == 11) { return s.tInt; }
    if (c == 12) { return s.tFloat; }
    return tFw(s, c);
}

function nkIsInt(c: int): bool { return (c >= 1 && c <= 9) || c == 11; }
function nkIsFloat(c: int): bool { return c == 10 || c == 12; }
function nkSigned(c: int): bool { return c == 1 || c == 2 || c == 3 || c == 8 || c == 11; }

// 位宽下界/上界：isize/usize 随目标指针宽度，按 32..64 判定，结论对所有目标成立。
function nkMinBits(c: int): int {
    if (c == 1 || c == 4) { return 8; }
    if (c == 2 || c == 5) { return 16; }
    if (c == 3 || c == 6 || c == 8 || c == 9) { return 32; }
    return 64;
}

function nkMaxBits(c: int): int {
    if (c == 1 || c == 4) { return 8; }
    if (c == 2 || c == 5) { return 16; }
    if (c == 3 || c == 6) { return 32; }
    return 64;
}

// 无损扩宽（所有目标上都不丢值）；同种恒真；整数与浮点之间不扩宽。
function nkWidens(f: int, t: int): bool {
    if (f == t) { return f != 0; }
    if (nkIsFloat(f) || nkIsFloat(t)) { return f == 10 && t == 12; }
    if (!nkIsInt(f) || !nkIsInt(t)) { return false; }
    if (nkSigned(t)) {
        if (nkSigned(f)) { return nkMaxBits(f) <= nkMinBits(t); }
        return nkMaxBits(f) < nkMinBits(t);
    }
    return !nkSigned(f) && nkMaxBits(f) <= nkMinBits(t);
}

// 混合比较的公共类型：一侧能扩宽到另一侧取较宽者，否则取两侧都能扩宽到的最小类型（i16、i32、int）；无则 0。
function nkCommon(a: int, b: int): int {
    if (nkWidens(a, b)) { return b; }
    if (nkWidens(b, a)) { return a; }
    if (nkWidens(a, 2) && nkWidens(b, 2)) { return 2; }
    if (nkWidens(a, 3) && nkWidens(b, 3)) { return 3; }
    if (nkWidens(a, 11) && nkWidens(b, 11)) { return 11; }
    return 0;
}

// 赋值类位置的自动扩宽：至少一侧是定宽类型（int/float 之间维持 v0.17 规则不变）。
function fwWidensTy(from: Ref<Ty>, to: Ref<Ty>): bool {
    if (from.tag != 21 && to.tag != 21) { return false; }
    const fc = nkOf(from);
    const tc = nkOf(to);
    return fc != 0 && tc != 0 && nkWidens(fc, tc);
}

// 整数实参位（内建的 int 形参、下标）：int，或能无损扩宽到 int 的定宽整数。
function intArg(t: Ref<Ty>): bool {
    return t.tag == 0 || (t.tag == 21 && nkWidens(t.alen, 11));
}

// i/u 后接数字的类型名整体保留（用户 2026-10-15）：任意位宽整数暂不提供，名字留给以后的 i128/u128
// 或位布局字段，免得撞上用户已有的同名类型。
function fwReservedName(n: string): bool {
    if (len(n) < 2) { return false; }
    const c0 = byteAt(n, 0) catch 0;
    if (c0 != 105 && c0 != 117) { return false; }
    let i: int = 1;
    while (i < len(n)) {
        const ch = byteAt(n, i) catch 0;
        if (ch < 48 || ch > 57) { return false; }
        i = i + 1;
    }
    return true;
}

// 定宽类型名在类型位置优先于用户声明，因此不能再用作类型或类型参数的名字。
function fwReservedCheck(s: Ref<Sm>, name: string, line: int, col: int): void {
    if (fwKindByName(name) != 0 || fwReservedName(name)) {
        emitDiag(s, 3034, line, col, "'" + name + "' 是保留的定宽数值类型名，不能用作类型或类型参数的名字");
    }
}

function fwReservedTps(s: Ref<Sm>, tps: List<string>, line: int, col: int): void {
    let i: int = 0;
    while (i < listLen(tps)) {
        fwReservedCheck(s, listGet(tps, i) catch "", line, col);
        i = i + 1;
    }
}

// 整数字面量原文的值（十进制、0x/0o/0b，可含 _；词法已保证不超过 int 上限）。
function litIntValue(raw: string): int {
    let base: int = 10;
    let i: int = 0;
    if (len(raw) > 2 && (byteAt(raw, 0) catch 0) == 48) {
        const p = byteAt(raw, 1) catch 0;
        if (p == 120 || p == 88) { base = 16; i = 2; }
        if (p == 111 || p == 79) { base = 8; i = 2; }
        if (p == 98 || p == 66) { base = 2; i = 2; }
    }
    let v: int = 0;
    while (i < len(raw)) {
        const ch = byteAt(raw, i) catch 0;
        let d: int = -1;
        if (ch >= 48 && ch <= 57) { d = ch - 48; }
        if (ch >= 97 && ch <= 102) { d = ch - 87; }
        if (ch >= 65 && ch <= 70) { d = ch - 55; }
        if (d >= 0) { v = v * base + d; }
        i = i + 1;
    }
    return v;
}

// 整数字面量原文的有效数字（去掉分隔符与前导零，十六进制字母转小写）。
function litSigDigits(raw: string, from: int): string {
    let out: string = "";
    let i: int = from;
    while (i < len(raw)) {
        let ch = byteAt(raw, i) catch 0;
        i = i + 1;
        if (ch == 95 || (ch == 48 && len(out) == 0)) { continue; }
        if (ch >= 65 && ch <= 70) { ch = ch + 32; }
        out = out + (utf8Encode(ch) catch "");
    }
    return out;
}

// 两个有效数字串按数值比较（位数多者大，等长按字典序）。
function digitsGt(a: string, b: string): bool {
    if (len(a) != len(b)) { return len(a) > len(b); }
    let i: int = 0;
    while (i < len(a)) {
        const x = byteAt(a, i) catch 0;
        const y = byteAt(b, i) catch 0;
        if (x != y) { return x > y; }
        i = i + 1;
    }
    return false;
}

// 整数字面量的量级（O4 第二步）：0＝不超过 int 上限；1＝超过 int 上限、不超过 2^64−1（词法放过，只在 u64/usize
// 期望下可用）；2＝超过 2^64−1（词法已报 1004）。
function litBigClass(raw: string): int {
    if ((byteAt(raw, 0) catch 0) == 39) { return 0; }
    let from: int = 0;
    let imax: string = "9223372036854775807";
    let umax: string = "18446744073709551615";
    if (len(raw) > 2 && (byteAt(raw, 0) catch 0) == 48) {
        const p = byteAt(raw, 1) catch 0;
        if (p == 120 || p == 88) { from = 2; imax = "7fffffffffffffff"; umax = "ffffffffffffffff"; }
        if (p == 111 || p == 79) { from = 2; imax = "777777777777777777777"; umax = "1777777777777777777777"; }
        if (p == 98 || p == 66) { from = 2; imax = "111111111111111111111111111111111111111111111111111111111111111"; umax = "1111111111111111111111111111111111111111111111111111111111111111"; }
    }
    const d = litSigDigits(raw, from);
    if (!digitsGt(d, imax)) { return 0; }
    if (!digitsGt(d, umax)) { return 1; }
    return 2;
}

// 超过 int 上限的整数字面量：期望型为 u64/usize 时取该型（codegen 以二补码位载入）；其余情形在词法原先报错的
// 位置（字面量末尾）报 1004，文案同词法。超过 2^64−1 的词法已报过，不再重复。
function bigIntLit(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const fl = fwLitTarget(s, expected);
    if (fl != None) {
        const ft = fl catch s.dT;
        if (ft.alen == 7 || ft.alen == 9) { return ft; }
    }
    if (litBigClass(e.s0) == 1) {
        let msg = "整数字面量超出 int（64 位有符号）范围: " + e.s0;
        if (len(e.s0) > 2 && (byteAt(e.s0, 0) catch 0) == 48) {
            const p = byteAt(e.s0, 1) catch 0;
            if (p == 111 || p == 79 || p == 98 || p == 66) { msg = "整数字面量超出 int 范围"; }
        }
        emitDiag(s, 1004, e.line, e.col + len(e.s0), msg);
    }
    return s.tInt;
}

// 浮点字面量原文的近似值（只用于 f32 有限范围判定）。
function litFloatApprox(raw: string): float {
    let m: float = 0.0;
    let ex: int = 0;
    let i: int = 0;
    let frac: bool = false;
    let digits: int = 0;
    while (i < len(raw)) {
        const ch = byteAt(raw, i) catch 0;
        if (ch == 101 || ch == 69) { break; }
        if (ch == 46) { frac = true; }
        if (ch >= 48 && ch <= 57) {
            if (digits < 18) {
                m = m * 10.0 + ((ch - 48) as float);
                if (m > 0.0) { digits = digits + 1; }
                if (frac) { ex = ex - 1; }
            } else if (!frac) {
                ex = ex + 1;
            }
        }
        i = i + 1;
    }
    if (i < len(raw)) {
        i = i + 1;
        let neg: bool = false;
        if (i < len(raw) && (byteAt(raw, i) catch 0) == 45) { neg = true; i = i + 1; }
        else if (i < len(raw) && (byteAt(raw, i) catch 0) == 43) { i = i + 1; }
        let e2: int = 0;
        while (i < len(raw)) {
            const ch2 = byteAt(raw, i) catch 0;
            if (ch2 >= 48 && ch2 <= 57 && e2 < 100000) { e2 = e2 * 10 + (ch2 - 48); }
            i = i + 1;
        }
        if (neg) { ex = ex - e2; } else { ex = ex + e2; }
    }
    while (ex > 0 && m < 1.0e300) { m = m * 10.0; ex = ex - 1; }
    while (ex < 0 && m > 0.0) { m = m / 10.0; ex = ex + 1; }
    if (ex > 0 && m > 0.0) { return 1.0e300 * 1.0e300; }
    return m;
}

// 字面量的期望定宽类型：期望本身，或可选/失败联合里的定宽类型；否则 None。
function fwLitTarget(s: Ref<Sm>, expected: Ref<Ty>): Ref<Ty>? {
    if (expected == s.dT) { return None; }
    if (expected.tag == 21) { return expected; }
    if (expected.tag == 6 || expected.tag == 7) {
        const inner = expected.inner catch s.dT;
        if (inner.tag == 21) { return inner; }
    }
    return None;
}

// 整数字面量取定宽类型（neg＝前缀负号随字面量一起取型），越界报 3034。
function fwIntLit(s: Ref<Sm>, e: Ref<Expr>, ft: Ref<Ty>, neg: bool, line: int, col: int): Ref<Ty> {
    const k = ft.alen;
    if (k == 10) { return ft; }
    let v = litIntValue(e.s0);
    if (neg) { v = 0 - v; }
    let lo: int = -9223372036854775807 - 1;
    let hi: int = 9223372036854775807;
    if (k == 1) { lo = -128; hi = 127; }
    if (k == 2) { lo = -32768; hi = 32767; }
    if (k == 3) { lo = -2147483647 - 1; hi = 2147483647; }
    if (k == 4) { lo = 0; hi = 255; }
    if (k == 5) { lo = 0; hi = 65535; }
    if (k == 6) { lo = 0; hi = 4294967295; }
    if (k == 7 || k == 9) { lo = 0; }
    if (v < lo || v > hi) {
        let shown = e.s0;
        if (neg) { shown = "-" + shown; }
        let hiText = toStr(hi);
        if (k == 7 || k == 9) { hiText = "18446744073709551615"; }
        emitDiag(s, 3034, line, col, "整数字面量 " + shown + " 超出 " + fwName(k) + " 范围（" + toStr(lo) + ".." + hiText + "）");
    }
    return ft;
}

// 浮点字面量取 f32，超出 f32 有限范围报 3034。
function fwF32Lit(s: Ref<Sm>, e: Ref<Expr>, ft: Ref<Ty>, line: int, col: int): Ref<Ty> {
    if (litFloatApprox(e.s0) > 3.4028235677973366e38) {
        emitDiag(s, 3034, line, col, "浮点字面量 " + e.s0 + " 超出 f32 有限范围");
    }
    return ft;
}

function isNumeric(t: Ref<Ty>): bool {
    return t.tag == 0 || t.tag == 1;
}

// D3 v0.19 错误 enum 与“像 Error 的类型”（Error 或错误 enum——运行期同为 Error 对象）。
function isErrEnumTy(s: Ref<Sm>, t: Ref<Ty>): bool {
    if (t.tag != 14) { return false; }
    return (t.ei catch s.dummyEi).isErr;
}

function isErrLike(s: Ref<Sm>, t: Ref<Ty>): bool {
    return t.tag == 5 || isErrEnumTy(s, t);
}

// 两个失败联合的失败侧是否相同（同为 Error 或同一错误 enum）。
function sameFail(s: Ref<Sm>, a: Ref<Ty>, b: Ref<Ty>): bool {
    if (a.ei == None && b.ei == None) { return true; }
    if (a.ei == None || b.ei == None) { return false; }
    return (a.ei catch s.dummyEi) == (b.ei catch s.dummyEi);
}

function failName(s: Ref<Sm>, t: Ref<Ty>): string {
    if (t.ei == None) { return "Error"; }
    return (t.ei catch s.dummyEi).name;
}

function isFailure(t: Ref<Ty>): bool {
    return t.tag == 6 || t.tag == 7;
}

function tyEq(s: Ref<Sm>, a: Ref<Ty>, b: Ref<Ty>): bool {
    if (a == b) { return true; }
    if (a.tag != b.tag) { return false; }
    const tag = a.tag;
    if ((tag >= 0 && tag <= 5) || tag == 17) { return true; }
    if (tag == 18 || tag == 19 || tag == 21 || tag == 22) { return a.alen == b.alen; }
    if (tag == 11) {
        return a.alen == b.alen && tyEq(s, a.elem catch s.dT, b.elem catch s.dT);
    }
    if (tag == 13) { return (a.si catch s.dummySi) == (b.si catch s.dummySi); }
    if (tag == 14) { return (a.ei catch s.dummyEi) == (b.ei catch s.dummyEi); }
    if (tag == 15) { return sigEq(s, a.sig catch s.dummySig, b.sig catch s.dummySig); }
    // slice（tag 12）载荷在 elem 位非 inner（V0.42-B1-⑤ 执行发现修复：
    // 原形 inner catch a 回落自身——两个异对象同形 slice 比较即无穷递归
    // 栈溢出；新增的绑定 assignable 检查首触该面）。
    if (tag == 12) { return tyEq(s, a.elem catch s.dT, b.elem catch s.dT); }
    if (tag == 7 && !sameFail(s, a, b)) { return false; }
    return tyEq(s, a.inner catch a, b.inner catch b);
}

function sigEq(s: Ref<Sm>, a: Ref<Sig>, b: Ref<Sig>): bool {
    const an = listLen(a.params);
    if (an != listLen(b.params)) { return false; }
    let i: int = 0;
    while (i < an) {
        if (!tyEq(s, listGet(a.params, i) catch a.ret, listGet(b.params, i) catch b.ret)) { return false; }
        i = i + 1;
    }
    return tyEq(s, a.ret, b.ret);
}

function assignable(s: Ref<Sm>, from: Ref<Ty>, to: Ref<Ty>): bool {
    if (tyEq(s, from, to)) { return true; }
    if (fwWidensTy(from, to)) { return true; }
    if (to.tag == 6) {
        const oi = to.inner catch s.dT;
        return tyEq(s, from, oi) || fwWidensTy(from, oi) || (oi.tag == 5 && from.tag == 14 && isErrEnumTy(s, from)) || (oi.tag == 19 && ifaceAccepts(s, from, oi));
    }
    if (to.tag == 7) {
        // D3 v0.19：失败侧为错误 enum 时 err(...) 不能流入（会丢掉种类）；错误 enum 值流入同种或 Error 失败侧；
        // T | E 可放宽为 T | Error。
        if (from.tag == 5) { return to.ei == None; }
        if (from.tag == 14 && isErrEnumTy(s, from)) { return to.ei == None || (to.ei catch s.dummyEi) == (from.ei catch s.dummyEi); }
        if (from.tag == 7 && to.ei == None) { return tyEq(s, from.inner catch s.dT, to.inner catch s.dT); }
        const ti = to.inner catch s.dT;
        return tyEq(s, from, ti) || fwWidensTy(from, ti) || (ti.tag == 19 && ifaceAccepts(s, from, ti));
    }
    if (to.tag == 5) { return from.tag == 14 && isErrEnumTy(s, from); }
    if (to.tag == 19) { return ifaceAccepts(s, from, to); }
    return false;
}

// D3 v0.20：具体类型（或不透明类型参数）的值能否装入接口值——结构化实现关系。
// 不同接口之间不转换（同一接口由 tyEq 处理）。
function ifaceAccepts(s: Ref<Sm>, from: Ref<Ty>, it: Ref<Ty>): bool {
    const ft = from.tag;
    if (ft == 4 || ft == 5 || ft == 6 || ft == 7 || ft == 19) { return false; }
    const scratch: List<int> = listNew();
    return conformMiss(s, from, listGet(s.iv.ifTs, it.alen) catch s.iv.dIfT, s.curMod, scratch) == "";
}

// 赋值类检查＋接口装箱（D3 v0.20）：目标为接口（或接口的可选/失败联合）且值为具体类型时，
// 把值表达式原地包装成隐藏 struct 字面量（self＝原值，其余字段＝实现函数的函数值）。
function assignableE(s: Ref<Sm>, e: Ref<Expr>, from: Ref<Ty>, to: Ref<Ty>): bool {
    if (!assignable(s, from, to)) {
        // 目标是接口而值类型没实现它：报 3030 并给出缺的方法（代替各处的笼统 3002）。
        let it: Ref<Ty> = to;
        if (it.tag == 6 || it.tag == 7) { it = it.inner catch s.dT; }
        const ft = from.tag;
        if (it.tag == 19 && !(ft == 4 || ft == 5 || ft == 6 || ft == 7 || ft == 19)) {
            const ift = listGet(s.iv.ifTs, it.alen) catch s.iv.dIfT;
            const sc: List<int> = listNew();
            const miss = conformMiss(s, from, ift, s.curMod, sc);
            if (miss != "") {
                emitDiag(s, 3030, e.line, e.col, "类型 " + typeNameOf(s, from) + " 不能用作接口 " + ift.name + "：" + miss);
                return true;
            }
        }
        return false;
    }
    if (to.tag == 19 || ((to.tag == 6 || to.tag == 7) && (to.inner catch s.dT).tag == 19)) {
        ifaceBox(s, e, from, to);
    }
    return true;
}

function stripRef(t: Ref<Ty>): Ref<Ty> {
    let ty = t;
    while (ty.tag == 8) {
        ty = ty.inner catch ty;
    }
    return ty;
}

// —— 分析节的记录（§四-2）——
function anaKey(m: int, l: int, c: int, h: int, tt: int): Ref<AnaRow> {
    let kh = h;
    if (l <= 0) { kh = -1; }
    return new AnaRow { m: 0, l: 0, c: 0, how: 0, tt: tt, flags: 0, km: m, kl: l, kc: c, kh: kh, name: "" };
}

// 合成名（`#` 开头）不在源码里。
function anaSynth(name: string): bool {
    return len(name) == 0 || (byteAt(name, 0) catch 35) == 35;
}

// 声明行（键是它自己），返回行号；未打开或合成名返回 -1。
function anaDecl(m: int, l: int, c: int, how: int, tt: int, name: string): int {
    if (!anaOn || anaSynth(name)) { return -1; }
    listPush(anaRows, new AnaRow { m: m, l: l, c: c, how: how, tt: tt, flags: 1, km: m, kl: l, kc: c, kh: how, name: name });
    return listLen(anaRows) - 1;
}

// 使用行：身份取自 key（声明行或 anaKey 造的键）；没有身份时不记。
function anaUse(s: Ref<Sm>, l: int, c: int, how: int, name: string, key: Ref<AnaRow>): void {
    if (!anaOn || key.kh < 0 || anaSynth(name)) { return; }
    listPush(anaRows, new AnaRow { m: s.curMod.idx, l: l, c: c, how: how, tt: key.tt, flags: 0, km: key.km, kl: key.kl, kc: key.kc, kh: key.kh, name: name });
}

// 没有身份、只供着色的出现（错误值的 message、cause）。
function anaTint(s: Ref<Sm>, l: int, c: int, tt: int, name: string): void {
    if (!anaOn || anaSynth(name)) { return; }
    listPush(anaRows, new AnaRow { m: s.curMod.idx, l: l, c: c, how: ANA_AT_EXACT, tt: tt, flags: 0, km: 0, kl: 0, kc: 0, kh: -1, name: name });
}

// 标识符引用局部或顶层绑定：身份为该绑定的声明行。
function anaUseDecl(s: Ref<Sm>, e: Ref<Expr>, decl: int): void {
    if (!anaOn || decl < 0) { return; }
    anaUse(s, e.line, e.col, ANA_AT_EXACT, e.s0, listGet(anaRows, decl) catch anaKey(0, 0, 0, -1, 0));
}

// 函数的键：声明名的位置（泛型实例的副本保留模板的位置，各实例因此同键）。
function anaFnKey(s: Ref<Sm>, fnIdx: int): Ref<AnaRow> {
    const fe = listGet(s.fns, fnIdx) catch s.dummyFE;
    return anaKey(fe.module_idx, fe.decl.line, fe.decl.col, ANA_AT_EXACT, ANA_TT_FN);
}

function anaStKey(si: Ref<StructT>, h: int, tt: int): Ref<AnaRow> {
    return anaKey(si.module_idx, si.aLine, si.aCol, h, tt);
}

function anaEnKey(ei: Ref<EnumT>, h: int, tt: int): Ref<AnaRow> {
    return anaKey(ei.module_idx, ei.aLine, ei.aCol, h, tt);
}

// 导入名所指符号的键；接口、句柄与其它种类没有身份。
function anaSymKey(s: Ref<Sm>, sym: Ref<Sym>): Ref<AnaRow> {
    if (sym.kind == 1 && sym.decl >= 0) { return listGet(anaRows, sym.decl) catch anaKey(0, 0, 0, -1, 0); }
    if (sym.kind == 2) { return anaFnKey(s, sym.fnIdx); }
    if (sym.kind == 6) {
        const gf = sym.gfn catch s.dGf;
        return anaKey(gf.module_idx, gf.decl.line, gf.decl.col, ANA_AT_EXACT, ANA_TT_FN);
    }
    if (sym.kind == 3) { return anaStKey(sym.si catch s.dummySi, ANA_AT_EXACT, ANA_TT_STRUCT); }
    if (sym.kind == 7) {
        const gs = sym.gst catch s.dGs;
        return anaKey(gs.module_idx, gs.decl.line, gs.decl.col, ANA_AT_EXACT, ANA_TT_STRUCT);
    }
    if (sym.kind == 4) { return anaEnKey(sym.ei catch s.dummyEi, ANA_AT_EXACT, ANA_TT_ENUM); }
    return anaKey(0, 0, 0, -1, 0);
}

// 被调名：标识符取其位置，字段形（方法糖、UFCS 形）取名字的位置。方法糖的名字是方法名、不是函数名，函数的键不带名字，
// 所以仍归入同一身份（LSP 由声明行的名字认出方法糖）。
function anaCallee(s: Ref<Sm>, e: Ref<Expr>, key: Ref<AnaRow>): void {
    if (!anaOn) { return; }
    const callee = e.a catch s.dummyE;
    if (callee.tag == 31) {
        anaUse(s, callee.line, callee.col, ANA_AT_EXACT, callee.s0, key);
    } else if (callee.tag == 36) {
        anaUse(s, callee.i1, callee.i2, ANA_AT_EXACT, callee.s0, key);
    }
}

// `E.V`、`E.V(…)`、`new E.V(…)`：变体存在时记 enum 名与变体名。
function anaVariant(s: Ref<Sm>, ei: Ref<EnumT>, el: int, ec: int, ehow: int, ename: string, vl: int, vc: int, vname: string): void {
    if (!anaOn) { return; }
    let i: int = 0;
    while (i < listLen(ei.vars)) {
        if ((listGet(ei.vars, i) catch s.dVarT).name == vname) {
            anaUse(s, el, ec, ehow, ename, anaEnKey(ei, ANA_AT_EXACT, ANA_TT_ENUM));
            anaUse(s, vl, vc, ANA_AT_EXACT, vname, anaEnKey(ei, ANA_AT_VARIANT, ANA_TT_MEMBER));
            return;
        }
        i = i + 1;
    }
}

function anaStructDecl(m: int, sd: Ref<StructDecl>, xst: bool): void {
    if (!anaOn) { return; }
    anaDecl(m, sd.line, sd.col, ANA_AT_EXACT, ANA_TT_STRUCT, sd.name);
    let head: string = "struct ";
    if (xst) { head = "declare struct "; }
    let body: string = " {}";
    if (listLen(sd.fnames) > 0) { body = " { " + fieldsText(sd.fnames, sd.ftes) + " }"; }
    anaDet(m, sd.line, sd.col, ANA_AT_EXACT, sd.exported, sd.name, head + sd.name + anaTpsText(sd.tps, sd.tcs) + body);
    let i: int = 0;
    while (i < listLen(sd.fnames)) {
        const fname = listGet(sd.fnames, i) catch "";
        anaDecl(m, sd.line, sd.col, ANA_AT_FIELD, ANA_TT_PROP, fname);
        anaDet(m, sd.line, sd.col, ANA_AT_FIELD, false, fname, sd.name + "." + fname + ": " + teText(listGet(sd.ftes, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() }));
        i = i + 1;
    }
}

// —— 声明的说明文本（6d-3b，§四-5）——
function anaDet(m: int, l: int, c: int, how: int, exported: bool, name: string, text: string): void {
    if (!anaOn || anaSynth(name)) { return; }
    let f: int = 0;
    if (exported) { f = 1; }
    listPush(anaDets, new AnaDet { m: m, l: l, c: c, how: how, flags: f, name: name, text: text });
}

// 型参表照语言的写法（约束写 `T extends C`；3033 的导出面比对用的 tpsText 写 `T: C`，不改它）。
function anaTpsText(tps: List<string>, tcs: List<Ref<Te>>): string {
    if (listLen(tps) == 0) { return ""; }
    let acc: string = "<";
    let i: int = 0;
    while (i < listLen(tps)) {
        if (i > 0) { acc = acc + ", "; }
        acc = acc + (listGet(tps, i) catch "");
        const c = listGet(tcs, i) catch new Te { tag: 0, name: "", a: None, alen: 0, ls: listNew() };
        if (c.tag != 0) { acc = acc + " extends " + teText(c); }
        i = i + 1;
    }
    return acc + ">";
}

// 带形参名的形参表，类型照写；nfix ≥ 0 时第 nfix 个起是外部函数的 C 变参参数（写 `...`）。
function anaParamsText(s: Ref<Sm>, ps: List<Ref<Param>>, nfix: int): string {
    let acc: string = "(";
    let i: int = 0;
    while (i < listLen(ps)) {
        const p = listGet(ps, i) catch s.dummyParam;
        if (i > 0) { acc = acc + ", "; }
        if (nfix >= 0 && i >= nfix) { acc = acc + "..."; }
        acc = acc + p.name + ": " + teText(p.ty);
        i = i + 1;
    }
    return acc + ")";
}

// 函数（含泛型模板）的说明与各形参的说明，由声明的书写生成（模板的型参照写，与实例无关）。
function anaFnDetail(s: Ref<Sm>, m: int, f: Ref<FnDecl>): void {
    if (!anaOn) { return; }
    let head: string = "function ";
    if (f.isAsync) { head = "async function "; }
    if (f.isGen) { head = "function* "; }
    let rt: string = "void";
    if (f.ret != None) { rt = teText(f.ret catch s.dummyTe); }
    anaDet(m, f.line, f.col, ANA_AT_EXACT, f.exported, f.name, head + f.name + anaTpsText(f.tps, f.tcs) + anaParamsText(s, f.params, -1) + ": " + rt);
    let i: int = 0;
    while (i < listLen(f.params)) {
        const p = listGet(f.params, i) catch s.dummyParam;
        anaDet(m, f.line, f.col, ANA_AT_PARAM, false, p.name, p.name + ": " + teText(p.ty));
        i = i + 1;
    }
}

// 绑定（顶层与局部、解构元素、for-in 变量）：写了类型的照写，没写的取检查得到的类型。
function anaBindDetail(s: Ref<Sm>, m: int, l: int, c: int, exported: bool, isConst: bool, name: string, te: Ref<Te>?, ty: Ref<Ty>): void {
    if (!anaOn) { return; }
    let head: string = "let ";
    if (isConst) { head = "const "; }
    let tt: string = "";
    if (te != None) {
        tt = teText(te catch s.dummyTe);
    } else {
        tt = anaTyText(s, ty);
    }
    anaDet(m, l, c, ANA_AT_BIND, exported, name, head + name + ": " + tt);
}

// 检查得到的类型的显示：同 typeNameOf，但不开改编，泛型 struct 实例写成模板名加实参（`Map<string, int>`）。
function anaTyText(s: Ref<Sm>, t: Ref<Ty>): string {
    const tag = t.tag;
    if (tag == 6) { return anaTyText(s, t.inner catch s.dT) + "?"; }
    if (tag == 7) { return anaTyText(s, t.inner catch s.dT) + " | " + failName(s, t); }
    if (tag == 8) { return "Ref<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 9) { return "Weak<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 10) { return "List<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 11) { return "[" + toStr(t.alen) + "]" + anaTyText(s, t.elem catch s.dT); }
    if (tag == 12) { return "[]" + anaTyText(s, t.elem catch s.dT); }
    if (tag == 16) { return "Future<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 20) { return "Gen<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 23) { return "Thread<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 24) { return "Shared<" + anaTyText(s, t.inner catch s.dT) + ">"; }
    if (tag == 13) {
        const si = t.si catch s.dummySi;
        const gi = iaGet(s, si.serial);
        if (gi < 0) { return si.name; }
        const off = listGet(s.iaOff, gi) catch 0;
        const n = listGet(s.iaN, gi) catch 0;
        let acc: string = (listGet(s.iaGs, gi) catch s.dGs).decl.name + "<";
        let i: int = 0;
        while (i < n) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + anaTyText(s, listGet(s.iaFlat, off + i) catch s.dT);
            i = i + 1;
        }
        return acc + ">";
    }
    if (tag == 15) {
        const sig = t.sig catch s.dummySig;
        let acc: string = "(";
        let i: int = 0;
        while (i < listLen(sig.params)) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + anaTyText(s, listGet(sig.params, i) catch s.dT);
            i = i + 1;
        }
        return acc + ") => " + anaTyText(s, sig.ret);
    }
    const savedM = s.iv.mangling;
    s.iv.mangling = false;
    const out = typeNameOf(s, t);
    s.iv.mangling = savedM;
    return out;
}

// 只取检查得到的类型的说明（catch 绑定、模式绑定、没写类型的箭头函数形参）。
function anaTyDetail(s: Ref<Sm>, how: int, l: int, c: int, name: string, ty: Ref<Ty>): void {
    if (!anaOn) { return; }
    anaDet(s.curMod.idx, l, c, how, false, name, name + ": " + anaTyText(s, ty));
}

function anaDetEmit(o: Ref<Out>, ctx: Ref<Cur>): void {
    listPush(o.parts, "ANT1 ");
    outDec(o, listLen(anaDets));
    let k: int = 0;
    while (k < listLen(anaDets)) {
        const d = listGet(anaDets, k) catch new AnaDet { m: 0, l: 0, c: 0, how: 0, flags: 0, name: "", text: "" };
        listPush(o.parts, toStr(d.m) + " " + toStr(d.l) + " " + toStr(d.c) + " " + toStr(d.how) + " " + toStr(d.flags) + " ");
        outStr(o, ctx, d.name);
        outStr(o, ctx, d.text);
        k = k + 1;
    }
}

function anaEnumDecl(s: Ref<Sm>, m: int, ed: Ref<EnumDecl>): void {
    if (!anaOn) { return; }
    anaDecl(m, ed.line, ed.col, ANA_AT_EXACT, ANA_TT_ENUM, ed.name);
    let vars: string = "";
    let i: int = 0;
    while (i < listLen(ed.vars)) {
        const vd = listGet(ed.vars, i) catch s.dVd;
        anaDecl(m, ed.line, ed.col, ANA_AT_VARIANT, ANA_TT_MEMBER, vd.name);
        let vt: string = vd.name;
        if (listLen(vd.fnames) > 0) { vt = vt + "(" + fieldsText(vd.fnames, vd.ftes) + ")"; }
        anaDet(m, ed.line, ed.col, ANA_AT_VARIANT, false, vd.name, ed.name + "." + vt);
        if (i > 0) { vars = vars + ", "; }
        vars = vars + vt;
        i = i + 1;
    }
    let head: string = "enum " + ed.name;
    if (ed.isErr) { head = head + " extends Error"; }
    let body: string = " {}";
    if (listLen(ed.vars) > 0) { body = " { " + vars + " }"; }
    anaDet(m, ed.line, ed.col, ANA_AT_EXACT, ed.exported, ed.name, head + body);
}

function anaExternDecl(s: Ref<Sm>, m: int, x: Ref<ExternDecl>): int {
    if (!anaOn) { return -1; }
    const d = anaDecl(m, x.line, x.col, ANA_AT_EXACT, ANA_TT_FN, x.name);
    anaDet(m, x.line, x.col, ANA_AT_EXACT, false, x.name, "declare function " + x.name + anaParamsText(s, x.params, x.nfix) + ": " + teText(x.ret));
    let i: int = 0;
    while (i < listLen(x.params)) {
        const p = listGet(x.params, i) catch s.dummyParam;
        anaDecl(m, x.line, x.col, ANA_AT_PARAM, ANA_TT_PARAM, p.name);
        let dots: string = "";
        if (x.nfix >= 0 && i >= x.nfix) { dots = "..."; }
        anaDet(m, x.line, x.col, ANA_AT_PARAM, false, p.name, dots + p.name + ": " + teText(p.ty));
        i = i + 1;
    }
    return d;
}

function anaEmit(o: Ref<Out>, ctx: Ref<Cur>): void {
    listPush(o.parts, "ANA1 ");
    outDec(o, listLen(anaRows));
    let k: int = 0;
    while (k < listLen(anaRows)) {
        const r = listGet(anaRows, k) catch anaKey(0, 0, 0, -1, 0);
        // 一行的整数合成一段（与逐个 outDec 同形），行数多时少拼接。
        listPush(o.parts, toStr(r.m) + " " + toStr(r.l) + " " + toStr(r.c) + " " + toStr(r.how) + " " + toStr(r.tt) + " " + toStr(r.flags) + " " + toStr(r.km) + " " + toStr(r.kl) + " " + toStr(r.kc) + " " + toStr(r.kh + 1) + " ");
        outStr(o, ctx, r.name);
        k = k + 1;
    }
}

// —— 表写入（键＝节点 ID；值载荷用 serial——池遍历时换 pool id）——
function putTy(s: Ref<Sm>, e: Ref<Expr>, t: Ref<Ty>): void {
    listPush(s.tExprTy, mkRow(e.id, t.serial, 0, 0, 0, 0, 0));
}

function putExprResLocal(s: Ref<Sm>, e: Ref<Expr>, slot: int): void {
    listPush(s.tExprRes, mkRow(e.id, 0, slot, 0, 0, 0, 0));
}

function putExprResGlobal(s: Ref<Sm>, e: Ref<Expr>, module_idx: int, slot: int): void {
    listPush(s.tExprRes, mkRow(e.id, 1, module_idx, slot, 0, 0, 0));
}

function putExprResFunc(s: Ref<Sm>, e: Ref<Expr>, fnIdx: int): void {
    listPush(s.tExprRes, mkRow(e.id, 2, fnIdx, 0, 0, 0, 0));
}

function putExprResBuiltin(s: Ref<Sm>, e: Ref<Expr>, bi: int): void {
    listPush(s.tExprRes, mkRow(e.id, 3, bi, 0, 0, 0, 0));
    if (smCheckCapture && bi == 47 && s.iv.defCheck == 0) {
        const a = listGet(e.list, 0) catch s.dummyE;
        smCheckRecordEmbed(e.id, s.curMod.idx, e.line, e.col, a.s0, a.tag == 28);
    }
}

function putExprResExtern(s: Ref<Sm>, e: Ref<Expr>, xi: int): void {
    listPush(s.tExprRes, mkRow(e.id, 4, xi, 0, 0, 0, 0));
}

function putBindSlot(s: Ref<Sm>, b: Ref<Binding>, slot: int): void {
    listPush(s.tBindSlot, mkRow(b.id, slot, 0, 0, 0, 0, 0));
}

function putBodySlot(s: Ref<Sm>, blk: Ref<Block>, cap: int): void {
    listPush(s.tBodySlots, mkRow(blk.id, cap, 0, 0, 0, 0, 0));
}

function allocSlot(s: Ref<Sm>): int {
    const v = s.nextSlot;
    s.nextSlot = s.nextSlot + 1;
    return v;
}

function synAlloc(s: Ref<Sm>): int {
    const v = s.synNext;
    s.synNext = s.synNext + 1;
    return v;
}

// —— 作用域 ——
function scopePush(s: Ref<Sm>): void {
    listPush(s.scopes, new Scope { names: listNew(), syms: listNew(), hHead: listNew(), hNext: listNew() });
}

function scopePop(s: Ref<Sm>): void {
    listRemoveAt(s.scopes, listLen(s.scopes) - 1);
}

function scopeTop(s: Ref<Sm>): Ref<Scope> {
    return listGet(s.scopes, listLen(s.scopes) - 1) catch s.dummyScope;
}

function scopeAt(s: Ref<Sm>, i: int): Ref<Scope> {
    return listGet(s.scopes, i) catch s.dummyScope;
}

function declareLocal(s: Ref<Sm>, name: string, slot: int, ty: Ref<Ty>, isConst: bool, decl: int): void {
    const sc = scopeTop(s);
    listPush(sc.names, name);
    listPush(sc.syms, new Sym { kind: 0, slot: slot, ty: ty, isConst: isConst, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: decl });
}

// 模块符号索引（容量批 C3c）：散列链，桶数取不小于 2 倍符号数的 2 的幂。原为名序副表＋二分、
// “长度不符即重建”——注册期每个声明先查重再追加，每次查重都整表重建，4 千个函数时注册 14 秒。
// 语义不变：同名取最后登记的（按原索引升序头插，链头即最新）。
function symHash(name: string): int {
    let h: int = 0;
    let i: int = 0;
    const n = len(name);
    while (i < n) {
        h = (h * 31 + (byteAt(name, i) catch 0)) % 1073741824;
        i = i + 1;
    }
    return h;
}

function symIdxLink(m: Ref<Mod>, i: int): void {
    const b = symHash(listGet(m.symNames, i) catch "") % listLen(m.symIdx);
    listPush(m.symNext, listGet(m.symIdx, b) catch -1);
    listSet(m.symIdx, b, i);
}

function symIdxRebuild(m: Ref<Mod>): void {
    const n = listLen(m.symNames);
    let nb: int = 64;
    while (nb < n * 2) { nb = nb * 2; }
    m.symIdx = listNew();
    m.symNext = listNew();
    let b: int = 0;
    while (b < nb) {
        listPush(m.symIdx, -1);
        b = b + 1;
    }
    let i: int = 0;
    while (i < n) {
        symIdxLink(m, i);
        i = i + 1;
    }
}

function modSymGet(m: Ref<Mod>, name: string): Ref<Sym>? {
    const n = listLen(m.symNames);
    if (n == 0) { return None; }
    if (listLen(m.symNext) != n) { symIdxRebuild(m); }
    let i: int = listGet(m.symIdx, symHash(name) % listLen(m.symIdx)) catch -1;
    while (i >= 0) {
        if ((listGet(m.symNames, i) catch "") == name) {
            return listGet(m.symVals, i);
        }
        i = listGet(m.symNext, i) catch -1;
    }
    return None;
}

function modSymPut(m: Ref<Mod>, name: string, sym: Ref<Sym>): void {
    listPush(m.symNames, name);
    listPush(m.symVals, sym);
    // 索引已同步且负载未过半时增量挂链；否则留给下次查询重建（桶数随之翻倍）。
    const n = listLen(m.symNames);
    if (listLen(m.symNext) == n - 1 && listLen(m.symIdx) >= n * 2) { symIdxLink(m, n - 1); }
}

function lookupSC(s: Ref<Sm>, name: string): Ref<Sym>? {
    let i: int = listLen(s.scopes) - 1;
    while (i >= 0) {
        const sc = scopeAt(s, i);
        const j = scopeFind(sc, name);
        if (j >= 0) {
            return listGet(sc.syms, j);
        }
        i = i - 1;
    }
    return modSymGet(s.curMod, name);
}

struct LookupHit {
    sym: Ref<Sym>,
    depth: int,
    hit: bool,
}

function lookupDepth(s: Ref<Sm>, name: string): Ref<LookupHit> {
    let i: int = listLen(s.scopes) - 1;
    while (i >= 0) {
        const sc = scopeAt(s, i);
        const j = scopeFind(sc, name);
        if (j >= 0) {
            return new LookupHit { sym: listGet(sc.syms, j) catch s.dummySym, depth: i, hit: true };
        }
        i = i - 1;
    }
    const g = modSymGet(s.curMod, name);
    const sym = g catch s.dummySym;
    if (sym.kind != -1) {
        return new LookupHit { sym: sym, depth: listLen(s.scopes), hit: true };
    }
    return new LookupHit { sym: s.dummySym, depth: 0, hit: false };
}

// 内建名表（预声明标识符；被用户声明遮蔽——D3 §3）。
function builtinOf(name: string): int {
    if (name == "print") { return 0; }
    if (name == "err") { return 1; }
    if (name == "readFile") { return 2; }
    if (name == "len") { return 3; }
    if (name == "toStr") { return 4; }
    if (name == "unref") { return 5; }
    if (name == "weak") { return 6; }
    if (name == "deref") { return 7; }
    if (name == "byteAt") { return 8; }
    if (name == "utf8Encode") { return 9; }
    if (name == "listNew") { return 10; }
    if (name == "listPush") { return 11; }
    if (name == "listPop") { return 12; }
    if (name == "listGet") { return 13; }
    if (name == "listSet") { return 14; }
    if (name == "listLen") { return 15; }
    if (name == "assert") { return 16; }
    if (name == "panic") { return 17; }
    if (name == "taskCancel") { return 18; }
    if (name == "taskCancelled") { return 19; }
    if (name == "taskAwaitAny") { return 20; }
    if (name == "writeFile") { return 21; }
    if (name == "nowMs") { return 22; }
    if (name == "sleepMs") { return 23; }
    if (name == "listRemoveAt") { return 24; }
    if (name == "listInsert") { return 25; }
    if (name == "strSub") { return 26; }
    if (name == "strIndexOf") { return 27; }
    if (name == "strSplit") { return 28; }
    if (name == "imul") { return 29; }
    if (name == "eprint") { return 30; }
    if (name == "listDir") { return 31; }
    if (name == "entryKind") { return 32; }
    if (name == "writeFileBytes") { return 33; }
    if (name == "makeDir") { return 34; }
    if (name == "writeExecutable") { return 35; }
    // D3 v0.18 Bytes（36..47；docs/design/v052-bytes-embed-stage0-v0.1-20261013.md §三）。
    if (name == "bytesNew") { return 36; }
    if (name == "bytesLen") { return 37; }
    if (name == "bytesGet") { return 38; }
    if (name == "bytesSet") { return 39; }
    if (name == "bytesPush") { return 40; }
    if (name == "bytesAppend") { return 41; }
    if (name == "bytesSlice") { return 42; }
    if (name == "bytesEqual") { return 43; }
    if (name == "bytesFromStr") { return 44; }
    if (name == "bytesToStr") { return 45; }
    if (name == "readFileBytes") { return 46; }
    if (name == "embedBytes") { return 47; }
    // D3 v0.19 结构化错误（48..49）。
    if (name == "errAs") { return 48; }
    if (name == "errWrap") { return 49; }
    // D3 v0.21 工具链系统内建（50..56；仅 --toolchain；docs/design/v052-native-run-test-async-v0.1-20261014.md §五）；
    // hostArch（79，v0.35）、setEnv（86，v0.42，docs/design/v052-gate-tx-v0.1-20261026.md）同族。
    if (name == "hostTarget") { return 50; }
    if (name == "hostArch") { return 79; }
    if (name == "getEnv") { return 51; }
    if (name == "setEnv") { return 86; }
    if (name == "runProcess") { return 52; }
    if (name == "tempDir") { return 53; }
    if (name == "removeFile") { return 54; }
    if (name == "selfExePath") { return 55; }
    if (name == "monoNs") { return 56; }
    // D3 v0.22 生成器（57..58；sema 序数，codegen 直发 gen_next/gen_close 操作码，不占 BuiltinId）。
    // #genNext/#genClose 只出现在 for-in 解糖里（# 名用户写不出，不会被遮蔽）。
    if (name == "genNext" || name == "#genNext") { return 57; }
    if (name == "#genClose") { return 58; }
    // 定宽数值（O4 第一步）：wrapTo<T>(x) 截断重解释（59；codegen 直发 cvt，不占 BuiltinId）。
    if (name == "wrapTo") { return 59; }
    // D3 v0.23 FFI：句柄与位值互转（60..61；codegen 直发——运行期句柄即整数，不占 BuiltinId）。
    if (name == "handleBits") { return 60; }
    if (name == "handleFromBits") { return 61; }
    // 外部函数调用后保存的系统错误码（62；运行期 BuiltinId 60）。
    if (name == "ffiLastError") { return 62; }
    // D3 v0.23：浮点与位模式互转（63..64；codegen 直发 cvt 种类 25/26，不占 BuiltinId；std/math 纯太虚实现用）。
    if (name == "floatToBits") { return 63; }
    if (name == "floatFromBits") { return 64; }
    // 线程（线程设计第 2 步，D3 v0.24 草案；65..66，运行期 BuiltinId 61/62）。
    if (name == "threadSpawn") { return 65; }
    if (name == "threadJoin") { return 66; }
    // 线程第 4c 步：Shared 与 Atomic（67..73，运行期 BuiltinId 63..69）。
    if (name == "sharedNew") { return 67; }
    if (name == "sharedGet") { return 68; }
    if (name == "atomicNew") { return 69; }
    if (name == "atomicLoad") { return 70; }
    if (name == "atomicStore") { return 71; }
    if (name == "atomicAdd") { return 72; }
    if (name == "atomicCas") { return 73; }
    // 定宽数值（O4 第二步）：环绕运算 wrapAdd/wrapSub/wrapMul（74..76；codegen 直发，不占 BuiltinId）。
    if (name == "wrapAdd") { return 74; }
    if (name == "wrapSub") { return 75; }
    if (name == "wrapMul") { return 76; }
    // O4 第二步 2c2：Bytes 与 List<u8> 零拷贝互转（同一个对象；BuiltinId 74/75）。
    if (name == "bytesAsList") { return 77; }
    if (name == "listAsBytes") { return 78; }
    // D3 v0.37 Bytes 批量操作（LANG-32）：区间拷贝、填充与定宽数值按端序读写。
    if (name == "bytesCopy") { return 80; }
    if (name == "bytesFill") { return 81; }
    if (name == "bytesGetLE") { return 82; }
    if (name == "bytesGetBE") { return 83; }
    if (name == "bytesSetLE") { return 84; }
    if (name == "bytesSetBE") { return 85; }
    // __rt 内部内建（2048..2054＝运行期编号，codegen 原样下发；线程设计 §十六）：进程级句柄表、环境表与入口保存的命令行
    // 参数（D3 v0.41），只供标准库模块调用（checkRtBuiltin 按 SEIN 标记拒绝其余模块）。
    if (name == "__rtHandleAdd") { return 2048; }
    if (name == "__rtHandlePeek") { return 2049; }
    if (name == "__rtHandleTake") { return 2050; }
    if (name == "__rtEnvGet") { return 2051; }
    if (name == "__rtEnvSet") { return 2052; }
    if (name == "__rtArgCount") { return 2053; }
    if (name == "__rtArgAt") { return 2054; }
    // 工具链进程与标准输入内建（3584..3594＝运行期编号，codegen 原样下发；仅 --toolchain；TOOL-103，调试实施设计 §四-6；
    // fileSize 为第 6 轮 6d-1a 所加，LSP 与 MCP 实施设计 §三-4）。
    if (name == "stdinRead") { return 3584; }
    if (name == "stdoutWrite") { return 3585; }
    if (name == "procSpawn") { return 3586; }
    if (name == "procSpawnLimited") { return 3595; }
    if (name == "procWrite") { return 3587; }
    if (name == "procRead") { return 3588; }
    if (name == "ioWait") { return 3589; }
    if (name == "procKill") { return 3590; }
    if (name == "procWait") { return 3591; }
    if (name == "procClose") { return 3592; }
    if (name == "currentDir") { return 3593; }
    if (name == "fileSize") { return 3594; }
    if (name == "readLocalFileBytes") { return 3596; }
    if (name == "localEntryKind") { return 3597; }
    if (name == "localFileSize") { return 3598; }
    if (name == "localListDir") { return 3600; }
    if (name == "procTryWrite") { return 3599; }
    return -1;
}

// sema.zig builtinArity 逐 id 镜像（V0.42-B1-⑤ 执行发现修正：原形为无消费
// 死表且值有误——taskAwaitAny(20)/sleepMs(23) 误 2、writeFile(21) 落默认 1；
// wantArgs 垫位面启用后即承重，逐 id 对齐 zig：0＝listNew/taskCancelled/nowMs、
// 3＝listSet/listInsert/strSub、2＝byteAt/listPush/listGet/assert/writeFile/
// listRemoveAt/strIndexOf/strSplit/imul、其余 1〔含 taskAwaitAny/sleepMs〕）。
function builtinArity(b: int): int {
    if (b == 10 || b == 19 || b == 22) { return 0; }
    if (b == 14 || b == 25 || b == 26) { return 3; }
    if (b == 8 || b == 11 || b == 13 || b == 16 || b == 21 || b == 24 || b == 27 || b == 28 || b == 29 || b == 33 || b == 35) { return 2; }
    if (b == 39 || b == 42) { return 3; }
    if (b == 38 || b == 40 || b == 41 || b == 43) { return 2; }
    if (b == 49) { return 2; }
    if (b == 50 || b == 53 || b == 55 || b == 56 || b == 62 || b == 79) { return 0; }
    if (b == 52) { return 3; }
    if (b == 71 || b == 72 || b == 86) { return 2; }
    if (b == 73) { return 3; }
    if (b >= 74 && b <= 76) { return 2; }
    if (b == 80) { return 5; }
    if (b == 81) { return 4; }
    if (b == 82 || b == 83) { return 2; }
    if (b == 84 || b == 85) { return 3; }
    if (b == 2052) { return 2; }
    if (b == 2053) { return 0; }
    if (b == 3584 || b == 3591) { return 2; }
    if (b == 3586) { return 4; }
    if (b == 3595) { return 6; }
    if (b == 3596) { return 3; }
    if (b == 3599) { return 3; }
    if (b == 3597 || b == 3598 || b == 3600) { return 2; }
    if (b == 3593) { return 0; }
    if (b >= 3587 && b <= 3589) { return 3; }
    return 1;
}

// —— 类型图池（§6.3 首触 ID；self 先行、子随声明序深度优先）——
function tyId(s: Ref<Sm>, t: Ref<Ty>): int {
    if (t.tag == 0 && t.serial != 0) {
    }
    const have = listGet(s.tyPool, t.serial) catch -1;
    if (have >= 0) { return have; }
    const id = listLen(s.tyOrder);
    listPush(s.tyOrder, t.serial);
    listSet(s.tyPool, t.serial, id);
    const tag = t.tag;
    if ((tag >= 6 && tag <= 10) || tag == 16 || tag == 19 || tag == 20 || tag == 23 || tag == 24 || tag == 25) {
        tyId(s, t.inner catch s.dT);
    } else if (tag == 11 || tag == 12) {
        tyId(s, t.elem catch s.dT);
    } else if (tag == 13) {
        structId(s, t.si catch s.dummySi);
    } else if (tag == 14) {
        enumId(s, t.ei catch s.dummyEi);
    } else if (tag == 15) {
        sigId(s, t.sig catch s.dummySig);
    }
    return id;
}

function structId(s: Ref<Sm>, si: Ref<StructT>): int {
    const have = listGet(s.stPool, si.serial) catch -1;
    if (have >= 0) { return have; }
    const id = listLen(s.stOrder);
    listPush(s.stOrder, si.serial);
    listSet(s.stPool, si.serial, id);
    let i: int = 0;
    const n = listLen(si.ftys);
    while (i < n) {
        tyId(s, listGet(si.ftys, i) catch s.dT);
        i = i + 1;
    }
    return id;
}

function enumId(s: Ref<Sm>, ei: Ref<EnumT>): int {
    const have = listGet(s.enPool, ei.serial) catch -1;
    if (have >= 0) { return have; }
    const id = listLen(s.enOrder);
    listPush(s.enOrder, ei.serial);
    listSet(s.enPool, ei.serial, id);
    let i: int = 0;
    const n = listLen(ei.vars);
    while (i < n) {
        const v = listGet(ei.vars, i) catch s.dVarT;
        let j: int = 0;
        const m = listLen(v.ftys);
        while (j < m) {
            tyId(s, listGet(v.ftys, j) catch s.dT);
            j = j + 1;
        }
        i = i + 1;
    }
    return id;
}

function sigId(s: Ref<Sm>, sig: Ref<Sig>): int {
    const have = listGet(s.sgPool, sig.serial) catch -1;
    if (have >= 0) { return have; }
    const id = listLen(s.sgOrder);
    listPush(s.sgOrder, sig.serial);
    listSet(s.sgPool, sig.serial, id);
    let i: int = 0;
    const n = listLen(sig.params);
    while (i < n) {
        tyId(s, listGet(sig.params, i) catch s.dT);
        i = i + 1;
    }
    tyId(s, sig.ret);
    return id;
}

// —— typeName（实例 mangled 名拼写面；RAW——发射面 escapeRaw 兜转义）——
function typeNameOf(s: Ref<Sm>, t: Ref<Ty>): string {
    const tag = t.tag;
    if (tag == 0) { return "int"; }
    if (tag == 1) { return "float"; }
    if (tag == 2) { return "bool"; }
    if (tag == 3) { return "string"; }
    if (tag == 4) { return "void"; }
    if (tag == 5) { return "Error"; }
    if (tag == 6) { return typeNameOf(s, t.inner catch s.dT) + "?"; }
    if (tag == 7) { return typeNameOf(s, t.inner catch s.dT) + " | " + failName(s, t); }
    if (tag == 8) { return "Ref<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 9) { return "Weak<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 10) { return "List<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 11) { return "[" + toStr(t.alen) + "]" + typeNameOf(s, t.elem catch s.dT); }
    if (tag == 12) { return "[]" + typeNameOf(s, t.elem catch s.dT); }
    if (tag == 13) { return (t.si catch s.dummySi).name; }
    if (tag == 14) { return (t.ei catch s.dummyEi).name; }
    if (tag == 15) {
        const sig = t.sig catch s.dummySig;
        let acc: string = "(";
        let i: int = 0;
        const n = listLen(sig.params);
        while (i < n) {
            if (i > 0) { acc = acc + ", "; }
            acc = acc + typeNameOf(s, listGet(sig.params, i) catch s.dT);
            i = i + 1;
        }
        return acc + ") => " + typeNameOf(s, sig.ret);
    }
    if (tag == 16) { return "Future<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 20) { return "Gen<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 23) { return "Thread<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 24) { return "Shared<" + typeNameOf(s, t.inner catch s.dT) + ">"; }
    if (tag == 25) { return "Atomic<int>"; }
    if (tag == 17) { return "Bytes"; }
    if (tag == 21) { return fwName(t.alen); }
    if (tag == 22) {
        // 句柄按名义区分：不同模块可各自声明同名句柄，泛型实例的记忆键按序号消歧。
        const hn = listGet(s.fx.hNames, t.alen) catch "?";
        if (s.iv.mangling) { return hn + "%h" + toStr(t.alen); }
        return hn;
    }
    if (tag == 18) {
        const on = listGet(s.iv.opqNames, t.alen) catch "T";
        if (s.iv.mangling) { return "%" + on + toStr(t.alen); }
        return on;
    }
    if (tag == 19) {
        const ifn = (listGet(s.iv.ifTs, t.alen) catch s.iv.dIfT).name;
        if (s.iv.mangling) { return ifn + "%" + toStr(t.alen); }
        return ifn;
    }
    return "?";
}

function mangledName(s: Ref<Sm>, name: string, argTys: List<Ref<Ty>>): string {
    // 不透明类型参数与接口按序号区分（同名不同物不撞记忆键）；其余类型名不变。
    const savedM = s.iv.mangling;
    s.iv.mangling = true;
    let acc: string = name + "#";
    let i: int = 0;
    const n = listLen(argTys);
    while (i < n) {
        if (i > 0) { acc = acc + ","; }
        acc = acc + typeNameOf(s, listGet(argTys, i) catch s.dT);
        i = i + 1;
    }
    s.iv.mangling = savedM;
    return acc;
}

// ============================================================================
// §5.1 阶段一——registerModules 五相位（sema.zig registerModules 镜像）
// ============================================================================

function symTypeOf(s: Ref<Sm>, si: Ref<StructT>): Ref<Sym> {
    return new Sym { kind: 3, slot: 0, ty: None, isConst: false, module_idx: 0, fnIdx: 0, sig: None, si: si, ei: None, bi: -1, gfn: None, gst: None, decl: -1 };
}

function symEnumOf(s: Ref<Sm>, ei: Ref<EnumT>): Ref<Sym> {
    return new Sym { kind: 4, slot: 0, ty: None, isConst: false, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: ei, bi: -1, gfn: None, gst: None, decl: -1 };
}

function declExported(s: Ref<Sm>, m: Ref<Mod>, kind: int, name: string): bool {
    let i: int = 0;
    const n = listLen(m.decls);
    while (i < n) {
        const d = listGet(m.decls, i) catch s.dDecl;
        if (kind == 1 && d.tag == 1) {
            const f = d.fn catch s.dummyF;
            if (f.name == name) { return f.exported; }
        }
        if (kind == 5 && d.tag == 5) {
            const sd = d.sd catch s.dSd;
            if (sd.name == name) { return sd.exported; }
        }
        if (kind == 7 && d.tag == 7) {
            const ed = d.ed catch s.dEd;
            if (ed.name == name) { return ed.exported; }
        }
        if (kind == 12 && d.tag == 12) {
            const bd = d.bd catch s.dBd;
            if (bd.name == name) { return bd.exported; }
        }
        if (kind == 68 && d.tag == 68) {
            const idl = d.idl catch s.iv.dIdl;
            if (idl.name == name) { return idl.exported; }
        }
        if (kind == 73 && d.tag == 73) {
            const hd = d.hd catch s.fx.dHd;
            if (hd.name == name) { return hd.exported; }
        }
        i = i + 1;
    }
    return false;
}

function registerModules(s: Ref<Sm>): void {
    // —— 相位 1：类型声明骨架＋顶层绑定槽位＋tests ——
    let mi: int = 0;
    const nm = listLen(s.mods);
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 5) {
                const sd = d.sd catch s.dSd;
                fwReservedCheck(s, sd.name, sd.line, sd.col);
                fwReservedTps(s, sd.tps, sd.line, sd.col);
                const dupSO = modSymGet(m, sd.name);
                const dupS = dupSO catch s.dummySym;
                if (dupS.kind != -1) {
                    emitDiag(s, 3003, sd.line, sd.col, "éå¤å£°æ '" + sd.name + "'");
                }
                anaStructDecl(m.idx, sd, d.xst);
                if (listLen(sd.tps) > 0) {
                    const gst = new GenSt { module_idx: m.idx, decl: sd };
                    modSymPut(m, sd.name, new Sym { kind: 7, slot: 0, ty: None, isConst: false, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: gst, decl: -1 });
                } else {
                    const info = newStructT(s, m.idx, sd.name);
                    info.aLine = sd.line;
                    info.aCol = sd.col;
                    modSymPut(m, sd.name, symTypeOf(s, info));
                    if (d.xst) {
                        // D3 v0.23 FFI：外部结构体（字段校验与 C 布局见 ffiCheckDecls）。
                        listPush(s.fx.xsSer, info.serial);
                        listPush(s.fx.xsSi, info);
                        listPush(s.fx.xsDecl, sd);
                        listPush(s.fx.xsMod, m.idx);
                        listPush(s.fx.xsSize, -1);
                        listPush(s.fx.xsAlign, 1);
                        listPush(s.fx.xsOff, listNew());
                    }
                }
            } else if (d.tag == 73) {
                // D3 v0.23 FFI：declare type 不透明句柄（符号种类 9，slot＝句柄序）。
                const hd = d.hd catch s.fx.dHd;
                fwReservedCheck(s, hd.name, hd.line, hd.col);
                const dupHO = modSymGet(m, hd.name);
                const dupH = dupHO catch s.dummySym;
                if (dupH.kind != -1) {
                    emitDiag(s, 3003, hd.line, hd.col, "重复声明 '" + hd.name + "'");
                }
                const hIdx: int = listLen(s.fx.hNames);
                listPush(s.fx.hNames, hd.name);
                modSymPut(m, hd.name, new Sym { kind: 9, slot: hIdx, ty: None, isConst: false, module_idx: m.idx, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: -1 });
            } else if (d.tag == 7) {
                const ed = d.ed catch s.dEd;
                fwReservedCheck(s, ed.name, ed.line, ed.col);
                const dupEO = modSymGet(m, ed.name);
                const dupE = dupEO catch s.dummySym;
                if (dupE.kind != -1) {
                    emitDiag(s, 3003, ed.line, ed.col, "重复声明 '" + ed.name + "'");
                }
                const info = newEnumT(s, m.idx, ed.name);
                info.isErr = ed.isErr;
                info.aLine = ed.line;
                info.aCol = ed.col;
                anaEnumDecl(s, m.idx, ed);
                modSymPut(m, ed.name, symEnumOf(s, info));
            } else if (d.tag == 68) {
                const idl = d.idl catch s.iv.dIdl;
                fwReservedCheck(s, idl.name, idl.line, idl.col);
                fwReservedTps(s, idl.tps, idl.line, idl.col);
                const dupIO = modSymGet(m, idl.name);
                const dupI = dupIO catch s.dummySym;
                if (dupI.kind != -1) {
                    emitDiag(s, 3003, idl.line, idl.col, "重复声明 '" + idl.name + "'");
                }
                const ifIdx: int = listLen(s.iv.ifDecls);
                listPush(s.iv.ifDecls, idl);
                listPush(s.iv.ifDeclMod, m.idx);
                modSymPut(m, idl.name, new Sym { kind: 8, slot: ifIdx, ty: None, isConst: false, module_idx: m.idx, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: -1 });
            } else if (d.tag == 11 || d.tag == 12) {
                const b = d.bd catch s.dBd;
                const dupBO = modSymGet(m, b.name);
                const dupB = dupBO catch s.dummySym;
                if (dupB.kind != -1) {
                    emitDiag(s, 3003, b.line, b.col, "重复声明 '" + b.name + "'");
                }
                const slot: int = listLen(m.globals);
                // 模块状态字段经 GETFLD/SETFLD 的字段号访问（标志位标记模块状态）：超过上限时原先按位截断、
                // 静默读写到别的顶层绑定。
                if (slot == smFieldMax() + 1) { emitDiag(s, 3020, b.line, b.col, "模块顶层绑定（let/const）超过 " + toStr(smFieldMax() + 1) + " 个（GETFLD " + smFieldBits() + " 位上限）：从 '" + b.name + "' 起请移入 struct 或拆分模块"); }
                putBindSlot(s, b, slot);
                listPush(m.globals, b);
                listPush(m.gSlots, slot);
            } else if (d.tag == 9) {
                const td = d.td catch s.dTest;
                listPush(s.tests, new TestE { name: td.name, module_idx: m.idx, body: td.body });
            }
            di = di + 1;
        }
        mi = mi + 1;
    }

    // —— 相位 1.5：类型导入预绑定（struct/enum/泛型 struct）——
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 10) {
                let ri: int = 0;
                const nr = listLen(m.impSpecs);
                while (ri < nr) {
                    if ((listGet(m.impSpecs, ri) catch "") != d.impPath) {
                        ri = ri + 1;
                        continue;
                    }
                    const tm = listGet(s.mods, listGet(m.impTargets, ri) catch 0) catch s.dummyMod;
                    let ii: int = 0;
                    const nin = listLen(d.impNames);
                    while (ii < nin) {
                        const name = listGet(d.impNames, ii) catch "";
                        const existing = modSymGet(m, name);
                        const exSym = existing catch s.dummySym;
                        if (exSym.kind != -1) {
                            ii = ii + 1;
                            continue;
                        }
                        const ts = modSymGet(tm, name);
                        const sym = ts catch s.dummySym;
                        if (sym.kind == -1) {
                            ii = ii + 1;
                            continue;
                        }
                        const isTypeSym: bool = sym.kind == 3 || sym.kind == 4 || sym.kind == 7 || sym.kind == 8 || sym.kind == 9;
                        if (!isTypeSym) {
                            ii = ii + 1;
                            continue;
                        }
                        if (sym.kind == 3) {
                            if (declExported(s, tm, 5, name)) {
                                modSymPut(m, name, sym);
                            }
                        } else if (sym.kind == 4) {
                            if (declExported(s, tm, 7, name)) {
                                modSymPut(m, name, sym);
                            }
                        } else if (sym.kind == 7) {
                            if (declExported(s, tm, 5, name)) {
                                modSymPut(m, name, sym);
                            }
                        } else if (sym.kind == 8) {
                            if (declExported(s, tm, 68, name)) {
                                modSymPut(m, name, sym);
                            }
                        } else if (sym.kind == 9) {
                            if (declExported(s, tm, 73, name)) {
                                modSymPut(m, name, sym);
                            }
                        }
                        ii = ii + 1;
                    }
                    ri = ri + 1;
                }
            }
            di = di + 1;
        }
        mi = mi + 1;
    }

    importPrelude(s, true);

    // —— 相位 2：struct/enum 字段（泛型模板延迟到实例化）——
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 5) {
                const sd = d.sd catch s.dSd;
                if (listLen(sd.tps) > 0) {
                    di = di + 1;
                    continue;
                }
                const sym = modSymGet(m, sd.name) catch s.dummySym;
                const info = sym.si catch s.dummySi;
                const fnames: List<string> = listNew();
                const ftys: List<Ref<Ty>> = listNew();
                let fi: int = 0;
                const nf = listLen(sd.fnames);
                while (fi < nf) {
                    listPush(fnames, listGet(sd.fnames, fi) catch "");
                    listPush(ftys, resolveTypeIn(s, m, listGet(sd.ftes, fi) catch s.dummyTe));
                    fi = fi + 1;
                }
                const dupf = hasDupName(fnames);
                if (dupf) { emitDiag(s, 3003, sd.line, sd.col, "struct " + sd.name + " 存在重名字段"); }
                if (nf > smFieldMax()) { emitDiag(s, 3020, sd.line, sd.col, "struct " + sd.name + " 字段数超过 " + toStr(smFieldMax()) + "（GETFLD " + smFieldBits() + " 位上限）"); }
                info.fnames = fnames;
                info.ftys = ftys;
            } else if (d.tag == 7) {
                const ed = d.ed catch s.dEd;
                const sym = modSymGet(m, ed.name) catch s.dummySym;
                const info = sym.ei catch s.dummyEi;
                let vi: int = 0;
                const nv = listLen(ed.vars);
                while (vi < nv) {
                    const vd = listGet(ed.vars, vi) catch s.dVd;
                    const vt = new VarT { segRaw: listNew(), segField: listNew(), cause: -1, name: vd.name, fnames: listNew(), ftys: listNew() };
                    let fj: int = 0;
                    const nf = listLen(vd.fnames);
                    while (fj < nf) {
                        listPush(vt.fnames, listGet(vd.fnames, fj) catch "");
                        listPush(vt.ftys, resolveTypeIn(s, m, listGet(vd.ftes, fj) catch s.dummyTe));
                        fj = fj + 1;
                    }
                    if (ed.isErr) { errVariantSegs(s, ed, vd, vt); }
                    listPush(info.vars, vt);
                    vi = vi + 1;
                }
                const vnames: List<string> = listNew();
                let vj: int = 0;
                while (vj < nv) {
                    listPush(vnames, (listGet(ed.vars, vj) catch s.dVd).name);
                    vj = vj + 1;
                }
                const dupv = hasDupName(vnames);
                if (dupv) { emitDiag(s, 3003, ed.line, ed.col, "enum " + ed.name + " 存在重名变体"); }
                if (nv > 65536) { emitDiag(s, 3020, ed.line, ed.col, "enum " + ed.name + " 变体数超过 65536（跳转表上限）"); }
                // 变体载荷字段与 struct 字段同经 GETFLD/SETFLD 的 7 位字段号：超过 127 个时原先按位截断、静默串字段。
                let vq: int = 0;
                while (vq < nv) {
                    const vdq = listGet(ed.vars, vq) catch s.dVd;
                    if (listLen(vdq.fnames) > smFieldMax()) { emitDiag(s, 3020, ed.line, ed.col, "enum " + ed.name + " 的变体 " + vdq.name + " 字段数超过 " + toStr(smFieldMax()) + "（GETFLD " + smFieldBits() + " 位上限）"); }
                    vq = vq + 1;
                }
            }
            di = di + 1;
        }
        mi = mi + 1;
    }

    // —— 相位 3：顶层绑定类型（先于导入解析登记符号）——
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let gi: int = 0;
        const ng = listLen(m.globals);
        while (gi < ng) {
            const g = listGet(m.globals, gi) catch s.dBd;
            const ty = inferBindingType(s, g);
            listPush(m.gTys, ty);
            modSymPut(m, g.name, new Sym { kind: 1, slot: listGet(m.gSlots, gi) catch 0, ty: ty, isConst: g.isConst, module_idx: m.idx, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: anaDecl(m.idx, g.line, g.col, ANA_AT_BIND, ANA_TT_VAR, g.name) });
            anaBindDetail(s, m.idx, g.line, g.col, g.exported, g.isConst, g.name, g.ty, ty);
            gi = gi + 1;
        }
        mi = mi + 1;
    }

    // —— 相位 4：函数编号与签名（泛型模板只登记模板符号）——
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 1) {
                // extern 声明（tag 1＋ext 非 None）不入 fn_table/无具名签名
                //（zig .extern_d 臂跳过同构——V0.42-B1-④ 执行发现修复：原形
                // extern 落 dummyF 幽灵条目，FAB1 根集②随之多发 dummy 根）。
                if (d.ext != None) {
                    di = di + 1;
                    continue;
                }
                const f = d.fn catch s.dummyF;
                fwReservedTps(s, f.tps, f.line, f.col);
                const dupFO = modSymGet(m, f.name);
                const dupF = dupFO catch s.dummySym;
                if (dupF.kind != -1) {
                    emitDiag(s, 3003, f.line, f.col, "重复声明 '" + f.name + "'");
                }
                anaDecl(m.idx, f.line, f.col, ANA_AT_EXACT, ANA_TT_FN, f.name);
                anaFnDetail(s, m.idx, f);
                if (listLen(f.tps) > 0) {
                    const gi = new GenFn { module_idx: m.idx, decl: f };
                    modSymPut(m, f.name, new Sym { kind: 6, slot: 0, ty: None, isConst: false, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: gi, gst: None, decl: -1 });
                    di = di + 1;
                    continue;
                }
                const sig = resolveFnSig(s, f);
                listPush(s.fns, new FnEntry { module_idx: m.idx, decl: f, sig: sig });
                const idx: int = listLen(s.fns) - 1;
                modSymPut(m, f.name, new Sym { kind: 2, slot: 0, ty: None, isConst: false, module_idx: 0, fnIdx: idx, sig: sig, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: -1 });
            }
            di = di + 1;
        }
        mi = mi + 1;
    }

    // —— 相位 5：导入解析（全量符号）——
    mi = 0;
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 10) {
                // —— 路径文法（zig 676/681：绝对路径/反斜杠不受支持；非
                // ./ ../ std/ gui/ 前缀＝std 尚未提供——诊断序先于目标解析）——
                const impPath: string = d.impPath;
                let badPath: bool = false;
                if (len(impPath) == 0) {
                    badPath = true;
                } else {
                    if ((byteAt(impPath, 0) catch 0) == 47) {
                        badPath = true;
                    } else {
                        let bq: int = 0;
                        const bqn = len(impPath);
                        while (bq < bqn) {
                            if ((byteAt(impPath, bq) catch 0) == 92) { badPath = true; }
                            bq = bq + 1;
                        }
                    }
                }
                if (badPath) {
                    emitDiag(s, 3008, d.impLine, d.impCol, "导入路径 '" + impPath + "' 不受支持（S1 仅支持相对路径）");
                    di = di + 1;
                    continue;
                }
                const pfxOk: bool = strStartsWith(impPath, "./") || strStartsWith(impPath, "../") || strStartsWith(impPath, "std/") || strStartsWith(impPath, "gui/");
                if (!pfxOk) {
                    emitDiag(s, 3008, d.impLine, d.impCol, "标准库 '" + impPath + "' 尚未提供（S1 仅支持 ./ ../ 相对导入与 std/ 前缀）");
                    di = di + 1;
                    continue;
                }
                let ri: int = 0;
                const nr = listLen(m.impSpecs);
                let tm: Ref<Mod> = s.dummyMod;
                let found: bool = false;
                while (ri < nr) {
                    if ((listGet(m.impSpecs, ri) catch "") == d.impPath) {
                        const cand = listGet(s.mods, listGet(m.impTargets, ri) catch 0) catch s.dummyMod;
                        tm = cand;
                        found = true;
                    }
                    ri = ri + 1;
                }
                if (!found) {
                    emitDiag(s, 3008, d.impLine, d.impCol, "找不到导入目标模块 '" + impPath + "'");
                    di = di + 1;
                    continue;
                }
                let ii: int = 0;
                const nin = listLen(d.impNames);
                while (ii < nin) {
                    const name = listGet(d.impNames, ii) catch "";
                    const ts = modSymGet(tm, name);
                    const sym = ts catch s.dummySym;
                    if (sym.kind == -1) {
                        emitDiag(s, 3008, d.impLine, d.impCol, "模块 '" + impPath + "' 未导出符号 '" + name + "'");
                        ii = ii + 1;
                        continue;
                    }
                    let kind: int = 0;
                    if (sym.kind == 2 || sym.kind == 6) { kind = 1; }
                    else if (sym.kind == 3 || sym.kind == 7) { kind = 5; }
                    else if (sym.kind == 4) { kind = 7; }
                    else if (sym.kind == 1) { kind = 12; }
                    else if (sym.kind == 8) { kind = 68; }
                    else if (sym.kind == 9) { kind = 73; }
                    else {
                        ii = ii + 1;
                        continue;
                    }
                    if (!declExported(s, tm, kind, name)) {
                        emitDiag(s, 3008, d.impLine, d.impCol, "符号 '" + name + "' 未标记 export");
                        ii = ii + 1;
                        continue;
                    }
                    const existing = modSymGet(m, name);
                    const exSym = existing catch s.dummySym;
                    if (exSym.kind != -1) {
                        const same: bool = (exSym.kind == 3 && sym.kind == 3 && (exSym.si catch s.dummySi) == (sym.si catch s.dummySi)) || (exSym.kind == 4 && sym.kind == 4 && (exSym.ei catch s.dummyEi) == (sym.ei catch s.dummyEi)) || (exSym.kind == 8 && sym.kind == 8 && exSym.slot == sym.slot) || (exSym.kind == 9 && sym.kind == 9 && exSym.slot == sym.slot) || (exSym.kind == 7 && sym.kind == 7 && (exSym.gst catch s.dGs) == (sym.gst catch s.dGs));
                        if (!same) {
                            emitDiag(s, 3003, d.impLine, d.impCol, "导入名 '" + name + "' 与本模块声明冲突");
                        } else {
                            if (anaOn) { anaUse(s, d.impLine, d.impCol, ANA_AT_IMPORT, name, anaSymKey(s, sym)); }
                        }
                        ii = ii + 1;
                        continue;
                    }
                    if (anaOn) { anaUse(s, d.impLine, d.impCol, ANA_AT_IMPORT, name, anaSymKey(s, sym)); }
                    modSymPut(m, name, sym);
                    ii = ii + 1;
                }
            }
            di = di + 1;
        }
        mi = mi + 1;
    }
}

// D3 v0.20 §6.19：编译器自带 prelude（显示名 <prelude>）的导出名隐式导入每个用户模块；
// 用户模块里已有的同名声明或导入优先（只补缺）。分两次：类型名在用户的类型导入之后、
// struct 字段解析之前补；函数名在用户的全部导入之后补。
function importPrelude(s: Ref<Sm>, types: bool): void {
    let pi: int = -1;
    let mi: int = 0;
    while (mi < listLen(s.mods)) {
        if ((listGet(s.mods, mi) catch s.dummyMod).display == "<prelude>") { pi = mi; }
        mi = mi + 1;
    }
    if (pi < 0) { return; }
    s.iv.preludeIdx = pi;
    const pm = listGet(s.mods, pi) catch s.dummyMod;
    const names: List<string> = listNew();
    let di: int = 0;
    while (di < listLen(pm.decls)) {
        const d = listGet(pm.decls, di) catch s.dDecl;
        if (d.tag == 1 && d.fn != None) {
            const f = d.fn catch s.dummyF;
            if (f.exported && !types) { listPush(names, f.name); }
        } else if (d.tag == 5) {
            const sd = d.sd catch s.dSd;
            if (sd.exported && types) { listPush(names, sd.name); }
        } else if (d.tag == 68 && types) {
            const idl = d.idl catch s.iv.dIdl;
            if (idl.exported) { listPush(names, idl.name); }
        }
        di = di + 1;
    }
    mi = 0;
    while (mi < listLen(s.mods)) {
        if (mi != pi) {
            const m = listGet(s.mods, mi) catch s.dummyMod;
            let k: int = 0;
            while (k < listLen(names)) {
                const nm = listGet(names, k) catch "";
                if (modSymGet(m, nm) == None) {
                    const ps = modSymGet(pm, nm) catch s.dummySym;
                    if (ps.kind != -1) { modSymPut(m, nm, ps); }
                }
                k = k + 1;
            }
        }
        mi = mi + 1;
    }
}

function resolveFnSig(s: Ref<Sm>, f: Ref<FnDecl>): Ref<Sig> {
    if (listLen(f.params) > smParamMax()) {
        emitDiag(s, 3011, f.line, f.col, "函数 " + f.name + " 参数超过 " + toStr(smParamMax()) + "（CALL 实参上限）");
    }
    const pnames: List<string> = listNew();
    let pi0: int = 0;
    const pn0 = listLen(f.params);
    while (pi0 < pn0) {
        listPush(pnames, (listGet(f.params, pi0) catch s.dummyParam).name);
        pi0 = pi0 + 1;
    }
    const dupp = hasDupName(pnames);
    if (dupp) { emitDiag(s, 3003, f.line, f.col, "函数 " + f.name + " 存在重名参数"); }
    const params: List<Ref<Ty>> = listNew();
    let i: int = 0;
    const n = listLen(f.params);
    while (i < n) {
        const p = listGet(f.params, i) catch s.dummyParam;
        const pt = resolveType(s, p.ty);
        listPush(params, pt);
        if (pt.tag == 4) { emitDiag(s, 3020, f.line, f.col, "参数 " + p.name + " 不能为 void"); }
        i = i + 1;
    }
    const ret = resolveType(s, f.ret catch s.dummyTe);
    if (f.isGen) {
        // D3 v0.22：function* f(...): T 的类型是普通函数类型 (...) => Gen<T>。
        if (f.ret == None) {
            emitDiag(s, 3032, f.line, f.col, "生成器 " + f.name + " 须声明元素类型（function* " + f.name + "(...): T）");
        } else {
            genElemCheck(s, ret, f.line, f.col);
        }
        return newSig(s, params, tGen(s, ret), false);
    }
    return newSig(s, params, ret, f.isAsync);
}

// D3 v0.22：元素类型不能是 void、可选、失败联合、Error 或错误 enum——genNext 以 None 表示取完，
// 失败语义留给将来的可失败生成器（以后放宽是向前兼容的）。
function genElemCheck(s: Ref<Sm>, t: Ref<Ty>, line: int, col: int): void {
    let bad: bool = t.tag == 4 || t.tag == 5 || t.tag == 6 || t.tag == 7;
    if (t.tag == 14 && isErrEnumTy(s, t)) { bad = true; }
    if (bad) {
        emitDiag(s, 3032, line, col, "生成器的元素类型不能是 " + typeNameOf(s, t) + "（不允许 void、可选类型、失败联合、Error 与错误 enum；需要产出错误时请包进 struct）");
    }
}

// D3 v0.22：生成器体内（含其中的箭头函数）yield 恒为关键字，不能作标识符。
function genKwCheck(s: Ref<Sm>, name: string, line: int, col: int): void {
    if (s.iv.genAny && name == "yield") {
        emitDiag(s, 3032, line, col, "生成器体内 yield 是关键字，不能作标识符");
    }
}

function resolveTypeIn(s: Ref<Sm>, m: Ref<Mod>, te: Ref<Te>): Ref<Ty> {
    const saved = s.curMod;
    s.curMod = m;
    const r = resolveType(s, te);
    s.curMod = saved;
    return r;
}

function inferBindingType(s: Ref<Sm>, b: Ref<Binding>): Ref<Ty> {
    if (b.ty != None) {
        return resolveType(s, b.ty catch s.dummyTe);
    }
    const init = b.init;
    if (init.tag == 26) { return s.tInt; }
    if (init.tag == 27) { return s.tFloat; }
    if (init.tag == 29) { return s.tBool; }
    if (init.tag == 28) { return s.tString; }
    emitDiag(s, 3020, b.line, b.col, "顶层绑定 '" + b.name + "' 需要类型标注（初值须为字面量）");
    return s.tInt;
}

// ============================================================================
// §5.2 resolveType（sema.zig resolveType 镜像——泛型 struct 命中即实例化）
// ============================================================================

function resolveType(s: Ref<Sm>, te: Ref<Te>): Ref<Ty> {
    const tag = te.tag;
    if (tag == 52) {
        const n = te.name;
        if (n == "int") { return s.tInt; }
        if (n == "float") { return s.tFloat; }
        if (n == "bool") { return s.tBool; }
        if (n == "string") { return s.tString; }
        if (n == "void") { return s.tVoid; }
        if (n == "Error") { return s.tErr; }
        const fk = fwKindByName(n);
        if (fk != 0) { return nkTy(s, fk); }
        if (fwReservedName(n)) {
            emitDiag(s, 3034, 0, 0, "暂不支持 " + n + "：整数类型只有 i8/i16/i32/i64/u8/u16/u32/u64/isize/usize（i/u 后接数字的名字保留给以后的定宽类型）");
            return s.tInt;
        }
        const sym = modSymGet(s.curMod, n) catch s.dummySym;
        if (sym.kind == 3) { return tStruct(s, sym.si catch s.dummySi); }
        if (sym.kind == 4) { return tEnum(s, sym.ei catch s.dummyEi); }
        if (sym.kind == 8) { return ifaceInstOf(s, sym.slot, listNew()); }
        if (sym.kind == 9) { return tHandle(s, sym.slot); }
        if (sym.kind != -1) {
            emitDiag(s, 3020, 0, 0, "'" + n + "' 不是类型");
            return s.tInt;
        }
        // 预声明类型名（被用户声明遮蔽，D3 §3）。v0.17 程序可触发的诊断文案保持与冻结的 Zig 前端逐字节一致（frontend-probe），Bytes 只放宽判定。
        if (n == "Bytes") { return tBytes(s); }
        if (n == "cstr") {
            // D3 v0.36：cstr 并入 string（外部函数签名里的 string 即 UTF-8、NUL 结尾的 C 串）。
            emitDiag(s, 3033, 0, 0, "cstr 已并入 string（D3 v0.36）：外部函数签名里直接写 string");
            return s.tString;
        }
        if (n == "wstr") {
            // D3 v0.23 FFI：wstr 只在带 from 的外部函数签名顶层识别（ffiMarshal 先行拦截）。
            emitDiag(s, 3033, 0, 0, "wstr 只能用作外部函数（declare function … from …）的参数或返回类型；太虚侧请用 string");
            return s.tString;
        }
        emitDiag(s, 3001, 0, 0, "未定义类型 '" + n + "'");
        return s.tInt;
    }
    if (tag == 53) {
        const it53 = resolveType(s, te.a catch s.dummyTe);
        if (it53.tag == 8) { emitDiag(s, 3020, 0, 0, "Ref 不能嵌套 Ref"); }
        if (it53.tag == 19) { emitDiag(s, 3030, 0, 0, "接口值本身就是共享句柄，不能再包 Ref（得到 Ref<" + typeNameOf(s, it53) + ">）"); }
        return tRef(s, it53);
    }
    if (tag == 54) {
        const it54 = resolveType(s, te.a catch s.dummyTe);
        if (it54.tag == 9) { emitDiag(s, 3020, 0, 0, "Weak 不能嵌套 Weak"); }
        if (it54.tag == 19) { emitDiag(s, 3030, 0, 0, "接口值不能取 Weak（得到 Weak<" + typeNameOf(s, it54) + ">）"); }
        if (it54.tag == 8) { emitDiag(s, 3020, 0, 0, "Weak 的类型参数是 Ref 指向的类型（不能 Weak<Ref<T>>）"); }
        return tWeak(s, it54);
    }
    if (tag == 55) {
        const it = resolveType(s, te.a catch s.dummyTe);
        const itTag = it.tag;
        // Shared、Atomic（线程第 4c 步）在白名单之前收下：冻结的 Zig seed 编译本文件对下面这条白名单附近的改动
        // 异常敏感（往链里加两项、或在链后另加判断，seed 编译从约 8.5 秒涨到约 27 秒，D102 的 S 臂随之失真），
        // 写在前面则不受影响。
        if (itTag == 24 || itTag == 25) { return tList(s, it); }
        const ok: bool = itTag == 0 || itTag == 1 || itTag == 21 || itTag == 22 || itTag == 2 || itTag == 3 || itTag == 8 || itTag == 9 || itTag == 10 || itTag == 15 || itTag == 16 || itTag == 17 || itTag == 18 || itTag == 19 || itTag == 20 || itTag == 23 || itTag == 11 || itTag == 13 || (itTag == 14 && !isErrEnumTy(s, it));
        if (itTag == 11 || itTag == 13 || itTag == 14) { s.iv.listValElem = true; }
        if (!ok) {
            emitDiag(s, 3020, 0, 0, "List 元素类型须为 int/float/bool/string/Ref<T>/Weak<T>/List/函数类型/Future<T>（得到 " + typeNameOf(s, it) + "）");
        }
        return tList(s, it);
    }
    if (tag == 56) {
        const it56 = resolveType(s, te.a catch s.dummyTe);
        if (it56.tag == 6) { emitDiag(s, 3020, 0, 0, "可选类型不能嵌套"); }
        if (it56.tag == 4) { emitDiag(s, 3020, 0, 0, "void 不能为可选"); }
        return tOpt(s, it56);
    }
    if (tag == 59) {
        const it59 = resolveType(s, te.a catch s.dummyTe);
        if (it59.tag == 7 || it59.tag == 6) { emitDiag(s, 3020, 0, 0, "联合的失败侧只能是 Error"); }
        if (it59.tag == 14 && isErrEnumTy(s, it59)) { emitDiag(s, 3028, 0, 0, "失败联合的成功侧不能是错误 enum（得到 " + typeNameOf(s, it59) + "）"); }
        return tErrunion(s, it59);
    }
    if (tag == 67) {
        // D3 v0.19：T | 错误enum。
        const it67 = resolveType(s, te.a catch s.dummyTe);
        const ft67 = resolveType(s, listGet(te.ls, 0) catch s.dummyTe);
        if (!isErrEnumTy(s, ft67)) {
            emitDiag(s, 3020, 0, 0, "联合类型右侧必须是 Error 或错误 enum（得到 " + typeNameOf(s, ft67) + "）");
            return tErrunion(s, it67);
        }
        if (it67.tag == 7 || it67.tag == 6 || isErrLike(s, it67)) {
            emitDiag(s, 3028, 0, 0, "失败联合的成功侧不能是 Error、错误 enum、可选或失败联合（得到 " + typeNameOf(s, it67) + "）");
        }
        return tErrunionE(s, it67, ft67.ei catch s.dummyEi);
    }
    if (tag == 58) {
        const elem = resolveType(s, te.a catch s.dummyTe);
        let ln: int = te.alen;
        if (ln < 1 || ln > 65535) { emitDiag(s, 3020, 0, 0, "数组长度须在 1..65535"); }
        if (ln < 0) { ln = 1; }
        if (ln == 0) { ln = 1; }
        return tArr(s, elem, ln);
    }
    if (tag == 57) { return tSlice(s, resolveType(s, te.a catch s.dummyTe)); }
    if (tag == 60) {
        if (listLen(te.ls) > smParamMax()) {
            emitDiag(s, 3011, 0, 0, "函数类型参数超过 " + toStr(smParamMax()) + "（CALL 实参上限）");
        }
        const params: List<Ref<Ty>> = listNew();
        let i: int = 0;
        const n = listLen(te.ls);
        while (i < n) {
            const pt60 = resolveType(s, listGet(te.ls, i) catch s.dummyTe);
            listPush(params, pt60);
            if (pt60.tag == 4) { emitDiag(s, 3020, 0, 0, "函数类型参数不能为 void"); }
            i = i + 1;
        }
        const ret = resolveType(s, te.a catch s.dummyTe);
        const sig = newSig(s, params, ret, false);
        return tFn(s, sig);
    }
    if (tag == 61) {
        const it61 = resolveType(s, te.a catch s.dummyTe);
        if (it61.tag == 16) { emitDiag(s, 3020, 0, 0, "Future 不能嵌套 Future"); }
        return tFuture(s, it61);
    }
    if (tag == 70) {
        // struct/enum 每次解析得新类型对象（与原先按名字解析同形，类型池首触序不变）。
        const rt = listGet(s.tys, te.alen) catch s.tInt;
        if (rt.tag == 13) { return tStruct(s, rt.si catch s.dummySi); }
        if (rt.tag == 14) { return tEnum(s, rt.ei catch s.dummyEi); }
        return rt;
    }
    if (tag == 62) {
        const sym = modSymGet(s.curMod, te.name) catch s.dummySym;
        if (sym.kind == -1 && te.name == "Gen" && listLen(te.ls) == 1) {
            // D3 v0.22 生成器句柄 Gen<T>（内建泛型名；同名用户类型优先）。
            const gt = resolveType(s, listGet(te.ls, 0) catch s.dummyTe);
            genElemCheck(s, gt, 0, 0);
            return tGen(s, gt);
        }
        if (sym.kind == -1 && te.name == "Thread" && listLen(te.ls) == 1) {
            // 线程句柄 Thread<T>（线程第 2 步；内建泛型名，同名用户类型优先）。
            return tThread(s, resolveType(s, listGet(te.ls, 0) catch s.dummyTe));
        }
        if (sym.kind == -1 && te.name == "Shared" && listLen(te.ls) == 1) {
            // Shared<T>（线程第 4c 步；内建泛型名，同名用户类型优先）。
            return tShared(s, resolveType(s, listGet(te.ls, 0) catch s.dummyTe));
        }
        if (sym.kind == -1 && te.name == "Atomic" && listLen(te.ls) == 1) {
            // Atomic<int>（线程第 4c 步；目前只有 int）。
            const at = resolveType(s, listGet(te.ls, 0) catch s.dummyTe);
            if (at.tag != 0) { emitDiag(s, 3020, 0, 0, "Atomic 目前只支持 Atomic<int>（得到 Atomic<" + typeNameOf(s, at) + ">）"); }
            return tAtomic(s);
        }
        if (sym.kind == -1) {
            emitDiag(s, 3001, 0, 0, "未定义类型 '" + te.name + "'");
            return s.tInt;
        }
        if (sym.kind == 8) {
            const ifArgs: List<Ref<Ty>> = listNew();
            let ii: int = 0;
            while (ii < listLen(te.ls)) {
                listPush(ifArgs, resolveType(s, listGet(te.ls, ii) catch s.dummyTe));
                ii = ii + 1;
            }
            return ifaceInstOf(s, sym.slot, ifArgs);
        }
        if (sym.kind != 7) {
            emitDiag(s, 3020, 0, 0, "'" + te.name + "' 不是泛型 struct，不能带类型实参");
            return s.tInt;
        }
        const gs = sym.gst catch s.dGs;
        const decl = gs.decl;
        if (listLen(decl.tps) != listLen(te.ls)) {
            emitDiag(s, 3020, 0, 0, "泛型 " + te.name + " 需要 " + toStr(listLen(decl.tps)) + " 个类型实参，得到 " + toStr(listLen(te.ls)));
            return s.tInt;
        }
        const argTys: List<Ref<Ty>> = listNew();
        let i: int = 0;
        const n = listLen(te.ls);
        while (i < n) {
            listPush(argTys, resolveType(s, listGet(te.ls, i) catch s.dummyTe));
            i = i + 1;
        }
        return instantiateStruct(s, gs, argTys);
    }
    return s.tInt;
}

// ============================================================================
// §5.3 阶段二——checkModules（externs 收集＋模块 init＋函数/测试检查＋main）
// ============================================================================

function externIdxGet(s: Ref<Sm>, name: string): int {
    // D3 v0.23：带 from 的外部函数只在声明它的模块可见且优先；宿主 extern 全程序可见。
    let legacy: int = -1;
    let i: int = listLen(s.extNames) - 1;
    while (i >= 0) {
        if ((listGet(s.extNames, i) catch "") == name) {
            const xi = listGet(s.extIdx, i) catch -1;
            const fxo = (listGet(s.externs, xi) catch s.dExt).fx;
            if (fxo == None) {
                if (legacy < 0) { legacy = xi; }
            } else if ((fxo catch s.fx.dFx).mod == s.curMod.idx) {
                return xi;
            }
        }
        i = i - 1;
    }
    return legacy;
}

function fnNameExists(s: Ref<Sm>, name: string): bool {
    let i: int = 0;
    const n = listLen(s.fns);
    while (i < n) {
        const fe = listGet(s.fns, i) catch s.dummyFE;
        if (fe.decl.name == name) { return true; }
        i = i + 1;
    }
    return false;
}

function collectExterns(s: Ref<Sm>): void {
    let mi: int = 0;
    const nm = listLen(s.mods);
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        s.curMod = m;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.ext != None && (d.ext catch s.dExDecl).fmode > 0) {
                ffiCollect(s, m, d.ext catch s.dExDecl);
            } else if (d.ext != None) {
                const x = d.ext catch s.dExDecl;
                if (externIdxGet(s, x.name) >= 0) {
                    emitDiag(s, 3003, x.line, x.col, "extern '" + x.name + "' 重复声明（宿主名程序内唯一）");
                    di = di + 1;
                    continue;
                }
                if (builtinOf(x.name) >= 0) {
                    emitDiag(s, 3003, x.line, x.col, "extern '" + x.name + "' 与内建重名（禁遮蔽）");
                    di = di + 1;
                    continue;
                }
                if (fnNameExists(s, x.name)) {
                    emitDiag(s, 3003, x.line, x.col, "extern '" + x.name + "' 与用户函数重名（禁遮蔽）");
                    di = di + 1;
                    continue;
                }
                emitDiag(s, 3033, x.line, x.col, "宿主 extern 已退场：declare function '" + x.name + "' 需要 from 库名或 from syscall");
                const params: List<Ref<Ty>> = listNew();
                let pi: int = 0;
                const np = listLen(x.params);
                while (pi < np) {
                    const p = listGet(x.params, pi) catch s.dummyParam;
                    const pt = resolveTypeIn(s, m, p.ty);
                    if (!(pt.tag == 0 || pt.tag == 1 || pt.tag == 2 || pt.tag == 3)) {
                        emitDiag(s, 3002, x.line, x.col, "extern 参数 " + p.name + " 须为 int/float/bool/string（得到 " + typeNameOf(s, pt) + "）");
                    }
                    listPush(params, pt);
                    pi = pi + 1;
                }
                const ret = resolveTypeIn(s, m, x.ret);
                if (!(ret.tag == 0 || ret.tag == 1 || ret.tag == 2 || ret.tag == 3 || ret.tag == 4)) {
                    emitDiag(s, 3002, x.line, x.col, "extern 返回须为 int/float/bool/string/void（得到 " + typeNameOf(s, ret) + "）");
                }
                const idx: int = listLen(s.externs);
                listPush(s.externs, new ExtE { name: x.name, ps: params, ret: ret, fx: None, decl: anaExternDecl(s, m.idx, x) });
                listPush(s.extNames, x.name);
                listPush(s.extIdx, idx);
            }
            di = di + 1;
        }
        mi = mi + 1;
    }
}

// ============================================================================
// D3 v0.23 FFI（docs/design/v052-ffi-platform-v0.1-20261015.md §四）：外部结构体布局、
// 外部函数的封送校验与收集、调用检查（3033）。
// ============================================================================

function ffiNoInts(): List<int> { return listNew(); }

function ffiXsIdx(s: Ref<Sm>, si: Ref<StructT>): int {
    let i: int = 0;
    while (i < listLen(s.fx.xsSer)) {
        if ((listGet(s.fx.xsSer, i) catch -1) == si.serial) { return i; }
        i = i + 1;
    }
    return -1;
}

// 外部结构体字段的标量种类：定宽 1..10、int 11、float 12、句柄 17；0＝不能用于 C 布局。
function ffiFieldScalar(t: Ref<Ty>): int {
    if (t.tag == 21) { return t.alen; }
    if (t.tag == 0) { return 11; }
    if (t.tag == 1) { return 12; }
    if (t.tag == 22) { return 17; }
    return 0;
}

// C 宽度（x86_64：isize/usize、句柄为 8 字节）。
function ffiScalarSize(k: int): int {
    if (k == 1 || k == 4) { return 1; }
    if (k == 2 || k == 5) { return 2; }
    if (k == 3 || k == 6 || k == 10) { return 4; }
    return 8;
}

function ffiRoundUp(v: int, a: int): int {
    return ((v + a - 1) / a) * a;
}

// C 布局：按声明序、C 对齐规则；字段只能是定宽标量、句柄、定长数组 [N]标量、其他外部结构体。
// xsSize：-1 未算、-2 计算中（再次进入即按值包含自身）。
function ffiLayout(s: Ref<Sm>, xi: int): void {
    const st = listGet(s.fx.xsSize, xi) catch 0;
    if (st >= 0) { return; }
    const sd = listGet(s.fx.xsDecl, xi) catch s.dSd;
    const saved = s.curMod;
    s.curMod = listGet(s.mods, listGet(s.fx.xsMod, xi) catch 0) catch s.dummyMod;
    if (st == -2) {
        emitDiag(s, 3033, sd.line, sd.col, "外部结构体 " + sd.name + " 按值包含自身（C 布局无法确定大小）");
        s.curMod = saved;
        return;
    }
    listSet(s.fx.xsSize, xi, -2);
    const si = listGet(s.fx.xsSi, xi) catch s.dummySi;
    const offs: List<int> = listNew();
    let off: int = 0;
    let al: int = 1;
    let fi: int = 0;
    while (fi < listLen(si.ftys)) {
        const ft = listGet(si.ftys, fi) catch s.dT;
        let k: int = ffiFieldScalar(ft);
        let cnt: int = 1;
        let aux: int = 0;
        let fsz: int = 0;
        let fal: int = 1;
        if (k > 0) {
            fsz = ffiScalarSize(k);
            fal = fsz;
        } else if (ft.tag == 11) {
            k = ffiFieldScalar(ft.elem catch s.dT);
            if (k > 0) {
                cnt = ft.alen;
                fal = ffiScalarSize(k);
                fsz = fal * cnt;
            }
        } else if (ft.tag == 13) {
            const nx = ffiXsIdx(s, ft.si catch s.dummySi);
            if (nx >= 0) {
                ffiLayout(s, nx);
                s.curMod = listGet(s.mods, listGet(s.fx.xsMod, xi) catch 0) catch s.dummyMod;
                const nsz = listGet(s.fx.xsSize, nx) catch -1;
                if (nsz >= 0) {
                    k = 19;
                    aux = nx;
                    fsz = nsz;
                    fal = listGet(s.fx.xsAlign, nx) catch 1;
                } else {
                    k = -1;
                }
            }
        }
        if (k == 0) {
            emitDiag(s, 3033, sd.line, sd.col, "外部结构体 " + sd.name + " 的字段 " + (listGet(si.fnames, fi) catch "") + " 不能是 " + typeNameOf(s, ft) + "（只能是定宽数值、int/float、declare type 句柄、定长数组 [N]标量或其他外部结构体）");
        }
        if (k > 0) {
            off = ffiRoundUp(off, fal);
            listPush(offs, off);
            listPush(offs, k);
            listPush(offs, cnt);
            listPush(offs, aux);
            off = off + fsz;
            if (fal > al) { al = fal; }
        }
        fi = fi + 1;
    }
    if (listLen(si.ftys) == 0) {
        emitDiag(s, 3033, sd.line, sd.col, "外部结构体 " + sd.name + " 至少要有一个字段");
    }
    listSet(s.fx.xsSize, xi, ffiRoundUp(off, al));
    listSet(s.fx.xsAlign, xi, al);
    listSet(s.fx.xsOff, xi, offs);
    s.curMod = saved;
}

function ffiCheckDecls(s: Ref<Sm>): void {
    let xi: int = 0;
    while (xi < listLen(s.fx.xsSer)) {
        ffiLayout(s, xi);
        xi = xi + 1;
    }
}

// 回调签名的封送种类（参数与返回只能是标量与句柄；不能 async）；-1＝不合法。
function ffiCbIndex(s: Ref<Sm>, sig: Ref<Sig>): int {
    if (sig.isAsync) { return -1; }
    const row: List<int> = listNew();
    const rk = ffiCbScalar(sig.ret, true);
    if (rk < 0) { return -1; }
    listPush(row, rk);
    listPush(row, listLen(sig.params));
    let i: int = 0;
    while (i < listLen(sig.params)) {
        const pk = ffiCbScalar(listGet(sig.params, i) catch s.dT, false);
        if (pk < 0) { return -1; }
        listPush(row, pk);
        i = i + 1;
    }
    let j: int = 0;
    while (j < listLen(s.fx.cbSigs)) {
        if (sigEq(s, listGet(s.fx.cbSigs, j) catch s.dummySig, sig)) { return j; }
        j = j + 1;
    }
    listPush(s.fx.cbSigs, sig);
    listPush(s.fx.cbKinds, row);
    return listLen(s.fx.cbSigs) - 1;
}

function ffiCbScalar(t: Ref<Ty>, isRet: bool): int {
    if (t.tag == 4 && isRet) { return 0; }
    if (t.tag == 2) { return 13; }
    const k = ffiFieldScalar(t);
    if (k > 0) { return k; }
    return -1;
}

// 封送种类（码见 FfiX）；-1＝不能用于外部函数签名，-2＝回调签名不合法。附加结果在 s.fx.lastA。
function ffiKindOf(s: Ref<Sm>, t: Ref<Ty>, isRet: bool): int {
    s.fx.lastA = 0;
    const tag = t.tag;
    if (tag == 4) {
        if (isRet) { return 0; }
        return -1;
    }
    if (tag == 21) { return t.alen; }
    if (tag == 0) { return 11; }
    if (tag == 1) { return 12; }
    if (tag == 2) { return 13; }
    if (tag == 22) { return 17; }
    if (tag == 17) {
        if (isRet) { return -1; }
        return 16;
    }
    if (tag == 6) {
        if ((t.inner catch s.dT).tag == 22) { return 18; }
        return -1;
    }
    if (tag == 8 && !isRet) {
        const it = t.inner catch s.dT;
        if (it.tag == 13) {
            const xi = ffiXsIdx(s, it.si catch s.dummySi);
            if (xi >= 0) {
                s.fx.lastA = xi;
                return 19;
            }
        }
        return -1;
    }
    if (tag == 15 && !isRet) {
        const ci = ffiCbIndex(s, t.sig catch s.dummySig);
        if (ci < 0) { return -2; }
        s.fx.lastA = ci;
        return 20;
    }
    return -1;
}

// 一个签名位置（参数或返回）的太虚侧类型；封送种类与附加写入 s.fx.lastK / lastA。
// 签名顶层的 string 即 UTF-8、NUL 结尾的 C 串（种类 14，D3 v0.36 并入原 cstr）；wstr 只在这里识别，太虚侧即 string。
// 只认顶层：回调签名不收字符串（ffiKindOf 照旧）。
function ffiMarshal(s: Ref<Sm>, m: Ref<Mod>, x: Ref<ExternDecl>, te: Ref<Te>, pname: string, isRet: bool): Ref<Ty> {
    let who: string = "外部函数 " + x.name + " 的参数 " + pname + " ";
    if (isRet) { who = "外部函数 " + x.name + " 的返回类型"; }
    s.fx.lastK = -1;
    s.fx.lastA = 0;
    let t: Ref<Ty> = s.tString;
    let k: int = -1;
    if (te.tag == 52 && te.name == "wstr") {
        k = 15;
    } else {
        t = resolveTypeIn(s, m, te);
        k = ffiKindOf(s, t, isRet);
        if (t.tag == 3) { k = 14; }
    }
    if (k == -2) {
        emitDiag(s, 3033, x.line, x.col, who + "的回调类型 " + typeNameOf(s, t) + " 只能以定宽数值、int/float、bool、句柄作参数与返回（回调不能是 async）");
        return t;
    }
    if (k == -1) {
        let xsBad: bool = false;
        if (t.tag == 13) { xsBad = ffiXsIdx(s, t.si catch s.dummySi) >= 0; }
        if (xsBad) {
            emitDiag(s, 3033, x.line, x.col, who + "不能按值使用外部结构体 " + typeNameOf(s, t) + "：以 Ref<" + typeNameOf(s, t) + "> 传指针（不支持按值传递或返回结构体）");
        } else if (t.tag == 17) {
            emitDiag(s, 3033, x.line, x.col, who + "不能是 Bytes：缓冲区由调用方以参数传入");
        } else if (t.tag == 8 && !isRet) {
            emitDiag(s, 3033, x.line, x.col, who + "不能是 " + typeNameOf(s, t) + "：Ref 只能指向外部结构体（declare struct）");
        } else if (isRet) {
            emitDiag(s, 3033, x.line, x.col, who + "不能是 " + typeNameOf(s, t) + "（可用：void、定宽数值、int/float、bool、string/wstr、句柄及其可空形式 H?）");
        } else {
            emitDiag(s, 3033, x.line, x.col, who + "不能是 " + typeNameOf(s, t) + "（可用：定宽数值、int/float、bool、string/wstr、Bytes、句柄及其可空形式 H?、Ref<外部结构体>、回调函数类型）");
        }
        return t;
    }
    if (x.fmode == 2) {
        // from syscall：参数只收整数、bool、句柄、string、Bytes 与 Ref<外部结构体>；返回只能是整数或 void。
        if (isRet && !(k == 0 || (k >= 1 && k <= 9) || k == 11)) {
            emitDiag(s, 3033, x.line, x.col, who + "须为整数类型或 void（from syscall 的返回值是系统调用的原始结果，失败为 -errno）");
            return t;
        }
        if (!isRet && (k == 10 || k == 12 || k == 15 || k == 20)) {
            let tn: string = typeNameOf(s, t);
            if (k == 15) { tn = "wstr"; }
            emitDiag(s, 3033, x.line, x.col, who + "不能是 " + tn + "（from syscall 的参数只收整数、bool、句柄、string、Bytes 与 Ref<外部结构体>）");
            return t;
        }
    }
    s.fx.lastK = k;
    return t;
}

function ffiLocalIdx(s: Ref<Sm>, mod: int, name: string): int {
    let i: int = 0;
    while (i < listLen(s.externs)) {
        const ex = listGet(s.externs, i) catch s.dExt;
        if (ex.name == name && ex.fx != None && (ex.fx catch s.fx.dFx).mod == mod) { return i; }
        i = i + 1;
    }
    return -1;
}

function ffiCollect(s: Ref<Sm>, m: Ref<Mod>, x: Ref<ExternDecl>): void {
    if (builtinOf(x.name) >= 0) {
        emitDiag(s, 3003, x.line, x.col, "extern '" + x.name + "' 与内建重名（禁遮蔽）");
        return;
    }
    const own = modSymGet(m, x.name) catch s.dummySym;
    if (own.kind != -1) {
        emitDiag(s, 3003, x.line, x.col, "外部函数 '" + x.name + "' 与本模块的声明或导入重名");
        return;
    }
    if (ffiLocalIdx(s, m.idx, x.name) >= 0) {
        emitDiag(s, 3003, x.line, x.col, "外部函数 '" + x.name + "' 在本模块重复声明");
        return;
    }
    if (x.fmode == 1 && len(x.flib) == 0) {
        emitDiag(s, 3033, x.fline, x.fcol, "外部函数 " + x.name + " 的库名不能为空");
    }
    if (x.fmode == 2 && x.fnr > 4095) {
        emitDiag(s, 3033, x.fline, x.fcol, "外部函数 " + x.name + " 的系统调用编号须在 0..4095（得到 " + toStr(x.fnr) + "）");
    }
    const np = listLen(x.params);
    if (x.fmode == 2 && np > 6) {
        emitDiag(s, 3033, x.line, x.col, "外部函数 " + x.name + "：from syscall 最多 6 个参数（得到 " + toStr(np) + "）");
    }
    if (np > 254) {
        emitDiag(s, 3011, x.line, x.col, "外部函数 " + x.name + " 参数超过 254（CALL 实参上限）");
    }
    let nfix: int = np;
    if (x.nfix >= 0) { nfix = x.nfix; }
    if (x.nfix >= 0 && x.fmode == 2) {
        emitDiag(s, 3033, x.line, x.col, "外部函数 " + x.name + "：from syscall 不能有变参参数（系统调用的实参个数固定）");
    }
    // D3 v0.36：常见 C 变参函数的定参个数须与 C 原型一致，多出的参数写成变参参数（Apple arm64 上变参经栈传，声明错了不报错而读到垃圾）。
    const known = ffiVariadicFixed(x.name, x.fmode, x.flib);
    if (known >= 0 && nfix != known) {
        if (x.nfix < 0 && np > known) {
            const vp = listGet(x.params, known) catch s.dummyParam;
            emitDiag(s, 3033, x.line, x.col, "外部函数 " + x.name + " 是 C 变参函数（定参 " + toStr(known) + " 个）：第 " + toStr(known + 1) + " 个参数起写成变参参数，如 ..." + vp.name + ": " + teText(vp.ty));
        } else {
            emitDiag(s, 3033, x.line, x.col, "外部函数 " + x.name + " 是 C 变参函数，定参须是 " + toStr(known) + " 个（同 C 原型），声明了 " + toStr(nfix) + " 个");
        }
    }
    const fx = new FfiX { mode: x.fmode, lib: x.flib, nr: x.fnr, mod: m.idx, line: x.line, col: x.col, pk: listNew(), pa: listNew(), rk: 0, ra: 0, nfix: nfix };
    const params: List<Ref<Ty>> = listNew();
    let pi: int = 0;
    while (pi < np) {
        const p = listGet(x.params, pi) catch s.dummyParam;
        listPush(params, ffiMarshal(s, m, x, p.ty, p.name, false));
        listPush(fx.pk, s.fx.lastK);
        listPush(fx.pa, s.fx.lastA);
        if (pi >= nfix && s.fx.lastK == 20) {
            emitDiag(s, 3033, x.line, x.col, "外部函数 " + x.name + " 的参数 " + p.name + "：回调不能作变参参数");
        }
        pi = pi + 1;
    }
    const ret = ffiMarshal(s, m, x, x.ret, "", true);
    fx.rk = s.fx.lastK;
    fx.ra = s.fx.lastA;
    const idx: int = listLen(s.externs);
    listPush(s.externs, new ExtE { name: x.name, ps: params, ret: ret, fx: fx, decl: anaExternDecl(s, m.idx, x) });
    listPush(s.extNames, x.name);
    listPush(s.extIdx, idx);
    s.fx.used = true;
}

// 带 from 的外部函数调用：实参按一般赋值规则（字面量按形参取型、无损扩宽）；回调实参须是顶层函数名。
// 外部函数的目标检查（D3 v0.35）：第一次被调用时按目标查一次，诊断落在声明处——带 from 的外部函数只在本模块可见，
// 调用与声明同属当前模块，按模块缓存的检查结果因此自洽。与构建尾部 ffiPrepare 同一判定与文案（selfhost/ffi_target.tx）。
function ffiTargetCheck(s: Ref<Sm>, xi: int, info: Ref<ExtE>): void {
    if (smTarget < 0) { return; }
    for (done in smFfiTargetDone) { if (done == xi) { return; } }
    listPush(smFfiTargetDone, xi);
    const fx = info.fx catch s.fx.dFx;
    let wide = fx.rk == 15;
    for (k in fx.pk) { if (k == 15) { wide = true; } }
    const msg = ffiTargetMessage(fx.mode, info.name, fx.lib, wide, smTarget);
    if (len(msg) > 0) { emitDiag(s, 3033, fx.line, fx.col, msg); }
}

function checkCallFfi(s: Ref<Sm>, info: Ref<ExtE>, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const fx = info.fx catch s.fx.dFx;
    if (listLen(info.ps) != listLen(args)) {
        emitDiag(s, 3011, atLine, atCol, "extern " + info.name + " 需要 " + toStr(listLen(info.ps)) + " 个实参，传入 " + toStr(listLen(args)));
    }
    let i: int = 0;
    const n = minInt(listLen(info.ps), listLen(args));
    while (i < n) {
        const a = listGet(args, i) catch s.dummyE;
        const pt = listGet(info.ps, i) catch s.dT;
        if ((listGet(fx.pk, i) catch 0) == 20) {
            ffiCallbackArg(s, a, pt, listGet(fx.pa, i) catch 0);
        } else {
            const at = checkExpr(s, a, pt);
            if (!assignable(s, at, pt)) {
                emitDiag(s, 3002, a.line, a.col, "extern " + info.name + " 实参 " + toStr(i + 1) + " 为 " + typeNameOf(s, at) + "，形参为 " + typeNameOf(s, pt));
            }
        }
        i = i + 1;
    }
    return info.ret;
}

function ffiCallbackArg(s: Ref<Sm>, a: Ref<Expr>, pt: Ref<Ty>, ci: int): void {
    const at = checkExpr(s, a, pt);
    if (a.tag == 31) {
        const sym = lookupSC(s, a.s0) catch s.dummySym;
        if (sym.kind == 2) {
            const fe = listGet(s.fns, sym.fnIdx) catch s.dummyFE;
            if (!(sym.sig catch s.dummySig).isAsync && !fe.decl.isGen) {
                if (!tyEq(s, at, pt)) {
                    emitDiag(s, 3033, a.line, a.col, "回调实参 " + a.s0 + " 的类型 " + typeNameOf(s, at) + " 与形参类型 " + typeNameOf(s, pt) + " 不一致");
                    return;
                }
                let j: int = 0;
                while (j + 1 < listLen(s.fx.cbFns)) {
                    if ((listGet(s.fx.cbFns, j) catch -1) == sym.fnIdx && (listGet(s.fx.cbFns, j + 1) catch -1) == ci) { return; }
                    j = j + 2;
                }
                listPush(s.fx.cbFns, sym.fnIdx);
                listPush(s.fx.cbFns, ci);
                return;
            }
        }
    }
    emitDiag(s, 3033, a.line, a.col, "回调实参须是顶层的非泛型、非 async 函数名（不能是闭包、函数值变量或泛型函数）：编译器为它生成 C 调用约定的入口");
}

function effectiveAsyncRet(s: Ref<Sm>, sig: Ref<Sig>): Ref<Ty> {
    if (sig.isAsync && sig.ret.tag != 7) {
        return tErrunion(s, sig.ret);
    }
    return sig.ret;
}

// fns 按声明节点号散列（容量批 C3c）：原为逐项线性查找，每个函数检查一次，函数多时平方级。
// fns 只追加；索引按长度增量补链，负载过半时整表重建。节点号可能重复（泛型实例的副本），
// 链上逐项按引用比较并取最小下标，结果与原线性查找相同。
function fnIdxLink(s: Ref<Sm>, i: int): void {
    const fe = listGet(s.fns, i) catch s.dummyFE;
    let id: int = fe.decl.id;
    if (id < 0) { id = 0 - id; }
    const b = id % listLen(s.fnHead);
    listPush(s.fnNext, listGet(s.fnHead, b) catch -1);
    listSet(s.fnHead, b, i);
}

function findFnIdx(s: Ref<Sm>, f: Ref<FnDecl>): int {
    const n = listLen(s.fns);
    if (n == 0) { return -1; }
    if (listLen(s.fnHead) < n * 2 || listLen(s.fnNext) > n) {
        let nb: int = 64;
        while (nb < n * 4) { nb = nb * 2; }
        s.fnHead = listNew();
        s.fnNext = listNew();
        let b: int = 0;
        while (b < nb) {
            listPush(s.fnHead, -1);
            b = b + 1;
        }
    }
    while (listLen(s.fnNext) < n) { fnIdxLink(s, listLen(s.fnNext)); }
    let id: int = f.id;
    if (id < 0) { id = 0 - id; }
    let i: int = listGet(s.fnHead, id % listLen(s.fnHead)) catch -1;
    let best: int = -1;
    while (i >= 0) {
        const fe = listGet(s.fns, i) catch s.dummyFE;
        if (fe.decl == f) { best = i; }
        i = listGet(s.fnNext, i) catch -1;
    }
    return best;
}

function checkFn(s: Ref<Sm>, m: Ref<Mod>, f: Ref<FnDecl>): void {
    s.curMod = m;
    const fi = findFnIdx(s, f);
    if (fi < 0) { return; }
    const fe = listGet(s.fns, fi) catch s.dummyFE;
    s.curRet = effectiveAsyncRet(s, fe.sig);
    if (fe.sig.isAsync && fe.sig.ret.tag == 7 && fe.sig.ret.ei != None) {
        emitDiag(s, 3028, f.line, f.col, "async 函数的失败侧暂只能是 Error（取消产生的是普通 Error，错误 enum 失败侧须与取消语义一起设计）");
    }
    // D3 v0.22 生成器：体内 return 不带值（curRet 取 void），yield 的值须为元素类型；生成器体是同步上下文
    // （泛型实例可能在 async 函数体检查中途检查，不能继承外层的 asyncDepth）。
    const savedGenDirect = s.iv.genDirect;
    const savedGenAny = s.iv.genAny;
    const savedGenElem = s.iv.genElem;
    const savedGenAsync = s.asyncDepth;
    s.iv.genDirect = f.isGen;
    s.iv.genAny = f.isGen;
    if (f.isGen) {
        s.curRet = s.tVoid;
        s.iv.genElem = fe.sig.ret.inner;
        s.asyncDepth = 0;
    }
    s.nextSlot = 1;
    s.scopes = listNew();
    scopePush(s);
    let i: int = 0;
    const pn = listLen(f.params);
    while (i < pn) {
        const p = listGet(f.params, i) catch s.dummyParam;
        genKwCheck(s, p.name, f.line, f.col);
        declareLocal(s, p.name, i + 1, listGet(fe.sig.params, i) catch s.dT, true, anaDecl(m.idx, f.line, f.col, ANA_AT_PARAM, ANA_TT_PARAM, p.name));
        if (s.nextSlot < i + 2) { s.nextSlot = i + 2; }
        i = i + 1;
    }
    s.asyncDepth = s.asyncDepth + b2i(fe.sig.isAsync);
    const diverges = checkBlock(s, f.body);
    s.asyncDepth = s.asyncDepth - b2i(fe.sig.isAsync);
    putBodySlot(s, f.body, s.nextSlot);
    s.iv.genDirect = savedGenDirect;
    s.iv.genAny = savedGenAny;
    s.iv.genElem = savedGenElem;
    if (f.isGen) {
        s.asyncDepth = savedGenAsync;
        return; // 生成器体走到末尾即结束迭代，无“缺 return”
    }
    if (fe.sig.ret.tag != 4 && !diverges) {
        emitDiag(s, 3012, f.line, f.col, "函数 " + f.name + " 声明返回 " + typeNameOf(s, s.curRet) + "，但存在未 return 的路径");
    }
}

function checkTest(s: Ref<Sm>, m: Ref<Mod>, td: Ref<TestDecl>): void {
    s.curMod = m;
    s.curRet = s.tVoid;
    s.nextSlot = 1;
    s.scopes = listNew();
    scopePush(s);
    checkBlock(s, td.body);
    putBodySlot(s, td.body, s.nextSlot);
}

function checkModules(s: Ref<Sm>): void {
    if (listLen(s.fx.xsSer) > 0) { ffiCheckDecls(s); }
    collectExterns(s);
    if (listLen(s.iv.ifDecls) > 0) { checkIfaceDecls(s); }
    defCheckAll(s);
    let mi: int = 0;
    const nm = listLen(s.mods);
    while (mi < nm) {
        const m = listGet(s.mods, mi) catch s.dummyMod;
        if (smPhaseUse(s, mi, 1)) { mi = mi + 1; continue; }
        s.curMod = m;
        s.curRet = s.tVoid;
        s.nextSlot = 1;
        s.scopes = listNew();
        scopePush(s);
        let gi: int = 0;
        const ng = listLen(m.globals);
        while (gi < ng) {
            const g = listGet(m.globals, gi) catch s.dBd;
            const expected = listGet(m.gTys, gi) catch s.tInt;
            s.stmtDiverged = false;
            checkExpr(s, g.init, expected);
            gi = gi + 1;
        }
        m.initCap = s.nextSlot;
        let di: int = 0;
        const nd = listLen(m.decls);
        while (di < nd) {
            const d = listGet(m.decls, di) catch s.dDecl;
            if (d.tag == 1) {
                checkFn(s, m, d.fn catch s.dummyF);
            } else if (d.tag == 9) {
                checkTest(s, m, d.td catch s.dTest);
            }
            di = di + 1;
        }
        smPhaseSave(s, mi, 1);
        mi = mi + 1;
    }
    // main 检查（入口模块；签名校验）。
    let fi: int = 0;
    const nf = listLen(s.fns);
    while (fi < nf) {
        const fe = listGet(s.fns, fi) catch s.dummyFE;
        if (fe.module_idx != s.entryModule) {
            fi = fi + 1;
            continue;
        }
        if (fe.decl.name != "main") {
            fi = fi + 1;
            continue;
        }
        s.curMod = listGet(s.mods, s.entryModule) catch s.dummyMod;
        const p0 = listGet(fe.sig.params, 0) catch s.dT;
        const argsOk: bool = listLen(fe.sig.params) == 1 && p0.tag == 12 && (p0.elem catch s.dT).tag == 3;
        if (!argsOk) {
            emitDiag(s, 3010, fe.decl.line, fe.decl.col, "main 的签名须为 (args: []string)");
        }
        const r0 = fe.sig.ret;
        const retOk: bool = r0.tag == 0 || r0.tag == 4 || (r0.tag == 7 && (r0.inner catch s.dT).tag == 0);
        if (!retOk) {
            emitDiag(s, 3010, fe.decl.line, fe.decl.col, "main 的返回类型须为 int 或 void");
        }
        s.mainFnIdx = fi;
        s.hasMain = true;
        fi = fi + 1;
    }
}

// ============================================================================
// §5.4 语句检查（checkBlock/checkStmt/checkLvalue/checkFieldBase＋捕获感知）
// ============================================================================

// 捕获感知的局部解析（checkArrow 捕获上下文内首引用登记；expr_res 统一落表）。
function resolveIdentCaptureAware(s: Ref<Sm>, e: Ref<Expr>, name: string): Ref<Sym>? {
    const hit = lookupDepth(s, name);
    if (!hit.hit) { return None; }
    if (hit.sym.kind != 0) { return hit.sym; }
    const cc = s.curCap;
    if (cc != None && hit.depth < (cc catch s.dCapCtx).floor) {
        const ctx = cc catch s.dCapCtx;
        let ci: int = -1;
        let k: int = listLen(ctx.names) - 1;
        while (k >= 0) {
            if ((listGet(ctx.names, k) catch "") == name) {
                ci = listGet(ctx.idxs, k) catch -1;
                break;
            }
            k = k - 1;
        }
        if (ci >= 0) {
            const cap = listGet(ctx.caps, ci) catch s.dummyCap;
            putExprResLocal(s, e, cap.slot);
            anaUseDecl(s, e, hit.sym.decl);
            const rs = new Sym { kind: 0, slot: cap.slot, ty: listGet(s.tys, cap.tySer) catch s.dT, isConst: true, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: hit.sym.decl };
            return rs;
        }
        const outerTy = hit.sym.ty catch s.dT;
        const slot = allocSlot(s);
        const fl = scopeAt(s, ctx.floor);
        listPush(fl.names, name);
        listPush(fl.syms, new Sym { kind: 0, slot: slot, ty: outerTy, isConst: true, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: hit.sym.decl });
        const nci: int = listLen(ctx.caps);
        listPush(ctx.caps, new Cap { name: name, tySer: outerTy.serial, slot: slot, srcTag: 0, p0: hit.sym.slot, p1: 0 });
        listPush(ctx.names, name);
        listPush(ctx.idxs, nci);
        putExprResLocal(s, e, slot);
        anaUseDecl(s, e, hit.sym.decl);
        const rs2 = new Sym { kind: 0, slot: slot, ty: outerTy, isConst: true, module_idx: 0, fnIdx: 0, sig: None, si: None, ei: None, bi: -1, gfn: None, gst: None, decl: hit.sym.decl };
        return rs2;
    }
    putExprResLocal(s, e, hit.sym.slot);
    anaUseDecl(s, e, hit.sym.decl);
    return hit.sym;
}

function checkBlock(s: Ref<Sm>, b: Ref<Block>): bool {
    scopePush(s);
    let diverges: bool = false;
    const out: List<Ref<Stmt>> = listNew();
    let changed: bool = false;
    let i: int = 0;
    const n = listLen(b.stmts);
    while (i < n) {
        const stmt = listGet(b.stmts, i) catch s.dStmt;
        if (stmt.tag == 22) {
            changed = true;
            const rss = rewriteForIn(s, stmt.fi catch s.dFi);
            let k: int = 0;
            const kn = listLen(rss);
            while (k < kn) {
                const rs = listGet(rss, k) catch s.dStmt;
                if (checkStmt(s, rs)) { diverges = true; }
                listPush(out, rs);
                k = k + 1;
            }
            i = i + 1;
            continue;
        }
        if (checkStmt(s, stmt)) { diverges = true; }
        listPush(out, stmt);
        i = i + 1;
    }
    if (changed) {
        b.stmts = out;
    }
    scopePop(s);
    return diverges;
}

function checkStmt(s: Ref<Sm>, st: Ref<Stmt>): bool {
    s.stmtDiverged = false;
    const tag = st.tag;
    if (tag == 11 || tag == 12) {
        const b = st.binding catch s.dBd;
        let expected: Ref<Ty> = s.dT;
        if (b.ty != None) {
            expected = resolveType(s, b.ty catch s.dummyTe);
        }
        const initTy = checkExpr(s, b.init, expected);
        let finalTy: Ref<Ty> = initTy;
        if (expected != s.dT) { finalTy = expected; }
        if (expected != s.dT) {
            if (!assignableE(s, b.init, initTy, expected)) {
                emitDiag(s, 3002, b.line, b.col, "绑定 '" + b.name + "' 声明为 " + typeNameOf(s, expected) + "，初值为 " + typeNameOf(s, initTy));
            }
        }
        if (finalTy.tag == 4) {
            emitDiag(s, 3020, b.line, b.col, "绑定 '" + b.name + "' 不能为 void");
        }
        if (s.iv.genAny) { genKwCheck(s, b.name, b.line, b.col); }
        if (scopeTopHas(s, b.name)) {
            emitDiag(s, 3003, b.line, b.col, "同一作用域内重复声明 '" + b.name + "'");
        }
        const slot = allocSlot(s);
        putBindSlot(s, b, slot);
        declareLocal(s, b.name, slot, finalTy, b.isConst, anaDecl(s.curMod.idx, b.line, b.col, ANA_AT_BIND, ANA_TT_VAR, b.name));
        anaBindDetail(s, s.curMod.idx, b.line, b.col, false, b.isConst, b.name, b.ty, finalTy);
        if (smDebug) { listPush(smDbgRows, mkRow(b.id, finalTy.serial, 0, 0, 0, 0, 0)); }
        return s.stmtDiverged;
    }
    if (tag == 14) {
        const a = st.assign catch s.dAssign;
        const targetTy = checkLvalue(s, a.target);
        const valTy = checkExpr(s, a.value, targetTy);
        if (!assignableE(s, a.value, valTy, targetTy)) {
            emitDiag(s, 3002, a.line, a.col, "赋值目标为 " + typeNameOf(s, targetTy) + "，右值为 " + typeNameOf(s, valTy));
        }
        return s.stmtDiverged;
    }
    if (tag == 0) {
        const e = st.expr catch s.dummyE;
        const ty = checkExpr(s, e, s.dT);
        if (isFailure(ty)) {
            emitDiag(s, 3005, e.line, e.col, "失败值（" + typeNameOf(s, ty) + "）不得丢弃：须 '?' 传播、'catch' 处理或绑定");
        }
        return s.stmtDiverged;
    }
    if (tag == 15) {
        const ifd = st.ifd catch s.dIf;
        const ct = checkExpr(s, ifd.cond, s.tBool);
        if (ct.tag != 2) {
            emitDiag(s, 3014, ifd.cond.line, ifd.cond.col, "if 条件必须是 bool（得到 " + typeNameOf(s, ct) + "；S1 无真值转换）");
        }
        const d1 = checkBlock(s, ifd.thenB);
        let d2: bool = false;
        if (ifd.elseTag == 1) {
            d2 = checkBlock(s, ifd.elseB catch s.dummyB);
        } else if (ifd.elseTag == 2) {
            const ei = new Stmt { df: None, ret: None, tag: 15, binding: None, assign: None, expr: None, ifd: ifd.elseI, wh: None, fo: None, fi: None, line: 0, col: 0 };
            d2 = checkStmt(s, ei);
        }
        return (d1 && d2) || s.stmtDiverged;
    }
    if (tag == 17) {
        const wd = st.wh catch s.dWhile;
        const ct = checkExpr(s, wd.cond, s.tBool);
        if (ct.tag != 2) {
            emitDiag(s, 3014, wd.cond.line, wd.cond.col, "while 条件必须是 bool（得到 " + typeNameOf(s, ct) + "）");
        }
        s.inLoop = s.inLoop + 1;
        checkBlock(s, wd.body);
        s.inLoop = s.inLoop - 1;
        return s.stmtDiverged;
    }
    if (tag == 18) {
        const fd = st.fo catch s.dFor;
        scopePush(s);
        if (fd.initTag == 1) {
            const bi = new Stmt { df: None, ret: None, tag: 11, binding: fd.initB, assign: None, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
            checkStmt(s, bi);
        } else if (fd.initTag == 2) {
            const ai = new Stmt { df: None, ret: None, tag: 14, binding: None, assign: fd.initA, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
            checkStmt(s, ai);
        }
        if (fd.cond != None) {
            const ct = checkExpr(s, fd.cond catch s.dummyE, s.tBool);
            if (ct.tag != 2) {
                emitDiag(s, 3014, (fd.cond catch s.dummyE).line, (fd.cond catch s.dummyE).col, "for 条件必须是 bool（得到 " + typeNameOf(s, ct) + "）");
            }
        }
        if (fd.updTag == 1) {
            const au = new Stmt { df: None, ret: None, tag: 14, binding: None, assign: fd.updA, expr: None, ifd: None, wh: None, fo: None, fi: None, line: 0, col: 0 };
            checkStmt(s, au);
        } else if (fd.updTag == 2) {
            const eu = fd.updE catch s.dummyE;
            const et = checkExpr(s, eu, s.dT);
            if (isFailure(et)) {
                emitDiag(s, 3005, eu.line, eu.col, "for 更新段的失败值不得丢弃");
            }
        }
        s.inLoop = s.inLoop + 1;
        checkBlock(s, fd.body);
        s.inLoop = s.inLoop - 1;
        scopePop(s);
        return s.stmtDiverged;
    }
    if (tag == 71) {
        // yield（D3 v0.22）：只作语句，只能直接写在生成器函数体内；值须为元素类型。
        const yv = st.expr catch s.dummyE;
        if (!s.iv.genDirect) {
            emitDiag(s, 3032, st.line, st.col, "yield 只能直接写在生成器函数（function*）体内，箭头函数里不行");
            checkExpr(s, yv, s.dT);
            return false;
        }
        if (s.deferDepth > 0) {
            emitDiag(s, 3026, st.line, st.col, "defer 体内不能 yield");
        }
        const yet = s.iv.genElem catch s.dT;
        const yvt = checkExpr(s, yv, yet);
        if (!assignableE(s, yv, yvt, yet)) {
            emitDiag(s, 3002, yv.line, yv.col, "yield 的值为 " + typeNameOf(s, yvt) + "，生成器产出 " + typeNameOf(s, yet));
        }
        return false;
    }
    if (tag == 65) {
        // defer（D3 v0.19）：块作用域、后进先出；体内禁 return、?、跳出体外的 break/continue。
        // async 函数内同样可用（D3 v0.21）：任务挂起中被取消时按后进先出执行已登记的 defer。
        // 生成器体内暂不支持（D3 v0.22：挂起中的生成器被丢弃时无法安全执行清理）；for-in 解糖
        // 内部登记的关闭动作（#genClose）不受此限。
        if (s.iv.genDirect && !isGenCloseDefer(s, st)) {
            emitDiag(s, 3026, st.line, st.col, "生成器函数体内暂不支持 defer（挂起中的生成器被丢弃时无法执行清理）");
        }
        const savedDeferLoop = s.inLoop;
        s.inLoop = 0;
        s.deferDepth = s.deferDepth + 1;
        checkBlock(s, st.df catch s.dummyB);
        s.deferDepth = s.deferDepth - 1;
        s.inLoop = savedDeferLoop;
        s.stmtDiverged = false;
        return false;
    }
    if (tag == 23) {
        const r = st.ret catch s.dRet;
        if (s.deferDepth > 0) {
            emitDiag(s, 3026, st.line, st.col, "defer 体内不能 return");
        }
        if (s.iv.genDirect && r.value != None) {
            emitDiag(s, 3032, st.line, st.col, "生成器里的 return 不能带值（用 return; 结束迭代）");
            checkExpr(s, r.value catch s.dummyE, s.dT);
            return true;
        }
        if (r.value != None) {
            const vt = checkExpr(s, r.value catch s.dummyE, s.curRet);
            if (!assignableE(s, r.value catch s.dummyE, vt, s.curRet)) {
                if (vt.tag == 5 && s.curRet.tag == 7 && s.curRet.ei != None) {
                    emitDiag(s, 3028, st.line, st.col, "函数的失败侧是 " + failName(s, s.curRet) + "，不能返回 Error（会丢掉种类）；请返回 " + failName(s, s.curRet) + " 的变体");
                } else {
                    emitDiag(s, 3002, st.line, st.col, "返回 " + typeNameOf(s, vt) + "，函数声明返回 " + typeNameOf(s, s.curRet));
                }
            }
        } else if (s.curRet.tag != 4) {
            emitDiag(s, 3002, st.line, st.col, "缺返回值（函数声明返回 " + typeNameOf(s, s.curRet) + "）");
        }
        return true;
    }
    if (tag == 24 || tag == 25) {
        if (s.inLoop == 0) {
            let kw: string = "break";
            if (tag == 25) { kw = "continue"; }
            if (s.deferDepth > 0) {
                emitDiag(s, 3026, st.line, st.col, "defer 体内不能用 " + kw + " 跳出 defer");
            } else {
                emitDiag(s, 2001, st.line, st.col, kw + " 只能出现在循环内");
            }
        }
        return s.stmtDiverged;
    }
    return s.stmtDiverged;
}

// for-in 迭代 Gen 的解糖内部登记的关闭动作：defer { #genClose(#itN); }（# 名用户写不出）。
function isGenCloseDefer(s: Ref<Sm>, st: Ref<Stmt>): bool {
    const b = st.df catch s.dummyB;
    if (listLen(b.stmts) != 1) { return false; }
    const s0 = listGet(b.stmts, 0) catch s.dStmt;
    if (s0.tag != 0) { return false; }
    const e = s0.expr catch s.dummyE;
    if (e.tag != 34) { return false; }
    const c = e.a catch s.dummyE;
    return c.tag == 31 && c.s0 == "#genClose";
}

function checkLvalue(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const tag = e.tag;
    if (tag == 31) {
        const name = e.s0;
        if (s.iv.genAny) { genKwCheck(s, name, e.line, e.col); }
        // 捕获名只读（V0.9-L；zig checkLvalue cur_capture 位镜像）。
        const ccLv = s.curCap;
        if (ccLv != None) {
            const hitLv = lookupDepth(s, name);
            if (hitLv.hit && hitLv.depth < (ccLv catch s.dCapCtx).floor && hitLv.sym.kind == 0) {
                emitDiag(s, 3023, e.line, e.col, "捕获名 '" + name + "' 在闭包体内只读（捕获＝值快照；要可变状态持 Ref）");
            }
        }
        const symO = lookupSC(s, name);
        const sym = symO catch s.dummySym;
        if (sym.kind == -1) {
            emitDiag(s, 3001, e.line, e.col, "未定义符号 '" + name + "'");
            return s.tInt;
        }
        if (sym.kind == 0) {
            if (sym.isConst) {
                emitDiag(s, 3004, e.line, e.col, "不能对 const 绑定（或参数）'" + name + "' 赋值");
            }
            putExprResLocal(s, e, sym.slot);
            anaUseDecl(s, e, sym.decl);
            putTy(s, e, sym.ty catch s.dT);
            return sym.ty catch s.dT;
        }
        if (sym.kind == 1) {
            if (sym.isConst) {
                emitDiag(s, 3004, e.line, e.col, "不能对 const 顶层绑定 '" + name + "' 赋值");
            }
            if (sym.module_idx != s.curMod.idx) {
                emitDiag(s, 3004, e.line, e.col, "跨模块赋值导入的顶层绑定 '" + name + "' 不支持（导入绑定只读）");
            }
            putExprResGlobal(s, e, sym.module_idx, sym.slot);
            anaUseDecl(s, e, sym.decl);
            putTy(s, e, sym.ty catch s.dT);
            return sym.ty catch s.dT;
        }
        emitDiag(s, 3016, e.line, e.col, "'" + name + "' 不是可赋值的变量");
        return s.tInt;
    }
    if (tag == 36) {
        const base = checkFieldBase(s, e.a catch s.dummyE);
        if (base.frozen) {
            emitDiag(s, 3004, e.line, e.col, "对 const 值类型的字段赋值（const 深层冻结；Ref 例外不适用于此链）");
        }
        let ty = base.ty;
        let throughRef: bool = false;
        while (ty.tag == 8) {
            ty = ty.inner catch ty;
            throughRef = true;
        }
        if (ty.tag != 13) {
            emitDiag(s, 3016, e.line, e.col, "字段赋值目标不是 struct（得到 " + typeNameOf(s, base.ty) + "）");
            return s.tInt;
        }
        const info = ty.si catch s.dummySi;
        let i: int = 0;
        const n = listLen(info.fnames);
        while (i < n) {
            if ((listGet(info.fnames, i) catch "") == e.s0) {
                listPush(s.tFieldRes, mkRow(e.id, 0, info.serial, i, b2i(throughRef), 0, 0));
                if (anaOn) { anaUse(s, e.i1, e.i2, ANA_AT_EXACT, e.s0, anaStKey(info, ANA_AT_FIELD, ANA_TT_PROP)); }
                const fdTy = listGet(info.ftys, i) catch s.dT;
                putTy(s, e, fdTy);
                return fdTy;
            }
            i = i + 1;
        }
        emitDiag(s, 3015, e.i1, e.i2, "struct " + info.name + " 没有字段 '" + e.s0 + "'");
        return s.tInt;
    }
    if (tag == 35) {
        const base = checkFieldBase(s, e.a catch s.dummyE);
        if (base.frozen) {
            emitDiag(s, 3004, e.line, e.col, "对 const 值类型的元素赋值（const 深层冻结）");
        }
        const idxTy = checkExpr(s, e.b catch s.dummyE, s.tInt);
        if (!intArg(idxTy)) {
            emitDiag(s, 3002, (e.b catch s.dummyE).line, (e.b catch s.dummyE).col, "索引必须是 int（得到 " + typeNameOf(s, idxTy) + "）");
        }
        const bt = base.ty;
        if (bt.tag == 11) { return bt.elem catch s.dT; }
        if (bt.tag == 12) { return bt.elem catch s.dT; }
        emitDiag(s, 3016, e.line, e.col, "索引赋值目标不是数组/切片（得到 " + typeNameOf(s, base.ty) + "）");
        return s.tInt;
    }
    emitDiag(s, 3016, e.line, e.col, "赋值目标必须是名字起头的字段/索引链");
    return s.tInt;
}

struct FieldBaseR {
    ty: Ref<Ty>,
    frozen: bool,
}

function checkFieldBase(s: Ref<Sm>, e: Ref<Expr>): Ref<FieldBaseR> {
    const tag = e.tag;
    if (tag == 31) {
        const name = e.s0;
        const symO = resolveIdentCaptureAware(s, e, name);
        const sym = symO catch s.dummySym;
        if (sym.kind == -1) {
            emitDiag(s, 3001, e.line, e.col, "未定义符号 '" + name + "'");
            return new FieldBaseR { ty: s.tInt, frozen: false };
        }
        if (sym.kind == 0) {
            const lty = sym.ty catch s.dT;
            return new FieldBaseR { ty: lty, frozen: sym.isConst && lty.tag != 8 && lty.tag != 12 };
        }
        if (sym.kind == 1) {
            const gty = sym.ty catch s.dT;
            putExprResGlobal(s, e, sym.module_idx, sym.slot);
            anaUseDecl(s, e, sym.decl);
            putTy(s, e, gty);
            return new FieldBaseR { ty: gty, frozen: sym.isConst && gty.tag != 8 && gty.tag != 12 };
        }
        emitDiag(s, 3016, e.line, e.col, "'" + name + "' 不是变量");
        return new FieldBaseR { ty: s.tInt, frozen: false };
    }
    if (tag == 36) {
        const base = checkFieldBase(s, e.a catch s.dummyE);
        let ty = base.ty;
        let throughRef: bool = false;
        while (ty.tag == 8) {
            ty = ty.inner catch ty;
            throughRef = true;
        }
        if (ty.tag == 13) {
            const info = ty.si catch s.dummySi;
            let i: int = 0;
            const n = listLen(info.fnames);
            while (i < n) {
                if ((listGet(info.fnames, i) catch "") == e.s0) {
                    listPush(s.tFieldRes, mkRow(e.id, 0, info.serial, i, b2i(throughRef), 0, 0));
                    if (anaOn) { anaUse(s, e.i1, e.i2, ANA_AT_EXACT, e.s0, anaStKey(info, ANA_AT_FIELD, ANA_TT_PROP)); }
                    const fdTy = listGet(info.ftys, i) catch s.dT;
                    putTy(s, e, fdTy);
                    return new FieldBaseR { ty: fdTy, frozen: base.frozen && fdTy.tag != 8 && fdTy.tag != 12 };
                }
                i = i + 1;
            }
            emitDiag(s, 3015, e.i1, e.i2, "struct " + info.name + " 没有字段 '" + e.s0 + "'");
        }
        emitDiag(s, 3016, e.line, e.col, "字段链目标不是 struct");
        return new FieldBaseR { ty: s.tInt, frozen: base.frozen };
    }
    if (tag == 35) {
        const base = checkFieldBase(s, e.a catch s.dummyE);
        let elem: Ref<Ty> = s.tInt;
        if (base.ty.tag == 11) { elem = base.ty.elem catch s.dT; }
        else if (base.ty.tag == 12) { elem = base.ty.elem catch s.dT; }
        const idxTy = checkExpr(s, e.b catch s.dummyE, s.tInt);
        if (!intArg(idxTy)) {
            emitDiag(s, 3002, (e.b catch s.dummyE).line, (e.b catch s.dummyE).col, "索引必须是 int（得到 " + typeNameOf(s, idxTy) + "）");
        }
        const throughShared: bool = base.ty.tag == 12 || elem.tag == 8 || elem.tag == 12;
        return new FieldBaseR { ty: elem, frozen: base.frozen && !throughShared };
    }
    emitDiag(s, 3016, e.line, e.col, "赋值目标必须是名字起头的字段/索引链");
    return new FieldBaseR { ty: s.tInt, frozen: false };
}

// ============================================================================
// §5.5 表达式检查（checkExpr 族——sema.zig §表达式 镜像；s.dT＝无期望哨兵）
// ============================================================================

function checkExpr(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const ty = checkExprInner(s, e, expected);
    putTy(s, e, ty);
    return ty;
}

function checkExprInner(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const tag = e.tag;
    if (tag == 26) {
        if (litBigClass(e.s0) != 0) { return bigIntLit(s, e, expected); }
        if (expected != s.dT && expected.tag == 1) { return s.tFloat; }
        const fl = fwLitTarget(s, expected);
        if (fl != None) { return fwIntLit(s, e, fl catch s.dT, false, e.line, e.col); }
        return s.tInt;
    }
    if (tag == 27) {
        const fl27 = fwLitTarget(s, expected);
        if (fl27 != None && (fl27 catch s.dT).alen == 10) { return fwF32Lit(s, e, fl27 catch s.dT, e.line, e.col); }
        return s.tFloat;
    }
    if (tag == 28) { return s.tString; }
    if (tag == 29) { return s.tBool; }
    if (tag == 30) {
        if (expected != s.dT) {
            if (expected.tag == 6) { return expected; }
            if (expected.tag == 5) { return expected; }
        }
        emitDiag(s, 3002, e.line, e.col, "None 需要 T? 上下文（无期望类型）");
        return tOpt(s, s.tInt);
    }
    if (tag == 31) {
        if (s.iv.genAny) { genKwCheck(s, e.s0, e.line, e.col); }
        const symO = resolveIdentCaptureAware(s, e, e.s0);
        const sym = symO catch s.dummySym;
        if (sym.kind == -1) {
            const xi = externIdxGet(s, e.s0);
            if (xi >= 0) {
                putExprResExtern(s, e, xi);
                emitDiag(s, 3002, e.line, e.col, "extern '" + e.s0 + "' 只能在被调位置使用");
                return s.tInt;
            }
            emitDiag(s, 3001, e.line, e.col, "未定义符号 '" + e.s0 + "'");
            return s.tInt;
        }
        if (sym.kind == 6 || sym.kind == 7) {
            emitDiag(s, 3002, e.line, e.col, "泛型模板 '" + e.s0 + "' 不可直接使用——函数经调用实例化（单态化），struct 经 " + e.s0 + "<T> 类型位");
            return s.tInt;
        }
        if (sym.kind == 0) { return sym.ty catch s.dT; }
        if (sym.kind == 1) {
            putExprResGlobal(s, e, sym.module_idx, sym.slot);
            anaUseDecl(s, e, sym.decl);
            return sym.ty catch s.dT;
        }
        if (sym.kind == 2) {
            putExprResFunc(s, e, sym.fnIdx);
            if (anaOn) { anaUse(s, e.line, e.col, ANA_AT_EXACT, e.s0, anaFnKey(s, sym.fnIdx)); }
            return tFn(s, sym.sig catch s.dummySig);
        }
        if (sym.kind == 3 || sym.kind == 4 || sym.kind == 9) {
            emitDiag(s, 3002, e.line, e.col, "'" + e.s0 + "' 是类型名，不能作为值使用");
            return s.tInt;
        }
        if (sym.kind == 5) {
            emitDiag(s, 3002, e.line, e.col, "内建 '" + e.s0 + "' 只能在被调位置使用");
            return s.tInt;
        }
        return s.tInt;
    }
    if (tag == 32) { return checkBinary(s, e); }
    if (tag == 33) {
        // 定宽字面量的负号（O4）：-128 在 i8 期望下与字面量一起取型。
        const opnd = e.a catch s.dummyE;
        if (e.i0 == 0 && opnd.tag == 26 && litBigClass(opnd.s0) != 0) {
            // 负号紧贴超过 int 上限的字面量：没有能容纳它的期望型，照词法的老规矩报 1004（取期望型，免得连带报错）。
            putTy(s, opnd, bigIntLit(s, opnd, s.dT));
            const fl33b = fwLitTarget(s, expected);
            if (fl33b != None) { return fl33b catch s.tInt; }
            return s.tInt;
        }
        const fl33 = fwLitTarget(s, expected);
        if (e.i0 == 0 && fl33 != None && (opnd.tag == 26 || (opnd.tag == 27 && (fl33 catch s.dT).alen == 10))) {
            const ft33 = fl33 catch s.dT;
            if (opnd.tag == 26) { fwIntLit(s, opnd, ft33, true, e.line, e.col); } else { fwF32Lit(s, opnd, ft33, e.line, e.col); }
            putTy(s, opnd, ft33);
            return ft33;
        }
        if (e.i0 == 0 && opnd.tag == 26 && expected != s.dT && expected.tag == 1) {
            // 负号紧贴整数字面量时同样随字面量取 float（定宽数值设计 §四-3：let f: float = -1）。
            return checkExpr(s, opnd, expected);
        }
        const opTy = checkExpr(s, opnd, s.dT);
        if (opTy.tag == 21 && e.i0 != 1) {
            // 定宽数值（O4 第二步）：有符号整数与 f32 取负、整数按位取反，结果同型；无符号不能取负。
            const uk = opTy.alen;
            if (e.i0 == 0 && !nkSigned(uk) && uk != 10) {
                emitDiag(s, 3034, e.line, e.col, "无符号类型 " + fwName(uk) + " 不能取负（要取二补码写 wrapSub<" + fwName(uk) + ">(0, x)）");
            }
            if (e.i0 == 2 && uk == 10) {
                emitDiag(s, 3002, e.line, e.col, "一元 '~' 需要整数类型（得到 f32）");
            }
            return opTy;
        }
        if (e.i0 == 0) {
            if (!isNumeric(opTy)) {
                emitDiag(s, 3002, e.line, e.col, "一元 '-' 需要数值（得到 " + typeNameOf(s, opTy) + "）");
            }
            return opTy;
        }
        if (e.i0 == 1) {
            if (opTy.tag != 2) {
                emitDiag(s, 3002, e.line, e.col, "一元 '!' 需要 bool（得到 " + typeNameOf(s, opTy) + "）");
            }
            return s.tBool;
        }
        if (opTy.tag != 0) {
            emitDiag(s, 3002, e.line, e.col, "一元 '~' 需要 int（得到 " + typeNameOf(s, opTy) + "）");
        }
        return s.tInt;
    }
    if (tag == 34) { return checkCall(s, e, expected); }
    if (tag == 51) {
        if (s.asyncDepth == 0) {
            emitDiag(s, 3024, e.line, e.col, "await 只能出现在 async 函数体内（同步上下文无暂停点）");
        } else if (s.deferDepth > 0) {
            emitDiag(s, 3026, e.line, e.col, "defer 体内不能 await（取消清理不能再挂起）");
        }
        const ot = checkExpr(s, e.a catch s.dummyE, s.dT);
        if (ot.tag != 16) {
            emitDiag(s, 3025, e.line, e.col, "await 操作数须为 Future<T>（得到 " + typeNameOf(s, ot) + "）");
            return s.tInt;
        }
        const inner = ot.inner catch s.dT;
        if (inner.tag == 7) { return inner; }
        return tErrunion(s, inner);
    }
    if (tag == 36) { return checkField(s, e); }
    if (tag == 35) {
        const baseTy = checkExpr(s, e.a catch s.dummyE, s.dT);
        const idxTy = checkExpr(s, e.b catch s.dummyE, s.tInt);
        if (!intArg(idxTy)) {
            emitDiag(s, 3002, (e.b catch s.dummyE).line, (e.b catch s.dummyE).col, "索引必须是 int（得到 " + typeNameOf(s, idxTy) + "）");
        }
        let ty = baseTy;
        while (ty.tag == 8) {
            ty = ty.inner catch ty;
        }
        if (ty.tag == 11) { return ty.elem catch s.dT; }
        if (ty.tag == 12) { return ty.elem catch s.dT; }
        emitDiag(s, 3002, e.line, e.col, "对 " + typeNameOf(s, baseTy) + " 使用索引（字符串索引不在 S1）");
        return s.tInt;
    }
    if (tag == 37) {
        if (s.deferDepth > 0) {
            emitDiag(s, 3026, e.line, e.col, "defer 体内不能用 ? 传播失败（请用 catch 就地处理）");
        }
        if (s.iv.genDirect) {
            // D3 v0.22：生成器不能失败（失败语义留给将来的可失败生成器）。
            emitDiag(s, 3032, e.line, e.col, "生成器里不能用 ? 传播失败（请用 catch 就地处理）");
            const git = checkExpr(s, e.a catch s.dummyE, s.dT);
            if (git.tag == 6 || git.tag == 7) { return git.inner catch s.dT; }
            return git;
        }
        const it = checkExpr(s, e.a catch s.dummyE, s.dT);
        if (it.tag == 7) {
            const ok = it.inner catch s.dT;
            if (s.curRet.tag != 7) {
                emitDiag(s, 3006, e.line, e.col, "'?' 传播 Error，但当前函数不返回 T | Error（返回 " + typeNameOf(s, s.curRet) + "；跨通道须 catch 显式桥接）");
            } else if (s.curRet.ei != None && !sameFail(s, it, s.curRet)) {
                emitDiag(s, 3028, e.line, e.col, "'?' 不能把 " + failName(s, it) + " 传播为 " + failName(s, s.curRet) + "（只允许同种传播或放宽为 Error；请用 catch 显式转换，或把返回类型的失败侧改为 Error）");
            }
            return ok;
        }
        if (it.tag == 6) {
            const inner2 = it.inner catch s.dT;
            if (s.curRet.tag != 6) {
                emitDiag(s, 3006, e.line, e.col, "'?' 传播 None，但当前函数不返回 T?（返回 " + typeNameOf(s, s.curRet) + "；跨通道须 catch 显式桥接）");
            }
            return inner2;
        }
        emitDiag(s, 3002, e.line, e.col, "'?' 只作用于 T? 或 T | Error（得到 " + typeNameOf(s, it) + "）");
        return it;
    }
    if (tag == 38) {
        const ot = checkExpr(s, e.a catch s.dummyE, s.dT);
        const tt = resolveType(s, e.ty catch s.dummyTe);
        const ok: bool = (ot.tag == 0 && tt.tag == 1) || (ot.tag == 1 && tt.tag == 0);
        if (ot.tag == 22 || tt.tag == 22) {
            // D3 v0.23 FFI：句柄不是数值，与整数互转只经显式的 handleBits / handleFromBits。
            emitDiag(s, 3013, e.line, e.col, "句柄不能用 as 转换（" + typeNameOf(s, ot) + " as " + typeNameOf(s, tt) + "）：取位值用 handleBits(h)，由位值构造用 handleFromBits<H>(v)");
            return tt;
        }
        if (!ok && (ot.tag == 21 || tt.tag == 21)) {
            // 定宽数值参与（O4）：任意两个数值类型之间都可 as；收窄越界运行期 trap。
            if (nkOf(ot) == 0 || nkOf(tt) == 0) {
                emitDiag(s, 3013, e.line, e.col, "as 只支持数值类型之间的转换（" + typeNameOf(s, ot) + " as " + typeNameOf(s, tt) + " 非法）");
            }
            return tt;
        }
        if (!ok) {
            emitDiag(s, 3013, e.line, e.col, "as 只支持 int ↔ float（" + typeNameOf(s, ot) + " as " + typeNameOf(s, tt) + " 非法）");
        }
        return tt;
    }
    if (tag == 39) { return checkCatch(s, e); }
    if (tag == 41) { return checkStructLit(s, e, expected); }
    if (tag == 43) { return checkArrayLit(s, e, expected); }
    if (tag == 44) {
        if (e.ty != None && e.s1 == "#iface") { return resolveType(s, e.ty catch s.dummyTe); }
        return checkNew(s, e);
    }
    if (tag == 46) { return checkSwitch(s, e); }
    if (tag == 49) { return checkArrow(s, e, expected); }
    return s.tInt;
}

struct TyPair {
    l: Ref<Ty>,
    r: Ref<Ty>,
}

// 数值字面量（含紧贴负号的字面量）：二元运算里按另一侧取型。
function isNumLit(e: Ref<Expr>): bool {
    if (e.tag == 26 || e.tag == 27) { return true; }
    if (e.tag == 33 && e.i0 == 0) {
        const o = e.a catch e;
        return o.tag == 26 || o.tag == 27;
    }
    return false;
}

function numLitDefault(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    let x = e;
    if (e.tag == 33) { x = e.a catch e; }
    if (x.tag == 27) { return s.tFloat; }
    return s.tInt;
}

// 二元运算两侧的类型（O4 第二步，字面量取型左右对称）：左侧是数值字面量而右侧不是时，右侧先按字面量的缺省
// 类型检查（同 v0.17 给右侧的期望），左侧再按右侧取型——右侧为定宽类型时取该类型，右侧为 float 而 fl 为真
// （算术与比较）时取 float（`1 + x`）。其余情形维持 v0.17 的先左后右（右侧按左侧取型）。
function checkOperands(s: Ref<Sm>, lhs: Ref<Expr>, rhs: Ref<Expr>, fl: bool): Ref<TyPair> {
    if (isNumLit(lhs) && !isNumLit(rhs)) {
        const rt = checkExpr(s, rhs, numLitDefault(s, lhs));
        let want: Ref<Ty> = s.dT;
        if (rt.tag == 21) { want = rt; }
        if (fl && rt.tag == 1) { want = rt; }
        return new TyPair { l: checkExpr(s, lhs, want), r: rt };
    }
    const lt = checkExpr(s, lhs, s.dT);
    return new TyPair { l: lt, r: checkExpr(s, rhs, lt) };
}

function checkBinary(s: Ref<Sm>, e: Ref<Expr>): Ref<Ty> {
    const op = e.i0;
    const lhs = e.a catch s.dummyE;
    const rhs = e.b catch s.dummyE;
    if (op == 11 || op == 12) {
        const lt = checkExpr(s, lhs, s.tBool);
        const rt = checkExpr(s, rhs, s.tBool);
        if (lt.tag != 2) {
            emitDiag(s, 3002, lhs.line, lhs.col, "逻辑运算须为 bool（得到 " + typeNameOf(s, lt) + "）");
        }
        if (rt.tag != 2) {
            emitDiag(s, 3002, rhs.line, rhs.col, "逻辑运算须为 bool（得到 " + typeNameOf(s, rt) + "）");
        }
        return s.tBool;
    }
    if (op == 5 || op == 6) {
        const pr = checkOperands(s, lhs, rhs, true);
        const lt = pr.l;
        const rt = pr.r;
        if (lt.tag == 15 || rt.tag == 15) {
            emitDiag(s, 3002, e.line, e.col, "函数值不可比较（== / !=：函数值没有相等性）");
            return s.tBool;
        }
        if (lt.tag == 20 || rt.tag == 20) {
            emitDiag(s, 3032, e.line, e.col, "Gen 不可比较（==；生成器是句柄，无相等性面）");
            return s.tBool;
        }
        if (lt.tag == 23 || rt.tag == 23) {
            emitDiag(s, 3002, e.line, e.col, "Thread 不可比较（==；线程是句柄，无相等性面）");
            return s.tBool;
        }
        if (lt.tag == 24 || rt.tag == 24 || lt.tag == 25 || rt.tag == 25) {
            emitDiag(s, 3002, e.line, e.col, "Shared、Atomic 不可比较（==；它们是句柄，无相等性面）");
            return s.tBool;
        }
        if (lt.tag == 16 || rt.tag == 16) {
            emitDiag(s, 3002, e.line, e.col, "Future 不可比较（== / !=：要知道是否完成，用 await 或 taskAwaitAny）");
            return s.tBool;
        }
        if (lt.tag == 19 || rt.tag == 19) {
            emitDiag(s, 3030, e.line, e.col, "接口值不能比较（== / !=）");
            return s.tBool;
        }
        if ((lt.tag == 21 || rt.tag == 21) && nkOf(lt) != 0 && nkOf(rt) != 0) {
            // 定宽数值（O4）：按公共类型比较；u64/usize 与有符号类型之间没有公共类型。
            if (nkCommon(nkOf(lt), nkOf(rt)) == 0) {
                emitDiag(s, 3034, e.line, e.col, "不能比较 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "：没有能无损容纳两侧的公共类型，请先用 as 显式转换");
            }
            return s.tBool;
        }
        if (!tyEq(s, lt, rt)) {
            emitDiag(s, 3002, e.line, e.col, "不能比较 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "（无跨类型 ==；None/Error 比较见 D3 §6.3-5）");
        }
        return s.tBool;
    }
    if (op >= 16 && op <= 18) {
        // 移位（O4 第二步）：结果取左侧的类型，计数可为任一整数类型（Rust、Go、Swift 同），运行期须在 0..宽度−1。
        const st = checkExpr(s, lhs, s.dT);
        let sc: Ref<Ty> = st;
        if (st.tag == 21) { sc = s.tInt; }
        const ct = checkExpr(s, rhs, sc);
        if (st.tag == 21 || ct.tag == 21) {
            if (!nkIsInt(nkOf(st)) || !nkIsInt(nkOf(ct))) {
                emitDiag(s, 3002, e.line, e.col, "移位须为整数类型（得到 " + typeNameOf(s, st) + " 与 " + typeNameOf(s, ct) + "）");
                return s.tInt;
            }
            return st;
        }
        if (st.tag != 0 || ct.tag != 0) {
            emitDiag(s, 3002, e.line, e.col, "位运算须为 int（得到 " + typeNameOf(s, st) + " 与 " + typeNameOf(s, ct) + "；无隐式转换）");
        }
        return s.tInt;
    }
    if (op >= 13 && op <= 15) {
        const pb = checkOperands(s, lhs, rhs, false);
        const lt = pb.l;
        const rt = pb.r;
        if ((lt.tag == 21 || rt.tag == 21) && nkOf(lt) != 0 && nkOf(rt) != 0) {
            // 定宽整数的与、或、异或按公共类型，结果同型（运算不会越出公共类型的范围）。
            const bc = nkCommon(nkOf(lt), nkOf(rt));
            if (bc == 0 && nkIsInt(nkOf(lt)) && nkIsInt(nkOf(rt))) {
                emitDiag(s, 3034, e.line, e.col, "不能对 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + " 做位运算：没有能无损容纳两侧的公共类型，请先用 as 显式转换");
                return lt;
            }
            if (!nkIsInt(bc)) {
                emitDiag(s, 3002, e.line, e.col, "位运算须为整数类型（得到 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "）");
                return s.tInt;
            }
            return nkTy(s, bc);
        }
        if (lt.tag != 0 || rt.tag != 0) {
            emitDiag(s, 3002, e.line, e.col, "位运算须为 int（得到 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "；无隐式转换）");
        }
        return s.tInt;
    }
    if (op >= 7 && op <= 10) {
        const pc = checkOperands(s, lhs, rhs, true);
        const lt = pc.l;
        const rt = pc.r;
        if ((lt.tag == 21 || rt.tag == 21) && nkOf(lt) != 0 && nkOf(rt) != 0) {
            if (nkCommon(nkOf(lt), nkOf(rt)) == 0) {
                emitDiag(s, 3034, e.line, e.col, "不能比较 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "：没有能无损容纳两侧的公共类型，请先用 as 显式转换");
            }
            return s.tBool;
        }
        if (!(isNumeric(lt) && isNumeric(rt) && tyEq(s, lt, rt))) {
            emitDiag(s, 3002, e.line, e.col, "大小比较须为同种数值（" + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "；int/float 不隐式转换）");
        }
        return s.tBool;
    }
    const pa = checkOperands(s, lhs, rhs, true);
    const lt = pa.l;
    const rt = pa.r;
    if (op == 0 && lt.tag == 3 && rt.tag == 3) { return s.tString; }
    if ((lt.tag == 21 || rt.tag == 21) && nkOf(lt) != 0 && nkOf(rt) != 0) {
        // 定宽数值的算术（O4 第二步）：按公共类型计算、结果同型，溢出运行期 trap 4004（消息写明类型）。
        const ac = nkCommon(nkOf(lt), nkOf(rt));
        if (ac == 0) {
            emitDiag(s, 3034, e.line, e.col, "不能对 " + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + " 做算术：没有能无损容纳两侧的公共类型，请先用 as 显式转换");
            if (lt.tag == 21) { return lt; }
            return rt;
        }
        if (op == 4 && nkIsFloat(ac)) {
            emitDiag(s, 3002, e.line, e.col, fwName(ac) + " 不支持 '%' 运算");
        }
        return nkTy(s, ac);
    }
    if (lt.tag == 0 && rt.tag == 0) { return s.tInt; }
    if (lt.tag == 1 && rt.tag == 1) {
        if (op == 4) {
            emitDiag(s, 3002, e.line, e.col, "float 不支持 '%' 运算");
        }
        return s.tFloat;
    }
    emitDiag(s, 3002, e.line, e.col, "算术须为同种数值或 string 拼接（" + typeNameOf(s, lt) + " 与 " + typeNameOf(s, rt) + "；转换用 as）");
    if (isNumeric(lt)) { return lt; }
    return s.tInt;
}

// ============================================================================
// §5.6 调用检查（直调/方法糖/内建/extern/泛型——sema.zig checkCall 族镜像）
// ============================================================================

function exprKeys(s: Ref<Sm>, args: List<Ref<Expr>>): List<int> {
    const ks: List<int> = listNew();
    let i: int = 0;
    const n = listLen(args);
    while (i < n) {
        listPush(ks, (listGet(args, i) catch s.dummyE).id);
        i = i + 1;
    }
    return ks;
}

// 实参检查会原地改写实参（接口装箱把值包成隐藏 struct 字面量并换一个节点号）：方法糖在检查前记下的实参键须按
// 检查后的节点号刷新，否则后端按旧键取到未装箱的原值（List<接口> 上 l.push(具体值) 运行时报 bad_type）。
function methodArgsRefresh(s: Ref<Sm>, off: int, args: List<Ref<Expr>>): void {
    let i: int = 0;
    const n = listLen(args);
    while (i < n && off + i < listLen(s.maFlat)) {
        listSet(s.maFlat, off + i, (listGet(args, i) catch s.dummyE).id);
        i = i + 1;
    }
}

function checkCallClosure(s: Ref<Sm>, sig: Ref<Sig>, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    if (listLen(sig.params) != listLen(args)) {
        emitDiag(s, 3011, atLine, atCol, "函数需要 " + toStr(listLen(sig.params)) + " 个实参，传入 " + toStr(listLen(args)));
    }
    let i: int = 0;
    const n = minInt(listLen(sig.params), listLen(args));
    while (i < n) {
        const atTy = checkExpr(s, listGet(args, i) catch s.dummyE, listGet(sig.params, i) catch s.dT);
        if (!assignableE(s, listGet(args, i) catch s.dummyE, atTy, listGet(sig.params, i) catch s.dT)) {
            emitDiag(s, 3002, (listGet(args, i) catch s.dummyE).line, (listGet(args, i) catch s.dummyE).col, "实参 " + toStr(i + 1) + " 为 " + typeNameOf(s, atTy) + "，形参为 " + typeNameOf(s, listGet(sig.params, i) catch s.dT));
        }
        i = i + 1;
    }
    if (sig.isAsync) { return tFuture(s, sig.ret); }
    return sig.ret;
}

function checkVariantCtor(s: Ref<Sm>, e: Ref<Expr>, ei: Ref<EnumT>, ename: string, vname: string, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    let i: int = 0;
    const n = listLen(ei.vars);
    while (i < n) {
        const v = listGet(ei.vars, i) catch s.dVarT;
        if (v.name != vname) {
            i = i + 1;
            continue;
        }
        if (listLen(v.fnames) != listLen(args)) {
            emitDiag(s, 3011, atLine, atCol, "变体 " + ename + "." + vname + " 有 " + toStr(listLen(v.fnames)) + " 个字段，传入 " + toStr(listLen(args)) + " 个实参");
        }
        let k: int = 0;
        const m = minInt(listLen(v.fnames), listLen(args));
        while (k < m) {
            const fty = listGet(v.ftys, k) catch s.dT;
            const at2 = checkExpr(s, listGet(args, k) catch s.dummyE, fty);
            if (!assignableE(s, listGet(args, k) catch s.dummyE, at2, fty)) {
                emitDiag(s, 3002, (listGet(args, k) catch s.dummyE).line, (listGet(args, k) catch s.dummyE).col, "变体字段为 " + typeNameOf(s, fty) + "，实参为 " + typeNameOf(s, at2));
            }
            k = k + 1;
        }
        listPush(s.tVariantRes, mkRow(e.id, ei.serial, i, 0, 0, 0, 0));
        return tEnum(s, ei);
    }
    emitDiag(s, 3019, atLine, atCol, "enum " + ename + " 没有变体 '" + vname + "'");
    return s.tInt;
}

function checkCallFn(s: Ref<Sm>, e: Ref<Expr>, fnIdx: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const fe = listGet(s.fns, fnIdx) catch s.dummyFE;
    if (listLen(fe.sig.params) != listLen(args)) {
        emitDiag(s, 3011, atLine, atCol, "函数 " + fe.decl.name + " 需要 " + toStr(listLen(fe.sig.params)) + " 个实参，传入 " + toStr(listLen(args)));
    }
    let i: int = 0;
    const n = minInt(listLen(fe.sig.params), listLen(args));
    while (i < n) {
        const atTy = checkExpr(s, listGet(args, i) catch s.dummyE, listGet(fe.sig.params, i) catch s.dT);
        if (!assignableE(s, listGet(args, i) catch s.dummyE, atTy, listGet(fe.sig.params, i) catch s.dT)) {
            emitDiag(s, 3002, (listGet(args, i) catch s.dummyE).line, (listGet(args, i) catch s.dummyE).col, "实参 " + toStr(i + 1) + " 为 " + typeNameOf(s, atTy) + "，形参为 " + typeNameOf(s, listGet(fe.sig.params, i) catch s.dT));
        }
        i = i + 1;
    }
    putExprResFunc(s, e, fnIdx);
    if (anaOn) { anaCallee(s, e, anaFnKey(s, fnIdx)); }
    if (fe.sig.isAsync) { return tFuture(s, fe.sig.ret); }
    return fe.sig.ret;
}

function checkCallExtern(s: Ref<Sm>, e: Ref<Expr>, xi: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const info = listGet(s.externs, xi) catch s.dExt;
    putExprResExtern(s, e, xi);
    if (anaOn && info.decl >= 0) { anaCallee(s, e, listGet(anaRows, info.decl) catch anaKey(0, 0, 0, -1, 0)); }
    if (info.fx != None) {
        ffiTargetCheck(s, xi, info);
        return checkCallFfi(s, info, args, atLine, atCol);
    }
    if (listLen(info.ps) != listLen(args)) {
        emitDiag(s, 3011, atLine, atCol, "extern " + info.name + " 需要 " + toStr(listLen(info.ps)) + " 个实参，传入 " + toStr(listLen(args)));
    }
    let i: int = 0;
    const n = minInt(listLen(info.ps), listLen(args));
    while (i < n) {
        const atTy = checkExpr(s, listGet(args, i) catch s.dummyE, listGet(info.ps, i) catch s.dT);
        if (!tyEq(s, atTy, listGet(info.ps, i) catch s.dT)) {
            emitDiag(s, 3002, (listGet(args, i) catch s.dummyE).line, (listGet(args, i) catch s.dummyE).col, "extern " + info.name + " 实参 " + toStr(i + 1) + " 为 " + typeNameOf(s, atTy) + "，形参为 " + typeNameOf(s, listGet(info.ps, i) catch s.dT));
        }
        i = i + 1;
    }
    return info.ret;
}

function resolveAndCheckCall(s: Ref<Sm>, e: Ref<Expr>, name: string, args: List<Ref<Expr>>, targs: List<Ref<Te>>, hasTargs: bool, expected: Ref<Ty>, atLine: int, atCol: int): Ref<Ty>? {
    const symO = lookupSC(s, name);
    const sym = symO catch s.dummySym;
    if (sym.kind == 2) {
        return checkCallFn(s, e, sym.fnIdx, args, atLine, atCol);
    }
    if (sym.kind == 5) {
        return checkCallBuiltin(s, e, sym.bi, args, expected, atLine, atCol);
    }
    if (sym.kind == 6) {
        return checkCallGeneric(s, e, sym.gfn catch s.dGf, args, targs, hasTargs, expected, atLine, atCol);
    }
    const xi = externIdxGet(s, name);
    if (xi >= 0) {
        return checkCallExtern(s, e, xi, args, atLine, atCol);
    }
    const bi = builtinOf(name);
    if (bi >= 0) {
        return checkCallBuiltin(s, e, bi, args, expected, atLine, atCol);
    }
    return None;
}

function checkCall(s: Ref<Sm>, e: Ref<Expr>, expected: Ref<Ty>): Ref<Ty> {
    const callee = e.a catch s.dummyE;
    const args = e.list;
    if (callee.tag == 31) {
        const name = callee.s0;
        const hit = lookupDepth(s, name);
        if (hit.hit && (hit.sym.kind == 0 || hit.sym.kind == 1)) {
            const ct = checkExpr(s, callee, s.dT);
            if (ct.tag == 15) {
                return checkCallClosure(s, ct.sig catch s.dummySig, args, callee.line, callee.col);
            }
        } else if (s.iv.genAny) {
            genKwCheck(s, name, callee.line, callee.col);
        }
        const r = resolveAndCheckCall(s, e, name, args, e.targs, listLen(e.targs) > 0, expected, callee.line, callee.col);
        if (r != None) { return r catch s.tInt; }
        emitDiag(s, 3001, callee.line, callee.col, "未定义函数 '" + name + "'");
        let i: int = 0;
        const n = listLen(args);
        while (i < n) {
            checkExpr(s, listGet(args, i) catch s.dummyE, s.dT);
            i = i + 1;
        }
        return s.tInt;
    }
    if (callee.tag == 36) {
        const fbase = callee.a catch s.dummyE;
        const fname = callee.s0;
        if (fbase.tag == 31) {
            const ename = fbase.s0;
            const symO = modSymGet(s.curMod, ename);
            const sym = symO catch s.dummySym;
            if (sym.kind == 4) {
                anaVariant(s, sym.ei catch s.dummyEi, fbase.line, fbase.col, ANA_AT_EXACT, ename, callee.i1, callee.i2, callee.s0);
                return checkVariantCtor(s, e, sym.ei catch s.dummyEi, ename, callee.s0, args, callee.i1, callee.i2);
            }
        }
        // fn 类型字段直调（探测只读接收者字段表）。
        if (true) {
            const recvProbe = checkExpr(s, fbase, s.dT);
            let bprobe = recvProbe;
            while (bprobe.tag == 8) {
                bprobe = bprobe.inner catch bprobe;
            }
            // D3 v0.20：接口值与不透明类型参数的方法调用。
            if (bprobe.tag == 18 || bprobe.tag == 19) {
                return checkIfaceCall(s, e, recvProbe, bprobe, fname, args, callee.i1, callee.i2);
            }
            if (bprobe.tag == 13) {
                const info = bprobe.si catch s.dummySi;
                let i: int = 0;
                const n = listLen(info.fnames);
                let stop: bool = false;
                while (i < n) {
                    if ((listGet(info.fnames, i) catch "") != fname) {
                        i = i + 1;
                        continue;
                    }
                    const fdTy = listGet(info.ftys, i) catch s.dT;
                    if (fdTy.tag != 15) {
                        stop = true;
                        break;
                    }
                    const ct = checkExpr(s, callee, s.dT);
                    return checkCallClosure(s, ct.sig catch s.dummySig, args, callee.i1, callee.i2);
                }
                if (stop) {
                    // 非 fn 字段 → 方法糖路径（fall through）。
                }
            }
        }
        // —— 方法语法解糖（约定名 → 方法名直击）——
        const recvTy = checkExpr(s, fbase, s.dT);
        let base = recvTy;
        while (base.tag == 8) {
            base = base.inner catch base;
        }
        let tname: string = "value";
        if (base.tag == 10) { tname = "List"; }
        else if (base.tag == 17) { tname = "bytes"; }
        else if (base.tag == 20) { tname = "gen"; }
        else if (base.tag == 3) { tname = "string"; }
        else if (base.tag == 13) { tname = structTname(s, base.si catch s.dummySi); }
        else if (base.tag == 14) { tname = (base.ei catch s.dummyEi).name; }
        else if (base.tag == 0) { tname = "int"; }
        else if (base.tag == 1) { tname = "float"; }
        else if (base.tag == 2) { tname = "bool"; }
        else if (base.tag == 21) { tname = fwName(base.alen); }
        else if (base.tag == 11) { tname = "array"; }
        else if (base.tag == 12) { tname = "array"; }
        const mapped: string = lowerFirst(tname) + upperFirst(fname);
        const newArgs: List<Ref<Expr>> = listNew();
        listPush(newArgs, fbase);
        let i: int = 0;
        const n = listLen(args);
        while (i < n) {
            listPush(newArgs, listGet(args, i) catch s.dummyE);
            i = i + 1;
        }
        // method_args 侧表（接收者前插后的全序实参键）。
        const ks = exprKeys(s, newArgs);
        const off: int = listLen(s.maFlat);
        let ki: int = 0;
        const kn = listLen(ks);
        while (ki < kn) {
            listPush(s.maFlat, listGet(ks, ki) catch 0);
            ki = ki + 1;
        }
        listPush(s.tMethodArgs, mkRow(e.id, off, kn, 0, 0, 0, 0));
        const r1 = resolveAndCheckCall(s, e, mapped, newArgs, e.targs, false, expected, callee.i1, callee.i2);
        if (r1 != None) {
            methodArgsRefresh(s, off, newArgs);
            return r1 catch s.tInt;
        }
        const r2 = resolveAndCheckCall(s, e, fname, newArgs, e.targs, false, expected, callee.i1, callee.i2);
        if (r2 != None) {
            methodArgsRefresh(s, off, newArgs);
            return r2 catch s.tInt;
        }
        // D3 v0.20：泛型实例体内回落到接收者类型的声明模块找方法。
        if (s.iv.instDepth > 0) {
            const hsym = methodSym(s, s.curMod, recvTy, mapped);
            if (hsym.kind == 2) {
                const rf = checkCallFn(s, e, hsym.fnIdx, newArgs, callee.i1, callee.i2);
                methodArgsRefresh(s, off, newArgs);
                return rf;
            }
            if (hsym.kind == 6) {
                const rg = checkCallGeneric(s, e, hsym.gfn catch s.dGf, newArgs, e.targs, false, expected, callee.i1, callee.i2);
                methodArgsRefresh(s, off, newArgs);
                return rg;
            }
        }
        emitDiag(s, 3001, callee.i1, callee.i2, "类型 " + typeNameOf(s, recvTy) + " 无方法 '" + fname + "'（未定义函数 '" + mapped + "'）");
        return s.tInt;
    }
    const ct = checkExpr(s, callee, s.dT);
    if (ct.tag == 15) {
        return checkCallClosure(s, ct.sig catch s.dummySig, args, callee.line, callee.col);
    }
    emitDiag(s, 3002, callee.line, callee.col, "调用目标不是函数");
    return s.tInt;
}

// 内建 wantArgs 签名串（sema.zig 各臂 wantArgs 字面量镜像——诊断文本逐字节）。
function builtinWantSig(b: int): string {
    if (b == 0) { return "print(string)"; }
    if (b == 1) { return "err(string)"; }
    if (b == 2) { return "readFile(string)"; }
    if (b == 3) { return "len(string|[]T|[N]T)"; }
    if (b == 4) { return "toStr(int|float|bool|string|Error)"; }
    if (b == 5) { return "unref(Ref<T>)"; }
    if (b == 6) { return "weak(Ref<T>)"; }
    if (b == 7) { return "deref(Weak<T>)"; }
    if (b == 8) { return "byteAt(string, int)"; }
    if (b == 9) { return "utf8Encode(int)"; }
    if (b == 10) { return "listNew()"; }
    if (b == 11) { return "listPush(List<T>, T)"; }
    if (b == 12) { return "listPop(List<T>)"; }
    if (b == 13) { return "listGet(List<T>, int)"; }
    if (b == 14) { return "listSet(List<T>, int, T)"; }
    if (b == 15) { return "listLen(List<T>)"; }
    if (b == 16) { return "assert(bool, string)"; }
    if (b == 17) { return "panic(string)"; }
    if (b == 18) { return "taskCancel(Future<T>)"; }
    if (b == 19) { return "taskCancelled(): bool"; }
    if (b == 20) { return "taskAwaitAny(List<Future<T>>)"; }
    if (b == 21) { return "writeFile(string, string)"; }
    if (b == 22) { return "nowMs(): int"; }
    if (b == 23) { return "sleepMs(int)"; }
    if (b == 24) { return "listRemoveAt(List<T>, int)"; }
    if (b == 25) { return "listInsert(List<T>, int, T)"; }
    if (b == 26) { return "strSub(string, int, int)"; }
    if (b == 27) { return "strIndexOf(string, string)"; }
    if (b == 28) { return "strSplit(string, string)"; }
    if (b == 30) { return "eprint(string): void"; }
    if (b == 31) { return "listDir(string): List<string> | Error"; }
