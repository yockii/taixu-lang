// V0.22-L1（LANG-12；D57 续行）：错误链 DX——toStr(err) 值可读化
//（"Error: <message>"）＋插值经 toStr 解糖同享；? 传播与 catch 面回归。
function mayFail(n: int): int | Error {
    if (n > 5) {
        return err("too big: n=" + toStr(n));
    }
    return n;
}
export function main(args: []string): int {
    const e = err("outer");
    print(toStr(e));
    print(`内嵌=${e} 消息=${e.message}`);
    print(`传播=${mayFail(9) catch -1}`);
    print(`成功=${mayFail(2) catch -1}`);
    // 链式再包装：catch err(...) 升级为新的 Error 值（联合面）——err 侧
    // 值经 message 提取后再可读化。
    const chained = mayFail(9) catch err("chained");
    const unwrapped = chained catch -1;
    if (unwrapped == -1) {
        print("Error: chained");
    } else {
        print(toStr(unwrapped));
    }
    return 0;
}
