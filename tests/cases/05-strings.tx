export function main(args: []string): int {
    const a: string = "太虚" + "-" + "taixu";
    const b: string = "tab:\t|nl:\n|quote:\"|u:\u{592A}";
    print(a);
    print(b);
    print("len=" + toStr(len("abc")) + "," + toStr(len(a)));
    print("eq=" + toStr("x" == "x") + "," + toStr("x" == "y"));
    print("bool=" + toStr(true) + toStr(false) + toStr(1.5));
    return 0;
}
