// 线程块 ABI（线程第 1 步，docs/design/v052-threads-v0.1-20261015.md §十二）。
// 按线程拆分的 NRT 内核状态收在“线程块”里。每个线程有一块按 TB_REGION（2^28 字节，2d 起；原 2^25）对齐的区域：
// 区域起点是线程块（TB_HEADER 字节，初值全零），其后是该线程的值槽栈（TB_STACK_SLOTS 个值）。
// 生成代码与内核例程由 rbx（当前值槽窗口；Win64 与 SysV 下都是被调方保存，内核例程从不写它）
// 按对齐掩码求出线程块：TB = rbx & TB_MASK——热路径只多两条整数指令，没有额外的内存读取。
// 字段沿用原来 .bss 里的符号名：内核以 G()/A() 引用这些名字时由 rtfn 改写成线程块相对寻址
// （tbOffset），手写汇编的几处直接用下面的偏移。没有列在这里的符号仍是进程级（rt 表、程序映像、
// 输出句柄、环境、FFI 状态等）。本文件不 import 任何模块（emitmirror 也引用它）。
// 2d（线程设计 §十七）：区域 2^28 字节，值槽栈 2^24−256 个值，线程块与值槽栈恰好占满区域。线程启动时只提交线程块
// 与值槽栈的首段 TB_STACK_INIT 字节（填 None），其余由 __tx_stack_more 按需提交（nrt_thread.tx）；区域内未提交的部分
// 不可访问。
export const TB_REGION: int = 268435456;
export const TB_MASK: int = -268435456;
export const TB_HEADER: int = 4096;
export const TB_STACK_SLOTS: int = 16776960;
export const TB_STACK_INIT: int = 262144;
// 线程启动时提交的部分：线程块＋值槽栈首段（4096 + 262144）。
export const TB_USED: int = 266240;

export const TB_STACK_LIMIT: int = 0;
export const TB_NATIVE_STACK_LIMIT: int = 8;
export const TB_SLOTS: int = 16;
export const TB_STR_OBJS: int = 24;
export const TB_MODULE_STATES: int = 32;
export const TB_STACK: int = 40;
export const TB_ENTRY_WIN: int = 48;
// 区域所在的那次保留的起点（线程结束时据此归还；第 2 步用）。
export const TB_RESERVATION: int = 56;
export const TB_TASK_RESUME: int = 64;
export const TB_TASK_SUSP: int = 72;
// 线程块主人的系统线程号（低 32 位；__tx_nrt_thread_bind 登记，回调蹦床核对）。
export const TB_OS_TID: int = 1080;
// FFI（线程设计 §四-7）：最近一次外部调用后的系统错误码、当前外部调用登记的回调窗口（0＝不在调用期间）。
export const TB_FFI_LAST_ERROR: int = 1088;
export const TB_FFI_CB_WIN: int = 1096;
// 释放递归深度护栏（4 字节计数，超限回落迭代工作表）。
export const TB_ZERO_DEPTH: int = 1104;
// 深链待释放表 {ptr, len, cap}（8 字节容器号）：释放递归超过护栏时，计数已归零、尚未释放子引用的容器
// 压在这里，由最外层释放帧（深度 1）在收尾时迭代清空（nrt.tx 的 __tx_zero_drain）。
// 本线程的堆（线程第 2 步，§十三-2：每线程一个堆、无锁）：11 条尺寸类空闲链（88 字节）、小块页链、
// 大块缓存（{数, 总字节} 与 16 项 {基址, 页长}，272 字节）、活着的大块链（块头 {prev, next, 总长}）。
export const TB_MEM_STATE: int = 1112;
export const TB_MEM_PAGES: int = 1200;
export const TB_BIG_CACHE: int = 1208;
export const TB_BIG_LIST: int = 1480;
export const TB_ZERO_PENDING: int = 1488;

// Linux 动态产物里线程用的 libc 函数（线程第 2 步）：内核为每个名字留一个钩子槽 __tx_libc_<名>（nrt_spawn.tx），
// 程序用到线程时由链接器登记为动态导入（link_elf_objects.tx 的 elfDynThreadHooks）；静态产物的槽为 0，走 clone。
export const PTHREAD_HOOKS: string = "pthread_create pthread_join pthread_detach pthread_attr_init pthread_attr_setstacksize pthread_attr_destroy";
// 异步任务记录回收（容量批 C4d，nrt_async.tx）：空闲链头、退役链头与尾（任务号＋1，0＝空）、排队＋挂起的任务数。
export const TB_TASK_FREE: int = 1512;
export const TB_TASK_RETIRED: int = 1520;
export const TB_TASK_RTAIL: int = 1528;
export const TB_TASK_NPEND: int = 1536;
// Shared 句柄缓存 {ptr, 字节数, 容量}（线程第 4c 步，nrt_shared.tx）：每项 16 字节 {共享块, 句柄号}。
export const TB_SHARED_CACHE: int = 1544;
// 已用到 1568。

/// 线程块字段的偏移；不是线程块字段时为 -1。"__tx_nrt_tb" 表示线程块本身（偏移 0，只经 A() 取址）。
export function tbOffset(symbol: string): int {
    if (len(symbol) < 8) { return -1; }
    if (symbol == "__tx_stack_limit") { return TB_STACK_LIMIT; }
    if (symbol == "__tx_native_stack_limit") { return TB_NATIVE_STACK_LIMIT; }
    if (symbol == "__tx_nrt_slots") { return TB_SLOTS; }
    if (symbol == "__tx_str_objs_ptr") { return TB_STR_OBJS; }
    if (symbol == "__tx_nrt_module_states") { return TB_MODULE_STATES; }
    if (symbol == "__tx_nrt_stack") { return TB_STACK; }
    if (symbol == "__tx_nrt_entry_win") { return TB_ENTRY_WIN; }
    if (symbol == "__tx_task_resume") { return TB_TASK_RESUME; }
    if (symbol == "__tx_task_susp") { return TB_TASK_SUSP; }
    if (symbol == "__tx_task_main") { return 80; }
    if (symbol == "__tx_task_tseq") { return 88; }
    if (symbol == "__tx_task_cur") { return 96; }
    if (symbol == "__tx_task_win") { return 104; }
    if (symbol == "__tx_gen_cur") { return 112; }
    if (symbol == "__tx_gen_win") { return 120; }
    if (symbol == "__tx_gen_resuming") { return 128; }
    // 24 字节的状态：弱引用表、驻留表、异步的四个向量 {ptr, len, cap}。
    if (symbol == "__tx_nrt_weak_state") { return 136; }
    if (symbol == "__tx_nrt_intern_state") { return 160; }
    if (symbol == "__tx_task_tab") { return 184; }
    if (symbol == "__tx_task_rq") { return 208; }
    if (symbol == "__tx_task_round") { return 232; }
    if (symbol == "__tx_task_tm") { return 256; }
    // 浮点格式化的五个 40 位 u32 大整数（800 字节，到 1080 为止；其后是 TB_OS_TID）。
    if (symbol == "__tx_nrt_bn") { return 280; }
    if (symbol == "__tx_task_free") { return TB_TASK_FREE; }
    if (symbol == "__tx_task_retired") { return TB_TASK_RETIRED; }
    if (symbol == "__tx_task_rtail") { return TB_TASK_RTAIL; }
    if (symbol == "__tx_task_npend") { return TB_TASK_NPEND; }
    if (symbol == "__tx_ffi_last_error") { return TB_FFI_LAST_ERROR; }
    if (symbol == "__tx_ffi_cb_win") { return TB_FFI_CB_WIN; }
    if (symbol == "__tx_nrt_tb") { return 0; }
    return -1;
}
