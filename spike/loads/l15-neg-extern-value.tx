// l15 负载（V0.26-B1 第四柱扩面）：extern 名作值——码 3002。
// host 为 declare function（extern）声明；裸读取 ⇒ 3002
// "extern 'host' 只能在被调位置使用"，落 ident 位（sema extern_idx 前置臂
// 同源——被调位面限定；AST-BIN 形态＝K_FN＋extern 原子无体，spike walkFn
// 既有 isExtern 通道承载）。
declare function host(x: int): int;
export function main(args: []string): int {
    let h = host;
    return 0;
}
