// D3 v0.50 修正：块形 catch (e) 的绑定作用域原先少弹一层，catch 表达式之后在同一块里声明的名字逃出所在块（块外仍可见、
// 外层同名声明误报重复）。现在块结束即不可见。
function parse(s: string): int | Error {
    return len(s);
}

function leak(): int {
    if (true) {
        const r = parse("ab") catch (e) { return 0; };
        const inner = r;
        print(toStr(inner));
    }
    return inner;
}

function main(args: []string): void {
    print(toStr(leak()));
}
