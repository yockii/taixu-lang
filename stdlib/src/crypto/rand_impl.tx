// 内部填充循环：reader 返回写入的字节数或负错误码，-4 表示可重试中断。
export function fillRandomFrom(data: Bytes, reader: (Bytes, int) => int): void | Error {
    const length = bytesLen(data);
    if (length == 0) { return done(); }
    const scratch = bytesNew(256);
    let offset = 0;
    while (offset < length) {
        let want = length - offset;
        if (want > 256) { want = 256; }
        const count = reader(scratch, want);
        if (count == -4) { continue; }
        if (count < 0) { return err("crypto/rand: system random source failed (" + toStr(count) + ")"); }
        if (count == 0 || count > want) { return err("crypto/rand: invalid random source progress"); }
        bytesCopy(data, offset, scratch, 0, count);
        offset = offset + count;
    }
    return done();
}

function done(): void {}
