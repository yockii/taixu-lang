// A window-associated NSApp queue marker delivers a retained real CG/NSEvent.
// The debug hook supplies only the hidden test window and pointer position.
import { windowOpenEx, windowWaitEvent, windowClose, eventWindowTarget, eventWindowX, eventWindowY, eventWindowMods } from "gui/surface";
import { platDebugPost } from "gui/engine/platform";
export function main(args: []string): int {
    const id = windowOpenEx("Taixu hidden wheel", 240, 160, 16); assert(id > 0, "hidden native window");
    const pos = (30 << 16) | 40 | (1 << 32);
    assert(platDebugPost(id, 22, 7, pos) == 0, "post pixel wheel");
    assert(platDebugPost(id, 22, (1 << 32) | 0xFFFFFFFE, (30 << 16) | 40) == 0, "post line wheel");
    let found = 0; let tries = 0;
    while (tries < 64) {
        const kind = windowWaitEvent(id, 100); if (kind == 0) { break; }
        if (kind == 9) {
            let expected = -7; if (found == 1) { expected = 80; }
            assert(found < 2 && eventWindowTarget(id) == expected, "precise points and coarse lines");
            let modifiers = 1; if (found == 1) { modifiers = 0; }
            assert(eventWindowX(id) == 40 && eventWindowY(id) == 30 && eventWindowMods(id) == modifiers, "client point and modifiers");
            found = found + 1;
        } tries = tries + 1;
    }
    windowClose(id); assert(found == 2, "both native wheel events");
    print("wheel macOS: precise points, coarse lines and coordinates OK"); return 0;
}
