// ============================================================================
// stdlib 用例：std/task——TaskGroup 同步面
// 运行：taixu test tests/task.tx（依赖 TAIXU_STDLIB 或同级发现）
// 红线：add 入组返回槽位下标；failed 计数面；async 收割面（taskGroupDrain/await）由 verify ⑤ 异步主程序对
//（tests/task-async.tx＋.out）与核心仓 e2e async-taskgroup-limit 覆盖。D3 v0.53 起结果类型泛型，无参的
// taskGroupNew 须写类型。
// ============================================================================

import { TaskGroup, taskGroupNew, taskGroupAdd, taskGroupDrain, taskGroupFailed } from "std/task";

async function five(): int {
    return 5;
}

async function seven(): int {
    return 7;
}

test "task：add 入组返回槽位下标（调用即 spawn，惰性入队）" {
    const tg = taskGroupNew<int>();
    assert(taskGroupFailed(tg) == 0, "新组 failed 为 0");
    const a = taskGroupAdd(tg, five()); // 直接调用即 spawn（用户侧着色面）
    const b = taskGroupAdd(tg, seven());
    assert(a == 0 && b == 1, "槽位下标自 0 顺序分配");
    assert(taskGroupFailed(tg) == 0, "入组不产生失败计数");
}

test "task：drain 返回 Future（同步侧不阻塞、不收割）" {
    const tg = taskGroupNew<int>();
    const a = taskGroupAdd(tg, five());
    const rs = taskGroupDrain(tg, 1); // async 调用面：Future<List<int>>；同步体不等待
    assert(a == 0, "入组槽位 0");
    assert(taskGroupFailed(tg) == 0, "drain 调用本身不产生失败计数");
}
