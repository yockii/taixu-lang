// ============================================================================
// engine/mac/m_i1 —— objc_msgSend：id(id, SEL, NSInteger)。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: int): usize from "/usr/lib/libobjc.A.dylib";

export function msgI(o: usize, s: string, a: int): usize {
    return objc_msgSend(o, sel_registerName(s), a);
}
