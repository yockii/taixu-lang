import { socketAddress, socketAddressScoped } from "std/net_socket_addr";
import { ByteSocket, socketOpen, socketClose, socketConnect, socketFinishConnect, socketRead, socketWrite, socketPoll } from "std/net_socket";
import { monotonicNs, deadlineAfterMs, deadlineRemainingMs } from "std/deadline";
import { parseIp } from "std/ip";
import { p256Hex } from "std/crypto/p256_field";

function openError(version: int): bool { socketOpen(version, false) catch (e) { return true; }; return false; }
function connectError(socket: Ref<ByteSocket>, ip: Bytes, port: int): bool { socketConnect(socket, ip, port) catch (e) { return true; }; return false; }
function readError(socket: Ref<ByteSocket>, n: int): bool { socketRead(socket, n) catch (e) { return true; }; return false; }
function pollError(socket: Ref<ByteSocket>, ms: int): bool { socketPoll(socket, false, ms) catch (e) { return true; }; return false; }
function deadlineError(ms: int): bool { deadlineAfterMs(ms) catch (e) { return true; }; return false; }

test "套接字地址：IPv4／IPv6 与 Darwin 长度字节" {
    const v4 = parseIp("127.0.0.1") catch panic("ip"); const v6 = parseIp("2001:db8::1") catch panic("ip6");
    assert(bytesEqual(socketAddress(v4, 443, 10, false) catch panic("linux4"), p256Hex("020001bb7f0000010000000000000000")), "IPv4 network order");
    assert(bytesEqual(socketAddress(v4, 443, 30, true) catch panic("darwin4"), p256Hex("100201bb7f0000010000000000000000")), "Darwin IPv4 layout");
    assert(bytesEqual(socketAddress(v6, 443, 10, false) catch panic("linux6"), p256Hex("0a0001bb0000000020010db800000000000000000000000100000000")), "Linux IPv6 layout");
    assert(bytesEqual(socketAddress(v6, 443, 23, false) catch panic("windows6"), p256Hex("170001bb0000000020010db800000000000000000000000100000000")), "Windows IPv6 layout");
    assert(bytesEqual(socketAddress(v6, 443, 30, true) catch panic("darwin6"), p256Hex("1c1e01bb0000000020010db800000000000000000000000100000000")), "Darwin IPv6 layout");
    const scoped = socketAddressScoped(v6, 443, 23, false, 4294967295) catch panic("scope");
    assert((bytesGetLE<u32>(scoped, 24) catch (0 as u32)) == 4294967295 as u32, "full u32 IPv6 scope preserved");
}

test "套接字：句柄代数、重复关闭与错误状态" {
    assert(openError(0) && openError(5), "invalid family");
    const socket = socketOpen(4, false) catch panic("open");
    const stale = new ByteSocket { handle: socket.handle, version: 4, datagram: false, state: 0 };
    assert(readError(socket, 1) && connectError(socket, bytesNew(16), 443) && connectError(socket, bytesNew(4), 0), "state and family checks");
    assert(pollError(socket, -1), "poll cannot wait forever implicitly");
    socketClose(socket); socketClose(socket);
    const fresh = socketOpen(4, false) catch panic("fresh open"); defer { socketClose(fresh); }
    assert(fresh.handle != stale.handle, "reused OS descriptor has a new ticket"); socketClose(stale);
    assert(fresh.state == 0 && connectError(fresh, bytesNew(16), 80), "stale close cannot affect fresh socket");
    assert(readError(socket, 1) && pollError(socket, 0), "closed operations rejected");
}

test "截止时间：单调钟、到期与溢出" {
    const before = monotonicNs() catch panic("monotonic clock"); const after = monotonicNs() catch panic("monotonic clock");
    assert(before >= 0 && after >= before, "monotonic observations");
    const past = deadlineAfterMs(0) catch panic("zero deadline"); assert((deadlineRemainingMs(past) catch panic("remaining")) == 0, "expired deadline");
    const future = deadlineAfterMs(100000) catch panic("future"); const left = deadlineRemainingMs(future) catch panic("remaining");
    assert(left > 0 && left <= 100000, "remaining time never extends deadline");
    assert(deadlineError(-1) && deadlineError(9223372036854775807), "invalid and overflowing duration");
}
