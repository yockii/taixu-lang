// Bind producer-owned code facts to an explicit input placement, never a symbol lookup.
import { NativeFunctionImage, nativeFunctionCopy, nativeFunctionValidate } from "./native_function_data";
import { LinkMapFunction, LinkMapPlacement, LinkMapSection, linkMapData, linkMapFail, linkMapIsa } from "./link_map_data";
import { rawNameNone } from "./binary_name";

function reject(message: string): string { linkMapFail(message); return message; }
export function linkMapAttachFunctions(image: Ref<NativeFunctionImage>, objectIndex: int, inputSection: int): string {
    const d = linkMapData();
    if (!d.ok || !image.ok) { return reject("InvalidFunctionImage:" + image.error); }
    if (image.isa != linkMapIsa(d)) { return reject("FunctionIsaMismatch:" + image.isa); }
    for (row in d.functions) { if (row.objectIndex == objectIndex && row.inputSection == inputSection) { return reject("DuplicateFunctionPlacement"); } }
    let matches = 0;
    let placement = new LinkMapPlacement { objectIndex: -1, inputSection: -1, outputSection: -1, va: -1, bytes: -1 };
    for (p in d.placements) { if (p.objectIndex == objectIndex && p.inputSection == inputSection) { placement = p; matches = matches + 1; } }
    if (matches != 1 || placement.va < 0 || placement.bytes < 0 || placement.bytes > 9223372036854775807 - placement.va) { return reject("MissingFunctionPlacement"); }
    let section = new LinkMapSection { index: -1, name: rawNameNone(), va: -1, fileOffset: -1, fileBytes: -1, memoryBytes: -1 };
    matches = 0;
    for (s in d.sections) { if (s.index == placement.outputSection) { section = s; matches = matches + 1; } }
    if (matches != 1 || section.va < 0 || placement.va < section.va || section.fileOffset < 0 || section.fileBytes < 0) { return reject("BadFunctionOutputSection"); }
    const displacement = placement.va - section.va;
    if (displacement > section.fileBytes || placement.bytes > section.fileBytes - displacement || section.fileOffset > 9223372036854775807 - displacement) { return reject("FunctionPlacementOutsideFile"); }
    const fileBase = section.fileOffset + displacement;
    if (placement.bytes > 9223372036854775807 - fileBase) { return reject("FunctionFileOffsetOverflow"); }
    const functions: List<Ref<LinkMapFunction>> = listNew(); let previousEnd = 0; let id = 0;
    for (f in image.functions) {
        const problem = nativeFunctionValidate(f, image.isa);
        if (len(problem) > 0 || f.id != id || f.begin < previousEnd || f.end > placement.bytes) { return reject("InvalidPlacedFunction:" + problem); }
        const copy = nativeFunctionCopy(f);
        listPush(functions, new LinkMapFunction { id: listLen(d.functions) + id, source: copy, objectIndex: objectIndex, inputSection: inputSection,
                outputSection: placement.outputSection, va: placement.va + f.begin, fileOffset: fileBase + f.begin });
        previousEnd = f.end; id = id + 1;
    }
    for (row in functions) { listPush(d.functions, row); } d.functionsPresent = true; return "";
}
