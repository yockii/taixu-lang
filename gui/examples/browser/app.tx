import { App, appNew, appClose, defaultSpec, pump, focusPushId } from "gui/app";
import { fontUi, fontFree } from "gui/text";
import { windowPresent, surfaceWriteBmp } from "gui/surface";
import { replayLoad, replayActive } from "gui/engine/replay";
import { BrowserUi, ID_PAGE, uiNew, uiEnsureSurfaces, uiReflow, uiRender, uiDestroy } from "./ui_state";
import { uiBind, uiOpen } from "./ui_events";
import { controllerNew, controllerTick, controllerClose } from "./controller";
import { contentError } from "./content";
import { deadlineAfterMs, deadlineRemainingMs } from "std/deadline";

function cleanup(model: Ref<BrowserUi>, app: Ref<App>): void { uiDestroy(model, app); appClose(app); }
function render(model: Ref<BrowserUi>, app: Ref<App>): void | Error {
    uiRender(model, app) catch (e) {
        const state = model.controller.navigation; state.content = contentError(state.content.url, e.message)?; state.scroll = 0;
        model.controller.version = model.controller.version + 1; uiReflow(model, app)?; return uiRender(model, app);
    }; return done();
}
function run(initial: string, demo: bool, requireWindow: bool, preview: string): int | Error {
    if (!requireWindow) { replayLoad(); if (!replayActive()) { return err("network replay requires an explicit active replay script"); } }
    const spec = defaultSpec("Taixu Browser", 760, 540); spec.min_w = 560; spec.min_h = 240;
    const app = appNew(spec);
    if (requireWindow && app.scripted && !demo) { appClose(app); return err("window system unavailable; use the explicit browser-demo entry for replay"); }
    const font = fontUi() catch (e) { appClose(app); return e; };
    const controller = controllerNew(demo, listNew(), 30000) catch (e) { fontFree(font); appClose(app); return e; };
    const model = uiNew(controller, font); defer cleanup(model, app);
    uiEnsureSurfaces(model, app)?; uiBind(model, app); focusPushId(app, ID_PAGE);
    if (initial != "about:home") { uiOpen(model, app, initial); }
    if (!requireWindow && len(model.notice) > 0) { return err(model.notice); }
    let networkBound = 0; if (!requireWindow) { networkBound = deadlineAfterMs(35000)?; }
    let frames = 0; let presents = 0; let reported = 0;
    while (app.running) {
        if (!pump(app, 16)) { break; } frames = frames + 1;
        if (app.scripted && demo && frames > 5000) { return err("browser replay exceeded its frame bound"); }
        if (!requireWindow && deadlineRemainingMs(networkBound)? == 0) { return err("browser network replay exceeded its wall-clock bound"); }
        if (controllerTick(controller)?) { app.dirty = true; }
        if (uiEnsureSurfaces(model, app)?) { app.dirty = true; }
        if (model.version != controller.version || model.page == None) {
            if (!model.editing) { model.notice = ""; } uiReflow(model, app)?; app.dirty = true;
        }
        if (demo && reported != controller.version) {
            const state = controller.navigation;
            print("browser page v=" + toStr(controller.version) + " url=" + state.content.url + " history=" + toStr(listLen(state.history)) + " cursor=" + toStr(state.cursor) + " scroll=" + toStr(state.scroll)); reported = controller.version;
        }
        // Replay frame numbers advance on presentation, including controlled
        // asynchronous waits. This branch never substitutes a demo network result.
        if (app.scripted) { app.dirty = true; }
        if (app.dirty) {
            render(model, app)?;
            if (windowPresent(app.hwnd, model.window) != 0) { return err("browser UI: presentation failed"); }
            presents = presents + 1; app.dirty = false;
        }
        if (!requireWindow && controller.started > 0 && !controller.navigation.loading && controller.job == None) {
            if (len(preview) > 0 && surfaceWriteBmp(model.window, preview) != 0) { return err("browser network replay: preview write failed"); } break;
        }
    }
    controllerClose(controller); const state = controller.navigation;
    print("browser url=" + state.content.url + " title=" + state.content.title + " history=" + toStr(listLen(state.history)) + " cursor=" + toStr(state.cursor) + " scroll=" + toStr(state.scroll)
        + " started=" + toStr(controller.started) + " completed=" + toStr(controller.completed) + " cancelled=" + toStr(controller.cancelled)
        + " links=" + toStr(model.clicks) + " opens=" + toStr(model.submits) + " scrolls=" + toStr(model.scrolls) + " reflows=" + toStr(model.reflows)
        + " resize=" + toStr(app.resize_count) + " k=" + toStr(app.k) + " presents=" + toStr(presents)); return 0;
}
export function browserMain(args: []string, demo: bool): int {
    if (len(args) == 1 && args[0] == "--help") { print("Usage: browser [http(s)://address]\nCtrl+L address, Ctrl+R reload, Alt+Left/Right history, Esc stop.\nPage: arrows, PageUp/PageDown, Home/End, Space; scrollbar and links are clickable."); return 0; }
    if (len(args) > 1) { eprint("usage: browser [http(s)://address]"); return 64; }
    let initial = "about:home"; if (demo) { initial = "https://example.test/a"; } if (len(args) == 1) { initial = args[0]; }
    return run(initial, demo, true, "") catch (e) { eprint(e.message); return 1; };
}
// Internal integration entry. It requires injected events and never opens a real
// window; production browserMain continues to require a real window system.
export function browserNetworkReplay(url: string, preview: string): int { return run(url, false, false, preview) catch (e) { eprint(e.message); return 1; }; }
function done(): void {}
