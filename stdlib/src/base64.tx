// ============================================================================
// std/base64 —— RFC 4648 base64 编解码。纯 .tx。
//
// 标准字母表（+/＝padding）＋URL-safe 变体（-_，无 padding）；decode 结构化
// Error（奇长/非法字符）。**文本域注记**：语言面 string 恒良构 UTF-8——
// 本模块按 UTF-8 字节面编解码（ASCII 输入与任意 UTF-8 文本可往返；任意
// 二进制字节域受 UTF-8 良构红线约束——bytes.tx 头注同源，如实登记）。
// 官方向量锚：RFC 4648 §10 测试向量（tests/base64-fx.tx）。
// ============================================================================

const STD: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const URL: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

// b64Encode：标准字母表（含 = padding）。
export function b64Encode(s: string): string {
    return encodeAlphabet(s, STD, true);
}

// b64EncodeUrl：URL-safe 变体（无 padding——RFC 4648 §5）。
export function b64EncodeUrl(s: string): string {
    return encodeAlphabet(s, URL, false);
}

function encodeAlphabet(s: string, alpha: string, pad: bool): string {
    let out: string = "";
    const n = len(s);
    let i: int = 0;
    while (i + 2 < n) {
        const b0 = byteTryAt(s, i) catch 0;
        const b1 = byteTryAt(s, i + 1) catch 0;
        const b2 = byteTryAt(s, i + 2) catch 0;
        out = out + chr(alpha, b0 / 4);
        out = out + chr(alpha, (b0 % 4) * 16 + b1 / 16);
        out = out + chr(alpha, (b1 % 16) * 4 + b2 / 64);
        out = out + chr(alpha, b2 % 64);
        i = i + 3;
    }
    if (n - i == 1) {
        const b0 = byteTryAt(s, i) catch 0;
        out = out + chr(alpha, b0 / 4);
        out = out + chr(alpha, (b0 % 4) * 16);
        if (pad) {
            out = out + "==";
        }
    } else if (n - i == 2) {
        const b0 = byteTryAt(s, i) catch 0;
        const b1 = byteTryAt(s, i + 1) catch 0;
        out = out + chr(alpha, b0 / 4);
        out = out + chr(alpha, (b0 % 4) * 16 + b1 / 16);
        out = out + chr(alpha, (b1 % 16) * 4);
        if (pad) {
            out = out + "=";
        }
    }
    return out;
}

// b64Decode：标准字母表（padding 可选容忍）；非法 Error。
export function b64Decode(s: string): string | Error {
    return decodeAlphabet(s, STD);
}

// b64DecodeUrl：URL-safe 变体。
export function b64DecodeUrl(s: string): string | Error {
    return decodeAlphabet(s, URL);
}

function decodeAlphabet(s: string, alpha: string): string | Error {
    // 剥 padding（标准形）；URL 形无 padding。
    let body = s;
    while (len(body) > 0 && (byteTryAt(body, len(body) - 1) catch 0) == '=') {
        body = sliceOf(body, 0, len(body) - 1);
    }
    const n = len(body);
    if (n % 4 == 1) {
        return err("odd base64 group");
    }
    // 先解成字节，再按 UTF-8 校验成串（2026-10-27：此前逐字节拒 ≥0x80，与头注“任意 UTF-8 文本可往返”不符，
    // b64Decode(b64Encode("你好")) 得 Error）。
    const out = bytesNew(n * 6 / 8);
    let k: int = 0;
    let i: int = 0;
    let acc: int = 0;
    let bits: int = 0;
    while (i < n) {
        const v = valOf(byteTryAt(body, i) catch 0, alpha);
        if (v < 0) {
            return err("bad base64 char");
        }
        acc = acc * 64 + v;
        bits = bits + 6;
        if (bits >= 8) {
            bits = bits - 8;
            bytesSet(out, k, acc / pow2(bits));
            k = k + 1;
            acc = acc % pow2(bits);
        }
        i = i + 1;
    }
    const text = bytesToStr(out) catch (e) {
        return err("decoded bytes are not UTF-8（UTF-8 良构红线）");
    };
    return text;
}

function pow2(k: int): int {
    let r: int = 1;
    let i: int = 0;
    while (i < k) {
        r = r * 2;
        i = i + 1;
    }
    return r;
}

function valOf(b: int, alpha: string): int {
    let i: int = 0;
    while (i < 64) {
        if ((byteTryAt(alpha, i) catch -1) == b) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

function chr(alpha: string, idx: int): string {
    return utf8Encode(byteTryAt(alpha, idx) catch 61) catch "=";
}

function sliceOf(s: string, from: int, to: int): string {
    let out: string = "";
    let i = from;
    while (i < to && i < len(s)) {
        out = out + (utf8Encode(byteTryAt(s, i) catch 0) catch "");
        i = i + 1;
    }
    return out;
}
