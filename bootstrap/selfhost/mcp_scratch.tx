// Parent-owned product namespace. Unknown entries are never recursively removed.
import { serviceCanonical, serviceLocalRoot } from "./service_files";
import { scratchMkdir, scratchRmdir, scratchClaim } from "./mcp_scratch_os";
import { realPath } from "./real_path";
import { jsonStart } from "./toolchain";
import { dbgStr } from "./dbg_out";
import { scratchPathSafe } from "./mcp_scratch_path";

export const SCRATCH_SLOTS: int = 64;
let workerRoot: string = "";
let cursor: int = 0;
function basename(slot: int): string {
    let name = "p-" + toStr(slot); if (hostTarget() == "windows") { name = name + ".exe"; } return name;
}
export function scratchCreate(generation: int): string | Error {
    // 上级目录（TMPDIR 等，属启动操作者的受信配置）只在这里解析为真实路径：macOS 的缺省 TMPDIR 在 /var 下，/var 是链接。
    const base = serviceCanonical(realPath(tempDir()));
    if (!scratchPathSafe(base, hostTarget() == "windows") || !serviceLocalRoot(base)) { return err("worker_scratch_not_local"); }
    let i = 0;
    while (i < 8) {
        const path = base + "/taixu-mcp-worker-" + toStr(monoNs()) + "-" + toStr(generation) + "-" + toStr(i);
        if (scratchMkdir(path)) { return path; } i = i + 1;
    }
    return err("worker_scratch_create_failed");
}
export function scratchUse(root: string): bool {
    const path = serviceCanonical(root);
    if (!scratchPathSafe(path, hostTarget() == "windows") || !serviceLocalRoot(path)) { return false; }
    workerRoot = path; cursor = 0; return true;
}
export function scratchProduct(): string | Error {
    if (len(workerRoot) == 0) { return err("worker_scratch_not_configured"); }
    if (!serviceLocalRoot(workerRoot)) { return err("worker_scratch_not_local"); }
    let i = 0;
    while (i < SCRATCH_SLOTS) {
        const name = basename(cursor); cursor = (cursor + 1) % SCRATCH_SLOTS; i = i + 1;
        const path = workerRoot + "/" + name;
        if (scratchClaim(path)) { return path; }
    }
    return err("worker_scratch_capacity_exhausted: 64 live product slots");
}
export function scratchErrorJson(tool: string, message: string): string {
    return jsonStart("tool-error/1") + ",\"ok\":false,\"tool\":" + dbgStr(tool) + ",\"reason\":\"worker_scratch_error\",\"message\":" + dbgStr(message) + ",\"retryable\":false}";
}
export function scratchClean(root: string): bool {
    if (len(root) == 0) { return true; }
    if (!scratchPathSafe(root, hostTarget() == "windows") || !serviceLocalRoot(root)) { return false; }
    let i = 0; let ok = true;
    while (i < SCRATCH_SLOTS) {
        const name = basename(i); i = i + 1;
        if (localEntryKind(root, name) == 1) { removeFile(root + "/" + name) catch (e) { ok = false; }; }
    }
    if (!ok) { return false; } return scratchRmdir(root);
}
