// V0.39-G0 位运算批（D3 v0.14）e2e：band/bor/bxor/bnot/shl/sar/shr 全谱
// ＋移位计数界外 trap＋imul 环绕＋嵌套泛型×位移同文件锚（D3 §6 无歧义结构
// 保证）＋显式实参×`<<` 交错锚（串联定序）。
function boxed<T>(x: T): List<T> {
    const out: List<T> = listNew();
    listPush(out, x);
    return out;
}
function shl3(x: int): int {
    return x << 3;
}
export function main(args: []string): int {
    const a = 12 & 10;
    const b = 12 | 10;
    const c = 12 ^ 10;
    const d = ~5;
    const e = 3 << 4;
    const f = -16 >> 2;
    const g = -16 >>> 1;
    print(toStr(a) + " " + toStr(b) + " " + toStr(c) + " " + toStr(d));
    print(toStr(e) + " " + toStr(f) + " " + toStr(g));
    // 优先级（TS 同构：| < ^ < & < ==；shift 紧于比较/加减）。
    const p1 = 1 | 2 ^ 3 & 1;
    const p2 = 2 + 3 << 1;
    const p3 = 16 >> 1 + 1;
    const p4 = 1 << 2 < 5;
    print(toStr(p1) + " " + toStr(p2) + " " + toStr(p3) + " " + toStr(p4));
    // imul：64 位环绕（与 `*` 溢出 trap 语义分立）。
    const i1 = imul(3037000499, 3);
    print(toStr(i1));
    // 嵌套泛型×位移同文件：`List<List<int>>` 与位移并存零歧义（类型位逐个
    // 消费 `>` 永不组合、表达式二元位才组合）。
    const nested: List<List<int>> = listNew();
    const inner: List<int> = boxed(7);
    listPush(nested, inner);
    const fallback: List<int> = listNew();
    const deep = listGet(listGet(nested, 0) catch fallback, 0) catch 0;
    print(toStr(deep) + " " + toStr(shl3(deep)));
    // 显式实参×`<<` 交错：平衡前瞻成功先消费、剩余为位移（串联定序）。
    const mixed = boxed(5);
    print(toStr(listLen(mixed) << 2));
    return 0;
}
