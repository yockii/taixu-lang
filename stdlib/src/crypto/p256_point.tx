// Jacobian P-256 点；EFD add-2007-bl / dbl-2001-b。异常点的结果以掩码选择，ladder 不按标量位分支。
import { P256Field, p256Hex, p256Small as small, p256Decode as decode, p256Encode as encode, p256Add as add, p256Sub as sub,
    p256Mul as mul, p256Inverse as inverse, p256Zero as zero, p256Select as select, p256Swap as swap } from "./p256_field";

export struct P256Point { x: List<int>, y: List<int>, z: List<int> }
export struct P256Affine { x: Bytes, y: Bytes }

function square(f: Ref<P256Field>, a: List<int>): List<int> { return mul(f, a, a); }
function twice(f: Ref<P256Field>, a: List<int>): List<int> { return add(f, a, a); }
function four(f: Ref<P256Field>, a: List<int>): List<int> { return twice(f, twice(f, a)); }
function eight(f: Ref<P256Field>, a: List<int>): List<int> { return twice(f, four(f, a)); }

export function p256Infinity(f: Ref<P256Field>): Ref<P256Point> { return new P256Point { x: small(f, 1), y: small(f, 1), z: small(f, 0) }; }

export function p256PointSelect(bit: int, yes: Ref<P256Point>, no: Ref<P256Point>): Ref<P256Point> {
    return new P256Point { x: select(bit, yes.x, no.x), y: select(bit, yes.y, no.y), z: select(bit, yes.z, no.z) };
}

export function p256PointDouble(f: Ref<P256Field>, p: Ref<P256Point>): Ref<P256Point> {
    const delta = square(f, p.z); const gamma = square(f, p.y); const beta = mul(f, p.x, gamma);
    const a = mul(f, sub(f, p.x, delta), add(f, p.x, delta)); const alpha = add(f, a, twice(f, a));
    const x = sub(f, square(f, alpha), eight(f, beta));
    return new P256Point { x: x, y: sub(f, mul(f, alpha, sub(f, four(f, beta), x)), eight(f, square(f, gamma))),
        z: sub(f, sub(f, square(f, add(f, p.y, p.z)), gamma), delta) };
}

export function p256PointAdd(f: Ref<P256Field>, p: Ref<P256Point>, q: Ref<P256Point>): Ref<P256Point> {
    const z1 = square(f, p.z); const z2 = square(f, q.z);
    const u1 = mul(f, p.x, z2); const u2 = mul(f, q.x, z1);
    const s1 = mul(f, p.y, mul(f, q.z, z2)); const s2 = mul(f, q.y, mul(f, p.z, z1));
    const h = sub(f, u2, u1); const sdiff = sub(f, s2, s1); const r = twice(f, sdiff);
    const i = four(f, square(f, h)); const j = mul(f, h, i); const v = mul(f, u1, i);
    const x = sub(f, sub(f, square(f, r), j), twice(f, v));
    const regular = new P256Point { x: x, y: sub(f, mul(f, r, sub(f, v, x)), twice(f, mul(f, s1, j))),
        z: twice(f, mul(f, mul(f, p.z, q.z), h)) };
    const exceptional = p256PointSelect(zero(sdiff), p256PointDouble(f, p), p256Infinity(f));
    let out = p256PointSelect(zero(h), exceptional, regular);
    out = p256PointSelect(zero(p.z), q, out); out = p256PointSelect(zero(q.z), p, out);
    return out;
}

function pointSwap(p: Ref<P256Point>, q: Ref<P256Point>, bit: int): void { swap(p.x, q.x, bit); swap(p.y, q.y, bit); swap(p.z, q.z, bit); }

export function p256Multiply(f: Ref<P256Field>, p: Ref<P256Point>, scalar: Bytes): Ref<P256Point> {
    let r0 = p256Infinity(f); let r1 = p256PointSelect(1, p, p); let bit = 255;
    while (bit >= 0) {
        const b = bytesGet(scalar, 31 - bit / 8) catch panic("p256: scalar bounds"); const selectBit = (b >> (bit % 8)) & 1;
        pointSwap(r0, r1, selectBit);
        const sum = p256PointAdd(f, r0, r1); const doubled = p256PointDouble(f, r0);
        r0 = doubled; r1 = sum; pointSwap(r0, r1, selectBit); bit = bit - 1;
    }
    return r0;
}

export function p256Affine(f: Ref<P256Field>, p: Ref<P256Point>): P256Affine | Error {
    if (zero(p.z) == 1) { return err("p256: point at infinity"); }
    const inv = inverse(f, p.z); const inv2 = square(f, inv);
    return P256Affine { x: encode(f, mul(f, p.x, inv2)), y: encode(f, mul(f, p.y, mul(f, inv2, inv))) };
}

export function p256Base(f: Ref<P256Field>): Ref<P256Point> {
    return new P256Point { x: decode(f, p256Hex("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296")),
        y: decode(f, p256Hex("4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")), z: small(f, 1) };
}

// 输入均为 32 字节大端值。全长比较也用于私钥范围检查。
export function p256Less(a: Bytes, b: Bytes): bool {
    let borrow = 0; let i = 31;
    while (i >= 0) {
        const av = bytesGet(a, i) catch panic("p256: comparison bounds"); const bv = bytesGet(b, i) catch panic("p256: comparison bounds");
        borrow = ((av - bv - borrow) >> 63) & 1; i = i - 1;
    }
    return borrow == 1;
}

export function p256DecodePoint(f: Ref<P256Field>, peer: Bytes): Ref<P256Point> | Error {
    if (bytesLen(peer) != 65 || (bytesGet(peer, 0) catch 0) != 4) { return err("p256: requires uncompressed 65-byte point"); }
    const xb = bytesSlice(peer, 1, 32); const yb = bytesSlice(peer, 33, 32);
    const prime = p256Hex("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff");
    if (!p256Less(xb, prime) || !p256Less(yb, prime)) { return err("p256: non-canonical coordinate"); }
    const x = decode(f, xb); const y = decode(f, yb);
    const b = decode(f, p256Hex("5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"));
    const rhs = add(f, sub(f, mul(f, square(f, x), x), add(f, x, twice(f, x))), b);
    if (zero(sub(f, square(f, y), rhs)) != 1) { return err("p256: point is not on curve"); }
    return new P256Point { x: x, y: y, z: small(f, 1) };
}
