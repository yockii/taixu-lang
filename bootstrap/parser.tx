const BK_FIELD: int = 36;
const BK_PROPAGATE: int = 37;
const BK_AS_CAST: int = 38;
const BK_CATCH: int = 39;
const BK_HANDLER: int = 40;
const BK_STRUCT_LIT: int = 41;
const BK_FINIT: int = 42;
const BK_ARRAY_LIT: int = 43;
const BK_NEW: int = 44;
const BK_VARIANT: int = 45;
const BK_SWITCH: int = 46;
const BK_ARM: int = 47;
const BK_PATF: int = 48;
const BK_ARROW: int = 49;
const BK_BODY: int = 50;
const BK_AWAIT: int = 51;
const BK_TNAMED: int = 52;
const BK_TREF: int = 53;
const BK_TWEAK: int = 54;
const BK_TLIST: int = 55;
const BK_TOPT: int = 56;
const BK_TSLICE: int = 57;
const BK_TARRAY: int = 58;
const BK_TERRUNION: int = 59;
const BK_TFN: int = 60;
const BK_TFUTURE: int = 61;
// 泛型三 kinds（V0.39-M0 泛型镜像；镜像 ast_bin.zig K 62–64——同源冻结）。
