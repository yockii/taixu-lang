// 闭包值调用点出现在模块初始化与 test 块里：帧窗口校正登记在 init/test 自身名下
// （此前 Zig codegen 记到 0 号函数，太虚 codegen 沿用上一个函数——多为闭包体，随轮次膨胀）。
// 原生编译器与 Zig codegen 的 .txc 须逐字节一致（scripts/test-native-bytecode-parity.py）。
function twice(f: (int) => int, x: int): int {
    return f(f(x));
}

const inc: (int) => int = (x: int): int => x + 1;
const base: int = inc(inc(40));

test "闭包值调用在 test 块里" {
    const sq = (x: int): int => x * x;
    assert(sq(base) == 1764, "sq");
    assert(twice(inc, 1) == 3, "twice");
}

export function main(args: []string): int {
    const dbl = (x: int): int => x * 2;
    print(toStr(base) + " " + toStr(dbl(base)) + " " + toStr(twice(dbl, 5)));
    return 0;
}
