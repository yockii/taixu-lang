// ============================================================================
// ============================================================================
// D3 S1 语法全景示例（syntax tour）v0.1 —— 2026-09-03
//
// 用途：D3 评审的观察材料，覆盖 S1 白名单的全部语法特性；
//       D3 定稿后，本文件将成为 TEST-02（白名单守护）的首个正向用例。
// 注意：编译器尚未实现，本文件当前不可运行；顶部 import 的 ./lexer、
//       ./token 为语法演示占位，转为守护用例时将提供真实桩模块。
// ============================================================================

// —— 注释：`//` 行注释；`/* */` 块注释（不支持嵌套）——
/* 这是一条
   跨行的块注释 */

// ============================================================================
// 一、导入与顶层声明
// ============================================================================

// TS 式命名导入；路径相对当前文件，省略 .tx 扩展名

// 顶层绑定：const 不可变绑定 / let 可变绑定；类型标注可省略（可静态推断时）
const VERSION: string = "s1-tour";
let counter: int = 0;

// 数值字面量全集：十进制 / 0x / 0o / 0b / `_` 分隔；float 小数与指数形式
const DEC: int = 1_000_000;
const HEX: int = 0xff;
const OCT: int = 0o17;
const BIN: int = 0b1011;
const PI: float = 3.14159;
const EXP: float = 6.02e23;

// 字符串字面量与转义（源码 UTF-8，可直接含中文）
const ESC: string = "tab:\t 换行:\n 引号:\" 太虚:\u{592A}";

// 字符字面量（v0.15/LANG-16）：'x' ＝ int 码点——byteAt(s, i) == 'a' 即字节比较
const CH: int = 'A';
const NLC: int = '\n';

// ============================================================================
// 二、类型声明：struct（值语义）与 enum（名义和类型）
// ============================================================================

struct Point {
    x: int,
    y: int,
}

export struct Span { // struct 字段可为其他 struct（值，内联存储）
    start: Point,
    end: Point,
}

// enum：变体可带字段（TS 判别联合的语义等价物）；递归类型经 Ref 间接
enum TokenKind {
    Ident(name: string),
    IntLit(value: int),
    FloatLit(value: float),
    Plus,
    Minus,
    EOF,
}

export enum Expr {
    Num(v: int),
    Unary(op: string, inner: Ref<Expr>),
    Binary(op: string, left: Ref<Expr>, right: Ref<Expr>),
}

// ============================================================================
// 三、函数（function + 冒号返回类型；参数一律不可变）与两类失败通道
// ============================================================================

export function add(a: int, b: int): int {
    return a + b;
}

function log(s: string): void { // void 返回
    print(s);
}

// 失败通道一：T | Error —— 操作可能故障
function div(a: int, b: int): int | Error {
    if (b == 0) {
        return err("division by zero");
    }
    return a / b;
}

// 失败通道二：T? —— 预期内的缺失
function firstByte(s: string): int? {
    if (len(s) == 0) {
        return None;
    }
    return len(s);
}

// ============================================================================
// 四、控制流与运算符
// ============================================================================

function controlFlowDemo(): int {
    // if / else if / else：条件必须是 bool（真值转换是编译错误）
    let acc: int = 0;
    if (DEC > 100 && PI < 4.0) { // && 短路
        acc = acc + 1;
    } else if (!false || true) { // 一元 ! 与 || 短路
        acc = acc + 2;
    } else {
        acc = acc + 3;
    }

    // while + break / continue
    let i: int = 0;
    while (i < 10) {
        i = i + 1;
        if (i % 2 == 0) { continue; }
        if (i > 7) { break; }
        acc = acc + i;
    }

    // C 风格 for：init 可带/省略类型标注；三段皆可为空
    for (let j = 0; j < 3; j = j + 1) { // j 推断为 int
        acc = acc + j;
    }
    for (;;) { break; } // 无限形式

    // 一元负号、取模；比较单层（a < b < c 是编译错误）
    const delta: int = -acc % 7;

    // 显式 as 转换：int <-> float（无隐式数值转换）
    const ratio: float = acc as float / 2.0;

    return acc + delta + (ratio as int);
}

// ============================================================================
// 五、struct：值语义、字面量、拷贝
// ============================================================================

function structDemo(): int {
    const origin: Point = { x: 0, y: 0 }; // 裸对象字面量（期望类型已知，TS 形式）
    let p: Point = Point { x: 3, y: 4 }; // 类型名前缀（无上下文时兜底）；let：值可改
    p.x = p.x + origin.x; // 值 struct 的字段赋值
    const span: Span = { start: { x: 1, y: 2 }, end: p }; // 嵌套裸字面量（构造时快照）
    const q: Point = p; // 赋值即整体拷贝（值语义）
    p.y = 100; // 后续修改不影响拷贝
    return span.end.y + q.y - p.y + 3; // 4 + 4 - 100 + 3 = -89
}

// ============================================================================
// 六、Ref<T>：堆引用（TS object 心智：共享、字段可变、同一性比较）
// ============================================================================

function refDemo(): int {
    const r: Ref<Point> = new Point { x: 1, y: 2 }; // new：唯一堆分配入口
    r.x = 10; // const 只约束绑定，对象字段可变（同 TS const object）
    const r2: Ref<Point> = r; // 引用赋值：共享同一对象
    const same: bool = r == r2; // true：Ref 按同一性比较
    let copy: Point = unref(r); // 整体取值拷贝（唯一显式"解引用"）
    copy.x = 99; // 只影响拷贝
    let total: int = r.x + copy.x; // 10 + 99
    if (same) { total = total + 1; }
    return total; // 110
}

// ============================================================================
// 七、enum：构造、switch 表达式（穷尽、无穿透、模式解构）
// ============================================================================

function mkToken(raw: string): TokenKind {
    // 表达式位置的变体构造：限定名（TS 命名空间/静态调用同形）
    if (raw == "+") { return TokenKind.Plus; }
    if (raw == "-") { return TokenKind.Minus; }
    return TokenKind.Ident(raw);
}

function describeToken(t: TokenKind): string {
    // switch 是表达式；case 臂不穿透（无 break 遗忘问题）；臂类型必须一致；
    // 对 enum 必须穷尽全部变体——本例无 else，少写一个变体即编译错误
    return switch (t) {
        case Ident(name) => "ident:" + name, // 模式解构绑定字段
        case IntLit(v) => "int:" + toStr(v),
        case FloatLit(v) => "float:" + toStr(v),
        case Plus => "plus",
        case Minus => "minus",
        case EOF => "eof",
    };
}

function describeExpr(e: Ref<Expr>): string {
    // scrutinee 为 Ref<Expr> 时自动解引用；else => 兜底臂（覆盖其余全部变体）
    return switch (e) {
        case Num(v) => "num:" + toStr(v),
        else => "compound",
    };
}

function exprSize(e: Ref<Expr>): int {
    // 解构绑定的字段在臂内只读；递归经 Ref 传递（无深拷贝）
    return switch (e) {
        case Num(v) => 8,
        case Unary(op, inner) => 1 + exprSize(inner),
        case Binary(op, left, right) => 1 + exprSize(left) + exprSize(right),
    };
}

// ============================================================================
// 八、两类失败通道：? 传播 / catch 两种形式 / 显式桥接
// ============================================================================

function loadSource(path: string): string | Error {
    const text = readFile(path)?; // ? 传播：失败立即返回 Error
    if (len(text) == 0) {
        return err("empty source"); // err() 构造 Error
    }
    return text;
}

function nonePropagation(s: string): int? {
    const n = firstByte(s)?; // ? 同样作用于 T?：缺席则返回 None（通道一致）
    return n + 1; // n 已解包为 int
}

function catchForms(path: string): int | Error {
    // 形式一：默认值表达式（类比 TS 的 ??）
    const fb: int = firstByte("taixu") catch 0;

    // 形式二：(e) 绑定块——e 恒为真 Error、必有 message；
    //         成功侧非 void 时块必须经 return/panic 发散（无隐式块值，同 TS 函数体）
    const text: string = loadSource(path) catch (e) {
        print("load failed: " + e.message);
        return err("outer: " + e.message);
    };

    // 桥接一：T | Error 降级为 T?（catch None）
    const maybeLen: string? = loadSource(path) catch None;
    // 桥接二：T? 升级为 T | Error（catch err(...)）
    const strictLen: int | Error = firstByte(text) catch err("empty");

    if (maybeLen == None) { // T? 与 None 的比较
        print("maybeLen: none");
    }
    const total: int = strictLen? + fb + len(text); // ? 传播（本函数正是 | Error 通道）
    return total;
}

// ============================================================================
// 九、数组与切片（[N]T 值语义 / []T 共享句柄）
// ============================================================================

function arrayDemo(): int {
    const xs: [3]int = [1, 2, 3]; // 定宽数组字面量（值类型）
    const ys: []int = [10, 20, 30, 40]; // 切片字面量（期望类型 []int → 新切片）
    let total: int = 0;
    for (let i = 0; i < len(xs); i = i + 1) {
        total = total + xs[i]; // 索引访问
    }
    const shared: []int = ys; // 切片赋值：共享底层存储（TS 数组行为）
    total = total + shared[1]; // 20
    return total; // 6 + 20 = 26
}

// ============================================================================
// 十、test 块（taixu test 枚举运行）与内建断言
// ============================================================================

test "add 基本行为" {
    assert(add(2, 3) == 5, "2 + 3 应为 5");
    assert((div(1, 0) catch -1) == 0, "除零应产生故障，取默认值 -1");
}

// ============================================================================
// 十一、弱引用 Weak<T>（D3 v0.2 §6.7：不拥有目标，deref 得 T?；D6 §5）
// ============================================================================

struct WeakTarget { name: string }

function weakDemo(): string {
    let r: Ref<WeakTarget> = new WeakTarget { name: "alive" };
    const w: Weak<WeakTarget> = weak(r); // 观察，不拥有目标
    const before = deref(w) catch WeakTarget { name: "miss" };
    r = new WeakTarget { name: "rebound" }; // 旧目标唯一强引用释放 → 死亡
    const after = deref(w) catch WeakTarget { name: "dead" };
    return before.name + "/" + after.name; // "alive/dead"
}

// ============================================================================
// 十二、List 容器（D3 v0.5 §6.9：预声明泛型＋六内建；句柄语义）
// ============================================================================

function listDemo(): int {
    const xs: List<int> = listNew(); // 元素类型经期望类型推断（同 []T 字面量规则）
    listPush(xs, 10); // 尾追加（元素 RETAIN）
    listPush(xs, 20);
    listSet(xs, 0, 11); // 索引写（越界 trap：越界码 4002）
    const head = listGet(xs, 0) catch -1; // 索引读（越界 None，byteAt 心智）
    const top = listPop(xs) catch -1; // 尾弹出（所有权移交；空表 None）
    const oob = listGet(xs, 99) catch -1; // 越界读 → None → -1
    return listLen(xs) * 100 + head + top + oob; // 1*100 + 11 + 20 + (-1) = 130
}

// ============================================================================
// 十三、外部函数：平台相关的 from 库名/syscall 例子见 tests/nrt-cases/ffi-*.tx。
// 无 from 的宿主绑定已退场，本可移植语法巡览不绑定系统函数。
// ============================================================================

// 十五、语法糖三件（D3 v0.6 §6.10：方法语法／for-in／插值——书写层面的糖，
// 解糖为零 .txc 格式变更；方法 ≡ 约定函数调用、for-in ≡ 计数循环、插值 ≡ 拼接链）
// ============================================================================

struct SugarPoint { x: int, y: int }

function sugarMagnitude(p: SugarPoint): int {
    return p.x * p.x + p.y * p.y; // 鸭子方法：首参为该类型的用户函数
}

function sugarDemo(): int {
    const p: SugarPoint = { x: 3, y: 4 };
    const nums: List<int> = listNew();
    nums.push(3); // 方法语法 ≡ listPush(nums, 3)（内建走 TypeName_method 约定名）
    nums.push(4);
    nums.push(nums.len()); // ≡ listPush(nums, listLen(nums))
    let acc: int = 0;
    for (x in nums) { // for-in：List 下标序（解糖计数循环＋listGet 发散 catch 收口）
        if (x == 4) { continue; }
        acc = acc + x;
    }
    let bytes: int = 0;
    for (b in "AB") { // string 字节序（byteAt 心智；码点迭代 v0.9 评估）
        bytes = bytes + b;
    }
    const arr = [10, 20];
    let sl: int = 0;
    for (v in arr) { // 数组下标序
        sl = sl + v;
    }
    // 插值 ≡ 拼接链（"sugar=" + toStr(...)；转义 \` 与 \$；裸 $ 非段首为字面）
    print(`sugar=${p.sugarMagnitude()} acc=${acc} bytes=${bytes} arr=${sl}$ok`);
    return acc * 100 + bytes; // 7*100 + 131 = 831
}

// ============================================================================
// 十六、闭包与函数类型（D3 v0.7 §6.11：唯一箭头形式、捕获＝值快照＋闭包内
// 只读、env/fnv 双形态调用收敛、fn 类型字段直调、List 元素面含函数类型）
// ============================================================================

const sub: (int, int) => int = (a: int, b: int): int => a - b; // 表达式体箭头

function makeAdder(n: int): (int) => int {
    return (x: int): int => x + n; // 捕获形参 n（值快照入 env；闭包体内只读）
}

struct ClosureButton {
    id: int,
    onClick: (int) => int, // fn 类型字段（GUI 回调主用例形态）
}

function closureDemo(): int {
    const add5 = makeAdder(5);
    const f0: (int, int) => int = sub; // fnv 形态：具名函数作值
    const f1: (int, int) => int = (a: int, b: int): int => a * b; // env 形态：箭头
    const r1: int = f0(10, 1); // 9
    const r2: int = f1(10, 1); // 10
    const r3: int = add5(r1); // 14（嵌套：返回箭头再捕获）
    const btn = new ClosureButton {
        id: 7,
        onClick: (t: int): int => t + 1, // 存字段后经 `.` 直调
    };
    return r3 * 100 + r2 + btn.onClick(0); // 1410 + 10 + 1 = 1421
}

// ============================================================================
// 十七、异步与任务运行时（D3 v0.8 §6.12：调用即 spawn、await 产出 T | Error、
// 确定性 FIFO 泵、取消即清理——AOT 对异步面结构化拒绝，解释器先行）
// ============================================================================

async function doubleAsync(n: int): int {
    return n * 2; // 声明写成功侧 T；调用方得 Future<int>
}

async function joinTwo(n: int): int {
    const inner = doubleAsync(n); // spawn 子任务（惰性入队）
    const v = (await inner)?; // await 产出 T | Error；? 原样传播
    return v + 1;
}

async function reporter(w: Future<int>): int {
    const v = await w catch -1; // 就地处理错误通道（本例不会触发）
    print("async:" + toStr(v)); // 任务内输出——main 同步体之后由调度泵执行
    return v;
}

function asyncDemo(): int {
    const j = joinTwo(20); // 调用即 spawn：j = Future<int>
    reporter(j); // 观察者任务：joinTwo 完成后打印 41
    return 41; // 同步侧已知结果（与任务经 Future 解耦，§6.12-3）
}

// ============================================================================
// 十四、程序入口与全景串联
// ============================================================================

export function main(args: []string): int {
    log("== S1 语法全景 " + VERSION + " =="); // void 调用作为语句

    print(ESC);
    print("控制流: " + toStr(controlFlowDemo()));
    print("struct: " + toStr(structDemo()));
    print("Ref:    " + toStr(refDemo()));
    print("数组:   " + toStr(arrayDemo()));
    print("weak:   " + weakDemo());
    print("list:   " + toStr(listDemo())); // List 容器（十二节）
    print("sugar:  " + toStr(sugarDemo())); // 语法糖三件（十五节）
    print("closure:" + toStr(closureDemo())); // 闭包与函数类型（十六节，v0.7）
    print("async: " + toStr(asyncDemo())); // 异步与任务运行时（十七节，v0.8；任务输出在泵中追加）
    print("boot:   " + toStr(byteAt("taixu", 0) catch -1) + "," + (utf8Encode(0x592A) catch "?"));
    print("token:  " + describeToken(mkToken("+"))); // 限定名构造 + 穷尽 switch
    print("noneProp: " + toStr(nonePropagation("taixu") catch 0));

    const e2: Ref<Expr> = new Expr.Unary("-", new Expr.Num(5));
    print("expr:   " + describeExpr(e2)); // else 臂 → "compound"
    print("exprSize: " + toStr(exprSize(
                new Expr.Binary("+", new Expr.Num(1), new Expr.Num(2)) // 8 + 1 + 8 = 17
            )));

    // 命令行参数与文件读取（给了参数则读该文件）
    if (len(args) > 0) {
        const n = catchForms(args[0]) catch (e) { // catch 块经 return 发散
            print("catchForms 失败: " + e.message);
            return 1;
        };
        print("catchForms: " + toStr(n));
    }
    if (len(args) > 2) {
        panic("参数过多"); // 不可恢复：非零退出
    }

    counter = counter + 1; // 顶层 let 的模块内可变性
    print("done, counter=" + toStr(counter));
    return 0;
}
