// 容量门（test_capacity_limits.tx）取子进程峰值常驻内存的 Linux 部分（导出面同 peak_os_windows.tx、peak_os_macos.tx）：子进程结束并
// 被等待后，getrusage(RUSAGE_CHILDREN) 的 ru_maxrss（KiB）即它的峰值。调用方须是新起的小进程（见 test_capacity_limits.tx 的
// --peak-helper）：Linux 在 exec 时把发起进程那份地址空间的峰值并进子进程，且 RUSAGE_CHILDREN 取所有已等待子进程的最大值。
import { captureRaw } from "./test_lib";

declare function getrusage(who: i32, usage: Bytes): i32 from syscall "getrusage";

const RUSAGE_CHILDREN: int = -1;
// struct rusage：两个 struct timeval（各 16 字节）之后是 ru_maxrss；整个结构 144 字节。
const MAXRSS_AT: int = 32;
const DRAIN_NS: int = 10000000000;
const MAX_OUTPUT: int = 1073741824;

// 在 cwd 里运行 exe（输出原样转到本进程标准输出），至多 limitMs 毫秒；得 "退出码 峰值字节"，超时得 "timeout"，起不来得 "spawn …"。
export function peakRun(exe: string, args: List<string>, cwd: string, limitMs: int): string {
    const r = captureRaw(exe, args, cwd, limitMs * 1000000, DRAIN_NS, MAX_OUTPUT) catch (e) {
        return "spawn " + e.message;
    };
    const w1 = stdoutWrite(r.out);
    const w2 = stdoutWrite(r.err);
    if (r.timedOut) {
        return "timeout";
    }
    const ru = bytesNew(144);
    if (getrusage(RUSAGE_CHILDREN as i32, ru) != 0) {
        return toStr(r.code) + " -1";
    }
    return toStr(r.code) + " " + toStr((bytesGetLE<int>(ru, MAXRSS_AT) ?? -1) * 1024);
}
