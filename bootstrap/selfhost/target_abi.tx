// 目标的组合层数据（目标分层 X3a）：随（系统，架构）的组合而变、共用代码
// 按目标取用的 ABI 数据，每个目标一行，各目标并排可查（同 Go 链接器各架构 Arch 结构里按系统分的字段、Zig std.Target 里按系统与
// 架构给动态链接器的 switch）。只随架构变的（指令编码、重定位、只有可移植版内核）按指令集判断；只随系统变的（产物格式、系统接口、
// 多数 uapi 常量）按 target.tx 的系统谓词判断：都不在这里。新加一个组合就在 targetAbi 里加一行；不适用的字段为 0 或空串，取用方
// 遇 0 报错，不拿别的目标的值顶替。
import { T_X64_WINDOWS, T_X64_LINUX, T_X64_MACOS, T_ARM64_MACOS, T_ARM64_LINUX, T_LA64_LINUX, T_RV64_LINUX, T_ARM64_WINDOWS } from "./target";

export struct TargetAbi {
    // ELF 可执行文件：段对齐（页长）、PT_INTERP 的动态链接器、GOT 槽的重定位号、e_flags（各项的来由见 link_elf_objects.tx 文件头）。
    elfPage: int,
    elfInterp: string,
    elfGlobDat: int,
    elfFlags: int,
    // Linux 静态产物主线程的 TLS 区字节数（__tx_tls_static，nrt_thread.tx）与 clone 新线程时线程指针的取法（TP_*，nrt_spawn.tx）。
    tlsStatic: int,
    threadPointer: int,
    // 内核 fstat／fstatat 缓冲的 8 字节槽数与 st_mode、st_size 的位置和宽度（unix_sys.tx）；loongarch64 的是 statx 的缓冲。
    statQuads: int,
    statModeAt: int,
    statModeBytes: int,
    statSizeAt: int,
    // open 族里随组合而变的标志（uapi fcntl.h：aarch64 的 Linux 另有数值）。
    oDirectory: int,
    oNofollow: int,
    // 链接器要额外留下的内核符号（程序映像或写出器按名字取用，nrt.tx 的根），空格分隔。
    extraRoots: string,
}

// clone 新线程时线程指针指向线程记录的哪一处：x86_64 为线程控制块（自指的线程指针）；aarch64 为 16 字节线程控制块之后的槽；
// loongarch64、riscv64 的线程控制块长 0，指向槽本身。
export const TP_TCB: int = 1;
export const TP_AFTER_TCB16: int = 2;
export const TP_SLOT: int = 3;

function none(): TargetAbi {
    return TargetAbi { elfPage: 0, elfInterp: "", elfGlobDat: 0, elfFlags: 0, tlsStatic: 0, threadPointer: 0, statQuads: 0, statModeAt: 0,
        statModeBytes: 0, statSizeAt: 0, oDirectory: 0, oNofollow: 0, extraRoots: "" };
}

// macOS（两种架构相同）：64 位 inode 的 struct stat 144 字节，st_mode 在 4（2 字节）、st_size 在 96。
function macos(): TargetAbi {
    return TargetAbi { elfPage: 0, elfInterp: "", elfGlobDat: 0, elfFlags: 0, tlsStatic: 0, threadPointer: 0, statQuads: 18, statModeAt: 4,
        statModeBytes: 2, statSizeAt: 96, oDirectory: 0x100000, oNofollow: 0x100, extraRoots: "" };
}

/// 目标编号 → 组合层数据；不认识的编号得全 0 的一行。
export function targetAbi(t: int): TargetAbi {
    // Windows 两个目标：产物是 PE，系统接口是 kernel32，这里的字段都不适用。
    if (t == T_X64_WINDOWS || t == T_ARM64_WINDOWS) { return none(); }
    // x86_64-linux：struct stat 144 字节，st_mode 在 24。
    if (t == T_X64_LINUX) {
        return TargetAbi { elfPage: 4096, elfInterp: "/lib64/ld-linux-x86-64.so.2", elfGlobDat: 6, elfFlags: 0, tlsStatic: 16,
            threadPointer: TP_TCB, statQuads: 18, statModeAt: 24, statModeBytes: 4, statSizeAt: 48, oDirectory: 0x10000, oNofollow: 0x20000,
            extraRoots: "" };
    }
    if (t == T_X64_MACOS || t == T_ARM64_MACOS) { return macos(); }
    // aarch64-linux：asm-generic 的 struct stat（128 字节，st_mode 在 16）；O_DIRECTORY、O_NOFOLLOW 是 arm64 的 uapi 数值。
    if (t == T_ARM64_LINUX) {
        return TargetAbi { elfPage: 65536, elfInterp: "/lib/ld-linux-aarch64.so.1", elfGlobDat: 1025, elfFlags: 0, tlsStatic: 24,
            threadPointer: TP_AFTER_TCB16, statQuads: 18, statModeAt: 16, statModeBytes: 4, statSizeAt: 48, oDirectory: 0x4000,
            oNofollow: 0x8000, extraRoots: "" };
    }
    // loongarch64-linux：fstat／newfstatat 由 rtfn 改写成 statx（256 字节，stx_mode 在 28、stx_size 在 40），空路径取 __tx_la64_empty。
    if (t == T_LA64_LINUX) {
        return TargetAbi { elfPage: 65536, elfInterp: "/lib64/ld-linux-loongarch-lp64d.so.1", elfGlobDat: 2, elfFlags: 67, tlsStatic: 8,
            threadPointer: TP_SLOT, statQuads: 32, statModeAt: 28, statModeBytes: 2, statSizeAt: 40, oDirectory: 0x10000, oNofollow: 0x20000,
            extraRoots: "__tx_la64_empty" };
    }
    // riscv64-linux：asm-generic 的 struct stat；动态产物的标志 __tx_dynamic_image 由链接器置 1（linux_rv64.tx 的 _start 据此）。
    if (t == T_RV64_LINUX) {
        return TargetAbi { elfPage: 4096, elfInterp: "/lib/ld-linux-riscv64-lp64d.so.1", elfGlobDat: 2, elfFlags: 4, tlsStatic: 8,
            threadPointer: TP_SLOT, statQuads: 18, statModeAt: 16, statModeBytes: 4, statSizeAt: 48, oDirectory: 0x10000, oNofollow: 0x20000,
            extraRoots: "__tx_dynamic_image" };
    }
    return none();
}
