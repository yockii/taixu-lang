// 原生调试用例（第 6 轮 6c-4c）：值的完整渲染——定宽整数与 f32 的局部变量、字段与捕获，三种列表形态与 Bytes，
// 数组与切片，结构与嵌套结构，值枚举与 Ref 枚举，错误 enum 的载荷与原因，存活与已死的 Weak，Future、生成器、
// 线程、Shared、Atomic，深 8 与长串的截断。断点在 main 末尾的 print 上，它用到全部变量。
struct Pair {
    lo: u8,
    hi: u64,
    f: f32,
}

struct Holder {
    name: string,
    pair: Pair,
    tags: List< i16>,
}

struct Node {
    v: int,
}

enum Shape {
    Circle(r: f32),
    Rect(w: u32, h: u32),
    Empty,
}

enum Chain {
    Link(v: int, next: Ref< Chain>),
    End,
}

enum LoadError extends Error {
    Missing(path: string) = `找不到 ${path}`,
    Io(path: string, cause: Error) = `读取 ${path} 失败`,
}

function * count(n: int): int {
    let i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
}

function work(): int {
    return 21 * 2;
}

async function job(n: int): int {
    return n + 1;
}

function fail(): int | LoadError {
    return LoadError.Io("a.cfg", err("磁盘已满"));
}

function deadWeak(): Weak< Node> {
    const n = new Node { v: 9 };
    return weak(n);
}

export function main(args: []string): int {
    const small: i8 = -5;
    const big: u64 = 9223372036854775807 as u64 * 2 + 1;
    const port: u16 = 8080;
    const ratio: f32 = 0.1;
    const pair = Pair { lo: 255, hi: big, f: ratio };
    const tags: List< i16> = listNew();
    listPush(tags, -3);
    listPush(tags, 300);
    const holder = new Holder { name: "盒", pair: pair, tags: tags };
    const raw = bytesNew(3);
    bytesSet(raw, 0, 1);
    bytesSet(raw, 2, 255);
    const words: List< u64> = listNew();
    listPush(words, big);
    listPush(words, 7);
    const floats: List< f32> = listNew();
    listPush(floats, ratio);
    listPush(floats, 2.5);
    const names: List< string> = listNew();
    listPush(names, "a");
    const arr: [3]int = [1, 2, 3];
    const sl: []u8 = [7, 8];
    const circle: Shape = Shape.Circle(1.5);
    const rect: Ref< Shape> = new Shape.Rect(4, 5);
    let chain: Ref< Chain> = new Chain.End();
    let k = 0;
    while (k < 10) {
        chain = new Chain.Link(k, chain);
        k = k + 1;
    }
    const long = "0123456789012345678901234567890123456789012345678901234567890123456789";
    const failed = fail();
    const node = new Node { v: 1 };
    const alive = weak(node);
    const dead = deadWeak();
    const fut = job(1);
    const g = count(3);
    const th = threadSpawn(work);
    const got = threadJoin(th) catch -1;
    const sh = sharedNew(names);
    const view = sharedGet(sh);
    const at = atomicNew(5);
    atomicAdd(at, 2);
    const add = (x: int): int => x + port;
    print(toStr(small) + " " + toStr(big) + " " + toStr(pair.lo) + " " + toStr(holder.pair.f) + " " + toStr(bytesLen(raw)) + " " + toStr(listLen(words)) + " " + toStr(listLen(floats)) + " " + toStr(arr[1]) + " " + toStr(len(sl)) + " " + toStr(circle == circle) + " " + toStr(rect == rect) + " " + toStr(chain == chain) + " " + long + " " + toStr(failed catch -1) + " " + toStr(deref(alive) != None) + " " + toStr(deref(dead) == None) + " " + toStr(got) + " " + toStr(listLen(view)) + " " + toStr(atomicLoad(at)) + " " + toStr(add(1)));
    const futs = [fut];
    let s = 0;
    for (x in g) { s = s + x; }
    print(toStr(s) + " " + toStr(listLen(sharedGet(sh))) + " " + toStr(len(futs)));
    return 0;
}
