// 容量门（test_capacity_limits.tx）取子进程峰值常驻内存的 Windows 部分（导出面同 peak_os_linux.tx、peak_os_macos.tx）：内建的
// procSpawn 不给出进程句柄，这里经 kernel32 的 CreateProcessW 起子进程（继承本进程的标准句柄，输出直接进父进程的管道），等它结束后
// 以 K32GetProcessMemoryInfo 取 PeakWorkingSetSize。结构体按 x64／ARM64 的布局写在 Bytes 里。
declare type SECURITY_ATTRIBUTES;
declare function CreateProcessW(app: wstr, cmd: wstr, pa: SECURITY_ATTRIBUTES?, ta: SECURITY_ATTRIBUTES?, inherit: i32, flags: u32, env: isize,
    cwd: wstr, si: Bytes, pi: Bytes): i32 from "kernel32";
declare function GetStdHandle(which: u32): isize from "kernel32";
declare function SetHandleInformation(h: isize, mask: u32, flags: u32): i32 from "kernel32";
declare function WaitForSingleObject(h: isize, ms: u32): u32 from "kernel32";
declare function GetExitCodeProcess(h: isize, code: Bytes): i32 from "kernel32";
declare function TerminateProcess(h: isize, code: u32): i32 from "kernel32";
declare function K32GetProcessMemoryInfo(h: isize, counters: Bytes, cb: u32): i32 from "kernel32";
declare function CloseHandle(h: isize): i32 from "kernel32";
declare function GetLastError(): u32 from "kernel32";

// STD_INPUT_HANDLE／STD_OUTPUT_HANDLE／STD_ERROR_HANDLE（−10、−11、−12 的 DWORD 写法）。
const STD_HANDLES: []int = [4294967286, 4294967285, 4294967284];
const HANDLE_FLAG_INHERIT: int = 1;
const STARTF_USESTDHANDLES: int = 256;
const STARTUPINFO_SIZE: int = 104;
const COUNTERS_SIZE: int = 72;
const WAIT_TIMEOUT: int = 258;

function quoted(a: string): string {
    return "\"" + a + "\"";
}

// 在 cwd 里运行 exe（实参不得含引号），至多 limitMs 毫秒；得 "退出码 峰值字节"，超时得 "timeout"，起不来得 "spawn …"。
export function peakRun(exe: string, args: List<string>, cwd: string, limitMs: int): string {
    let cmd = quoted(exe);
    for (a in args) {
        cmd = cmd + " " + quoted(a);
    }
    const si = bytesNew(STARTUPINFO_SIZE);
    bytesSetLE<u32>(si, 0, STARTUPINFO_SIZE as u32);
    bytesSetLE<u32>(si, 60, STARTF_USESTDHANDLES as u32);
    let k = 0;
    while (k < 3) {
        const h = GetStdHandle(STD_HANDLES[k] as u32);
        if (h != 0 && h != -1) {
            const set = SetHandleInformation(h, HANDLE_FLAG_INHERIT as u32, HANDLE_FLAG_INHERIT as u32);
        }
        bytesSetLE<int>(si, 80 + 8 * k, h as int);
        k = k + 1;
    }
    const pi = bytesNew(24);
    if (CreateProcessW(exe, cmd, None, None, 1, 0, 0, cwd, si, pi) == 0) {
        return "spawn error " + toStr(GetLastError() as int);
    }
    const proc = (bytesGetLE<int>(pi, 0) ?? 0) as isize;
    const thread = (bytesGetLE<int>(pi, 8) ?? 0) as isize;
    let result = "";
    if ((WaitForSingleObject(proc, limitMs as u32) as int) == WAIT_TIMEOUT) {
        const killed = TerminateProcess(proc, 1);
        const waited = WaitForSingleObject(proc, 5000);
        result = "timeout";
    } else {
        const code = bytesNew(4);
        const got = GetExitCodeProcess(proc, code);
        const counters = bytesNew(COUNTERS_SIZE);
        bytesSetLE<u32>(counters, 0, COUNTERS_SIZE as u32);
        let peak = -1;
        if (K32GetProcessMemoryInfo(proc, counters, COUNTERS_SIZE as u32) != 0) {
            peak = bytesGetLE<int>(counters, 8) ?? -1;
        }
        result = toStr((bytesGetLE<u32>(code, 0) ?? 0) as int) + " " + toStr(peak);
    }
    const c1 = CloseHandle(thread);
    const c2 = CloseHandle(proc);
    return result;
}
