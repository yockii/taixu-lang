// 06 模块与标准库：import、std/ 模块；Map/Set 由编译器自带，不用导入（迭代序＝插入序）。
import { pathJoin, pathBase, pathExt } from "std/path";
import { jsonParse, jsonStringify } from "std/json";

function main(args: []string): int {
    // std/path：纯函数，同入参恒同出参
    print(pathJoin("docs", "tutorial"));
    print(pathBase("a/b/c.tx") + " ext=" + pathExt("a/b/c.tx"));

    // Map<K, V>：编译器自带的泛型容器；方法写法 m.set(k, v) ≡ mapSet(m, k, v)
    const m: Map<string, int> = mapNew();
    m.set("tai", 30);
    mapSet(m, "xu", 20);
    print("has-tai:" + toStr(mapHas(m, "tai")) + " len:" + toStr(m.len()));
    for (k, v in m) {
        print(k + "=" + toStr(v)); // 插入序
    }
    print("miss=" + toStr(m.get("none") catch -1)); // 查无此键得 None

    // std/json：解析可能失败，走 T | Error 通道
    const j = jsonParse("{\"name\":\"太虚\",\"tags\":[1,2]}") catch (e) {
        print("bad json: " + e.message);
        return 1;
    };
    print(jsonStringify(j));
    return 0;
}
