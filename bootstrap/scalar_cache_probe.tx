// Generate paired real products through the shared frontend and portable ISA macros.
import { drvSetPrelude, drvSetKernel, drvSetPortable, drvSetLeakCheck, drvNativeRuntime, drvBytesOut, drvDiagOut } from "./selfhost/driver";
import { recordSetScalarCache } from "./selfhost/emit_record";
import { hostTargetId, targetFlagHost } from "./selfhost/target_host";
import { sha256Hex } from "./selfhost/sha256";

function kernel(t: int): Bytes {
    if (t == 0) { return embedBytes("nrt-kernel/kernel-x86_64-windows-heapcheck.obj"); }
    if (t == 1) { return embedBytes("nrt-kernel/kernel-x86_64-linux-heapcheck.o"); }
    if (t == 2) { return embedBytes("nrt-kernel/kernel-x86_64-macos-heapcheck.o"); }
    if (t == 3) { return embedBytes("nrt-kernel/kernel-aarch64-macos-heapcheck.o"); }
    if (t == 4) { return embedBytes("nrt-kernel/kernel-aarch64-linux-heapcheck.o"); }
    if (t == 5) { return embedBytes("nrt-kernel/kernel-loongarch64-linux-heapcheck.o"); }
    if (t == 6) { return embedBytes("nrt-kernel/kernel-riscv64-linux-heapcheck.o"); }
    return embedBytes("nrt-kernel/kernel-aarch64-windows-heapcheck.o");
}
export function main(args: []string): int {
    if (len(args) < 3) { return 64; }
    let t = hostTargetId(); if (len(args) > 3) { t = targetFlagHost(args[3]); }
    if (t < 0 || t > 7) { return 64; }
    drvSetPrelude(bytesToStr(embedBytes("../prelude/collections.tx")) catch panic("prelude"));
    drvSetPortable(!(len(args) > 4 && args[4] == "native")); drvSetKernel(kernel(t)); drvSetLeakCheck(true);
    const paths: List<string> = listNew(); recordSetScalarCache(false);
    if (drvNativeRuntime(args[0], 1, paths, t) != 0) { eprint(drvDiagOut()); return 1; }
    const original = drvBytesOut();
    writeFileBytes(args[1], original) catch (e) { eprint(e.message); return 1; };
    recordSetScalarCache(true);
    const rc = drvNativeRuntime(args[0], 1, paths, t); recordSetScalarCache(false);
    if (rc != 0) { eprint(drvDiagOut()); return 1; }
    const cached = drvBytesOut();
    writeFileBytes(args[2], cached) catch (e) { eprint(e.message); return 1; };
    print("OFF " + sha256Hex(original) + " " + toStr(bytesLen(original)));
    print("ON " + sha256Hex(cached) + " " + toStr(bytesLen(cached)));
    return 0;
}
