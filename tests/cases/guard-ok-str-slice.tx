// D3 v0.52 §7：整数位置与长度一律按字节——strSlice(s, from, to) 取字节区间 [from, to)，strFind 得字节
// 下标（可直接交给 strSlice）；按码点的切片与查找在 std/utf8（slice、find）。期望值由 Python 独立算出。
import { slice, find, count } from "std/utf8";

export function main(args: []string): int {
    const s = "ab太虚😀c";
    print(toStr(len(s)) + " " + toStr(count(s)));
    print(strSlice(s, 0, 2) + "|" + strSlice(s, 2, 5) + "|" + strSlice(s, 8, 12) + "|" + strSlice(s, 12, 13));
    print("[" + strSlice(s, 0, 0) + "][" + strSlice(s, 13, 13) + "][" + strSlice("", 0, 0) + "]");
    print(toStr(strSlice(s, 0, len(s)) == s));
    print(toStr(strFind(s, "虚")) + " " + toStr(strFind(s, "😀")) + " " + toStr(strFind(s, "c")) + " " + toStr(strFind(s, "x")) + " " + toStr(strFind(s, "")) + " " + toStr(strFind("", "a")));
    const at = strFind(s, "虚");
    print(strSlice(s, at, len(s)));
    print(slice(s, 2, 4) + " " + toStr(find(s, "😀")) + " " + toStr(find(s, "c")));
    print(strSlice(s, strFind(s, "😀"), strFind(s, "c")) + " " + slice(s, find(s, "😀"), find(s, "c")));
    return 0;
}
