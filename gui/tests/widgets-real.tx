// widgets-real —— T0 组件级真实文本轨用例（前置项）。
// gui/text 的 realPainter 接入画布（引用才拉栈形态的本侧消费）——FreeType
// 同版本同字体同输入 → 同像素；**golden 伴字体文件锚定**（tests/font/
// text-font.ttf——文本 golden 先例，sha256 f37ecd80…）。度量/折行走
// txp_text_measure 推进（paintTextWidth 双轨单点）。纯无头面。
import { Canvas, canvasWithPainter, wrapText, drawMultiline, paintText, paintTextWidth } from "gui/components";
import { FontBundle, fontLoad, realPainter } from "gui/text";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256, surfaceProject } from "gui/surface";

export function main(args: []string): int {
    args;
    // 候选路径：aot-e2e cwd=tests/；verify 手跑 cwd=仓根——都命中。
    const cands: List<string> = listNew();
    listPush(cands, "font/text-font.ttf");
    listPush(cands, "tests/font/text-font.ttf");
    const fb: Ref<FontBundle> = fontLoad(cands) catch (e) {
        print("font load failed: " + e.message);
        return 1;
    };
    const s = surfaceOpen(220, 90) catch (e) {
        print("surface open failed: " + e.message);
        return 1;
    };
    surfaceClear(s, 0x202040);
    // size 16——核心仓 text-extern 同款已验证像素尺寸（size 14 触发 vendored
    // FreeType 字节码解释器缺陷 TT_RunIns，登记 vendor 件不扩面）。
    const cv = canvasWithPainter(s, 220, 90, realPainter(fb.handle, 16));
    paintText(cv, 8, 10, 0xFFFFFF, "taixu real text");
    const w1: int = paintTextWidth(cv, "taixu real text");
    print("w=" + toStr(w1));
    // 折行走真实轨度量（贪心逐字符断行）。
    const h: int = drawMultiline(cv, 8, 34, 150, 16, "the quick brown fox jumps over", 0xE0E0E0);
    print("ml_h=" + toStr(h));
    const lines: List<string> = wrapText(cv, "wrap by measured widths", 90);
    print("wrap_n=" + toStr(listLen(lines)));
    // 空串/宽度单点。
    print("w_empty=" + toStr(paintTextWidth(cv, "")));
    print("sha256=" + surfaceSha256(s));
    print(surfaceProject(s));
    surfaceClose(s);
    return 0;
}
