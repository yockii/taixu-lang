// Producer-declared functions and instruction-completion frame facts. No ISA guessing: the producer names the ISA
// (x86_64 or aarch64) and register numbers are that ISA's GPR numbers (aarch64 sp is 31).
export struct NativeFunctionSource { id: int, module: string, name: string }
export struct NativeFrameEvent { before: int, after: int, kind: string, reg: int, bytes: int }
export struct NativeEpilogue { begin: int, end: int }
export struct NativeFunction {
    id: int, module: string, name: string, linkName: string, origin: string, stackModel: string,
    begin: int, end: int, prologueEnd: int, epilogues: List<Ref<NativeEpilogue>>,
    events: List<Ref<NativeFrameEvent>>,
}
export struct NativeFunctionImage { ok: bool, error: string, isa: string, functions: List<Ref<NativeFunction>> }
let enabled: bool = false;
let isa: string = "x86_64";
let sources: List<Ref<NativeFunctionSource>> = listNew();
let rows: List<Ref<NativeFunction>> = listNew();
let current: int = -1;
let emittedSources: int = 0;
let failure: string = "";
// 产物函数符号（v052-image-symbols）：与帧事实收集无关、每次构建都记的名字与范围。驱动汇编程序前 nativeSymbolsBegin（程序函数
// id → 可读名），链接前 nativeSymbolsTake。
export struct NativeSymbol { name: string, link: string, begin: int, end: int }
let symbolsOn: bool = false;
let symbolNames: List<string> = listNew();
let symbolRows: List<Ref<NativeSymbol>> = listNew();
export function nativeSymbolsBegin(names: List<string>): void { symbolsOn = true; symbolNames = names; symbolRows = listNew(); }
export function nativeSymbolsTake(): List<Ref<NativeSymbol>> { symbolsOn = false; const rows = symbolRows; symbolRows = listNew(); return rows; }
function symbolBegin(name: string, link: string, at: int): void { if (symbolsOn) { listPush(symbolRows, new NativeSymbol { name: name, link: link, begin: at, end: -1 }); } }
function symbolEnd(at: int): void {
    if (!symbolsOn || listLen(symbolRows) == 0) { return; }
    const last = listGet(symbolRows, listLen(symbolRows) - 1) catch new NativeSymbol { name: "", link: "", begin: 0, end: 0 };
    if (last.end < 0) { last.end = at; }
}
function missingFn(): Ref<NativeFunction> {
    return new NativeFunction { id: -1, module: "", name: "", linkName: "", origin: "", stackModel: "fixed-call", begin: 0, end: -1,
        prologueEnd: -1, epilogues: listNew(), events: listNew() };
}
function fail(message: string): void { if (len(failure) == 0) { failure = message; } }
export function nativeFunctionsActive(): bool { return enabled; }
export function nativeFunctionsReset(): void { sources = listNew(); rows = listNew(); current = -1; emittedSources = 0; failure = ""; isa = "x86_64"; }
/// The A64 assembler declares its ISA before replaying a buffer; one collection never mixes ISAs.
export function nativeFunctionsIsa(name: string): void {
    if (!enabled || len(failure) > 0 || name == isa) { return; }
    if (listLen(rows) > 0 || (name != "x86_64" && name != "aarch64")) { fail("MixedFunctionIsa"); return; } isa = name;
}
export function nativeFunctionsEnable(on: bool): void { enabled = on; nativeFunctionsReset(); }
export function nativeFunctionSource(id: int, module: string, name: string): void {
    if (!enabled || len(failure) > 0) { return; }
    if (id != listLen(sources) || current >= 0 || listLen(rows) > 0) { fail("BadFunctionSourceOrder"); return; }
    listPush(sources, new NativeFunctionSource { id: id, module: module, name: name });
}
export function nativeFunctionBegin(id: int, symbol: string, at: int): void {
    symbolBegin(listGet(symbolNames, id) catch symbol, symbol, at);
    if (!enabled || len(failure) > 0) { return; }
    if (current >= 0 || id != emittedSources || id != listLen(rows) || id >= listLen(sources) || at < 0 || symbol != "f_" + toStr(id)) { fail("BadFunctionBegin"); return; }
    if (id > 0 && at < (listGet(rows, id - 1) catch missingFn()).end) { fail("OverlappingFunctions"); return; }
    const src = listGet(sources, id) catch new NativeFunctionSource { id: -1, module: "", name: "" };
    const f = missingFn(); f.id = id; f.module = src.module; f.name = src.name; f.linkName = symbol; f.begin = at; f.origin = "tx-generated";
    listPush(rows, f); current = id; emittedSources = emittedSources + 1;
}
export function nativeFunctionOwnedBegin(module: string, name: string, origin: string, at: int): void {
    symbolBegin(name, name, at); ownedBegin(module, name, origin, at);
}
function ownedBegin(module: string, name: string, origin: string, at: int): void {
    if (!enabled || len(failure) > 0) { return; }
    if (current >= 0 || emittedSources != listLen(sources) || at < 0 || len(module) == 0 || len(name) == 0) { fail("BadOwnedFunctionBegin"); return; }
    if (listLen(rows) > 0 && at < (listGet(rows, listLen(rows) - 1) catch missingFn()).end) { fail("OverlappingFunctions"); return; }
    const f = missingFn(); f.id = listLen(rows); f.module = module; f.name = name; f.linkName = name; f.origin = origin; f.begin = at;
    listPush(rows, f); current = f.id;
}
function activeFn(): Ref<NativeFunction> {
    if (current < 0) { fail("FrameOutsideFunction"); return missingFn(); }
    return listGet(rows, current) catch missingFn();
}
// Boundaries declare a range and a stop condition, without inventing a frame recipe.
export function nativeFunctionBoundaryBegin(module: string, name: string, model: string, at: int): void {
    symbolBegin(name, name, at);
    if (!enabled || len(failure) > 0) { return; }
    ownedBegin(module, name, "process-thread-entry", at);
    if (len(failure) > 0) { return; }
    const f = activeFn(); f.stackModel = model; f.prologueEnd = at;
}
export function nativeFunctionEvent(before: int, after: int, kind: string, reg: int, bytes: int): void {
    if (!enabled || len(failure) > 0) { return; }
    const f = activeFn(); if (len(failure) > 0) { return; }
    if (before < f.begin || after <= before || bytes < 0) { fail("BadFrameInstructionRange"); return; }
    if (listLen(f.events) > 0) {
        const prev = listGet(f.events, listLen(f.events) - 1) catch new NativeFrameEvent { before: -1, after: -1, kind: "", reg: -1, bytes: 0 };
        if (before < prev.after && !(before == prev.before && after == prev.after)) { fail("OverlappingFrameInstructions"); return; }
    }
    listPush(f.events, new NativeFrameEvent { before: before, after: after, kind: kind, reg: reg, bytes: bytes });
    if (kind == "return" && listLen(f.epilogues) > 0) {
        const ep = listGet(f.epilogues, listLen(f.epilogues) - 1) catch new NativeEpilogue { begin: -1, end: -1 };
        if (ep.end >= 0) { fail("ReturnAfterEpilogue"); return; } ep.end = after;
    }
}
export function nativeFunctionPrologueEnd(at: int): void {
    if (!enabled || len(failure) > 0) { return; } const f = activeFn();
    if (f.prologueEnd >= 0 || at < f.begin) { fail("BadPrologueEnd"); return; } f.prologueEnd = at;
}
export function nativeFunctionEpilogueStart(at: int): void {
    if (!enabled || len(failure) > 0) { return; } const f = activeFn();
    if (f.prologueEnd < 0 || at < f.prologueEnd) { fail("BadEpilogueStart"); return; }
    if (listLen(f.epilogues) > 0) {
        const prev = listGet(f.epilogues, listLen(f.epilogues) - 1) catch new NativeEpilogue { begin: -1, end: -1 };
        if (prev.end < 0 || at < prev.end) { fail("OverlappingEpilogues"); return; }
    }
    listPush(f.epilogues, new NativeEpilogue { begin: at, end: -1 });
}
function nonvolatile(a64: bool, reg: int): bool {
    if (a64) { return reg >= 19 && reg <= 30; } return reg == 3 || reg == 5 || reg == 6 || reg == 7 || (reg >= 12 && reg <= 15);
}
export function nativeFrameDelta(e: Ref<NativeFrameEvent>): int {
    if (e.kind == "push-nonvolatile" || e.kind == "allocate-stack") { return -e.bytes; }
    if (e.kind == "pop-nonvolatile" || e.kind == "release-stack" || e.kind == "return") { return e.bytes; } return 0;
}
export function nativeFunctionValidate(f: Ref<NativeFunction>, arch: string): string {
    if (arch != "x86_64" && arch != "aarch64") { return "UnknownFunctionIsa"; }
    if (f.id < 0 || f.begin < 0 || f.end <= f.begin || f.prologueEnd < f.begin || f.prologueEnd > f.end || len(f.module) == 0 || len(f.name) == 0 || len(f.linkName) == 0) { return "BadFunctionRange"; }
    if (f.stackModel != "fixed-call") {
        if (f.stackModel != "process-entry" && f.stackModel != "thread-entry" && f.stackModel != "stack-transition" && f.stackModel != "stack-disposal") { return "UnknownStackModel"; }
        if (f.origin != "process-thread-entry" || f.prologueEnd != f.begin || listLen(f.epilogues) != 0 || listLen(f.events) != 0) { return "BadBoundaryFrame"; }
        return "";
    }
    const tx = f.origin == "tx-generated";
    const shell = f.origin == "ffi-callback-shell";
    if (!tx && !shell && f.origin != "runtime-rtfn" && f.origin != "ffi-rtfn" && f.origin != "debug-rtfn" && f.origin != "tool-rtfn") { return "UnknownFunctionOrigin"; }
    if (tx && (listLen(f.epilogues) != 1 || f.linkName != "f_" + toStr(f.id))) { return "BadTxFunctionShape"; }
    let lastEnd = f.prologueEnd;
    for (ep in f.epilogues) {
        if (ep.begin < lastEnd || ep.end <= ep.begin || ep.end > f.end) { return "BadEpilogueRange"; } lastEnd = ep.end;
    }
    if (tx && lastEnd != f.end) { return "BadTxFunctionEnd"; }
    // A64: sp is 31, x29 the frame pointer, ret leaves sp unchanged; an instruction may carry several events
    // (stp/ldp) with the same range, and the stack stays 16-byte aligned between instructions.
    const a64 = arch == "aarch64"; let sp = 4; let fp = 5; let returnBytes = 8;
    if (a64) { sp = 31; fp = 29; returnBytes = 0; }
    const proSaves: List<int> = listNew(); const proSizes: List<int> = listNew(); let mask = 0; let proDebt = 0; let allocation = -1; let framePointer = false;
    let last = f.begin; let lastBefore = -1; let proLast = f.begin;
    let epIndex = -1; let epEnd = -1; let debt = 0; let released = false; let returned = false; let saveIndex = -1;
    for (e in f.events) {
        const again = a64 && lastBefore >= 0 && e.before == lastBefore && e.after == last;
        if ((e.before < last && !again) || e.after <= e.before || e.after > f.end || e.bytes < 0) { return "BadFrameEventRange"; }
        const pro = e.before < f.prologueEnd;
        if (pro) {
            if ((e.before != last && !again) || e.after > f.prologueEnd || epIndex >= 0) { return "BadPrologueEventRange"; }
            if (a64 && !again && proDebt % 16 != 0) { return "MisalignedFrame"; }
            proLast = e.after;
        } else {
            if (epIndex < 0 || e.before >= epEnd) {
                if (epIndex >= 0 && !returned) { return "IncompleteEpilogue"; }
                if (a64 && proDebt % 16 != 0) { return "MisalignedFrame"; }
                epIndex = epIndex + 1;
                if (epIndex >= listLen(f.epilogues)) { return "FrameOutsideEpilogue"; }
                const ep = listGet(f.epilogues, epIndex) catch new NativeEpilogue { begin: -1, end: -1 };
                last = ep.begin; epEnd = ep.end; debt = proDebt; saveIndex = listLen(proSaves) - 1; released = false; returned = false;
            }
            if (returned || (e.before != last && !again) || e.after > epEnd) { return "BadEpilogueEventRange"; }
            if (a64 && !again && debt % 16 != 0) { return "MisalignedFrame"; }
        }
        lastBefore = e.before; last = e.after;
        if (e.kind == "push-nonvolatile") {
            if (!pro || (!tx && !shell && !a64) || !nonvolatile(a64, e.reg) || (e.bytes != 8 && (!a64 || e.bytes != 16)) || (mask & (1 << e.reg)) != 0 || allocation >= 0) { return "BadFramePush"; }
            listPush(proSaves, e.reg); listPush(proSizes, e.bytes); mask = mask | (1 << e.reg); proDebt = proDebt + e.bytes;
        } else if (e.kind == "set-frame-pointer") {
            if (!pro || (!tx && !a64) || e.reg != fp || e.bytes != 0 || framePointer || (mask & (1 << fp)) == 0 || allocation >= 0) { return "BadFramePointer"; }
            // A64: x29 must address the frame record just pushed, x29 at [sp] and x30 above it.
            const n = listLen(proSaves);
            if (a64 && (n < 2 || (listGet(proSaves, n - 1) catch -1) != 29 || (listGet(proSaves, n - 2) catch -1) != 30
                    || (listGet(proSizes, n - 1) catch -1) != 8 || (listGet(proSizes, n - 2) catch -1) != 8)) { return "BadFramePointer"; }
            framePointer = true;
        } else if (e.kind == "allocate-stack") {
            const step = (a64 && e.bytes % 16 != 0) || (!a64 && (allocation >= 0 || e.bytes % 8 != 0));
            if (!pro || e.reg != sp || step || e.bytes > 9223372036854775807 - proDebt) { return "BadFrameAllocation"; }
            if (allocation < 0) { allocation = 0; } allocation = allocation + e.bytes; proDebt = proDebt + e.bytes;
        } else if (e.kind == "release-stack") {
            if (pro || e.reg != sp || released || allocation < 0 || e.bytes != allocation || e.bytes > debt) { return "BadFrameRelease"; }
            released = true; debt = debt - e.bytes;
        } else if (e.kind == "pop-nonvolatile") {
            if (pro || saveIndex < 0 || e.reg != (listGet(proSaves, saveIndex) catch -1) || e.bytes != (listGet(proSizes, saveIndex) catch -1) || (allocation >= 0 && !released)) { return "BadFramePop"; }
            saveIndex = saveIndex - 1; debt = debt - e.bytes;
        } else if (e.kind == "return") {
            if (pro || e.after != epEnd || e.reg != -1 || e.bytes != returnBytes || debt != 0 || saveIndex >= 0 || (allocation >= 0 && !released)) { return "BadFrameReturn"; } returned = true;
        } else { return "UnknownFrameEvent"; }
    }
    if (proLast != f.prologueEnd || epIndex + 1 != listLen(f.epilogues) || (epIndex >= 0 && !returned)) { return "IncompleteFrameEvents"; }
    if (a64 && proDebt % 16 != 0) { return "MisalignedFrame"; }
    if (!tx && !a64 && allocation < 0) { return "MissingRtfnAllocation"; }
    return "";
}
export function nativeFunctionEnd(at: int): void {
    symbolEnd(at);
    if (!enabled || len(failure) > 0) { return; } const f = activeFn(); if (len(failure) > 0) { return; }
    f.end = at; const problem = nativeFunctionValidate(f, isa); if (len(problem) > 0) { fail(problem); return; } current = -1;
}
export function nativeFunctionsSnapshot(): Ref<NativeFunctionImage> {
    const out = new NativeFunctionImage { ok: false, error: failure, isa: isa, functions: listNew() };
    if (!enabled) { out.error = "FunctionCollectionDisabled"; return out; }
    if (len(failure) > 0) { return out; }
    if (current >= 0 || emittedSources != listLen(sources)) { out.error = "IncompleteFunctions"; return out; }
    for (f in rows) {
        listPush(out.functions, nativeFunctionCopy(f));
    }
    out.ok = true; return out;
}
export function nativeFunctionCopy(f: Ref<NativeFunction>): Ref<NativeFunction> {
    const copy = new NativeFunction { id: f.id, module: f.module, name: f.name, linkName: f.linkName, origin: f.origin, stackModel: f.stackModel,
        begin: f.begin, end: f.end, prologueEnd: f.prologueEnd, epilogues: listNew(), events: listNew() };
    for (ep in f.epilogues) { listPush(copy.epilogues, new NativeEpilogue { begin: ep.begin, end: ep.end }); }
    for (e in f.events) { listPush(copy.events, new NativeFrameEvent { before: e.before, after: e.after, kind: e.kind, reg: e.reg, bytes: e.bytes }); }
    return copy;
}
