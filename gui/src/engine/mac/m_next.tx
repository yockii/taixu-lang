// ============================================================================
// engine/mac/m_next —— objc_msgSend：-[NSApplication nextEventMatchingMask:untilDate:inMode:dequeue:]。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, mask: u64, until: usize, mode: usize, dequeue: u8): usize from "/usr/lib/libobjc.A.dylib";

export function msgNextEvent(app: usize, until: usize, mode: usize): usize {
    return objc_msgSend(app, sel_registerName("nextEventMatchingMask:untilDate:inMode:dequeue:"), 0xFFFFFFFFFFFFFFFF, until, mode, 1);
}
