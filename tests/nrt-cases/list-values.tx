// D3 v0.20：List 元素放开到 struct/enum/定长数组（值语义）——listPush/listSet/listInsert 存入拷贝，
// listGet 取出拷贝，listPop/listRemoveAt 移交；要在表内原地改用 Ref<T>。
struct Point { x: int, y: int }
enum Shape { Dot, Box(w: int, h: int) }

function area(s: Shape): int {
    return switch (s) {
        case Dot => 0,
        case Box(w, h) => w * h,
    };
}

function main(args: []string): int {
    const ps: List< Point> = listNew();
    let p = Point { x: 1, y: 2 };
    listPush(ps, p);
    p.x = 100;
    listPush(ps, p);
    let q = listGet(ps, 0) catch Point { x: 0, y: 0 };
    q.y = 50;
    print(toStr((listGet(ps, 0) catch q).y) + " " + toStr((listGet(ps, 1) catch q).x));
    listSet(ps, 0, Point { x: 7, y: 8 });
    listInsert(ps, 0, Point { x: 3, y: 4 });
    for (pt in ps) { print(toStr(pt.x) + "," + toStr(pt.y)); }
    const last = listPop(ps) catch q;
    print(toStr(last.x) + " " + toStr(listLen(ps)));

    const shapes: List< Shape> = listNew();
    listPush(shapes, Shape.Dot);
    listPush(shapes, Shape.Box(2, 3));
    let total: int = 0;
    for (s in shapes) { total = total + area(s); }
    print(toStr(total));

    const rows: List< [3]int> = listNew();
    let r: [3]int = [1, 2, 3];
    listPush(rows, r);
    r[0] = 9;
    listPush(rows, r);
    print(toStr((listGet(rows, 0) catch r)[0]) + " " + toStr((listGet(rows, 1) catch r)[0]));

    const refs: List< Ref< Point>> = listNew();
    listPush(refs, new Point { x: 1, y: 1 });
    const rp = listGet(refs, 0) catch new Point { x: 0, y: 0 };
    rp.x = 42;
    print(toStr((listGet(refs, 0) catch rp).x));
    return 0;
}
