// ============================================================================
// std/compress —— DEFLATE/zlib/gzip（V0.40-S1；STD-11；D88"仅 BMP"之墙）。
// 纯 .tx，零宿主 extern（确定性红线——向量锚逐位，tests/compress-fx.tx）。
//
// 解压全量（RFC 1951 §3.2 inflate：stored＋fixed Huffman＋dynamic Huffman
// 三形态；RFC 1950 §2 zlib 包装＋adler32；RFC 1952 §2 gzip 包装＋CRC32＋
// ISIZE）。压缩面＝stored 块写入器（roundtrip 正确、压缩比 1.0；真实
// Huffman 压缩编码器**登记评估位不实施**——README 如实注记；写入器输出
// 与 Python zlib level-0 stored 布局对单块载荷逐字节一致——向量文件
// tests/vectors/ 下 zlib_store0/gzip_store 行）。
//
// 字节域容器＝List<int>（元素 0..255）：语言面 string 恒良构 UTF-8（D3 §一），
// 任意二进制不经 string——bytes.tx 头注同源。解压输出上限 64 MiB
//（解压炸弹结构化拒绝）。实现取 puff.c（Mark Adler，公有领域）的
// 规范解码结构：counts/symbols 规范码构造＋逐位解码；oversubscribed 拒绝、
// incomplete 仅在"单长 1 码"形态容忍（lencode/dencode 同 puff 判据）。
// ============================================================================

const MAXBITS: int = 15;
const MAX_OUT: int = 67108864; // 64 MiB 解压输出上限

// —— 长度/距离表（RFC 1951 §3.2.5 官方字面表） ——

function lbase(): List<int> {
    const t: List<int> = listNew();
    listPush(t, 3);
    listPush(t, 4);
    listPush(t, 5);
    listPush(t, 6);
    listPush(t, 7);
    listPush(t, 8);
    listPush(t, 9);
    listPush(t, 10);
    listPush(t, 11);
    listPush(t, 13);
    listPush(t, 15);
    listPush(t, 17);
    listPush(t, 19);
    listPush(t, 23);
    listPush(t, 27);
    listPush(t, 31);
    listPush(t, 35);
    listPush(t, 43);
    listPush(t, 51);
    listPush(t, 59);
    listPush(t, 67);
    listPush(t, 83);
    listPush(t, 99);
    listPush(t, 115);
    listPush(t, 131);
    listPush(t, 163);
    listPush(t, 195);
    listPush(t, 227);
    listPush(t, 258);
    return t;
}

function lext(): List<int> {
    const t: List<int> = listNew();
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 1);
    listPush(t, 1);
    listPush(t, 1);
    listPush(t, 1);
    listPush(t, 2);
    listPush(t, 2);
    listPush(t, 2);
    listPush(t, 2);
    listPush(t, 3);
    listPush(t, 3);
    listPush(t, 3);
    listPush(t, 3);
    listPush(t, 4);
    listPush(t, 4);
    listPush(t, 4);
    listPush(t, 4);
    listPush(t, 5);
    listPush(t, 5);
    listPush(t, 5);
    listPush(t, 5);
    listPush(t, 0);
    return t;
}

function dbase(): List<int> {
    const t: List<int> = listNew();
    listPush(t, 1);
    listPush(t, 2);
    listPush(t, 3);
    listPush(t, 4);
    listPush(t, 5);
    listPush(t, 7);
    listPush(t, 9);
    listPush(t, 13);
    listPush(t, 17);
    listPush(t, 25);
    listPush(t, 33);
    listPush(t, 49);
    listPush(t, 65);
    listPush(t, 97);
    listPush(t, 129);
    listPush(t, 193);
    listPush(t, 257);
    listPush(t, 385);
    listPush(t, 513);
    listPush(t, 769);
    listPush(t, 1025);
    listPush(t, 1537);
    listPush(t, 2049);
    listPush(t, 3073);
    listPush(t, 4097);
    listPush(t, 6145);
    listPush(t, 8193);
    listPush(t, 12289);
    listPush(t, 16385);
    listPush(t, 24577);
    return t;
}

function dext(): List<int> {
    const t: List<int> = listNew();
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 0);
    listPush(t, 1);
    listPush(t, 1);
    listPush(t, 2);
    listPush(t, 2);
    listPush(t, 3);
    listPush(t, 3);
    listPush(t, 4);
    listPush(t, 4);
    listPush(t, 5);
    listPush(t, 5);
    listPush(t, 6);
    listPush(t, 6);
    listPush(t, 7);
    listPush(t, 7);
    listPush(t, 8);
    listPush(t, 8);
    listPush(t, 9);
    listPush(t, 9);
    listPush(t, 10);
    listPush(t, 10);
    listPush(t, 11);
    listPush(t, 11);
    listPush(t, 12);
    listPush(t, 12);
    listPush(t, 13);
    listPush(t, 13);
    return t;
}

// —— 位读取器（LSB-first；不足 need 位返回 -1＝流终）——

struct BitR {
    data: List<int>,
    pos: int,
    bitbuf: int,
    bitcnt: int,
}

function newBitR(data: List<int>): Ref<BitR> {
    return new BitR { data: data, pos: 0, bitbuf: 0, bitcnt: 0 };
}

function bits(br: Ref<BitR>, need: int): int {
    while (br.bitcnt < need) {
        if (br.pos >= listLen(br.data)) {
            return -1;
        }
        br.bitbuf = br.bitbuf | ((listGet(br.data, br.pos) catch 0) << br.bitcnt);
        br.pos = br.pos + 1;
        br.bitcnt = br.bitcnt + 8;
    }
    const v: int = br.bitbuf & ((1 << need) - 1);
    br.bitbuf = br.bitbuf >>> need;
    br.bitcnt = br.bitcnt - need;
    return v;
}

// —— 规范 Huffman（counts/symbols；puff construct 同构） ——

struct Huff {
    counts: List<int>,
    symbols: List<int>,
}

function newHuff(): Ref<Huff> {
    const counts: List<int> = listNew();
    let i: int = 0;
    while (i <= MAXBITS) {
        listPush(counts, 0);
        i = i + 1;
    }
    return new Huff { counts: counts, symbols: listNew() };
}

// 构造规范码：返回 0＝完全、>0＝不完全（剩余码空间）、<0＝过订阅。
function huffBuild(h: Ref<Huff>, lengths: List<int>, n: int): int {
    let i: int = 0;
    while (i <= MAXBITS) {
        listSet(h.counts, i, 0);
        i = i + 1;
    }
    i = 0;
    while (i < n) {
        const l: int = listGet(lengths, i) catch 0;
        if (l < 0 || l > MAXBITS) {
            return -10;
        }
        listSet(h.counts, l, (listGet(h.counts, l) catch 0) + 1);
        i = i + 1;
    }
    if ((listGet(h.counts, 0) catch 0) == n) {
        return 0; // 全零：完全（但解码必失败——调用面不会用到）
    }
    let left: int = 1;
    let k: int = 1;
    while (k <= MAXBITS) {
        left = left << 1;
        left = left - (listGet(h.counts, k) catch 0);
        if (left < 0) {
            return left;
        }
        k = k + 1;
    }
    // 规范序填充：按（码长升序、符号升序）——offs 索引填充的等价直排形。
    let len2: int = 1;
    while (len2 <= MAXBITS) {
        let s: int = 0;
        while (s < n) {
            if ((listGet(lengths, s) catch 0) == len2) {
                listPush(h.symbols, s);
            }
            s = s + 1;
        }
        len2 = len2 + 1;
    }
    return left;
}

// 逐位解码单符号；-1＝流终/坏码。
function huffDecode(br: Ref<BitR>, h: Ref<Huff>): int {
    let code: int = 0;
    let first: int = 0;
    let index: int = 0;
    let len: int = 1;
    while (len <= MAXBITS) {
        const b: int = bits(br, 1);
        if (b < 0) {
            return -1;
        }
        code = code | b;
        const count: int = listGet(h.counts, len) catch 0;
        if (code - first < count) {
            return listGet(h.symbols, index + code - first) catch -1;
        }
        index = index + count;
        first = (first + count) << 1;
        code = code << 1;
        len = len + 1;
    }
    return -1;
}

// fixed Huffman 表（RFC 1951 §3.2.6 固定码长）。
function fixedLitlen(): Ref<Huff> {
    const h: Ref<Huff> = newHuff();
    const lengths: List<int> = listNew();
    let i: int = 0;
    while (i < 144) {
        listPush(lengths, 8);
        i = i + 1;
    }
    while (i < 256) {
        listPush(lengths, 9);
        i = i + 1;
    }
    while (i < 280) {
        listPush(lengths, 7);
        i = i + 1;
    }
    while (i < 288) {
        listPush(lengths, 8);
        i = i + 1;
    }
    const r: int = huffBuild(h, lengths, 288);
    if (r != 0) {
        panic("compress: fixed litlen 表构造失败");
    }
    return h;
}

function fixedDist(): Ref<Huff> {
    const h: Ref<Huff> = newHuff();
    const lengths: List<int> = listNew();
    let i: int = 0;
    while (i < 30) {
        listPush(lengths, 5);
        i = i + 1;
    }
    // 固定距离码 30 码×5 位＝Kraft 30/32——**设计性不完全**（码 30/31 恒不
    // 出现；RFC 1951 §3.2.6——puff fixed() 同样容忍，不校验返回值）。
    const r: int = huffBuild(h, lengths, 30);
    if (r < 0) {
        panic("compress: fixed dist 表过订阅");
    }
    return h;
}

// Huffman 块解码（litlen＋dist 表；输出写入 out；返回 0 ok / -1 err）。
function decodeCodes(br: Ref<BitR>, litlen: Ref<Huff>, dist: Ref<Huff>,
    out: List<int>): int {
    const lb: List<int> = lbase();
    const lx: List<int> = lext();
    const db: List<int> = dbase();
    const dx: List<int> = dext();
    let running: bool = true;
    while (running) {
        const sym: int = huffDecode(br, litlen);
        if (sym < 0) {
            return -1;
        }
        if (sym < 256) {
            if (listLen(out) >= MAX_OUT) {
                return -1;
            }
            listPush(out, sym);
        } else if (sym == 256) {
            running = false;
        } else {
            const li: int = sym - 257;
            if (li >= 29) {
                return -1; // 286/287 无效长度码
            }
            const extraL: int = bits(br, listGet(lx, li) catch 0);
            if (extraL < 0) {
                return -1;
            }
            const length: int = (listGet(lb, li) catch 0) + extraL;
            const dsym: int = huffDecode(br, dist);
            if (dsym < 0 || dsym >= 30) {
                return -1; // 30/31 无效距离码
            }
            const extraD: int = bits(br, listGet(dx, dsym) catch 0);
            if (extraD < 0) {
                return -1;
            }
            const distance: int = (listGet(db, dsym) catch 0) + extraD;
            if (distance > listLen(out)) {
                return -1; // 回引越界
            }
            let i: int = 0;
            while (i < length) {
                if (listLen(out) >= MAX_OUT) {
                    return -1;
                }
                const from: int = listLen(out) - distance;
                listPush(out, listGet(out, from) catch 0);
                i = i + 1;
            }
        }
    }
    return 0;
}

// dynamic 表读入（RFC 1951 §3.2.7）；成功时经 outLit/outDist 返回表。
function readDynamicTables(br: Ref<BitR>, outLit: Ref<Huff>,
    outDist: Ref<Huff>): int {
    const hlit: int = bits(br, 5);
    if (hlit < 0) {
        return -1;
    }
    const nlen: int = hlit + 257;
    const hd: int = bits(br, 5);
    if (hd < 0) {
        return -1;
    }
    const ndist: int = hd + 1;
    const hc: int = bits(br, 4);
    if (hc < 0) {
        return -1;
    }
    const ncode: int = hc + 4;
    if (ncode > 19) {
        return -1;
    }
    const order: List<int> = codeOrder();
    const clens: List<int> = listNew();
    let i: int = 0;
    while (i < 19) {
        listPush(clens, 0);
        i = i + 1;
    }
    i = 0;
    while (i < ncode) {
        const v: int = bits(br, 3);
        if (v < 0) {
            return -1;
        }
        listSet(clens, listGet(order, i) catch 0, v);
        i = i + 1;
    }
    const clen: Ref<Huff> = newHuff();
    if (huffBuild(clen, clens, 19) != 0) {
        return -1; // 码长码须完全（puff 同判据）
    }
    const lengths: List<int> = listNew();
    i = 0;
    while (i < nlen + ndist) {
        const sym: int = huffDecode(br, clen);
        if (sym < 0) {
            return -1;
        }
        if (sym < 16) {
            listPush(lengths, sym);
            i = i + 1;
        } else if (sym == 16) {
            if (listLen(lengths) == 0) {
                return -1; // 无前码可重复
            }
            const r: int = bits(br, 2);
            if (r < 0) {
                return -1;
            }
            const prev: int = listGet(lengths, listLen(lengths) - 1) catch 0;
            let j: int = 0;
            while (j < r + 3) {
                listPush(lengths, prev);
                j = j + 1;
                i = i + 1;
            }
        } else {
            // 17＝零重复 3..10（3 位附加）；18＝零重复 11..138（7 位附加）。
            let rb: int = 7;
            let add: int = 11;
            if (sym == 17) {
                rb = 3;
                add = 3;
            }
            const r2: int = bits(br, rb);
            if (r2 < 0) {
                return -1;
            }
            let j: int = 0;
            while (j < r2 + add) {
                listPush(lengths, 0);
                j = j + 1;
                i = i + 1;
            }
        }
    }
    if (listLen(lengths) != nlen + ndist) {
        return -1; // 重复越界（i 超计数）
    }
    // litlen 表：incomplete 仅"全部长 1 码"容忍（puff 判据）。
    const litErr: int = huffBuild(outLit, lengths, nlen);
    if (litErr < 0) {
        return -1;
    }
    if (litErr > 0 && nlen != (listGet(outLit.counts, 0) catch 0) + (listGet(outLit.counts, 1) catch 0)) {
        return -1;
    }
    const distLengths: List<int> = tailFrom(lengths, nlen);
    const distErr: int = huffBuild(outDist, distLengths, ndist);
    if (distErr < 0) {
        return -1;
    }
    if (distErr > 0 && ndist != (listGet(outDist.counts, 0) catch 0) + (listGet(outDist.counts, 1) catch 0)) {
        return -1;
    }
    return 0;
}

function codeOrder(): List<int> {
    const t: List<int> = listNew();
    listPush(t, 16);
    listPush(t, 17);
    listPush(t, 18);
    listPush(t, 0);
    listPush(t, 8);
    listPush(t, 7);
    listPush(t, 9);
    listPush(t, 6);
    listPush(t, 10);
    listPush(t, 5);
    listPush(t, 11);
    listPush(t, 4);
    listPush(t, 12);
    listPush(t, 3);
    listPush(t, 13);
    listPush(t, 2);
    listPush(t, 14);
    listPush(t, 1);
    listPush(t, 15);
    return t;
}

function tailFrom(xs: List<int>, from: int): List<int> {
    const t: List<int> = listNew();
    let i: int = from;
    while (i < listLen(xs)) {
        listPush(t, listGet(xs, i) catch 0);
        i = i + 1;
    }
    return t;
}

// —— inflate 主循环（RFC 1951 §3.2.4 三块形态） ——

export function inflate(data: List<int>): List<int> | Error {
    const br: Ref<BitR> = newBitR(data);
    const out: List<int> = listNew();
    const litFixed: Ref<Huff> = fixedLitlen();
    const distFixed: Ref<Huff> = fixedDist();
    let final: int = 0;
    while (final != 1) {
        final = bits(br, 1);
        if (final < 0) {
            return err("compress: 流终截断");
        }
        const btype: int = bits(br, 2);
        if (btype == 0) {
            // stored：丢弃位缓冲余位，LEN/NLEN 逐字节校验后整块拷贝。
            br.bitbuf = 0;
            br.bitcnt = 0;
            if (br.pos + 4 > listLen(br.data)) {
                return err("compress: stored 头截断");
            }
            const l0: int = listGet(br.data, br.pos) catch 0;
            const l1: int = listGet(br.data, br.pos + 1) catch 0;
            const n0: int = listGet(br.data, br.pos + 2) catch 0;
            const n1: int = listGet(br.data, br.pos + 3) catch 0;
            br.pos = br.pos + 4;
            const blockLen: int = l0 | (l1 << 8);
            const nlen: int = n0 | (n1 << 8);
            if (blockLen != ((~nlen) & 0xFFFF)) {
                return err("compress: stored LEN/NLEN 不符");
            }
            if (br.pos + blockLen > listLen(br.data)) {
                return err("compress: stored 数据截断");
            }
            if (listLen(out) + blockLen > MAX_OUT) {
                return err("compress: 输出超上限");
            }
            let i: int = 0;
            while (i < blockLen) {
                listPush(out, listGet(br.data, br.pos + i) catch 0);
                i = i + 1;
            }
            br.pos = br.pos + blockLen;
        } else if (btype == 1) {
            const r: int = decodeCodes(br, litFixed, distFixed, out);
            if (r < 0) {
                return err("compress: fixed 块解码失败");
            }
        } else if (btype == 2) {
            const lit: Ref<Huff> = newHuff();
            const dist: Ref<Huff> = newHuff();
            if (readDynamicTables(br, lit, dist) != 0) {
                return err("compress: dynamic 表读入失败");
            }
            const r: int = decodeCodes(br, lit, dist, out);
            if (r < 0) {
                return err("compress: dynamic 块解码失败");
            }
        } else {
            return err("compress: 非法块形态 3");
        }
    }
    return out;
}

// —— 校验和（adler32 RFC 1950 §8；crc32 ISO 3309/ITU-T V.42）——

export function adler32(data: List<int>): int {
    let a: int = 1;
    let b: int = 0;
    for (d in data) {
        a = (a + d) % 65521;
        b = (b + a) % 65521;
    }
    return b * 65536 + a;
}

function crcTable(): List<int> {
    const t: List<int> = listNew();
    let n: int = 0;
    while (n < 256) {
        let c: int = n;
        let k: int = 0;
        while (k < 8) {
            if ((c & 1) == 1) {
                c = 3988292384 ^ (c >>> 1);
            } else {
                c = c >>> 1;
            }
            k = k + 1;
        }
        listPush(t, c);
        n = n + 1;
    }
    return t;
}

export function crc32(data: List<int>): int {
    const t: List<int> = crcTable();
    let c: int = 4294967295;
    for (d in data) {
        c = (listGet(t, (c ^ d) & 0xFF) catch 0) ^ (c >>> 8);
    }
    return (c ^ 4294967295) & 0xFFFFFFFF;
}

// —— zlib 包装（RFC 1950 §2；CMF/FLG 头＋adler32 尾）——

export function zlibDecompress(data: List<int>): List<int> | Error {
    if (listLen(data) < 6) {
        return err("zlib: 流过短");
    }
    const cmf: int = listGet(data, 0) catch 0;
    const flg: int = listGet(data, 1) catch 0;
    if ((cmf & 0x0F) != 8) {
        return err("zlib: 压缩方法非 deflate");
    }
    if ((cmf >>> 4) > 7) {
        return err("zlib: CINFO 越界");
    }
    if (((cmf * 256) + flg) % 31 != 0) {
        return err("zlib: 头校验不符");
    }
    if ((flg & 32) != 0) {
        return err("zlib: 预置字典不支持");
    }
    const body: List<int> = subList(data, 2, listLen(data) - 4);
    const out: List<int> = inflate(body)?;
    const want: int = ((listGet(data, listLen(data) - 4) catch 0) << 24)
    | ((listGet(data, listLen(data) - 3) catch 0) << 16)
    | ((listGet(data, listLen(data) - 2) catch 0) << 8)
    | (listGet(data, listLen(data) - 1) catch 0);
    if (adler32(out) != want) {
        return err("zlib: adler32 校验失败");
    }
    return out;
}

// —— gzip 包装（RFC 1952 §2；可选域 FEXTRA/FNAME/FCOMMENT/FHCRC 跳过）——

const GZIP_FEXTRA: int = 4;
const GZIP_FNAME: int = 8;
const GZIP_FCOMMENT: int = 16;
const GZIP_FHCRC: int = 2;
const GZIP_FRESERVED: int = 224;

export function gzipDecompress(data: List<int>): List<int> | Error {
    const n: int = listLen(data);
    if (n < 18) {
        return err("gzip: 流过短");
    }
    if ((listGet(data, 0) catch 0) != 0x1F || (listGet(data, 1) catch 0) != 0x8B) {
        return err("gzip: magic 不符");
    }
    if ((listGet(data, 2) catch 0) != 8) {
        return err("gzip: 压缩方法非 deflate");
    }
    const flg: int = listGet(data, 3) catch 0;
    if ((flg & GZIP_FRESERVED) != 0) {
        return err("gzip: 保留位置位");
    }
    let p: int = 10;
    if ((flg & GZIP_FEXTRA) != 0) {
        if (p + 2 > n) {
            return err("gzip: FEXTRA 截断");
        }
        const xlen: int = ((listGet(data, p) catch 0) | ((listGet(data, p + 1) catch 0) << 8));
        p = p + 2 + xlen;
        if (p > n) {
            return err("gzip: FEXTRA 截断");
        }
    }
    if ((flg & GZIP_FNAME) != 0) {
        while (p < n && (listGet(data, p) catch 1) != 0) {
            p = p + 1;
        }
        p = p + 1;
    }
    if ((flg & GZIP_FCOMMENT) != 0) {
        while (p < n && (listGet(data, p) catch 1) != 0) {
            p = p + 1;
        }
        p = p + 1;
    }
    if ((flg & GZIP_FHCRC) != 0) {
        p = p + 2;
    }
    if (p + 8 > n) {
        return err("gzip: 体/尾截断");
    }
    const body: List<int> = subList(data, p, n - 8);
    const out: List<int> = inflate(body)?;
    const wantCrc: int = ((listGet(data, n - 8) catch 0) | ((listGet(data, n - 7) catch 0) << 8)
        | ((listGet(data, n - 6) catch 0) << 16) | ((listGet(data, n - 5) catch 0) << 24))
    & 0xFFFFFFFF;
    if (crc32(out) != wantCrc) {
        return err("gzip: crc32 校验失败");
    }
    const wantSize: int = (listGet(data, n - 4) catch 0) | ((listGet(data, n - 3) catch 0) << 8)
    | ((listGet(data, n - 2) catch 0) << 16) | ((listGet(data, n - 1) catch 0) << 24);
    if ((listLen(out) & 0xFFFFFFFF) != (wantSize & 0xFFFFFFFF)) {
        return err("gzip: ISIZE 不符");
    }
    return out;
}

function subList(xs: List<int>, from: int, to: int): List<int> {
    const t: List<int> = listNew();
    let i: int = from;
    while (i < to && i < listLen(xs)) {
        listPush(t, listGet(xs, i) catch 0);
        i = i + 1;
    }
    return t;
}

// —— stored 块写入器（压缩面：roundtrip 正确；压缩比 1.0——真实
//     Huffman 压缩编码器登记评估位不实施）——

function storeBlocks(data: List<int>): List<int> {
    const out: List<int> = listNew();
    const n: int = listLen(data);
    let off: int = 0;
    if (n == 0) {
        // 空输入：单 final stored 空块（01 00 00 FF FF——zlib 同形）。
        listPush(out, 1);
        listPush(out, 0);
        listPush(out, 0);
        listPush(out, 255);
        listPush(out, 255);
        return out;
    }
    while (off < n) {
        const remain: int = n - off;
        let take: int = remain;
        if (take > 65535) {
            take = 65535;
        }
        let isLast: int = 0;
        if (off + take >= n) {
            isLast = 1;
        }
        listPush(out, isLast);
        listPush(out, take & 0xFF);
        listPush(out, (take >>> 8) & 0xFF);
        listPush(out, (~take) & 0xFF);
        listPush(out, ((~take) >>> 8) & 0xFF);
        let i: int = 0;
        while (i < take) {
            listPush(out, listGet(data, off + i) catch 0);
            i = i + 1;
        }
        off = off + take;
    }
    return out;
}

export function deflateStore(data: List<int>): List<int> {
    return storeBlocks(data);
}

export function zlibCompressStore(data: List<int>): List<int> {
    const out: List<int> = listNew();
    // CMF=0x78（deflate＋32K 窗）；FLG=0x01（FLEVEL=0 最快——头校验 0x7801%31==0）。
    listPush(out, 0x78);
    listPush(out, 0x01);
    appendAll(out, storeBlocks(data));
    const a: int = adler32(data);
    listPush(out, (a >>> 24) & 0xFF);
    listPush(out, (a >>> 16) & 0xFF);
    listPush(out, (a >>> 8) & 0xFF);
    listPush(out, a & 0xFF);
    return out;
}

export function gzipCompressStore(data: List<int>): List<int> {
    const out: List<int> = listNew();
    // 固定头：magic/CM/FLG=0/MTIME=0/XFL=0/OS=255(unknown)——canonical 形。
    listPush(out, 0x1F);
    listPush(out, 0x8B);
    listPush(out, 8);
    listPush(out, 0);
    let i: int = 0;
    while (i < 4) {
        listPush(out, 0);
        i = i + 1;
    }
    listPush(out, 0);
    listPush(out, 255);
    appendAll(out, storeBlocks(data));
    const c: int = crc32(data);
    listPush(out, c & 0xFF);
    listPush(out, (c >>> 8) & 0xFF);
    listPush(out, (c >>> 16) & 0xFF);
    listPush(out, (c >>> 24) & 0xFF);
    const sz: int = listLen(data) & 0xFFFFFFFF;
    listPush(out, sz & 0xFF);
    listPush(out, (sz >>> 8) & 0xFF);
    listPush(out, (sz >>> 16) & 0xFF);
    listPush(out, (sz >>> 24) & 0xFF);
    return out;
}

function appendAll(dst: List<int>, src: List<int>): void {
    for (v in src) {
        listPush(dst, v);
    }
}
