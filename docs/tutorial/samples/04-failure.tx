// 04 失败通道：T | Error 与 ?/catch；T? 与桥接。
function div(a: int, b: int): int | Error {
    if (b == 0) {
        return err("division by zero");
    }
    return a / b;
}

// ? 传播：失败立即从本函数返回（替代 TS 的 try/throw）
function timesTen(a: int, b: int): int | Error {
    const q = div(a, b)?;
    return q * 10;
}

// 绑定块内 return 发散：以 -1 标记失败路径
function demo(a: int, b: int): int {
    div(a, b) catch (e) {
        print("blocked:" + e.message);
        return -1;
    };
    return 1;
}

function firstChar(s: string): int? {
    if (len(s) == 0) {
        return None;
    }
    return byteAt(s, 0) catch None;
}

function main(args: []string): int {
    // catch 默认值：失败取默认，成功保原值
    print("a=" + toStr(div(9, 3) catch -1));

    // catch (e) 绑定块：e.message 诊断面（成功侧非 void 时块须发散）
    print("demo:" + toStr(demo(1, 0)));

    // 桥接：T? 升级 T | Error（catch err）／降级 T | Error → T?（catch None）
    const strict: int | Error = firstChar("tx") catch err("empty");
    print("strict=" + toStr(strict catch -1));

    // ? 链路：成功路径逐层透传
    print("timesTen=" + toStr(timesTen(9, 3) catch -1));

    // ?? 是 catch 默认值的另一种写法（None 与 Error 都合并）
    print("empty=" + toStr(firstChar("") ?? -1));
    return 0;
}
