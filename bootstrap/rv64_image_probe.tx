// RISC-V 写出链路的端到端探针：用 rv64_asm 手写两个目标文件，经 ELF riscv64 对象与
// 链接器写成静态可执行文件（不用 libc，直接 ecall）。在 RISC-V Linux（或 qemu-riscv64）上运行应依次打印五行：
//   rv64 image: write ok          ← ecall write、符号地址（auipc＋addi：PCREL_HI20＋PCREL_LO12_I）
//   rv64 image: relax ok          ← 向前越过 4 KiB 的 beq（中形式：取反跳过一条＋jal）、向后越过 1 MiB 的 blt（长形式：取反＋auipc＋jalr）、
//                                   越过 1 MiB 的无条件跳转（auipc＋jalr）与本缓冲内的调用（auipc ra＋jalr ra，就地算出）
//   rv64 image: consts ok         ← 约 300 个 64 位常数经 rv64MovImm 合成，与 .rodata 里的同值逐个比较（偏移超 2047 的读经 t6）
//   rv64 image: float ok          ← fcvt.d.l、flt.d、feq.d
//   rv64 image: call/data ok      ← 跨对象调用（CALL_PLT）、.data 里的绝对地址（R_RISCV_64）、读写 .data（PCREL_LO12_I／_S）
// 然后 exit_group(0)；不符时以 12..15 退出。用法：rv64_image_probe <输出文件> [<目标文件目录>]；构建成功打印 PASS_RV64_IMAGE、字节数与常数个数。
import { StructuredBuffer, asBufferLabel, asStructuredBegin, asStructuredSection, asStructuredLabel, asStructuredByte, asStructuredQuad, asStructuredAlign, asStructuredAddress, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { asBufferNewRv64, rv64BufferSubmit, rv64Emit, rv64Br, rv64BCond, rv64AddrOf, rv64SymAccess, rv64MovImm, rv64Mem } from "./selfhost/rv64_asm";
import { rv64R, rv64R2, rv64I } from "./selfhost/rv64_encode";
import { RV64_ADDI, RV64_ECALL, RV64_EBREAK, RV64_LD, RV64_SD, RV64_BEQ, RV64_BNE, RV64_BLT, RV64_JALR, RV64_FCVT_D_L, RV64_FLT_D, RV64_FEQ_D } from "./selfhost/rv64_encode";
import { elfWriteObject, elfObjectOk, elfObjectBytes, elfObjectError } from "./selfhost/emit_elf_object";
import { linkElfObjects, elfObjectsBytes, elfObjectsError, elfDynReset } from "./selfhost/link_elf_objects";

const ZERO: int = 0;
const RA: int = 1;
const T0: int = 5;
const T1: int = 6;
const T2: int = 7;
const A0: int = 10;
const A1: int = 11;
const A2: int = 12;
const A7: int = 17;
// 通用表的系统调用号（riscv64）：write 64、exit_group 94。
const SYS_WRITE: int = 64;
const SYS_EXIT_GROUP: int = 94;
const NOP: int = 19; // addi zero, zero, 0

function text(label: string, s: string): void {
    asStructuredSection(1);
    asStructuredLabel(label);
    let i = 0;
    while (i < len(s)) { asStructuredByte(byteAt(s, i) catch 0); i = i + 1; }
    asStructuredSection(0);
}

function syscall(b: Ref<StructuredBuffer>, nr: int): void {
    rv64MovImm(b, A7, nr);
    rv64Emit(b, RV64_ECALL, "ecall");
}
// write(1, 符号, n)。
function write(b: Ref<StructuredBuffer>, symbol: string, n: int): void {
    rv64MovImm(b, A0, 1);
    rv64AddrOf(b, A1, symbol, 0);
    rv64MovImm(b, A2, n);
    syscall(b, SYS_WRITE);
}
function exitWith(b: Ref<StructuredBuffer>, code: int): void {
    rv64MovImm(b, A0, code);
    syscall(b, SYS_EXIT_GROUP);
}
function nops(b: Ref<StructuredBuffer>, n: int): void {
    let k = 0;
    while (k < n) { rv64Emit(b, NOP, "nop"); k = k + 1; }
}

function object(exports: List<string>): Bytes {
    const r = elfWriteObject(exports);
    if (elfObjectOk(r) != 1) { eprint("elf: " + elfObjectError(r)); return bytesNew(0); }
    return elfObjectBytes(r);
}

const MSG_WRITE: string = "rv64 image: write ok\n";
const MSG_RELAX: string = "rv64 image: relax ok\n";
const MSG_CONSTS: string = "rv64 image: consts ok\n";
const MSG_FLOAT: string = "rv64 image: float ok\n";
const MSG_CALL: string = "rv64 image: call/data ok\n";

let seed: int = 88172645463325252;
function next(): int {
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >>> 7);
    seed = seed ^ (seed << 17);
    return seed;
}
// 合成用的常数：12、20、32 位的边界，lui＋addiw 回绕的几种（0x7ffff800 等），高位进位到 2^51 的 0x7ffffffffffff800，加随机值与
// 随机值右移若干位（覆盖 1～8 条指令的各种组合）。
function constants(): List<int> {
    const out: List<int> = listNew();
    for (w in strSplit("0 1 -1 2047 2048 -2048 -2049 4095 4096 4097 65535 2147483647 -2147483648 2147483648 4294967295 4294967296 -4294967296", " ")) {
        listPush(out, parse(w));
    }
    for (w in strSplit("2147481600 2147481599 -2147483649 2251799813685247 2251799813685248 -2251799813685248 4503599627370495 4503599627370496 9223372036854775807 9223372036854773760 1311768467463790320 -4503599627370496 -4503599627368449 81985529216486895 1099511628211 -3750763034362895579", " ")) {
        listPush(out, parse(w));
    }
    listPush(out, 0 - 9223372036854775807 - 1);
    let k = 0;
    while (k < 140) {
        const r = next();
        listPush(out, r);
        listPush(out, r >> ((next() >>> 1) % 64));
        k = k + 1;
    }
    return out;
}
function parse(s: string): int {
    let v = 0;
    let i = 0;
    let neg = false;
    if ((byteAt(s, 0) catch 0) == 45) { neg = true; i = 1; }
    while (i < len(s)) { v = v * 10 + ((byteAt(s, i) catch 48) - 48); i = i + 1; }
    if (neg) { v = -v; }
    return v;
}

function first(consts: List<int>): Bytes {
    const b = asBufferNewRv64();
    asBufferLabel(b, "rv64_main", 1);
    write(b, "msg_write", len(MSG_WRITE));
    // 向前越过 4 KiB 的 beq（zero == zero，必跳）：短形式够不着，换成 bne +8; jal .Lmid。
    rv64BCond(b, RV64_BEQ, ZERO, ZERO, ".Lmid");
    rv64Emit(b, RV64_EBREAK, "ebreak");
    nops(b, 1200);
    rv64Emit(b, RV64_EBREAK, "ebreak");
    asBufferLabel(b, ".Lmid", 1);
    // 越过 1 MiB 的无条件跳转（auipc t6＋jalr zero）。
    rv64Br(b, 0, ".Lfar");
    asBufferLabel(b, ".Lback", 1);
    // 本缓冲内的调用：.Lsub 把 a0 置 7。
    rv64Br(b, 1, ".Lsub");
    rv64MovImm(b, T0, 7);
    rv64BCond(b, RV64_BNE, A0, T0, ".Lbad14");
    write(b, "msg_relax", len(MSG_RELAX));
    rv64Br(b, 0, ".Lafter");
    asBufferLabel(b, ".Lsub", 1);
    rv64MovImm(b, A0, 7);
    rv64Emit(b, rv64I(RV64_JALR, ZERO, RA, 0), "ret");
    nops(b, 270000);
    rv64Emit(b, RV64_EBREAK, "ebreak");
    asBufferLabel(b, ".Lfar", 1);
    // 向后越过 1 MiB 的 blt（0 < 1，必跳）：长形式 bge +12; auipc t6; jalr zero。
    rv64MovImm(b, T1, 1);
    rv64BCond(b, RV64_BLT, ZERO, T1, ".Lback");
    rv64Emit(b, RV64_EBREAK, "ebreak");
    asBufferLabel(b, ".Lafter", 1);
    // 常数：t2 指向 .rodata 的表，逐个合成进 t0、读进 t1，不等即以 12 退出。
    rv64AddrOf(b, T2, "rv64_consts", 0);
    let k = 0;
    for (v in consts) {
        rv64MovImm(b, T0, v);
        rv64Mem(b, RV64_LD, T1, T2, k * 8);
        rv64BCond(b, RV64_BNE, T0, T1, ".Lbad12");
        k = k + 1;
    }
    write(b, "msg_consts", len(MSG_CONSTS));
    // 浮点：3.0 与 2.0，2 < 3 为真，3 == 3 为真（feq 写 1）；3 < 2 为假。
    rv64MovImm(b, T0, 3);
    rv64Emit(b, rv64R2(RV64_FCVT_D_L, 0, T0), "fcvt.d.l");
    rv64MovImm(b, T0, 2);
    rv64Emit(b, rv64R2(RV64_FCVT_D_L, 1, T0), "fcvt.d.l");
    rv64Emit(b, rv64R(RV64_FLT_D, T0, 1, 0), "flt.d");
    rv64BCond(b, RV64_BEQ, T0, ZERO, ".Lbad13");
    rv64Emit(b, rv64R(RV64_FEQ_D, T0, 0, 0), "feq.d");
    rv64BCond(b, RV64_BEQ, T0, ZERO, ".Lbad13");
    rv64Emit(b, rv64R(RV64_FLT_D, T0, 0, 1), "flt.d");
    rv64BCond(b, RV64_BNE, T0, ZERO, ".Lbad13");
    write(b, "msg_float", len(MSG_FLOAT));
    // 写 .data 再读回（PCREL_LO12_S 与 _I），不等即以 15 退出。
    rv64MovImm(b, T0, 81985529216486895);
    rv64SymAccess(b, RV64_SD, T0, T2, "rv64_slot", 0);
    rv64SymAccess(b, RV64_LD, T1, T1, "rv64_slot", 0);
    rv64BCond(b, RV64_BNE, T0, T1, ".Lbad15");
    // 跨对象调用；返回写出的字节数，为 0 即以 14 退出。
    rv64Br(b, 1, "rv64_helper");
    rv64BCond(b, RV64_BEQ, A0, ZERO, ".Lbad14");
    exitWith(b, 0);
    asBufferLabel(b, ".Lbad12", 1);
    exitWith(b, 12);
    asBufferLabel(b, ".Lbad13", 1);
    exitWith(b, 13);
    asBufferLabel(b, ".Lbad14", 1);
    exitWith(b, 14);
    asBufferLabel(b, ".Lbad15", 1);
    exitWith(b, 15);
    asStructuredBegin();
    rv64BufferSubmit(b);
    if (asFailedAs() != 0) { eprint("rv64: " + asLastErrAs()); return bytesNew(0); }
    text("msg_write", MSG_WRITE);
    text("msg_relax", MSG_RELAX);
    text("msg_consts", MSG_CONSTS);
    text("msg_float", MSG_FLOAT);
    asStructuredSection(1);
    asStructuredAlign(3);
    asStructuredLabel("rv64_consts");
    for (v in consts) { asStructuredQuad(v); }
    asStructuredSection(2);
    asStructuredAlign(3);
    asStructuredLabel("rv64_slot");
    asStructuredQuad(0);
    asStructuredSection(0);
    const exports: List<string> = listNew(); listPush(exports, "rv64_main");
    return object(exports);
}

function second(): Bytes {
    const b = asBufferNewRv64();
    asBufferLabel(b, "rv64_helper", 1);
    // a1 ＝ [cell]：.data 里存着 msg_call 的绝对地址。
    rv64SymAccess(b, RV64_LD, A1, T0, "rv64_cell", 0);
    rv64MovImm(b, A0, 1);
    rv64MovImm(b, A2, len(MSG_CALL));
    syscall(b, SYS_WRITE);
    rv64Emit(b, rv64I(RV64_JALR, ZERO, RA, 0), "ret");
    asStructuredBegin();
    rv64BufferSubmit(b);
    if (asFailedAs() != 0) { eprint("rv64: " + asLastErrAs()); return bytesNew(0); }
    text("msg_call", MSG_CALL);
    asStructuredSection(2);
    asStructuredAlign(3);
    asStructuredLabel("rv64_cell");
    asStructuredAddress("msg_call");
    asStructuredSection(0);
    const exports: List<string> = listNew(); listPush(exports, "rv64_helper");
    return object(exports);
}

function main(args: []string): int {
    if (len(args) < 1) { eprint("usage: rv64_image_probe <out>"); return 64; }
    const consts = constants();
    const a = first(consts);
    if (asFailedAs() != 0) { eprint("asm: " + asLastErrAs()); return 65; }
    const c = second();
    if (asFailedAs() != 0) { eprint("asm: " + asLastErrAs()); return 65; }
    if (bytesLen(a) == 0 || bytesLen(c) == 0) { return 66; }
    const objects: List<Bytes> = listNew();
    listPush(objects, a);
    listPush(objects, c);
    // 第二个参数给目录时另写出两个目标文件（交 GNU ld 等独立链接器核对重定位）。
    if (len(args) >= 2) {
        writeFileBytes(args[1] + "/rv64_a.o", a) catch (e) { eprint(e.message); return 68; };
        writeFileBytes(args[1] + "/rv64_b.o", c) catch (e) { eprint(e.message); return 68; };
    }
    elfDynReset();
    if (linkElfObjects(objects, "rv64_main") != 0) { eprint("link: " + elfObjectsError()); return 67; }
    const image = elfObjectsBytes();
    writeFileBytes(args[0], image) catch (e) { eprint(e.message); return 68; };
    print("PASS_RV64_IMAGE " + toStr(bytesLen(image)) + " " + toStr(listLen(consts)));
    return 0;
}
