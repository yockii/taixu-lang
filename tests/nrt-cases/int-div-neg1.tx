// 整数除以 -1：商为相反数，-1 / -1 为 1；最小值 % -1 为 0，最小值 + 1 除以 -1 为最大值（D3 §617）。
// 形参有类型的函数、循环里的局部量、数组元素三种写法各走一遍生成代码的除法快路径。
function q(a: int, b: int): int { return a / b; }
function r(a: int, b: int): int { return a % b; }

export function main(args: []string): int {
    const m: int = -9223372036854775807 - 1;
    print(toStr(q(-1, -1)) + " " + toStr(q(7, -1)) + " " + toStr(q(m + 1, -1)));
    print(toStr(r(-1, -1)) + " " + toStr(r(m, -1)) + " " + toStr(r(7, -1)));
    let acc: int = 0;
    let i: int = -3;
    while (i <= 3) {
        if (i != 0) { acc = acc * 10 + (-1 / i) + (i / -1) + (i % -1); }
        i = i + 1;
    }
    print(toStr(acc));
    const xs = [-1, m + 1, m];
    print(toStr(xs[0] / xs[0]) + " " + toStr(xs[1] / xs[0]) + " " + toStr(xs[2] % xs[0]));
    return 0;
}
