// generic-same-name 的桩模块：模块 A 的 P 与 K（与 B 中的同名类型不是同一个类型）。
import { Box, Pair, unbox, firstOf, apply } from "./gsn_g";

export struct P { x: int }
export enum K { A, B }

function px(p: P): int { return p.x; }
function kName(k: K): string {
    return switch (k) {
        case A => "A",
        case B => "B",
    };
}

export function fa(): string {
    const b = Box < P > { v: P { x: 5 } };
    const bb = Box < Box < P >> { v: b };
    const k = Box < K > { v: K.B };
    const rs: List< Ref< P>> = listNew();
    listPush(rs, new P { x: 7 });
    const r = firstOf(rs, new P { x: 0 });
    const fbox: Box < (P) => int > = { v: px };
    const fv = fbox.v;
    const q = Pair < P, K > { first: P { x: 1 }, second: K.A };
    return toStr(unbox(b).x) + "," + toStr(bb.v.v.x) + "," + kName(k.v) + "," + toStr(r.x) + "," + toStr(q.first.x) + kName(q.second) + "," + toStr(fv(P { x: 3 })) + "," + toStr(apply(px, P { x: 9 }));
}
