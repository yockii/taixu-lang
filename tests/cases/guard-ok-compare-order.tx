// D3 §6.5-1：表达式自左向右求值，比较运算同样——a > b、a >= b 先求 a（v0.52 修正：此前 > 与 >= 先求右侧）。
// 数值、定宽数值与 string 的大小比较各测一遍。
let trace: string = "";

function t(n: int): int {
    trace = trace + toStr(n);
    return n;
}

function u(n: u8): u8 {
    trace = trace + "u" + toStr(n as int);
    return n;
}

function s(x: string): string {
    trace = trace + x;
    return x;
}

export function main(args: []string): int {
    if (t(1) > t(2)) { trace = trace + "!"; }
    trace = trace + "|";
    if (t(3) >= t(4)) { trace = trace + "!"; }
    trace = trace + "|";
    if (t(6) > t(5) && t(7) >= t(7)) { trace = trace + "+"; }
    trace = trace + "|";
    if (u(9) > u(8)) { trace = trace + "+"; }
    trace = trace + "|";
    if (s("a") > s("b") || s("d") >= s("c")) { trace = trace + "+"; }
    print(trace);
    return 0;
}
