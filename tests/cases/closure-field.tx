struct Button {
    id: int,
    onClick: (int) => void,
}
export function main(args: []string): int {
    const btn = new Button {
        id: 2,
        onClick: (target: int): void => { print(`clicked ${target}`); },
    };
    const ls: List<Ref<Button>> = listNew();
    listPush(ls, btn);
    const b = listGet(ls, 0) catch panic("unreachable");
    b.onClick(b.id);
    return 0;
}
