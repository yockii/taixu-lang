// D3 v0.51 §6.9-2：listGet／listPop／byteAt 越界（空表）即 trap、返回 T；listTryGet／listTryPop／byteTryAt
// 越界得 None。元素可为 T?（List<int?>、Map<string, int?>）：listGet 取到的 None 只能是元素本身；值可空的 Map 用 mapHas＋mapAt；
// for-in 照常取元素与值；解构 List 时各名为 T?（越界得 None）。
struct P { x: int, tag: string }

function sum(xs: List<int>): int {
    let s = 0;
    let i = 0;
    while (i < listLen(xs)) {
        s += listGet(xs, i);
        i += 1;
    }
    return s;
}

export function main(args: []string): int {
    const xs: List<int> = listNew();
    listPush(xs, 10);
    listPush(xs, 20);
    print(toStr(sum(xs)) + " " + toStr(listGet(xs, 1)) + " " + toStr(listTryGet(xs, 5) ?? -1) + " " + toStr(listTryGet(xs, 0) ?? -1));
    const ps: List<P> = listNew();
    listPush(ps, P { x: 1, tag: "a" });
    const p = listGet(ps, 0);
    print(p.tag + toStr(p.x) + " " + toStr((listTryGet(ps, 3) ?? P { x: 9, tag: "z" }).x));
    print(toStr(byteAt("abc", 1)) + " " + toStr(byteTryAt("abc", 9) ?? -1));
    const top = listPop(xs);
    print(toStr(top) + " " + toStr(listTryPop(xs) ?? -1) + " " + toStr(listTryPop(xs) ?? -1) + " " + toStr(listLen(xs)));
    const os: List<int?> = listNew();
    listPush(os, 1);
    listPush(os, None);
    listPush(os, 3);
    let line = "";
    for (o in os) { line = line + toStr(o ?? 0) + ","; }
    const mid = listGet(os, 1);
    print(line + " " + toStr(mid == None) + " " + toStr(listGet(os, 2) ?? 0) + " " + toStr(listPop(os) ?? 0) + " " + toStr(listPop(os) == None));
    const m: Map<string, int?> = mapNew();
    mapSet(m, "a", 1);
    const nn: int? = None;
    mapSet(m, "n", nn);
    print(toStr(mapHas(m, "n")) + " " + toStr(mapAt(m, "n") == None) + " " + toStr(mapAt(m, "a") ?? 0) + " " + toStr(mapHas(m, "q")));
    let acc = "";
    for (k, v in m) { acc = acc + k + "=" + toStr(v ?? -1) + ";"; }
    print(acc);
    const m2: Map<string, int> = mapNew();
    mapSet(m2, "x", 5);
    print(toStr(mapGet(m2, "x") ?? 0) + " " + toStr(mapGet(m2, "y") ?? 0) + " " + toStr(mapAt(m2, "x")));
    const (a, b, c) = xs;
    print(toStr(a ?? -1) + " " + toStr(b ?? -1) + " " + toStr(c ?? -1));
    return 0;
}
