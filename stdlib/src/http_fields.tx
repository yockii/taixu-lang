// HTTP 字段的字节级语法。头值保留原始 octet，调用方按字段定义选择解码方式。
export function httpLower(s: string): string {
    const b = bytesFromStr(s);
    let i = 0;
    while (i < bytesLen(b)) {
        const c = bytesGet(b, i) catch 0;
        if (c >= 65 && c <= 90) { bytesSet(b, i, c + 32); }
        i = i + 1;
    }
    return bytesToStr(b) catch "";
}

export function httpTokenByte(c: int): bool {
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
    || c == 33 || c == 35 || c == 36 || c == 37 || c == 38 || c == 39 || c == 42 || c == 43 || c == 45 || c == 46
    || c == 94 || c == 95 || c == 96 || c == 124 || c == 126;
}

export function httpToken(s: string): bool {
    if (len(s) == 0) { return false; }
    for (c in s) { if (!httpTokenByte(c)) { return false; } }
    return true;
}

export function httpOws(c: int): bool { return c == 32 || c == 9; }

export function httpTrim(b: Bytes): Bytes {
    let a = 0;
    let z = bytesLen(b);
    while (a < z && httpOws(bytesGet(b, a) catch 0)) { a = a + 1; }
    while (z > a && httpOws(bytesGet(b, z - 1) catch 0)) { z = z - 1; }
    return bytesSlice(b, a, z - a);
}

export function httpValueOk(b: Bytes): bool {
    let i = 0;
    while (i < bytesLen(b)) {
        const c = bytesGet(b, i) catch 0;
        if ((c < 32 && c != 9) || c == 127) { return false; }
        i = i + 1;
    }
    return true;
}

export function httpNumber(s: string, base: int, max: int): int | Error {
    if ((base != 10 && base != 16) || max < 0) { return err("http: invalid number constraints"); }
    if (len(s) == 0) { return err("http: empty number"); }
    let n = 0;
    for (c in s) {
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        else if (c >= 65 && c <= 70) { d = c - 55; }
        else if (c >= 97 && c <= 102) { d = c - 87; }
        if (d < 0 || d >= base || n > (max - d) / base || d > max) { return err("http: invalid or oversized number"); }
        n = n * base + d;
    }
    return n;
}

// chunk-size 后的扩展只验证语法，不解释未知扩展。quoted-pair 允许 HTAB／SP／VCHAR／obs-text。
export function httpChunkSize(line: Bytes): int | Error {
    const n = bytesLen(line);
    let i = 0;
    while (i < n) {
        const c = bytesGet(line, i) catch 0;
        if (!((c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102))) { break; }
        i = i + 1;
    }
    const size = httpNumber(bytesToStr(bytesSlice(line, 0, i))?, 16, 9223372036854775807)?;
    while (i < n) {
        while (i < n && httpOws(bytesGet(line, i) catch 0)) { i = i + 1; }
        if (i == n) { break; }
        if ((bytesGet(line, i) catch 0) != 59) { return err("http: invalid chunk extension"); }
        i = i + 1;
        while (i < n && httpOws(bytesGet(line, i) catch 0)) { i = i + 1; }
        const start = i;
        while (i < n && httpTokenByte(bytesGet(line, i) catch 0)) { i = i + 1; }
        if (i == start) { return err("http: missing chunk extension name"); }
        while (i < n && httpOws(bytesGet(line, i) catch 0)) { i = i + 1; }
        if (i < n && (bytesGet(line, i) catch 0) == 61) {
            i = i + 1;
            while (i < n && httpOws(bytesGet(line, i) catch 0)) { i = i + 1; }
            if (i < n && (bytesGet(line, i) catch 0) == 34) {
                i = i + 1;
                let closed = false;
                while (i < n) {
                    let c = bytesGet(line, i) catch 0;
                    i = i + 1;
                    if (c == 34) { closed = true; break; }
                    if (c == 92) {
                        if (i >= n) { return err("http: incomplete quoted escape"); }
                        c = bytesGet(line, i) catch 0;
                        i = i + 1;
                    }
                    if ((c < 32 && c != 9) || c == 127) { return err("http: invalid chunk quoted value"); }
                }
                if (!closed) { return err("http: incomplete quoted value"); }
            } else {
                const valueAt = i;
                while (i < n && httpTokenByte(bytesGet(line, i) catch 0)) { i = i + 1; }
                if (i == valueAt) { return err("http: missing chunk extension value"); }
            }
        }
    }
    return size;
}
