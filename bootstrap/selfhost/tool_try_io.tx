// Bounded pipe writes for deadline-driven tools. Ordinary procWrite still writes all.
import { StructuredBuffer } from "./assemble";
import { L, I } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtSyscall, rtRet } from "./rtfn";
import { callWinImport } from "./ffi_callbacks";
import { xs0, xs1, xs2, xs3, xs4, xs5, xs7, toolCheck } from "./tool_base";
import { tRawSyscall, tMacos } from "./target";
import { uxSys, uxErrno, uxConst } from "./unix_sys";
import { rtCall0 } from "./rtfn";

export function emitToolTryIo(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_tool_try_wr", "x buf n", "r result flags changed fp orig op set old sp mp ts0 ts1 tp w wp gp ef", 7, "bootstrap/selfhost/tool_try_io.tx");
    rtIf(f, L("n"), "le", I(0), "zero");
    // <= PIPE_BUF on Linux; also ensures progress on a fresh Windows byte pipe.
    rtIf(f, L("n"), "le", I(4096), "sized");
    rtSet(f, "n", I(4096));
    rtLabel(f, "sized");
    rtSet(f, "result", I(-1));
    if (tMacos(t)) {
        // macOS：SIGPIPE 已改为空处理（M3 设计 G5），写坏管道直接得 EPIPE；其余同 Linux。PIPE_BUF 为 512，大于它的非阻塞写
        // 可能只写进一部分，返回实写字节数（调用方本就按返回值推进）。
        rtCall0(f, "", "__tx_tool_nopipe");
        uxSys(f, t, "flags", 72, xs3(L("x"), I(uxConst(t, "F_GETFL")), I(0)));
        rtIf(f, L("flags"), "lt", I(0), "bad");
        rtOp(f, "changed", L("flags"), "or", I(uxConst(t, "O_NONBLOCK")));
        uxSys(f, t, "r", 72, xs3(L("x"), I(uxConst(t, "F_SETFL")), L("changed")));
        rtIf(f, L("r"), "lt", I(0), "bad");
        uxSys(f, t, "r", 1, xs3(L("x"), L("buf"), L("n")));
        rtIf(f, L("r"), "lt", I(0), "macfail");
        rtSet(f, "result", L("r"));
        rtJump(f, "macrestore");
        rtLabel(f, "macfail");
        rtIf(f, L("r"), "eq", I(0 - uxErrno(t, "EAGAIN")), "macagain");
        rtIf(f, L("r"), "ne", I(-4), "macrestore");
        rtLabel(f, "macagain");
        rtSet(f, "result", I(0));
        rtLabel(f, "macrestore");
        uxSys(f, t, "r", 72, xs3(L("x"), I(uxConst(t, "F_SETFL")), L("flags")));
        rtIf(f, L("r"), "lt", I(0), "bad");
    } else if (tRawSyscall(t)) {
        rtSyscall(f, "flags", 72, xs3(L("x"), I(3), I(0)));
        rtIf(f, L("flags"), "lt", I(0), "bad");
        rtOp(f, "changed", L("flags"), "or", I(2048));
        rtSyscall(f, "r", 72, xs3(L("x"), I(4), L("changed")));
        rtIf(f, L("r"), "lt", I(0), "bad");
        rtSet(f, "set", I(4096)); rtSet(f, "old", I(0));
        rtAddrOf(f, "sp", "set"); rtAddrOf(f, "mp", "old");
        rtSyscall(f, "r", 14, xs4(I(0), L("sp"), L("mp"), I(8)));
        rtIf(f, L("r"), "lt", I(0), "restoreflags");
        rtSyscall(f, "r", 1, xs3(L("x"), L("buf"), L("n")));
        rtIf(f, L("r"), "ge", I(0), "written");
        rtIf(f, L("r"), "eq", I(-11), "again");
        rtIf(f, L("r"), "eq", I(-4), "again");
        rtIf(f, L("r"), "ne", I(-32), "restoresignal");
        rtOp(f, "r", L("old"), "and", I(4096));
        rtIf(f, L("r"), "ne", I(0), "restoresignal");
        rtSet(f, "ts0", I(0)); rtSet(f, "ts1", I(0)); rtAddrOf(f, "tp", "ts0");
        rtSyscall(f, "", 128, xs4(L("sp"), I(0), L("tp"), I(8)));
        rtJump(f, "restoresignal");
        rtLabel(f, "written"); rtSet(f, "result", L("r")); rtJump(f, "restoresignal");
        rtLabel(f, "again"); rtSet(f, "result", I(0));
        rtLabel(f, "restoresignal");
        rtSyscall(f, "r", 14, xs4(I(2), L("mp"), I(0), I(8)));
        rtIf(f, L("r"), "ge", I(0), "restoreflags");
        rtSet(f, "result", I(-1));
        rtLabel(f, "restoreflags");
        rtSyscall(f, "r", 72, xs3(L("x"), I(4), L("flags")));
        rtIf(f, L("r"), "lt", I(0), "bad");
    } else {
        rtSet(f, "orig", I(0)); rtAddrOf(f, "op", "orig");
        callWinImport(f, "r", "GetNamedPipeHandleStateW", xs7(L("x"), L("op"), I(0), I(0), I(0), I(0), I(0)));
        rtIf32(f, L("r"), "eq", I(0), "bad");
        rtOp(f, "r", L("orig"), "and", I(1));
        rtIf(f, L("r"), "ne", I(0), "write");
        rtOp(f, "changed", L("orig"), "or", I(1)); rtAddrOf(f, "fp", "changed");
        callWinImport(f, "r", "SetNamedPipeHandleState", xs4(L("x"), L("fp"), I(0), I(0)));
        rtIf32(f, L("r"), "ne", I(0), "write");
        // Windows refuses WAIT -> NOWAIT while earlier bytes remain queued (231; NOWAIT -> WAIT always
        // succeeds). No write was attempted and the mode is intact: retry later. Once switched, the handle
        // stays NOWAIT (switching back after every write made each later call fail until the reader had
        // drained the pipe: about 4 KiB per wait); __tx_tool_wr switches back before a blocking write.
        callWinImport(f, "r", "GetLastError", xs0());
        rtIf32(f, L("r"), "eq", I(231), "zero");
        rtJump(f, "bad");
        rtLabel(f, "write");
        rtSet(f, "w", I(0)); rtAddrOf(f, "wp", "w");
        // A NOWAIT write larger than the free space writes nothing (n <= 4096, the pipe holds 64 KiB).
        callWinImport(f, "r", "WriteFile", xs5(L("x"), L("buf"), L("n"), L("wp"), I(0)));
        rtIf32(f, L("r"), "eq", I(0), "done");
        rtOp(f, "result", L("w"), "and", I(4294967295));
    }
    rtLabel(f, "done");
    rtRet(f, L("result"));
    rtLabel(f, "zero"); rtRet(f, I(0));
    rtLabel(f, "bad"); rtRet(f, I(-1));
    toolCheck(f);
}
