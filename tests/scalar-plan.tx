function carry(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) { sum = sum + i; i = i + 1; }
    return sum;
}
function floating(n: int): float {
    let i = 0; let sum = 0.5;
    while (i < n) { sum = sum * 1.5; i = i + 1; }
    return sum;
}
function nested(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) {
        let j = 0;
        while (j < i) { sum = sum + j; j = j + 1; }
        i = i + 1;
    }
    return sum;
}
function helper(a: int, b: int, c: int, d: int, e: int): int {
    let result = a + b + c + d; let i = 0;
    while (i < e) { result = result + i; i = i + 1; }
    return result;
}
function calling(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) { sum = sum + helper(i, i + 1, i + 2, i + 3, i + 4); i = i + 1; }
    return sum;
}
function overwrite(n: int): int {
    let i = 0; let scratch = 0;
    while (i < n) { scratch = i * 2; i = scratch + 1; }
    return i;
}
function exits(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) {
        if (i == 8) { break; }
        i = i + 1;
        if (i == 3) { continue; }
        if (i == 7) { return sum; }
        sum = sum + i;
    }
    return sum;
}
async function delayed(n: int): int { return n + 1; }
async function suspending(n: int): int {
    let i = 0; let sum = 0;
    while (i < n) { const value = await delayed(i); sum = sum + (value catch panic("task failed")); i = i + 1; }
    return sum;
}
function main(args: []string): int {
    print(toStr(carry(10)) + " " + toStr(floating(4)) + " " + toStr(nested(4)));
    print(toStr(calling(3)) + " " + toStr(overwrite(10)) + " " + toStr(exits(20)));
    const pending = suspending(3); const value = await pending; print(toStr(value catch panic("task failed")));
    return 0;
}
