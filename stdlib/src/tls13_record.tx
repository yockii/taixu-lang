// TLS 1.3 AES-128-GCM 记录；调用方为收发分别持有状态，并在握手状态机中处理类型与密钥切换。
import { tls13ExpandLabel } from "./tls13_kdf";
import { aes128GcmSeal, aes128GcmOpen } from "./crypto/gcm";

export struct Tls13RecordKeys { key: Bytes, iv: Bytes, sequence: int, failed: bool }
export struct Tls13Plaintext { contentType: int, content: Bytes }

export function tls13TrafficKeys(secret: Bytes): Ref<Tls13RecordKeys> | Error {
    return new Tls13RecordKeys { key: tls13ExpandLabel(secret, "key", bytesNew(0), 16)?,
        iv: tls13ExpandLabel(secret, "iv", bytesNew(0), 12)?, sequence: 0, failed: false };
}

function at(data: Bytes, i: int): int { return bytesGet(data, i) catch panic("tls13: internal record bounds"); }
function typeOk(kind: int): bool { return kind == 21 || kind == 22 || kind == 23; }

function ready(state: Ref<Tls13RecordKeys>): void | Error {
    if (state.failed) { return err("tls13: closed record state"); }
    if (bytesLen(state.key) != 16 || bytesLen(state.iv) != 12 || state.sequence < 0) { return err("tls13: invalid record state"); }
    if (state.sequence >= 16777216) { return err("tls13: record key update required"); }
    return done();
}

function nonce(state: Ref<Tls13RecordKeys>): Bytes {
    const out = bytesSlice(state.iv, 0, 12);
    let value = state.sequence; let i = 11;
    while (i >= 4) { bytesSet(out, i, at(out, i) ^ (value & 255)); value = value >> 8; i = i - 1; }
    return out;
}

function header(length: int): Bytes {
    const out = bytesNew(5);
    bytesSet(out, 0, 23); bytesSet(out, 1, 3); bytesSet(out, 2, 3); bytesSet(out, 3, length / 256); bytesSet(out, 4, length % 256);
    return out;
}

export function tls13Seal(state: Ref<Tls13RecordKeys>, contentType: int, content: Bytes, padding: int): Bytes | Error {
    ready(state)?;
    const length = bytesLen(content);
    if (!typeOk(contentType) || length > 16384 || padding < 0 || padding > 16384 - length || (length == 0 && contentType != 23)) {
        return err("tls13: invalid record content or padding");
    }
    const inner = bytesNew(length + 1 + padding);
    bytesCopy(inner, 0, content, 0, length); bytesSet(inner, length, contentType);
    const aad = header(bytesLen(inner) + 16);
    const encrypted = aes128GcmSeal(state.key, nonce(state), aad, inner)?;
    const out = bytesSlice(aad, 0, 5); bytesAppend(out, encrypted);
    state.sequence = state.sequence + 1;
    return out;
}

function fail(state: Ref<Tls13RecordKeys>, alert: string): Error { state.failed = true; return err("tls13: " + alert); }

export function tls13Open(state: Ref<Tls13RecordKeys>, record: Bytes): Tls13Plaintext | Error {
    ready(state)?;
    const length = bytesLen(record);
    if (length < 5) { return fail(state, "decode_error"); }
    if (at(record, 0) != 23 || at(record, 1) != 3 || at(record, 2) != 3) { return fail(state, "unexpected_message"); }
    const encryptedLength = at(record, 3) * 256 + at(record, 4);
    if (encryptedLength > 16640) { return fail(state, "record_overflow"); }
    if (encryptedLength < 17 || encryptedLength != length - 5) { return fail(state, "decode_error"); }
    const aad = bytesSlice(record, 0, 5);
    const sealed = bytesSlice(record, 5, encryptedLength);
    const inner = aes128GcmOpen(state.key, nonce(state), aad, sealed) catch (e) { return fail(state, "bad_record_mac"); };
    if (bytesLen(inner) > 16385) { return fail(state, "record_overflow"); }
    let found = 0; let contentType = 0; let end = 0; let i = bytesLen(inner) - 1;
    while (i >= 0) {
        const value = at(inner, i); const nonzero = ((value | -value) >> 63) & 1;
        const mask = -(nonzero & (found ^ 1));
        contentType = contentType ^ ((contentType ^ value) & mask); end = end ^ ((end ^ i) & mask);
        found = found | nonzero; i = i - 1;
    }
    if (found == 0 || !typeOk(contentType) || (end == 0 && contentType != 23)) { return fail(state, "unexpected_message"); }
    state.sequence = state.sequence + 1;
    return Tls13Plaintext { contentType: contentType, content: bytesSlice(inner, 0, end) };
}

function done(): void {}
