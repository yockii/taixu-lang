// ============================================================================
// std/random —— 种子化伪随机数（V0.9-S1；D27 §一；STD-03；V0.39-G0 重写）。
//
// **确定性红线**：同种子恒同序列（教程/e2e 可断言）；句柄语义
//（randomNew 产 Ref，内部状态随句柄推进）。**无系统熵源混合**——熵由
// 种子注入（`randomSeed()` 便利面用 nowMs 派生，断言面禁用同 nowMs）。
//
// **splitmix64 复归（V0.39-G0 重写；D3 v0.14 位运算面）**：V0.10 降级注记
//（S1 无位运算＋溢出即 trap → Park–Miller Schrage 化）随位运算落地清偿
//（弧 G1-c 清单首位）。goldberg'15 splitmix64：state += φ⁶⁴ 黄金比例常数
// 的 64 位环绕推进＋三轮 multiply-xor-shift 混合；全域 2⁶⁴、统计质量
// 显著优于 31 位 LCG。**行为变更如实登记**：输出序列与 Park–Miller 完全
// 不同（内测期允许——D3 v0.14 §10 清偿条）；"同种子同序列"红线在新算法
// 上重立锚（tests/random.tx 属性行＋本头注）。randomNext 返回 **63 位
// 非负**（0..2⁶³-1，`>>> 1` 承载——保持非负取模/浮点面的既有契约）。
// ============================================================================

// 常量以 64 位二补码有符号十进制书写（int 无字面量后缀/无符号形态——
// 位型等价于 0x9E3779B97F4A7C15 / 0xBF58476D1CE4E5B9 / 0x94D049BB133111EB）。
const GOLDEN: int = -7046029254386353131; // φ⁶⁴ 黄金比例常数
const M1: int = -4658895280553007687;
const M2: int = -7723592293110705685;

export struct Random {
    state: int, // 64 位流式状态（任意初值合法——splitmix64 无非法状态）
}

// 建实例（seed 原样作初值——任意 64 位状态均良构）。
export function randomNew(seed: int): Ref<Random> {
    return new Random {
        state: seed,
    };
}

// 便利面：以 nowMs 派生种子（非确定性——断言面禁用，同 nowMs 纪律）。
export function randomSeed(): Ref<Random> {
    return randomNew(nowMs());
}

// 64 位环绕加（addconst）：S1 无环绕加法指令（imul 仅乘、+/- 溢出即 trap）
// ——异或进位迭代法（a+b = a^b ＋ 进位 (a&b)<<1 迭代；进位每轮左移一位、
// 64 轮内恒收敛，移位丢位即自然环绕）。确定性纯函数。
function addWrap(x: int, c: int): int {
    let sum: int = x;
    let carry: int = c;
    while (carry != 0) {
        const total = sum ^ carry;
        carry = (sum & carry) << 1;
        sum = total;
    }
    return sum;
}

// splitmix64 混合步：z = state += GOLDEN 后三轮 multiply-xor-shift。
function mix64(state: int): int {
    let z: int = state;
    z = imul(z ^ (z >>> 30), M1);
    z = imul(z ^ (z >>> 27), M2);
    return z ^ (z >>> 31);
}

// 下一原始值：0..2^63-1（63 位非负——取模/浮点契约面）。
export function randomNext(r: Ref<Random>): int {
    r.state = addWrap(r.state, GOLDEN); // 64 位环绕推进
    return mix64(r.state) >>> 1;
}

// 半开区间 [lo, hi) 的均匀面整数（lo < hi；否则返回 lo）。
export function randomRange(r: Ref<Random>, lo: int, hi: int): int {
    if (hi <= lo) { return lo; }
    const width = hi - lo;
    return lo + randomNext(r) % width;
}

// [0.0, 1.0) 浮点（63 位均匀分桶）。
export function randomFloat(r: Ref<Random>): float {
    return randomNext(r) as float / 9223372036854775808.0;
}
