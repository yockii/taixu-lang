// 线程第 4c 步：Atomic<int>（线程设计 §四-5、§二十一-4）。五个操作都是 seqcst；Atomic 只能经 Shared 跨线程——放进
// sharedNew 的对象图后，各线程物化出的 Atomic 指向块里同一个值单元（sharedNew 拷贝单元，原对象的单元与之无关）。
struct Stats {
    hits: Atomic< int>,
    best: Atomic< int>,
    name: string,
}

function bumpMax(a: Atomic< int>, v: int): void {
    while (true) {
        const cur = atomicLoad(a);
        if (v <= cur) {
            return;
        }
        if (atomicCas(a, cur, v)) {
            return;
        }
    }
}

function work(st: Shared< Ref< Stats>>, id: int): int {
    const s = sharedGet(st);
    let i = 0;
    while (i < 20000) {
        atomicAdd(s.hits, 1);
        i = i + 1;
    }
    bumpMax(s.best, id * 10);
    return id;
}

function main(args: []string): void {
    // 本线程里的 Atomic。
    const a = atomicNew(5);
    print(toStr(atomicAdd(a, 3)) + " " + toStr(atomicLoad(a)));
    atomicStore(a, 40);
    print(toStr(atomicCas(a, 1, 2)) + " " + toStr(atomicCas(a, 40, 41)) + " " + toStr(atomicLoad(a)));

    // 共享的计数器：8 个线程各加 20000 次，并用 CAS 取最大值。
    const st = sharedNew(new Stats { hits: atomicNew(0), best: atomicNew(-1), name: "计数" });
    const ths: List< Thread< int>> = listNew();
    let i = 0;
    while (i < 8) {
        const id = i;
        listPush(ths, threadSpawn((): int => work(st, id)));
        i = i + 1;
    }
    let ids = 0;
    for (th in ths) {
        ids = ids + (threadJoin(th) catch -100);
    }
    const s = sharedGet(st);
    print(s.name + " hits " + toStr(atomicLoad(s.hits)) + " best " + toStr(atomicLoad(s.best)) + " ids " + toStr(ids));

    // 原对象里的 Atomic 与共享块里的是两个单元。
    const local = new Stats { hits: atomicNew(7), best: atomicNew(0), name: "原" };
    const sh = sharedNew(local);
    atomicAdd(local.hits, 1);
    print(toStr(atomicLoad(local.hits)) + " " + toStr(atomicLoad(sharedGet(sh).hits)));

    // List<Atomic<int>> 也能共享。
    const cells: List< Atomic< int>> = listNew();
    i = 0;
    while (i < 4) {
        listPush(cells, atomicNew(i));
        i = i + 1;
    }
    const sc = sharedNew(cells);
    const t = threadSpawn((): int => {
            let sum = 0;
            for (c in sharedGet(sc)) {
                sum = sum + atomicAdd(c, 100);
            }
            return sum;
        });
    print(toStr(threadJoin(t) catch -1));
    let after = 0;
    for (c in sharedGet(sc)) {
        after = after + atomicLoad(c);
    }
    print(toStr(after));

    // 闭包捕获的 Atomic 随 sharedNew 进块（静态算可共享，运行期按类型号表放行，表项 2），各线程调用的是同一个单元。
    const hits = atomicNew(0);
    const fs: List< () => int> = listNew();
    listPush(fs, (): int => atomicAdd(hits, 1));
    const sf = sharedNew(fs);
    const calls: List< Thread< int>> = listNew();
    i = 0;
    while (i < 3) {
        listPush(calls, threadSpawn((): int => {
                let k = 0;
                for (f in sharedGet(sf)) {
                    f();
                    k = k + 1;
                }
                return k;
            }));
        i = i + 1;
    }
    let ran = 0;
    for (th in calls) {
        ran = ran + (threadJoin(th) catch 0);
    }
    const f0 = listGet(sharedGet(sf), 0) catch ((): int => -1);
    print("ran " + toStr(ran) + " shared " + toStr(f0()) + " local " + toStr(atomicLoad(hits)));
}
