// ============================================================================
// engine/mac/m_pb —— objc_msgSend：id(id, SEL, id, BOOL)（如 -[NSApplication postEvent:atStart:]）。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: usize, b: u8): usize from "/usr/lib/libobjc.A.dylib";

export function msgPB(o: usize, s: string, a: usize, b: bool): usize {
    let v: u8 = 0;
    if (b) {
        v = 1;
    }
    return objc_msgSend(o, sel_registerName(s), a, v);
}
