// 只查询内核状态（macOS，M3 设计 G9）：hard CPU、禁 core、独立进程组缺一即拒绝 worker 入口。内存限额由父进程的看守线程
// 按进程组的物理足迹事后执行（G4），worker 自己无从核验；策略报告如实写。
declare function getrlimit(kind: i32, info: Bytes): i32 from "libSystem";
declare function getpid(): i32 from "libSystem";
declare function getpgrp(): i32 from "libSystem";
function u64at(b: Bytes, at: int): int {
    let n = 0; let i = 0; while (i < 8) { n = n | ((bytesGet(b, at + i) catch 0) << (i * 8)); i = i + 1; } return n;
}
function limited(kind: i32, maximum: int): bool {
    const b = bytesNew(16); if (getrlimit(kind, b) != 0) { return false; }
    const soft = u64at(b, 0); const hard = u64at(b, 8);
    return soft >= 0 && hard >= 0 && soft <= hard && hard <= maximum;
}
export function workerLimitsValid(memory: int, cpu: int): bool {
    memory;
    const pid = getpid(); return pid > 0 && getpgrp() == pid && limited(0, cpu) && limited(4, 0);
}
