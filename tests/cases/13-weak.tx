// MEM-03：弱引用——构造/解引用得值拷贝/目标释放后 deref 得 None（D3 v0.2 §6.7）。
struct Node { name: string }

export function main(args: []string): int {
    let r: Ref<Node> = new Node { name: "taixu" };
    const w: Weak<Node> = weak(r);
    const a = deref(w) catch Node { name: "MISS" }; // 目标存活：Node 值拷贝
    print(a.name);
    r = new Node { name: "next" }; // 旧 Ref 唯一强引用释放 → 目标死亡
    const b = deref(w) catch Node { name: "DEAD" }; // 已死：None → catch 默认
    print(b.name);
    const w2: Weak<Node> = weak(r); // 新目标：deref 正常
    const c = deref(w2) catch Node { name: "MISS2" };
    print(c.name);
    return 0;
}
