// Exclusive creation and empty-directory removal; never recursive.
declare function CreateDirectoryW(path: wstr, attributes: usize): i32 from "kernel32";
declare function RemoveDirectoryW(path: wstr): i32 from "kernel32";
declare type SCRATCH_FILE;
declare function CreateFileW(path: wstr, access: u32, share: u32, security: usize, creation: u32, flags: u32, template: usize): SCRATCH_FILE from "kernel32";
declare function CloseHandle(file: SCRATCH_FILE): i32 from "kernel32";
export function scratchMkdir(path: string): bool { return CreateDirectoryW(path, 0) != 0; }
export function scratchRmdir(path: string): bool { return RemoveDirectoryW(path) != 0; }
export function scratchClaim(path: string): bool {
    const file = CreateFileW(path, 1073741824, 3, 0, 1, 128, 0);
    if (handleBits(file) == -1 || handleBits(file) == 0) { return false; }
    return CloseHandle(file) != 0;
}
