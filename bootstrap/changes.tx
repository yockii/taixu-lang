        after: "setenv(\"MODE\", \"ci\") catch panic(\"\"); runProcess(\"/bin/sh\", [\"-c\", \"echo $MODE\"], \"\") catch -1; // 现在三个目标都打印 ci",
        implementedIn: "D3 v0.39",
        explain: "",
