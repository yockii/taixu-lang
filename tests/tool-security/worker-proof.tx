import { workerLimitsValid } from "../../bootstrap/selfhost/mcp_worker_limits";
function main(args: []string): int {
    if (len(args) > 1) { if (workerLimitsValid(805306368, 3)) { print("VERIFIED"); return 0; } return 3; }
    if (len(args) != 1) { return 64; }
    assert(!workerLimitsValid(805306368, 3), "unlimited entry must be rejected");
    const a: List< string> = listNew(); listPush(a, args[0]); listPush(a, "child");
    const h = procSpawnLimited(args[0], a, "", 0, 805306368, 3) catch (e) { print(e.message); return 1; };
    const code = procWait(h, 10000) catch 888;
    const b = bytesNew(1024); const n = procRead(h, 1, b); procClose(h);
    assert(code == 0 && n > 0, "limited entry must be verified");
    print("PASS_ACTUAL_WORKER_LIMITS"); return 0;
}
