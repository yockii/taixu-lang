// `taixu init <项目名> [--template=console|library|gui]`，或 `taixu init <模板> <项目名>`
// 项目脚手架。已存在的文件不覆盖。gui 模板的程序要用外部 GUI 库 taixu-gui（gui/ 前缀导入），模板只写源码。

import { filePath } from "./file_path";

function cpCountI(s: string): int {
    let pos = 0;
    let count = 0;
    while (pos < len(s)) {
        const c = byteAt(s, pos) catch 0;
        if (c >= 240) { pos = pos + 4; }
        else if (c >= 224) { pos = pos + 3; }
        else if (c >= 192) { pos = pos + 2; }
        else { pos = pos + 1; }
        count = count + 1;
    }
    return count;
}

function isSafeName(name: string): bool {
    if (len(name) == 0) { return false; }
    let i = 0;
    while (i < len(name)) {
        const c = byteAt(name, i) catch 0;
        const ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 45;
        if (!ok) { return false; }
        i = i + 1;
    }
    return true;
}

function isTemplate(t: string): bool {
    return t == "console" || t == "library" || t == "gui";
}

// 逐级建目录（已存在不算错）。
function ensureDir(dir: string): void {
    const parts = strSplit(dir, "/");
    let acc = "";
    for (p in parts) {
        if (len(acc) > 0) { acc = acc + "/"; }
        acc = acc + p;
        if (entryKind(filePath(acc)) != 2) {
            makeDir(filePath(acc)) catch (e) {};
        }
    }
}

function dirOf(path: string): string {
    const parts = strSplit(path, "/");
    let acc = "";
    let i = 0;
    while (i + 1 < listLen(parts)) {
        if (i > 0) { acc = acc + "/"; }
        acc = acc + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return acc;
}

// `taixu init` 的参数（args[0] 为子命令名）。返回退出码；-64 为用法错误（调用方打印用法）。
export function initCommand(args: []string): int {
    let name = "";
    let template = "console";
    let second = "";
    let i = 1;
    while (i < len(args)) {
        const a = args[i];
        if (strIndexOf(a, "--template=") == 0) { template = strSub(a, 11, cpCountI(a) - 11); }
        else if (strIndexOf(a, "-") == 0) { return -64; } // 其余选项（含 --help）一律报用法，不当作项目名
        else if (len(name) == 0) { name = a; }
        else if (len(second) == 0) { second = a; }
        else { return -64; }
        i = i + 1;
    }
    if (len(second) > 0) {
        if (!isTemplate(name)) { return -64; }
        template = name;
        name = second;
    } else if (template == "console" && (name == "library" || name == "gui")) {
        eprint("提示: '" + name + "' 是模板名——建 " + name + " 项目写作 `taixu init " + name + " <项目名>`");
    }
    if (len(name) == 0) { return -64; }
    if (!isSafeName(name)) {
        eprint("taixu init: 项目名须为 [A-Za-z0-9_-]+（不可为路径片段）");
        return 64;
    }
    const paths: List<string> = listNew();
    const datas: List<string> = listNew();
    if (template == "console") {
        listPush(paths, name + "/main.tx");
        listPush(datas, consoleMain(name));
    } else if (template == "library") {
        listPush(paths, name + "/src/" + name + ".tx");
        listPush(datas, libraryLib(name));
        listPush(paths, name + "/tests/smoke.tx");
        listPush(datas, libraryTest(name));
    } else if (template == "gui") {
        listPush(paths, name + "/main.tx");
        listPush(datas, guiMain(name));
        listPush(paths, name + "/replay.txt");
        listPush(datas, guiReplay());
        listPush(paths, name + "/expected.out");
        listPush(datas, guiExpected());
    } else {
        eprint("taixu init: --template 须为 console|library|gui");
        return 64;
    }
    let written = 0;
    let k = 0;
    while (k < listLen(paths)) {
        const p = listGet(paths, k) catch "";
        k = k + 1;
        if (entryKind(filePath(p)) == 1) { continue; }
        ensureDir(dirOf(p));
        writeFile(filePath(p), listGet(datas, k - 1) catch "") catch (e) {
            eprint("taixu init: 写盘失败");
            return 3;
        };
        written = written + 1;
    }
    print("init: " + toStr(written) + " 个文件写入 " + name + "（模板 " + template + "）");

    return 0;
}

// —— 模板 ——

function consoleMain(name: string): string {
    let t = "";
    t = t + "// " + name + "/main.tx —— console 模板（taixu init）\n";
    t = t + "export function main(args: []string): int {\n";
    t = t + "    args;\n";
    t = t + "    print(\"hello from " + name + "\");\n";
    t = t + "    return 0;\n";
    t = t + "}\n";
    return t;
}

function libraryLib(name: string): string {
    let t = "";
    t = t + "// " + name + "/src/" + name + ".tx —— library 模板（taixu init；std 模块形态）\n";
    t = t + "\n";
    t = t + "/// 计算整数平方（示例导出函数）。\n";
    t = t + "export function square(n: int): int {\n";
    t = t + "    return n * n;\n";
    t = t + "}\n";
    t = t + "\n";
    t = t + "test \"square\" {\n";
    t = t + "    assert(square(7) == 49, \"square(7) != 49\");\n";
    t = t + "}\n";
    return t;
}

function libraryTest(name: string): string {
    let t = "";
    t = t + "// " + name + "/tests/smoke.tx —— 库冒烟测试（taixu test）\n";
    t = t + "import { square } from \"../src/" + name + "\";\n";
    t = t + "\n";
    t = t + "test \"smoke\" {\n";
    t = t + "    assert(square(3) == 9, \"square(3) != 9\");\n";
    t = t + "}\n";
    return t;
}

function guiMain(name: string): string {
    let t = "";
    t = t + "// " + name + "/main.tx —— gui 模板（taixu init）：窗口、文字、按钮与点击计数。\n";
    t = t + "// 需要外部 GUI 库 taixu-gui（github.com/yockii/taixu-gui）：设环境变量 TAIXU_GUI_ROOT 为它的 src 目录，或把它放在\n";
    t = t + "// 编译器同级的 taixu-gui/。Windows 上 `taixu run main.tx` 开窗；发布用 `taixu build main.tx --out dist --subsystem=windows`\n";
    t = t + "// （启动不带控制台）。Linux、macOS 的真窗随 GUI 库后续版本，此前程序退回脚本窗、立即结束。\n";
    t = t + "import { Button, button, Canvas, paintText, paintTextWidth, drawButtonC } from \"gui/components\";\n";
    t = t + "import { appNew, appClose, pump, onClick, onResize, hitZone, defaultSpec } from \"gui/app\";\n";
    t = t + "import { EventRecord } from \"std/events\";\n";
    t = t + "import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent } from \"gui/surface\";\n";
    t = t + "import { fontEmbedded, fontFree, textCanvasK } from \"gui/text\";\n";
    t = t + "\n";
    t = t + "const BTN: int = 1;\n";
    t = t + "\n";
    t = t + "struct Model {\n";
    t = t + "    count: int,\n";
    t = t + "    surface: int,\n";
    t = t + "    btn: Ref<Button>,\n";
    t = t + "}\n";
    t = t + "\n";
    t = t + "function render(cv: Ref<Canvas>, w: int, h: int, m: Ref<Model>): void {\n";
    t = t + "    surfaceClear(cv.h, 0x202040);\n";
    t = t + "    paintText(cv, (w - paintTextWidth(cv, \"" + name + "\")) / 2, 16, 0xFFFFFF, \"" + name + "\");\n";
    t = t + "    paintText(cv, 16, 48, 0xC0C8E0, \"点击次数：\" + toStr(m.count));\n";
    t = t + "    m.btn.x = (w - m.btn.w) / 2;\n";
    t = t + "    m.btn.y = h - m.btn.h - 16;\n";
    t = t + "    drawButtonC(cv, m.btn);\n";
    t = t + "}\n";
    t = t + "\n";
    t = t + "export function main(args: []string): int {\n";
    t = t + "    args;\n";
    t = t + "    const m: Ref<Model> = new Model { count: 0, surface: 0, btn: button(BTN, 0, 0, 80, 24, \"点我\") };\n";
    t = t + "    const spec = defaultSpec(\"" + name + "\", 240, 140);\n";
    t = t + "    const app = appNew(spec);\n";
    t = t + "    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {\n";
    t = t + "        print(\"开不了绘制面：\" + e.message);\n";
    t = t + "        appClose(app);\n";
    t = t + "        return 1;\n";
    t = t + "    };\n";
    t = t + "    const font = fontEmbedded() catch (e) {\n";
    t = t + "        print(\"载入字体失败：\" + e.message);\n";
    t = t + "        appClose(app);\n";
    t = t + "        surfaceClose(m.surface);\n";
    t = t + "        return 1;\n";
    t = t + "    };\n";
    t = t + "    onClick(app, BTN, (rec: EventRecord): void => {\n";
    t = t + "            m.count = m.count + 1;\n";
    t = t + "        });\n";
    t = t + "    onResize(app, (w: int, h: int): void => {\n";
    t = t + "            surfaceClose(m.surface);\n";
    t = t + "            m.surface = surfaceOpenDip(w, h, app.k) catch 0;\n";
    t = t + "        });\n";
    t = t + "    while (app.running) {\n";
    t = t + "        const live: bool = pump(app, 16);\n";
    t = t + "        if (app.dirty) {\n";
    t = t + "            const cv = textCanvasK(m.surface, app.w, app.h, font.handle, 14, app.k);\n";
    t = t + "            render(cv, app.w, app.h, m);\n";
    t = t + "            hitZone(app, BTN, m.btn.x, m.btn.y, m.btn.w, m.btn.h);\n";
    t = t + "            windowPresent(app.hwnd, m.surface);\n";
    t = t + "            app.dirty = false;\n";
    t = t + "        }\n";
    t = t + "        if (!live) {\n";
    t = t + "            break;\n";
    t = t + "        }\n";
    t = t + "    }\n";
    t = t + "    print(\"点击了 \" + toStr(m.count) + \" 次\");\n";
    t = t + "    fontFree(font);\n";
    t = t + "    appClose(app);\n";
    t = t + "    surfaceClose(m.surface);\n";
    t = t + "    return 0;\n";
    t = t + "}\n";
    return t;
}

function guiReplay(): string {
    let t = "";
    t = t + "# 重放脚本：每行“帧号 kind target x y”；kind 3 按下（target 为组件 id）、6 关窗。\n";
    t = t + "step 16\n";
    t = t + "1 3 1 0 0\n";
    t = t + "2 3 1 0 0\n";
    t = t + "3 6 0 0 0\n";
    return t;
}

function guiExpected(): string {
    return "点击了 2 次\n";
}
