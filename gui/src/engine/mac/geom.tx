// ============================================================================
// engine/mac/geom —— AppKit 的几何结构（CGFloat 即 double，64 位）：按值传与返回（核心 K2，D3 v0.45）。
// ============================================================================

export declare struct NSPOINT { x: float, y: float }
export declare struct NSSIZE { w: float, h: float }
export declare struct NSRECT { origin: NSPOINT, size: NSSIZE }

export function nsRect(x: float, y: float, w: float, h: float): NSRECT {
    return NSRECT { origin: NSPOINT { x: x, y: y }, size: NSSIZE { w: w, h: h } };
}
