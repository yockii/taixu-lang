// makeDir（v052 toolchain builtins §一）：单层建目录、已存在目录幂等、
// 非目录占位与父缺失得结构化 Error。工作目录＝本用例目录，不新建任何目录。
function show(path: string): void {
    makeDir(path) catch (e) {
        print("err " + e.message);
        return;
    };
    print("ok " + path);
}

function main(args: []string): int {
    show(".");
    show("32-makedir.tx");
    show("no-such-parent-32/child");
    show("");
    return 0;
}
