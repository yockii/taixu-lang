// 外部函数的目标检查（D3 v0.35）：语义分析在外部函数
// 第一次被调用时检查（检查模式与构建同一判定），构建尾部的 ffiPrepare 用同一文案兜底。只查被调用的：声明而不调用无害
// （Go 引用当前 GOOS 下不存在的符号才报错，Zig 惰性分析只在被引用时检查）。
import { targetArch, tLinux, tMacos, tWindows } from "./target";
import { macInstallNameOk } from "./macos_symbols";
import { syscallKernel, syscallName, syscallNumber, syscallReplacement, syscallWithheldWhy } from "./syscall_names";

/// 被调用的外部函数在目标 t 上的问题（空串＝没有）：mode 1＝from "库"（库名 lib）、2＝from syscall 数字、3＝from syscall "名字"
/// （D3 v0.47）；wide＝签名里有 wstr（含 Ref<外部结构体> 参数的 wstr 字段）。
export function ffiTargetMessage(mode: int, name: string, lib: string, wide: bool, t: int): string {
    if ((mode == 2 || mode == 3) && !tLinux(t)) {
        if (tMacos(t)) {
            return "外部函数 " + name + " 声明为 from syscall，只能用于 Linux 目标（macOS 不提供稳定的系统调用接口：实现放进 _macos 或 _unix 文件，经 from \"libSystem\" 声明）";
        }
        return "外部函数 " + name + " 声明为 from syscall，只能用于 Linux 目标（Windows 实现请放在 _windows 文件里经 from \"库\" 声明）";
    }
    if (mode != 0 && wide && !tWindows(t)) {
        return "外部函数 " + name + "：wstr（UTF-16）只用于 Windows 目标；Linux、macOS 的 C 字符串请用 string（UTF-8）";
    }
    // 交叉链接不读目标平台的库文件，库名须是 dylib 的安装名。
    if (mode == 1 && tMacos(t) && !macInstallNameOk(lib)) {
        return "外部函数 " + name + " 来自 \"" + lib + "\"：macOS 上库名须写 dylib 的安装名（/ 开头的绝对路径，或 @executable_path/、@loader_path/ 开头），libSystem 可简写为 \"libSystem\"";
    }
    return "";
}

/// 模块显示名 display（如 `./lib/x_linux_aarch64`，不带扩展名；带 `.tx` 的也认）是否为目标 t 的架构专用 Linux 文件（按目标
/// 选文件的第一档 x_linux_<架构>）。
export function ffiArchFile(display: string, t: int): bool {
    const b = bytesFromStr(display);
    let n = len(display);
    if (n >= 3 && (bytesToStr(bytesSlice(b, n - 3, 3)) catch "") == ".tx") { n = n - 3; }
    const suffix = "_linux_" + targetArch(t);
    if (n < len(suffix)) { return false; }
    return (bytesToStr(bytesSlice(b, n - len(suffix), len(suffix))) catch "") == suffix;
}

/// from syscall 在 Linux 目标上选定的号码：nr＝号码（不可用为 -1），msg＝不可用的原因。
export struct SyscallPick {
    nr: int,
    msg: string,
}

/// D3 v0.47：被调用的 from syscall 在 Linux 目标 t 上的号码。mode 2＝数字：按 x86_64 的号解释，只在 x86_64 目标、
/// 或声明写在该目标架构的 _linux_<架构> 文件里（archFile）时可用——同一个号在别的架构上是另一个系统调用（41 在 x86_64 是 socket、
/// 在 aarch64 是 pivot_root），编给别的架构会静默调错；mode 3＝名字：按目标架构查内核号表，没有即报出并给替代调用。
export function ffiSyscallPick(mode: int, fname: string, sys: string, nr: int, t: int, archFile: bool): Ref<SyscallPick> {
    const arch = targetArch(t);
    const table = "（Linux " + syscallKernel() + " 的号表）";
    if (mode == 2) {
        if (arch == "x86_64" || archFile) { return new SyscallPick { nr: nr, msg: "" }; }
        const x = syscallName("x86_64", nr);
        let msg = "外部函数 " + fname + " 声明为 from syscall " + toStr(nr) + "：数字按 x86_64 的系统调用号解释";
        if (len(x) > 0) {
            msg = msg + "（x86_64 上是 " + x + "），不能用于 " + arch + " 目标——改写为 from syscall \"" + x + "\"，或把这条声明放进 _linux_" + arch + " 文件里写该架构的号";
            const there = syscallName(arch, nr);
            if (len(there) > 0) { msg = msg + "（同一个号在 " + arch + " 上是 " + there + "）"; }
        } else {
            msg = msg + "（x86_64 上没有这个号），不能用于 " + arch + " 目标——把这条声明放进 _linux_" + arch + " 文件里写该架构的号";
        }
        return new SyscallPick { nr: -1, msg: msg };
    }
    const n = syscallNumber(arch, sys);
    if (n >= 0) { return new SyscallPick { nr: n, msg: "" }; }
    let msg = "外部函数 " + fname + " 声明为 from syscall \"" + sys + "\"：";
    if (syscallNumber("x86_64", sys) < 0 && syscallNumber("aarch64", sys) < 0 && syscallNumber("loongarch64", sys) < 0 && syscallNumber("riscv64", sys) < 0) {
        return new SyscallPick { nr: -1, msg: msg + "不是 Linux 的系统调用名" + table };
    }
    const why = syscallWithheldWhy(arch, sys);
    if (len(why) > 0) {
        msg = msg + arch + " 上不提供这个系统调用（" + why + "）";
    } else {
        msg = msg + arch + " 上没有这个系统调用" + table;
    }
    const alt = syscallReplacement(arch, sys);
    if (len(alt) > 0) { msg = msg + "，改用 \"" + alt + "\""; }
    return new SyscallPick { nr: -1, msg: msg };
}

// D3 v0.36 C 变参：常见 C 变参函数的定参个数。只对系统 C 库
// 的声明核对（同名的自家库函数不受影响）；不在表里的由声明者负责。语义阶段核对，三个宿主一致。
function lowerAscii(s: string): string {
    const b = bytesFromStr(s);
    let i = 0;
    while (i < bytesLen(b)) {
        const c = bytesGet(b, i) catch 0;
        if (c >= 65 && c <= 90) { bytesSet(b, i, c + 32); }
        i = i + 1;
    }
    return bytesToStr(b) catch s;
}
function systemCLib(lib: string): bool {
    const l = lowerAscii(lib);
    const libs = ["libc.so.6", "libsystem", "/usr/lib/libsystem.b.dylib", "ucrtbase", "ucrtbase.dll", "msvcrt", "msvcrt.dll", "user32", "user32.dll"];
    for (x in libs) {
        if (l == x) { return true; }
    }
    return false;
}
/// 系统 C 库里的已知 C 变参函数的定参个数；不是（或不是系统 C 库的声明）为 −1。mode 1＝from "库"。
export function ffiVariadicFixed(name: string, mode: int, lib: string): int {
    if (mode != 1 || !systemCLib(lib)) { return -1; }
    // 每项“名字 定参个数”（个数都是一位数）。
    const rows = ["printf 1", "fprintf 2", "dprintf 2", "sprintf 2", "snprintf 3", "_snprintf 3", "asprintf 2", "scanf 1", "fscanf 2",
        "sscanf 2", "open 2", "open64 2", "openat 3", "openat64 3", "fcntl 2", "fcntl64 2", "ioctl 2", "execl 2", "execlp 2", "execle 2",
        "syslog 2", "prctl 1", "semctl 3", "sem_open 2", "mq_open 2", "err 2", "errx 2", "warn 1", "warnx 1", "_open 2", "wsprintfA 2",
        "wsprintfW 2"];
    for (row in rows) {
        if (strSub(row, 0, len(row) - 2) == name) { return (byteAt(row, len(row) - 1) catch 48) - 48; }
    }
    return -1;
}
