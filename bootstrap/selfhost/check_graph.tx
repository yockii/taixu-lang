// 模块反向依赖图：输入改变沿使用者传播，新增语义边可继续扩大失效集合。
export function checkGraphNew(n: int): List<List<int>> {
    const out: List<List<int>> = listNew();
    let i = 0;
    while (i < n) { const row: List<int> = listNew(); listPush(out, row); i = i + 1; }
    return out;
}

function checkGraphEmpty(): List<int> { return listNew(); }
export function checkGraphAdd(graph: List<List<int>>, dependency: int, user: int): void {
    if (dependency < 0 || dependency >= listLen(graph) || user < 0 || user >= listLen(graph)) { return; }
    const row = listGet(graph, dependency) catch checkGraphEmpty();
    for (x in row) { if (x == user) { return; } }
    listPush(row, user);
}

export function checkGraphPropagate(graph: List<List<int>>, dirty: List<int>): int {
    const queue: List<int> = listNew(); let i = 0;
    while (i < listLen(dirty)) {
        if ((listGet(dirty, i) catch 0) != 0) { listPush(queue, i); }
        i = i + 1;
    }
    i = 0;
    while (i < listLen(queue)) {
        const node = listGet(queue, i) catch -1;
        for (user in listGet(graph, node) catch checkGraphEmpty()) {
            if ((listGet(dirty, user) catch 1) == 0) { listSet(dirty, user, 1); listPush(queue, user); }
        }
        i = i + 1;
    }
    return listLen(queue);
}
