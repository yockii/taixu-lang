// D3 v0.53：箭头函数不继承外层的 await 资格——async 函数里的普通箭头、threadSpawn 入口箭头里再嵌套的箭头都不能
// await；传给 threadSpawn 的具名函数也不是入口（声明 async 后写 threadSpawn(() => await work())）。
async function job(): int {
    return 1;
}

async function outer(): int {
    const f = (): int => {
        const v = await job() catch 0;
        return v;
    };
    return f();
}

function named(): int {
    const v = await job() catch 0;
    return v;
}

function main(args: []string): int {
    const t = threadSpawn((): int => {
            const g = (): int => {
                const w = await job() catch 0;
                return w;
            };
            return g();
        });
    const u = threadSpawn(named);
    const o = await outer() catch 0;
    return 0;
}
