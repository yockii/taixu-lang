// libSystem 的 arc4random_buf 填满目标，无失败返回。
declare function arc4random_buf(data: Bytes, length: usize): void from "libSystem";

export function sysRandomRead(data: Bytes, length: int): int {
    if (length < 0 || length > bytesLen(data)) { return -1; }
    if (length == 0) { return 0; }
    arc4random_buf(data, length as usize);
    return length;
}
