function require(ok: bool): void { assert(ok, "tool security boundary"); }
function names(xs: List< string>): string {
    let out = "";
    let i = 0;
    while (i < listLen(xs)) {
        if (i > 0) { out = out + "|"; }
        out = out + (listGet(xs, i) catch "?");
        i = i + 1;
    }
    return out;
}
function noNames(): List< string> {
    const l: List< string> = listNew();
    return l;
}
function listFails(root: string, rel: string): bool {
    const r = localListDir(root, rel) catch (e) { return true; };
    return listLen(r) < 0;
}
function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    const root = args[0];
    require(localEntryKind(root, "") == 2);
    require(localEntryKind(root, "ok.bin") == 1);
    require((localFileSize(root, "ok.bin") catch -1) == 3);
    const b = readLocalFileBytes(root, "ok.bin", 3) catch (e) { print(e.message); return 1; };
    require(bytesLen(b) == 3);
    require((bytesGet(b, 0) catch -1) == 0 && (bytesGet(b, 1) catch -1) == 255 && (bytesGet(b, 2) catch -1) == 97);
    require(bytesLen(readLocalFileBytes(root, "empty.bin", 0) catch bytesNew(999)) == 0);
    require(bytesLen(readLocalFileBytes(root, "ok.bin", 2) catch bytesNew(0)) == 0);
    require(bytesLen(readLocalFileBytes(root, "ok.bin", -1) catch bytesNew(0)) == 0);
    require(localEntryKind(root, "../outside/secret.bin") == 0);
    require(localEntryKind(root, "junction/secret.bin") == 0);
    require(localEntryKind(root + "/junction", "secret.bin") == 0);
    require((localFileSize(root, "junction/secret.bin") catch -1) == -1);
    require(bytesLen(readLocalFileBytes(root, "junction/secret.bin", 64) catch bytesNew(0)) == 0);
    require(bytesLen(readLocalFileBytes(root, root + "/ok.bin", 64) catch bytesNew(0)) == 0);
    require(localEntryKind(root, "ok.bin\0extra") == 0);
    // localListDir（D3 v0.35）：名字按字节排序、含链接本身的名字但不跟随；链接、非目录、根外、根本身是链接都得 Error。
    require(names(localListDir(root, "") catch noNames()) == "empty.bin|junction|ok.bin|sub");
    require(names(localListDir(root, "sub") catch noNames()) == "Case.tx|中文 名.tx");
    require(listLen(localListDir(root, "junction") catch noNames()) == 0 && listFails(root, "junction"));
    require(listFails(root, "ok.bin") && listFails(root, "../outside") && listFails(root, "missing"));
    require(listFails(root + "/junction", ""));
    if (hostTarget() == "windows") {
        require(localEntryKind("\\\\security-test.invalid\\share", "a") == 0);
        require(localEntryKind(root, "ok.bin:stream") == 0);
        require(localEntryKind(root, "ok.bin.") == 0);
    } else {
        // 跨设备（NO_XDEV）：以 / 为根，同设备的 usr 可达；终点在另一挂载（Linux 的 procfs、macOS 的 devfs）即拒绝。
        require(localEntryKind("/", "usr") == 2);
        if (hostTarget() == "linux") { require(localEntryKind("/", "proc") == 0 && listFails("/", "proc")); }
        if (hostTarget() == "macos") { require(localEntryKind("/", "dev") == 0 && listFails("/", "dev")); }
    }
    // 拒绝／失败后正常读取仍正确，空文件与二进制所有权也进入 leak 模式。
    require((localFileSize(root, "ok.bin") catch -1) == 3);
    require(bytesEqual(b, readLocalFileBytes(root, "ok.bin", 3) catch bytesNew(0)));
    print("PASS_LOCAL_BINARY_METADATA_BOUNDARY_RECOVERY");
    return 0;
}
