// all-ops-probe —— .tx 驱动原生链 shim superset 探针（S5-③）：触碰
// newref/newstruct/getidx/setidx/clone/算术陷阱/str/list 全套——生成代码
// 引用的 __tx_* 慢路径全部活捉进 shim cfg 的 used_syms 面。
const gBoxes: List<Ref<Box>> = listNew();

export function main(args: []string): int {
    const src: string = "hello";
    const s: string = src + "!";
    const c: int = byteAt(s, 0) catch 0;
    let acc: int = c;
    // Ref/newref＋newstruct＋getidx/setidx（struct 与 list 双面）。
    const box: Ref<Box> = new Box { v: 1, tag: "a" };
    box.v = acc + 1;
    // 逃逸面：装入全局 List——逃逸分析证伪帧局部，生成 __tx_newref 直引。
    listPush(gBoxes, box);
    acc = box.v;
    const nums: List<int> = listNew();
    listPush(nums, 3);
    listPush(nums, 4);
    acc = acc + (listGet(nums, 0) catch 0);
    listSet(nums, 1, acc);
    listInsert(nums, 0, 9);
    listRemoveAt(nums, 0);
    acc = acc + (listPop(nums) catch 0);
    // 算术陷阱面（div/mod 消息池＋溢出慢路径——imul 直发不涉 shim）。
    const d: int = acc / 2;
    const m: int = acc % 3;
    const big: int = 4611686018427387904;
    const ovf: int = big + big;
    acc = acc + d + m + ovf * 0;
    // clone 面（值结构浅克隆）。
    const box2: Ref<Box> = box;
    acc = acc + box2.v + len(box2.tag);
    // unary/comparison 慢路径（eq/compare/neg）。
    if (box.v == 2 && acc != 0) { acc = -acc; }
    if (acc < 0) { acc = 0 - acc; }
    const wr = writeFile(".tmp/all-ops-probe.out", toStr(acc));
    print(toStr(acc) + toStr(len(s)) + toStr(len(readFile(".tmp/all-ops-probe.out") catch "y")));
    return 0;
}
struct Box {
    v: int,
    tag: string,
}
