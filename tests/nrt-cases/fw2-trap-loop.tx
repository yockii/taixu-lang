// O4 第二步 2b：内联快路径在循环里检出溢出，经冷路径 trap 4004（位置与消息同运行期例程）。
function bump(x: u8, k: u8): u8 {
    return x + k;
}

export function main(args: []string): int {
    let v: u8 = 250;
    let i = 0;
    while (i < 10) {
        v = bump(v, 1);
        print(toStr(v));
        i = i + 1;
    }
    return 0;
}
