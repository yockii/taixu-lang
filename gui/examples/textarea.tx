// textarea —— 多行编辑器示例：TextArea 行结构控件消费
// 样本——多行键入（RETURN 分行）＋方向键跨行导航＋shift 延伸多行选区
// ＋退格/删除＋滚动跟随（行数超视口）＋IME 文本通道（EV_TEXT 臂）。
//
// 确定性校验：
//   TAIXU_REPLAY=tests/textarea-replay.txt TAIXU_FRAME=N TAIXU_OUT_DIR=tests/.rv-out taixu run examples/textarea.tx
// 状态行输出＝行数/光标 (行,列)/scroll——纯函数可锚；golden 三伴随 verify ⑥。
import { Canvas, TextArea, textArea, drawTextAreaC, taText, taSel, paintText, paintFillRect } from "gui/components";
import { App, appNew, appClose, pump, textCursor, taOnKeys, defaultSpec } from "gui/app";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_TA: int = 7;

struct Model {
    ta: Ref<TextArea>,
    surface: int,
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x14181E);
    paintText(cv, 8, 4, 0xC8D8E8, "taixu textarea");
    m.ta.x = 8;
    m.ta.y = 22;
    m.ta.w = app.w - 16;
    m.ta.h = app.h - 48;
    drawTextAreaC(cv, m.ta);
    const sel = taSel(m.ta);
    paintText(cv, 8, app.h - 20, 0x88A0B0, "lines=" + toStr(listLen(m.ta.lines)) + " cursor=(" + toStr(m.ta.cl) + "," + toStr(m.ta.cc) + ") scroll=" + toStr(m.ta.scroll) + " sel=" + toStr(sel.active));
}

export function main(args: []string): int {
    args;
    const spec = defaultSpec("taixu textarea", 320, 240);
    const app = appNew(spec);
    const m: Ref<Model> = new Model {
        ta: textArea(ID_TA, 8, 22, 304, 192, "line-1\nline-2\nline-3"),
        surface: surfaceOpen(spec.w, spec.h) catch 0,
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    textCursor(app, ID_TA);
    taOnKeys(app, m.ta, 12);
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvas(m.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("lines=" + toStr(listLen(m.ta.lines)) + " text-ends=" + toStr(len(taText(m.ta))) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
