// NRT clone hooks and the native handlers' trap message maps
// (messages mirror src/tools/aot_shim.zig byte for byte).
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtCall5, rtRet, rtRetVoid } from "./rtfn";
import { ARITY, check, trapText, trapAt, arity, text, memcpyName } from "./nrt_base";
import { FW_OP_BASE, fwKindName, fwKindBits, fwKindSigned } from "./fw_ops";

// D3 v0.19 结构化错误。富 Error 对象＝值标签 5 指向 struct 形容器（对象种类 3、载荷 values），
// 五个值：0 message(str) 1 种类名(str) 2 类型号(int；errWrap 为 -1) 3 错误 enum 变体载荷(enumv/None)
// 4 原因(Error/None)。普通 err(...) 仍是字节对象（载荷种类 0）。释放走容器级联；克隆对标签 5 是句柄复制。
export const NRT_ERROR_EXPORTS: string = "__tx_nrt_err_msgobj __tx_nrt_err_text __tx_bi_err_rich __tx_bi_err_payload __tx_bi_err_cause __tx_bi_err_as __tx_bi_err_wrap";

export function emitNrtErrors(b: Ref<StructuredBuffer>): void {
    // __tx_clone(win, fn, pc, a, bsrc): owned deep clone of win[bsrc] into win[a].
    let f = rtBegin(b, "__tx_clone", "win fn pc a bs", "st sp ot op ctx sa oa ca", 4, "bootstrap/selfhost/nrt_errors.tx");
    rtOp(f, "sa", L("bs"), "and", I(4294967295)); rtShift(f, "sa", L("sa"), "shl", 4); rtOp(f, "sa", L("sa"), "add", L("win"));
    rtLoad(f, "st", L("sa"), 0, 8); rtLoad(f, "sp", L("sa"), 8, 8);
    rtOp(f, "ctx", L("fn"), "and", I(4294967295)); rtShift(f, "ca", L("pc"), "shl", 32); rtOp(f, "ctx", L("ctx"), "or", L("ca"));
    rtAddrOf(f, "sa", "st"); rtAddrOf(f, "oa", "ot"); rtAddrOf(f, "ca", "ctx");
    rtCall4(f, "", "__tx_native_clone_v1", L("sa"), I(0), L("ca"), L("oa"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("ot"), L("op"));
    rtRetVoid(f); check(f);

    // __tx_store_clone_depth(ctx*): resource_depth trap.
    f = rtBegin(b, "__tx_store_clone_depth", "ctx", "fn pc", 5, "bootstrap/selfhost/nrt_errors.tx");
    rtLoad(f, "fn", L("ctx"), 0, 4); rtLoad(f, "pc", L("ctx"), 4, 4);
    trapText(b, f, 4007, "值克隆深度超限");
    rtRetVoid(f); check(f);

    // __tx_store_clone_view(value*, ctx*, out*) → kind (0 = handle copy).
    f = rtBegin(b, "__tx_store_clone_view", "vp ctx out", "tag o r fn pc", 5, "bootstrap/selfhost/nrt_errors.tx");
    rtLoad(f, "tag", L("vp"), 0, 1);
    rtIf(f, L("tag"), "eq", I(7), "obj"); rtIf(f, L("tag"), "eq", I(8), "obj"); rtIf(f, L("tag"), "eq", I(9), "obj"); rtIf(f, L("tag"), "eq", I(10), "obj");
    rtStore(f, L("out"), 0, I(0), 8); rtStore(f, L("out"), 8, I(0), 8); rtStore(f, L("out"), 16, I(0), 8); rtStore(f, L("out"), 24, I(0), 8);
    rtRet(f, I(0));
    rtLabel(f, "obj");
    rtLoad(f, "o", L("vp"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    rtCall3(f, "r", "__tx_native_object_clone_view_v1", L("o"), L("tag"), L("out"));
    rtOp(f, "r", L("r"), "and", I(4294967295));
    rtIf(f, L("r"), "eq", I(5), "bad");
    rtRet(f, L("r"));
    rtLabel(f, "bad");
    rtLoad(f, "fn", L("ctx"), 0, 4); rtLoad(f, "pc", L("ctx"), 4, 4);
    trapText(b, f, 4010, "克隆目标载荷异常");
    rtRetVoid(f); check(f);

    // __tx_store_clone_materialize(view*, ptr, ctx*) → idx of the new value box.
    f = rtBegin(b, "__tx_store_clone_materialize", "view ptr ctx", "k ty meta n s0 s1 s2 s3 s4 s5 s6 s7 sp", 1, "bootstrap/selfhost/nrt_errors.tx");
    rtLoad(f, "k", L("view"), 0, 4); rtLoad(f, "ty", L("view"), 4, 4); rtLoad(f, "meta", L("view"), 8, 4); rtLoad(f, "n", L("view"), 24, 8);
    rtShift(f, "s0", L("ty"), "shl", 32);
    rtSet(f, "s2", L("ptr")); rtSet(f, "s3", L("n")); rtSet(f, "s4", I(0)); rtSet(f, "s5", I(0)); rtSet(f, "s6", I(4)); rtSet(f, "s7", I(0));
    rtIf(f, L("k"), "eq", I(2), "enum");
    rtIf(f, L("k"), "eq", I(3), "arr");
    rtOp(f, "s0", L("s0"), "or", I(3)); rtSet(f, "s1", I(4294967296)); rtJump(f, "make");
    rtLabel(f, "enum");
    rtOp(f, "s0", L("s0"), "or", I(4)); rtSet(f, "s1", I(8589934592)); rtSet(f, "s5", L("meta")); rtJump(f, "make");
    rtLabel(f, "arr");
    rtOp(f, "s0", L("s0"), "or", I(6)); rtSet(f, "s1", I(12884901888)); rtSet(f, "s5", L("meta"));
    rtLabel(f, "make");
    rtAddrOf(f, "sp", "s0"); rtCall1(f, "s0", "__tx_native_object_create_v1", L("sp"));
    rtRet(f, L("s0")); check(f);

    // __tx_native_error_message_v1(idx, fn, pc, out*): Error.message as a new string.
    f = rtBegin(b, "__tx_native_error_message_v1", "idx fn pc out", "o p n", 3, "bootstrap/selfhost/nrt_errors.tx");
    rtCall1(f, "o", "__tx_nrt_err_msgobj", L("idx"));
    rtLoad(f, "p", L("o"), 32, 8); rtLoad(f, "n", L("o"), 40, 8);
    rtCall3(f, "o", "__tx_nrt_str_copy", L("p"), L("n"), I(1));
    rtStore(f, L("out"), 0, I(6), 8); rtStore(f, L("out"), 8, L("o"), 8);
    rtRetVoid(f); check(f);

    emitRichErrors(b);

    // __tx_native_object_handler_error_v1(op, status, fn, pc): field/index traps.
    f = rtBegin(b, "__tx_native_object_handler_error_v1", "op status fn pc", "", 5, "bootstrap/selfhost/nrt_errors.tx");
    rtOp(f, "op", L("op"), "and", I(4294967295)); rtOp(f, "status", L("status"), "and", I(4294967295));
    rtIf(f, L("op"), "eq", I(4), "notfn");
    rtIf(f, L("status"), "eq", I(8), "frozen");
    rtIf(f, L("status"), "eq", I(4), "idxint");
    rtIf(f, L("status"), "eq", I(5), "autoderef");
    rtIf(f, L("status"), "eq", I(6), "errmsg");
    rtIf(f, L("status"), "eq", I(3), "bounds");
    rtIf(f, L("status"), "eq", I(7), "bounds");
    rtIf(f, L("status"), "eq", I(2), "payload");
    rtIf(f, L("op"), "eq", I(0), "fieldget");
    rtIf(f, L("op"), "eq", I(1), "fieldset");
    rtIf(f, L("op"), "eq", I(2), "indexget");
    trapText(b, f, 4010, "索引写目标不是数组/切片");
    trapAt(b, f, "notfn", 4010, "调用目标不是函数");
    trapAt(b, f, "idxint", 4010, "索引不是 int");
    trapAt(b, f, "autoderef", 4010, "自动解引用标志但值不是 Ref");
    trapAt(b, f, "errmsg", 4010, "Error 只有 message 字段");
    rtLabel(f, "bounds");
    rtIf(f, L("op"), "lt", I(2), "fieldbounds");
    rtIf(f, L("status"), "eq", I(7), "slicebounds");
    trapText(b, f, 4002, "数组索引越界");
    trapAt(b, f, "slicebounds", 4002, "切片索引越界");
    trapAt(b, f, "fieldbounds", 4012, "字段索引越界");
    rtLabel(f, "payload");
    rtIf(f, L("op"), "ne", I(0), "payloadset");
    trapText(b, f, 4010, "字段访问目标不是 struct/enum 载荷");
    trapAt(b, f, "payloadset", 4010, "字段写目标不是 struct/enum 载荷");
    trapAt(b, f, "fieldget", 4010, "字段访问目标不是 struct/enum");
    trapAt(b, f, "fieldset", 4010, "字段写目标不是 struct/enum");
    trapAt(b, f, "indexget", 4010, "索引访问目标不是数组/切片");
    // 线程第 4b 步：写冻结对象（op 1 字段写、3 下标写）。
    rtLabel(f, "frozen");
    rtIf(f, L("op"), "eq", I(3), "frozenidx");
    trapText(b, f, 4022, "字段赋值写入了冻结的对象（来自 Shared，深度不可变）");
    trapAt(b, f, "frozenidx", 4022, "下标赋值写入了冻结的数组（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);

    // __tx_native_handler_error_v1(op, status, fn, pc): scalar window handler traps.
    f = rtBegin(b, "__tx_native_handler_error_v1", "op status fn pc", "t o", 5, "bootstrap/selfhost/nrt_errors.tx");
    rtOp(f, "op", L("op"), "and", I(4294967295)); rtOp(f, "status", L("status"), "and", I(4294967295));
    rtIf(f, L("op"), "ge", I(FW_OP_BASE), "fw");
    rtIf(f, L("op"), "ge", I(100), "cvt");
    rtIf(f, L("op"), "eq", I(12), "depth");
    rtIf(f, L("status"), "eq", I(7), "fmod");
    rtIf(f, L("status"), "eq", I(8), "cmpnum");
    rtIf(f, L("op"), "ne", I(37), "scalar");
    rtIf(f, L("status"), "eq", I(6), "f2i");
    rtLabel(f, "scalar");
    rtIf(f, L("status"), "eq", I(2), "overflow");
    rtIf(f, L("status"), "eq", I(3), "divzero");
    rtIf(f, L("status"), "eq", I(4), "shift");
    // Type messages by op.
    rtIf(f, L("op"), "eq", I(10), "tneg");
    rtIf(f, L("op"), "eq", I(11), "tnot");
    rtIf(f, L("op"), "eq", I(43), "tbnot");
    rtIf(f, L("op"), "eq", I(36), "ti2f");
    rtIf(f, L("op"), "eq", I(37), "tf2i");
    rtIf(f, L("op"), "eq", I(16), "tjump");
    rtIf(f, L("op"), "eq", I(13), "tcmp");
    rtIf(f, L("op"), "eq", I(14), "tcmp");
    rtIf(f, L("op"), "lt", I(5), "tother");
    rtIf(f, L("op"), "le", I(9), "tarith");
    rtIf(f, L("op"), "lt", I(40), "tother");
    rtIf(f, L("op"), "le", I(42), "tarith");
    rtIf(f, L("op"), "lt", I(44), "tother");
    rtIf(f, L("op"), "le", I(47), "tarith");
    rtLabel(f, "tother");
    trapText(b, f, 4010, "原生 handler 操作数异常");
    trapAt(b, f, "depth", 4007, "相等比较深度超限");
    trapAt(b, f, "fmod", 4010, "float 不支持 % 运算");
    trapAt(b, f, "cmpnum", 4010, "比较操作数不是数值");
    trapAt(b, f, "f2i", 4005, "float 转 int 精度损失越界");
    rtLabel(f, "overflow");
    rtIf(f, L("op"), "eq", I(5), "oadd");
    rtIf(f, L("op"), "eq", I(6), "osub");
    rtIf(f, L("op"), "eq", I(7), "omul");
    rtIf(f, L("op"), "eq", I(8), "odiv");
    trapText(b, f, 4004, "int 取负溢出");
    trapAt(b, f, "oadd", 4004, "int 加法溢出");
    trapAt(b, f, "osub", 4004, "int 减法溢出");
    trapAt(b, f, "omul", 4004, "int 乘法溢出");
    trapAt(b, f, "odiv", 4004, "int 除法溢出");
    rtLabel(f, "divzero");
    rtIf(f, L("op"), "eq", I(9), "modzero");
    trapText(b, f, 4001, "除数为零");
    trapAt(b, f, "modzero", 4001, "模运算除数为零");
    trapAt(b, f, "shift", 4016, "移位计数越界（须 0..63）");
    trapAt(b, f, "tneg", 4010, "neg 的操作数不是数值");
    trapAt(b, f, "tnot", 4010, "not 的操作数不是 bool");
    trapAt(b, f, "tbnot", 4010, "bnot 的操作数不是 int");
    trapAt(b, f, "ti2f", 4010, "as float 的操作数不是 int");
    trapAt(b, f, "tf2i", 4010, "as int 的操作数不是 float");
    trapAt(b, f, "tjump", 4010, "条件跳转的操作数不是 bool");
    trapAt(b, f, "tcmp", 4010, "比较两侧类型不一致");
    trapAt(b, f, "tarith", 4010, "算术操作数类型不匹配");
    // 定宽数值转换（op＝100＋种类，scalar_ops cvtOpsEmit）：状态 9 收窄越界 4018，状态 6 浮点转整数越界 4005。
    rtLabel(f, "cvt");
    rtIf(f, L("status"), "eq", I(6), "cvtf");
    rtIf(f, L("status"), "ne", I(9), "tother");
    rtIf(f, L("op"), "eq", I(101), "n1"); rtIf(f, L("op"), "eq", I(102), "n2"); rtIf(f, L("op"), "eq", I(103), "n3");
    rtIf(f, L("op"), "eq", I(104), "n4"); rtIf(f, L("op"), "eq", I(105), "n5"); rtIf(f, L("op"), "eq", I(106), "n6");
    rtIf(f, L("op"), "eq", I(107), "n7"); rtIf(f, L("op"), "eq", I(117), "n17");
    trapText(b, f, 4018, "数值转换越界");
    trapAt(b, f, "n1", 4018, "as i8 越界（须在 -128..127）");
    trapAt(b, f, "n2", 4018, "as i16 越界（须在 -32768..32767）");
    trapAt(b, f, "n3", 4018, "as i32 越界（须在 -2147483648..2147483647）");
    trapAt(b, f, "n4", 4018, "as u8 越界（须在 0..255）");
    trapAt(b, f, "n5", 4018, "as u16 越界（须在 0..65535）");
    trapAt(b, f, "n6", 4018, "as u32 越界（须在 0..4294967295）");
    trapAt(b, f, "n7", 4018, "有符号与无符号 64 位互转越界（负数不能转为 u64/usize，2^63 及以上不能转为 int/isize）");
    trapAt(b, f, "n17", 4018, "as f32 越界（超出 f32 有限范围）");
    trapAt(b, f, "cvtf", 4005, "float 转定宽整数越界（含 NaN）");
    fwErrors(b, f);
    rtRetVoid(f); check(f);
}

// 定宽数值运算族（O4 第二步，op＝字节码操作码，scalar_fw）：状态 2 溢出 4004（消息写明类型与运算），
// 3 除数为零 4001（文案同 int），4 移位计数越界 4016（写明类型的宽度），其余 4010。
function fwErrors(b: Ref<StructuredBuffer>, f: Ref<RtFn>): void {
    rtLabel(f, "fw");
    rtOp(f, "t", L("op"), "sub", I(FW_OP_BASE)); rtOp(f, "o", L("t"), "and", I(15)); rtShift(f, "t", L("t"), "shr", 4);
    rtIf(f, L("status"), "eq", I(3), "fwzero");
    rtIf(f, L("status"), "eq", I(4), "fwshift");
    rtIf(f, L("status"), "ne", I(2), "fwbad");
    let t = 1;
    while (t <= 9) {
        rtIf(f, L("t"), "eq", I(t), "fwo" + toStr(t));
        t = t + 1;
    }
    rtJump(f, "fwbad");
    t = 1;
    while (t <= 9) {
        const tn = fwKindName(t);
        rtLabel(f, "fwo" + toStr(t));
        rtIf(f, L("o"), "eq", I(1), "fwo" + toStr(t) + "_1");
        rtIf(f, L("o"), "eq", I(2), "fwo" + toStr(t) + "_2");
        rtIf(f, L("o"), "eq", I(3), "fwo" + toStr(t) + "_3");
        if (fwKindSigned(t)) { rtIf(f, L("o"), "eq", I(5), "fwo" + toStr(t) + "_5"); }
        trapText(b, f, 4004, tn + " 加法溢出");
        trapAt(b, f, "fwo" + toStr(t) + "_1", 4004, tn + " 减法溢出");
        trapAt(b, f, "fwo" + toStr(t) + "_2", 4004, tn + " 乘法溢出");
        trapAt(b, f, "fwo" + toStr(t) + "_3", 4004, tn + " 除法溢出");
        if (fwKindSigned(t)) { trapAt(b, f, "fwo" + toStr(t) + "_5", 4004, tn + " 取负溢出"); }
        t = t + 1;
    }
    rtLabel(f, "fwzero");
    rtIf(f, L("o"), "eq", I(4), "fwmodzero");
    trapText(b, f, 4001, "除数为零");
    trapAt(b, f, "fwmodzero", 4001, "模运算除数为零");
    rtLabel(f, "fwshift");
    t = 1;
    while (t <= 9) {
        rtIf(f, L("t"), "eq", I(t), "fws" + toStr(t));
        t = t + 1;
    }
    rtJump(f, "fwbad");
    t = 1;
    while (t <= 9) {
        trapAt(b, f, "fws" + toStr(t), 4016, "移位计数越界（" + fwKindName(t) + " 须 0.." + toStr(fwKindBits(t) - 1) + "）");
        t = t + 1;
    }
    trapAt(b, f, "fwbad", 4010, "定宽数值运算的操作数异常");
}

// 富错误对象：values（5 个值）就绪后建 struct 形容器，结果写入 win[a]（标签 5）。
function richMake(f: Ref<RtFn>): void {
    rtSet(f, "s0", I(3)); rtSet(f, "s1", I(4294967296));
    rtSet(f, "s2", L("vals")); rtSet(f, "s3", I(5)); rtSet(f, "s4", I(0)); rtSet(f, "s5", I(0)); rtSet(f, "s6", I(4)); rtSet(f, "s7", I(0));
    rtAddrOf(f, "sp", "s0");
    rtCall1(f, "s0", "__tx_native_object_create_v1", L("sp"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(5), L("s0"));
    rtRetVoid(f);
}

// errPayload/errCause：富错误第 k 个值（新引用）；普通 Error 得 None。
function richField(b: Ref<StructuredBuffer>, name: string, off: int): void {
    const f = rtBegin(b, name, "win fn pc a nargs", "v o t p", 5, "bootstrap/selfhost/nrt_errors.tx");
    arity(b, f, 1);
    rtCall3(f, "v", "__tx_nrt_arg", L("win"), L("a"), I(0));
    rtSet(f, "t", I(4)); rtSet(f, "p", I(0));
    rtLoad(f, "o", L("v"), 0, 1); rtIf(f, L("o"), "ne", I(5), "set");
    rtLoad(f, "o", L("v"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    rtLoad(f, "t", L("o"), 16, 4); rtIf(f, L("t"), "eq", I(0), "plain");
    rtLoad(f, "o", L("o"), 32, 8); rtOp(f, "v", L("o"), "add", I(off));
    rtCall1(f, "", "__tx_retain", L("v"));
    rtLoad(f, "t", L("v"), 0, 8); rtLoad(f, "p", L("v"), 8, 8);
    rtJump(f, "set");
    rtLabel(f, "plain"); rtSet(f, "t", I(4)); rtSet(f, "p", I(0));
    rtLabel(f, "set");
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("t"), L("p"));
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtRetVoid(f); check(f);
}

function emitRichErrors(b: Ref<StructuredBuffer>): void {
    // __tx_nrt_err_msgobj(idx) → 消息字节所在对象的地址（普通 Error 即自身）。
    let f = rtBegin(b, "__tx_nrt_err_msgobj", "idx", "o pk v", 1, "bootstrap/selfhost/nrt_errors.tx");
    rtCall1(f, "o", "__tx_native_object_address_v1", L("idx"));
    rtLoad(f, "pk", L("o"), 16, 4);
    rtIf(f, L("pk"), "eq", I(0), "plain");
    rtLoad(f, "v", L("o"), 32, 8); rtLoad(f, "v", L("v"), 8, 4);
    rtCall1(f, "o", "__tx_native_object_address_v1", L("v"));
    rtLabel(f, "plain");
    rtRet(f, L("o")); check(f);

    // __tx_nrt_err_text(idx) → 新 str：普通 "Error: 消息"；富错误 "种类名: 消息"，有原因时追加 "；原因：" + 原因文本。
    const prefix = text(b, "Error: ");
    const colon = text(b, ": ");
    const sep = "；原因：";
    const sepText = text(b, sep);
    f = rtBegin(b, "__tx_nrt_err_text", "idx", "o pk v kp kn mp mn cs cp cn total q at t bt bp", 3, "bootstrap/selfhost/nrt_errors.tx");
    rtCall1(f, "o", "__tx_native_object_address_v1", L("idx"));
    rtLoad(f, "pk", L("o"), 16, 4);
    rtIf(f, L("pk"), "ne", I(0), "rich");
    rtLoad(f, "mp", L("o"), 32, 8); rtLoad(f, "mn", L("o"), 40, 8);
    rtOp(f, "total", L("mn"), "add", I(7));
    rtCall2(f, "q", "__tx_native_mem_alloc", L("total"), I(1)); rtIf(f, L("q"), "eq", I(0), "oom");
    rtCall3(f, "", memcpyName(), L("q"), A(prefix), I(7));
    rtOp(f, "t", L("q"), "add", I(7));
    rtCall3(f, "", memcpyName(), L("t"), L("mp"), L("mn"));
    rtCall3(f, "q", "__tx_store_new_str_take", L("q"), L("total"), I(0));
