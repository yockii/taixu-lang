// D3 v0.49 §6.4-3：switch 臂按期望类型检查；没有期望类型时 T 臂＋Error 臂合成 T | Error、
// T 臂＋None 臂合成 T?、T 臂＋同一错误 enum 合成 T | 该 enum；None 臂排在最前也行。
enum J { S(s: string), N(n: int), B }
enum ParseErr extends Error { Empty = "空", Bad(at: int) = `第 ${at} 处` }

function asStr(j: J): string? {
    return switch (j) {
        case S(s) => s,
        else => None,
    };
}

function noneFirst(j: J): string? {
    return switch (j) {
        case B => None,
        case S(s) => s,
        case N(n) => toStr(n),
    };
}

function asStrE(j: J): string | Error {
    const r: string | Error = switch (j) {
        case S(s) => s,
        else => err("不是串"),
    };
    return r;
}

function inferred(j: J): int {
    const r = switch (j) {
        case N(n) => n,
        case S(s) => err("是串 " + s),
        case B => err("是 B"),
    };
    const v: int = r catch -1;
    return v;
}

function inferredOpt(j: J): int {
    const r = switch (j) {
        case B => None,
        case N(n) => n,
        else => None,
    };
    return r ?? -2;
}

function enumFail(j: J): int | ParseErr {
    return switch (j) {
        case N(n) => n,
        case B => ParseErr.Empty,
        else => ParseErr.Bad(3),
    };
}

export function main(args: []string): int {
    args;
    print((asStr(J.S("甲")) ?? "-") + " " + (asStr(J.B) ?? "-"));
    print((noneFirst(J.B) ?? "-") + " " + (noneFirst(J.N(7)) ?? "-"));
    print(asStrE(J.S("乙")) catch "错");
    print(asStrE(J.N(1)) catch "错");
    print(toStr(inferred(J.N(5))) + " " + toStr(inferred(J.B)));
    print(toStr(inferredOpt(J.N(4))) + " " + toStr(inferredOpt(J.B)));
    print(toStr(enumFail(J.N(8)) catch -1));
    enumFail(J.S("x")) catch (e) {
        print("失败：" + toStr(e));
        return 0;
    };
    return 1;
}
