// ============================================================================
// stdlib 异步验证：std/task TaskGroup limit 批环（V0.9-A2；verify ⑤ 段——
// 同步 test 块无暂停点，收割断言走主程序＋.out 逐字节比对）。
// 红线：完成序＝裁决序（FIFO＋插入序）；limit 窗口确定；失败槽计 failed。
// ============================================================================

import { TaskGroup, taskGroupNew, taskGroupAdd, taskGroupDrain, taskGroupFailed } from "std/task";

async function five(): int {
    return 5;
}

async function seven(): int {
    return 7;
}

async function nine(): int {
    return 9;
}

async function bad(): int {
    return err("task-level failure");
}

// 收割观察者：await drain 的 Future 并逐项打印（泵中执行——main 同步体之后）。
async function reporter(rs: Future<List<int>>, tg: Ref<TaskGroup>): void {
    const xs = (await rs catch err("drain failed"))?;
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch -1;
        print("result:" + toStr(v));
        i = i + 1;
    }
    print("failed:" + toStr(taskGroupFailed(tg)));
}

function main(args: []string): int {
    const tg = taskGroupNew();
    taskGroupAdd(tg, five());
    taskGroupAdd(tg, seven());
    taskGroupAdd(tg, nine());
    taskGroupAdd(tg, bad()); // 体级失败槽：计 failed 不入结果
    const rs = taskGroupDrain(tg, 2); // limit=2 批环
    reporter(rs, tg);
    print("main-done");
    return 0;
}
