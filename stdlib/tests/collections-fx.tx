// ============================================================================
// stdlib 用例：collections 高阶工具（V0.23-S1 扩批；STD-04）
// 运行：taixu test tests/collections-fx.tx
// ============================================================================

import { range, reverseInt, takeInt, dropInt, mapInt, filterInt, foldInt, sumInt, maxInt } from "std/collections";

test "range：区间与空表" {
    const r = range(2, 6);
    assert(listLen(r) == 4, "应 4 元");
    assert((listGet(r, 0) catch 0) == 2 && (listGet(r, 3) catch 0) == 5, "值序正确");
    assert(listLen(range(5, 5)) == 0, "空区间");
    assert(listLen(range(6, 2)) == 0, "逆区间为空");
}

test "reverseInt／takeInt／dropInt" {
    const xs = range(0, 5);
    const rv = reverseInt(xs);
    assert((listGet(rv, 0) catch 0) == 4 && (listGet(rv, 4) catch 0) == 0, "倒序");
    assert(listLen(takeInt(xs, 2)) == 2 && (listGet(takeInt(xs, 2), 1) catch 0) == 1, "取前");
    assert(listLen(takeInt(xs, 99)) == 5, "越界取全");
    assert(listLen(dropInt(xs, 3)) == 2 && (listGet(dropInt(xs, 3), 0) catch 0) == 3, "去前");
}

test "mapInt／filterInt／foldInt" {
    const xs = range(1, 5);
    const dbl = mapInt(xs, (v: int): int => v * 2);
    assert((listGet(dbl, 0) catch 0) == 2 && (listGet(dbl, 3) catch 0) == 8, "映射");
    const evens = filterInt(xs, (v: int): bool => v % 2 == 0);
    assert(listLen(evens) == 2 && (listGet(evens, 1) catch 0) == 4, "过滤");
    const total = foldInt(xs, 0, (a: int, b: int): int => a + b);
    assert(total == 10, "折叠求和");
    assert(sumInt(xs) == 10, "sum 定式");
    assert(maxInt(xs) == 4, "max 定式");
    assert(sumInt(range(0, 0)) == 0, "空表 sum");
}
