// LSP 内建表的门。。
//
// bootstrap/selfhost/lsp_builtins.tx 是 hover、signatureHelp、completion 用的内建表。本门是纯源码检查：
// 1. 表里每一条的签名等于 D3（docs/design/ 下版本号最大的 D3-s1-language-spec-v*.md）§7 内建表同名行的签名，按固定规则转写成
//    `function 名<型参>(参数): 返回`（D3 的写法有 `(参数) 返回` 与 `名<型参>(参数) 返回` 两种）；
// 2. 表的名字集合等于 D3 §7 的名字集合，也等于 semamirror 的 builtinOf 认的、用户能写的名字（不含 `#` 开头与 `__rt` 开头的内部内建）
//    ——三者任何一处增删都须同步；
// 3. 表里“仅 --toolchain”的标记与 builtinOf 的号段一致（35 writeExecutable、50..56、79 hostArch、86 setEnv、3584..3615，同 semamirror
//    的 checkSysBuiltin、checkToolBuiltin 与 35 号的检查；D3 v0.52 起 26 strSub、27 strIndexOf、87 strByteSub、88 strByteIndexOf 只在
//    种子换代前的 --toolchain 构建里收，同 semamirror 的 strOldNameDiag）。
//
// 运行（仓根）：taixu run --toolchain scripts/test_lsp_builtins.tx [--root 仓库根]
// 任何 FAIL 时退出码 1。
import { join, nat, readBytes, startsWith } from "./build_lib";
import { byteSub, indexOf, reprStr, sorted } from "./test_text";
import { lossyText } from "./check_lib";

struct Row {
    name: string,
    sig: string,
    doc: string,
    tool: bool,
}

function readText(root: string, rel: string): string {
    const b = readBytes(nat(join(root, rel))) catch (e) {
        return "";
    };
    return lossyText(b);
}

function isDigit(c: int): bool {
    return c >= 48 && c <= 57;
}

function identStart(c: int): bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

function identChar(c: int): bool {
    return identStart(c) || isDigit(c);
}

function tail(s: string, from: int): string {
    return byteSub(s, from, len(s) - from);
}

// docs/design 下版本号最大的 D3-s1-language-spec-v<主>.<次>.md。
function latestD3(root: string): string {
    const prefix = "D3-s1-language-spec-v";
    let best = "";
    let bestMajor = -1;
    let bestMinor = -1;
    const names = listDir(nat(join(root, "docs/design"))) catch (e) {
        return "";
    };
    for (n in names) {
        if (!startsWith(n, prefix) || len(n) < len(prefix) + 6 || byteSub(n, len(n) - 3, 3) != ".md") {
            continue;
        }
        const v = byteSub(n, len(prefix), len(n) - len(prefix) - 3);
        const dot = indexOf(v, ".");
        if (dot <= 0 || dot == len(v) - 1 || !allDigits(byteSub(v, 0, dot)) || !allDigits(tail(v, dot + 1))) {
            continue;
        }
        const major = num(byteSub(v, 0, dot));
        const minor = num(tail(v, dot + 1));
        if (major > bestMajor || (major == bestMajor && minor > bestMinor)) {
            bestMajor = major;
            bestMinor = minor;
            best = n;
        }
    }
    return best;
}

function allDigits(s: string): bool {
    if (len(s) == 0) {
        return false;
    }
    let i = 0;
    while (i < len(s)) {
        if (!isDigit(byteAt(s, i) ?? 0)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

function num(s: string): int {
    let v = 0;
    let i = 0;
    while (i < len(s)) {
        v = v * 10 + ((byteAt(s, i) ?? 48) - 48);
        i = i + 1;
    }
    return v;
}

// §7 内建表的行：`| \`名\` | \`签名\` |`（签名里的 `\|` 还原成 `|`）。
function d3Rows(text: string): List<Row> {
    const out: List<Row> = listNew();
    const at = indexOf(text, "## 7. 内建函数与程序入口");
    if (at < 0) {
        return out;
    }
    let sec = tail(text, at);
    const end = indexOf(tail(sec, 10), "\n## ");
    if (end >= 0) {
        sec = byteSub(sec, 0, end + 10);
    }
    for (line in strSplit(sec, "\n")) {
        const l = stripCr(line);
        if (!startsWith(l, "| `")) {
            continue;
        }
        let i = 3;
        if (i >= len(l) || !identStart(byteAt(l, i) ?? 0)) {
            continue;
        }
        while (i < len(l) && identChar(byteAt(l, i) ?? 0)) {
            i = i + 1;
        }
        const name = byteSub(l, 3, i - 3);
        if (byteSub(l, i, 5) != "` | `") {
            continue;
        }
        i = i + 5;
        const from = i;
        let ok = false;
        while (i < len(l)) {
            const c = byteAt(l, i) ?? 0;
            if (c == 96) {
                ok = true;
                break;
            }
            if (c == 92) {
                i = i + 2;
            } else {
                i = i + 1;
            }
        }
        if (!ok || i > len(l) || byteSub(l, i, 3) != "` |") {
            continue;
        }
        listPush(out, Row { name: name, sig: replaceAll(byteSub(l, from, i - from), "\\|", "|"), doc: "", tool: false });
    }
    return out;
}

// Python 逐行时 splitlines 已去掉 \r。
function stripCr(s: string): string {
    if (len(s) > 0 && (byteAt(s, len(s) - 1) ?? 0) == 13) {
        return byteSub(s, 0, len(s) - 1);
    }
    return s;
}

function replaceAll(s: string, a: string, b: string): string {
    const parts = strSplit(s, a);
    let out = "";
    let i = 0;
    while (i < listLen(parts)) {
        if (i > 0) {
            out = out + b;
        }
        out = out + (listGet(parts, i) catch "");
        i = i + 1;
    }
    return out;
}

function trim(s: string): string {
    let i = 0;
    let j = len(s);
    while (i < j && isSpaceByte(byteAt(s, i) ?? 0)) {
        i = i + 1;
    }
    while (j > i && isSpaceByte(byteAt(s, j - 1) ?? 0)) {
        j = j - 1;
    }
    return byteSub(s, i, j - i);
}

function isSpaceByte(c: int): bool {
    return c == 32 || c == 9 || c == 10 || c == 13 || c == 11 || c == 12;
}

// D3 的签名 → `function name<tps>(params): ret`；没有参数表得错误。
function convert(name: string, sig: string): string | Error {
    let s = trim(sig);
    if (startsWith(s, name)) {
        s = tail(s, len(name));
    }
    let tps = "";
    if (startsWith(s, "<")) {
        let depth = 0;
        let i = 0;
        while (i < len(s)) {
            const c = byteAt(s, i) ?? 0;
            if (c == 60) {
                depth = depth + 1;
            } else if (c == 62) {
                depth = depth - 1;
            }
            if (depth == 0) {
                tps = byteSub(s, 0, i + 1);
                s = tail(s, i + 1);
                break;
            }
            i = i + 1;
        }
    }
    if (!startsWith(s, "(")) {
        return err("signature of " + name + " has no parameter list: " + reprStr(sig));
    }
    let depth = 0;
    let i = 0;
    let params = s;
    let rest = "";
    while (i < len(s)) {
        const c = byteAt(s, i) ?? 0;
        if (c == 40) {
            depth = depth + 1;
        } else if (c == 41) {
            depth = depth - 1;
        }
        if (depth == 0) {
            params = byteSub(s, 0, i + 1);
            rest = tail(s, i + 1);
            break;
        }
        i = i + 1;
    }
    let ret = trim(rest);
    if (startsWith(ret, ":")) {
        ret = trim(tail(ret, 1));
    }
    return "function " + name + tps + params + ": " + ret;
}

struct Ids {
    names: List<string>,
    ids: List<int>,
}

// semamirror 的 builtinOf：每个 `if (…) { return 号; }` 的条件里的 name == "名"。
function builtinIds(text: string): Ref<Ids> {
    const out = new Ids { names: listNew(), ids: listNew() };
    const head = "function builtinOf(name: string): int {";
    const at = indexOf(text, head);
    if (at < 0) {
        return out;
    }
    let body = tail(text, at);
    const end = indexOf(body, "\n}\n");
    if (end >= 0) {
        body = byteSub(body, 0, end);
    }
    let from = 0;
    while (true) {
        const k = indexOf(tail(body, from), "if (");
        if (k < 0) {
            break;
        }
        const start = from + k;
        const brace = indexOf(tail(body, start), "{");
        if (brace < 0) {
            break;
        }
        const b = start + brace;
        const after = tail(body, b);
        // ") { return 号; }"
        let n = -1;
        let stop = b + 1;
        if (b >= start + 6 && byteSub(body, b - 2, 2) == ") " && startsWith(after, "{ return ")) {
            let i = 9;
            while (i < len(after) && isDigit(byteAt(after, i) ?? 0)) {
                i = i + 1;
            }
            if (i > 9 && byteSub(after, i, 3) == "; }") {
                n = num(byteSub(after, 9, i - 9));
                stop = b + i + 3;
            }
        }
        if (n >= 0) {
            const cond = byteSub(body, start + 4, b - 2 - start - 4);
            addNames(out, cond, n);
            from = stop;
        } else {
            from = start + 1;
        }
    }
    return out;
}

function addNames(out: Ref<Ids>, cond: string, n: int): void {
    const marker = "name == \"";
    let from = 0;
    while (true) {
        const k = indexOf(tail(cond, from), marker);
        if (k < 0) {
            return;
        }
        const s = from + k + len(marker);
        const q = indexOf(tail(cond, s), "\"");
        if (q <= 0) {
            from = s;
            continue;
        }
        const name = byteSub(cond, s, q);
        let found = false;
        let i = 0;
        while (i < listLen(out.names)) {
            if ((listGet(out.names, i) catch "") == name) {
                listSet(out.ids, i, n);
                found = true;
            }
            i = i + 1;
        }
        if (!found) {
            listPush(out.names, name);
            listPush(out.ids, n);
        }
        from = s + q + 1;
    }
}

function idOf(ids: Ref<Ids>, name: string): int {
    let i = 0;
    while (i < listLen(ids.names)) {
        if ((listGet(ids.names, i) catch "") == name) {
            return listGet(ids.ids, i) catch -1;
        }
        i = i + 1;
    }
    return -1;
}

function isToolchain(bid: int): bool {
    return bid == 26 || bid == 27 || bid == 35 || bid == 79 || bid == 86 || bid == 87 || bid == 88 || (bid >= 50 && bid <= 56) || (bid >= 3584 && bid <= 3615);
}

// lsp_builtins.tx 的行：`    b("名", "签名", "说明");` 或 t(…)（t 为仅 --toolchain）。
function tableRows(text: string): List<Row> {
    const out: List<Row> = listNew();
    for (line in strSplit(text, "\n")) {
        if (len(line) < 8 || byteSub(line, 0, 4) != "    " || byteSub(line, 5, 2) != "(\"") {
            continue;
        }
        const kind = byteAt(line, 4) ?? 0;
        if (kind != 98 && kind != 116) {
            continue;
        }
        let i = 7;
        const name = plain(line, i);
        if (name == None) {
            continue;
        }
        i = i + len(name ?? "");
        if (byteSub(line, i, 4) != "\", \"") {
            continue;
        }
        i = i + 4;
        const sig = plain(line, i);
        if (sig == None) {
            continue;
        }
        i = i + len(sig ?? "");
        if (byteSub(line, i, 4) != "\", \"") {
            continue;
        }
        i = i + 4;
        const from = i;
        let ok = false;
        while (i < len(line)) {
            const c = byteAt(line, i) ?? 0;
            if (c == 34) {
                ok = true;
                break;
            }
            if (c == 92) {
                i = i + 2;
            } else {
                i = i + 1;
            }
        }
        if (!ok || i > len(line) || tail(line, i) != "\");") {
            continue;
        }
        listPush(out, Row { name: name ?? "", sig: sig ?? "", doc: byteSub(line, from, i - from), tool: kind == 116 });
    }
    return out;
}

// 从 at 起到下一个双引号之前的一段（不含双引号）；行里没有双引号得 None。
function plain(line: string, at: int): string? {
    const q = indexOf(tail(line, at), "\"");
    if (q < 0) {
        return None;
    }
    return byteSub(line, at, q);
}

function pyList(xs: List<string>): string {
    let s = "[";
    let i = 0;
    while (i < listLen(xs)) {
        if (i > 0) {
            s = s + ", ";
        }
        s = s + reprStr(listGet(xs, i) catch "");
        i = i + 1;
    }
    return s + "]";
}

function inList(xs: List<string>, x: string): bool {
    for (y in xs) {
        if (y == x) {
            return true;
        }
    }
    return false;
}

// a 里有、b 里没有的，排序去重。
function minus(a: List<string>, b: List<string>): List<string> {
    const out: List<string> = listNew();
    for (x in a) {
        if (!inList(b, x) && !inList(out, x)) {
            listPush(out, x);
        }
    }
    return sorted(out);
}

function main(args: []string): int {
    let root = "";
    let i = 0;
    while (i + 1 < len(args)) {
        if (args[i] == "--root") {
            root = args[i + 1];
        }
        i = i + 2;
    }
    if (len(root) == 0) {
        root = currentDir() catch ".";
    }
    let bad = 0;
    const d3Name = latestD3(root);
    const d3 = d3Rows(readText(root, "docs/design/" + d3Name));
    const ids = builtinIds(readText(root, "bootstrap/semamirror.tx"));
    const table = tableRows(readText(root, "bootstrap/selfhost/lsp_builtins.tx"));
    const d3Names: List<string> = listNew();
    for (r in d3) {
        listPush(d3Names, r.name);
    }
    const names: List<string> = listNew();
    const dups: List<string> = listNew();
    for (r in table) {
        if (inList(names, r.name) && !inList(dups, r.name)) {
            listPush(dups, r.name);
        }
        listPush(names, r.name);
    }
    if (listLen(dups) > 0) {
        bad = bad + 1;
        print("FAIL  表里有重名：" + pyList(sorted(dups)));
    }
    const user: List<string> = listNew();
    for (n in ids.names) {
        if (!startsWith(n, "#") && !startsWith(n, "__rt")) {
            listPush(user, n);
        }
    }
    for (n in minus(d3Names, names)) {
        bad = bad + 1;
        print("FAIL  D3 §7 有、表里没有：" + n);
    }
    for (n in minus(names, d3Names)) {
        bad = bad + 1;
        print("FAIL  表里有、D3 §7 没有：" + n);
    }
    for (n in minus(user, names)) {
        bad = bad + 1;
        print("FAIL  builtinOf 认、表里没有：" + n);
    }
    for (n in minus(names, user)) {
        bad = bad + 1;
        print("FAIL  表里有、builtinOf 不认：" + n);
    }
    let tools = 0;
    for (r in table) {
        if (r.tool) {
            tools = tools + 1;
        }
        // dict(d3)：同名以后一行为准。
        let d3Sig = "";
        let has = false;
        for (d in d3) {
            if (d.name == r.name) {
                d3Sig = d.sig;
                has = true;
            }
        }
        if (has) {
            const want = convert(r.name, d3Sig) catch (e) {
                print("FAIL  " + e.message);
                return 1;
            };
            if (r.sig != want) {
                bad = bad + 1;
                print("FAIL  " + r.name + " 的签名 " + reprStr(r.sig) + " 不等于 D3 §7 转写的 " + reprStr(want));
            }
        }
        const id = idOf(ids, r.name);
        if (id >= 0 && r.tool != isToolchain(id)) {
            bad = bad + 1;
            print("FAIL  " + r.name + " 的仅 --toolchain 标记与 builtinOf 的号段不符");
        }
        if (len(r.doc) == 0) {
            bad = bad + 1;
            print("FAIL  " + r.name + " 没有说明");
        }
    }
    print("d3=" + d3Name + " rows=" + toStr(listLen(d3)) + " table=" + toStr(listLen(table)) + " builtinOf-user=" + toStr(listLen(user)) + " toolchain="
        + toStr(tools));
    if (bad == 0) {
        print("SUMMARY PASS");
        return 0;
    }
    print("SUMMARY FAIL=" + toStr(bad));
    return 1;
}
