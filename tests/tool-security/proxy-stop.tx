import { proxyConfigure, proxyCall, proxyClose, proxyReason, proxyReaped, proxyGeneration, proxyArtifactsCleaned, proxyStderrTruncated, proxyStderrTextBytes, proxyStderr, proxyExitCode } from "../../bootstrap/selfhost/mcp_proxy";
import { serviceOptions, serviceOptionsNew } from "../../bootstrap/selfhost/service_options";
import { workerLimitsValid } from "../../bootstrap/selfhost/mcp_worker_limits";
import { serviceConfigure } from "../../bootstrap/selfhost/service_files";
import { reaperSelfPid } from "../../bootstrap/selfhost/mcp_reaper";
function main(args: []string): int {
    if (len(args) > 0 && args[0] == "mcp") {
        const c = serviceOptions(args, 1, true);
        assert(c.worker && workerLimitsValid(c.memoryMiB * 1048576, c.cpuSeconds), "real kernel worker limits");
        let product = c.scratch + "/p-0"; if (hostTarget() == "windows") { product = product + ".exe"; }
        writeFile(product, "controlled product") catch (e) { eprint(e.message); return 92; };
        stdoutWrite(bytesFromStr("READY " + toStr(c.generation) + " " + toStr(reaperSelfPid()) + "\n"));
        if (c.generation == 1) { const until = monoNs() + 5000000000; while (monoNs() < until) {} return 90; }
        if (c.generation == 3) { eprint("CONTROL_OUTPUT_REACHED"); stdoutWrite(bytesNew(16777218)); return 93; }
        if (c.generation == 5) { eprint("CONTROL_OOM_REACHED"); const huge = bytesNew(2147483648); print(toStr(bytesLen(huge))); return 94; }
        if (c.generation == 7) { eprint("CONTROL_CPU_REACHED"); let n = 0; while (true) { n = n + 1; if (n == 100000000) { n = 0; } } }
        const b = bytesNew(65536); let done = false;
        while (!done) {
            const n = stdinRead(b, 1000); if (n < 0) { return 91; }
            let i = 0; while (i < n) { if ((bytesGet(b, i) catch 0) == 10) { done = true; } i = i + 1; }
        }
        if (c.generation == 9) { let text = "e"; while (len(text) < 2097152) { text = text + text; } eprint(text); }
        stdoutWrite(bytesFromStr("{\"recovered\":true}\n")); return 0;
    }
    const roots: List< string> = listNew(); const libraries: List< string> = listNew();
    assert(serviceConfigure(roots, libraries, libraries), "startup roots");
    const config = serviceOptionsNew(); config.requestMs = 500; assert(proxyConfigure(config), "verified parent reaper");
    const begin = monoNs();
    assert(proxyCall(bytesNew(2097152), 500) == "", "stopped reader must time out");
    print("reason=" + proxyReason() + " reaped=" + toStr(proxyReaped()) + " elapsed_ms=" + toStr((monoNs() - begin) / 1000000));
    assert(proxyReason() == "request_timeout" && proxyReaped() && proxyArtifactsCleaned(), "terminated/reaped worker and cleaned product directory");
    assert(monoNs() - begin < 2000000000, "parent never blocks in write");
    assert(proxyCall(bytesFromStr("{}"), 2000) == "{\"recovered\":true}" && proxyGeneration() == 2, "next worker recovers");
    proxyClose(); assert(proxyArtifactsCleaned(), "normal close removes registered products");
    config.memoryMiB = 1024; config.cpuSeconds = 1; config.requestMs = 15000;
    for (expectedReason in["worker_output_limit", "worker_exit", "worker_exit"]) {
        const started = monoNs();
        let budget = 4000; if (proxyGeneration() == 6) { budget = 12000; }
        const reply = proxyCall(bytesFromStr("{}"), budget);
        print("generation=" + toStr(proxyGeneration()) + " expected=" + expectedReason + " actual=" + proxyReason() + " reaped=" + toStr(proxyReaped()) + " clean=" + toStr(proxyArtifactsCleaned()) + " elapsed_ms=" + toStr((monoNs() - started) / 1000000) + " exit=" + toStr(proxyExitCode()) + " stderr=" + proxyStderr());
        assert(reply == "" && proxyReason() == expectedReason && proxyReaped() && proxyArtifactsCleaned(), "output/OOM/CPU worker reclaimed");
        let reached = "CONTROL_OOM_REACHED";
        if (proxyGeneration() == 3) { reached = "CONTROL_OUTPUT_REACHED"; }
        if (proxyGeneration() == 7) { reached = "CONTROL_CPU_REACHED"; }
        assert(strIndexOf(proxyStderr(), reached) >= 0, "fault branch reached, not startup OOM");
        assert((monoNs() - started) / 1000000 < budget + 1000, "failure bounded by OS or wall budget");
        assert(proxyCall(bytesFromStr("{}"), 2000) == "{\"recovered\":true}", "healthy generation after failure");
        proxyClose(); assert(proxyArtifactsCleaned(), "recovery cleanup");
    }
    assert(proxyCall(bytesFromStr("{}"), 3000) == "{\"recovered\":true}" && proxyStderrTruncated() && proxyStderrTextBytes() >= 2097152, "bounded stderr retains explicit truncation accounting");
    proxyClose(); assert(proxyArtifactsCleaned(), "stderr producer cleanup");
    print("PASS_STOPPED_READER_FULL_PIPE_DEADLINE_REAP_RECOVERY"); return 0;
}
