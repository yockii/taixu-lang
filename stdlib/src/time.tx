// ============================================================================
// std/time —— 时间工具（V0.9-S1；D27 §一；STD-03）。
//
// **确定性纪律（D27 §一明示）**：nowMs/timeNowMs 为墙钟观测面——e2e/教程
// 断言面禁用（输出随宿主墙钟变化）；本模块把可断言面收敛为纯函数段
//（formatMs：毫秒时长 → 人类可读串——同入参恒同出参，test 块覆盖）。
// ============================================================================

// 墙钟毫秒（nowMs 内建的模块面别名——观测面；断言面禁用）。
export function timeNowMs(): int {
    return nowMs();
}

// 毫秒时长 → 人类可读串（**纯函数**）：`<1ms` ｜ `Nms` ｜ `N.NNs`（十分位
// 为 0 收敛整秒 `Ns`）｜ `Nm N.NNs`。负时长按 0 处理（观测噪声面不呈现负号）。
export function formatMs(ms: int): string {
    let m: int = ms;
    if (m < 0) { m = 0; }
    if (m < 1) { return "<1ms"; }
    if (m < 1000) { return toStr(m) + "ms"; }
    const mins = m / 60000;
    const secs = (m % 60000) / 1000;
    const tenth = (m % 1000) / 100;
    let tail: string = toStr(secs) + "." + toStr(tenth) + "s";
    if (tenth == 0) { tail = toStr(secs) + "s"; }
    if (mins > 0) { return toStr(mins) + "m " + tail; }
    return tail;
}
