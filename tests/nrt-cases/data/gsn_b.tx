// generic-same-name 的桩模块：模块 B 的同名 P 与 K（字段与变体都不同）。
import { Box, Pair, unbox, firstOf, apply } from "./gsn_g";

export struct P { s: string }
export enum K { C, D, E }

function ps(p: P): int { return len(p.s); }
function kName(k: K): string {
    return switch (k) {
        case C => "C",
        case D => "D",
        case E => "E",
    };
}

export function fb(): string {
    const b = Box < P > { v: P { s: "hi" } };
    const bb = Box < Box < P >> { v: b };
    const k = Box < K > { v: K.E };
    const rs: List< Ref< P>> = listNew();
    listPush(rs, new P { s: "ref" });
    const r = firstOf(rs, new P { s: "" });
    const fbox: Box < (P) => int > = { v: ps };
    const fv = fbox.v;
    const q = Pair < P, K > { first: P { s: "one" }, second: K.D };
    return unbox(b).s + "," + bb.v.v.s + "," + kName(k.v) + "," + r.s + "," + q.first.s + kName(q.second) + "," + toStr(fv(P { s: "three" })) + "," + toStr(apply(ps, P { s: "four" }));
}
