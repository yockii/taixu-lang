// ============================================================================
// stdlib 用例：std/image（V0.40-S1；STD-12）。PNG 向量锚逐位——fixture 为
// tests/vectors/png-vectors.txt（Python zlib 构造的确定性 PNG，
// gen_vectors.py 冻结生成；勿手改）；像素面 golden＝RGBA8 平面 FNV-1a 64＋
// 前缀像素逐字节断言。覆盖：filter 0–4 全形态、color type 0/2/3/4/6、
// tRNS 透明键与调色板 alpha、多 IDAT 拼接、CRC 校验与结构化拒绝负例。
// 运行：taixu test tests/image-fx.tx
// ============================================================================

import { decodePng, decodePngHex } from "std/image";
import { PngImage } from "std/image";

// —— fixture 十六进制（冻结产物）——

const V_TINY2X2: string = "89504e470d0a1a0a0000000d494844520000000200000002080600000072b60d24000000144944415478da63606060f8ff1f8841a8014400003064057c5067f92b0000000049454e44ae426082";
const V_FILTERS8X5: string = "89504e470d0a1a0a0000000d49484452000000080000000508060000007891ad55000000504944415478da6390656038a1c71a7dd09e6bdbae007ec1cd8922396b8a248f2f6d96539a3745b9763aa3862aef6941d6e89fb83013b72a2f333eccacea2595c5276af20f82b7fc4367b38055b2e2c6008023253c9036e6790000000049454e44ae426082";
const V_GRAY8X4: string = "89504e470d0a1a0a0000000d494844520000000800000004080000000096a6212c0000001d4944415478da636010d7738d29ee5ac8a2290e018c4150069326140000718f0591c396cdbd0000000049454e44ae426082";
const V_GRAY_TRNS4X2: string = "89504e470d0a1a0a0000000d49484452000000040000000208000000005ac322bf0000000274524e530033c943ac2e000000124944415478da636030aed8c294929b9202000d2f02fbd0b53a160000000049454e44ae426082";
const V_RGB12X8: string = "";
const V_PAL6X4: string = "89504e470d0a1a0a0000000d49484452000000060000000408030000009adabe710000000c504c5445ff000000ff000000fff0f0f0e77b26950000000474524e53ff8000ffa1a194660000001b4944415478da636060646266600481bf8c8c4c60929181192c0a001d51021897a0b6960000000049454e44ae426082";
const V_GA6X4: string = "89504e470d0a1a0a0000000d4948445200000006000000040804000000070d86c8000000274944415478da6364b051e5864166e160190518641236454006cbdb71cf9a3faef87396fd931000bb960bbd91eb0ad90000000049454e44ae426082";
const V_BIG32X16: string = "";
const V_OK1X1: string = "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000d4944415478da63606060f80f000104010080bbd15b0000000049454e44ae426082";
const V_BAD_MAGIC: string = "88504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000c4944415478da63600082ff0001050100bf985b350000000049454e44ae426082";
const V_DEPTH16: string = "89504e470d0a1a0a0000000d49484452000000010000000110060000004f8518ca0000000c4944415478da63600082ff0001050100bf985b350000000049454e44ae426082";
const V_INTERLACED: string = "89504e470d0a1a0a0000000d49484452000000010000000108060000016812f41f0000000c4944415478da63600082ff0001050100bf985b350000000049454e44ae426082";
const V_BAD_CRC: string = "89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4890000000c4944415478da63600082ff0001050100bf985b35ff00000049454e44ae426082";

// —— golden（十进制 FNV 为二补码形态；前缀像素十六进制）——

const FNV_TINY2X2: int = 7461260632623676072;
const P0_TINY2X2: string = "000000ffff0000ff00ff00800000ff00";
const FNV_FILTERS8X5: int = -8687800423744494107;
const P0_FILTERS8X5: string = "1d0000c82e055bc13f0ab6ba500f11b3";
const FNV_GRAY8X4: int = -7391357409792936043;
const P0_GRAY8X4: string = "000000ff171717ff2e2e2eff454545ff";
const FNV_GRAY_TRNS4X2: int = 670931352331923737;
const P0_GRAY_TRNS4X2: string = "000000ff33333300787878ffb4b4b4ff";
const FNV_RGB12X8: int = -4082734133258404155;
const P0_RGB12X8: string = "076400ff146739ff216a72ff2e6dabff";
const FNV_PAL6X4: int = 6246902907717145545;
const P0_PAL6X4: string = "ff0000ff00ff00800000ff00f0f0f0ff";
const FNV_GA6X4: int = -6519039140895162907;
const P0_GA6X4: string = "0000003c252525474a4a4a526f6f6f5d";
const FNV_BIG32X16: int = 8319363598281747616;
const P0_BIG32X16: string = "00000040071d01ff0e3a02ff15570340";

// —— 断言助手 ——

function fnv64(data: List<int>): int {
    // 0xCBF29CE484222325 的二补码形态（>i64.max——imul 64 位环绕下等价）。
    let h: int = -3750763034362895579;
    for (b in data) {
        h = imul(h ^ b, 1099511628211);
    }
    return h;
}

function expectSize(name: string, w: int, h: int): PngImage {
    const img: PngImage = decodePngHex(name) catch panic("解码失败");
    assert(img.width == w && img.height == h, "尺寸");
    assert(listLen(img.pixels) == w * h * 4, "像素面长度");
    return img;
}

function expectFnv(img: PngImage, golden: int, label: string): void {
    assert(fnv64(img.pixels) == golden, label);
}

function expectPrefix(img: PngImage, prefixHex: string, label: string): void {
    const n: int = len(prefixHex) / 2;
    let i: int = 0;
    while (i < n) {
        const hi: int = hexVal(byteAt(prefixHex, i * 2) catch -1);
        const lo: int = hexVal(byteAt(prefixHex, i * 2 + 1) catch -1);
        assert((listGet(img.pixels, i) catch -1) == hi * 16 + lo, label);
        i = i + 1;
    }
}

function hexVal(b: int): int {
    if (b >= 48 && b <= 57) {
        return b - 48;
    }
    if (b >= 97 && b <= 102) {
        return b - 87;
    }
    return -1;
}

function badImg(): PngImage {
    return { width: -1, height: -1, pixels: listNew() };
}

function expectReject(fixtureHex: string, label: string): void {
    const img: PngImage = decodePngHex(fixtureHex) catch badImg();
    assert(img.width == -1, label);
}

// —— 全字面像素面（2x2 RGBA，filter 0——最小编码全值断言）——

test "image：tiny2x2 全字面像素面（RGBA8 行主序逐字节）" {
    const img: PngImage = expectSize(V_TINY2X2, 2, 2);
    expectFnv(img, FNV_TINY2X2, "fnv tiny2x2");
    assert((listGet(img.pixels, 0) catch 0) == 0, "p0 r");
    assert((listGet(img.pixels, 3) catch 0) == 255, "p0 a");
    assert((listGet(img.pixels, 4) catch 0) == 255, "p1 r=255");
    assert((listGet(img.pixels, 7) catch 0) == 255, "p1 a");
    assert((listGet(img.pixels, 8) catch 0) == 0, "p2 r");
    assert((listGet(img.pixels, 9) catch 0) == 255, "p2 g");
    assert((listGet(img.pixels, 11) catch 0) == 128, "p2 a=128");
    assert((listGet(img.pixels, 12) catch 0) == 0, "p3 r");
    assert((listGet(img.pixels, 13) catch 0) == 0, "p3 g");
    assert((listGet(img.pixels, 14) catch 0) == 255, "p3 b");
    assert((listGet(img.pixels, 15) catch 0) == 0, "p3 a=0");
}

// —— filter 0–4 全覆盖行 ——

test "image：filters8x5 五 filter 形态（None/Sub/Up/Average/Paeth）" {
    const img: PngImage = expectSize(V_FILTERS8X5, 8, 5);
    expectFnv(img, FNV_FILTERS8X5, "fnv filters8x5");
    expectPrefix(img, P0_FILTERS8X5, "前缀像素 filters8x5");
}

// —— color type 全谱 ——

test "image：灰度 type0（含 filter 4/1/2 行）" {
    const img: PngImage = expectSize(V_GRAY8X4, 8, 4);
    expectFnv(img, FNV_GRAY8X4, "fnv gray8x4");
    expectPrefix(img, P0_GRAY8X4, "前缀像素 gray8x4（灰→RGB 复制）");
}

test "image：灰度 tRNS 透明键（灰值 51 → alpha 0）" {
    const img: PngImage = expectSize(V_GRAY_TRNS4X2, 4, 2);
    expectFnv(img, FNV_GRAY_TRNS4X2, "fnv gray_trns4x2");
    assert((listGet(img.pixels, 3) catch 0) == 255, "p0 a=255");
    assert((listGet(img.pixels, 7) catch 0) == 0, "p1 a=0（透明键）");
}

test "image：调色板 type3（PLTE＋tRNS alpha 255/128/0/255）" {
    const img: PngImage = expectSize(V_PAL6X4, 6, 4);
    expectFnv(img, FNV_PAL6X4, "fnv pal6x4");
    expectPrefix(img, P0_PAL6X4, "前缀像素 pal6x4");
}

test "image：灰α type4" {
    const img: PngImage = expectSize(V_GA6X4, 6, 4);
    expectFnv(img, FNV_GA6X4, "fnv ga6x4");
    expectPrefix(img, P0_GA6X4, "前缀像素 ga6x4");
}

test "image：rgb12x8（type2＋多 IDAT 拼接＋filter 循环——gui 消费 fixture）" {
    const img: PngImage = expectSize(V_RGB12X8, 12, 8);
    expectFnv(img, FNV_RGB12X8, "fnv rgb12x8");
    expectPrefix(img, P0_RGB12X8, "前缀像素 rgb12x8");
}

test "image：big32x16（inflate 工作量锚）" {
    const img: PngImage = expectSize(V_BIG32X16, 32, 16);
    expectFnv(img, FNV_BIG32X16, "fnv big32x16");
}

test "image：decodePng（List 通道）与 ok1x1 最小编码" {
    const l: List<int> = listNew();
    const h: string = V_OK1X1;
    let i: int = 0;
    while (i + 1 < len(h)) {
        const hi: int = hexVal(byteAt(h, i) catch -1);
        const lo: int = hexVal(byteAt(h, i + 1) catch -1);
        listPush(l, hi * 16 + lo);
        i = i + 2;
    }
    const img: PngImage = decodePng(l) catch panic("ok1x1 解码失败");
    assert(img.width == 1 && img.height == 1, "尺寸 1x1");
    assert(listLen(img.pixels) == 4, "像素面 4 字节");
}

// —— 负例（结构化拒绝）——

test "image：负例结构化拒绝（magic/16 位深/Adam7/坏 CRC）" {
    expectReject(V_BAD_MAGIC, "magic 不符拒绝");
    expectReject(V_DEPTH16, "bit depth 16 拒绝（登记不实施）");
    expectReject(V_INTERLACED, "Adam7 拒绝（登记不实施）");
    expectReject(V_BAD_CRC, "CRC 拒绝");
}
