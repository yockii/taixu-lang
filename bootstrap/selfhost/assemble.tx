}

let asProducerMeta: List<int> = listNew();
let asProducerNames: List<string> = listNew();
let asProducerOperands: List<Ref<Operand>> = listNew();
// Explicit producer actions: record instruction boundaries only after ISA encoding.
export function asProducerFunctionBegin(id: int, line: int): void {
    const name = "f_" + toStr(id); asProducerLabel(0, name, line);
    if (as_failed == 0) { nativeFunctionBegin(id, name, asHere()); }
}
export function asProducerFunctionPrologueEnd(): void { if (as_failed == 0) { nativeFunctionPrologueEnd(asHere()); } }
export function asProducerFunctionEpilogueStart(): void { if (as_failed == 0) { nativeFunctionEpilogueStart(asHere()); } }
export function asProducerFunctionEnd(): void { if (as_failed == 0) { nativeFunctionEnd(asHere()); } }
export function asProducerFrame(kind: string, reg: int, size: int, line: int): void {
    const before = asHere(); const missing = asStructuredMissing();
    if (kind == "push-nonvolatile" || kind == "pop-nonvolatile") {
        let mn = "push"; if (kind == "pop-nonvolatile") { mn = "pop"; }
        asProducerInstruction(0, mn, 1, asStructuredReg(0, reg), missing, missing, line);
    } else if (kind == "allocate-stack" || kind == "release-stack") {
        let mn = "sub"; if (kind == "release-stack") { mn = "add"; }
        asProducerInstruction(0, mn, 2, asStructuredReg(0, 4), asStructuredImm(size), missing, line);
    } else if (kind == "set-frame-pointer") {
        asProducerInstruction(0, "mov", 2, asStructuredReg(0, 5), asStructuredReg(0, 4), missing, line);
    } else if (kind == "return") { asProducerInstruction(0, "ret", 0, missing, missing, missing, line); }
    else { asFail("BadFrameInstruction"); return; }
    if (as_failed == 0) { nativeFunctionEvent(before, asHere(), kind, reg, size); }
}
export function asProducerBeginFunction(): void {
    asProducerMeta = listNew(); asProducerNames = listNew(); asProducerOperands = listNew();
}
export function asProducerSubmitBody(): void {
    // Shape is checked once here: every instruction pushed four meta words and
    // three operands, so the per-entry reads below stay in range.
    const count = listLen(asProducerNames);
    const meta = asProducerMeta;
    const operands = asProducerOperands;
    assert(listLen(meta) == count * 4, "producer record shape invariant");
    let i = 0;
    while (i < count) {
        if (as_failed == 1) { break; }
        const pos = i * 4;
        const kind = listGet(meta, pos) catch -1;
        const nops = listGet(meta, pos + 1) catch -1;
        const line = listGet(meta, pos + 2) catch -1;
        const operandBase = listGet(meta, pos + 3) catch -1;
        const name = listGet(asProducerNames, i) catch "";
        as_last_line = line;
        if (line < 1) { asFail("BadOperand"); break; }
        if (kind == 0) {
            asStructuredInstruction(name, nops, listGet(operands, operandBase) catch missingOperand, listGet(operands, operandBase + 1) catch missingOperand, listGet(operands, operandBase + 2) catch missingOperand, line);
        } else if (kind == 2) { asStructuredLabel(name); }
        else { asFail("BadInstruction"); break; }
        i = i + 1;
    }
    if (asListingOn) { asListingBody(); }
    asProducerBeginFunction();
}
export function asProducerLabel(body: int, name: string, line: int): void {
    if (body == 1) {
        listPush(asProducerMeta, 2); listPush(asProducerMeta, 0);
        listPush(asProducerMeta, line); listPush(asProducerMeta, -1);
        listPush(asProducerNames, name);
    } else {
        as_last_line = line; asStructuredLabel(name);
        if (asListingOn) { asListingAdd(2, name, 0, missingOperand, missingOperand, missingOperand, line); }
    }
}
export function asProducerInstruction(body: int, mn: string, nops: int, a: Ref<Operand>, b: Ref<Operand>, c: Ref<Operand>, line: int): void {
    if (body == 1) {
        const operandBase = listLen(asProducerOperands);
        listPush(asProducerOperands, a); listPush(asProducerOperands, b); listPush(asProducerOperands, c);
        listPush(asProducerMeta, 0); listPush(asProducerMeta, nops);
        listPush(asProducerMeta, line); listPush(asProducerMeta, operandBase);
        listPush(asProducerNames, mn);
    } else {
        asStructuredInstruction(mn, nops, a, b, c, line);
        if (asListingOn) { asListingAdd(0, mn, nops, a, b, c, line); }
    }
}
export function asProducerInteger(text: string): int {
    const value = parseIntAuto(text);
    if (parseIntAutoOk == 0) { asFail("BadOperand"); }
    return value;
}
export function asProducerRegister(name: string): Ref<Operand> {
    if (name == "rax") { return asStructuredReg(0, 0); }
    if (name == "rcx") { return asStructuredReg(0, 1); }
    if (name == "rdx") { return asStructuredReg(0, 2); }
    if (name == "rbx") { return asStructuredReg(0, 3); }
    if (name == "rsp") { return asStructuredReg(0, 4); }
    if (name == "rbp") { return asStructuredReg(0, 5); }
    if (name == "rsi") { return asStructuredReg(0, 6); }
    if (name == "rdi") { return asStructuredReg(0, 7); }
    if (name == "r8") { return asStructuredReg(0, 8); }
    if (name == "r9") { return asStructuredReg(0, 9); }
    if (name == "r10") { return asStructuredReg(0, 10); }
    if (name == "r11") { return asStructuredReg(0, 11); }
    if (name == "r12") { return asStructuredReg(0, 12); }
    if (name == "r13") { return asStructuredReg(0, 13); }
    if (name == "r14") { return asStructuredReg(0, 14); }
    if (name == "r15") { return asStructuredReg(0, 15); }
    if (name == "eax") { return asStructuredReg(1, 0); }
    if (name == "ecx") { return asStructuredReg(1, 1); }
    if (name == "edx") { return asStructuredReg(1, 2); }
    if (name == "ebx") { return asStructuredReg(1, 3); }
    if (name == "esp") { return asStructuredReg(1, 4); }
    if (name == "ebp") { return asStructuredReg(1, 5); }
    if (name == "esi") { return asStructuredReg(1, 6); }
    if (name == "edi") { return asStructuredReg(1, 7); }
    if (name == "r8d") { return asStructuredReg(1, 8); }
    if (name == "r9d") { return asStructuredReg(1, 9); }
    if (name == "r10d") { return asStructuredReg(1, 10); }
    if (name == "r11d") { return asStructuredReg(1, 11); }
    if (name == "r12d") { return asStructuredReg(1, 12); }
    if (name == "r13d") { return asStructuredReg(1, 13); }
    if (name == "r14d") { return asStructuredReg(1, 14); }
    if (name == "r15d") { return asStructuredReg(1, 15); }
    if (name == "al") { return asStructuredReg(2, 0); }
    if (name == "cl") { return asStructuredReg(2, 1); }
    if (name == "dl") { return asStructuredReg(2, 2); }
    if (name == "bl") { return asStructuredReg(2, 3); }
    if (name == "xmm0") { return asStructuredReg(3, 0); }
    if (name == "xmm1") { return asStructuredReg(3, 1); }
    if (name == "xmm2") { return asStructuredReg(3, 2); }
    if (name == "xmm3") { return asStructuredReg(3, 3); }
    if (name == "xmm4") { return asStructuredReg(3, 4); }
    if (name == "xmm5") { return asStructuredReg(3, 5); }
    if (name == "xmm6") { return asStructuredReg(3, 6); }
    if (name == "xmm7") { return asStructuredReg(3, 7); }
    if (name == "xmm8") { return asStructuredReg(3, 8); }
    if (name == "xmm9") { return asStructuredReg(3, 9); }
    if (name == "xmm10") { return asStructuredReg(3, 10); }
    if (name == "xmm11") { return asStructuredReg(3, 11); }
    if (name == "xmm12") { return asStructuredReg(3, 12); }
    if (name == "xmm13") { return asStructuredReg(3, 13); }
    if (name == "xmm14") { return asStructuredReg(3, 14); }
    if (name == "xmm15") { return asStructuredReg(3, 15); }
    if (name == "ymm0") { return asStructuredReg(4, 0); }
    if (name == "ymm1") { return asStructuredReg(4, 1); }
    if (name == "ymm2") { return asStructuredReg(4, 2); }
    if (name == "ymm3") { return asStructuredReg(4, 3); }
    if (name == "ymm4") { return asStructuredReg(4, 4); }
    if (name == "ymm5") { return asStructuredReg(4, 5); }
    if (name == "ymm6") { return asStructuredReg(4, 6); }
    if (name == "ymm7") { return asStructuredReg(4, 7); }
    if (name == "ymm8") { return asStructuredReg(4, 8); }
    if (name == "ymm9") { return asStructuredReg(4, 9); }
    if (name == "ymm10") { return asStructuredReg(4, 10); }
    if (name == "ymm11") { return asStructuredReg(4, 11); }
    if (name == "ymm12") { return asStructuredReg(4, 12); }
    if (name == "ymm13") { return asStructuredReg(4, 13); }
    if (name == "ymm14") { return asStructuredReg(4, 14); }
    if (name == "ymm15") { return asStructuredReg(4, 15); }
    asFail("BadOperand"); return emptyOperand();
}

// Logical zero storage never constructs an initialized byte list.
export function asStructuredZero(n: int): void {
    if (as_failed == 1) { return; }
    if (as_cur != SEC_BSS) { asFail("UnsupportedDirective"); return; }
    if (n < 0 || n > 4294967295 || as_img.bssSize > 4294967295 - n) { asFail("BadBssSize"); return; }
    as_img.bssSize = as_img.bssSize + n;
}
let storageNumberOk: int = 0;
function storageParseInt(text: string): int {
    storageNumberOk = 0;
    if (len(text) == 0) { return 0; }
    let at = 0; let negative = 0;
    if ((byteAt(text, at) catch 0) == 45) { negative = 1; at = at + 1; }
    else if ((byteAt(text, at) catch 0) == 43) { at = at + 1; }
    let base = 10;
    if (at + 2 < len(text) && (byteAt(text, at) catch 0) == 48 && ((byteAt(text, at + 1) catch 0) == 120 || (byteAt(text, at + 1) catch 0) == 88)) { base = 16; at = at + 2; }
    if (at >= len(text)) { return 0; }
    let limit = -9223372036854775807; if (negative == 1) { limit = limit - 1; }
    let value = 0;
    while (at < len(text)) {
        const digit = hexValAs(byteAt(text, at) catch 0);
        if (digit < 0 || digit >= base) { return 0; }
        if (value < limit / base || (value == limit / base && digit > -(limit % base))) { return 0; }
        value = value * base - digit; at = at + 1;
    }
    storageNumberOk = 1;
    if (negative == 1) { return value; } return -value;
}
function storageLabelValid(name: string): bool {
    if (len(name) == 0) { return false; }
    let i = 0;
    while (i < len(name)) {
        const b = byteAt(name, i) catch 0;
        if (!((b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 46 || b == 36 || b >= 128 || (i > 0 && b >= 48 && b <= 57))) { return false; }
        i = i + 1;
    }
    return true;
}
function asStorageQuadText(text: string): void {
    const value = storageParseInt(text);
    if (storageNumberOk == 1) { asStructuredQuad(value); return; }
    let split = -1; let i = 1;
    while (i < len(text)) {
        const c = byteAt(text, i) catch 0;
        if (c == 43 || c == 45) { split = i; break; } i = i + 1;
    }
    if (split < 0) { asStructuredAddressAddend(text, 0); return; }
    const name = trimSpAll(asByteSub(text, 0, split));
    const magnitude = storageParseInt(trimSpAll(asByteSub(text, split + 1, len(text) - split - 1)));
    if (storageNumberOk == 0 || magnitude < 0) { asFail("BadOperand"); return; }
    let addend = magnitude; if ((byteAt(text, split) catch 0) == 45) { addend = -magnitude; }
    asStructuredAddressAddend(name, addend);
}

// 原生函数清单（6d-5）：关闭时只在函数提交与序言/尾声处判断；体内编码热循环不变。
// A64 的行（asListingA64）不带结构化操作数，操作数按反汇编文本放在 ops；x86 的行 ops 为空。
export struct AsListingRow {
    fnIdx: int, pc: int, kind: int, name: string, nops: int,
    a: Ref<Operand>, b: Ref<Operand>, c: Ref<Operand>, ops: List<string>,
}
const asListingNoOps: List<string> = listNew();
let asListingOn: bool = false;
let asListingFn: int = -1;
let asListingLimit: int = 0;
let asListingCut: bool = false;
let asListingRows: List<Ref<AsListingRow>> = listNew();
export function asListingClear(): void {
    asListingOn = false; asListingFn = -1; asListingCut = false; asListingRows = listNew();
}
export function asListingStart(limit: int): void {
    asListingClear(); asListingLimit = limit; asListingOn = true;
}
export function asListingSelect(fnIdx: int): void { asListingFn = fnIdx; }
export function asListingStop(): void { asListingOn = false; }
export function asListingGet(): List<Ref<AsListingRow>> { return asListingRows; }
export function asListingTruncated(): bool { return asListingCut; }
function asListingAdd(kind: int, name: string, nops: int, a: Ref<Operand>, b: Ref<Operand>, c: Ref<Operand>, line: int): void {
    if (asListingFn < 0 || asListingCut) { return; }
    if (compileProfileActive()) {
        if (kind == 0) {
            let imm = 0; let zeros = 0; let mem = 0;
            if (nops > 0) { if (a.kind == 1) { imm = imm + 1; if (a.imm == 0) { zeros = zeros + 1; } } if (a.kind == 2) { mem = mem + 1; } }
            if (nops > 1) { if (b.kind == 1) { imm = imm + 1; if (b.imm == 0) { zeros = zeros + 1; } } if (b.kind == 2) { mem = mem + 1; } }
            if (nops > 2) { if (c.kind == 1) { imm = imm + 1; if (c.imm == 0) { zeros = zeros + 1; } } if (c.kind == 2) { mem = mem + 1; } }
            compileProfileInstruction(asListingFn, nops, imm, zeros, mem);
        }
        return;
    }
    if (asListingLimit > 0 && listLen(asListingRows) >= asListingLimit) { asListingCut = true; return; }
    listPush(asListingRows, new AsListingRow { fnIdx: asListingFn, pc: line - 2, kind: kind,
            name: name, nops: nops, a: a, b: b, c: c, ops: asListingNoOps });
}
export function asListingActive(): bool { return asListingOn; }
/// A64 清单行（a64BufferSubmit 用）：kind 0 指令（name 助记符、ops 操作数文本）、2 标号；line 同 asProducer*。
/// 编译画像按操作数文本计数：# 开头为立即数（#0、#0x0 为零），[ 开头为内存。
export function asListingA64(fnIdx: int, kind: int, name: string, ops: List<string>, line: int): void {
    if (!asListingOn || asListingCut || fnIdx < 0) { return; }
    if (compileProfileActive()) {
        if (kind == 0) {
            let imm = 0; let zeros = 0; let mem = 0;
            for (o in ops) {
                const head = byteAt(o, 0) catch 0;
                if (head == 35) { imm = imm + 1; if (o == "#0" || o == "#0x0") { zeros = zeros + 1; } }
                if (head == 91) { mem = mem + 1; }
            }
            compileProfileInstruction(fnIdx, listLen(ops), imm, zeros, mem);
        }
        return;
    }
    if (asListingLimit > 0 && listLen(asListingRows) >= asListingLimit) { asListingCut = true; return; }
    listPush(asListingRows, new AsListingRow { fnIdx: fnIdx, pc: line - 2, kind: kind, name: name, nops: 0,
            a: missingOperand, b: missingOperand, c: missingOperand, ops: ops });
}
function asListingBody(): void {
    let i = 0;
    while (i < listLen(asProducerNames) && !asListingCut) {
        const p = i * 4;
        const k = listGet(asProducerMeta, p) catch -1;
        const n = listGet(asProducerMeta, p + 1) catch 0;
        const line = listGet(asProducerMeta, p + 2) catch 1;
        const base = listGet(asProducerMeta, p + 3) catch -1;
        asListingAdd(k, listGet(asProducerNames, i) catch "", n,
            listGet(asProducerOperands, base) catch missingOperand,
            listGet(asProducerOperands, base + 1) catch missingOperand,
            listGet(asProducerOperands, base + 2) catch missingOperand, line);
        i = i + 1;
    }
}
