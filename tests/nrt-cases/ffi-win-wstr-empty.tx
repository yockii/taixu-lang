// 第 5 轮 FFI（D3 v0.23，Windows）：空字符串作 wstr／string 实参得到只含 NUL 的缓冲（此前空串作 wstr 实参误报
// “内存不足”），空串返回值得 ""；环境变量可设为空值（读回 0 个字符），与“未设置”（错误码 203）可分。
declare function lstrlenW(s: wstr): i32 from "kernel32";
declare function lstrlenA(s: string): i32 from "kernel32";
declare function lstrcpyW(dst: Bytes, src: wstr): wstr from "kernel32";
declare function lstrcpyA(dst: Bytes, src: string): string from "kernel32";
declare function SetEnvironmentVariableW(name: wstr, value: wstr): i32 from "kernel32";
declare function GetEnvironmentVariableW(name: wstr, buf: Bytes, n: u32): u32 from "kernel32";

function main(args: []string): int {
    print("len " + toStr(lstrlenW("")) + " " + toStr(lstrlenA("")));
    print("copy [" + lstrcpyW(bytesNew(8), "") + "] [" + lstrcpyA(bytesNew(8), "") + "]");
    print("set " + toStr(SetEnvironmentVariableW("TAIXU_FFI_EMPTY", "") != 0));
    const buf = bytesNew(16);
    bytesSet(buf, 0, 65);
    print("get " + toStr(GetEnvironmentVariableW("TAIXU_FFI_EMPTY", buf, 8)) + " nul " + toStr((bytesGet(buf, 0) catch -1) == 0));
    print("missing " + toStr(GetEnvironmentVariableW("TAIXU_FFI_EMPTY_NOPE", buf, 8)) + " err " + toStr(ffiLastError()));
    print("again " + toStr(lstrlenW("") as int + lstrlenW("ab") as int + lstrlenW("") as int));
    return 0;
}
