// 第 5 轮 FFI 前端负例（声明）：外部结构体字段、封送类型、from syscall 限制（3033），重名（3003）。
declare type HANDLE;
declare struct S { a: i32, b: string, c: bool }
declare struct LOOP { inner: LOOP }
declare struct EMPTY {}
struct Plain { v: int }
declare function f1(s: cstr): void from "k";
declare function f2(s: RECT): void from "k";
declare function f3(): RECT from "k";
declare function f4(): Bytes from "k";
declare function f5(r: Ref< Plain>): void from "k";
declare function f6(l: List< int>): void from "k";
declare function f7(cb: (string) => int): void from "k";
declare function f8(x: f64): f32 from syscall 1;
declare function f9(a: int, b: int, c: int, d: int, e: int, f: int, g: int): int from syscall 2;
declare function f10(): bool from syscall 3;
declare function f11(): int from "";
declare function f12(s: wstr): int from syscall 4;
declare function f13(): int from "k";
declare function f13(): int from "k";
declare struct RECT { left: i32, top: i32, right: i32, bottom: i32 }

function main(args: []string): int {
    return 0;
}
