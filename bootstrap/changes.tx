        id: "tool.local-service-trust",
        kind: 3,
        layer: "tool",
        since: "0.2.24-dev",
        gate: "alpha",
        diagnostics: [],
        fix: "由启动操作者配置本地工作区与库根；仅在明确信任的工作区启用运行和调试。同批的其他可见变化：LSP 也只读操作者授权的本地根，不带 --workspace 时只读当前目录，按目录上溯发现的标准库、GUI 库不在已授权根内时不再可读，须以 --library-root 或 TAIXU_STDLIB／TAIXU_GUI_ROOT 授权（taixu lsp --workspace <本地项目> --library-root <标准库 src>），与可执行文件同目录分发的 taixu-stdlib/src、taixu-gui/src 自动授权；MCP 工具的 timeout_ms 超过启动上限（--request-timeout-ms，缺省 10000）时由截断到 60000 改为按参数错误拒绝；调试会话 ID 由 1、2… 改为“worker 代数.序号”形式的不透明字符串，须原样回传；debug_step、debug_continue 在请求时限先到时暂停程序（stopped，reason pause），会话保留。需要更长的请求时由操作者加 --request-timeout-ms（1..1800000）",
        applicability: "unavailable",
        before: "taixu mcp",
        after: "taixu mcp --workspace <本地项目> --trust-workspace --request-timeout-ms 60000",
        implementedIn: "工具安全边界 v0.2",
        explain: "taixu help",
        d3: "docs/design/v052-tool-security-boundaries-v0.3-20261023.md",
        llmGuide: "docs/ai/llm-guide-s1.md#本地工具服务的信任与预算",
