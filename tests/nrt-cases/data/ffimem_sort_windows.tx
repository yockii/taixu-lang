// ffi-mem-callback 排序的 Windows 实现：ucrtbase 的 qsort，比较函数在 ffimem_cmp.tx。
import { byValue } from "./ffimem_cmp";

declare function qsort(base: usize, n: usize, w: usize, cmp: (usize, usize) => i32): void from "ucrtbase";

export function sortInts(p: int, n: int): void {
    qsort(p as usize, n as usize, 4, byValue);
}
