// 泄漏检查（TOOL-84 第一步，泄漏检查设计 §四）：以 --leak-check 构建，有意留下三种环——Ref 经自身的 List 字段
// 指回自己、List 里的闭包捕获这个 List、子线程里的同类环；另有模块级变量持有的无环结构（退出时放开，不算泄漏）。
// 期望：子线程报告 2 个对象（Ref 与它的 List）；主线程报告 4 个——同样的一对，加上闭包所在的 List 与闭包捕获的
// 环境（显示为 Ref，位置指向闭包表达式）；退出码 23。模块级变量 keep 在检查前放开，不算泄漏。
struct Node {
    name: string,
    kids: List< Ref< Node>>,
}

let keep: List< string> = listNew();

function selfLoop(name: string): int {
    const n: Ref< Node> = new Node { name: name, kids: listNew() };
    listPush(n.kids, n);
    return listLen(n.kids);
}

function closureLoop(): int {
    const fs: List< () => int> = listNew();
    listPush(fs, (): int => listLen(fs));
    return listLen(fs);
}

function main(args: []string): int {
    listPush(keep, "kept");
    print("self " + toStr(selfLoop("a")));
    print("closure " + toStr(closureLoop()));
    const t = threadSpawn((): int => selfLoop("t"));
    print("thread " + toStr(threadJoin(t) catch -1));
    return 0;
}
