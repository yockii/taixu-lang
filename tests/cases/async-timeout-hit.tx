// V0.10-A1 e2e：timeout 命中（D29 §二）——原任务挂不到期定时器，
// timeout(f, 0) 即刻裁决 err("timeout")；失败者 taskCancel（取消即清理）。
import { timeout } from "std/task";

function main(args: []string): int {
    const t = runner();
    print("spawned");
    return 0;
}

async function runner(): int {
    const slow = stalled(7);
    const v = await timeout(slow, 0) catch (e) {
        print("timeout err: " + e.message);
        return 0;
    };
    print("unreachable: " + toStr(v));
    return 0;
}

async function stalled(n: int): int {
    const s = sleepMs(60000);
    await s catch (e) {
        return err(e.message);
    };
    return n;
}
