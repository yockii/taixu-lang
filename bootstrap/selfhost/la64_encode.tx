// LoongArch64（LA64 v1.00 基本指令集）指令编码。
// 指令定长 32 位，寄存器字段从第 0 位起排（rd 4:0、rj 9:5、rk 14:10、ra 19:15），操作码从第 31 位往下排；每种格式一个纯函数，
// 收操作码常量与字段，返回编码字，字段编不出时返回 -1，不悄悄改写。合法化（大常数、大偏移、远跳）在上一层做。
// 寄存器参数是编码号 0..31（通用 r0..r31、浮点 f0..f31），条件标志 fcc 为 0..7。偏移一律是相对本条指令的字节数。
// 只收后端用到的子集：不收 LSX／LASX、v1.1 新增指令（amcas、llacq／screl 等），也不收融合乘加（不做 a*b+c 的隐式融合）。
// 校验：tests/la64/encodings.txt（scripts/la64-encodings.tx 交 LLVM 与 GNU as 两家汇编器生成，两边须一致）经
// bootstrap/la64_encode_probe.tx 逐条核对；指令表（助记符、格式、寄存器类别）在 la64_disasm.tx，表项引用这里的常量。

// ---------------------------------------------------------------- 格式
export const LA64_F_2R: int = 1; // op rd, rj
export const LA64_F_3R: int = 2; // op rd, rj, rk
export const LA64_F_UI5: int = 3; // op rd, rj, ui5（32 位移位）
export const LA64_F_UI6: int = 4; // op rd, rj, ui6（64 位移位）
export const LA64_F_SI12: int = 5; // op rd, rj, si12（addi、slti、读写）
export const LA64_F_UI12: int = 6; // op rd, rj, ui12（andi、ori、xori）
export const LA64_F_SI14: int = 7; // op rd, rj, 偏移（4 的倍数，±32 KiB：ll／sc／ldptr／stptr）
export const LA64_F_SI20: int = 8; // op rd, si20（lu12i.w、lu32i.d、pcaddu12i 等）
export const LA64_F_BSTR: int = 9; // op rd, rj, msbd, lsbd
export const LA64_F_CODE: int = 10; // op code15（syscall、break、dbar、ibar）
export const LA64_F_JIRL: int = 11; // jirl rd, rj, 偏移（4 的倍数，±128 KiB）
export const LA64_F_B16: int = 12; // op rj, rd, 偏移（beq 类，±128 KiB）
export const LA64_F_B21: int = 13; // op rj, 偏移（beqz／bnez，±4 MiB）
export const LA64_F_BC21: int = 14; // op cj, 偏移（bceqz／bcnez，±4 MiB）
export const LA64_F_B26: int = 15; // op 偏移（b／bl，±128 MiB）
export const LA64_F_AM: int = 16; // op rd, rk, rj（AM*：rd 不得与 rj 相同，非零时也不得与 rk 相同）
export const LA64_F_FCMP: int = 17; // fcmp.cond.d cd, fj, fk
export const LA64_F_CF2GR: int = 18; // movcf2gr rd, cj
export const LA64_F_FSEL: int = 19; // fsel fd, fj, fk, ca

// ---------------------------------------------------------------- 操作码
// 整数三寄存器
export const LA64_ADD_W: int = 0x00100000;
export const LA64_ADD_D: int = 0x00108000;
export const LA64_SUB_W: int = 0x00110000;
export const LA64_SUB_D: int = 0x00118000;
export const LA64_SLT: int = 0x00120000;
export const LA64_SLTU: int = 0x00128000;
export const LA64_MASKEQZ: int = 0x00130000;
export const LA64_MASKNEZ: int = 0x00138000;
export const LA64_NOR: int = 0x00140000;
export const LA64_AND: int = 0x00148000;
export const LA64_OR: int = 0x00150000;
export const LA64_XOR: int = 0x00158000;
export const LA64_SLL_W: int = 0x00170000;
export const LA64_SRL_W: int = 0x00178000;
export const LA64_SRA_W: int = 0x00180000;
export const LA64_SLL_D: int = 0x00188000;
export const LA64_SRL_D: int = 0x00190000;
export const LA64_SRA_D: int = 0x00198000;
export const LA64_MUL_W: int = 0x001c0000;
export const LA64_MUL_D: int = 0x001d8000;
export const LA64_MULH_D: int = 0x001e0000;
export const LA64_MULH_DU: int = 0x001e8000;
export const LA64_DIV_W: int = 0x00200000;
export const LA64_MOD_W: int = 0x00208000;
export const LA64_DIV_WU: int = 0x00210000;
export const LA64_MOD_WU: int = 0x00218000;
export const LA64_DIV_D: int = 0x00220000;
export const LA64_MOD_D: int = 0x00228000;
export const LA64_DIV_DU: int = 0x00230000;
export const LA64_MOD_DU: int = 0x00238000;
// 两寄存器
export const LA64_EXT_W_H: int = 0x00005800;
export const LA64_EXT_W_B: int = 0x00005c00;
// 移位立即数
export const LA64_SLLI_W: int = 0x00408000;
export const LA64_SLLI_D: int = 0x00410000;
export const LA64_SRLI_W: int = 0x00448000;
export const LA64_SRLI_D: int = 0x00450000;
export const LA64_SRAI_W: int = 0x00488000;
export const LA64_SRAI_D: int = 0x00490000;
// 位段
export const LA64_BSTRINS_D: int = 0x00800000;
export const LA64_BSTRPICK_D: int = 0x00c00000;
// 12 位立即数
export const LA64_SLTI: int = 0x02000000;
export const LA64_SLTUI: int = 0x02400000;
export const LA64_ADDI_W: int = 0x02800000;
export const LA64_ADDI_D: int = 0x02c00000;
export const LA64_LU52I_D: int = 0x03000000;
export const LA64_ANDI: int = 0x03400000;
export const LA64_ORI: int = 0x03800000;
export const LA64_XORI: int = 0x03c00000;
// 20 位立即数
export const LA64_LU12I_W: int = 0x14000000;
export const LA64_LU32I_D: int = 0x16000000;
export const LA64_PCADDI: int = 0x18000000;
export const LA64_PCALAU12I: int = 0x1a000000;
export const LA64_PCADDU12I: int = 0x1c000000;
export const LA64_PCADDU18I: int = 0x1e000000;
// 14 位偏移（×4）
export const LA64_LL_W: int = 0x20000000;
export const LA64_SC_W: int = 0x21000000;
export const LA64_LL_D: int = 0x22000000;
export const LA64_SC_D: int = 0x23000000;
export const LA64_LDPTR_W: int = 0x24000000;
export const LA64_STPTR_W: int = 0x25000000;
export const LA64_LDPTR_D: int = 0x26000000;
export const LA64_STPTR_D: int = 0x27000000;
// 读写（12 位偏移）
export const LA64_LD_B: int = 0x28000000;
export const LA64_LD_H: int = 0x28400000;
export const LA64_LD_W: int = 0x28800000;
export const LA64_LD_D: int = 0x28c00000;
export const LA64_ST_B: int = 0x29000000;
export const LA64_ST_H: int = 0x29400000;
export const LA64_ST_W: int = 0x29800000;
export const LA64_ST_D: int = 0x29c00000;
export const LA64_LD_BU: int = 0x2a000000;
export const LA64_LD_HU: int = 0x2a400000;
export const LA64_LD_WU: int = 0x2a800000;
export const LA64_FLD_S: int = 0x2b000000;
export const LA64_FST_S: int = 0x2b400000;
export const LA64_FLD_D: int = 0x2b800000;
export const LA64_FST_D: int = 0x2bc00000;
// 读写（变址）
export const LA64_LDX_B: int = 0x38000000;
export const LA64_LDX_H: int = 0x38040000;
export const LA64_LDX_W: int = 0x38080000;
export const LA64_LDX_D: int = 0x380c0000;
export const LA64_STX_B: int = 0x38100000;
export const LA64_STX_H: int = 0x38140000;
export const LA64_STX_W: int = 0x38180000;
export const LA64_STX_D: int = 0x381c0000;
export const LA64_LDX_BU: int = 0x38200000;
export const LA64_LDX_HU: int = 0x38240000;
export const LA64_LDX_WU: int = 0x38280000;
export const LA64_FLDX_S: int = 0x38300000;
export const LA64_FLDX_D: int = 0x38340000;
export const LA64_FSTX_S: int = 0x38380000;
export const LA64_FSTX_D: int = 0x383c0000;
// 原子（带全屏障的 _db 形）
export const LA64_AMSWAP_DB_W: int = 0x38690000;
export const LA64_AMSWAP_DB_D: int = 0x38698000;
export const LA64_AMADD_DB_W: int = 0x386a0000;
export const LA64_AMADD_DB_D: int = 0x386a8000;
// 系统
export const LA64_BREAK: int = 0x002a0000;
export const LA64_SYSCALL: int = 0x002b0000;
export const LA64_DBAR: int = 0x38720000;
export const LA64_IBAR: int = 0x38728000;
// 跳转
export const LA64_BEQZ: int = 0x40000000;
export const LA64_BNEZ: int = 0x44000000;
export const LA64_BCEQZ: int = 0x48000000;
export const LA64_BCNEZ: int = 0x48000100;
export const LA64_JIRL: int = 0x4c000000;
export const LA64_B: int = 0x50000000;
export const LA64_BL: int = 0x54000000;
export const LA64_BEQ: int = 0x58000000;
export const LA64_BNE: int = 0x5c000000;
export const LA64_BLT: int = 0x60000000;
export const LA64_BGE: int = 0x64000000;
export const LA64_BLTU: int = 0x68000000;
export const LA64_BGEU: int = 0x6c000000;
// 浮点（双精度运算；单精度只用于搬运与舍入）
export const LA64_FADD_D: int = 0x01010000;
export const LA64_FSUB_D: int = 0x01030000;
export const LA64_FMUL_D: int = 0x01050000;
export const LA64_FDIV_D: int = 0x01070000;
export const LA64_FMAX_D: int = 0x01090000;
export const LA64_FMIN_D: int = 0x010b0000;
export const LA64_FABS_D: int = 0x01140800;
export const LA64_FNEG_D: int = 0x01141800;
export const LA64_FSQRT_D: int = 0x01144800;
export const LA64_FMOV_D: int = 0x01149800;
export const LA64_MOVGR2FR_W: int = 0x0114a400;
export const LA64_MOVGR2FR_D: int = 0x0114a800;
export const LA64_MOVFR2GR_S: int = 0x0114b400;
export const LA64_MOVFR2GR_D: int = 0x0114b800;
export const LA64_MOVCF2GR: int = 0x0114dc00;
export const LA64_FCVT_S_D: int = 0x01191800;
export const LA64_FCVT_D_S: int = 0x01192400;
export const LA64_FTINTRZ_L_D: int = 0x011aa800;
export const LA64_FFINT_D_L: int = 0x011d2800;
export const LA64_FCMP_D: int = 0x0c200000;
export const LA64_FSEL: int = 0x0d000000;

// fcmp 的条件（cond 字段，19:15）：c 为不报 QNaN 的比较，s 为信号型（c＋1）。IEEE 的 != 用 CUNE（CNE 是有序不等，遇 NaN 为假）。
export const LA64_CAF: int = 0;
export const LA64_CLT: int = 2;
export const LA64_CEQ: int = 4;
export const LA64_CLE: int = 6;
export const LA64_CUN: int = 8;
export const LA64_CULT: int = 10;
export const LA64_CUEQ: int = 12;
export const LA64_CULE: int = 14;
export const LA64_CNE: int = 16;
export const LA64_COR: int = 20;
export const LA64_CUNE: int = 24;

// 寄存器号（psABI 的角色名）。
export const LA64_ZERO: int = 0;
export const LA64_RA: int = 1;
export const LA64_TP: int = 2;
export const LA64_SP: int = 3;
export const LA64_A0: int = 4;
export const LA64_T0: int = 12;
export const LA64_FP: int = 22;
export const LA64_S0: int = 23;

function isReg(r: int): bool { return r >= 0 && r <= 31; }
function fits(v: int, lo: int, hi: int): bool { return v >= lo && v <= hi; }
function isCond(c: int): bool { return fits(c, 0, 17) || c == 20 || c == 21 || c == 24 || c == 25; }

/// op rd, rj：两寄存器（ext.w.b、浮点单源、movgr2fr／movfr2gr 等，寄存器类别随指令）。
export function la64R2(op: int, rd: int, rj: int): int {
    if (!isReg(rd) || !isReg(rj)) { return -1; }
    return op | (rj << 5) | rd;
}
/// op rd, rj, rk：三寄存器。
export function la64R3(op: int, rd: int, rj: int, rk: int): int {
    if (!isReg(rd) || !isReg(rj) || !isReg(rk)) { return -1; }
    return op | (rk << 10) | (rj << 5) | rd;
}
/// op rd, rj, ui：移位立即数，width 32（ui5）或 64（ui6）。
export function la64Shift(op: int, rd: int, rj: int, ui: int, width: int): int {
    if (!isReg(rd) || !isReg(rj) || !(width == 32 || width == 64) || !fits(ui, 0, width - 1)) { return -1; }
    return op | (ui << 10) | (rj << 5) | rd;
}
/// op rd, rj, si12：有符号 12 位立即数（addi、slti、sltui、lu52i.d、读写的偏移）。
export function la64Si12(op: int, rd: int, rj: int, si12: int): int {
    if (!isReg(rd) || !isReg(rj) || !fits(si12, -2048, 2047)) { return -1; }
    return op | ((si12 & 4095) << 10) | (rj << 5) | rd;
}
/// op rd, rj, ui12：无符号 12 位立即数（andi、ori、xori）。
export function la64Ui12(op: int, rd: int, rj: int, ui12: int): int {
    if (!isReg(rd) || !isReg(rj) || !fits(ui12, 0, 4095)) { return -1; }
    return op | (ui12 << 10) | (rj << 5) | rd;
}
/// op rd, rj, 偏移：14 位字段存偏移 / 4（ll、sc、ldptr、stptr），偏移须为 4 的倍数、在 −32768..32764。
export function la64Si14(op: int, rd: int, rj: int, offset: int): int {
    if (!isReg(rd) || !isReg(rj) || offset % 4 != 0 || !fits(offset, -32768, 32764)) { return -1; }
    return op | (((offset / 4) & 16383) << 10) | (rj << 5) | rd;
}
/// op rd, si20：有符号 20 位立即数（lu12i.w、lu32i.d、pcaddi、pcalau12i、pcaddu12i、pcaddu18i）。
export function la64Si20(op: int, rd: int, si20: int): int {
    if (!isReg(rd) || !fits(si20, -524288, 524287)) { return -1; }
    return op | ((si20 & 1048575) << 5) | rd;
}
/// bstrpick.d／bstrins.d rd, rj, msbd, lsbd：0 ≤ lsbd ≤ msbd ≤ 63。
export function la64Bstr(op: int, rd: int, rj: int, msbd: int, lsbd: int): int {
    if (!isReg(rd) || !isReg(rj) || !fits(lsbd, 0, 63) || !fits(msbd, lsbd, 63)) { return -1; }
    return op | (msbd << 16) | (lsbd << 10) | (rj << 5) | rd;
}
/// op code：15 位码（syscall、break、dbar、ibar）。
export function la64Code(op: int, code: int): int {
    if (!fits(code, 0, 32767)) { return -1; }
    return op | code;
}
/// jirl rd, rj, 偏移：跳到 rj＋偏移、返回地址进 rd；偏移为 4 的倍数、±128 KiB。
export function la64Jirl(rd: int, rj: int, offset: int): int {
    if (!isReg(rd) || !isReg(rj) || offset % 4 != 0 || !fits(offset, -131072, 131068)) { return -1; }
    return LA64_JIRL | (((offset / 4) & 65535) << 10) | (rj << 5) | rd;
}
/// beq／bne／blt／bge／bltu／bgeu rj, rd, 偏移：±128 KiB。
export function la64B16(op: int, rj: int, rd: int, offset: int): int {
    if (!isReg(rj) || !isReg(rd) || offset % 4 != 0 || !fits(offset, -131072, 131068)) { return -1; }
    return op | (((offset / 4) & 65535) << 10) | (rj << 5) | rd;
}
/// beqz／bnez rj, 偏移：±4 MiB；偏移／4 的低 16 位在 25:10、高 5 位在 4:0。
export function la64B21(op: int, rj: int, offset: int): int {
    if (!isReg(rj) || offset % 4 != 0 || !fits(offset, -4194304, 4194300)) { return -1; }
    const w = (offset / 4) & 2097151;
    return op | ((w & 65535) << 10) | (rj << 5) | (w >>> 16);
}
/// bceqz／bcnez cj, 偏移：按条件标志 fcc 跳，±4 MiB。
export function la64Bc21(op: int, cj: int, offset: int): int {
    if (!fits(cj, 0, 7) || offset % 4 != 0 || !fits(offset, -4194304, 4194300)) { return -1; }
    const w = (offset / 4) & 2097151;
    return op | ((w & 65535) << 10) | (cj << 5) | (w >>> 16);
}
/// b／bl 偏移：±128 MiB；偏移／4 的低 16 位在 25:10、高 10 位在 9:0。
export function la64B26(op: int, offset: int): int {
    if (offset % 4 != 0 || !fits(offset, -134217728, 134217724)) { return -1; }
    const w = (offset / 4) & 67108863;
    return op | ((w & 65535) << 10) | (w >>> 16);
}
/// AM* rd, rk, rj：[rj] 的旧值进 rd、新值由 rk 算出。rd 与 rj 相同为非法指令，rd 非零时与 rk 相同结果不定，都拒绝。
export function la64Am(op: int, rd: int, rk: int, rj: int): int {
    if (!isReg(rd) || !isReg(rk) || !isReg(rj) || rd == rj || (rd != 0 && rd == rk)) { return -1; }
    return op | (rk << 10) | (rj << 5) | rd;
}
/// fcmp.cond.d cd, fj, fk：比较结果写进条件标志 fcc[cd]。
export function la64Fcmp(cond: int, cd: int, fj: int, fk: int): int {
    if (!isCond(cond) || !fits(cd, 0, 7) || !isReg(fj) || !isReg(fk)) { return -1; }
    return LA64_FCMP_D | (cond << 15) | (fk << 10) | (fj << 5) | cd;
}
/// movcf2gr rd, cj：rd 的最低位取 fcc[cj]，其余位清零。
export function la64Movcf2gr(rd: int, cj: int): int {
    if (!isReg(rd) || !fits(cj, 0, 7)) { return -1; }
    return LA64_MOVCF2GR | (cj << 5) | rd;
}
/// fsel fd, fj, fk, ca：fcc[ca] 为 0 取 fj，否则取 fk。
export function la64Fsel(fd: int, fj: int, fk: int, ca: int): int {
    if (!isReg(fd) || !isReg(fj) || !isReg(fk) || !fits(ca, 0, 7)) { return -1; }
    return LA64_FSEL | (ca << 15) | (fk << 10) | (fj << 5) | fd;
}
