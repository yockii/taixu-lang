// std/math 公共包装：两平台共享纯太虚 math_impl；不再绑定宿主。精度口径见 math_impl.tx
// （常规域约 1–2ulp；pow/cbrt 约 2ulp；三角大参数归约精度随 |x| 衰减）。PI/E 经函数取值。
import { mAbs, mAcos, mAsin, mAtan, mAtan2, mCbrt, mCeil, mCos, mE, mExp, mFloor, mHypot, mLog, mLog10, mLog2, mMax, mMin, mPi, mPow, mRound, mSin, mSqrt, mTan, mTrunc } from "./math_impl";

export function PI(): float {
    return mPi();
}

export function E(): float {
    return mE();
}

export function sin(x: float): float {
    return mSin(x);
}

export function cos(x: float): float {
    return mCos(x);
}

export function tan(x: float): float {
    return mTan(x);
}

export function asin(x: float): float {
    return mAsin(x);
}

export function acos(x: float): float {
    return mAcos(x);
}

export function atan(x: float): float {
    return mAtan(x);
}

export function atan2(y: float, x: float): float {
    return mAtan2(y, x);
}

export function sqrt(x: float): float {
    return mSqrt(x);
}

export function cbrt(x: float): float {
    return mCbrt(x);
}

export function pow(x: float, y: float): float {
    return mPow(x, y);
}

export function exp(x: float): float {
    return mExp(x);
}

export function log(x: float): float {
    return mLog(x);
}

export function log2(x: float): float {
    return mLog2(x);
}

export function log10(x: float): float {
    return mLog10(x);
}

export function floor(x: float): float {
    return mFloor(x);
}

export function ceil(x: float): float {
    return mCeil(x);
}

// round：半值远离零（C round／Go 语义——与 TS Math.round 的半值向 +∞ 有
// 差异，文档声明面）。
export function round(x: float): float {
    return mRound(x);
}

export function trunc(x: float): float {
    return mTrunc(x);
}

export function abs(x: float): float {
    return mAbs(x);
}

export function fmin(x: float, y: float): float {
    return mMin(x, y);
}

export function fmax(x: float, y: float): float {
    return mMax(x, y);
}

export function hypot(x: float, y: float): float {
    return mHypot(x, y);
}
