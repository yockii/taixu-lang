// 拼接累加环的条件读累加变量：不得走拼接帧缓冲（环内累加值出口才物化，条件会读到
// 进环前的旧值——原生产物与 Zig AOT 曾在此死循环）。同时保留一个照常优化的环对照。
function padStart(s: string, width: int, pad: string): string {
    const n = len(s);
    if (n >= width || len(pad) == 0) {
        return s;
    }
    let fill: string = "";
    while (len(fill) < width - n) {
        fill = fill + pad;
    }
    return strSub(fill, 0, width - n) + s;
}

function grow(limit: int): string {
    let s: string = "a";
    while (len(s) < limit) {
        s = "b" + s;
    }
    return s;
}

function repeat(s: string, n: int): string {
    let out: string = "";
    let i: int = 0;
    while (i < n) {
        out = out + s;
        i = i + 1;
    }
    return out;
}

export function main(args: []string): int {
    print(padStart("7", 3, "0"));
    print(padStart("42", 7, "ab"));
    print(grow(5));
    print(repeat("xy", 4));
    return 0;
}
