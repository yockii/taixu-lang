// 第 6 轮 6c-4a 工具链内建 currentDir 的失败路径（Linux，伴文件 proc-cwd-gone.linux 与 .toolchain）：子进程在一个
// 新建的目录里启动并等 stdin，父进程删掉这个目录后放行，子进程的 currentDir 得 Error "no such file: ."（getcwd 报
// ENOENT）。
declare function sysRmdir(path: string): int from syscall 84;

function argv1(mode: string): List< string> {
    const xs: List< string> = listNew();
    listPush(xs, mode);
    return xs;
}

function child(): int {
    const buf = bytesNew(16);
    const n = stdinRead(buf, 10000);
    if (n <= 0) {
        print("child: no go " + toStr(n));
        return 2;
    }
    const d = currentDir() catch (e) {
        print("child: " + e.message);
        return 0;
    };
    print("child: unexpected " + d);
    return 1;
}

function main(args: []string): int {
    if (len(args) >= 1) { return child(); }
    const dir = tempDir() + "/taixu-proc-cwd-gone";
    sysRmdir(dir);
    makeDir(dir) catch (e) {
        print("makeDir failed: " + e.message);
        return 1;
    };
    const h = procSpawn(selfExePath(), argv1("child"), dir, 1) catch (e) {
        print("spawn failed: " + e.message);
        return 1;
    };
    print("rmdir: " + toStr(sysRmdir(dir)));
    print("go: " + toStr(procWrite(h, 0, bytesFromStr("go\n"))));
    const buf = bytesNew(256);
    let got = "";
    while (true) {
        if (ioWait(h, 2, 10000) == 0) {
            got = got + "<timeout>";
            break;
        }
        const n = procRead(h, 1, buf);
        if (n < 0) { break; }
        got = got + (bytesToStr(bytesSlice(buf, 0, n)) catch "?");
    }
    print(got + "exit " + toStr(procWait(h, 10000) catch -999));
    procClose(h);
    return 0;
}
