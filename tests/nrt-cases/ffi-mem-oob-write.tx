// D3 v0.48 外部内存区：负偏移写，trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function main(args: []string): int {
    const m = ffiMem(pageAlloc(), 16, true) catch (e) { print(e.message); return 1; };
    ffiMemWrite(m, 14, bytesNew(2));
    print("ok");
    ffiMemWrite(m, -1, bytesNew(2));
    print("never");
    return 0;
}
