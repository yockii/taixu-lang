// 泄漏检查（TOOL-84 第一步）：`taixu test --leak-check` 下每个 test 块各在一个进程里检查，留下环的那一个失败。
struct Node {
    name: string,
    kids: List< Ref< Node>>,
}

test "无环" {
    const n: Ref< Node> = new Node { name: "a", kids: listNew() };
    listPush(n.kids, new Node { name: "b", kids: listNew() });
    assert(listLen(n.kids) == 1, "一个孩子");
}

test "自环" {
    const n: Ref< Node> = new Node { name: "a", kids: listNew() };
    listPush(n.kids, n);
    assert(listLen(n.kids) == 1, "一个孩子");
}

export function main(args: []string): int { return 0; }
