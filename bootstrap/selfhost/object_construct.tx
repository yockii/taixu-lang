// Native heap/frame constructors: bytecode facts enter through ObjectSpec64.
import { StructuredBuffer } from "./assemble";
import { nr, nd, ni, nm, nmd, nt, nmov, nl, nj, nc, nret } from "./native_emit";
function construct(b: Ref<StructuredBuffer>, name: string, mode: int, frame: bool): void {
    nl(b, name); nt(b, "sub", nr(4), ni(184)); nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 64), nd(9));
    nmov(b, nd(10), nmd(4, 224)); nmov(b, nmd(4, 68), nd(10));
    if (frame || mode == 3) { nmov(b, nr(10), nm(4, 232)); nmov(b, nm(4, 72), nr(10)); }
    nmov(b, nd(1), nd(2)); nmov(b, nd(2), nd(8)); nmov(b, nd(8), nmd(4, 68)); nmov(b, nd(9), ni(mode)); nmov(b, nr(10), nr(4)); nt(b, "add", nr(10), ni(80)); nmov(b, nm(4, 32), nr(10)); nc(b, "__tx_native_construct_facts_v1");
    if (frame) {
        nmov(b, nr(1), nm(4, 72)); nmov(b, nr(2), nm(4, 104)); nmov(b, nm(4, 96), nr(1)); nc(b, "__tx_native_values_init_v1"); nt(b, "test", nd(0), nd(0)); nj(b, "jz", name + "_oom");
    } else {
        nmov(b, nr(1), nm(4, 104)); nc(b, "__tx_native_values_alloc_v1"); nmov(b, nm(4, 96), nr(0)); nt(b, "test", nr(0), nr(0)); nj(b, "jne", name + "_allocated"); nt(b, "cmp", nm(4, 104), ni(0)); nj(b, "jne", name + "_oom"); nl(b, name + "_allocated");
    }
    nmov(b, nd(1), ni(0)); if (frame) { nmov(b, nd(1), ni(1)); } nc(b, "__tx_native_construct_stat_v1");
    nmov(b, nd(1), nmd(4, 56)); nmov(b, nd(2), nmd(4, 60)); nc(b, "__tx_site_of"); nmov(b, nmd(4, 88), nd(0));
    nmov(b, nr(1), nr(4)); nt(b, "add", nr(1), ni(80)); nc(b, "__tx_native_object_create_v1"); nmov(b, nmd(4, 160), nd(0));
    if (frame) { nmov(b, nd(1), nd(0)); nc(b, "__tx_native_object_address_v1"); nmov(b, nd(10), nmd(0, 0)); nt(b, "or", nd(10), ni(4)); nmov(b, nmd(0, 0), nd(10)); }
    let tag = mode + 7; if (mode == 3) { tag = 10; }
    nmov(b, nm(4, 144), ni(tag)); nmov(b, nd(10), nmd(4, 160)); nmov(b, nm(4, 152), nr(10));
    if (mode == 3 && frame == false) {
        nt(b, "cmp", nmd(4, 72), ni(0)); nj(b, "je", name + "_result");
        // The initial array reference becomes the slice owner's reference.
        nmov(b, nmd(4, 80), ni(7)); nmov(b, nmd(4, 92), ni(4)); nmov(b, nmd(4, 120), nd(10)); nmov(b, nd(11), nmd(4, 104)); nmov(b, nmd(4, 124), nd(11));
        nmov(b, nm(4, 96), ni(0)); nmov(b, nm(4, 104), ni(0)); nmov(b, nm(4, 112), ni(0)); nmov(b, nr(1), nr(4)); nt(b, "add", nr(1), ni(80)); nc(b, "__tx_native_object_create_v1"); nmov(b, nd(10), nd(0)); nmov(b, nm(4, 152), nr(10)); nmov(b, nm(4, 144), ni(11));
    }
    nl(b, name + "_result"); nmov(b, nd(1), nmd(4, 64)); nt(b, "shl", nr(1), ni(4)); nt(b, "add", nr(1), nm(4, 48)); nmov(b, nm(4, 168), nr(1)); nc(b, "__tx_release"); nmov(b, nr(1), nm(4, 168)); nmov(b, nr(10), nm(4, 144)); nmov(b, nm(1, 0), nr(10)); nmov(b, nr(10), nm(4, 152)); nmov(b, nm(1, 8), nr(10));
    nt(b, "add", nr(4), ni(184)); nret(b); nl(b, name + "_oom"); nc(b, "__tx_native_object_oom_v1"); nt(b, "add", nr(4), ni(184)); nret(b);
}
export function objectConstructNames(): List<string> {
    const names: List<string> = listNew(); listPush(names, "__tx_newstruct"); listPush(names, "__tx_newenum"); listPush(names, "__tx_newref"); listPush(names, "__tx_newarrsl"); listPush(names, "__tx_newstruct_fr"); listPush(names, "__tx_newenum_fr"); listPush(names, "__tx_newref_fr"); listPush(names, "__tx_newarr_fr"); return names;
}
export function objectConstructEmit(b: Ref<StructuredBuffer>): void {
    construct(b, "__tx_newstruct", 0, false); construct(b, "__tx_newenum", 1, false); construct(b, "__tx_newref", 2, false); construct(b, "__tx_newarrsl", 3, false);
    construct(b, "__tx_newstruct_fr", 0, true); construct(b, "__tx_newenum_fr", 1, true); construct(b, "__tx_newref_fr", 2, true); construct(b, "__tx_newarr_fr", 3, true);
}
