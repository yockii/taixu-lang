// ============================================================================
// engine/replay —— 重放与定格的会话配置（GUI 原生引擎 G0）。
//
// 脚本格式 v1.2：
//   # 注释行与空行忽略
//   step N          虚拟时钟步长（毫秒，须为正；缺省 16）
//   scale X         重放态 DPI×100（100..1000；缺省 100）
//   win I           之后的数据行发给第 I 个存活的脚本窗（0..7；缺省 0）
//   dialog 路径     打开文件对话框的结果队列（行剩余部分即路径，按行序弹出）
//   帧 kind target x y [mods]   数据行，恰 5 或 6 个字段，帧号 ≥1
// 配置来自环境变量（第一次用到窗口、事件、呈现或能力查询时读一次）：
//   TAIXU_REPLAY    重放脚本路径；有至少一条数据行即为重放态
//   TAIXU_FRAME     定格帧号（第 N 次成功呈现后写三伴）
//   TAIXU_OUT_DIR   三伴目录（缺省为当前目录；不存在则逐级创建）
// 旧 CLI 旗标 --replay/--frame/--out-dir 随旧宿主退场。配置错误即 panic（进程以非零码结束；旧宿主
// 为退出码 2）。
// ============================================================================

import { getenv } from "std/os";

let loaded: bool = false;
let scriptGiven: bool = false;
let lines: List<int> = listNew(); // 每条数据行 7 项：帧、kind、target、x、y、mods、窗下标
let stepMs: int = 16;
let scaleX100: int = 100;
let dialogs: List<string> = listNew();
let dialogNext: int = 0;
let freezeAt: int = 0;
let outDir: string = "";
let stem: string = "frame";

const LINE_SLOTS: int = 7;
const MAX_SCRIPT_BYTES: int = 1048576;
const BAD: int = -4294967296; // parseDec 的“不合法”

/// 读一次会话配置（幂等）。
export function replayLoad(): void {
    if (loaded) {
        return;
    }
    loaded = true;
    const path: string = getenv("TAIXU_REPLAY");
    if (path != "") {
        const msg: string = parseScript(path);
        if (msg != "") {
            panic("TAIXU_REPLAY=" + path + "：" + msg);
        }
        scriptGiven = true;
        stem = stemOf(path);
    }
    const frame: string = getenv("TAIXU_FRAME");
    if (frame != "") {
        const n: int = parseDec(bytesFromStr(frame), false, 4294967295);
        if (n < 1) {
            panic("TAIXU_FRAME 须为正整数：" + frame);
        }
        freezeAt = n;
        outDir = getenv("TAIXU_OUT_DIR");
        if (outDir == "") {
            outDir = ".";
        }
    }
}

/// 重放态：脚本至少有一条数据行（开窗恒退回脚本窗、DPI 与对话框结果取自脚本）。
export function replayActive(): bool {
    return listLen(lines) > 0;
}

/// 给了重放脚本（剪贴板改走进程内模拟板）。
export function replayScriptGiven(): bool {
    return scriptGiven;
}

/// 数据行（每行 7 项，只读）。
export function replayLines(): List<int> {
    return lines;
}

export function replayStepMs(): int {
    return stepMs;
}

export function replayScale(): int {
    return scaleX100;
}

/// 弹出下一个对话框结果；队列空得空串（即“取消”）。
export function replayDialogPop(): string {
    const p: string = listTryGet(dialogs, dialogNext) catch "";
    if (dialogNext < listLen(dialogs)) {
        dialogNext = dialogNext + 1;
    }
    return p;
}

/// 定格帧号（0 为不定格）、三伴目录与主名。
export function freezeFrame(): int {
    return freezeAt;
}

export function freezeOutDir(): string {
    return outDir;
}

export function freezeStem(): string {
    return stem;
}

// 脚本主名：去掉目录（/ 与 \ 都算）与最后一个扩展名。
function stemOf(path: string): string {
    const b = bytesFromStr(path);
    let start: int = 0;
    let dot: int = -1;
    let i: int = 0;
    while (i < bytesLen(b)) {
        const c: int = bytesGet(b, i) catch 0;
        if (c == 47 || c == 92) {
            start = i + 1;
            dot = -1;
        } else if (c == 46) {
            dot = i;
        }
        i = i + 1;
    }
    let end: int = bytesLen(b);
    if (dot > start) {
        end = dot;
    }
    return bytesToStr(bytesSlice(b, start, end - start)) catch "frame";
}

function isSpace(c: int): bool {
    return c == 32 || c == 9 || c == 13;
}

// 十进制整数：可带一个 + 号（signed 时也可带 - 号），至少一位数字；不超过 limit（有符号时
// 下限为 -(limit+1)）。不合法得 BAD（低于一切合法值）。
function parseDec(b: Bytes, signed: bool, limit: int): int {
    const n: int = bytesLen(b);
    let i: int = 0;
    let neg: bool = false;
    if (n > 0 && ((bytesGet(b, 0) catch 0) == 43 || ((bytesGet(b, 0) catch 0) == 45 && signed))) {
        neg = (bytesGet(b, 0) catch 0) == 45;
        i = 1;
    }
    if (i >= n || n - i > 12) {
        return BAD;
    }
    let v: int = 0;
    while (i < n) {
        const c: int = bytesGet(b, i) catch 0;
        if (c < 48 || c > 57) {
            return BAD;
        }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg) {
        if (v > limit + 1) {
            return BAD;
        }
        return -v;
    }
    if (v > limit) {
        return BAD;
    }
    return v;
}

// 一行里从 at 起按空白切出的下一个字段（[起, 止)）；没有时起为 -1。
function nextField(b: Bytes, at: int, end: int, out: List<int>): void {
    let s: int = at;
    while (s < end && isSpace(bytesGet(b, s) catch 0)) {
        s = s + 1;
    }
    if (s >= end) {
        listSet(out, 0, -1);
        return;
    }
    let e: int = s;
    while (e < end && !isSpace(bytesGet(b, e) catch 0)) {
        e = e + 1;
    }
    listSet(out, 0, s);
    listSet(out, 1, e);
}

function hasPrefix(b: Bytes, s: int, e: int, p: string): bool {
    const n: int = len(p);
    if (e - s < n) {
        return false;
    }
    let i: int = 0;
    while (i < n) {
        if ((bytesGet(b, s + i) catch 0) != (byteTryAt(p, i) catch 0)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 指令行的数值参数：前缀之后整段去掉首尾空白再按十进制解析。
function directiveNum(b: Bytes, s: int, e: int, skip: int): int {
    let a: int = s + skip;
    let z: int = e;
    while (a < z && isSpace(bytesGet(b, a) catch 0)) {
        a = a + 1;
    }
    while (z > a && isSpace(bytesGet(b, z - 1) catch 0)) {
        z = z - 1;
    }
    return parseDec(bytesSlice(b, a, z - a), false, 4294967295);
}

// 解析脚本；成功得空串，否则得错误说明。
function parseScript(path: string): string {
    const b = readFileBytes(path) catch (e) {
        return "读不到重放脚本";
    };
    const n: int = bytesLen(b);
    if (n > MAX_SCRIPT_BYTES) {
        return "重放脚本超过 1 MiB";
    }
    let win: int = 0;
    let lineNo: int = 0;
    let at: int = 0;
    const f: List<int> = listNew();
    listPush(f, 0);
    listPush(f, 0);
    while (at <= n) {
        let eol: int = at;
        while (eol < n && (bytesGet(b, eol) catch 0) != 10) {
            eol = eol + 1;
        }
        lineNo = lineNo + 1;
        let s: int = at;
        let e: int = eol;
        at = eol + 1;
        while (s < e && isSpace(bytesGet(b, s) catch 0)) {
            s = s + 1;
        }
        while (e > s && isSpace(bytesGet(b, e - 1) catch 0)) {
            e = e - 1;
        }
        if (s >= e || (bytesGet(b, s) catch 0) == 35) {
            continue;
        }
        const where: string = "第 " + toStr(lineNo) + " 行";
        if (hasPrefix(b, s, e, "step ")) {
            const v: int = directiveNum(b, s, e, 5);
            if (v < 1) {
                return where + "：step 须为正整数";
            }
            stepMs = v;
            continue;
        }
        if (hasPrefix(b, s, e, "win ")) {
            const v: int = directiveNum(b, s, e, 4);
            if (v < 0 || v >= 8) {
                return where + "：win 须在 0..7";
            }
            win = v;
            continue;
        }
        if (hasPrefix(b, s, e, "scale ")) {
            const v: int = directiveNum(b, s, e, 6);
            if (v < 100 || v > 1000) {
                return where + "：scale 须在 100..1000";
            }
            scaleX100 = v;
            continue;
        }
        if (hasPrefix(b, s, e, "dialog ")) {
            let a: int = s + 7;
            while (a < e && isSpace(bytesGet(b, a) catch 0)) {
                a = a + 1;
            }
            const p: string = bytesToStr(bytesSlice(b, a, e - a)) catch (bad) {
                return where + "：dialog 路径不是合法的 UTF-8";
            };
            listPush(dialogs, p);
            continue;
        }
        // 数据行：帧 kind target x y [mods]。
        const vals: List<int> = listNew();
        let p: int = s;
        while (true) {
            nextField(b, p, e, f);
            const fs: int = listTryGet(f, 0) catch -1;
            if (fs < 0) {
                break;
            }
            const fe: int = listTryGet(f, 1) catch fs;
            const idx: int = listLen(vals);
            if (idx >= 6) {
                return where + "：数据行多于 6 个字段";
            }
            const signed: bool = idx >= 2 && idx <= 4;
            let limit: int = 4294967295;
            if (signed) {
                limit = 2147483647;
            }
            const v: int = parseDec(bytesSlice(b, fs, fe - fs), signed, limit);
            if (v == BAD) {
                return where + "：第 " + toStr(idx + 1) + " 个字段不是合法整数";
            }
            listPush(vals, v);
            p = fe;
        }
        if (listLen(vals) < 5) {
            return where + "：数据行须为 5 或 6 个字段";
        }
        if ((listTryGet(vals, 0) catch 0) < 1) {
            return where + "：帧号须 ≥1";
        }
        let i: int = 0;
        while (i < 5) {
            listPush(lines, listTryGet(vals, i) catch 0);
            i = i + 1;
        }
        listPush(lines, listTryGet(vals, 5) catch 0);
        listPush(lines, win);
    }
    return "";
}
