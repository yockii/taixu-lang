// 兼容变更注册表：仅 struct、const 与字面量树；不得包含可执行初始化。
// since 是首次包含该变化的未发布开发线；implementedIn 记录实际规范来源。
export struct Change {
    id: string,
    kind: int,
    layer: string,
    since: string,
    gate: string,
    diagnostics: []int,
    fix: string,
    applicability: string,
    before: string,
    after: string,
    implementedIn: string,
    explain: string,
    d3: string,
    llmGuide: string,
}

