// NRT M2c: List builtins over the native list descriptor. Obj72 keeps a
// list as meta(elem)@24, aux(form)@28, ptr@32, len@40, cap@48; the native
// algorithms take NativeList ptr@0, len@8, cap@16, form@24, elem@28.
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, I, A } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtRet, rtRetVoid } from "./rtfn";
import { ARITY, check, fatal, trapText, arity, argTag, frozenGuard, pinGuard } from "./nrt_base";

export const NRT_LIST_EXPORTS: string = "__tx_store_list_append __tx_bi_list_push __tx_bi_list_len __tx_bi_list_get __tx_bi_list_pop __tx_bi_list_remove_at __tx_bi_list_insert __tx_bi_list_set";

function listView(f: Ref<RtFn>, obj: string, v0: string, v1: string, v2: string, v3: string): void {
    rtLoad(f, v0, L(obj), 32, 8); rtLoad(f, v1, L(obj), 40, 8); rtLoad(f, v2, L(obj), 48, 8);
    rtLoad(f, v3, L(obj), 24, 8);
    // Obj packs (elem, form) as (meta, aux); NativeList packs (form, elem).
    rtShift(f, "t", L(v3), "shl", 32); rtShift(f, v3, L(v3), "shr", 32); rtOp(f, v3, L(v3), "or", L("t"));
}

function listApply(f: Ref<RtFn>, obj: string, v0: string, v1: string, v2: string, v3: string): void {
    rtStore(f, L(obj), 32, L(v0), 8); rtStore(f, L(obj), 40, L(v1), 8); rtStore(f, L(obj), 48, L(v2), 8);
    rtShift(f, "t", L(v3), "shl", 32); rtShift(f, v3, L(v3), "shr", 32); rtOp(f, v3, L(v3), "or", L("t"));
    rtStore(f, L(obj), 24, L(v3), 8);
}

export function emitNrtLists(b: Ref<StructuredBuffer>): void {
    // __tx_nrt_set_retain(win, a, tag, pay): shared read into a slot.
    let f = rtBegin(b, "__tx_nrt_set_retain", "win a tag pay", "vt vp va", 4, "bootstrap/selfhost/nrt_lists.tx");
    rtSet(f, "vt", L("tag")); rtSet(f, "vp", L("pay"));
    rtAddrOf(f, "va", "vt"); rtCall1(f, "", "__tx_retain", L("va"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("tag"), L("pay"));
    rtRetVoid(f); check(f);

    // __tx_store_list_append(idx, value*): append through the native descriptor. 借用中的 List<u8> 已由 listPush
    // 与内核快路径挡下（D3 v0.34 §6.8-16）；这里是不带位置的兜底。
    f = rtBegin(b, "__tx_store_list_append", "idx vp", "o v0 v1 v2 v3 t va r", 3, "bootstrap/selfhost/nrt_lists.tx");
    rtCall1(f, "o", "__tx_native_object_address_v1", L("idx"));
    rtCall1(f, "", "__tx_nrt_buffer_pin_check", L("o"));
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0");
    rtCall3(f, "r", "__tx_native_list_append_v1", L("va"), L("vp"), I(1));
    rtIf32(f, L("r"), "eq", I(0), "oom");
    rtCall1(f, "o", "__tx_native_object_address_v1", L("idx"));
    listApply(f, "o", "v0", "v1", "v2", "v3");
    rtRetVoid(f);
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1"); rtRetVoid(f); check(f);

    // listPush(list, v): retain v, append.
    f = rtBegin(b, "__tx_bi_list_push", "win fn pc a nargs", "l t v x o", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 2);
    argTag(f, 0, "l", "t", 15, "type");
    frozenGuard(f, "l", "t", "frozen");
    rtLoad(f, "x", L("l"), 8, 4);
    rtCall1(f, "o", "__tx_native_object_address_v1", L("x")); pinGuard(f, "o", "t", "pinned");
    rtCall3(f, "v", "__tx_nrt_arg", L("win"), L("a"), I(1));
    rtCall1(f, "", "__tx_retain", L("v"));
    rtCall2(f, "", "__tx_store_list_append", L("x"), L("v"));
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listPush 第一实参不是 List");
    rtLabel(f, "pinned"); trapText(b, f, 4024, "listPush 改变了外部调用借用中的 List<u8> 的长度");
    rtRetVoid(f); rtLabel(f, "frozen"); trapText(b, f, 4022, "listPush 写入了冻结的 List（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);

    // listLen(list): int.
    f = rtBegin(b, "__tx_bi_list_len", "win fn pc a nargs", "l t o n", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 1);
    argTag(f, 0, "l", "t", 15, "type");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(1), L("n"));
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listLen 的实参不是 List");
    rtRetVoid(f); check(f);

    // listGet(list, i): T? — out of range → None; hit → shared read (retain).
    f = rtBegin(b, "__tx_bi_list_get", "win fn pc a nargs", "l t ix i o n v0 v1 v2 v3 va rt rp ra r", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 2);
    argTag(f, 0, "l", "t", 15, "type");
    argTag(f, 1, "ix", "t", 1, "itype");
    rtLoad(f, "i", L("ix"), 8, 8);
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtIf(f, L("i"), "lt", I(0), "none"); rtIf(f, L("i"), "ge", L("n"), "none");
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0"); rtAddrOf(f, "ra", "rt");
    rtCall3(f, "r", "__tx_native_list_get_v2", L("va"), L("i"), L("ra"));
    rtIf32(f, L("r"), "eq", I(0), "broken");
    rtCall4(f, "", "__tx_nrt_set_retain", L("win"), L("a"), L("rt"), L("rp"));
    rtRetVoid(f);
    rtLabel(f, "none"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(4), I(0)); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listGet 第一实参不是 List");
    rtLabel(f, "itype"); trapText(b, f, 4010, "listGet 索引不是 int");
    rtLabel(f, "broken"); fatal(b, f, "taixu NRT: List 原生读取失败\n", 70);
    rtRetVoid(f); check(f);

    // listPop(list): T? — empty → None; else ownership moves to the result slot.
    f = rtBegin(b, "__tx_bi_list_pop", "win fn pc a nargs", "l t o n v0 v1 v2 v3 va rt rp ra r", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 1);
    argTag(f, 0, "l", "t", 15, "type");
    frozenGuard(f, "l", "t", "frozen");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtIf(f, L("n"), "eq", I(0), "none");
    pinGuard(f, "o", "t", "pinned");
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0"); rtAddrOf(f, "ra", "rt"); rtOp(f, "n", L("n"), "sub", I(1));
    rtCall3(f, "r", "__tx_native_list_remove_v2", L("va"), L("n"), L("ra"));
    rtIf32(f, L("r"), "eq", I(0), "broken");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    listApply(f, "o", "v0", "v1", "v2", "v3");
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), L("rt"), L("rp"));
    rtRetVoid(f);
    rtLabel(f, "none"); rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(4), I(0)); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listPop 的实参不是 List");
    rtLabel(f, "pinned"); trapText(b, f, 4024, "listPop 改变了外部调用借用中的 List<u8> 的长度");
    rtLabel(f, "broken"); fatal(b, f, "taixu NRT: List 原生移除失败\n", 70);
    rtRetVoid(f); rtLabel(f, "frozen"); trapText(b, f, 4022, "listPop 写入了冻结的 List（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);

    // listRemoveAt(list, i): void — out of range traps; removed heap value released.
    f = rtBegin(b, "__tx_bi_list_remove_at", "win fn pc a nargs", "l t ix i o n v0 v1 v2 v3 va rt rp ra r", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 2);
    argTag(f, 0, "l", "t", 15, "type");
    frozenGuard(f, "l", "t", "frozen");
    argTag(f, 1, "ix", "t", 1, "itype");
    rtLoad(f, "i", L("ix"), 8, 8);
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtIf(f, L("i"), "lt", I(0), "bounds"); rtIf(f, L("i"), "ge", L("n"), "bounds");
    pinGuard(f, "o", "t", "pinned");
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0"); rtAddrOf(f, "ra", "rt");
    rtCall3(f, "r", "__tx_native_list_remove_v2", L("va"), L("i"), L("ra"));
    rtIf32(f, L("r"), "eq", I(0), "broken");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    listApply(f, "o", "v0", "v1", "v2", "v3");
    rtCall1(f, "", "__tx_release", L("ra"));
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listRemoveAt 第一实参不是 List");
    rtLabel(f, "itype"); trapText(b, f, 4010, "listRemoveAt 索引不是 int");
    rtLabel(f, "pinned"); trapText(b, f, 4024, "listRemoveAt 改变了外部调用借用中的 List<u8> 的长度");
    rtLabel(f, "bounds"); trapText(b, f, 4002, "List 索引越界");
    rtLabel(f, "broken"); fatal(b, f, "taixu NRT: List 原生移除失败\n", 70);
    rtRetVoid(f); rtLabel(f, "frozen"); trapText(b, f, 4022, "listRemoveAt 写入了冻结的 List（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);

    // listInsert(list, i, v): i == len appends; out of range traps; retain v.
    f = rtBegin(b, "__tx_bi_list_insert", "win fn pc a nargs", "l t ix i v o n v0 v1 v2 v3 va r", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 3);
    argTag(f, 0, "l", "t", 15, "type");
    frozenGuard(f, "l", "t", "frozen");
    argTag(f, 1, "ix", "t", 1, "itype");
    rtLoad(f, "i", L("ix"), 8, 8);
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtIf(f, L("i"), "lt", I(0), "bounds"); rtIf(f, L("i"), "gt", L("n"), "bounds");
    pinGuard(f, "o", "t", "pinned");
    rtCall3(f, "v", "__tx_nrt_arg", L("win"), L("a"), I(2));
    rtCall1(f, "", "__tx_retain", L("v"));
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0");
    rtCall4(f, "r", "__tx_native_list_insert_v2", L("va"), L("i"), L("v"), I(1));
    rtIf32(f, L("r"), "eq", I(0), "oom");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    listApply(f, "o", "v0", "v1", "v2", "v3");
    rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listInsert 第一实参不是 List");
    rtLabel(f, "itype"); trapText(b, f, 4010, "listInsert 索引不是 int");
    rtLabel(f, "pinned"); trapText(b, f, 4024, "listInsert 改变了外部调用借用中的 List<u8> 的长度");
    rtLabel(f, "bounds"); trapText(b, f, 4002, "List 插入位置越界");
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1");
    rtRetVoid(f); rtLabel(f, "frozen"); trapText(b, f, 4022, "listInsert 写入了冻结的 List（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);

    // listSet(list, i, v): raw same-type writes in place; otherwise the generic
    // slot gets retain-new / release-old.
    f = rtBegin(b, "__tx_bi_list_set", "win fn pc a nargs", "l t ix i v o n v0 v1 v2 v3 va r p ot op oa", 5, "bootstrap/selfhost/nrt_lists.tx");
    arity(b, f, 3);
    argTag(f, 0, "l", "t", 15, "type");
    frozenGuard(f, "l", "t", "frozen");
    argTag(f, 1, "ix", "t", 1, "itype");
    rtLoad(f, "i", L("ix"), 8, 8);
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o")); rtLoad(f, "n", L("o"), 40, 8);
    rtIf(f, L("i"), "lt", I(0), "bounds"); rtIf(f, L("i"), "ge", L("n"), "bounds");
    rtCall3(f, "v", "__tx_nrt_arg", L("win"), L("a"), I(2));
    listView(f, "o", "v0", "v1", "v2", "v3");
    rtAddrOf(f, "va", "v0");
    rtCall3(f, "r", "__tx_native_list_prepare_set_v2", L("va"), L("i"), L("v"));
    rtIf32(f, L("r"), "eq", I(0), "oom");
    rtLoad(f, "o", L("l"), 8, 4); rtCall1(f, "o", "__tx_native_object_address_v1", L("o"));
    listApply(f, "o", "v0", "v1", "v2", "v3");
    rtIf32(f, L("r"), "eq", I(2), "done");
    // Generic slot: retain new, snapshot old, write, release old.
    rtCall1(f, "", "__tx_retain", L("v"));
    rtLoad(f, "p", L("o"), 32, 8); rtShift(f, "t", L("i"), "shl", 4); rtOp(f, "p", L("p"), "add", L("t"));
    rtLoad(f, "ot", L("p"), 0, 8); rtLoad(f, "op", L("p"), 8, 8);
    rtLoad(f, "t", L("v"), 0, 8); rtStore(f, L("p"), 0, L("t"), 8); rtLoad(f, "t", L("v"), 8, 8); rtStore(f, L("p"), 8, L("t"), 8);
    rtAddrOf(f, "oa", "ot"); rtCall1(f, "", "__tx_release", L("oa"));
    rtLabel(f, "done"); rtRetVoid(f);
    rtLabel(f, "arity"); trapText(b, f, 4010, ARITY);
    rtLabel(f, "type"); trapText(b, f, 4010, "listSet 第一实参不是 List");
    rtLabel(f, "itype"); trapText(b, f, 4010, "listSet 索引不是 int");
    rtLabel(f, "bounds"); trapText(b, f, 4002, "List 索引越界");
    rtLabel(f, "oom"); rtCall0(f, "", "__tx_native_object_oom_v1");
    rtRetVoid(f); rtLabel(f, "frozen"); trapText(b, f, 4022, "listSet 写入了冻结的 List（来自 Shared，深度不可变）");
    rtRetVoid(f); check(f);
}
