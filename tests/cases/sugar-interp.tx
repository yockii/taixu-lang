export function main(args: []string): int {
    const name: string = "太虚";
    const n: int = 42;
    const pi: float = 3.5;
    const ok: bool = true;
    print(`hello ${name}!`);
    print(`n=${n} pi=${pi} ok=${ok}`);
    print(`a\tb\`q\${lit}$end`);
    print(`${n + 1}${toStr(7)}`);
    const empty = ``;
    print(`empty=[${empty}]`);
    return 0;
}
