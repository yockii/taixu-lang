// ffi-mem 用例页分配的 Windows 实现：VirtualAlloc 提交一页、VirtualProtect 改保护、VirtualFree 释放（MEM_RELEASE）。
declare function VirtualAlloc(addr: usize, size: usize, kind: u32, protect: u32): usize from "kernel32";
declare function VirtualProtect(addr: usize, size: usize, protect: u32, old: Bytes): i32 from "kernel32";
declare function VirtualFree(addr: usize, size: usize, kind: u32): i32 from "kernel32";

const MEM_COMMIT_RESERVE: u32 = 12288;
const MEM_RELEASE: u32 = 32768;

export function pageAlloc(): int {
    return VirtualAlloc(0, 4096, MEM_COMMIT_RESERVE, 4) as int;
}

export function pageProtect(p: int, prot: int): bool {
    let protect: u32 = 4;
    if (prot == 0) { protect = 1; } else if (prot == 1) { protect = 2; }
    return VirtualProtect(p as usize, 4096, protect, bytesNew(4)) != 0;
}

export function pageFree(p: int): void {
    VirtualFree(p as usize, 0, MEM_RELEASE);
}

export function writableChecked(): bool {
    return true;
}
