// 函数块取舍（运行时按需链入，docs/design/v052-runtime-on-demand-link-v0.2-20261108.md 第二节）：生产者的函数目录把一个代码节
// 切成首尾相接的函数块，链接器把这个节换成这些块，再照常按节求可达，只放入可达的块（按原相对次序紧排，块间不补齐）。
// 块与函数一一对应，前提由生产者保证、内核生成器核查：函数之间的引用都带重定位，每个函数以无条件转移结束（不落入下一个函数）。
// 目录没登记的字节（空洞：尚未登记的手写例程）并进紧随其后的那一块，这样的块钉住（总是放入）——空洞里的代码可能落入下一个
// 函数，也可能被就地解析的引用指着，与下一个函数同进同出、保持相邻才安全。目录本身不合（重叠、乱序、空函数、越出节尾）时不切，
// 链接器整节照旧。
import { NativeFunction } from "./native_function_data";

// begins／ends 为各块在节里的范围（与目录逐项对应；空洞已并入），pinned[i] 为 1 表示块 i 含空洞字节、须总是放入。
export struct BlockPlan { ok: bool, reason: string, begins: List<int>, ends: List<int>, pinned: List<int>, size: int }

function rejected(reason: string): Ref<BlockPlan> {
    return new BlockPlan { ok: false, reason: reason, begins: listNew(), ends: listNew(), pinned: listNew(), size: 0 };
}

/// 按函数范围 [begins[i], ends[i]) 切一个 size 字节的节：范围须按次序、互不重叠、各自非空、不越出节尾。范围之前的空洞并入该块，
/// 最后一个范围之后的空洞并入最后一块，含空洞的块钉住。
export function blockPlan(size: int, begins: List<int>, ends: List<int>): Ref<BlockPlan> {
    if (size <= 0) { return rejected("EmptySection"); }
    if (listLen(begins) == 0) { return rejected("NoFunctions"); }
    if (listLen(begins) != listLen(ends)) { return rejected("BadFunctionDirectory"); }
    const plan = new BlockPlan { ok: true, reason: "", begins: listNew(), ends: listNew(), pinned: listNew(), size: size };
    let at = 0;
    let i = 0;
    while (i < listLen(begins)) {
        const begin = listGet(begins, i) catch -1;
        const end = listGet(ends, i) catch -1;
        if (begin < at) { return rejected("FunctionDirectoryOverlap"); }
        if (end <= begin) { return rejected("EmptyFunction"); }
        if (end > size) { return rejected("FunctionOutsideSection"); }
        listPush(plan.begins, at); listPush(plan.ends, end);
        if (begin > at) { listPush(plan.pinned, 1); } else { listPush(plan.pinned, 0); }
        at = end; i = i + 1;
    }
    if (at < size) {
        listSet(plan.ends, listLen(plan.ends) - 1, size);
        listSet(plan.pinned, listLen(plan.pinned) - 1, 1);
    }
    return plan;
}

/// 同上，范围取自生产者的函数目录（按目录次序）。
export function blockPlanOf(size: int, functions: List<Ref<NativeFunction>>): Ref<BlockPlan> {
    const begins: List<int> = listNew(); const ends: List<int> = listNew();
    for (f in functions) { listPush(begins, f.begin); listPush(ends, f.end); }
    return blockPlan(size, begins, ends);
}

export function blockCount(plan: Ref<BlockPlan>): int { return listLen(plan.begins); }
export function blockBegin(plan: Ref<BlockPlan>, block: int): int { return listGet(plan.begins, block) catch -1; }
export function blockEnd(plan: Ref<BlockPlan>, block: int): int { return listGet(plan.ends, block) catch -1; }
export function blockPinned(plan: Ref<BlockPlan>, block: int): bool { return (listGet(plan.pinned, block) catch 0) == 1; }

/// 偏移所在的块（begin ≤ offset < end）；恰在节尾的偏移（节尾处的标号）归最后一块；节外为 -1。
export function blockAt(plan: Ref<BlockPlan>, offset: int): int {
    const n = listLen(plan.begins);
    if (!plan.ok || n == 0 || offset < 0 || offset > plan.size) { return -1; }
    if (offset == plan.size) { return n - 1; }
    let lo = 0; let hi = n - 1;
    while (lo < hi) {
        const mid = (lo + hi + 1) / 2;
        if ((listGet(plan.begins, mid) catch 0) <= offset) { lo = mid; } else { hi = mid - 1; }
    }
    return lo;
}

/// 整个 [offset, offset + width) 所在的块；跨块或越出节为 -1（重定位的位置须落在单个块里）。
export function blockOfRange(plan: Ref<BlockPlan>, offset: int, width: int): int {
    if (width <= 0 || offset < 0 || offset >= plan.size || width > plan.size - offset) { return -1; }
    const block = blockAt(plan, offset);
    if (block < 0 || offset + width > (listGet(plan.ends, block) catch -1)) { return -1; }
    return block;
}
