// 线程第 4c 步：冻结的 List 上 listSet 即 trap 4022（下标写同理）。
struct Grid {
    cells: List< string>,
}

function main(args: []string): void {
    const cells: List< string> = listNew();
    listPush(cells, "x");
    const s = sharedNew(new Grid { cells: cells });
    const g = sharedGet(s);
    print(listGet(g.cells, 0) catch "?");
    listSet(g.cells, 0, "y");
    print("unreachable");
}
