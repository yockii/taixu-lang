// Unix x86-64 file boundary (Linux, and macOS since adaptation M2); all public arguments use the private kernel ABI.
// Paths remain byte paths; no Windows separator conversion. Linux issues raw syscalls; macOS calls libSystem through
// the syscall-shaped shims of unix_sys.tx (same registers, same −errno result), with its own flag and errno values.
import { Operand, StructuredBuffer, asBufferInstruction, asBufferSection, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
import { uxRawSys, uxOpenFlags, uxAtFdcwd, uxErrno } from "./unix_sys";

// 目标（linuxFileEmit 设定）。
let ft: int = 1;
function sys(b: Ref<StructuredBuffer>, nr: int): void { uxRawSys(b, ft, nr); }
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function t(n: string): Ref<Operand> { return asStructuredTarget(n); }
function m(base: int, off: int): Ref<Operand> { return asStructuredMem(2, base, -1, 0, off, 0, ""); }
function byte(base: int): Ref<Operand> { return asStructuredMem(0, base, -1, 0, 0, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, count: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, count, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function one(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>): void { op(b, name, 1, a, asStructuredMissing()); }
function zero(b: Ref<StructuredBuffer>, name: string): void { op(b, name, 0, asStructuredMissing(), asStructuredMissing()); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { one(b, cond, t(name)); }
function call(b: Ref<StructuredBuffer>, name: string): void { one(b, "call", t(name)); }

function status(b: Ref<StructuredBuffer>): void {
    lab(b, "__tx_linux_file_status");
    // Negative syscall errno -> frozen tx_Status.
    const codes: List<int> = listNew(); const values: List<int> = listNew();
    listPush(codes, -2); listPush(values, 3); listPush(codes, -20); listPush(values, 3);
    listPush(codes, -13); listPush(values, 4); listPush(codes, -1); listPush(values, 4);
    listPush(codes, -30); listPush(values, 4); listPush(codes, -12); listPush(values, 2);
    listPush(codes, -22); listPush(values, 1); listPush(codes, 0 - uxErrno(ft, "ENAMETOOLONG")); listPush(values, 1);
    listPush(codes, -21); listPush(values, 1); listPush(codes, -27); listPush(values, 6);
    let n = 0;
    while (n < listLen(codes)) {
        two(b, "cmp", r(0), i(listGet(codes, n) catch 0)); jump(b, "je", "__tx_lfs_" + toStr(n)); n = n + 1;
    }
    mov(b, r(0), i(5)); zero(b, "ret"); n = 0;
    while (n < listLen(codes)) { lab(b, "__tx_lfs_" + toStr(n)); mov(b, r(0), i(listGet(values, n) catch 5)); zero(b, "ret"); n = n + 1; }
}

function file(b: Ref<StructuredBuffer>, reading: int): void {
    let tag = "__tx_lfw"; let entry = "__tx_native_file_write";
    if (reading == 1) { tag = "__tx_lfr"; entry = "__tx_native_file_read"; }
    // reading == 2: writeExecutable — unlink the old file, then create 0777 & ~umask (as ld).
    if (reading == 2) { tag = "__tx_lfx"; entry = "__tx_native_file_write_exec"; }
    lab(b, entry);
    // Three nonvolatile pushes plus 128 bytes: calls are aligned, shadow [0,32).
    one(b, "push", r(3)); one(b, "push", r(7)); one(b, "push", r(6)); two(b, "sub", r(4), i(128));
    mov(b, m(4, 32), r(1)); mov(b, m(4, 40), r(2)); mov(b, m(4, 48), r(8)); mov(b, m(4, 56), r(9));
    mov(b, m(4, 64), i(-1)); mov(b, m(4, 72), i(0)); mov(b, m(4, 80), i(0));
    mov(b, m(4, 96), i(1)); mov(b, m(4, 104), i(0));
    two(b, "test", r(1), r(1)); jump(b, "jz", tag + "_clean");
    two(b, "cmp", r(2), i(0)); jump(b, "jle", tag + "_clean");
    two(b, "cmp", r(2), i(4095)); jump(b, "ja", tag + "_clean");
    if (reading == 1) {
        two(b, "test", r(8), r(8)); jump(b, "jz", tag + "_clean");
        two(b, "test", r(9), r(9)); jump(b, "jz", tag + "_clean");
    } else {
        two(b, "cmp", r(9), i(0)); jump(b, "jl", tag + "_clean");
        two(b, "test", r(9), r(9)); jump(b, "jz", tag + "_path");
        two(b, "test", r(8), r(8)); jump(b, "jz", tag + "_clean");
    }
    lab(b, tag + "_path");
    mov(b, r(10), m(4, 32)); mov(b, r(11), m(4, 40));
    lab(b, tag + "_scan");
    two(b, "cmp", byte(10), i(0)); jump(b, "je", tag + "_clean");
    two(b, "add", r(10), i(1)); two(b, "sub", r(11), i(1)); jump(b, "jne", tag + "_scan");
    mov(b, r(1), m(4, 40)); two(b, "add", r(1), i(1)); mov(b, r(2), i(1));
    call(b, "__tx_native_mem_alloc"); two(b, "test", r(0), r(0)); jump(b, "jz", tag + "_oom");
    mov(b, m(4, 104), r(0)); mov(b, r(1), r(0)); mov(b, r(2), m(4, 32)); mov(b, r(8), m(4, 40));
    call(b, "__tx_linux_memcpy"); mov(b, r(10), m(4, 104)); two(b, "add", r(10), m(4, 40)); two(b, "xor", r(0), r(0)); mov(b, byte(10), asStructuredReg(2, 0));
    if (reading == 2) {
        mov(b, r(0), i(263)); mov(b, r(7), i(uxAtFdcwd(ft))); mov(b, r(6), m(4, 104)); two(b, "xor", r(2), r(2)); sys(b, 263);
    }
    lab(b, tag + "_open");
    mov(b, r(0), i(257)); mov(b, r(7), i(uxAtFdcwd(ft))); mov(b, r(6), m(4, 104));
    if (reading == 1) { mov(b, r(2), i(uxOpenFlags(ft, 524288))); }
    else { mov(b, r(2), i(uxOpenFlags(ft, 524865))); }
    if (reading == 2) { mov(b, r(10), i(511)); } else { mov(b, r(10), i(438)); }
    sys(b, 257);
    two(b, "cmp", r(0), i(-4)); jump(b, "je", tag + "_open");
    two(b, "cmp", r(0), i(0)); jump(b, "jl", tag + "_errno");
    mov(b, m(4, 64), r(0)); mov(b, m(4, 96), i(0));
    if (reading == 1) {
        mov(b, m(4, 112), i(4096)); mov(b, r(1), i(4096)); mov(b, r(2), i(1));
        call(b, "__tx_native_mem_alloc"); two(b, "test", r(0), r(0)); jump(b, "jz", tag + "_oom");
        mov(b, m(4, 72), r(0));
    }
    lab(b, tag + "_io");
    if (reading == 1) {
        mov(b, r(0), m(4, 80)); two(b, "cmp", r(0), m(4, 112)); jump(b, "je", tag + "_grow");
        mov(b, r(6), m(4, 72)); two(b, "add", r(6), r(0));
        mov(b, r(2), m(4, 112)); two(b, "sub", r(2), r(0)); mov(b, r(0), i(0));
    } else {
        mov(b, r(0), m(4, 80)); two(b, "cmp", r(0), m(4, 56)); jump(b, "je", tag + "_clean");
        mov(b, r(6), m(4, 48)); two(b, "add", r(6), r(0));
        mov(b, r(2), m(4, 56)); two(b, "sub", r(2), r(0)); mov(b, r(0), i(1));
    }
    mov(b, r(7), m(4, 64));
    if (reading == 1) { sys(b, 0); } else { sys(b, 1); }
    two(b, "cmp", r(0), i(-4)); jump(b, "je", tag + "_io");
    two(b, "cmp", r(0), i(0)); jump(b, "jl", tag + "_errno");
    if (reading == 1) { jump(b, "je", tag + "_success"); }
    else { jump(b, "je", tag + "_ioerr"); }
    mov(b, r(10), m(4, 80)); two(b, "add", r(10), r(0)); mov(b, m(4, 80), r(10)); jump(b, "jmp", tag + "_io");
    if (reading == 1) {
        // 缓冲按倍增扩张，不设尺寸上限（容量批 C4b；原先 64 MiB 处报 etoobig），分配失败即 enomem。
        lab(b, tag + "_grow");
        mov(b, r(1), m(4, 72)); mov(b, r(2), m(4, 112)); mov(b, r(8), r(2)); two(b, "shl", r(8), i(1)); mov(b, r(9), i(1));
        call(b, "__tx_native_mem_realloc"); two(b, "test", r(0), r(0)); jump(b, "jz", tag + "_oom");
        mov(b, m(4, 72), r(0)); mov(b, r(10), m(4, 112)); two(b, "shl", r(10), i(1)); mov(b, m(4, 112), r(10)); jump(b, "jmp", tag + "_io");
        lab(b, tag + "_success");
        // Empty payloads have no allocation; successful nonempty buffers transfer.
        two(b, "cmp", m(4, 80), i(0)); jump(b, "jne", tag + "_transfer");
        mov(b, r(1), m(4, 72)); call(b, "__tx_native_mem_free"); mov(b, m(4, 72), i(0));
        lab(b, tag + "_transfer");
        // Delay transfer until close succeeds, so errors keep out pointers untouched.
    }
    jump(b, "jmp", tag + "_clean");
    lab(b, tag + "_errno"); call(b, "__tx_linux_file_status"); mov(b, m(4, 96), r(0)); jump(b, "jmp", tag + "_clean");
    lab(b, tag + "_oom"); mov(b, m(4, 96), i(2)); jump(b, "jmp", tag + "_clean");
    lab(b, tag + "_ioerr"); mov(b, m(4, 96), i(5));
    lab(b, tag + "_clean");
    two(b, "cmp", m(4, 64), i(0)); jump(b, "jl", tag + "_closed");
    mov(b, r(0), i(3)); mov(b, r(7), m(4, 64)); sys(b, 3);
    // Linux close consumes the descriptor even on EINTR; do not close it twice.
    two(b, "cmp", m(4, 96), i(0)); jump(b, "jne", tag + "_closed");
    two(b, "cmp", r(0), i(0)); jump(b, "jge", tag + "_closed");
    call(b, "__tx_linux_file_status"); mov(b, m(4, 96), r(0));
    lab(b, tag + "_closed");
    if (reading == 1) {
        two(b, "cmp", m(4, 96), i(0)); jump(b, "jne", tag + "_free");
        mov(b, r(10), m(4, 48)); mov(b, r(0), m(4, 72)); mov(b, m(10, 0), r(0));
        mov(b, r(10), m(4, 56)); mov(b, r(0), m(4, 80)); mov(b, m(10, 0), r(0));
        mov(b, m(4, 72), i(0));
    }
    lab(b, tag + "_free");
    mov(b, r(1), m(4, 72)); call(b, "__tx_native_mem_free");
    mov(b, r(1), m(4, 104)); call(b, "__tx_native_mem_free");
    mov(b, r(0), m(4, 96)); two(b, "add", r(4), i(128));
    one(b, "pop", r(6)); one(b, "pop", r(7)); one(b, "pop", r(3)); zero(b, "ret");
}

export function linuxFileEmit(b: Ref<StructuredBuffer>, t: int): void {
    ft = t;
    asBufferSection(b, 0, 1); status(b); file(b, 1); file(b, 0); file(b, 2);
}
