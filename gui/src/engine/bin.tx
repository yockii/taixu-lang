// ============================================================================
// engine/bin —— 大端读取（字体解析用）与按字节切字符串。越界一律读作 0：字体文件是不可信输入，解析方再按
// 长度与计数核对，不因越界 trap。
// ============================================================================

export function u8(b: Bytes, o: int): int {
    return bytesGet(b, o) catch 0;
}

export function u16(b: Bytes, o: int): int {
    const v: int = bytesGetBE<u16>(b, o) catch 0;
    return v;
}

export function i16(b: Bytes, o: int): int {
    const v: int = bytesGetBE<i16>(b, o) catch 0;
    return v;
}

export function u24(b: Bytes, o: int): int {
    return u8(b, o) * 65536 + u16(b, o + 1);
}

export function u32(b: Bytes, o: int): int {
    const v: int = bytesGetBE<u32>(b, o) catch 0;
    return v;
}

export function i32(b: Bytes, o: int): int {
    const v: int = bytesGetBE<i32>(b, o) catch 0;
    return v;
}

/// 按 n 字节（1..4）读无符号大端整数。
export function uN(b: Bytes, o: int, n: int): int {
    if (n == 1) {
        return u8(b, o);
    }
    if (n == 2) {
        return u16(b, o);
    }
    if (n == 3) {
        return u24(b, o);
    }
    return u32(b, o);
}

/// 四字符标签的数值（如 tag("cmap")）。
export function tag(s: string): int {
    return (byteTryAt(s, 0) catch 0) * 16777216 + (byteTryAt(s, 1) catch 0) * 65536 + (byteTryAt(s, 2) catch 0) * 256 + (byteTryAt(s, 3) catch 0);
}

/// 字符串按字节偏移取 [a, b)（与 len、strFind 同一单位）。偏移须落在 UTF-8 字符边界上，越界或切在字符中间得空串
///（内建 strSlice 在这两种情形 trap）。
export function byteSlice(s: string, a: int, b: int): string {
    if (a < 0 || b < a || b > len(s)) {
        return "";
    }
    return bytesToStr(bytesSlice(bytesFromStr(s), a, b - a)) catch "";
}
