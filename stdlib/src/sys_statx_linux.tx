// Linux 上经 statx 取文件信息：struct statx 各架构布局相同，这份代码与架构无关。龙芯只用它
// （sys_arch_linux_loongarch64.tx：5.19～6.10 的内核没有 fstat／newfstatat，同 glibc、musl、Go）；x86_64、aarch64 上
// tests/stat-diff-linux.tx 拿它与 newfstatat 逐项对照，龙芯走的这条路径每次 verify 都在真机上跑到。
// 带 AT_NO_AUTOMOUNT：与 stat／newfstatat 一样不触发自动挂载（同 glibc）。按 fd 取用空串＋AT_EMPTY_PATH（空指针要 6.11）。
declare function lxStatx(dir: int, path: string, flags: int, mask: int, buf: Bytes): int from syscall "statx";

const AT_FDCWD: int = -100;
const AT_EMPTY_PATH: int = 4096;
const AT_NO_AUTOMOUNT: int = 2048;
const STATX_BASIC_STATS: int = 2047;
// struct statx 256 字节：stx_mode 为偏移 28 的 u16，stx_size 为偏移 40 的 u64，stx_mtime 在 112（tv_sec i64、tv_nsec u32）。
export const STATX_BUF: int = 256;

// statxPath、statxFd 返回 0 或 -errno；buf 至少 STATX_BUF 字节。路径跟随符号链接。
export function statxPath(path: string, buf: Bytes): int {
    return lxStatx(AT_FDCWD, path, AT_NO_AUTOMOUNT, STATX_BASIC_STATS, buf);
}

export function statxFd(fd: int, buf: Bytes): int {
    return lxStatx(fd, "", AT_EMPTY_PATH | AT_NO_AUTOMOUNT, STATX_BASIC_STATS, buf);
}

export function stxMode(buf: Bytes): int {
    return (bytesGetLE<u16>(buf, 28) ?? 0) as int;
}

export function stxSize(buf: Bytes): int {
    return bytesGetLE<int>(buf, 40) ?? -1;
}

export function stxMtimeSec(buf: Bytes): int {
    return bytesGetLE<int>(buf, 112) ?? 0;
}

export function stxMtimeNsec(buf: Bytes): int {
    return (bytesGetLE<u32>(buf, 120) ?? 0) as int;
}
