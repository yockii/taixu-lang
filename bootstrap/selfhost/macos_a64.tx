// aarch64-macos 的原语（目标分层 X3b）：线程局部取址。进程入口是 LC_MAIN
// 指向的 main（dyld 按 C 约定调用，由共用的入口例程发出，不需要手写的 _start），系统接口例程是两种架构共用的 libSystem 蹦床
// （unix_sys.tx 的 macSysEmit），线程入口是 A64 的 AAPCS 外壳（thread_entry.tx）。
// - 线程局部：Mach-O 的 TLV——__tx_tls_tlv 是描述符，首字是 dyld 的取址函数，以 x0＝描述符按 C 约定
//   调用，x0＝本线程槽的地址。两个例程都经 rtfn 发出，调用方都是 rtfn 与生成代码，按私有约定看待这次调用即可。
import { StructuredBuffer } from "./assemble";
import { RtFn, RtOp, L, A } from "./rtfn_base";
import { rtBegin, rtSet, rtLoad, rtStore, rtCallC, rtRet, rtRetVoid } from "./rtfn";
import { check } from "./nrt_base";

const MODULE: string = "bootstrap/selfhost/macos_a64.tx";

/// __tx_tls_tb_get() → 本线程的线程块（外来线程为 0）；__tx_tls_tb_set(tb)。
export function macosA64TlsLeaves(b: Ref<StructuredBuffer>): void {
    let f = rtBegin(b, "__tx_tls_tb_get", "", "p fp", 1, MODULE);
    tlvSlot(f);
    rtLoad(f, "p", L("p"), 0, 8);
    rtRet(f, L("p")); check(f);
    f = rtBegin(b, "__tx_tls_tb_set", "tb", "p fp", 1, MODULE);
    tlvSlot(f);
    rtStore(f, L("p"), 0, L("tb"), 8);
    rtRetVoid(f); check(f);
}

// p ＝ 本线程 TLV 槽的地址：x0＝描述符，调描述符首字。
function tlvSlot(f: Ref<RtFn>): void {
    rtSet(f, "p", A("__tx_tls_tlv"));
    rtLoad(f, "fp", L("p"), 0, 8);
    const xs: List<Ref<RtOp>> = listNew(); listPush(xs, L("p"));
    const cls: List<int> = listNew(); listPush(cls, 0);
    rtCallC(f, "p", "", "fp", xs, cls, true);
}
