// 线程第 4c 步：经函数值带入 Weak 的对象图在 sharedNew 时核对（线程设计 §二十一-5）：外层 List<() => bool> 静态
// 可共享，闭包捕获了 Weak，它的环境类型在可发送表里标为 0，sharedNew 即 trap 4021。
struct Node {
    v: int,
}

function main(args: []string): void {
    const n: Ref< Node> = new Node { v: 1 };
    const w: Weak< Node> = weak(n);
    const fs: List< () => bool> = listNew();
    listPush(fs, (): bool => w == w);
    const s = sharedNew(fs);
    print(toStr(listLen(sharedGet(s))));
}
