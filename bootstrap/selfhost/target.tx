// 编译目标描述：目标编号加按维度的谓词，代替一路传下去的
// `linux` 布尔量。判断点按自己真正关心的维度取谓词——文件格式、与 C 交界的调用约定、系统接口、操作系统语义；
// 新增目标只改这里的表。程序代码在 x86-64 目标上一律用私有约定（emit_record 的 target win64），所以这里的调用约定
// 只管 FFI 桩、回调外壳、线程入口、libc 钩子与导出的 memcpy 这些与 C 交界的地方。
export const T_X64_WINDOWS: int = 0;
export const T_X64_LINUX: int = 1;
// macOS（适配 M0b，M1）：
// x86_64 自 M1 起是产物目标（构建、反汇编、画像、内核生成器、
// Mach-O 链接）；aarch64 仍只用于分析（dev-check），产物在 M4 实施。
export const T_X64_MACOS: int = 2;
export const T_ARM64_MACOS: int = 3;
// Linux 的 aarch64、loongarch64、riscv64（A0、A1）：aarch64-linux 自 A2
// 起是产物目标（A64 指令层与 aarch64-macos 共用，ELF、裸系统调用与 x86_64-linux 共用）；loongarch64-linux 自 A4e 起是产物目标
// （龙芯指令层，B16）；riscv64-linux 自 A5e 起是产物目标（RISC-V 指令层，B17）。
export const T_ARM64_LINUX: int = 4;
export const T_LA64_LINUX: int = 5;
export const T_RV64_LINUX: int = 6;
// aarch64-windows：A64 指令层与另两个 A64 目标共用，PE 与 kernel32 与 x86_64-windows 共用（PE 经 ELF 对象由
// link_pe_objects.tx 链接）；A6b 起只用于分析，A6c 起是产物目标。
export const T_ARM64_WINDOWS: int = 7;

/// 系统名：hostTarget() 的返回值，也是按目标选择源文件（x_<os>.tx）用的名字；不认识的编号得空串。
export function targetOs(t: int): string {
    if (t == T_X64_WINDOWS || t == T_ARM64_WINDOWS) { return "windows"; }
    if (t == T_X64_LINUX || t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX) { return "linux"; }
    if (t == T_X64_MACOS || t == T_ARM64_MACOS) { return "macos"; }
    return "";
}
/// 架构名（ISA 名，同 Zig、Rust、LLVM；hostArch() 的返回值，也是 x_<os>_<arch>.tx 的后缀）；不认识的编号得空串。
export function targetArch(t: int): string {
    if (t == T_ARM64_MACOS || t == T_ARM64_LINUX || t == T_ARM64_WINDOWS) { return "aarch64"; }
    if (t == T_LA64_LINUX) { return "loongarch64"; }
    if (t == T_RV64_LINUX) { return "riscv64"; }
    if (t == T_X64_WINDOWS || t == T_X64_LINUX || t == T_X64_MACOS) { return "x86_64"; }
    return "";
}
/// 规范名（三元组，同内核生成器、链接映射、编译画像的写法）；不认识的编号得空串。
export function targetName(t: int): string {
    const os = targetOs(t);
    if (len(os) == 0) { return ""; }
    return targetArch(t) + "-" + os;
}
/// 已知的系统名与架构名：按目标选文件的后缀全集（导出面一致性比对的兄弟名单由它们生成）。
export function targetOsNames(): List<string> { return strSplit("windows linux macos", " "); }
export function targetArchNames(): List<string> { return strSplit("x86_64 aarch64 loongarch64 riscv64", " "); }
/// 按目标选文件的后缀链：x_<os>_<arch>、x_<os>，类 Unix 目标再试 x_unix；都没有才用 x.tx。
export function targetFileSuffixes(t: int): List<string> {
    const out: List<string> = listNew();
    const os = targetOs(t);
    if (len(os) == 0) { return out; }
    listPush(out, os + "_" + targetArch(t));
    listPush(out, os);
    if (tUnix(t)) { listPush(out, "unix"); }
    return out;
}
/// 同组兄弟文件的全部后缀（导出面一致性比对）：每个系统、unix、每个“系统_架构”。
export function targetFileSuffixesAll(): List<string> {
    const out: List<string> = listNew();
    const oses = targetOsNames();
    const arches = targetArchNames();
    for (os in oses) { listPush(out, os); }
    listPush(out, "unix");
    for (os in oses) { for (arch in arches) { listPush(out, os + "_" + arch); } }
    return out;
}
/// `--target=` 的写法（系统名或三元组）→ 目标编号；不认识得 -1。
export function targetParse(s: string): int {
    if (s == "windows" || s == "x86_64-windows") { return T_X64_WINDOWS; }
    if (s == "linux" || s == "x86_64-linux") { return T_X64_LINUX; }
    // 不带架构的 macos 在这里取 x86_64；命令行的 --target 经 targetFlag 先按宿主架构试（M4）。
    if (s == "macos" || s == "x86_64-macos") { return T_X64_MACOS; }
    return -1;
}
/// 只认规范名（三元组）→ 目标编号；不认识得 -1。内核生成器与探针的 `--target` 只收三元组。
export function targetParseName(s: string): int {
    const t = targetParse(s);
    if (t >= 0 && targetName(t) == s) { return t; }
    return -1;
}
/// 全部目标写法：targetParse 之外另认 aarch64-macos（M4 起是产物目标，但只由明确支持它的命令收：build、dev-check、
/// 内核生成器）与只用于分析的 Linux 新架构。`arm64` 是 aarch64 的别名，只在这里认，不进文件名。
export function targetParseAnalysis(s: string): int {
    const t = targetParse(s);
    if (t >= 0) { return t; }
    if (s == "aarch64-macos" || s == "arm64-macos") { return T_ARM64_MACOS; }
    if (s == "aarch64-linux" || s == "arm64-linux") { return T_ARM64_LINUX; }
    // loong64 是 loongarch64 的别名（Go、Debian 的写法，B16），只在这里认，不进文件名。
    if (s == "loongarch64-linux" || s == "loong64-linux") { return T_LA64_LINUX; }
    if (s == "riscv64-linux") { return T_RV64_LINUX; }
    if (s == "aarch64-windows" || s == "arm64-windows") { return T_ARM64_WINDOWS; }
    return -1;
}
/// 只用于分析的目标（产物命令拒绝，退出码 64）：riscv64-linux 自出产物；aarch64-windows 自 A6b 起经这一档接入、A6c 起出
/// 产物，现在没有。它不并入
/// 系统、格式等维度的谓词（A6a 起 tLinux／tUnix 不再含它）：新目标在各维度谓词里显式列出，免得只用于分析的 Windows 目标被当成 Linux。
export function tAnalysisOnly(t: int): bool { return false; }
function flagValue(arg: string): string {
    if (strIndexOf(arg, "--target=") != 0) { return ""; }
    const parts = strSplit(arg, "=");
    if (listLen(parts) != 2) { return ""; }
    return listGet(parts, 1) catch "";
}
/// 命令行选项 `--target=<写法>` → 目标编号；不是这个选项或写法不认识得 -1（调用方照旧按未知选项处理）。不带架构的
/// 系统名先按宿主架构 `arch` 试（同 Go 的 GOARCH 缺省取宿主），该系统没有这个架构的目标再取 x86_64（M4）；只用于
/// 分析的目标不由不带架构的写法选中（aarch64 宿主上的 `linux` 仍是 x86_64-linux，直到 aarch64-linux 能出产物）。
/// 认得出 aarch64-macos；不支持 A64 的命令自行拒绝。
export function targetFlag(arg: string, arch: string): int {
    const v = flagValue(arg);
    if (len(v) > 0 && strIndexOf(v, "-") < 0) {
        const t = targetParseAnalysis(arch + "-" + v);
        if (t >= 0 && !tAnalysisOnly(t)) { return t; }
    }
    return targetParseAnalysis(v);
}

// 指令集：x86_64 与 A64（Linux）。
export function tA64(t: int): bool { return t == T_ARM64_MACOS || t == T_ARM64_LINUX || t == T_ARM64_WINDOWS; }
// 指令集枚举：缓冲、宏层、rtfn、渲染器与汇编映像按它分派，取代原先的布尔量 a64。分派处只认自己
// 实现了的指令集；守卫处（x86 指令进不了别的映像等）写成“不是 x86_64”，未实现的指令集在那里失败，不会被当成 x86。
export const ISA_X86_64: int = 0;
export const ISA_A64: int = 1;
export const ISA_LA64: int = 2;
export const ISA_RV64: int = 3;
export function tIsa(t: int): int {
    if (tA64(t)) { return ISA_A64; }
    if (t == T_LA64_LINUX) { return ISA_LA64; }
    if (t == T_RV64_LINUX) { return ISA_RV64; }
    return ISA_X86_64;
}
// 文件格式：PE/COFF、ELF 与 Mach-O。
export function tPe(t: int): bool { return t == T_X64_WINDOWS || t == T_ARM64_WINDOWS; }
export function tElf(t: int): bool { return t == T_X64_LINUX || t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX; }
export function tMachO(t: int): bool { return t == T_X64_MACOS || t == T_ARM64_MACOS; }
// 与 C 交界的调用约定：Win64（rcx/rdx/r8/r9、影子空间、XMM6–15 非易失）与 SysV（x86_64 的 Linux、macOS）；
// A64 上是 AAPCS64（Apple、Linux 与 Windows 在栈上实参的排布与变参上不同，见 tA64Os）；tWin64 只指 x86_64 的约定。
export function tWin64(t: int): bool { return t == T_X64_WINDOWS; }
export function tSysV(t: int): bool { return t == T_X64_LINUX || t == T_X64_MACOS; }
// 系统接口：经 kernel32 等 DLL 导入、直接发系统调用，或经 libSystem 导入（macOS 不提供稳定的系统调用接口）。
export function tKernel32(t: int): bool { return t == T_X64_WINDOWS || t == T_ARM64_WINDOWS; }
export function tRawSyscall(t: int): bool { return t == T_X64_LINUX || t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX; }
/// A64 目标的系统（与 assemble.tx 的 A64_OS_* 同值）：1 Apple、2 Linux、3 Windows；非 A64 为 0。C 调用约定随它：Apple arm64 栈上
/// 实参按自然对齐紧排、变参一律上栈、x18 保留；Linux 的 aarch64 是标准 AAPCS64（栈上每个实参占 8 字节槽、变参与定参同规则）；
/// Windows 定参同标准 AAPCS64，变参不用浮点寄存器（浮点按位进整数寄存器、复合类型不按 HFA）、x18 指向 TEB（B18）。
/// 原子操作也随它：Apple 的 arm64 都有 LSE；Linux、Windows 上按启动时读到的 CPU 特性选 LSE 或 LL/SC（B18）。
export function tA64Os(t: int): int {
    if (t == T_ARM64_MACOS) { return 1; }
    if (t == T_ARM64_LINUX) { return 2; }
    if (t == T_ARM64_WINDOWS) { return 3; }
    return 0;
}
export function tLibSystem(t: int): bool { return t == T_X64_MACOS || t == T_ARM64_MACOS; }
// 操作系统语义（路径语法、errno 与 GetLastError、信号、控制台编码、进程模型）。
export function tWindows(t: int): bool { return t == T_X64_WINDOWS || t == T_ARM64_WINDOWS; }
/// 用内核通用号表（scripts/syscall.tbl）与通用结构布局（asm-generic 的 stat 等）的 Linux：aarch64、loongarch64、riscv64。
/// 通用表没有 open、poll、dup2 这类旧形态（rtfn 的 a64LinuxSyscall 改写）；x86_64 用自己的号表。
export function tGenericLinux(t: int): bool { return t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX; }
export function tLinux(t: int): bool { return t == T_X64_LINUX || t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX; }
export function tMacos(t: int): bool { return t == T_X64_MACOS || t == T_ARM64_MACOS; }
export function tUnix(t: int): bool { return t == T_X64_LINUX || t == T_X64_MACOS || t == T_ARM64_MACOS || t == T_ARM64_LINUX || t == T_LA64_LINUX || t == T_RV64_LINUX; }
