    if (b == 3597) { return "localEntryKind(string, string): int"; }
    if (b == 3598) { return "localFileSize(string, string): int | Error"; }
    if (b == 3600) { return "localListDir(string, string): List<string> | Error"; }
    return "imul(int, int)";
}

// wantArgs 镜像（实参过多时各臂报错——垫齐后恰等长不触发）。
function wantArgsEmit(s: Ref<Sm>, args: List<Ref<Expr>>, n: int, atLine: int, atCol: int, sigName: string): void {
    if (listLen(args) != n) {
        emitDiag(s, 3011, atLine, atCol, "内建 " + sigName + " 需要 " + toStr(n) + " 个实参，传入 " + toStr(listLen(args)));
    }
}

// D3 v0.21 工具链系统内建（50..56）：仅 --toolchain 构建可用（同 writeExecutable
// 先例）；公开的 std/os、std/proc 接口随第 5 轮平台层设计。
function sysArgIs(s: Ref<Sm>, args: List<Ref<Expr>>, i: int, want: Ref<Ty>, what: string): void {
    const a = listGet(args, i) catch s.dummyE;
    const t = checkExpr(s, a, want);
    let ok = t.tag == want.tag;
    if (ok && want.tag == 10) { ok = (t.inner catch s.dT).tag == 3; }
    if (!ok) { emitDiag(s, 3002, a.line, a.col, what + "需要 " + typeNameOf(s, want) + "（得到 " + typeNameOf(s, t) + "）"); }
}

function checkSysBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const sig = builtinWantSig(b);
    if (!smToolchain) { emitDiag(s, 3001, atLine, atCol, strSub(sig, 0, strIndexOf(sig, "(")) + " 仅限工具链构建（需 --toolchain）"); }
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, sig);
    if (b == 51) {
        sysArgIs(s, args, 0, s.tString, "getEnv 的实参（变量名）");
        return tOpt(s, s.tString);
    }
    if (b == 86) {
        sysArgIs(s, args, 0, s.tString, "setEnv 第一实参（变量名）");
        sysArgIs(s, args, 1, s.tString, "setEnv 第二实参（值）");
        return tErrunion(s, s.tVoid);
    }
    if (b == 52) {
        sysArgIs(s, args, 0, s.tString, "runProcess 第一实参（程序路径）");
        sysArgIs(s, args, 1, tList(s, s.tString), "runProcess 第二实参（参数）");
        sysArgIs(s, args, 2, s.tString, "runProcess 第三实参（stderr 重定向路径，空串表示继承）");
        return tErrunion(s, s.tInt);
    }
    if (b == 54) {
        sysArgIs(s, args, 0, s.tString, "removeFile 的实参（路径）");
        return tErrunion(s, s.tVoid);
    }
    if (b == 56) { return s.tInt; }
    return s.tString;
}

// D3 v0.18 Bytes 内建的实参与结果类型（36..47）。
function bytesArgIs(s: Ref<Sm>, args: List<Ref<Expr>>, i: int, tag: int, what: string): void {
    const a = listGet(args, i) catch s.dummyE;
    let want: Ref<Ty> = s.tInt;
    if (tag == 3) { want = s.tString; }
    if (tag == 17) { want = s.dT; }
    const t = checkExpr(s, a, want);
    if (t.tag != tag && !(tag == 0 && intArg(t))) {
        let tn = "int";
        if (tag == 3) { tn = "string"; }
        if (tag == 17) { tn = "Bytes"; }
        emitDiag(s, 3002, a.line, a.col, what + "需要 " + tn + "（得到 " + typeNameOf(s, t) + "）");
    }
}

// O4 第二步 2c2：bytesAsList(Bytes): List<u8> 与 listAsBytes(List<u8>): Bytes——同一个对象，句柄语义（设计 §五-4、§七-1）。
function checkBytesListBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, 1, atLine, atCol, builtinWantSig(b));
    const u8l = tList(s, tFw(s, 4));
    if (b == 77) {
        bytesArgIs(s, args, 0, 17, "bytesAsList 实参");
        return u8l;
    }
    const a = listGet(args, 0) catch s.dummyE;
    const t = checkExpr(s, a, u8l);
    if (!tyEq(s, t, u8l)) { emitDiag(s, 3002, a.line, a.col, "listAsBytes 实参需要 List<u8>（得到 " + typeNameOf(s, t) + "）"); }
    return tBytes(s);
}

// D3 v0.37 Bytes 批量操作（LANG-32）：bytesCopy／bytesFill 的位置与个数为 int；定宽读写须写出类型实参 T——i8…u64、int、f32、
// float（不收 isize／usize：宽度随目标而变，二进制格式须用显式宽度）；写入的值须正是 T（窄类型先 as），宽度即类型实参。
function checkBytesBulk(s: Ref<Sm>, e: Ref<Expr>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const sig = builtinWantSig(b);
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, sig);
    if (b == 80) {
        bytesArgIs(s, args, 0, 17, "bytesCopy 目标");
        bytesArgIs(s, args, 1, 0, "bytesCopy 目标位置");
        bytesArgIs(s, args, 2, 17, "bytesCopy 来源");
        bytesArgIs(s, args, 3, 0, "bytesCopy 来源位置");
        bytesArgIs(s, args, 4, 0, "bytesCopy 个数");
        return s.tVoid;
    }
    if (b == 81) {
        bytesArgIs(s, args, 0, 17, "bytesFill 第一实参");
        bytesArgIs(s, args, 1, 0, "bytesFill 位置");
        bytesArgIs(s, args, 2, 0, "bytesFill 个数");
        bytesArgIs(s, args, 3, 0, "bytesFill 字节值");
        return s.tVoid;
    }
    const name = strSub(sig, 0, strIndexOf(sig, "<"));
    bytesArgIs(s, args, 0, 17, name + " 第一实参");
    bytesArgIs(s, args, 1, 0, name + " 位置");
    let t = s.tInt;
    let ok = false;
    if (listLen(e.targs) != 1) {
        emitDiag(s, 3002, atLine, atCol, name + " 须写出一个类型实参：" + name + "<u32>(…)");
    } else {
        t = resolveType(s, listGet(e.targs, 0) catch s.dummyTe);
        const k = nkOf(t);
        ok = k != 0 && k != 8 && k != 9;
        if (!ok) {
            emitDiag(s, 3002, atLine, atCol, name + " 的类型实参须为 i8…u64、int、f32 或 float（得到 " + typeNameOf(s, t) + "；isize／usize 的宽度随目标而变）");
        }
    }
    if (b <= 83) { return tOpt(s, t); }
    const va = listGet(args, 2) catch s.dummyE;
    const vt = checkExpr(s, va, t);
    if (ok && !tyEq(s, vt, t)) {
        emitDiag(s, 3002, va.line, va.col, name + " 的值须为 " + typeNameOf(s, t) + "（得到 " + typeNameOf(s, vt) + "；先写 as " + typeNameOf(s, t) + "）");
    }
    return s.tVoid;
}

function checkBytesBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, builtinWantSig(b));
    if (b == 36) { bytesArgIs(s, args, 0, 0, "bytesNew 长度"); return tBytes(s); }
    if (b == 37) { bytesArgIs(s, args, 0, 17, "bytesLen 实参"); return s.tInt; }
    if (b == 38) { bytesArgIs(s, args, 0, 17, "bytesGet 第一实参"); bytesArgIs(s, args, 1, 0, "bytesGet 索引"); return tOpt(s, s.tInt); }
    if (b == 39) { bytesArgIs(s, args, 0, 17, "bytesSet 第一实参"); bytesArgIs(s, args, 1, 0, "bytesSet 索引"); bytesArgIs(s, args, 2, 0, "bytesSet 字节值"); return s.tVoid; }
    if (b == 40) { bytesArgIs(s, args, 0, 17, "bytesPush 第一实参"); bytesArgIs(s, args, 1, 0, "bytesPush 字节值"); return s.tVoid; }
    if (b == 41) { bytesArgIs(s, args, 0, 17, "bytesAppend 第一实参"); bytesArgIs(s, args, 1, 17, "bytesAppend 第二实参"); return s.tVoid; }
    if (b == 42) { bytesArgIs(s, args, 0, 17, "bytesSlice 第一实参"); bytesArgIs(s, args, 1, 0, "bytesSlice 起始"); bytesArgIs(s, args, 2, 0, "bytesSlice 计数"); return tBytes(s); }
    if (b == 43) { bytesArgIs(s, args, 0, 17, "bytesEqual 第一实参"); bytesArgIs(s, args, 1, 17, "bytesEqual 第二实参"); return s.tBool; }
    if (b == 44) { bytesArgIs(s, args, 0, 3, "bytesFromStr 实参"); return tBytes(s); }
    if (b == 45) { bytesArgIs(s, args, 0, 17, "bytesToStr 实参"); return tErrunion(s, s.tString); }
    if (b == 46) { bytesArgIs(s, args, 0, 3, "readFileBytes 路径"); return tErrunion(s, tBytes(s)); }
    // embedBytes：路径须为字符串字面量（编译期读取，codegen 解析相对路径）。
    const a = listGet(args, 0) catch s.dummyE;
    bytesArgIs(s, args, 0, 3, "embedBytes 路径");
    if (a.tag != 28) { emitDiag(s, 3002, a.line, a.col, "embedBytes 路径必须是字符串字面量（编译期读取）"); }
    return tBytes(s);
}

// 定宽数值（O4 第一步）：wrapTo<T>(x)——取 x 的低位按 T 的宽度与符号解释，不检查。
function checkWrapTo(s: Ref<Sm>, e: Ref<Expr>, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, 1, atLine, atCol, "wrapTo<整数类型>(整数)");
    const a0 = listGet(args, 0) catch s.dummyE;
    const t0 = checkExpr(s, a0, s.dT);
    if (listLen(e.targs) != 1) {
        emitDiag(s, 3034, atLine, atCol, "wrapTo 须显式写出一个类型实参：wrapTo<i32>(x)");
        return s.tInt;
    }
    const want = resolveType(s, listGet(e.targs, 0) catch s.dummyTe);
    if (!nkIsInt(nkOf(want))) {
        emitDiag(s, 3034, atLine, atCol, "wrapTo 的类型实参须为整数类型（得到 " + typeNameOf(s, want) + "）");
        return s.tInt;
    }
    if (!nkIsInt(nkOf(t0))) {
        emitDiag(s, 3034, a0.line, a0.col, "wrapTo 的实参须为整数（得到 " + typeNameOf(s, t0) + "）");
    }
    return want;
}

// 定宽数值（O4 第二步）：wrapAdd/wrapSub/wrapMul<T>(a, b)——按 T 的宽度环绕（二补码取低位），不检查溢出。
// 类型实参可省：由两个实参按公共类型推出（字面量取另一侧的类型），须为整数类型（含 int）。
function checkWrapArith(s: Ref<Sm>, e: Ref<Expr>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const sig = builtinWantSig(b);
    const name = strSub(sig, 0, strIndexOf(sig, "<"));
    wantArgsEmit(s, args, 2, atLine, atCol, sig);
    const a0 = listGet(args, 0) catch s.dummyE;
    const a1 = listGet(args, 1) catch s.dummyE;
    if (listLen(e.targs) > 1) {
        emitDiag(s, 3034, atLine, atCol, name + " 至多一个类型实参：" + name + "<u32>(a, b)");
        return s.tInt;
    }
    if (listLen(e.targs) == 1) {
        const want = resolveType(s, listGet(e.targs, 0) catch s.dummyTe);
        if (!nkIsInt(nkOf(want))) {
            emitDiag(s, 3034, atLine, atCol, name + " 的类型实参须为整数类型（得到 " + typeNameOf(s, want) + "）");
            return s.tInt;
        }
        const t0 = checkExpr(s, a0, want);
        if (!assignableE(s, a0, t0, want)) { emitDiag(s, 3034, a0.line, a0.col, name + " 的实参须为 " + typeNameOf(s, want) + "（得到 " + typeNameOf(s, t0) + "）"); }
        const t1 = checkExpr(s, a1, want);
        if (!assignableE(s, a1, t1, want)) { emitDiag(s, 3034, a1.line, a1.col, name + " 的实参须为 " + typeNameOf(s, want) + "（得到 " + typeNameOf(s, t1) + "）"); }
        return want;
    }
    const pr = checkOperands(s, a0, a1, false);
    if (!nkIsInt(nkOf(pr.l)) || !nkIsInt(nkOf(pr.r))) {
        emitDiag(s, 3034, atLine, atCol, name + " 的实参须为整数（得到 " + typeNameOf(s, pr.l) + " 与 " + typeNameOf(s, pr.r) + "）");
        return s.tInt;
    }
    const c = nkCommon(nkOf(pr.l), nkOf(pr.r));
    if (c == 0) {
        emitDiag(s, 3034, atLine, atCol, name + " 的两个实参没有能无损容纳两侧的公共类型（" + typeNameOf(s, pr.l) + " 与 " + typeNameOf(s, pr.r) + "），请写出类型实参或先用 as 转换");
        return pr.l;
    }
    return nkTy(s, c);
}

// D3 v0.23：floatToBits(x: float): int 取 IEEE 双精度的 64 位模式（有符号 int 承载，最高位为符号位）；
// floatFromBits(b: int): float 由位模式构造。运行期只换标签、载荷不变。
function checkFloatBits(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, 1, atLine, atCol, builtinWantSig(b));
    const a0 = listGet(args, 0) catch s.dummyE;
    let want = s.tFloat;
    let ret = s.tInt;
    if (b == 64) {
        want = s.tInt;
        ret = s.tFloat;
    }
    const t0 = checkExpr(s, a0, want);
    if (!assignableE(s, a0, t0, want)) {
        emitDiag(s, 3002, a0.line, a0.col, builtinWantSig(b) + " 的实参需要 " + typeNameOf(s, want) + "（得到 " + typeNameOf(s, t0) + "）");
    }
    return ret;
}

// __rt 内部内建（线程设计 §十六，2c）：只供标准库模块（驱动按模块路径是否在标准库根之下打标）。其余模块
// 调用报 3001，文案同未定义函数并注明原因；实参照常检查。
function checkRtBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const sig = builtinWantSig(b);
    const name = strSub(sig, 0, strIndexOf(sig, "("));
    if (!s.curMod.std) { emitDiag(s, 3001, atLine, atCol, "未定义函数 '" + name + "'（__rt 前缀的内部内建只供标准库模块使用）"); }
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, sig);
    if (b <= 2050) {
        sysArgIs(s, args, 0, s.tInt, name + " 的实参（句柄或系统值）");
        return s.tInt;
    }
    if (b == 2053) { return s.tInt; }
    if (b == 2054) {
        sysArgIs(s, args, 0, s.tInt, name + " 的实参（参数序号）");
        return tOpt(s, s.tString);
    }
    sysArgIs(s, args, 0, s.tString, name + " 第一实参（变量名）");
    if (b == 2051) { return tOpt(s, s.tString); }
    sysArgIs(s, args, 1, s.tString, name + " 第二实参（值）");
    return s.tInt;
}

// 工具链进程与标准输入内建（3584..3594；TOOL-103，调试实施设计 §四-6）：仅 --toolchain 构建可用（同 runProcess）。
// 读写都以调用方给的 Bytes 为缓冲、以返回码报字节数、超时与流尾；只有 procSpawn、currentDir 与 fileSize 得 Error。
function checkToolBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    const sig = builtinWantSig(b);
    const name = strSub(sig, 0, strIndexOf(sig, "("));
    if (!smToolchain) { emitDiag(s, 3001, atLine, atCol, name + " 仅限工具链构建（需 --toolchain）"); }
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, sig);
    if (b == 3584) {
        sysArgIs(s, args, 0, tBytes(s), name + " 第一实参（缓冲）");
        sysArgIs(s, args, 1, s.tInt, name + " 第二实参（毫秒）");
        return s.tInt;
    }
    if (b == 3585) {
        sysArgIs(s, args, 0, tBytes(s), name + " 的实参（数据）");
        return s.tInt;
    }
    if (b == 3586 || b == 3595) {
        if (b == 3595) {
            sysArgIs(s, args, 4, s.tInt, name + " 第五实参（内存字节数）");
            sysArgIs(s, args, 5, s.tInt, name + " 第六实参（CPU 秒数）");
        }
        sysArgIs(s, args, 0, s.tString, name + " 第一实参（程序路径）");
        sysArgIs(s, args, 1, tList(s, s.tString), name + " 第二实参（参数）");
        sysArgIs(s, args, 2, s.tString, name + " 第三实参（工作目录，空串表示继承）");
        sysArgIs(s, args, 3, s.tInt, name + " 第四实参（选项位）");
        return tErrunion(s, s.tInt);
    }
    if ((b >= 3596 && b <= 3598) || b == 3600) {
        sysArgIs(s, args, 0, s.tString, name + " 第一实参（本地根绝对路径）");
        sysArgIs(s, args, 1, s.tString, name + " 第二实参（根内相对路径）");
        if (b == 3596) { sysArgIs(s, args, 2, s.tInt, name + " 第三实参（内容字节上限）"); return tErrunion(s, tBytes(s)); }
        if (b == 3597) { return s.tInt; }
        if (b == 3600) { return tErrunion(s, tList(s, s.tString)); }
        return tErrunion(s, s.tInt);
    }
    if (b == 3593) { return tErrunion(s, s.tString); }
    if (b == 3594) {
        sysArgIs(s, args, 0, s.tString, name + " 的实参（路径）");
        return tErrunion(s, s.tInt);
    }
    if ((b >= 3587 && b <= 3589) || b == 3599) {
        sysArgIs(s, args, 0, s.tInt, name + " 第一实参（句柄）");
        sysArgIs(s, args, 1, s.tInt, name + " 第二实参（" + toolSecondArg(b) + "）");
        if (b == 3589) {
            sysArgIs(s, args, 2, s.tInt, name + " 第三实参（毫秒）");
        } else {
            sysArgIs(s, args, 2, tBytes(s), name + " 第三实参（" + toolThirdArg(b) + "）");
        }
        return s.tInt;
    }
    sysArgIs(s, args, 0, s.tInt, name + " 第一实参（句柄）");
    if (b == 3591) {
        sysArgIs(s, args, 1, s.tInt, name + " 第二实参（毫秒）");
        return tOpt(s, s.tInt);
    }
    return s.tVoid;
}

function toolSecondArg(b: int): string {
    if (b == 3589) { return "来源位"; }
    return "流号";
}

function toolThirdArg(b: int): string {
    if (b == 3587 || b == 3599) { return "数据"; }
    return "缓冲";
}

// 线程（线程设计 §十、§十八）：threadSpawn(f): Thread<T> 在新线程里运行 f，f 的捕获与 T 的结果经深拷贝跨线程
// （发送）。f 是任何无参、非 async 的函数值（顶层函数名、箭头函数字面量、变量、字段……），结果类型须可发送
// （sendWhy），否则报 3035 并指出成分与路径；f 是箭头函数字面量时逐个检查捕获。函数值、接口值擦除了捕获与具体
// 类型，静态算可发送，发送时按类型号表核对（运行期 4021，第 3b 步）。threadJoin(t: Thread<T>): T | Error 等线程
// 结束并取回结果；同一线程第二次 join 得到错误值。
function checkThreadBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, 1, atLine, atCol, builtinWantSig(b));
    const a0 = listGet(args, 0) catch s.dummyE;
    const t0 = checkExpr(s, a0, s.dT);
    if (b == 66) {
        if (t0.tag != 23) {
            emitDiag(s, 3002, a0.line, a0.col, "threadJoin 需要 Thread<T>（得到 " + typeNameOf(s, t0) + "）");
            return tErrunion(s, s.tInt);
        }
        // f 返回 T | Error 时线程的错误原样作为 threadJoin 的错误（线程设计 §四-1），合并成一层；失败侧是错误 enum
        // 时不合并（join 自己的错误——重复 join、创建失败——是普通 Error）。
        const jt = t0.inner catch s.tInt;
        if (jt.tag == 7 && jt.ei == None) { return jt; }
        return tErrunion(s, jt);
    }
    if (t0.tag != 15) {
        emitDiag(s, 3002, a0.line, a0.col, "threadSpawn 需要函数（得到 " + typeNameOf(s, t0) + "）");
        return tThread(s, s.tInt);
    }
    const sig = t0.sig catch s.dummySig;
    s.iv.sendUsed = true;
    let shape: bool = !sig.isAsync;
    if (a0.tag == 31) {
        const hit = lookupDepth(s, a0.s0);
        if (hit.hit && hit.sym.kind == 2) {
            const fe = listGet(s.fns, hit.sym.fnIdx) catch s.dummyFE;
            shape = shape && !fe.decl.isAsync && !fe.decl.isGen;
        }
    } else if (a0.tag == 49) {
        shape = shape && !(a0.af catch s.dArrow).isAsync;
    }
    if (!shape) {
        emitDiag(s, 3035, a0.line, a0.col, "threadSpawn 的函数不能是 async 函数或生成器");
        return tThread(s, sig.ret);
    }
    if (listLen(sig.params) != 0) {
        emitDiag(s, 3035, a0.line, a0.col, "threadSpawn 的函数不能有参数（得到 " + typeNameOf(s, t0) + "）");
    }
    if (a0.tag == 49) {
        // 箭头函数的捕获在启动时深拷贝进新线程：逐个检查捕获的静态类型。
        let ri: int = listLen(s.tClosureRes) - 1;
        while (ri >= 0) {
            const row = listGet(s.tClosureRes, ri) catch s.dummyRow;
            if (row.k == a0.id) {
                let ci: int = 0;
                while (ci < row.a3) {
                    const at = row.a2 + ci;
                    const cty = listGet(s.tys, listGet(s.crInts, at * 5) catch 0) catch s.dT;
                    const why = sendWhy(s, cty, "捕获的 " + (listGet(s.crNames, at) catch "?"), listNew());
                    if (why != "") {
                        emitDiag(s, 3035, a0.line, a0.col, "threadSpawn 的函数不可发送：" + why);
                    }
                    ci = ci + 1;
                }
                ri = -1;
            }
            ri = ri - 1;
        }
    }
    const rt = sig.ret;
    const rwhy = sendWhy(s, rt, "线程函数的结果", listNew());
    if (rwhy != "") {
        emitDiag(s, 3035, a0.line, a0.col, "threadSpawn 的结果不可发送：" + rwhy);
    }
    return tThread(s, rt);
}

// 线程第 4c 步（线程设计 §四-4、§四-5、§二十一）：sharedNew(v): Shared<T> 把 v 可达的对象图深拷贝进共享块并冻结，
// 实参须可共享（同可发送，另允许 Atomic<int>）；sharedGet(s): T 取出冻结的对象图（每线程物化一次）；Atomic<int>
// 的五个操作内存序均为 seqcst。
function checkSharedBuiltin(s: Ref<Sm>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, builtinWantSig(b));
    if (b == 67) {
        const a0 = listGet(args, 0) catch s.dummyE;
        const t0 = checkExpr(s, a0, s.dT);
        s.iv.sendUsed = true;
        if (t0.tag == 4) {
            emitDiag(s, 3002, a0.line, a0.col, "sharedNew 的实参不能是 void");
            return tShared(s, s.tInt);
        }
        s.iv.shareMode = true;
        const why = sendWhy(s, t0, "sharedNew 的实参", listNew());
        s.iv.shareMode = false;
        if (why != "") {
            emitDiag(s, 3035, a0.line, a0.col, "sharedNew 的实参不可共享：" + why);
        }
        return tShared(s, t0);
    }
    if (b == 68) {
        const a0 = listGet(args, 0) catch s.dummyE;
        const t0 = checkExpr(s, a0, s.dT);
        if (t0.tag != 24) {
            emitDiag(s, 3002, a0.line, a0.col, "sharedGet 需要 Shared<T>（得到 " + typeNameOf(s, t0) + "）");
            return s.tInt;
        }
        return t0.inner catch s.tInt;
    }
    if (b == 69) {
        sysArgIs(s, args, 0, s.tInt, "atomicNew 的实参");
        return tAtomic(s);
    }
    const at = tAtomic(s);
    if (b == 70) {
        sysArgIs(s, args, 0, at, "atomicLoad 的实参");
        return s.tInt;
    }
    if (b == 71) {
        sysArgIs(s, args, 0, at, "atomicStore 的第一实参");
        sysArgIs(s, args, 1, s.tInt, "atomicStore 的第二实参");
        return s.tVoid;
    }
    if (b == 72) {
        sysArgIs(s, args, 0, at, "atomicAdd 的第一实参");
        sysArgIs(s, args, 1, s.tInt, "atomicAdd 的第二实参");
        return s.tInt;
    }
    sysArgIs(s, args, 0, at, "atomicCas 的第一实参");
    sysArgIs(s, args, 1, s.tInt, "atomicCas 的第二实参（期望值）");
    sysArgIs(s, args, 2, s.tInt, "atomicCas 的第三实参（新值）");
    return s.tBool;
}

// 可发送判定（线程设计 §四-8、§十八）：值能否深拷贝到别的线程。可发送返回空串，否则返回不可发送的成分
// 与路径（如“捕获的 cache 的字段 owner 是 Weak<Node>”）。排除绑定在本线程上的东西：Weak、Future、Gen、
// Thread 句柄、平台句柄（declare type）；经 struct 字段、enum 变体字段、List／数组／切片元素、Ref、可选、
// 错误联合间接含有同样不可发送。不透明类型参数放过——泛型实例以具体类型重查。函数类型与接口类型擦除了
// 捕获与具体类型，静态算可发送，发送时按类型号表核对（SND1、运行期 4021）。seen 防递归类型重复展开。
function sendWhy(s: Ref<Sm>, t: Ref<Ty>, path: string, seen: List<int>): string {
    const tag = t.tag;
    if (tag <= 5 || tag == 17 || tag == 21 || tag == 18) { return ""; }
    if (tag == 9) { return pjoin(path, "是 " + typeNameOf(s, t) + "（弱引用只观察本线程的对象）"); }
    if (tag == 16) { return pjoin(path, "是 " + typeNameOf(s, t) + "（任务属于本线程的执行器）"); }
    if (tag == 20) { return pjoin(path, "是 " + typeNameOf(s, t) + "（生成器属于本线程）"); }
    if (tag == 23) { return pjoin(path, "是 " + typeNameOf(s, t) + "（线程句柄只能由建它的线程 join）"); }
    if (tag == 22) { return pjoin(path, "是平台句柄 " + typeNameOf(s, t)); }
    if (tag == 15 || tag == 19) { return ""; }
    // Shared<T> 发送的是句柄（线程第 4c 步）；Atomic<int> 只能经 Shared 跨线程（sharedNew 的实参里允许）。
    if (tag == 24) { return ""; }
    if (tag == 25) {
        if (s.iv.shareMode) { return ""; }
        return pjoin(path, "是 Atomic<int>（只能经 Shared 跨线程：放进 sharedNew）");
    }
    if (tag == 6 || tag == 8) { return sendWhy(s, t.inner catch s.dT, path, seen); }
    if (tag == 10) { return sendWhy(s, t.inner catch s.dT, pjoin(path, "的元素"), seen); }
    if (tag == 7) {
        const w = sendWhy(s, t.inner catch s.dT, path, seen);
        if (w != "" || t.ei == None) { return w; }
        return sendEnum(s, t.ei catch s.dummyEi, path, seen);
    }
    if (tag == 11 || tag == 12) { return sendWhy(s, t.elem catch s.dT, pjoin(path, "的元素"), seen); }
    if (tag == 13) {
        const si = t.si catch s.dummySi;
        if (listContains(seen, si.serial)) { return ""; }
        listPush(seen, si.serial);
        let i: int = 0;
        while (i < listLen(si.ftys)) {
            const w = sendWhy(s, listGet(si.ftys, i) catch s.dT, pjoin(path, "的字段 " + (listGet(si.fnames, i) catch "?")), seen);
            if (w != "") { return w; }
            i = i + 1;
        }
        return "";
    }
    if (tag == 14) { return sendEnum(s, t.ei catch s.dummyEi, path, seen); }
    return "";
}

function sendEnum(s: Ref<Sm>, ei: Ref<EnumT>, path: string, seen: List<int>): string {
    const key = -2 - ei.serial;
    if (listContains(seen, key)) { return ""; }
    listPush(seen, key);
    let v: int = 0;
    while (v < listLen(ei.vars)) {
        const vt = listGet(ei.vars, v) catch s.dVarT;
        let i: int = 0;
        while (i < listLen(vt.ftys)) {
            const w = sendWhy(s, listGet(vt.ftys, i) catch s.dT, pjoin(path, "的变体 " + vt.name + " 的字段 " + (listGet(vt.fnames, i) catch "?")), seen);
            if (w != "") { return w; }
            i = i + 1;
        }
        v = v + 1;
    }
    return "";
}

// SND1（线程第 3b 步）：按 sendWhy 的同一规则标记每个 struct、enum 能否发送——接口装入的运行期 struct 按具体
// 类型，其余按字段；不可发送沿字段反向传播到不动点（递归类型不展开，轮数不超过引用链长）。闭包按捕获的类型。
// 发出不可发送的 struct 池序、enum 池序与闭包键（先按可发送、再按可共享各一套，线程第 4c 步），codegen 换成运行期
// 类型号，原生产物据此建可发送表。
function sndEmit(s: Ref<Sm>, o: Ref<Out>): void {
    listPush(o.parts, "SND1 ");
    sndMode(s, o, false);
    sndMode(s, o, true);
}

// share＝false 按可发送标记（Atomic<int> 不可），true 按可共享标记（Atomic<int> 可；线程第 4c 步）。
function sndMode(s: Ref<Sm>, o: Ref<Out>, share: bool): void {
    const ns = listLen(s.sts);
    const ne = listLen(s.ens);
    const badS: List<int> = listNew();
    const boxOf: List<int> = listNew();
    let i: int = 0;
    while (i < ns) {
        listPush(badS, 0);
        listPush(boxOf, -1);
        i = i + 1;
    }
    const badE: List<int> = listNew();
    i = 0;
    while (i < ne) {
        listPush(badE, 0);
        i = i + 1;
    }
    i = 0;
    while (i < listLen(s.iv.boxSt)) {
        const bser = (listGet(s.iv.boxSt, i) catch s.dummySi).serial;
        if (bser >= 0 && bser < ns) {
            listSet(boxOf, bser, i);
        }
        i = i + 1;
    }
    let changed: bool = true;
    while (changed) {
        changed = false;
        i = 0;
        while (i < ns) {
            if ((listGet(badS, i) catch 1) == 0) {
                let bad: bool = false;
                const bx = listGet(boxOf, i) catch -1;
                if (bx >= 0) {
                    bad = sndBad(s, listGet(s.iv.boxTy, bx) catch s.dT, badS, badE, share);
                } else {
                    const si = listGet(s.sts, i) catch s.dummySi;
                    let j: int = 0;
                    while (!bad && j < listLen(si.ftys)) {
                        bad = sndBad(s, listGet(si.ftys, j) catch s.dT, badS, badE, share);
                        j = j + 1;
                    }
                }
                if (bad) {
                    listSet(badS, i, 1);
                    changed = true;
                }
            }
            i = i + 1;
        }
        i = 0;
        while (i < ne) {
            if ((listGet(badE, i) catch 1) == 0) {
                const ei = listGet(s.ens, i) catch s.dummyEi;
                let bad: bool = false;
                let v: int = 0;
                while (!bad && v < listLen(ei.vars)) {
                    const vt = listGet(ei.vars, v) catch s.dVarT;
                    let j: int = 0;
                    while (!bad && j < listLen(vt.ftys)) {
                        bad = sndBad(s, listGet(vt.ftys, j) catch s.dT, badS, badE, share);
                        j = j + 1;
                    }
                    v = v + 1;
                }
                if (bad) {
                    listSet(badE, i, 1);
                    changed = true;
                }
            }
            i = i + 1;
        }
    }
    const outS: List<int> = listNew();
    i = 0;
    while (i < ns) {
        const pid = listGet(s.stPool, i) catch -1;
        if ((listGet(badS, i) catch 0) == 1 && pid >= 0) {
            listPush(outS, pid);
        }
        i = i + 1;
    }
    const outE: List<int> = listNew();
    i = 0;
    while (i < ne) {
        const pid = listGet(s.enPool, i) catch -1;
        if ((listGet(badE, i) catch 0) == 1 && pid >= 0) {
            listPush(outE, pid);
        }
        i = i + 1;
    }
    const outC: List<int> = listNew();
    i = 0;
    while (i < listLen(s.tClosureRes)) {
        const row = listGet(s.tClosureRes, i) catch s.dummyRow;
        let bad: bool = false;
        let j: int = 0;
        while (!bad && j < row.a3) {
            bad = sndBad(s, listGet(s.tys, listGet(s.crInts, (row.a2 + j) * 5) catch 0) catch s.dT, badS, badE, share);
            j = j + 1;
        }
        if (bad) {
            listPush(outC, row.k);
        }
        i = i + 1;
    }
    sndList(o, outS);
    sndList(o, outE);
    sndList(o, outC);
}

function sndList(o: Ref<Out>, xs: List<int>): void {
    outDec(o, listLen(xs));
    let i: int = 0;
    while (i < listLen(xs)) {
        outDec(o, listGet(xs, i) catch 0);
        i = i + 1;
    }
}

// 类型 t 是否（经可选、错误联合、Ref、List、数组、切片）含有不可发送的成分；struct、enum 查当前标记。
function sndBad(s: Ref<Sm>, t: Ref<Ty>, badS: List<int>, badE: List<int>, share: bool): bool {
    const tag = t.tag;
    if (tag == 9 || tag == 16 || tag == 20 || tag == 23 || tag == 22) { return true; }
    if (tag == 25) { return !share; }
    if (tag == 6 || tag == 8 || tag == 10) { return sndBad(s, t.inner catch s.dT, badS, badE, share); }
    if (tag == 7) {
        if (sndBad(s, t.inner catch s.dT, badS, badE, share)) { return true; }
        if (t.ei == None) { return false; }
        return (listGet(badE, (t.ei catch s.dummyEi).serial) catch 0) == 1;
    }
    if (tag == 11 || tag == 12) { return sndBad(s, t.elem catch s.dT, badS, badE, share); }
    if (tag == 13) { return (listGet(badS, (t.si catch s.dummySi).serial) catch 0) == 1; }
    if (tag == 14) { return (listGet(badE, (t.ei catch s.dummyEi).serial) catch 0) == 1; }
    return false;
}

// 路径接续：前一段以英文标识符结尾时隔一个空格（“捕获的 w 是 …”），以中文结尾时直接相连（“结果是 …”）。
function pjoin(path: string, tail: string): string {
    const n = len(path);
    if (n > 0 && (byteAt(path, n - 1) catch 0) < 128) {
        return path + " " + tail;
    }
    return path + tail;
}

function listContains(xs: List<int>, x: int): bool {
    let i: int = 0;
    while (i < listLen(xs)) {
        if ((listGet(xs, i) catch -9) == x) { return true; }
        i = i + 1;
    }
    return false;
}

// D3 v0.23 FFI：handleBits(h): int 取句柄的位值；handleFromBits<H>(v): H 由位值构造句柄（哨兵值、
// 与 C 侧约定的整数句柄）。两者都不检查，运行期为恒等。
function checkHandleBuiltin(s: Ref<Sm>, e: Ref<Expr>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, 1, atLine, atCol, builtinWantSig(b));
    const a0 = listGet(args, 0) catch s.dummyE;
    if (b == 60) {
        const t0 = checkExpr(s, a0, s.dT);
        if (t0.tag != 22) {
            emitDiag(s, 3002, a0.line, a0.col, "handleBits 需要句柄（declare type 声明的类型）的值（得到 " + typeNameOf(s, t0) + "）");
        }
        return s.tInt;
    }
    const t1 = checkExpr(s, a0, s.tInt);
    if (!assignable(s, t1, s.tInt)) {
        emitDiag(s, 3002, a0.line, a0.col, "handleFromBits 的实参须为整数（得到 " + typeNameOf(s, t1) + "）");
    }
    if (listLen(e.targs) != 1) {
        emitDiag(s, 3002, atLine, atCol, "handleFromBits 须显式写出句柄类型：handleFromBits<HWND>(v)");
        return s.tInt;
    }
    const want = resolveType(s, listGet(e.targs, 0) catch s.dummyTe);
    if (want.tag != 22) {
        emitDiag(s, 3002, atLine, atCol, "handleFromBits 的类型实参须为句柄类型（declare type 声明；得到 " + typeNameOf(s, want) + "）");
        return s.tInt;
    }
    return want;
}

// D3 v0.19：errAs<E>(e)——e 带 E 种类时得到该值，否则 None（类型实参必须显式写出）；errWrap(原因, 消息)。
function checkErrBuiltin(s: Ref<Sm>, e: Ref<Expr>, b: int, args: List<Ref<Expr>>, atLine: int, atCol: int): Ref<Ty> {
    wantArgsEmit(s, args, builtinArity(b), atLine, atCol, builtinWantSig(b));
    const a0 = listGet(args, 0) catch s.dummyE;
    const t0 = checkExpr(s, a0, s.tErr);
    if (b == 48) {
        if (!isErrLike(s, t0)) { emitDiag(s, 3002, a0.line, a0.col, "errAs 的实参需要 Error（得到 " + typeNameOf(s, t0) + "）"); }
        if (listLen(e.targs) != 1) {
            emitDiag(s, 3029, atLine, atCol, "errAs 须显式写出一个类型实参：errAs<错误enum>(e)");
            return tOpt(s, s.tErr);
        }
        const want = resolveType(s, listGet(e.targs, 0) catch s.dummyTe);
        if (!isErrEnumTy(s, want)) {
            emitDiag(s, 3029, atLine, atCol, "errAs 的类型实参须为错误 enum（得到 " + typeNameOf(s, want) + "）");
            return tOpt(s, s.tErr);
        }
        return tOpt(s, want);
    }
    if (!isErrLike(s, t0)) { emitDiag(s, 3002, a0.line, a0.col, "errWrap 第一实参（原因）需要 Error（得到 " + typeNameOf(s, t0) + "）"); }
    const a1 = listGet(args, 1) catch s.dummyE;
    const t1 = checkExpr(s, a1, s.tString);
    if (t1.tag != 3) { emitDiag(s, 3002, a1.line, a1.col, "errWrap 第二实参（消息）需要 string（得到 " + typeNameOf(s, t1) + "）"); }
    return s.tErr;
}

// D3 v0.19 错误 enum 变体：消息 → 片段（字面量原文／本变体字段序），原因＝名为 cause 的 Error 型字段。
function errVariantSegs(s: Ref<Sm>, ed: Ref<EnumDecl>, vd: Ref<VarDecl>, vt: Ref<VarT>): void {
    let fj: int = 0;
    while (fj < listLen(vt.fnames)) {
        if ((listGet(vt.fnames, fj) catch "") == "cause" && isErrLike(s, listGet(vt.ftys, fj) catch s.dT)) { vt.cause = fj; }
        fj = fj + 1;
    }
    if (vd.msg == None) {
        emitDiag(s, 3027, ed.line, ed.col, "错误 enum " + ed.name + " 的变体 " + vd.name + " 缺少消息（写成 " + vd.name + " = \"…\" 或 = `…${字段}…`）");
        return;
    }
    errMsgSegs(s, vd.msg catch s.dummyE, vd, vt);
}

// 模板插值段的位置随模板串本身（段内子解析从 1:1 计），诊断取 toStr 调用节点的位置。
function errMsgSegs(s: Ref<Sm>, e: Ref<Expr>, vd: Ref<VarDecl>, vt: Ref<VarT>): bool {
    if (e.tag == 28) {
        listPush(vt.segRaw, e.s0);
        listPush(vt.segField, -1);
        return true;
    }
    if (e.tag == 32 && e.i0 == 0) {
        if (!errMsgSegs(s, e.a catch s.dummyE, vd, vt)) { return false; }
        return errMsgSegs(s, e.b catch s.dummyE, vd, vt);
    }
    if (e.tag == 34 && listLen(e.list) == 1 && (e.a catch s.dummyE).tag == 31 && (e.a catch s.dummyE).s0 == "toStr") {
        const arg = listGet(e.list, 0) catch s.dummyE;
        if (arg.tag == 31) {
            let fj: int = 0;
            while (fj < listLen(vt.fnames)) {
                if ((listGet(vt.fnames, fj) catch "") == arg.s0) {
                    const ft = listGet(vt.ftys, fj) catch s.dT;
                    if (!(ft.tag <= 3 || isErrLike(s, ft))) {
                        emitDiag(s, 3027, e.line, e.col, "错误消息插值的字段 " + arg.s0 + " 类型为 " + typeNameOf(s, ft) + "，不能转成字符串（只支持 int/float/bool/string/Error）");
                        return false;
                    }
                    listPush(vt.segRaw, "");
                    listPush(vt.segField, fj);
                    return true;
                }
                fj = fj + 1;
            }
            emitDiag(s, 3027, e.line, e.col, "错误消息只能插值变体 " + vd.name + " 自己的字段（没有字段 '" + arg.s0 + "'）");
            return false;
        }
    }
    emitDiag(s, 3027, e.line, e.col, "错误消息须为字符串字面量，或只插值本变体字段的模板串");
    return false;
}

function checkCallBuiltin(s: Ref<Sm>, e: Ref<Expr>, b: int, rawArgs: List<Ref<Expr>>, expected: Ref<Ty>, atLine: int, atCol: int): Ref<Ty> {
    // 实参不足垫齐（zig 同构：wantArgs 先报错，none 字面量垫位——垫位节点
    // 检查期照查照发诊断；synMake＝检查期分配序，与 oracle synRegExpr 同批）。
    const want: int = builtinArity(b);
    let args: List<Ref<Expr>> = rawArgs;
    if (listLen(rawArgs) < want) {
        emitDiag(s, 3011, atLine, atCol, "内建 " + builtinWantSig(b) + " 需要 " + toStr(want) + " 个实参，传入 " + toStr(listLen(rawArgs)));
        args = listNew();
        let ppi: int = 0;
        const prn = listLen(rawArgs);
        while (ppi < prn) {
            listPush(args, listGet(rawArgs, ppi) catch s.dummyE);
            ppi = ppi + 1;
        }
        while (ppi < want) {
            listPush(args, synMake(s, 30, atLine, atCol));
            ppi = ppi + 1;
        }
    }
    putExprResBuiltin(s, e, b);
    if (b == 0) {
        wantArgsEmit(s, args, 1, atLine, atCol, "print(string)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.tString);
        if (t.tag != 3) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "print 需要 string（得到 " + typeNameOf(s, t) + "；数字先用 toStr）"); }
        return s.tVoid;
    }
    if (b == 1) {
        wantArgsEmit(s, args, 1, atLine, atCol, "err(string)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.tString);
        if (t.tag != 3) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "err 需要 string（得到 " + typeNameOf(s, t) + "）"); }
        return s.tErr;
    }
    if (b == 2) {
        wantArgsEmit(s, args, 1, atLine, atCol, "readFile(string)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.tString);
        if (t.tag != 3) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "readFile 需要 string 路径（得到 " + typeNameOf(s, t) + "）"); }
        return tErrunion(s, s.tString);
    }
    if (b == 3) {
        wantArgsEmit(s, args, 1, atLine, atCol, "len(string|[]T|[N]T)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.dT);
        if (!(t.tag == 3 || t.tag == 12 || t.tag == 11 || t.tag == 17)) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "len 需要 string/数组/切片（得到 " + typeNameOf(s, t) + "）"); }
        return s.tInt;
    }
    if (b == 4) {
        wantArgsEmit(s, args, 1, atLine, atCol, "toStr(int|float|bool|string|Error)");
        const t = checkExpr(s, listGet(args, 0) catch s.dummyE, s.dT);
        if (t.tag == 3) { return s.tString; }
        if (t.tag == 5) { return s.tString; }
        if (t.tag == 14 && isErrEnumTy(s, t)) { return s.tString; }
        if (t.tag == 21) { return s.tString; }
        if (!(t.tag == 0 || t.tag == 1 || t.tag == 2)) { emitDiag(s, 3002, (listGet(args, 0) catch s.dummyE).line, (listGet(args, 0) catch s.dummyE).col, "toStr 需要 int/float/bool/string/Error（得到 " + typeNameOf(s, t) + "）"); }
        return s.tString;
    }
    if (b == 5) {
        wantArgsEmit(s, args, 1, atLine, atCol, "unref(Ref<T>)");
