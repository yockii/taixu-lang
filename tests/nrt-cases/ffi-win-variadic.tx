// D3 v0.36 C 变参（Windows，msvcrt）：同 Linux 版——float、int、窄整数与 f32（默认实参提升）、u32、字符串混排，核对 _snprintf
// 的结果。float 在第 4 个位置：Win64 的变参浮点须同时在 xmm3 与 r9（被调方按 va_list 从影子空间读整数寄存器的副本）。
declare function _snprintf(buf: Bytes, count: usize, format: string, ...e: float, ...a: int, ...b: i8, ...c: u32, ...d: f32, ...f: string): i32 from "msvcrt";

function cText(b: Bytes): string {
    let n = 0;
    while (n < bytesLen(b) && (bytesGet(b, n) catch 0) != 0) { n = n + 1; }
    return bytesToStr(bytesSlice(b, 0, n)) catch "bad-utf8";
}

function main(args: []string): int {
    const buf = bytesNew(96);
    const small: i8 = -5;
    const wide: u32 = 4000000000;
    const single: f32 = 1.25;
    const n = _snprintf(buf, 96, "%.3f %I64d %d %u %.2f %s", 2.5, -9000000000, small, wide, single, "太虚");
    print("ret " + toStr(n as int) + " text " + cText(buf));
    return 0;
}
