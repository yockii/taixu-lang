// 第 5 轮 FFI 前端负例（使用）：string 只在外部签名、句柄不经 as、handleBits/handleFromBits 误用、
// 回调实参须是顶层函数名、外部函数按模块可见、与本模块声明重名。
import { ticks } from "./data/ffi_hidden";

declare type HANDLE;
declare function onEach(cb: (usize) => i32): void from "k";
declare function helper(): int from "k";

function helper(): int {
    return 1;
}

function good(x: usize): i32 {
    return 0;
}

function wrongSig(x: int): i32 {
    return 0;
}

function main(args: []string): int {
    let c: cstr = "a";
    const h = handleFromBits < HANDLE > (1);
    const v = h as int;
    const w = handleBits(5);
    const z = handleFromBits(1);
    const q = handleFromBits < int > (1);
    const cl = (x: usize): i32 => 0;
    onEach(cl);
    onEach(wrongSig);
    onEach(good);
    print(toStr(GetTickCount() as int + ticks()));
    return 0;
}
