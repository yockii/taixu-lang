// D3 v0.36 C 变参的编译期拒绝（3033）：from syscall 不能有变参；常见 C 变参函数的定参个数须与 C 原型一致（写成定参、或 ... 的
// 位置不对都报）；回调不能作变参。不调用也报（声明处核对，各目标一致）。
declare function g1(fd: i32, ...mode: u32): i32 from syscall 257;
declare function openat(fd: i32, path: string, flags: i32, mode: u32): i32 from "libSystem";
declare function fcntl(fd: i32, ...cmd: i32, ...arg: int): i32 from "libc.so.6";
declare function qs(base: Bytes, ...cmp: (usize, usize) => i32): void from "k";
function main(args: []string): int {
    return 0;
}
