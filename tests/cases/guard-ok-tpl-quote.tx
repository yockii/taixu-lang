// V0.42 验收发现 B 锚件：模板字面量静态段含引号/CJK/转义（raw 规范化前
// 裸引号包裹段在 AST-BIN→FAB1 回环 decodeStrRaw 处被内引号截断）。
function main(args: []string): int {
    const i = 3;
    assert(`A${i}B${i + 1}C` == "A3B4C", "无引号模板基线");
    assert(`a"b${i}` == "a\"b3", "头段含引号");
    assert(`${i}c"d` == "3c\"d", "尾段含引号");
    assert(`a"b${i}e` == "a\"b3e", "双段含引号");
    assert(`{"id":${i},"ok":true}` == "{\"id\":3,\"ok\":true}", "json 形");
    assert(`中"文${i}结` == "中\"文3结", "CJK 段含引号");
    assert(`x\ty${i}` == "x\ty3", "段内转义");
    print("tpl-quote-ok");
    return 0;
}

test "tpl：纯模板无插值（raw 全切片规范化）" {
    assert(`plain "quoted" text` == "plain \"quoted\" text", "纯模板含引号");
    assert(`中文“引号”` == "中文“引号”", "纯模板 CJK 引号");
}
