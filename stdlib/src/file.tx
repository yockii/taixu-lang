// ============================================================================
// std/file —— 流式文件读写（核心仓容量批 C4e；设计：核心仓 docs/design/v052-file-streaming-v0.1-20261016.md）。
//
// 打开、分块读、分块写、定位、关闭。readFile/writeFile 一次读入或写出整个文件；数据集、模型权重、日志
// 按 GB 计时，用本模块边读边处理、追加写或随机访问。
//
// 数据是 Bytes（D3 v0.18）。当初冻结的 Zig 链不认识 Bytes 而 std/fs 还要供它编译，所以单列为本模块；
// Zig 链已退役，模块划分保持不变。系统面在 file_sys_windows.tx（kernel32）／file_sys_linux.tx（from syscall）／
// file_sys_macos.tx（libSystem）。
//
// 句柄是 int，取自核心仓内核的进程级句柄表（同 std/net 的套接字）：可以在线程之间传递；带代数，关闭后
// 旧句柄失效，槽位复用时新句柄与旧的不同。一个线程关闭句柄的同时另一个线程正在用它，属调用方的同步责任。
// ============================================================================

import { sysFileOpen, sysFileRead, sysFileWrite, sysFileSeek, sysFileClose } from "./file_sys";

// 打开方式。
export const FILE_READ: int = 0; // 只读；文件须存在，不能是目录
export const FILE_WRITE: int = 1; // 只写；新建或截断
export const FILE_APPEND: int = 2; // 只写；新建或追加，每次写都落在末尾

// 定位基准。
export const SEEK_START: int = 0;
export const SEEK_CURRENT: int = 1;
export const SEEK_END: int = 2;

// 单次读、单块写的上限（Windows ReadFile/WriteFile 的长度是 32 位）。
const FILE_CHUNK: int = 1073741824;

// 系统面的返回码：≥0 成功；−1 系统调用失败；−2 无效句柄；−3 不支持（导出面基准文件）。
const BAD_HANDLE: int = -2;
const UNSUPPORTED: int = -3;

// fileOpen：按打开方式打开文件，返回句柄。
export function fileOpen(path: string, mode: int): int | Error {
    if (mode < FILE_READ || mode > FILE_APPEND) {
        return err("file: bad open mode: " + toStr(mode));
    }
    const h = sysFileOpen(path, mode);
    if (h == UNSUPPORTED) {
        return err("file: not supported on this target");
    }
    if (h < 0) {
        return err("file: open failed: " + path);
    }
    return h;
}

// fileRead：至多读 max 字节（单次另有 1 GiB 上限），返回实际读到的字节；文件尾得空 Bytes。
export function fileRead(f: int, max: int): Bytes | Error {
    if (max <= 0) {
        return err("file: read size must be positive");
    }
    let cap: int = max;
    if (cap > FILE_CHUNK) {
        cap = FILE_CHUNK;
    }
    const buf = bytesNew(cap);
    const n = sysFileRead(f, buf, cap);
    if (n == BAD_HANDLE) {
        return err("file: bad handle");
    }
    if (n < 0) {
        return err("file: read failed");
    }
    if (n == cap) {
        return buf;
    }
    return bytesSlice(buf, 0, n);
}

// fileWrite：全部写出（按块循环，每块至多 1 GiB）；中途失败为 Error，已写出的部分不回滚。
export function fileWrite(f: int, data: Bytes): void | Error {
    const total = bytesLen(data);
    let off: int = 0;
    while (true) {
        let n: int = total - off;
        if (n > FILE_CHUNK) {
            n = FILE_CHUNK;
        }
        const w = sysFileWrite(f, data, off, n);
        if (w == BAD_HANDLE) {
            return err("file: bad handle");
        }
        if (w < 0 || (w == 0 && n > 0)) {
            return err("file: write failed");
        }
        off = off + w;
        if (off >= total) {
            break;
        }
    }
    return done();
}

// fileSeek：按基准（SEEK_START／SEEK_CURRENT／SEEK_END）移动读写位置，返回新位置；越过文件尾允许，
// 结果为负是 Error。
export function fileSeek(f: int, offset: int, whence: int): int | Error {
    if (whence < SEEK_START || whence > SEEK_END) {
        return err("file: bad seek whence: " + toStr(whence));
    }
    const p = sysFileSeek(f, offset, whence);
    if (p == BAD_HANDLE) {
        return err("file: bad handle");
    }
    if (p < 0) {
        return err("file: seek failed");
    }
    return p;
}

// fileClose：关闭并作废句柄；无效或已关闭的句柄为空操作。
export function fileClose(f: int): void {
    sysFileClose(f);
}

// void | Error 的成功出口（语言没有裸 `return;` 的形式，返回一个 void 调用）。
function done(): void {
}
