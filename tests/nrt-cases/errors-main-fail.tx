// main 可以返回 int | Error：失败时 toStr(e) 写到 stderr，退出码 1。
enum AppError extends Error {
    Missing(path: string) = `找不到配置文件 ${path}`,
}

function load(path: string): int | AppError {
    return AppError.Missing(path);
}

export function main(args: []string): int | Error {
    print("开始");
    const n = load("app.conf")?;
    print("不会到这里 " + toStr(n));
    return 0;
}
