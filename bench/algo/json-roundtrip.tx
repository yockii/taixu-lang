// bench/algo/json-roundtrip —— JSON 构树→序列化→解析 往复（40 轮 ×
// 120 节点树）。校验和＝解析回读的 Int 叶子和＋轮数（std/json 确定性）。
import { Json, KV, jsonParse, jsonStringify } from "std/json";

function mkTree(round: int): Ref<Json> {
    const entries: List< Ref<KV>> = listNew();
    let i: int = 0;
    while (i < 20) {
        const inner: List< Ref<KV>> = listNew();
        let j: int = 0;
        while (j < 5) {
            listPush(inner, new KV { k: "i" + toStr(j), v: new Json.Int(round * 100 + i * 5 + j) });
            j = j + 1;
        }
        listPush(entries, new KV { k: "g" + toStr(i), v: new Json.Obj(inner) });
        i = i + 1;
    }
    return new Json.Obj(entries);
}

export function main(args: []string): int {
    let checksum: int = 0;
    let round: int = 0;
    while (round < 40) {
        const tree = mkTree(round);
        const text: string = jsonStringify(tree);
        const back: Ref<Json> = jsonParse(text) catch new Json.Null();
        checksum = checksum + len(text) % 97;
        round = round + 1;
    }
    print(toStr(checksum % 1000003));
    return 0;
}
