// 05 堆与引用：new/Ref/Weak 与 List 容器。
struct Counter {
    hits: int,
}

function bump(c: Ref<Counter>): void {
    c.hits = c.hits + 1; // const 绑定不冻结对象字段（TS object 心智）
}

function main(args: []string): int {
    // Ref：共享同一对象（同一性 ==）
    const c: Ref<Counter> = new Counter { hits: 0 };
    const alias: Ref<Counter> = c;
    bump(c);
    bump(c);
    print("hits=" + toStr(alias.hits) + " same:" + toStr(c == alias));

    // Weak：观察不拥有；最后一个强引用消失（重绑定 v）即死亡
    let v: Ref<Counter> = new Counter { hits: 9 };
    const w = weak(v);
    const before = deref(w) catch Counter { hits: -1 };
    print("before:" + toStr(before.hits));
    v = new Counter { hits: 55 };
    const dead = deref(w) catch Counter { hits: -1 };
    print("after:" + toStr(dead.hits));

    // List<T>：句柄语义的堆容器；迭代顺序＝插入顺序
    const names: List<string> = listNew();
    listPush(names, "太虚");
    listPush(names, "taixu");
    for (name in names) {
        print("name:" + name);
    }
    print("len:" + toStr(listLen(names)));
    return 0;
}
