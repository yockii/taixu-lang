// D3 v0.50 修正：有返回值的函数以“两支都 return 的 if／else”结尾时，then 支之后的跳转落在函数体末尾之外，原先链接失败
// （标号悬空）。现在函数末尾补一个走不到的尾作落点。
function pick(c: bool): int {
    if (c) {
        return 1;
    } else {
        return 2;
    }
}

function chain(n: int): string {
    if (n < 0) {
        return "负";
    } else if (n == 0) {
        return "零";
    } else {
        return "正";
    }
}

function nested(a: bool, b: bool): int {
    if (a) {
        if (b) {
            return 11;
        } else {
            return 10;
        }
    } else {
        return 0;
    }
}

function main(args: []string): void {
    print(toStr(pick(true)) + " " + toStr(pick(false)));
    print(chain(-5) + chain(0) + chain(7));
    print(toStr(nested(true, true)) + " " + toStr(nested(true, false)) + " " + toStr(nested(false, true)));
}
