// 逐例对照两种构建的门步（portable-codegen、heap-check）共用的部分：经语料运行器 scripts/test_nrt_products.tx 跑一遍语料、读它的
// 报告（{"counts": …, "rows": [{"case", "status", "detail"?…}]}，也接受只有 rows 数组的旧形）。不导入 bootstrap/。
import { join, nat, readBytes } from "./build_lib";
import { captureRaw } from "./test_lib";
import { J_ARR, J_OBJ, Jv, jAt, jGet, jLen, jParseBytes, jText } from "./test_json";

const SEC: int = 1000000000;
// 一遍全量语料的上限（语料运行器另外逐例限时）。
const CORPUS_NS: int = 21600 * SEC;

// 用例 → 状态与细节。
export struct Rows {
    status: Map<string, string>,
    detail: Map<string, string>,
}

export function rowsNew(): Ref<Rows> {
    return new Rows { status: mapNew(), detail: mapNew() };
}

export function loadRows(path: string): Ref<Rows> | Error {
    const v = jParseBytes(readBytes(path)?)?;
    let rows = v;
    if (v.kind == J_OBJ) {
        rows = jGet(v, "rows") ?? v;
    }
    if (rows.kind != J_ARR) {
        return err("报告里没有 rows 数组：" + path);
    }
    const out = rowsNew();
    let i = 0;
    while (i < jLen(rows)) {
        const r = jAt(rows, i);
        if (r == None) {
            return err("报告的 rows 第 " + toStr(i) + " 项缺席：" + path);
        }
        const row = r ?? v;
        const c = jText(jGet(row, "case"));
        const s = jText(jGet(row, "status"));
        if (c == None || s == None) {
            return err("报告的 rows 第 " + toStr(i) + " 项缺 case 或 status：" + path);
        }
        mapSet(out.status, c ?? "", s ?? "");
        mapSet(out.detail, c ?? "", jText(jGet(row, "detail")) ?? "");
        i = i + 1;
    }
    return out;
}

// 在仓根跑语料运行器：--work runDir --report report，再加 extra（旗标与用例）；退出码与输出不看，结果只取报告。
export function runCorpus(compiler: string, root: string, runDir: string, report: string, extra: List<string>): void | Error {
    const args: List<string> = listNew();
    listPush(args, "run");
    listPush(args, "--toolchain");
    listPush(args, nat(join(root, "scripts/test_nrt_products.tx")));
    listPush(args, "--compiler");
    listPush(args, compiler);
    listPush(args, "--work");
    listPush(args, runDir);
    listPush(args, "--report");
    listPush(args, report);
    for (a in extra) {
        listPush(args, a);
    }
    const r = captureRaw(compiler, args, root, CORPUS_NS, 30 * SEC, 65536)?;
}
