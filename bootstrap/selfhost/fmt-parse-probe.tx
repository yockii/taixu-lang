// 格式化门的语法守护：指定的文本须能解析；不执行用户程序。
import { parseSourceBin } from "../parser";

function main(args: []string): int {
    if (len(args) == 0) { return 64; }
    for (path in args) {
        const source = readFile(path) catch (e) { eprint(e.message); return 1; };
        const raw = parseSourceBin(source);
        if (strIndexOf(raw, "TXB1 ") != 0) { eprint(raw); return 1; }
    }
    return 0;
}
