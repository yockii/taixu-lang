// D3 v0.52 §6.10-2：for (c in s) 逐字符产出码点（此前逐字节）；for (i, c in s) 的 i 为该字符首字节的字节
// 偏移，可直接交给 strSlice；continue 同样前进到下一个字符。逐字节仍用 while＋byteAt。期望值由 Python 独立算出。
export function main(args: []string): int {
    const s = "aé太😀";
    let line = "";
    for (c in s) { line = line + toStr(c) + "|"; }
    print(line);
    line = "";
    for (i, c in s) {
        const w = len(utf8Encode(c) catch "");
        line = line + toStr(i) + ":" + strSlice(s, i, i + w) + " ";
    }
    print(line + "/");
    let n = 0;
    for (c in "") { n = n + 1; }
    for (c in "太虚智能") {
        if (c == '虚') { continue; }
        if (c == '能') { break; }
        n = n + 10;
    }
    print(toStr(n));
    let offs = "";
    for (i, c in "😀a😀") {
        if (c == 'a') { continue; }
        offs = offs + toStr(i) + ",";
    }
    print(offs);
    let sum = 0;
    let k = 0;
    while (k < len(s)) {
        sum = sum + byteAt(s, k);
        k = k + 1;
    }
    print(toStr(sum));
    return 0;
}
