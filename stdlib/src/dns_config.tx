import { dnsName } from "./dns_wire";
import { parseIp } from "./ip";

export struct DnsServer { ip: Bytes, port: int }
export struct DnsConfig { servers: List<DnsServer>, search: List<string>, ndots: int, timeoutMs: int, attempts: int, tcp: bool, rotate: bool }

export function dnsWords(line: string): List<string> {
    const out: List<string> = listNew(); let start = -1; let i = 0;
    while (i < len(line)) {
        const b = byteAt(line, i);
        if (b == 35 || b == 59) { break; }
        if (b == 32 || b == 9 || b == 13) { if (start >= 0) { listPush(out, strSlice(line, start, i)); start = -1; } }
        else if (start < 0) { start = i; } i = i + 1;
    }
    if (start >= 0) { listPush(out, strSlice(line, start, i)); } return out;
}
// 选项值按 glibc（atoi）与 Go（dtoi）取开头的十进制数字，不以数字开头的值得 -1，调用方忽略该选项。
function optionNumber(value: string, maximum: int): int {
    let n = 0; let i = 0;
    while (i < len(value) && i < 9) { const b = byteAt(value, i); if (b < 48 || b > 57) { break; } n = n * 10 + (b - 48); i = i + 1; }
    if (i == 0) { return -1; } if (n > maximum) { return maximum; } return n;
}
// 宽容解析，同 glibc 与 Go：认不出的行、地址与选项逐项忽略，不使整份配置失效（systemd-resolved 的存根写“search .”）；
// nameserver 只取前 3 个（MAXNS）；一个都没有时用本机 127.0.0.1 与 ::1。
export function dnsParseConfig(text: string): DnsConfig | Error {
    if (len(text) > 1048576) { return err("dns: resolver file limit"); }
    let config = DnsConfig { servers: listNew(), search: listNew(), ndots: 1, timeoutMs: 5000, attempts: 2, tcp: false, rotate: false };
    for (line in strSplit(text, "\n")) {
        const words = dnsWords(line); if (listLen(words) == 0) { continue; } const directive = listGet(words, 0);
        if (directive == "nameserver") {
            if (listLen(words) >= 2 && listLen(config.servers) < 3) {
                const ip = parseIp(listGet(words, 1)) catch (e) { continue; };
                listPush(config.servers, DnsServer { ip: ip, port: 53 });
            }
        } else if (directive == "search" || directive == "domain") {
            config.search = listNew(); let i = 1;
            while (i < listLen(words) && listLen(config.search) < 32) {
                const word = listGet(words, i); i = i + 1;
                if (word != ".") { const name = dnsName(word) catch ""; if (len(name) > 0) { listPush(config.search, name); } }
                if (directive == "domain") { break; }
            }
        } else if (directive == "options") {
            let i = 1;
            while (i < listLen(words)) {
                const parts = strSplit(listGet(words, i), ":"); const key = listGet(parts, 0);
                if (listLen(parts) == 2) {
                    const value = listGet(parts, 1);
                    if (key == "ndots") { const ndots = optionNumber(value, 15); if (ndots >= 0) { config.ndots = ndots; } }
                    else if (key == "timeout") { const seconds = optionNumber(value, 30); if (seconds == 0) { config.timeoutMs = 1000; } else if (seconds > 0) { config.timeoutMs = seconds * 1000; } }
                    else if (key == "attempts") { const attempts = optionNumber(value, 5); if (attempts == 0) { config.attempts = 1; } else if (attempts > 0) { config.attempts = attempts; } }
                } else if (listLen(parts) == 1) { if (key == "use-vc") { config.tcp = true; } else if (key == "rotate") { config.rotate = true; } }
                i = i + 1;
            }
        }
    }
    if (listLen(config.servers) == 0) {
        listPush(config.servers, DnsServer { ip: parseIp("127.0.0.1")?, port: 53 }); listPush(config.servers, DnsServer { ip: parseIp("::1")?, port: 53 });
    }
    return config;
}
export function dnsSearchNames(host: string, config: DnsConfig): List<string> | Error {
    const name = dnsName(host)?; const out: List<string> = listNew();
    if (byteAt(host, len(host) - 1) == 46) { listPush(out, name); return out; }
    const absoluteFirst = listLen(strSplit(name, ".")) - 1 >= config.ndots;
    if (absoluteFirst) { listPush(out, name); }
    for (suffix in config.search) {
        const candidate = name + "." + suffix; if (len(candidate) > 253) { continue; }
        let duplicate = false; for (existing in out) { if (existing == candidate) { duplicate = true; } } if (!duplicate) { listPush(out, candidate); }
    }
    let found = false; for (existing in out) { if (existing == name) { found = true; } } if (!found) { listPush(out, name); } return out;
}
export function dnsHosts(text: string, host: string): List<Bytes> | Error {
    if (len(text) > 1048576) { return err("dns: hosts file limit"); }
    const name = dnsName(host)?; const out: List<Bytes> = listNew();
    for (line in strSplit(text, "\n")) {
        const words = dnsWords(line); if (listLen(words) < 2) { continue; } let matches = false; let i = 1;
        while (i < listLen(words)) { if ((dnsName(listGet(words, i)) catch "") == name) { matches = true; } i = i + 1; }
        if (matches) {
            // 认不出的地址（如带区域的 fe80::1%lo0）跳过该行，同 glibc。
            const ip = parseIp(listGet(words, 0)) catch (e) { continue; }; let duplicate = false; for (existing in out) { if (bytesEqual(existing, ip)) { duplicate = true; } }
            if (!duplicate) { listPush(out, ip); }
        }
    } return out;
}
