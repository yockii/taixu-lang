// Native deep clone: descriptor adapters supply layout facts, not recursion.
import { CLONE_OFF_KIND, CLONE_OFF_PTR, CLONE_OFF_LEN, CLONE_MAX_DEPTH } from "./payload_abi";
import { Operand, StructuredBuffer, asBufferInstruction, asBufferLabel, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem } from "./assemble";
function r(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function d(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function i(n: int): Ref<Operand> { return asStructuredImm(n); }
function m(n: int, off: int): Ref<Operand> { return asStructuredMem(2, n, -1, 0, off, 0, ""); }
function md(n: int, off: int): Ref<Operand> { return asStructuredMem(1, n, -1, 0, off, 0, ""); }
function op(b: Ref<StructuredBuffer>, name: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void { asBufferInstruction(b, name, n, a, c, asStructuredMissing(), 1); }
function two(b: Ref<StructuredBuffer>, name: string, a: Ref<Operand>, c: Ref<Operand>): void { op(b, name, 2, a, c); }
function mov(b: Ref<StructuredBuffer>, a: Ref<Operand>, c: Ref<Operand>): void { two(b, "mov", a, c); }
function lab(b: Ref<StructuredBuffer>, name: string): void { asBufferLabel(b, name, 1); }
function jump(b: Ref<StructuredBuffer>, cond: string, name: string): void { op(b, cond, 1, asStructuredTarget(name), asStructuredMissing()); }
function call(b: Ref<StructuredBuffer>, name: string): void { jump(b, "call", name); }
function ret(b: Ref<StructuredBuffer>): void { op(b, "ret", 0, asStructuredMissing(), asStructuredMissing()); }
export function payloadCloneEmit(b: Ref<StructuredBuffer>): void {
    let p = "__tx_pc";
    lab(b, "__tx_native_clone_v1"); two(b, "sub", r(4), i(120));
    mov(b, md(4, 48), d(2)); mov(b, m(4, 56), r(8)); mov(b, m(4, 64), r(9));
    // Snapshot input before any callback, including when out==input.
    mov(b, r(10), m(1, 0)); mov(b, r(11), m(1, 8)); mov(b, m(4, 32), r(10)); mov(b, m(4, 40), r(11));
    two(b, "cmp", d(2), i(CLONE_MAX_DEPTH)); jump(b, "ja", p + "_depth");
    // Nested Ref fields stay shared handles (D3 Ref semantics); only a top-level clone of a Ref takes its value (unref).
    two(b, "test", d(2), d(2)); jump(b, "jz", p + "_view");
    mov(b, d(10), md(4, 32)); two(b, "and", d(10), i(255)); two(b, "cmp", d(10), i(9)); jump(b, "je", p + "_shared");
    lab(b, p + "_view");
    mov(b, r(1), r(4)); two(b, "add", r(1), i(32)); mov(b, r(2), m(4, 56)); mov(b, r(8), r(4)); two(b, "add", r(8), i(72)); call(b, "__tx_store_clone_view");
    two(b, "test", d(0), d(0)); jump(b, "jz", p + "_shared");
    mov(b, r(1), m(4, 72 + CLONE_OFF_LEN)); call(b, "__tx_native_values_alloc_v1"); two(b, "test", r(0), r(0)); jump(b, "jz", p + "_oom");
    mov(b, m(4, 104), r(0)); mov(b, m(4, 112), i(0));
    lab(b, p + "_loop"); mov(b, r(0), m(4, 112)); two(b, "cmp", r(0), m(4, 72 + CLONE_OFF_LEN)); jump(b, "jae", p + "_new");
    two(b, "shl", r(0), i(4)); mov(b, r(1), m(4, 72 + CLONE_OFF_PTR)); two(b, "add", r(1), r(0));
    mov(b, r(9), m(4, 104)); two(b, "add", r(9), r(0)); mov(b, d(2), md(4, 48)); two(b, "add", d(2), i(1)); mov(b, r(8), m(4, 56)); call(b, "__tx_native_clone_v1");
    mov(b, r(0), m(4, 112)); two(b, "add", r(0), i(1)); mov(b, m(4, 112), r(0)); jump(b, "jmp", p + "_loop");
    lab(b, p + "_new"); mov(b, r(1), r(4)); two(b, "add", r(1), i(72)); mov(b, r(2), m(4, 104)); mov(b, r(8), m(4, 56)); call(b, "__tx_store_clone_materialize");
    mov(b, d(0), d(0)); mov(b, r(9), m(4, 64)); mov(b, m(9, 8), r(0)); mov(b, r(10), i(7));
    two(b, "cmp", md(4, 72 + CLONE_OFF_KIND), i(1)); jump(b, "je", p + "_tag"); mov(b, r(10), i(8)); two(b, "cmp", md(4, 72 + CLONE_OFF_KIND), i(2)); jump(b, "je", p + "_tag"); mov(b, r(10), i(10));
    lab(b, p + "_tag"); mov(b, m(9, 0), r(10)); jump(b, "jmp", p + "_return");
    lab(b, p + "_shared"); mov(b, r(1), r(4)); two(b, "add", r(1), i(32)); call(b, "__tx_retain");
    mov(b, r(9), m(4, 64)); mov(b, r(10), m(4, 32)); mov(b, r(11), m(4, 40)); mov(b, m(9, 0), r(10)); mov(b, m(9, 8), r(11));
    lab(b, p + "_return"); two(b, "add", r(4), i(120)); ret(b);
    lab(b, p + "_depth"); mov(b, r(1), m(4, 56)); call(b, "__tx_store_clone_depth");
    lab(b, p + "_oom"); jump(b, "jmp", "__tx_str_oom");
}
