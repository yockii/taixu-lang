import { socketAddressScoped } from "./net_socket_addr";

declare function lxSocket(family: int, kind: int, protocol: int): int from syscall "socket";
declare function lxClose(socket: int): int from syscall "close";
declare function lxConnect(socket: int, address: Bytes, length: int): int from syscall "connect";
declare function lxRecv(socket: int, data: Bytes, length: int, flags: int, address: int, addressLength: int): int from syscall "recvfrom";
declare function lxSend(socket: int, data: Bytes, length: int, flags: int, address: int, addressLength: int): int from syscall "sendto";
declare function lxPpoll(descriptors: Bytes, count: int, timeout: Bytes, mask: int, maskSize: int): int from syscall "ppoll";
declare function lxGetsockopt(socket: int, level: int, option: int, value: Bytes, length: Bytes): int from syscall "getsockopt";

export function sysByteOpen(version: int, datagram: bool): int {
    let family = 2; if (version == 6) { family = 10; } let kind = 1; if (datagram) { kind = 2; }
    return lxSocket(family, kind | 526336, 0);
}
export function sysByteClose(socket: int): void { lxClose(socket); }
export function sysByteConnect(socket: int, ip: Bytes, port: int, scope: int): int {
    const address = socketAddressScoped(ip, port, 10, false, scope) catch (e) { return -22; };
    const result = lxConnect(socket, address, bytesLen(address));
    if (result == -115 || result == -114 || result == -4) { return 1; } if (result == -106) { return 0; } return result;
}
function ioResult(result: int): int { if (result == -11 || result == -4) { return -2; } return result; }
export function sysByteRead(socket: int, data: Bytes): int { return ioResult(lxRecv(socket, data, bytesLen(data), 0, 0, 0)); }
export function sysByteWrite(socket: int, data: Bytes): int { return ioResult(lxSend(socket, data, bytesLen(data), 16384, 0, 0)); }
export function sysBytePoll(socket: int, writable: bool, timeoutMs: int): int {
    const descriptor = bytesNew(8); bytesSetLE<i32>(descriptor, 0, socket as i32);
    let event = 1; if (writable) { event = 4; } bytesSetLE<i16>(descriptor, 4, event as i16);
    const time = bytesNew(16); bytesSetLE<i64>(time, 0, timeoutMs / 1000); bytesSetLE<i64>(time, 8, (timeoutMs % 1000) * 1000000);
    const result = lxPpoll(descriptor, 1, time, 0, 8);
    if (result == -4) { return 0; } if (result < 0) { return result; }
    if ((((bytesGetLE<i16>(descriptor, 6) catch (32 as i16)) as int) & 32) != 0) { return -9; }
    if (result > 0) { return 1; } return 0;
}
export function sysByteError(socket: int): int {
    const error = bytesNew(4); const length = bytesNew(4); bytesSetLE<u32>(length, 0, 4 as u32);
    const result = lxGetsockopt(socket, 1, 4, error, length);
    if (result < 0) { return result; } return (bytesGetLE<i32>(error, 0) catch (-1 as i32)) as int;
}
