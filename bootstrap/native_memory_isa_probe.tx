import { Operand, StructuredBuffer, assembleText, asImgText, asFailedAs, asLastErrAs, asBufferNew, asBufferInstruction, asBufferSubmit, asStructuredBegin, asStructuredMissing, asStructuredReg, asStructuredTarget } from "./selfhost/assemble";

function byteCheck(bytes: Bytes, at: int, value: int): void {
    assert((bytesGet(bytes, at) catch -1) == value, "native byte encoding differs");
}

function instruction(buf: Ref<StructuredBuffer>, name: string, count: int, first: Ref<Operand>): void {
    const missing = asStructuredMissing();
    asBufferInstruction(buf, name, count, first, missing, missing, 1);
}

function main(args: []string): int {
    assembleText(".text\ncld\nrep movsb\nrep stosb\nud2\n");
    assert(asFailedAs() == 0, "text byte instructions rejected");
    const text = asImgText();
    assert(bytesLen(text) == 7, "text byte instruction length");
    byteCheck(text, 0, 252); byteCheck(text, 1, 243); byteCheck(text, 2, 164);
    byteCheck(text, 3, 243); byteCheck(text, 4, 170); byteCheck(text, 5, 15); byteCheck(text, 6, 11);
    const buf = asBufferNew();
    instruction(buf, "cld", 0, asStructuredMissing());
    instruction(buf, "rep", 1, asStructuredTarget("movsb"));
    instruction(buf, "rep", 1, asStructuredTarget("stosb"));
    instruction(buf, "ud2", 0, asStructuredMissing());
    asStructuredBegin(); asBufferSubmit(buf);
    assert(asFailedAs() == 0, "structured byte instructions rejected");
    const structured = asImgText();
    assert(bytesLen(structured) == 7 && bytesLen(text) == 7, "structured byte instruction length");
    let i = 0;
    while (i < bytesLen(text)) {
        assert((bytesGet(text, i) catch -1) == (bytesGet(structured, i) catch -2), "text/structured bytes differ");
        i = i + 1;
    }
    const invalid: List<string> = listNew();
    listPush(invalid, "cld rax"); listPush(invalid, "ud2 rax");
    listPush(invalid, "rep"); listPush(invalid, "rep rax");
    listPush(invalid, "rep 0"); listPush(invalid, "rep movsb, rax");
    i = 0;
    while (i < listLen(invalid)) {
        assembleText(".text\n" + (listGet(invalid, i) catch "") + "\n");
        assert(asFailedAs() == 1 && asLastErrAs() == "BadOperand", "invalid operand accepted");
        assert(bytesLen(asImgText()) == 0, "invalid instruction emitted bytes");
        i = i + 1;
    }
    assembleText(".text\nrep cmpsb\n");
    assert(asFailedAs() == 1 && asLastErrAs() == "BadInstruction", "unsupported REP opcode accepted");
    const bad = asBufferNew();
    instruction(bad, "cld", 1, asStructuredReg(0, 0));
    asStructuredBegin(); asBufferSubmit(bad);
    assert(asFailedAs() == 1 && asLastErrAs() == "BadOperand" && bytesLen(asImgText()) == 0, "structured invalid operands accepted");
    asStructuredBegin(); asBufferSubmit(buf);
    assert(asFailedAs() == 0 && bytesLen(asImgText()) == 7, "failure poisoned retained native buffer");
    print("PASS_NATIVE_BYTE_ISA_TEXT_STRUCTURED_OWNERSHIP_AND_REJECTIONS");
    return 0;
}
