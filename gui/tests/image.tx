// image ——：BMP 引擎侧通道——load→维度→drawImage
//（部分可见/完全出界判界）→sha 确定性锚→释放。
import { Canvas, canvasNew, tryImage, drawImage, imageDispose } from "gui/components";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256 } from "gui/surface";

export function main(args: []string): int {
    args;
    const surface = surfaceOpen(40, 30) catch (e) {
        print(e.message);
        return 1;
    };
    surfaceClear(surface, 0xE8E8F0);
    const img = tryImage("tests/img/sample.bmp", 4, 3) catch (e) {
        print(e.message);
        surfaceClose(surface);
        return 1;
    };
    print("img " + toStr(img.w) + "x" + toStr(img.h));
    const cv = canvasNew(surface, 40, 30);
    drawImage(cv, img);
    // 部分可见（右下越界——引擎边界裁剪）。
    img.x = 36;
    img.y = 20;
    drawImage(cv, img);
    // 完全出界（Canvas 判界跳过——不触引擎）。
    img.x = 100;
    img.y = 100;
    drawImage(cv, img);
    print("sha=" + surfaceSha256(surface));
    imageDispose(img);
    surfaceClose(surface);
    return 0;
}
