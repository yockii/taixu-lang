// D3 v0.51 §6.10-2：List、数组、切片的双变量 for-in (i, x)——下标与元素；Map 照旧为（键, 值）。
// range(n)／range(a, b) 只作 for-in 的迭代对象：解糖为计数循环、不分配，实参各求值一次、自左向右，a ≥ b 时一次也不执行；
// 循环体改动实参用到的变量不影响次数；break／continue 照常。
function twice(g: () => int): int {
    return g() * 2;
}

export function main(args: []string): int {
    const xs: List<string> = ["a", "b", "c"];
    let line = "";
    for (i, x in xs) { line = line + toStr(i) + x; }
    const arr: [3]int = [7, 8, 9];
    for (i, v in arr) { line = line + "|" + toStr(i) + ":" + toStr(v); }
    const sl: []int = [5, 6];
    for (i, v in sl) { line = line + "/" + toStr(i * 10 + v); }
    const m: Map<string, int> = mapNew();
    mapSet(m, "k", 1);
    for (k, v in m) { line = line + " " + k + toStr(v); }
    print(line);
    let s = 0;
    for (i in range(5)) { s += i; }
    for (i in range(10, 13)) { s += i; }
    for (i in range(3, 1)) { s += 1000; }
    for (i in range(10)) {
        if (i == 2) { continue; }
        if (i == 4) { break; }
        s += 100;
    }
    let n = 3;
    for (i in range(n)) {
        n = 10;
        s += 1;
    }
    for (i in range(twice((): int => 1))) { s += 1; }
    for (i in range(2)) {
        for (j in range(i, 3)) { s += 10000; }
    }
    print(toStr(s));
    return 0;
}
