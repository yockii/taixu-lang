// ELF64 x86-64 静态映像直写；输入来自真实 assemble 四节/符号/修补协议。
import { asImgText, asImgRdata, asImgData, asImgBssSize, asImgAlignPow, asFailedAs, asSymCountL, asSymIndexL, asSymSecL, asSymOffL, asFixCountL, asFixSecL, asFixAtL, asFixKindL, asFixSymL, asFixAddendL } from "./assemble";

const BASE: int = 4194304;
const PAGE: int = 4096;
let output: List<int> = listNew();
let failure: string = "";
let offsets: List<int> = listNew();
let sizes: List<int> = listNew();

function reject(message: string): int {
    failure = message;
    output = listNew();
    return 1;
}

function alignUp(value: int, alignment: int): int {
    return ((value + alignment - 1) / alignment) * alignment;
}

function emit(value: int, width: int): void {
    let i = 0;
    while (i < width) {
        listPush(output, (value >>> (i * 8)) & 255);
        i = i + 1;
    }
}

function patch(at: int, value: int, width: int): void {
    let i = 0;
    while (i < width) {
        listSet(output, at + i, (value >>> (i * 8)) & 255);
        i = i + 1;
    }
}

function padTo(at: int): void {
    while (listLen(output) < at) { listPush(output, 0); }
}

function append(data: Bytes): void {
    let i = 0;
    while (i < bytesLen(data)) {
        listPush(output, bytesGet(data, i) catch 0);
        i = i + 1;
    }
}

function segment(kind: int, flags: int, off: int, fileSize: int, memSize: int, alignment: int): void {
    emit(kind, 4); emit(flags, 4); emit(off, 8);
    emit(BASE + off, 8); emit(BASE + off, 8);
    emit(fileSize, 8); emit(memSize, 8); emit(alignment, 8);
}

function symbolAddress(index: int): int {
    const section = asSymSecL(index);
    const off = asSymOffL(index);
    if (section < 0 || section > 3 || off < 0) { return -1; }
    if (off > (listGet(sizes, section) catch 0)) { return -1; }
    return BASE + (listGet(offsets, section) catch 0) + off;
}

export function linkElfImage(entry: string): int {
    output = listNew(); failure = ""; offsets = listNew(); sizes = listNew();
    if (asFailedAs() != 0) { return reject("AssemblerFailed"); }
    const text = asImgText(); const rodata = asImgRdata(); const data = asImgData();
    const bss = asImgBssSize();
    if (bss < 0 || bss > 4294967295) { return reject("BadBssSize"); }
    const alignments: List<int> = listNew();
    let sec = 0;
    while (sec < 4) {
        const power = asImgAlignPow(sec);
        if (power < 0 || power > 20) { return reject("UnsupportedSectionAlignment"); }
        listPush(alignments, 1 << power);
        sec = sec + 1;
    }
    const textOff = alignUp(PAGE, listGet(alignments, 0) catch PAGE);
    const roOff = alignUp(textOff + bytesLen(text), maxAlign(listGet(alignments, 1) catch PAGE));
    const dataOff = alignUp(roOff + bytesLen(rodata), maxAlign(listGet(alignments, 2) catch PAGE));
    const bssOff = alignUp(dataOff + bytesLen(data), listGet(alignments, 3) catch 16);
    listPush(offsets, textOff); listPush(offsets, roOff); listPush(offsets, dataOff); listPush(offsets, bssOff);
    listPush(sizes, bytesLen(text)); listPush(sizes, bytesLen(rodata)); listPush(sizes, bytesLen(data)); listPush(sizes, bss);
    const entryIndex = asSymIndexL(entry);
    if (entryIndex < 0 || asSymSecL(entryIndex) != 0 || asSymOffL(entryIndex) >= bytesLen(text)) {
        return reject("MissingTextEntry");
    }
    const entryAddress = symbolAddress(entryIndex);
    if (entryAddress < 0) { return reject("BadSymbol"); }
    let i = 0;
    while (i < asSymCountL()) {
        if (symbolAddress(i) < 0) { return reject("BadSymbol"); }
        i = i + 1;
    }
    // e_ident: ELF64、little-endian、EV_CURRENT、System V。
    emit(127, 1); emit(69, 1); emit(76, 1); emit(70, 1);
    emit(2, 1); emit(1, 1); emit(1, 1); emit(0, 1); emit(0, 8);
    emit(2, 2); emit(62, 2); emit(1, 4); emit(entryAddress, 8);
    emit(64, 8); emit(0, 8); emit(0, 4);
    emit(64, 2); emit(56, 2); emit(5, 2); emit(0, 2); emit(0, 2); emit(0, 2);
    segment(1, 4, 0, 344, 344, PAGE);
    segment(1, 5, textOff, bytesLen(text), bytesLen(text), maxAlign(listGet(alignments, 0) catch PAGE));
    segment(1, 4, roOff, bytesLen(rodata), bytesLen(rodata), maxAlign(listGet(alignments, 1) catch PAGE));
    segment(1, 6, dataOff, bytesLen(data), bssOff - dataOff + bss, maxAlign(listGet(alignments, 2) catch PAGE));
    // PT_GNU_STACK：零文件/内存跨度，明确 RW 而非 RWX。
    emit(1685382481, 4); emit(6, 4); emit(0, 8); emit(0, 8);
    emit(0, 8); emit(0, 8); emit(0, 8); emit(16, 8);
    padTo(textOff); append(text);
    padTo(roOff); append(rodata);
    padTo(dataOff); append(data);
    i = 0;
    while (i < asFixCountL()) {
        const from = asFixSecL(i); const at = asFixAtL(i); const kind = asFixKindL(i);
        if (from < 0 || from > 2 || at < 0 || (kind != 0 && kind != 1)) { return reject("BadRelocation"); }
        let width = 4;
        if (kind == 1) { width = 8; }
        if (at + width > (listGet(sizes, from) catch 0)) { return reject("BadRelocation"); }
        const targetIndex = asSymIndexL(asFixSymL(i));
        if (targetIndex < 0) { return reject("MissingSymbol:" + asFixSymL(i)); }
        const target = symbolAddress(targetIndex);
        if (target < 0) { return reject("BadSymbol"); }
        const site = (listGet(offsets, from) catch 0) + at;
        const addend = asFixAddendL(i);
        if (kind == 0) {
            const delta = target - (BASE + site + 4);
            // 加法前检查范围，不能先溢出再判断 addend。
            if (addend < -2147483648 - delta || addend > 2147483647 - delta) {
                return reject("RelativeRelocationOutOfRange");
            }
            patch(site, delta + addend, 4);
        } else {
            if (addend < -target || addend > 9223372036854775807 - target) { return reject("AddressRelocationOutOfRange"); }
            patch(site, target + addend, 8);
        }
        i = i + 1;
    }
    return 0;
}

function maxAlign(value: int): int {
    if (value < PAGE) { return PAGE; }
    return value;
}

export function elfBytesOut(): List<int> { return output; }
export function elfLastError(): string { return failure; }
