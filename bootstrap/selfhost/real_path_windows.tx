// 真实路径（Windows）：GetFinalPathNameByHandleW，解开目录联接、符号链接与 SUBST 盘符。导出面同 real_path_linux.tx、
// real_path_macos.tx。local* 内建按组件持有句柄、拒绝路径里的重解析点，启动操作者给的路径只在这里解析一次。
declare type SECURITY_ATTRIBUTES;
declare function CreateFileW(name: wstr, access: u32, share: u32, sa: SECURITY_ATTRIBUTES?, disposition: u32, flags: u32, template: isize): isize from "kernel32";
declare function CloseHandle(h: isize): i32 from "kernel32";
declare function GetFinalPathNameByHandleW(h: isize, buf: Bytes, n: u32, flags: u32): u32 from "kernel32";
declare function WideCharToMultiByte(cp: u32, flags: u32, src: Bytes, n: i32, dst: Bytes, size: i32, def: usize, used: usize): i32 from "kernel32";

// FILE_SHARE_READ｜WRITE｜DELETE；OPEN_EXISTING；FILE_FLAG_BACKUP_SEMANTICS（目录也能打开）。
const SHARE_ALL: int = 7;
const OPEN_EXISTING: int = 3;
const BACKUP_SEMANTICS: int = 33554432;

// 去掉 \\?\ 前缀；网络路径（\\?\UNC\，含网络映射盘）与解析不了的原样返回，由随后的检查报错。
export function realPath(path: string): string {
    const h = CreateFileW(path, 0 as u32, SHARE_ALL as u32, None, OPEN_EXISTING as u32, BACKUP_SEMANTICS as u32, 0);
    if (h == -1 || h == 0) {
        return path;
    }
    const wide = bytesNew(65536);
    const n = GetFinalPathNameByHandleW(h, wide, 32767 as u32, 0 as u32) as int;
    CloseHandle(h);
    if (n <= 0 || n >= 32767) {
        return path;
    }
    const out = bytesNew(n * 3 + 1);
    const m = WideCharToMultiByte(65001 as u32, 0 as u32, wide, n as i32, out, (n * 3 + 1) as i32, 0, 0) as int;
    if (m <= 0) {
        return path;
    }
    const full = bytesToStr(bytesSlice(out, 0, m)) catch path;
    if (byteStarts(full, "\\\\?\\UNC\\")) {
        return path;
    }
    if (byteStarts(full, "\\\\?\\")) {
        return bytesToStr(bytesSlice(bytesFromStr(full), 4, len(full) - 4)) catch path;
    }
    return full;
}

function byteStarts(s: string, prefix: string): bool {
    return len(s) >= len(prefix) && (bytesToStr(bytesSlice(bytesFromStr(s), 0, len(prefix))) catch "") == prefix;
}
