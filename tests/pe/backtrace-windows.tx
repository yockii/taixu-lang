// x86_64-windows 展开信息的运行时核对（scripts/test_pe_image.tx，PE 规范化 P3）：经 FFI 调 RtlCaptureStackBackTrace——Windows 的
// 展开器按 .pdata 逐帧回溯——打印本模块的加载基址与各帧返回地址，由测试按 --map 对到函数。deep 递归四层，调用不是尾调用。
declare function RtlCaptureStackBackTrace(skip: u32, count: u32, frames: Bytes, hash: Bytes): u16 from "kernel32";
declare function GetModuleHandleA(name: usize): usize from "kernel32";

function capture(): int {
    const frames = bytesNew(512);
    const hash = bytesNew(4);
    const got = RtlCaptureStackBackTrace(0, 64, frames, hash) as int;
    print("base " + toStr(GetModuleHandleA(0) as int));
    let i = 0;
    while (i < got) { print("frame " + toStr(bytesGetLE<int>(frames, i * 8) ?? 0)); i = i + 1; }
    return got;
}

function deep(n: int): int {
    if (n > 0) { return deep(n - 1) + 1; }
    return capture();
}

export function main(args: []string): int {
    if (deep(3) > 0) { return 0; }
    return 1;
}
