// Linux 系统调用的名字与号（D3 v0.47 `from syscall "名字"`；B2、B3）：
// 按架构查 syscall_tables.tx 生成的号表，目标上没有的名字给出通用表里的替代调用。号表以内核源码为准（同 Go 的 zsysnum、Zig 的
// std.os.linux.SYS），名字在表里不等于运行的内核有它（如 statx 要 4.11），运行时照旧得 -ENOSYS。号表里有、但该架构的最低内核上
// 没有、别处又自古就有而容易照搬的调用不提供（withheld）：名字形态按没有处理，确要用的写进 _linux_<架构> 文件用
// 数字形态。
import { SYSCALL_KERNEL, syscallTableAarch64, syscallTableLoongarch64, syscallTableRiscv64, syscallTableX86_64 } from "./syscall_tables";

// 最近一次查的架构的号表（同一次编译通常只查一个架构）。
let cacheArch: string = "";
let cacheNames: List<string> = listNew();
let cacheNums: List<int> = listNew();

function tableOf(arch: string): string {
    if (arch == "x86_64") { return syscallTableX86_64(); }
    if (arch == "aarch64") { return syscallTableAarch64(); }
    if (arch == "loongarch64") { return syscallTableLoongarch64(); }
    if (arch == "riscv64") { return syscallTableRiscv64(); }
    return "";
}

function decimal(s: string): int {
    let v: int = 0;
    let i: int = 0;
    while (i < len(s)) {
        v = v * 10 + ((byteAt(s, i) catch 48) - 48);
        i = i + 1;
    }
    return v;
}

// 龙芯 5.19～6.10 的内核没有 fstat、newfstatat（6.11 才补回）；glibc、musl、Go 在龙芯上都只用 statx。
function withheld(arch: string, name: string): bool {
    return arch == "loongarch64" && (name == "fstat" || name == "newfstatat");
}

/// 号表里有、但在 arch 上不提供的 name 的原因（诊断里用）；不是得空串。
export function syscallWithheldWhy(arch: string, name: string): string {
    if (withheld(arch, name)) { return "内核 6.11 才补回，龙芯的最低内核 5.19 上没有；glibc、musl、Go 在龙芯上都只用 statx"; }
    return "";
}

function load(arch: string): void {
    if (arch == cacheArch) { return; }
    cacheArch = arch;
    cacheNames = listNew();
    cacheNums = listNew();
    const t = tableOf(arch);
    if (len(t) == 0) { return; }
    const parts = strSplit(t, " ");
    let i: int = 0;
    while (i + 1 < listLen(parts)) {
        const name = listGet(parts, i) catch "";
        if (!withheld(arch, name)) {
            listPush(cacheNames, name);
            listPush(cacheNums, decimal(listGet(parts, i + 1) catch "0"));
        }
        i = i + 2;
    }
}

/// 号表的内核版本（诊断里写明依据）。
export function syscallKernel(): string { return SYSCALL_KERNEL; }

/// 架构 arch 上名为 name 的系统调用号；没有得 -1。
export function syscallNumber(arch: string, name: string): int {
    load(arch);
    let i: int = 0;
    while (i < listLen(cacheNames)) {
        if ((listGet(cacheNames, i) catch "") == name) { return listGet(cacheNums, i) catch -1; }
        i = i + 1;
    }
    return -1;
}

/// 架构 arch 上号码 nr 的系统调用名；没有得空串。
export function syscallName(arch: string, nr: int): string {
    load(arch);
    let i: int = 0;
    while (i < listLen(cacheNums)) {
        if ((listGet(cacheNums, i) catch -1) == nr) { return listGet(cacheNames, i) catch ""; }
        i = i + 1;
    }
    return "";
}

/// 目标上没有 name 时的替代调用（通用表架构只留 *at、p* 与带标志的新形态）：取第一个在 arch 上存在的；没有得空串。
export function syscallReplacement(arch: string, name: string): string {
    // 每项“旧名 替代 1 [替代 2]”。
    const rows = ["open openat", "creat openat", "stat statx newfstatat", "lstat statx newfstatat", "fstat statx", "newfstatat statx",
        "poll ppoll", "select pselect6", "pause ppoll", "access faccessat2 faccessat", "pipe pipe2", "dup2 dup3", "fork clone",
        "vfork clone", "getrlimit prlimit64", "setrlimit prlimit64", "rename renameat2", "renameat renameat2", "unlink unlinkat",
        "rmdir unlinkat", "mkdir mkdirat", "mknod mknodat", "link linkat", "symlink symlinkat", "readlink readlinkat", "chmod fchmodat",
        "chown fchownat", "lchown fchownat", "utime utimensat", "utimes utimensat", "futimesat utimensat", "getdents getdents64",
        "epoll_create epoll_create1", "epoll_wait epoll_pwait", "inotify_init inotify_init1", "eventfd eventfd2", "signalfd signalfd4",
        "alarm setitimer", "time clock_gettime", "gettimeofday clock_gettime", "getpgrp getpgid", "ustat statfs"];
    for (row in rows) {
        const parts = strSplit(row, " ");
        if ((listGet(parts, 0) catch "") == name) {
            let k: int = 1;
            while (k < listLen(parts)) {
                const alt = listGet(parts, k) catch "";
                if (syscallNumber(arch, alt) >= 0) { return alt; }
                k = k + 1;
            }
            return "";
        }
    }
    return "";
}
