struct Cell { value: int }

function async(f: () => int): int { return f(); }

async function observe(a: Future < int >, b: Future < int >): int {
    const first = await a catch 0;
    const second = await b catch 0;
    print(toStr(first + second));
    return 0;
}

function main(args: []string): int {
    let base = 20;
    const cell = new Cell { value: 2 };
    const a = (async(): int => base + 1) ();
    const b = (async(): int => {
            await sleepMs(0) catch (e) { return -1; };
            return cell.value;
        }) ();
    base = 100;
    cell.value = 22;
    print(toStr(async((): int => 5)));
    observe(a, b);
    return 0;
}
