// 原生验证总控：逐步起子进程，每步打印 START／END 行、末行 STATUS，每步的 stdout 与
// stderr 合写 <运行目录>/<步名>.log，结果进 report.json。正式性能与跨机器验收另跑。
// 用法（在仓库根运行）：taixu run --toolchain scripts/gate.tx --compiler <原生 taixu> [--quick] [--work <目录>] [--stdlib <目录>]
//   [--other-compiler <另一宿主的不动点>] [--baseline-compiler <上一不动点>] [--keep-runs N] [--root <仓库根>]
//   [--only <步名,步名,...>]：补齐报告依赖后按原顺序执行，scope 为 selected-host；不代替完整门。
//   [--jobs N]：有限并发；自举先行，资源与服务时限步骤独占。缺省 1。
// 门由种子编译器运行，只用种子已有的内建（同 Go 的 cmd/dist、Rust 的 bootstrap 由引导工具链运行）；给子进程的环境经 setEnv（D3 v0.42）。
import { absolute, dirOf, exeName, findInPath, finishRunDir, freshRunDir, join, kindOf, list1, nat, nothing, onWindows, parseDigits,
    plus, readBytes, shaOf } from "./build_lib";
import { osRealPath } from "./build_os";
import { capture, linesOf } from "./test_lib";
import { JSON_ARR, JSON_OBJ, JSON_STR, jsonGet, jsonParseStr } from "../bootstrap/selfhost/json_parse";
import { jsonQuote } from "../bootstrap/selfhost/json_text";
import { wireText } from "../bootstrap/selfhost/dbg_wire";
import { GateResult, GateTask, gatePool } from "./gate_pool";
import { STEP_NAMES } from "./gate_steps";

// 每步至多两小时。
const STEP_LIMIT_NS: int = 7200000000000;
// 子进程退出后，后代进程仍占着输出管道时再读这么久，之后不再等（不判失败）。
const DRAIN_NS: int = 30000000000;
// 日志边跑边落盘：距上次至少 2 秒，日志每多 1 MiB 再加 1 秒（整份重写，写盘量至多约每秒 1 MiB）。
const FLUSH_NS: int = 2000000000;
const FLUSH_PER_MIB_NS: int = 1000000000;
// tail 只看日志末尾这么多字节。
const TAIL_BYTES: int = 65536;

// 可选择的顶层步骤；bootstrap 包含 cross-b、cross-d 与 cross-identity。

struct Opts {
    root: string,
    compiler: string,
    work: string,
    stdlib: string,
    gui: string,
    other: string,
    baseline: string,
    quick: bool,
    keepRuns: int,
    requested: List<string>,
    selected: List<string>,
    jobs: int,
    exportCommit: string,
    exportStdlibCommit: string,
    exportGuiCommit: string,
    report: string,
}

// 一次门：当前编译器（自举后换成新的不动点）、本次运行目录与 report.json 的内容（checks 每项为序列化好的对象）。
struct Gate {
    o: Ref<Opts>,
    compiler: string,
    work: string,
    scope: string,
    initialSha: string,
    checks: List<string>,
    completed: List<string>,
    fails: int,
    status: string,
    compilerSha: string,
    started: int,
    queued: bool,
    tasks: List<GateTask>,
}

// 一步的结果：退出码（起不了或超时为 1）与合写的输出。
struct Logged {
    code: int,
    log: Bytes,
}

function usage(msg: string): int {
    eprint(msg);
    eprint("用法：taixu run --toolchain scripts/gate.tx --compiler <原生 taixu> [--quick] [--work <目录>] [--stdlib <目录>]");
    eprint("  [--other-compiler <另一宿主的不动点>] [--baseline-compiler <上一不动点>] [--keep-runs N] [--root <仓库根>]");
    eprint("  [--only <步名,步名,...>]（可用步骤：" + STEP_NAMES + "）");
    eprint("  [--jobs N]（1..64，缺省 1）");
    eprint("  [--export-commit <树或提交>]（缺省 HEAD；用于验证不可变工作树快照）");
    eprint("  [--gui <GUI 根>] [--export-gui-commit <树或提交>]（GUI 导出缺省 HEAD）");
    eprint("  [--export-stdlib-commit <树或提交>]（缺省 HEAD；固定导出所用的标准库源码）");
    eprint("  [--report <文件>]（同时写一份报告，供批次编排读取）");
    return 2;
}

function hasStep(xs: List<string>, name: string): bool {
    for (x in xs) {
        if (x == name) { return true; }
    }
    return false;
}

function needStep(xs: List<string>, name: string): void {
    if (!hasStep(xs, name)) { listPush(xs, name); }
}

function selectSteps(o: Ref<Opts>): void | Error {
    if (listLen(o.requested) == 0) { return nothing(); }
    if (o.quick) { return err("--only 不能与 --quick 同用"); }
    if (hasStep(o.requested, "product-identity") && len(o.baseline) == 0) {
        return err("product-identity 需要 --baseline-compiler");
    }
    if (hasStep(o.requested, "export") && kindOf(join(o.root, "release/export.txt")) != 1) {
        return err("此仓库没有 export 步（缺少 release/export.txt）");
    }
    for (name in o.requested) { needStep(o.selected, name); }
    if (hasStep(o.selected, "bootstrap")) { needStep(o.selected, "build-driver"); }
    if (hasStep(o.selected, "portable-codegen")) {
        needStep(o.selected, "products");
        needStep(o.selected, "leak");
        needStep(o.selected, "instrumented");
    }
    if (hasStep(o.selected, "heap-check") || hasStep(o.selected, "product-identity")) { needStep(o.selected, "products"); }
    const ordered: List<string> = listNew();
    for (name in strSplit(STEP_NAMES, " ")) {
        if (hasStep(o.selected, name)) { listPush(ordered, name); }
    }
    o.selected = ordered;
    return nothing();
}

function wanted(g: Ref<Gate>, name: string): bool {
    if (listLen(g.o.requested) == 0) { return true; }
    if (name == "cross-b" || name == "cross-d") { return hasStep(g.o.selected, "bootstrap"); }
    return hasStep(g.o.selected, name);
}

test "选步展开报告依赖并保持原有执行顺序" {
    const o = parseOpts(["--compiler", "gate-test", "--only", "portable-codegen,heap-check"]) catch (e) { panic(e.message); };
    assert(strArray(o.selected) == "[\"products\", \"leak\", \"instrumented\", \"portable-codegen\", \"heap-check\"]", "语料报告依赖");
    const b = parseOpts(["--compiler", "gate-test", "--only", "bootstrap"]) catch (e) { panic(e.message); };
    assert(strArray(b.selected) == "[\"build-driver\", \"bootstrap\"]", "自举前置检查");
    const p = parseOpts(["--compiler", "gate-test", "--baseline-compiler", "baseline-test", "--only", "product-identity"]) catch (e) { panic(e.message); };
    assert(strArray(p.selected) == "[\"products\", \"product-identity\"]", "产物对照依赖");
}

function invalidSelection(args: []string): bool {
    parseOpts(args) catch (e) { return true; };
    return false;
}

test "选步拒绝错误输入和缺失前置条件" {
    assert(invalidSelection(["--compiler", "gate-test", "--only", ""]), "空集");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "json,"]), "尾部空名");
    assert(invalidSelection(["--compiler", "gate-test", "--only", ",json"]), "首部空名");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "json,,sha256"]), "中间空名");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "jsoon"]), "拼错名字");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "json,json"]), "重复名字");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "json", "--quick"]), "互斥开关");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "product-identity"]), "缺基线");
    assert(invalidSelection(["--compiler", "gate-test", "--only", "cross-d"]), "不能拆开自举一致性检查");
    assert(invalidSelection(["--compiler", "gate-test", "--jobs", "0"]), "并发数不能为零");
    assert(invalidSelection(["--compiler", "gate-test", "--jobs", "65"]), "并发数上限");
    assert(invalidSelection(["--compiler", "gate-test", "--jobs", "two"]), "并发数必须是整数");
}

test "导出分别固定三个源码输入" {
    const explicit = parseOpts(["--compiler", "gate-test", "--only", "json", "--export-commit", "core-tree", "--export-stdlib-commit", "stdlib-tree", "--export-gui-commit", "gui-tree"]) catch (e) { panic(e.message); };
    assert(explicit.exportCommit == "core-tree" && explicit.exportStdlibCommit == "stdlib-tree" && explicit.exportGuiCommit == "gui-tree", "independent source refs");
    const defaults = parseOpts(["--compiler", "gate-test", "--only", "json"]) catch (e) { panic(e.message); };
    assert(defaults.exportCommit == "HEAD" && defaults.exportStdlibCommit == "HEAD" && defaults.exportGuiCommit == "HEAD", "unchanged defaults");
    assert(invalidSelection(["--compiler", "gate-test", "--export-commit", ""]), "empty core ref");
    assert(invalidSelection(["--compiler", "gate-test", "--export-stdlib-commit", ""]), "empty stdlib ref");
    assert(invalidSelection(["--compiler", "gate-test", "--export-gui-commit", ""]), "empty gui ref");
    assert(invalidSelection(["--compiler", "gate-test", "--gui", ""]), "empty gui root");
    assert(invalidSelection(["--compiler", "gate-test", "--report", ""]), "empty report path");
    const gui = parseOpts(["--compiler", "gate-test", "--only", "gui"]) catch (e) { panic(e.message); };
    assert(strArray(gui.selected) == "[\"gui\"]", "GUI can be selected independently");
}

function parseOpts(args: []string): Ref<Opts> | Error {
    const o = new Opts { root: "", compiler: "", work: "", stdlib: "", gui: "", other: "", baseline: "", quick: false, keepRuns: 3,
        requested: listNew(), selected: listNew(), jobs: 1, exportCommit: "HEAD", exportStdlibCommit: "HEAD", exportGuiCommit: "HEAD", report: "" };
    let i: int = 0;
    while (i < len(args)) {
        const a = args[i];
        if (a == "--quick") {
            o.quick = true;
            i = i + 1;
            continue;
        }
        if (i + 1 >= len(args)) {
            return err("缺少取值或未知参数：" + a);
        }
        const v = args[i + 1];
        if (a == "--compiler") {
            o.compiler = v;
        } else if (a == "--report") {
            if (len(v) == 0) { return err("--report 不能为空"); }
            o.report = absolute(v);
        } else if (a == "--export-commit") {
            if (len(v) == 0) { return err("--export-commit 不能为空"); }
            o.exportCommit = v;
        } else if (a == "--export-gui-commit") {
            if (len(v) == 0) { return err("--export-gui-commit 不能为空"); }
            o.exportGuiCommit = v;
        } else if (a == "--gui") {
            if (len(v) == 0) { return err("--gui 不能为空"); }
            o.gui = v;
        } else if (a == "--export-stdlib-commit") {
            if (len(v) == 0) { return err("--export-stdlib-commit 不能为空"); }
            o.exportStdlibCommit = v;
        } else if (a == "--jobs") {
            o.jobs = parseDigits(v);
            if (o.jobs < 1 || o.jobs > 64) { return err("--jobs 须为 1..64：" + v); }
        } else if (a == "--only") {
            const known = strSplit(STEP_NAMES, " ");
            for (name in strSplit(v, ",")) {
                if (len(name) == 0 || !hasStep(known, name)) { return err("未知或空步名：" + name); }
                if (hasStep(o.requested, name)) { return err("重复步名：" + name); }
                listPush(o.requested, name);
            }
            if (len(v) == 0) { return err("--only 需要至少一个步名"); }
        } else if (a == "--work") {
            o.work = v;
        } else if (a == "--stdlib") {
            o.stdlib = v;
        } else if (a == "--other-compiler") {
            o.other = v;
        } else if (a == "--baseline-compiler") {
            o.baseline = v;
        } else if (a == "--root") {
            o.root = v;
        } else if (a == "--keep-runs") {
            o.keepRuns = parseDigits(v);
            if (o.keepRuns < 0) {
                return err("--keep-runs 须为非负整数：" + v);
            }
        } else {
            return err("未知参数：" + a);
        }
        i = i + 2;
    }
    if (len(o.root) == 0) {
        o.root = currentDir() catch ".";
    }
    // 取真实路径：local* 内建拒绝路径里的符号链接（同 build.tx）。
    o.root = osRealPath(absolute(o.root));
    if (kindOf(join(o.root, "scripts/gate.tx")) != 1) {
        return err("不在仓库根：" + o.root + "（请在仓库根运行或给出 --root）");
    }
    if (len(o.compiler) == 0) {
        o.compiler = getEnv("TAIXU_NATIVE") ?? findInPath("taixu");
    }
    if (len(o.compiler) == 0) {
        return err("请给出 --compiler <原生 taixu>（或设环境变量 TAIXU_NATIVE）");
    }
    o.compiler = osRealPath(absolute(o.compiler));
    if (len(o.work) == 0) {
        o.work = join(o.root, "work/native-gate");
    }
    o.work = absolute(o.work);
    if (len(o.stdlib) == 0) {
        // 公开仓 taixu-lang 把标准库并在仓内 stdlib/（设计 v052-public-release §三）；开发仓仍是同级的 taixu-stdlib。
        o.stdlib = join(dirOf(o.root), "taixu-stdlib");
        if (kindOf(join(o.root, "stdlib/verify.tx")) == 1) {
            o.stdlib = join(o.root, "stdlib");
        }
    }
    o.stdlib = osRealPath(absolute(o.stdlib));
    if (len(o.gui) == 0) {
        o.gui = join(dirOf(o.root), "taixu-gui");
        if (kindOf(join(o.root, "gui/verify.tx")) == 1) { o.gui = join(o.root, "gui"); }
    }
    o.gui = osRealPath(absolute(o.gui));
    if (len(o.other) > 0) {
        o.other = osRealPath(absolute(o.other));
    }
    if (len(o.baseline) > 0) {
        o.baseline = osRealPath(absolute(o.baseline));
    }
    selectSteps(o)?;
    return o;
}

// 所选编译器须是原生太虚（capabilities 报 native-tx）。
function checkNative(compiler: string, root: string): void | Error {
    const r = capture(compiler, plus(list1("capabilities"), list1("--format=json")), root, 30000000000, 1048576) catch (e) {
        return e;
    };
    const v = jsonParseStr(r.out) catch (e) {
        return err("读不懂 " + compiler + " capabilities 的输出");
    };
    const caps = jsonGet(v, "capabilities") ?? v;
    const c = jsonGet(caps, "compiler") ?? caps;
    if (r.code != 0 || c.kind != JSON_STR || c.s != "native-tx") {
        return err("所选编译器不是原生太虚：" + compiler);
    }
    return nothing();
}

// ---- 子进程与日志 ----

function flush(path: string, log: Bytes): void {
    writeFileBytes(nat(path), log) catch (e) {};
}

// 在 cwd 里运行一步：stdout 与 stderr 按读到的先后合写 path，边跑边落盘。标准输入接空设备。
// 起不了或超时（STEP_LIMIT_NS）记退出码 1，原因追加在日志末尾。
function logged(exe: string, args: List<string>, cwd: string, path: string): Ref<Logged> {
    const r = new Logged { code: 0, log: bytesNew(0) };
    const h = procSpawn(exe, args, cwd, 0) catch (e) {
        bytesAppend(r.log, bytesFromStr("起不了 " + exe + "：" + e.message + "\n"));
        flush(path, r.log);
        r.code = 1;
        return r;
    };
    const buf = bytesNew(65536);
    const start = monoNs();
    let flushedAt: int = start;
    let flushedLen: int = 0;
    let timedOut: bool = false;
    let outOpen: bool = true;
    let errOpen: bool = true;
    let ended: bool = false;
    let endedAt: int = 0;
    let abandoned: bool = false;
    while (true) {
        if (!ended) {
            const w = procWait(h, 0);
            if (w != None) {
                r.code = w ?? -1;
                ended = true;
                endedAt = monoNs();
            }
        }
        const now = monoNs();
        if (!ended && !timedOut && now - start >= STEP_LIMIT_NS) {
            timedOut = true;
            procKill(h);
        }
        if (ended && !outOpen && !errOpen) {
            break;
        }
        if (ended && now - endedAt >= DRAIN_NS) {
            abandoned = true;
            break;
        }
        let mask: int = 0;
        if (outOpen) {
            mask = mask | 2;
        }
        if (errOpen) {
            mask = mask | 4;
        }
        if (mask == 0) {
            const waited = procWait(h, 100);
            continue;
        }
        const ready = ioWait(h, mask, 100);
        if ((ready & 2) != 0) {
            const n = procRead(h, 1, buf);
            if (n < 0) {
                outOpen = false;
            } else if (n > 0) {
                bytesAppend(r.log, bytesSlice(buf, 0, n));
            }
        }
        if ((ready & 4) != 0) {
            const n = procRead(h, 2, buf);
            if (n < 0) {
                errOpen = false;
            } else if (n > 0) {
                bytesAppend(r.log, bytesSlice(buf, 0, n));
            }
        }
        const size = bytesLen(r.log);
        if (size != flushedLen && now - flushedAt >= FLUSH_NS + size / 1048576 * FLUSH_PER_MIB_NS) {
            flush(path, r.log);
            flushedAt = now;
            flushedLen = size;
        }
    }
    procClose(h);
    if (timedOut) {
        bytesAppend(r.log, bytesFromStr("超时：" + toStr(STEP_LIMIT_NS / 1000000000) + " 秒后结束了子进程\n"));
        r.code = 1;
    }
    if (abandoned) {
        bytesAppend(r.log, bytesFromStr("子进程已退出，后代进程仍占着输出管道；" + toStr(DRAIN_NS / 1000000000) + " 秒后不再读取\n"));
    }
    flush(path, r.log);
    return r;
}

// 日志的末 n 行（非法 UTF-8 换成 U+FFFD）。
function tailLines(log: Bytes, n: int): List<string> {
    let from: int = 0;
    if (bytesLen(log) > TAIL_BYTES) {
        from = bytesLen(log) - TAIL_BYTES;
    }
    const lines = linesOf(wireText(bytesSlice(log, from, bytesLen(log) - from)));
    const out: List<string> = listNew();
    let i: int = listLen(lines) - n;
    if (i < 0) {
        i = 0;
    }
    while (i < listLen(lines)) {
        listPush(out, listGet(lines, i) catch "");
        i = i + 1;
    }
    return out;
}

// ---- report.json ----

function strArray(xs: List<string>): string {
    let s = "[";
    let first: bool = true;
    for (x in xs) {
        if (!first) {
            s = s + ", ";
        }
        s = s + jsonQuote(x);
        first = false;
    }
    return s + "]";
}

function record(g: Ref<Gate>, row: string, ok: bool): void {
    listPush(g.checks, row);
    if (!ok) {
        g.fails = g.fails + 1;
    }
}

// 字段依次为 scope、host、initial_compiler_sha256、other_host_reference、checks、status 与 compiler_sha256；每项检查占一行。
// compiler_sha256 是最后用来跑各步的编译器：跑了自举时是新的不动点，没跑（--quick、--only 不含 bootstrap）时即起始编译器。
function save(g: Ref<Gate>): void {
    let other = "not supplied";
    if (len(g.o.other) > 0) {
        other = "provided";
    }
    let s = "{\n  \"scope\": " + jsonQuote(g.scope) + ",\n  \"host\": " + jsonQuote(hostTarget()) + ",\n  \"initial_compiler_sha256\": "
    + jsonQuote(g.initialSha) + ",\n  \"other_host_reference\": " + jsonQuote(other) + ",\n  \"checks\": [";
    let first: bool = true;
    for (row in g.checks) {
        if (first) {
            s = s + "\n    " + row;
        } else {
            s = s + ",\n    " + row;
        }
        first = false;
    }
    s = s + "\n  ],\n  \"status\": " + jsonQuote(g.status);
    s = s + ",\n  \"elapsed_ms\": " + toStr((monoNs() - g.started) / 1000000);
    s = s + ",\n  \"jobs\": " + toStr(g.o.jobs);
    s = s + ",\n  \"export_commit\": " + jsonQuote(g.o.exportCommit);
    s = s + ",\n  \"export_stdlib_commit\": " + jsonQuote(g.o.exportStdlibCommit);
    s = s + ",\n  \"export_gui_commit\": " + jsonQuote(g.o.exportGuiCommit);
    if (listLen(g.o.requested) > 0) {
        const omitted: List<string> = listNew();
        for (name in strSplit(STEP_NAMES, " ")) {
            if (!hasStep(g.completed, name)) { listPush(omitted, name); }
        }
        s = s + ",\n  \"requested_steps\": " + strArray(g.o.requested) + ",\n  \"selected_steps\": " + strArray(g.o.selected)
        + ",\n  \"not_run_steps\": " + strArray(omitted);
    }
    if (len(g.compilerSha) > 0) {
        s = s + ",\n  \"compiler_sha256\": " + jsonQuote(g.compilerSha);
    }
    s = s + ",\n  \"compiler\": " + jsonQuote(g.compiler);
    writeFile(join(g.work, "report.json"), s + "\n}\n") catch (e) {};
    if (len(g.o.report) > 0) {
        writeFile(g.o.report, s + "\n}\n") catch (e) { g.fails = g.fails + 1; eprint("写不了批次报告：" + e.message); };
    }
}

// ---- 步 ----

function run(g: Ref<Gate>, name: string, exe: string, args: List<string>): bool {
    return runCwd(g, name, exe, args, g.o.root);
}

function runCwd(g: Ref<Gate>, name: string, exe: string, args: List<string>, cwd: string): bool {
    if (!wanted(g, name)) { return true; }
    if (g.queued) {
        const deps: List<string> = listNew();
        if (name == "portable-codegen") { listPush(deps, "leak"); listPush(deps, "instrumented"); }
        const exclusive = hasStep(strSplit("cli toolchain-contract console capacity debug-vars debug-stub debug dap mcp lsp check-cache lsp-cache service-sequence lsp-resources lsp-readonly lsp-builtins stdlib gui", " "), name);
        listPush(g.tasks, GateTask { name: name, exe: exe, args: args, cwd: cwd, deps: deps, exclusive: exclusive });
        return true;
    }
    print("START " + name);
    const started = monoNs();
    const r = logged(exe, args, cwd, join(g.work, name + ".log"));
    const elapsed = (monoNs() - started) / 1000000;
    finished(g, name, exe, args, r.code, r.log, elapsed);
    return r.code == 0;
}

function finished(g: Ref<Gate>, name: string, exe: string, args: List<string>, code: int, log: Bytes, elapsed: int): void {
    listPush(g.completed, name);
    const tail = tailLines(log, 4);
    record(g, "{\"name\": " + jsonQuote(name) + ", \"exit\": " + toStr(code) + ", \"argv\": " + strArray(plus(list1(exe), args))
        + ", \"tail\": " + strArray(tail) + ", \"elapsed_ms\": " + toStr(elapsed) + "}", code == 0);
    save(g);
    let text = "";
    for (line in tail) {
        if (len(text) > 0) {
            text = text + "\n";
        }
        text = text + line;
    }
    print("END " + name + " " + toStr(code) + " " + text);
}

function drainTasks(g: Ref<Gate>): void {
    gatePool(g.tasks, g.o.jobs, g.work, g.completed, STEP_LIMIT_NS, DRAIN_NS, (name: string, r: Ref<GateResult>): void => {
            for (task in g.tasks) {
                if (task.name == name) { finished(g, name, task.exe, task.args, r.code, r.log, r.elapsedMs); return; }
            }
        });
    g.tasks = listNew();
}

// 太虚写的门步：taixu run --toolchain scripts/<script>.tx --compiler <当前编译器> 再加 flags。
function txGate(g: Ref<Gate>, name: string, script: string, flags: List<string>): bool {
    const args = plus(args3("run", "--toolchain", nat(join(g.o.root, "scripts/" + script + ".tx"))), args2("--compiler", g.compiler));
    return run(g, name, g.compiler, plus(args, flags));
}

function at(g: Ref<Gate>, rel: string): string {
    return nat(join(g.work, rel));
}

function work(g: Ref<Gate>, name: string): List<string> {
    return plus(list1("--work"), list1(at(g, name)));
}

function args2(a: string, b: string): List<string> {
    return plus(list1(a), list1(b));
}

function args3(a: string, b: string, c: string): List<string> {
    return plus(args2(a, b), list1(c));
}

// ---- 产物对照 ----

function strLess(a: string, b: string): bool {
    const x = bytesFromStr(a);
    const y = bytesFromStr(b);
    let i: int = 0;
    while (i < bytesLen(x) && i < bytesLen(y)) {
        const c = bytesGet(x, i) ?? 0;
        const d = bytesGet(y, i) ?? 0;
        if (c != d) {
            return c < d;
        }
        i = i + 1;
    }
    return bytesLen(x) < bytesLen(y);
}

// 按字节序（即码点序，同 Python 的 sorted）。
function sorted(xs: List<string>): List<string> {
    const out: List<string> = listNew();
    for (x in xs) {
        let k: int = listLen(out);
        while (k > 0 && strLess(x, listGet(out, k - 1) catch "")) {
            k = k - 1;
        }
        listInsert(out, k, x);
    }
    return out;
}

// 产物报告里各用例的 product_sha256；读不了为空表。
function hashes(path: string): Map<string, string> {
    const m: Map<string, string> = mapNew();
    const text = readFile(path) catch (e) {
        return m;
    };
    const v = jsonParseStr(text) catch (e) {
        return m;
    };
    const rows = jsonGet(v, "rows") ?? v;
    if (rows.kind != JSON_ARR) {
        return m;
    }
    for (row in rows.items) {
        if (row.kind == JSON_OBJ) {
            const c = jsonGet(row, "case") ?? row;
            const h = jsonGet(row, "product_sha256") ?? row;
            if (c.kind == JSON_STR && h.kind == JSON_STR) {
                mapSet(m, c.s, h.s);
            }
        }
    }
    return m;
}

// 新旧编译器产物逐字节比较。变化可能是有意的（改了代码生成或内核），所以不判失败；名单进报告，提交须逐一解释。
// 内核变了时几乎全部产物都不同。
function productIdentity(g: Ref<Gate>): void {
    if (!wanted(g, "product-identity")) { return; }
    print("START product-identity");
    const started = monoNs();
    const path = join(g.work, "products-baseline.json");
    // 语料运行器由当前编译器编出，被比较的是基线编译器编出的产物。
    const runner = plus(args3("run", "--toolchain", nat(join(g.o.root, "scripts/test_nrt_products.tx"))),
        plus(args2("--compiler", g.o.baseline), list1("--build-only")));
    const r = logged(g.compiler, plus(runner, plus(work(g, "products-baseline"), args2("--report", nat(path)))), g.o.root,
        join(g.work, "products-baseline.log"));
    const old = hashes(path);
    const cur = hashes(join(g.work, "products.json"));
    const oldKeys = sorted(mapKeys(old));
    const curKeys = sorted(mapKeys(cur));
    const both: List<string> = listNew();
    const differing: List<string> = listNew();
    const onlyBaseline: List<string> = listNew();
    const onlyCandidate: List<string> = listNew();
    for (k in oldKeys) {
        if (mapHas(cur, k)) {
            listPush(both, k);
            if ((mapGet(old, k) ?? "") != (mapGet(cur, k) ?? "")) {
                listPush(differing, k);
            }
        } else {
            listPush(onlyBaseline, k);
        }
    }
    for (k in curKeys) {
        if (!mapHas(old, k)) {
            listPush(onlyCandidate, k);
        }
    }
    const same = listLen(both) - listLen(differing);
    listPush(g.completed, "product-identity");
    record(g, "{\"name\": \"product-identity\", \"exit\": 0, \"baseline_mode\": \"build-only\", \"baseline_sha256\": " + jsonQuote(shaOf(g.o.baseline)) + ", \"compared\": "
        + toStr(listLen(both)) + ", \"identical\": " + toStr(same) + ", \"differing\": " + strArray(differing) + ", \"only_candidate\": "
        + strArray(onlyCandidate) + ", \"only_baseline\": " + strArray(onlyBaseline) + ", \"elapsed_ms\": "
        + toStr((monoNs() - started) / 1000000) + "}", true);
    save(g);
    print("END product-identity 0\n比较 " + toStr(listLen(both)) + " 个产物：相同 " + toStr(same) + "，不同 " + toStr(listLen(differing))
        + "；只有新编译器编出 " + toStr(listLen(onlyCandidate)) + "，只有基线编出 " + toStr(listLen(onlyBaseline)));
}

// ---- 自举与交叉一致性 ----

// 自举由太虚写的构建驱动完成：种子编译器编出并运行它。失败时门到此为止。
function bootstrap(g: Ref<Gate>): bool {
    if (!wanted(g, "bootstrap")) { return true; }
    const root = g.o.root;
    const args = plus(args3("run", "--toolchain", nat(join(root, "scripts/build.tx"))), args2("--root", root));
    if (!run(g, "bootstrap", g.compiler, plus(plus(args, args2("--compiler", g.compiler)),
                plus(work(g, "build"), args2("--out", at(g, "compiler")))))) {
        return false;
    }
    g.compiler = at(g, "compiler/" + exeName("taixu"));
    setEnv("TAIXU_NATIVE", g.compiler) catch (e) {
        eprint("设不了 TAIXU_NATIVE：" + e.message);
    };
    // build.json 的 work 指向构建工作目录，其中 bootstrap/b 是嵌入新内核的 B；读不了时 cross-b 起不来、记失败。
    let b = "";
    const text = readFile(join(g.work, "compiler/build.json")) catch "";
    const manifest = jsonParseStr(text) catch (e) {
        return crossIdentity(g, b);
    };
    const w = jsonGet(manifest, "work") ?? manifest;
    if (w.kind == JSON_STR) {
        b = nat(join(join(w.s, "bootstrap/b"), exeName("taixu")));
    }
    return crossIdentity(g, b);
}

// B 与 D 交叉编出另一端的编译器，两份须逐字节相同；给了 --other-compiler 时还须等于另一宿主的不动点。
function crossIdentity(g: Ref<Gate>, b: string): bool {
    let target = "windows";
    if (onWindows()) {
        target = "linux";
    }
    let product = "taixu";
    if (target == "windows") {
        product = "taixu.exe";
    }
    const sums: List<string> = listNew();
    const names = plus(list1("cross-b"), list1("cross-d"));
    const builders = plus(list1(b), list1(g.compiler));
    let i: int = 0;
    while (i < 2) {
        const name = listGet(names, i) catch "";
        const dest = at(g, name);
        const ok = run(g, name, listGet(builders, i) catch "", plus(args3("build", "bootstrap/taixu.tx", "--toolchain"),
                args3("--target=" + target, "--out", dest)));
        const out = join(dest, product);
        if (ok && kindOf(out) == 1) {
            listPush(sums, shaOf(out));
        } else {
            listPush(sums, "");
        }
        i = i + 1;
    }
    const comparedAt = monoNs();
    const first = listGet(sums, 0) catch "";
    const second = listGet(sums, 1) catch "";
    let same: bool = len(first) > 0 && first == second;
    if (len(g.o.other) > 0) {
        same = same && second == shaOf(g.o.other);
    }
    let shown = "[";
    for (h in sums) {
        if (len(shown) > 1) {
            shown = shown + ", ";
        }
        if (len(h) == 0) {
            shown = shown + "null";
        } else {
            shown = shown + jsonQuote(h);
        }
    }
    let code: int = 1;
    if (same) {
        code = 0;
    }
    record(g, "{\"name\": \"cross-identity\", \"exit\": " + toStr(code) + ", \"hashes\": " + shown + "], \"elapsed_ms\": "
        + toStr((monoNs() - comparedAt) / 1000000) + "}", same);
    g.compilerSha = shaOf(g.compiler);
    save(g);
    return true;
}

// ---- 门 ----

function steps(g: Ref<Gate>): int {
    const root = g.o.root;
    run(g, "gate-selftest", g.compiler, args3("test", "--toolchain", nat(join(root, "scripts/gate.tx"))));
    txGate(g, "gate-pool", "test_gate_pool", work(g, "gate-pool"));
    txGate(g, "gate-batch", "test_gate_batch", work(g, "gate-batch"));
    if (!g.o.quick) {
        // 构建驱动的自检（太虚写）：解 tar 的拒绝规则、运行目录修剪（原 run-retention 步的用例在此）等 bootstrap 步走不到的部分。
        run(g, "build-driver", g.compiler, args3("run", "--toolchain", nat(join(root, "scripts/build_selftest.tx"))));
        if (!bootstrap(g)) {
            g.status = "FAIL";
            save(g);
            return 1;
        }
    }
    txGate(g, "products", "test_nrt_products", plus(work(g, "products"), args2("--report", at(g, "products.json"))));
    if (len(g.o.baseline) > 0) {
        productIdentity(g);
    }
    g.queued = g.o.jobs > 1;
    txGate(g, "cli", "test_native_cli", args2("--report", at(g, "cli.json")));
    txGate(g, "fmt", "test_native_fmt", args2("--report", at(g, "fmt.json")));
    txGate(g, "toolchain-contract", "test_toolchain_contract", work(g, "toolchain-contract"));
    txGate(g, "asm-output", "test_native_asm_output", work(g, "asm-output"));
    txGate(g, "a64-encodings", "test_a64_encodings", work(g, "a64-encodings"));
    txGate(g, "a64-image", "test_a64_image", work(g, "a64-image"));
    // 龙芯编码表：编码函数与反汇编器对两家汇编器生成的表双向核对；太虚写的门步。
    run(g, "la64-encodings", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_la64_encodings.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "la64-encodings"))));
    // 龙芯写出链路：手写两对象经 ELF 对象与链接器写成静态可执行文件；龙芯宿主或 TAIXU_QEMU_LOONGARCH64 下运行。
    // 写出链路与编译器自举两种步按目标参数化（scripts/test_arch_image.tx、test_arch_bootstrap.tx），龙芯与 RISC-V 共用。
    run(g, "la64-image", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_arch_image.tx"))),
            plus(plus(args2("--compiler", g.compiler), args2("--target", "loongarch64-linux")), work(g, "la64-image"))));
    // 龙芯编译器：交叉编出、两次逐字节相同；龙芯宿主或 TAIXU_QEMU_LOONGARCH64 下由它自举，须是不动点。
    run(g, "la64-bootstrap", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_arch_bootstrap.tx"))),
            plus(plus(args2("--compiler", g.compiler), args2("--target", "loongarch64-linux")), work(g, "la64-bootstrap"))));
    // RISC-V 编码表：编码函数与反汇编器对两家汇编器生成的表双向核对；太虚写的门步。
    run(g, "rv64-encodings", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_rv64_encodings.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "rv64-encodings"))));
    // RISC-V 写出链路：手写两对象经 ELF 对象与链接器写成静态可执行文件；RISC-V 宿主或 TAIXU_QEMU_RISCV64 下运行。
    run(g, "rv64-image", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_arch_image.tx"))),
            plus(plus(args2("--compiler", g.compiler), args2("--target", "riscv64-linux")), work(g, "rv64-image"))));
    // RISC-V 编译器：交叉编出、两次逐字节相同；RISC-V 宿主或 TAIXU_QEMU_RISCV64 下由它自举，须是不动点。
    run(g, "rv64-bootstrap", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_arch_bootstrap.tx"))),
            plus(plus(args2("--compiler", g.compiler), args2("--target", "riscv64-linux")), work(g, "rv64-bootstrap"))));
    // 交叉产物（目标分层 4.1）：scripts/targets.tx 里本宿主以外的每个目标，全量语料只构建、只核对构建结果——Mach-O 产物另过独立的
    // macho_check，aarch64-windows 的另过独立的 PE 核对器（头、导入、基址重定位、TLS、展开信息）；loongarch64、riscv64 随后一批补齐的
    // 外部函数回调、按值结构体记 PENDING。本宿主的目标由 products 步构建并运行；别的目标的实际运行另记（qemu-user，TAIXU_QEMU_*；
    // M1；Windows ARM64 测试机）。代替原先按目标各开一步的 a64-products 等五步。
    txGate(g, "cross-products", "test_cross_products", work(g, "cross-products"));
    // aarch64-windows 写出链路：手写两对象小程序经 PE 外壳链接；任何宿主上核头与确定性，Windows ARM64 宿主上运行。
    run(g, "a64-windows-image", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_a64w_image.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "a64-windows-image"))));
    // aarch64-windows 编译器：交叉编出、两次逐字节相同、PE 头合乎 ARM64；Windows ARM64 宿主上由它自举，须是不动点。
    run(g, "a64-windows-bootstrap", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_a64w_bootstrap.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "a64-windows-bootstrap"))));
    // PE 头部约定（x86_64-windows PE 规范化）：任何宿主上交叉编出 x86_64-windows 与 aarch64-windows 的小程序，核头部字段、内容哈希
    // 时间戳与校验和、两次逐字节相同；x86_64 Windows 宿主上再运行。
    run(g, "pe-image", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_pe_image.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "pe-image"))));
    // 运行时按需链入（docs/design/v052-runtime-on-demand-link-v0.2-20261108.md）：函数块探针与它链出的小 PE 逐字节核对、x86_64-windows
    // 导入面黄金表（任何宿主上交叉编出）；x86_64 Windows 宿主上再运行样例。太虚写的门步。
    run(g, "on-demand-link", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_on_demand_link.tx"))),
            plus(args2("--compiler", g.compiler), work(g, "on-demand-link"))));
    txGate(g, "compile-profile", "test_native_compile_profile", work(g, "compile-profile"));
    txGate(g, "program-regalloc", "test_program_regalloc", work(g, "program-regalloc"));
    txGate(g, "link-map", "test_native_link_map", work(g, "link-map"));
    // 对象与函数元数据的结构化 fuzz（安全审查攻关第 3 项）：逐例受限进程，标准与页堆两个链接探针。
    txGate(g, "object-fuzz", "test_object_fuzz", work(g, "object-fuzz"));
    txGate(g, "functions", "test_native_functions", work(g, "functions"));
    txGate(g, "runtime-functions", "test_runtime_functions", work(g, "runtime-functions"));
    if (!g.o.quick) {
        txGate(g, "console", "test_native_console", plus(work(g, "console"), args2("--report", at(g, "console.json"))));
        txGate(g, "leak", "test_nrt_products", plus(list1("--leak-check"), plus(work(g, "leak"), args2("--report", at(g, "leak.json")))));
        txGate(g, "instrumented", "test_nrt_products", plus(list1("--debug"),
                plus(work(g, "instrumented"), args2("--report", at(g, "instrumented.json")))));
        // 可移植渲染器（arm64 后端的渲染逻辑）在本宿主上与缺省渲染器逐例对照。
        txGate(g, "portable-codegen", "test_portable_codegen", plus(plus(args2("--leak-check", "--debug"), work(g, "portable-codegen")),
                plus(plus(args2("--standard-normal", at(g, "products.json")), args2("--standard-leak", at(g, "leak.json"))),
                    args2("--standard-debug", at(g, "instrumented.json")))));
        // 测试专用页堆（安全审查攻关第 2 项）：驱动与产物正控制、变异体；全量语料在页堆内核下与 products 步的标准结果逐例对照。
        txGate(g, "heap-check", "test_heap_check", plus(work(g, "heap-check"), args2("--standard-normal", at(g, "products.json"))));
        // 取页失败的注入扫描：测试内核里第 N 次取页起失败，逐个 N 穷举；太虚写的门步。
        run(g, "oom-fault", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/test_oom_fault.tx"))),
                plus(args2("--compiler", g.compiler), work(g, "oom-fault"))));
        txGate(g, "capacity", "test_capacity_limits", work(g, "capacity"));
        txGate(g, "check", "test_native_check", work(g, "check"));
        txGate(g, "analysis", "test_ana", listNew());
        // 开发仓（有不导出的清单 release/export.txt）另要求编译器源码固定提交的那份冻结清单存在；公开仓只查夹具。
        let frozenFlags = work(g, "frontend-frozen");
        if (kindOf(join(root, "release/export.txt")) == 1) {
            frozenFlags = plus(frozenFlags, list1("--require-pinned"));
        }
        txGate(g, "frontend-frozen", "test_frontend_frozen", frozenFlags);
        txGate(g, "sha256", "test_native_sha256", work(g, "sha256"));
        txGate(g, "json", "test_native_json", work(g, "json"));
        txGate(g, "debug-vars", "test_native_debug_vars", work(g, "debug-vars"));
        txGate(g, "debug-stub", "test_native_debug_stub", work(g, "debug-stub"));
        txGate(g, "debug", "test_native_debug", listNew());
        txGate(g, "dap", "test_dap_e2e", listNew());
        txGate(g, "disasm", "test_native_disasm", listNew());
        txGate(g, "mcp", "test_mcp_e2e", listNew());
        txGate(g, "lsp", "test_lsp_e2e", listNew());
        txGate(g, "check-cache", "test_check_cache", work(g, "check-cache"));
        txGate(g, "lsp-cache", "test_lsp_cache", work(g, "lsp-cache"));
        // 服务状态序列 fuzz（安全审查攻关第 4 项）：带种子的 MCP／LSP 请求序列，分片写入，对照模型与后代、临时根。
        txGate(g, "service-sequence", "test_service_sequence", work(g, "service-sequence"));
        // LSP 聚合资源预算与输出背压（安全审查攻关第 5 项）：文档／编辑工作量／分析与热缓存预算、去抖最长等待、取消、诊断截断、停读矩阵。
        txGate(g, "lsp-resources", "test_lsp_resources", work(g, "lsp-resources"));
        txGate(g, "lsp-readonly", "test_lsp_readonly", listNew());
        txGate(g, "lsp-builtins", "test_lsp_builtins", listNew());
        // 标准库仓的验证（太虚写的 verify.tx）。
        run(g, "stdlib", g.compiler, plus(plus(args3("run", "--toolchain", nat(join(g.o.stdlib, "verify.tx"))), args2("--compiler", g.compiler)),
                plus(args2("--core", root), args2("--root", g.o.stdlib))));
    }
    if (!g.o.quick) {
        runCwd(g, "gui", g.compiler, plus(args3("run", "--toolchain", nat(join(g.o.gui, "verify.tx"))),
                plus(args2("--compiler", g.compiler), args2("--stdlib", join(g.o.stdlib, "src")))), g.o.gui);
    }
    // 行尾、行数、导入边界、独立判定器与纯太虚目录（连同导入边界规则的自检）。
    run(g, "hygiene", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/repo_hygiene.tx"))), args2("--root", root)));
    // 公开仓导出的泄漏自检：按清单 release/export.txt 把本提交与标准库导出到工作目录，擦除之后再按全部模式查内部字样、本机痕迹、
    // 指向未导出文件的链接与规范版本，命中即失败——新写的注释带回内部字样时在开发中就暴露。清单不随公开仓导出，公开仓里没有这一步。
    if (kindOf(join(root, "release/export.txt")) == 1) {
        run(g, "export", g.compiler, plus(args3("run", "--toolchain", nat(join(root, "scripts/export.tx"))),
                plus(plus(args2("--out", at(g, "export")), args2("--stdlib", g.o.stdlib)),
                    plus(plus(args2("--commit", g.o.exportCommit), args2("--stdlib-commit", g.o.exportStdlibCommit)),
                        plus(args2("--gui", g.o.gui), args2("--gui-commit", g.o.exportGuiCommit))))));
    }
    if (g.queued) { drainTasks(g); }
    g.status = "FAIL";
    if (g.fails == 0) {
        g.status = "PASS";
    }
    save(g);
    print("STATUS " + g.status + " " + g.scope + " report " + nat(join(g.work, "report.json")));
    finishRunDir(g.work);
    if (g.fails == 0) {
        return 0;
    }
    return 1;
}

export function main(args: []string): int {
    const o = parseOpts(args) catch (e) {
        return usage(e.message);
    };
    checkNative(o.compiler, o.root) catch (e) {
        eprint(e.message);
        return 2;
    };
    const dir = freshRunDir(o.work, "gate-", o.keepRuns) catch (e) {
        eprint(e.message);
        return 1;
    };
    let scope = "full-host";
    if (o.quick) {
        scope = "quick";
    }
    if (listLen(o.requested) > 0) { scope = "selected-host"; }
    const started = monoNs();
    const initialSha = shaOf(o.compiler);
    const g = new Gate { o: o, compiler: o.compiler, work: dir, scope: scope, initialSha: initialSha, checks: listNew(), completed: listNew(), fails: 0,
        status: "RUNNING", compilerSha: initialSha, started: started, queued: false, tasks: listNew() };
    // 子进程的环境：编译器按 TAIXU_STDLIB 找标准库根。
    setEnv("TAIXU_STDLIB", nat(join(o.stdlib, "src"))) catch (e) {
        eprint("设不了 TAIXU_STDLIB：" + e.message);
        return 1;
    };
    // 既有测试遗留的同名文件须还给调用者；测试产物进入独立 work。
    const fsTmp = join(o.root, "taixu-fs.tmp");
    const had = kindOf(fsTmp) == 1;
    const original = readBytes(fsTmp) catch bytesNew(0);
    const code = steps(g);
    if (had) {
        flush(fsTmp, original);
    }
    return code;
}
