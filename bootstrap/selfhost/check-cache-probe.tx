// 模块缓存的冷、热检查差分与实际工作量探针（6d-6b）。配置只提供覆盖层，不写源文件。
import { DrvCheckCache, drvCheckCacheNew, drvCheckCacheStats, drvCheck, drvCheckCached, drvSetOverlay,
    drvSetToolchain, drvSetPrelude, drvDiagOut, drvCheckDiags, drvAnaInts, drvAnaNames, drvAnaDetInts,
    drvAnaDetStrs, drvModulePathList, drvModuleTextList, drvCheckChanged, drvFailedPathList } from "./driver";
import { DrvDiag, newDrvDiag } from "./check_diag";
import { JsonValue, jsonNew, jsonParseStr, jsonGet, JSON_BOOL, JSON_INT, JSON_STR } from "./json_parse";
import { AnaOcc, AnaDetail, anaResolve, anaDetails, anaDirtyModules, anaResolveCached, anaDetailsCached } from "./ana_index";

struct ProbeIndex { paths: List<string>, texts: List<string>, occs: List<Ref<AnaOcc>>, dets: List<Ref<AnaDetail>>, }
function probeIndexNew(): Ref<ProbeIndex> { return new ProbeIndex { paths: listNew(), texts: listNew(), occs: listNew(), dets: listNew() }; }
function probeIndexUpdate(old: Ref<ProbeIndex>, cache: Ref<DrvCheckCache>): Ref<ProbeIndex> | Error {
    const paths = drvModulePathList(); const texts = drvModuleTextList(); let i = 0;
    for (p in paths) { if (p == "<prelude>") { listSet(texts, i, ""); } i = i + 1; }
    const dirty = anaDirtyModules(old.paths, paths, old.texts, texts, drvCheckChanged(cache));
    const fresh = anaResolve(drvAnaInts(), drvAnaNames(), texts);
    const dets = anaDetails(drvAnaDetInts(), drvAnaDetStrs());
    const out = new ProbeIndex { paths: paths, texts: texts, occs: anaResolveCached(drvAnaInts(), drvAnaNames(), texts, old.occs, dirty),
        dets: anaDetailsCached(drvAnaDetInts(), drvAnaDetStrs(), old.dets, dirty) };
    if (listLen(fresh) != listLen(out.occs) || listLen(dets) != listLen(out.dets)) { return err("index length"); }
    i = 0;
    for (a in fresh) {
        const b = listGet(out.occs, i) catch a;
        if (a.mod != b.mod || a.line != b.line || a.col != b.col || a.len != b.len || a.tt != b.tt || a.decl != b.decl
            || a.km != b.km || a.kl != b.kl || a.kc != b.kc || a.kh != b.kh || a.key != b.key || a.name != b.name || a.guess != b.guess) { return err("index occurrence"); }
        i = i + 1;
    }
    i = 0;
    for (a in dets) {
        const b = listGet(out.dets, i) catch a;
        if (a.key != b.key || a.mod != b.mod || a.how != b.how || a.name != b.name || a.text != b.text || a.exported != b.exported || a.varies != b.varies) { return err("index detail"); }
        i = i + 1;
    }
    return out;
}

struct CheckSnapshot {
    text: string, diags: List<Ref<DrvDiag>>, paths: List<string>, missing: List<string>,
    ai: List<int>, an: List<string>, di: List<int>, ds: List<string>,
}
function cacheSnapshot(): Ref<CheckSnapshot> {
    return new CheckSnapshot { text: drvDiagOut(), diags: drvCheckDiags(), paths: drvModulePathList(), missing: drvFailedPathList(),
        ai: drvAnaInts(), an: drvAnaNames(), di: drvAnaDetInts(), ds: drvAnaDetStrs() };
}
function probeInts(a: List<int>, b: List<int>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) { if ((listGet(a, i) catch -1) != (listGet(b, i) catch -2)) { return false; } i = i + 1; }
    return true;
}
function probeStrs(a: List<string>, b: List<string>): bool {
    if (listLen(a) != listLen(b)) { return false; }
    let i = 0;
    while (i < listLen(a)) { if ((listGet(a, i) catch "") != (listGet(b, i) catch "")) { return false; } i = i + 1; }
    return true;
}
function probeDiff(a: Ref<CheckSnapshot>, b: Ref<CheckSnapshot>): string {
    if (a.text != b.text) { return "diagnostic text: cold=" + a.text + " hot=" + b.text; }
    if (!probeStrs(a.paths, b.paths) || !probeStrs(a.missing, b.missing)) { return "module/missing paths"; }
    if (listLen(a.diags) != listLen(b.diags)) { return "diagnostic count"; }
    let i = 0;
    for (d in a.diags) {
        const e = listGet(b.diags, i) catch newDrvDiag(0, "", "", 0, 0, "", false);
        if (d.code != e.code || d.path != e.path || d.display != e.display || d.line != e.line || d.col != e.col || d.msg != e.msg || d.hint != e.hint) { return "diagnostic record"; }
        i = i + 1;
    }
    if (!probeInts(a.ai, b.ai) || !probeStrs(a.an, b.an)) { return "ANA1"; }
    if (!probeInts(a.di, b.di) || !probeStrs(a.ds, b.ds)) { return "ANT1"; }
    return "";
}
function probeStats(xs: List<int>): string {
    let out = "["; let i = 0;
    for (x in xs) { if (i > 0) { out = out + ","; } out = out + toStr(x); i = i + 1; }
    return out + "]";
}
function probeField(o: Ref<JsonValue>, key: string): Ref<JsonValue> { return jsonGet(o, key) catch jsonNew(0); }
export function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    const text: string = readFile(args[0]) catch (e) { eprint(e.message); return 2; };
    const doc = jsonParseStr(text) catch (e) { eprint(e.message); return 2; };
    const entry = probeField(doc, "entry").s; const target = probeField(doc, "target").i;
    drvSetToolchain(true);
    drvSetPrelude(bytesToStr(embedBytes("../../prelude/collections.tx")) catch "");
    const cache = drvCheckCacheNew(); let index = 0;
    let indexState = probeIndexNew();
    for (revision in probeField(doc, "revisions").items) {
        let currentEntry = entry; let currentTarget = target; let tool = true;
        const ep = probeField(revision, "entry"); if (ep.kind == JSON_STR) { currentEntry = ep.s; }
        const tp = probeField(revision, "target"); if (tp.kind == JSON_INT) { currentTarget = tp.i; }
        const tc = probeField(revision, "toolchain"); if (tc.kind == JSON_BOOL) { tool = tc.i != 0; }
        drvSetToolchain(tool);
        const remove = probeField(revision, "remove").s;
        if (len(remove) > 0) { removeFile(remove) catch (e) { eprint(e.message); return 2; }; }
        const write = probeField(revision, "write").s;
        if (len(write) > 0) { writeFile(write, "ok") catch (e) { eprint(e.message); return 2; }; }
        const paths: List<string> = listNew(); const texts: List<string> = listNew();
        for (x in probeField(revision, "paths").items) { listPush(paths, x.s); }
        for (x in probeField(revision, "texts").items) { listPush(texts, x.s); }
        drvSetOverlay(paths, texts);
        drvCheck(currentEntry, currentTarget, true);
        const cold = cacheSnapshot();
        const expectedCode = probeField(revision, "must_code").i;
        if (expectedCode > 0) {
            let found = false;
            for (d in cold.diags) { if (d.code == expectedCode) { found = true; } }
            if (!found) { eprint("missing expected diagnostic " + toStr(expectedCode)); return 1; }
        }
        drvCheckCached(currentEntry, currentTarget, true, cache);
        let why = probeDiff(cold, cacheSnapshot());
        if (len(why) > 0) { eprint("revision " + toStr(index) + " miss " + why); return 1; }
        const miss = drvCheckCacheStats(cache);
        indexState = probeIndexUpdate(indexState, cache) catch (e) { eprint(currentEntry + " miss " + e.message); return 1; };
        drvCheckCached(currentEntry, currentTarget, true, cache);
        why = probeDiff(cold, cacheSnapshot());
        if (len(why) > 0) { eprint("revision " + toStr(index) + " hit " + why); return 1; }
        indexState = probeIndexUpdate(indexState, cache) catch (e) { eprint(currentEntry + " hit " + e.message); return 1; };
        print("{\"revision\":" + toStr(index) + ",\"miss\":" + probeStats(miss) + ",\"hit\":" + probeStats(drvCheckCacheStats(cache)) + "}");
        index = index + 1;
    }
    return 0;
}
