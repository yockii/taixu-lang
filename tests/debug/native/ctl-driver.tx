// 第 6 轮 6c-3（TOOL-103）：工具链程序经 procSpawn 的控制通道驱动调试产物（scripts/test-native-debug-stub.py 的
// toolchain-driver 场景，以 --toolchain 构建）。按私有协议读 HELLO，发 RUN 单步进入，读 STOP，再发 RUN continue，
// 同时排干产物的 stdout 与 stderr，直到产物退出。
function u64At(b: Bytes, off: int): int {
    let v = 0;
    let i = 7;
    while (i >= 0) {
        v = v * 256 + (bytesGet(b, off + i) catch 0);
        i = i - 1;
    }
    return v;
}

function u32At(b: Bytes, off: int): int {
    let v = 0;
    let i = 3;
    while (i >= 0) {
        v = v * 256 + (bytesGet(b, off + i) catch 0);
        i = i - 1;
    }
    return v;
}

// RUN 帧：长度 17、操作码 11、模式、截止毫秒 0。
function runFrame(mode: int): Bytes {
    const f = bytesNew(21);
    bytesSet(f, 0, 17);
    bytesSet(f, 4, 11);
    bytesSet(f, 5, mode);
    return f;
}

function main(args: []string): int {
    if (len(args) < 1) {
        print("usage: ctl-driver <product>");
        return 2;
    }
    const h = procSpawn(args[0], listNew(), "", 2) catch (e) {
        print("spawn failed: " + e.message);
        return 1;
    };
    const buf = bytesNew(4096);
    const acc = bytesNew(0);
    let pos = 0;
    let frames = 0;
    let out = "";
    let ctlOpen = true;
    let outOpen = true;
    let errOpen = true;
    while (ctlOpen || outOpen || errOpen) {
        let mask = 0;
        if (ctlOpen) { mask = mask | 8; }
        if (outOpen) { mask = mask | 2; }
        if (errOpen) { mask = mask | 4; }
        const r = ioWait(h, mask, 10000);
        if (r == 0) {
            print("timeout");
            break;
        }
        if ((r & 8) != 0) {
            const n = procRead(h, 3, buf);
            if (n < 0) { ctlOpen = false; } else { bytesAppend(acc, bytesSlice(buf, 0, n)); }
            while (len(acc) - pos >= 4 && len(acc) - pos >= 4 + u32At(acc, pos)) {
                const op = bytesGet(acc, pos + 4) catch 0;
                if (frames == 0) {
                    print("hello: op=" + toStr(op) + " version=" + toStr(u64At(acc, pos + 5)));
                    print("run into sent: " + toStr(procWrite(h, 3, runFrame(1))));
                } else if (frames == 1) {
                    print("stop: op=" + toStr(op) + " reason=" + toStr(u64At(acc, pos + 5)) + " depth=" + toStr(u64At(acc, pos + 29)));
                    print("continue sent: " + toStr(procWrite(h, 3, runFrame(0))));
                } else {
                    print("extra frame: op=" + toStr(op));
                }
                frames = frames + 1;
                pos = pos + 4 + u32At(acc, pos);
            }
        }
        if ((r & 2) != 0) {
            const n = procRead(h, 1, buf);
            if (n < 0) { outOpen = false; } else { out = out + (bytesToStr(bytesSlice(buf, 0, n)) catch "?"); }
        }
        if ((r & 4) != 0) {
            const n = procRead(h, 2, buf);
            if (n < 0) { errOpen = false; }
        }
    }
    print("product stdout: " + out);
    print("product exit: " + toStr(procWait(h, 10000) catch -999));
    print("ctl after exit: " + toStr(procRead(h, 3, buf)));
    procClose(h);
    return 0;
}
