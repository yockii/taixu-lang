// l29-neg-await-outside-async —— BOOT-21 第十柱 3024 负例。
// zig sema 真值（2026-09-19 执行期活体捕获）：普通（非 async）函数体内
// await（操作数合法 Future——async 调用值形态）→ 单诊断 3024 "await 只能
// 出现在 async 函数体内（同步上下文无暂停点）" 落 await 记号位（13:15）。
// D26 §二：await 只能在 async function 或 async 箭头体内——同步 main 无
// 暂停点，着色整体传染（同步调用链不可 await）。
// 活体双注记：①await 产出 T | Error 失败联合——消费面 catch 桥接（D3 §2.1
// 跨通道显式桥）否则 3002 跟发（首探形态）；②同步体内 await 非 Future 值
// （int）双诊断 3024+3025 同位同发（await 臂两查独立）。
async function work(): int {
    return 1;
}
export function main(args: []string): int {
    const r = (await work()) catch 0;
    print(toStr(r));
    return 0;
}
