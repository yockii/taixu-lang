import { ScalarCandidate, ScalarCandidates } from "../bootstrap/selfhost/scalar_candidates";
import { scalarCacheSlots, scalarCachePlan, scalarCacheHotCalls } from "../bootstrap/selfhost/scalar_cache_plan";
import { ScalarBlock, ScalarLoop } from "../bootstrap/selfhost/scalar_loops";
function row(values: List<Ref<ScalarCandidate>>, region: int, slot: int, reads: int): void {
    listPush(values, new ScalarCandidate { region: region, slot: slot, tag: 1, reads: reads, writes: 1, barriers: 0 });
}
test "scalar cache plan: pressure, stable ties and nesting" {
    const values: List<Ref<ScalarCandidate>> = listNew();
    row(values, 0, 9, 8); row(values, 0, 4, 8); row(values, 1, 9, 8); row(values, 1, 2, 9); row(values, 2, 2, 3);
    const plan = scalarCacheSlots(ScalarCandidates { values: values, work: 1, limited: false });
    assert(listLen(plan) == 2 && (listGet(plan, 0) catch -1) == 2 && (listGet(plan, 1) catch -1) == 4, "two best unique slots, no nested double score");
}
test "scalar cache plan: one slot and exhausted analysis" {
    const values: List<Ref<ScalarCandidate>> = listNew(); row(values, 0, 2, 3); row(values, 1, 2, 5);
    const plan = scalarCacheSlots(ScalarCandidates { values: values, work: 1, limited: false });
    assert(listLen(plan) == 1 && (listGet(plan, 0) catch -1) == 2, "one physical lane");
    assert(listLen(scalarCacheSlots(ScalarCandidates { values: values, work: 1, limited: true })) == 0, "no partial plan");
    assert(listLen(scalarCacheSlots(ScalarCandidates { values: listNew(), work: 0, limited: false })) == 0, "no candidates");
}

test "scalar cache plan: float slots keep their value slots" {
    const values: List<Ref<ScalarCandidate>> = listNew();
    listPush(values, new ScalarCandidate { region: 0, slot: 5, tag: 2, reads: 20, writes: 2, barriers: 0 });
    listPush(values, new ScalarCandidate { region: 0, slot: 6, tag: 2, reads: 18, writes: 2, barriers: 0 });
    row(values, 0, 7, 3);
    listPush(values, new ScalarCandidate { region: 0, slot: 8, tag: 3, reads: 2, writes: 1, barriers: 0 });
    const plan = scalarCacheSlots(ScalarCandidates { values: values, work: 1, limited: false });
    assert(listLen(plan) == 2 && (listGet(plan, 0) catch -1) == 7 && (listGet(plan, 1) catch -1) == 8, "int and bool only, in read order");
    // 同一槽在另一区域里是 int 也不缓存：缓存跨整个函数，r12/r13 里会出现 float 位型。
    const mixed: List<Ref<ScalarCandidate>> = listNew();
    row(mixed, 0, 4, 9);
    listPush(mixed, new ScalarCandidate { region: 1, slot: 4, tag: 2, reads: 9, writes: 1, barriers: 0 });
    assert(listLen(scalarCacheSlots(ScalarCandidates { values: mixed, work: 1, limited: false })) == 0, "slot float in any region is excluded");
    const floats: List<Ref<ScalarCandidate>> = listNew();
    listPush(floats, new ScalarCandidate { region: 0, slot: 3, tag: 2, reads: 9, writes: 1, barriers: 0 });
    assert(listLen(scalarCachePlan(ScalarCandidates { values: floats, work: 1, limited: false }, 0)) == 0, "float-only loop allocates nothing");
}

test "scalar cache plan: calls inside root intervals only, nesting counted once" {
    const blocks: List<Ref<ScalarBlock>> = listNew(); let i = 0;
    while (i < 7) { listPush(blocks, new ScalarBlock { first: i * 3, last: i * 3 + 2, succs: listNew() }); i = i + 1; }
    const regions: List<Ref<ScalarLoop>> = listNew();
    listPush(regions, new ScalarLoop { header: 1, last: 4, parent: -1, depth: 0, latches: listNew(), exitFrom: listNew(), exitTo: listNew() });
    listPush(regions, new ScalarLoop { header: 2, last: 3, parent: 0, depth: 1, latches: listNew(), exitFrom: listNew(), exitTo: listNew() });
    listPush(regions, new ScalarLoop { header: 5, last: 5, parent: -1, depth: 0, latches: listNew(), exitFrom: listNew(), exitTo: listNew() });
    const calls: List<int> = listNew(); for (pc in [0, 2, 3, 6, 7, 11, 12, 14, 15, 17, 18, 20]) { listPush(calls, pc); }
    let oracle = 0;
    for (pc in calls) { if ((pc >= 3 && pc <= 14) || (pc >= 15 && pc <= 17)) { oracle = oracle + 1; } }
    assert(oracle == 8 && scalarCacheHotCalls(blocks, regions, calls) == oracle, "root union including first/last PCs");
    const outside: List<int> = listNew(); for (pc in [0, 2, 18, 20]) { listPush(outside, pc); }
    assert(scalarCacheHotCalls(blocks, regions, outside) == 0, "acyclic initialization and output calls do not veto");
    assert(scalarCacheHotCalls(blocks, listNew(), calls) == 0, "no loop");
}

test "scalar cache plan: automatic calls policy preserves raw eligibility" {
    const values: List<Ref<ScalarCandidate>> = listNew(); row(values, 0, 2, 3);
    const candidates = ScalarCandidates { values: values, work: 1, limited: false };
    assert(listLen(scalarCacheSlots(candidates)) == 1 && listLen(scalarCachePlan(candidates, 0)) == 1, "eligible call-free loop remains allocated");
    assert(listLen(scalarCachePlan(candidates, 1)) == 0 && listLen(scalarCachePlan(candidates, -1)) == 0, "hot call or invalid cost keeps slots");
    assert(listLen(candidates.values) == 1 && listLen(scalarCacheSlots(candidates)) == 1, "policy does not change candidate facts");
}
