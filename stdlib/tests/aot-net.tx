// V0.39-N1 AOT 双路锚：net extern 面（txp_net_*——platform.net 同表分发
// ＝math_host/fsops 先例；shim used_externs 过滤装配活体）。
// 恒定性：loopback 127.0.0.1 自建自连＋固定响应（禁外网；端口步进重试）。
import { tcpListen, tcpAccept, tcpConnect, tcpSend, tcpRecv, tcpClose } from "std/net";

export function main(args: []string): int {
    let listener: int = -1;
    let port: int = 47200;
    let attempt: int = 0;
    while (attempt < 8) {
        const l: int | Error = tcpListen(port);
        listener = l catch -1;
        if (listener >= 0) { break; }
        port = port + 1;
        attempt = attempt + 1;
    }
    if (listener < 0) {
        print("listener-failed");
        return 1;
    }
    const cliR: int | Error = tcpConnect("127.0.0.1", port);
    const cli: int = cliR catch panic("connect");
    const sent: int | Error = tcpSend(cli, "hello-net");
    print(toStr(sent catch -1));
    const conn: int | Error = tcpAccept(listener);
    const cc: int = conn catch panic("accept");
    print(tcpRecv(cc, 64) catch "recv-err");
    const back: int | Error = tcpSend(cc, "ok");
    print(toStr(back catch -1));
    print(tcpRecv(cli, 64) catch "recv-err");
    tcpClose(cli);
    tcpClose(cc);
    tcpClose(listener);
    return 0;
}
