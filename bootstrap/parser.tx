// bootstrap/parser —— S1 自举语法分析器（BOOT-05；D13 §3/§4/§6）。
//
// 与引导版（src/compiler/parser/parser.zig）行为同构：输出规范化 AST 文本
// （文法基准＝src/compiler/ast/render.zig 头部文法表），语法错误输出
// `! line col code`（码位硬编码对齐 diag.Code）并退出 1；词法错误经预扫描
// 透传词法器错误行（D13 §4-5 定序镜像：先词法全程、后语法）。
// 差异测试（build_tools/diff_parser.zig，B2-P6）对全部仓库 .tx 比对本实现
// 与 `taixu parse` 的输出（TEST-06）。
//
// 流式设计：每个解析函数返回"子树文本块"（string，各行以 \n 收尾、相对
// 缩进 0），父层以 indent4 拼接自己的节点行；前瞻为重复词法（快照/恢复，
// 性能不对齐是预期）。分段合入：P1 骨架与类型层 → P2 声明 → P3 语句
// → P4 表达式 → P5 消歧与收口；分段期未实现构造经 NOTIMPL 干净退场
// （stdout 单行 `# notimpl <构造名>`、退出码 0、丢弃部分渲染输出）。
//
// 【B2-P1 实现注记（调查结论已定案，见 docs/work/VM-RC-fix.md）】
// 1. sema 导入可见性（引导侧缺陷，已确认）：导入结构类型（lexer 的
//    Cur/Tok/Out）不可用于函数签名与 struct 字段位置——registerModules
//    次序为签名/字段类型消解（阶段 1/2）先于导入解析（阶段 4），仅函数
//    体内可见。绕开：游标与词法错误状态在 P 内值化（pos/line/col ＋
//    lexErrs/lexFailed），逐次经局部 Cur/Out 包装驱动 lexer 的 nextToken
//    （D13 §3 骨架的 `P { cur: Ref<Cur>, err: Ref<Out> }` 形态留待修订
//    后复原）。
// 2. codegen __access 桩寄存器少报（引导侧缺陷，已修复）：跨模块常量
//    访问桩合成时漏 useReg，GETFLD 越出 1 槽窗口写调用方相邻槽位并
//    释放旧值——本件每次 K_* 常量读取都触发，先期观察到的段错误/值槽
//    载荷混淆/错误分支皆其连带表现；修复＝合成器补一行 useReg（无导入
//    模块的 .txc 与金哈希不变）。解析函数返回 string 文本块的流式形态
//    保留（较 struct Result 简省且已全绿）。
// 3. 自测抓得并已修复的本件逻辑缺陷两处：advance 曾双重消费 token
//    （走查行数对账定案）；indent4 曾漏首行缩进（18 vs 14 字节定案）。
//    修复后类型层 11 例全绿。
// 4. 遗留观察（不阻塞 P1 验收面，随 VM-RC-fix 工单跟进）：同一程序内
//    "token 全量走查段＋类型段"顺序执行仍可在退出清理期触发段错误
//    （两段各自独立程序均全绿）——疑似帧窗口释放账目的更深问题；
//    P1 验收面（分段比对＋zig build test）不经过该组合。

// ============================================================================
// 分节标头（R0-a-⑧ 双出口裁决：维持单文件——S1 模块面无 re-export 转发，
// 拆分必改消费面 import 契约＝非逐字节搬家；与引导 parser.zig 同裁决。
// 本标头为 AI/维护导航面。）
//   §1 常量/节点编码（BK 表＋bNode 族，~14–230）
//   §2 词法驱动（lexStep/fillTok/tok*/advance/peek，231–330）
//   §3 预扫描与错误账（preScan/preScanCoded/recordErr*/expect*，335–430）
//   §4 声明解析（parseModule/parseTopDecl 族）
//   §5 类型解析（parseTypeAtom/parseTypeUnion）
//   §6 语句解析（parseStmt/parseIf/parseFor 族）
//   §7 表达式解析（parseExpr 优先级链/parsePrimary/parseTemplate）
//   §8 egress 与入口（parseSource/parseSourceBin/parseCore/main）
//   §9 自测（test 块）
// ============================================================================

import {
    Cur, Tok, Out, nextToken, sliceText, fitsU64,
    K_EOF, K_IDENT, K_INT, K_FLOAT, K_STR, K_TEMPLATE,
    K_EXPORT, K_FUNCTION, K_STRUCT, K_ENUM, K_LET, K_CONST,
    K_IF, K_ELSE, K_WHILE, K_FOR, K_BREAK, K_CONTINUE, K_RETURN,
    K_SWITCH, K_CASE, K_TEST, K_IMPORT, K_TRUE, K_FALSE,
    K_NEW, K_CATCH, K_AS,
    K_PLUS, K_MINUS, K_STAR, K_SLASH, K_PERCENT,
    K_EQEQ, K_BANGEQ, K_LT, K_LTEQ, K_GT, K_GTEQ,
    K_ANDAND, K_OROR, K_BANG, K_QUESTION, K_ASSIGN, K_FATARROW,
    K_AMP, K_CARET, K_TILDE, K_CHAR, K_DEFER, K_INTERFACE,
    K_DOT, K_COMMA, K_SEMI, K_COLON, K_LPAREN, K_RPAREN,
    K_LBRACE, K_RBRACE, K_LBRACKET, K_RBRACKET, K_PIPE, K_COMMENT,
} from "./lexer";

// —— 解析器状态：游标值化（恒停当前 token 之前，D13 §3）＋当前 token
// 缓存（curValid）＋首错承载（只记首个）＋输出缓冲 buf 与 expr 元数据槽——
struct P {
    src: string,
    pos: int,
    line: int,
    col: int,
    lexErrs: string,
    lexFailed: bool,
    curValid: bool,
    curKind: int,
    curText: string,
    curLine: int,
    curCol: int,
    lastKind: int,
    buf: string,
    impl: bool,
    implWhat: string,
    failed: bool,
    errLine: int,
    errCol: int,
    errCode: int,
    errMsg: string,
    errAcc: string,
    exprLine: int,
    exprCol: int,
    exprLval: bool,
    bin: bool,
    nnodes: int,
    sbytes: int,
    // 解构糖溢出队列（V0.38-T1 糖面镜像；D3 v0.12）——镜像引导版
    // pending_stmts：`const (a,b)=e;` 首绑定（#dt<N>）随返回值走常规流，
    // 元素绑定入本队列，由 parseBlock/parseModule 在该语句后立即 flush。
    pending: List<string>,
    // 解构合成名计数（镜像引导版 syn_n——#dt<N> 的 N）。
    synN: int,
    // 泛型镜像侧通道（V0.39-M0 泛型语法镜像；D3 v0.13）：
    // exprIdent＝后缀链头是否 bare-ident（镜像引导版 e.kind==.ident——
    // parsePostfix 泛型调用臂前置；parsePrimary 置位、后缀臂清位）；
    // tyargsN/tparamsN＝最近一次 parseCallTypeArgs/parseTypeParams 的元素数
    //（父节点 bin 头子计数需要）；noGenTy＝as_cast 位关门（镜像引导版
    // parseTypeAtomG(false)——`x as int < y` 零回归；Ref/Weak/List/Future
    // 内层恢复 false 与引导版嵌套允许语义逐位同构）。
    exprIdent: bool,
    tyargsN: int,
    tparamsN: int,
    noGenTy: bool,
    // 生成器函数体内（D3 v0.22）：`yield` 为关键字（语句位）。
    inGen: bool,
}

