// ============================================================================
// engine/mac/m_rrect_macos_aarch64 —— NSRect(id, SEL)（如 frame）：arm64 上 NSRect 是四个 double 的 HFA，在返回，经 objc_msgSend（arm64 没有 _stret）。
// ============================================================================

import { NSRECT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize): NSRECT from "/usr/lib/libobjc.A.dylib";

export function msgRetRect(o: usize, s: string): NSRECT {
    return objc_msgSend(o, sel_registerName(s));
}
