// ============================================================================
// stdlib 用例：std/pool——Pool 同步面（V0.9-A2；D26 §四）
// 运行：taixu test tests/pool.tx（依赖 TAIXU_STDLIB 或同级发现）
// 红线：道数下限归一 1（显式逃生舱面）；默认池＝单道；submit 越界归道 0
//（不静默丢任务）；async 轮转收割面由 verify ⑤（tests/pool-async.tx＋.out）覆盖。
// ============================================================================

import { Pool, poolNew, poolDefault, poolSubmit, poolDrain, poolFailed, poolLanes } from "std/pool";

async function five(): int {
    return 5;
}

async function seven(): int {
    return 7;
}

test "pool：道数构造与下限归一；默认池单道" {
    const p2 = poolNew(2);
    assert(poolLanes(p2) == 2, "显式 2 道");
    const p0 = poolNew(0);
    assert(poolLanes(p0) == 1, "道数下限归一 1");
    const d = poolDefault();
    assert(poolLanes(d) == 1, "默认池＝单道（隐式合理默认）");
    assert(poolFailed(d) == 0, "新池 failed 为 0");
}

test "pool：submit 返回池内全局槽位；越界归道 0（不丢任务）" {
    const p = poolNew(2);
    const a = poolSubmit(p, 0, five());
    const b = poolSubmit(p, 1, seven());
    const c = poolSubmit(p, 1, five());
    assert(a == 0 && b == 1 && c == 2, "全局槽位按提交序分配");
    const oob = poolSubmit(p, 9, seven());
    assert(oob == 3, "越界指道归道 0（任务入池不丢，全局槽位续分配）");
    assert(poolFailed(p) == 0, "submit 不产生失败计数");
}
