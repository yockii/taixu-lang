// D3 v0.50 §6.3-9：?. 只用于 T?——T | Error 给定向错误（先 catch，或 (x?).f 传播后再取），非可选值直接写 .；?. 链不能作赋值目标。
struct P {
    name: string,
}

function failing(): Ref<P> | Error {
    return new P { name: "x" };
}

function onError(): string? {
    return failing()?.name;
}

function onPlain(p: Ref<P>): string? {
    return p?.name;
}

function assignChain(p: Ref<P>?): void {
    p?.name = "y";
}

function main(args: []string): void {
    print("x");
}
