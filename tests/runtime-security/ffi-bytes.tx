declare function tx_buffer_address(b: Bytes): usize from "ffi_safety_probe";
declare function tx_buffer_probe(b: Bytes, grow: () => void, current: () => usize): i32 from "ffi_safety_probe";
declare function tx_buffer_duplicate(a: Bytes, b: Bytes, grow: () => void, current: () => usize): i32 from "ffi_safety_probe";
let buffer: Bytes = bytesNew(65536);
let empty: Bytes = bytesNew(0);
let mode: string = "";
let hold: List< Bytes> = listNew();
function current(): usize { return tx_buffer_address(buffer); }
function currentEmpty(): usize { return tx_buffer_address(empty); }
function nothing(): void { bytesSet(buffer, 0, 43); }
// D3 v0.34：不改变长度的调用在借用期内照常（空追加、空表弹出得 None）。
function unchanged(): void {
    bytesAppend(empty, bytesNew(0));
    const popped = listPop(bytesAsList(empty));
    assert(popped == None, "empty pop yields None");
    bytesAppend(buffer, empty);
}
function callback(): void {
    // 任何改变长度的操作都 trap 4024，与容量无关（*-spare 在调用前留出了空余容量）。
    if (mode == "push" || mode == "push-spare") { bytesPush(buffer, 42); }
    if (mode == "append") { bytesAppend(buffer, bytesNew(65536)); }
    if (mode == "append-spare") { bytesAppend(buffer, bytesNew(1)); }
    const alias = bytesAsList(buffer);
    if (mode == "list-push" || mode == "list-push-spare") { listPush(alias, 42); }
    if (mode == "list-insert") { listInsert(alias, 1, 42); }
    if (mode == "list-pop") { listPop(alias) catch 0; }
    if (mode == "list-remove") { listRemoveAt(alias, 0); }
    if (mode == "safe") {
        bytesSet(buffer, 0, 41); listSet(alias, 1, 42);
        assert((listGet(alias, 1) catch 0) == 42 && bytesLen(buffer) == 65536, "in-place reads and writes");
        // D3 v0.37 批量操作不改变长度，借用期内照常（填充、同一对象内拷贝、定宽写）。
        bytesFill(buffer, 100, 8, 7); bytesCopy(buffer, 200, buffer, 100, 8); bytesSetLE<u32>(buffer, 300, 0x01020304);
        assert((bytesGetLE<u32>(buffer, 300) catch 0) == 0x01020304 && (bytesGet(buffer, 207) catch 0) == 7 && bytesLen(buffer) == 65536, "bulk in-place writes");
        assert(tx_buffer_duplicate(empty, empty, unchanged, currentEmpty) == 0, "length-preserving calls");
        assert(tx_buffer_duplicate(buffer, buffer, nothing, current) == 0, "nested duplicate borrow");
        const snapshot = buffer;
        const transfer = threadSpawn((): int => { bytesPush(snapshot, 99); return bytesLen(snapshot); });
        assert((threadJoin(transfer) catch -1) == 65537 && bytesLen(buffer) == 65536, "deep copy does not inherit transient pin");
        let i = 0; while (i < 20000) { listPush(hold, bytesNew(1)); i = i + 1; }
    }
    if (mode == "after-nested") {
        assert(tx_buffer_duplicate(buffer, buffer, nothing, current) == 0, "inner returns");
        bytesPush(buffer, 42);
    }
}
function main(args: []string): int {
    if (len(args) != 1) { return 64; } mode = args[0];
    if (mode == "empty-push") { buffer = bytesNew(0); mode = "push"; }
    if (mode == "push-spare" || mode == "append-spare" || mode == "list-push-spare") {
        bytesPush(buffer, 0); listPop(bytesAsList(buffer)) catch 0;
    }
    assert(tx_buffer_duplicate(buffer, buffer, callback, current) == 0, "stable backing");
    assert(mode == "safe", "length change must trap before C resumes");
    assert((bytesGet(buffer, 0) catch -1) == 43 && (bytesGet(buffer, 1) catch -1) == 42, "in-place aliases allowed");
    bytesPush(buffer, 45); listInsert(bytesAsList(buffer), 1, 46); listPop(bytesAsList(buffer)) catch 0; bytesPush(buffer, 47);
    assert(bytesLen(buffer) == 65538, "borrow removed after return and table growth");
    print("PASS_FFI_BYTES_ALIAS_NESTED_DUPLICATE_TABLE_GROWTH_RETURN"); return 0;
}
