// 内存上限扫描的负载（安全复审 v0.2 攻关第 1、2 项的 Shared／Weak／发送部分）：在逐级收紧的进程内存上限下运行，
// 每次只允许两种结局——完整跑完并打印校验和，或在某个分配点按既定的致命 OOM 退出（退出码 3、“taixu: 内存不足”）。
// 崩溃、挂起、其他退出码或错误的校验和都说明某个分配失败路径没有按合同处理。
struct Node { name: string, data: Bytes, kids: List< Ref< Node>> }

function build(depth: int, width: int, tag: int): Ref< Node> {
    const n = new Node { name: "n" + toStr(tag), data: bytesNew(256 + tag % 64), kids: listNew() };
    if (depth > 0) {
        let i = 0;
        while (i < width) { listPush(n.kids, build(depth - 1, width, tag * width + i + 1)); i = i + 1; }
    }
    return n;
}
function sum(n: Ref< Node>): int {
    let total = len(n.name) + bytesLen(n.data);
    for (k in n.kids) { total = total + sum(k); }
    return total;
}
// Weak 表增长、链接与目标死亡时的通知：一半目标活着，一半随即死去。
function churn(count: int): int {
    const keep: List< Ref< Node>> = listNew();
    const watch: List< Weak< Node>> = listNew();
    let i = 0;
    while (i < count) {
        const n = build(0, 0, i);
        listPush(watch, weak(n));
        listPush(watch, weak(n));
        if (i % 2 == 0) { listPush(keep, n); }
        i = i + 1;
    }
    let alive = 0;
    for (w in watch) { if (deref(w) != None) { alive = alive + 1; } }
    return alive;
}

function main(args: []string): int {
    let total = 0;
    let round = 0;
    while (round < 4) {
        const root = build(4, 4, round);
        total = total + sum(root);
        const shared = sharedNew(root);
        const worker = threadSpawn((): int => { return sum(sharedGet(shared)); });
        // 线程建不起来（系统层或新线程的区域分配失败）时 threadJoin 得错误值（附录 A）：换本线程算同一个值，校验和不变。
        let part = threadJoin(worker) catch -1;
        if (part < 0) { print("JOIN_FAILED"); part = sum(sharedGet(shared)); }
        total = total + sum(sharedGet(shared)) + part + churn(300);
        round = round + 1;
    }
    print("PASS_OOM_SWEEP " + toStr(total));
    return 0;
}
