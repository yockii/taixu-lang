// 路径分隔符（docs/design/v052-path-canonical-v0.1-20261025.md）：驱动内部与进产物的路径一律以 / 分隔，与宿主无关（同 Go 记进
// 二进制的文件名）；输入按宿主认分隔符——Windows 上 / 与 \ 都是，类 Unix 上只有 /，\ 是普通字符（同 Zig 的 std.fs.path.isSep）；
// 给人看的绝对路径在输出处按宿主渲染（Windows 换回 \）。宿主取编译器自身的目标。
const WINDOWS_HOST: bool = hostTarget() == "windows";

/// c 是否为本宿主上的路径分隔符（码点或字节值）。
export function pathIsSep(c: int): bool {
    return c == 47 || (c == 92 && WINDOWS_HOST);
}

/// 宿主是否为 Windows。
export function pathOnWindows(): bool { return WINDOWS_HOST; }

/// 本宿主的分隔符（取末段等按串切分处用）。
export function pathSeps(): List<string> {
    const out: List<string> = listNew();
    listPush(out, "/");
    if (WINDOWS_HOST) { listPush(out, "\\"); }
    return out;
}

/// 按宿主分隔符拼接（交给系统、给人看的路径，如临时目录下的暂存产物）。
export function pathHostJoin(dir: string, name: string): string {
    if (WINDOWS_HOST) { return dir + "\\" + name; }
    return dir + "/" + name;
}

/// 给人看的形式：Windows 宿主上把 / 换成 \，其余原样。
export function pathHostShow(p: string): string {
    if (!WINDOWS_HOST || strIndexOf(p, "/") < 0) { return p; }
    const b = bytesFromStr(p);
    let i = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) catch 0) == 47) { bytesSet(b, i, 92); }
        i = i + 1;
    }
    return bytesToStr(b) catch p;
}
