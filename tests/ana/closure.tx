// 分析节黄金用例：闭包捕获链、函数值、模板串；故意保留无 from 的宿主声明，检查 3033 后的名字恢复，
// 以及 for-in 的 Map 形（解糖时合成在 for 关键字上的标识符不出行）；模板串插值里的标识符位置相对插值段，暂不出行（6e）。
import { jsonParse } from "std/json";
import { mapNew, mapSet, mapKeys, mapGet } from "std/map_set";

declare function txp_host(n: int): int;

function apply(g: (int) => int, v: int): int {
    return g(v);
}

function main(args: []string): int {
    const base = 10;
    const outer = (a: int): int => {
        const inner = (b: int): int => a + b + base;
        return inner(a);
    };
    const m = mapNew();
    mapSet(m, "k", jsonParse("1") catch panic("bad"));
    let acc = 0;
    for (key, val in m) {
        const seen = val;
        acc = acc + len(key);
    }
    const text = `n=${acc} b=${base}`;
    print(text);
    return apply(outer, base) + txp_host(acc);
}
