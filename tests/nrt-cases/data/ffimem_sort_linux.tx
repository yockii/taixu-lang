// ffi-mem-callback 排序的 Linux 实现：libc 的 qsort（产物动态链接 glibc），比较函数在 ffimem_cmp.tx。
import { byValue } from "./ffimem_cmp";

declare function qsort(base: usize, n: usize, w: usize, cmp: (usize, usize) => i32): void from "libc.so.6";

export function sortInts(p: int, n: int): void {
    qsort(p as usize, n as usize, 4, byValue);
}
