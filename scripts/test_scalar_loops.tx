import { ScalarBlock, ScalarLoop, ScalarLoops, scalarLoops } from "../bootstrap/selfhost/scalar_loops";

function ints(values: []int): List<int> { const out: List<int> = listNew(); for (value in values) { listPush(out, value); } return out; }
function graph(edges: List<List<int>>): List<Ref<ScalarBlock>> {
    const out: List<Ref<ScalarBlock>> = listNew(); let i = 0;
    for (successors in edges) { listPush(out, new ScalarBlock { first: i, last: i, succs: successors }); i = i + 1; } return out;
}
function edges(rows: []List<int>): List<List<int>> { const out: List<List<int>> = listNew(); for (row in rows) { listPush(out, row); } return out; }
function run(rows: []List<int>, roots: []int): ScalarLoops { return scalarLoops(graph(edges(rows)), ints(roots), 10000) catch panic("valid graph"); }
function region(result: ScalarLoops, i: int): Ref<ScalarLoop> { assert(!result.limited, "complete result"); return listGet(result.regions, i) catch panic("missing loop"); }
function hasExit(loop: Ref<ScalarLoop>, from: int, to: int): bool {
    let i = 0; while (i < listLen(loop.exitFrom)) {
        if ((listGet(loop.exitFrom, i) catch -2) == from && (listGet(loop.exitTo, i) catch -2) == to) { return true; } i = i + 1;
    } return false;
}
function invalid(blocks: List<Ref<ScalarBlock>>, roots: List<int>, budget: int): bool { scalarLoops(blocks, roots, budget) catch (e) { return true; }; return false; }
function get(xs: List<int>, i: int): int { return listGet(xs, i) catch panic("test graph index"); }
function reach(rows: List<List<int>>, roots: List<int>, blocked: int): List<int> {
    const seen: List<int> = listNew(); for (row in rows) { listPush(seen, 0); }
    const todo: List<int> = listNew();
    for (root in roots) { if (root != blocked && get(seen, root) == 0) { listPush(todo, root); listSet(seen, root, 1); } }
    while (listLen(todo) > 0) {
        const owner = listPop(todo) catch panic("test work queue");
        for (next in listGet(rows, owner) catch panic("test graph row")) {
            if (next != blocked && get(seen, next) == 0) { listPush(todo, next); listSet(seen, next, 1); }
        }
    } return seen;
}
// Independent path oracle: remove the proposed header and start at every
// reachable outside block / explicit entry. No path may enter its interior.
function verifyPaths(rows: List<List<int>>, roots: List<int>): void {
    const n = listLen(rows); const live = reach(rows, roots, -1);
    const result = scalarLoops(graph(rows), roots, 100000) catch panic("small valid graph"); assert(!result.limited, "small graph fits budget");
    let h = 0;
    while (h < n) {
        let end = -1; let owner = h;
        while (owner < n) {
            if (get(live, owner) != 0) { for (next in listGet(rows, owner) catch panic("test row")) { if (next == h) { end = owner; } } }
            owner = owner + 1;
        }
        let expected = false;
        if (end >= h) {
            const starts: List<int> = listNew(); let i = 0;
            while (i < n) { if (get(live, i) != 0 && (i < h || i > end)) { listPush(starts, i); } i = i + 1; }
            for (root in roots) { listPush(starts, root); }
            const bypass = reach(rows, starts, h); expected = true; i = h + 1;
            while (i <= end) { if (get(bypass, i) != 0) { expected = false; } i = i + 1; }
        }
        let found = false;
        for (loop in result.regions) {
            if (loop.header == h) { assert(loop.last == end && !found, "unique maximal interval"); found = true; }
        }
        assert(found == expected, "loop entries agree with independent path reachability"); h = h + 1;
    }
    for (loop in result.regions) {
        let owner = loop.header;
        while (owner <= loop.last) {
            if (get(live, owner) != 0) {
                const successors = listGet(rows, owner) catch panic("test exit row");
                if (listLen(successors) == 0) { assert(hasExit(loop, owner, -1), "terminal boundary retained"); }
                for (next in successors) { if (next < loop.header || next > loop.last) { assert(hasExit(loop, owner, next), "outside edge retained"); } }
            } owner = owner + 1;
        }
    }
}

test "scalar loops: while, continue, break, return and duplicate edges" {
    const basic = run([ints([1]), ints([2, 4]), ints([1, 3]), ints([1, 4]), ints([])], [0]);
    assert(listLen(basic.regions) == 1, "one loop"); const loop = region(basic, 0);
    assert(loop.header == 1 && loop.last == 3 && loop.parent == -1 && loop.depth == 0, "loop interval");
    assert(listLen(loop.latches) == 2 && listLen(loop.exitFrom) == 2, "continue and normal back edges; condition and break exits");
    assert(hasExit(loop, 1, 4) && hasExit(loop, 3, 4), "all exits retained");
    const returned = run([ints([1]), ints([2, 4]), ints([3, 5]), ints([]), ints([]), ints([1])], [0]);
    const early = region(returned, 0); assert(early.last == 5 && hasExit(early, 3, -1) && hasExit(early, 4, -1), "return exits inside physical interval");
    const duplicate = run([ints([1]), ints([1, 1, 2, 2]), ints([])], [0]); const self = region(duplicate, 0);
    assert(self.header == 1 && self.last == 1 && listLen(self.latches) == 1 && listLen(self.exitFrom) == 1, "parallel CFG edges are canonicalized");
}
test "scalar loops: nesting and separate loops" {
    const nested = run([ints([1]), ints([2, 6]), ints([3, 4]), ints([2]), ints([5]), ints([1]), ints([7]), ints([7, 8]), ints([])], [0]);
    assert(listLen(nested.regions) == 3, "outer, inner and later loops");
    const outer = region(nested, 0); const inner = region(nested, 1); const later = region(nested, 2);
    assert(outer.header == 1 && outer.last == 5 && inner.header == 2 && inner.last == 3 && inner.parent == 0 && inner.depth == 1, "nested intervals");
    assert(later.header == 7 && later.last == 7 && later.parent == -1, "separate interval");
}
test "scalar loops: irreducible entries, resume entries and dead cycles" {
    const multiple = run([ints([1, 2]), ints([2, 3]), ints([1]), ints([])], [0]);
    assert(listLen(multiple.regions) == 0, "entry into loop interior prevents interval allocation");
    const resumed = run([ints([1]), ints([2, 3]), ints([1]), ints([])], [0, 2]);
    assert(listLen(resumed.regions) == 0, "explicit resume entry is not an ordinary back edge");
    const dead = run([ints([1]), ints([]), ints([2])], [0]); assert(listLen(dead.regions) == 0, "unreachable cycle ignored");
    const entered = run([ints([1]), ints([]), ints([2])], [0, 2]); assert(region(entered, 0).header == 2, "explicit entry makes cycle reachable");
}
test "scalar loops: work limit and malformed CFG" {
    const blocks = graph(edges([ints([1]), ints([1, 2]), ints([])]));
    const short = scalarLoops(blocks, ints([0]), 4) catch panic("limit"); assert(short.limited && listLen(short.regions) == 0, "no partial plan on exhaustion");
    const complete = scalarLoops(blocks, ints([0]), 10000) catch panic("complete budget"); let allowance = 0;
    while (allowance < complete.work) {
        const partial = scalarLoops(blocks, ints([0]), allowance) catch panic("bounded graph");
        assert(partial.limited && listLen(partial.regions) == 0, "early and late budget exhaustion return no plan"); allowance = allowance + 1;
    }
    assert(invalid(blocks, ints([0]), -1) && invalid(blocks, ints([]), 10000), "invalid configuration");
    assert(invalid(graph(edges([ints([1])])), ints([0]), 10000), "successor beyond graph");
    assert(invalid(blocks, ints([3]), 10000), "entry beyond graph");
    const second = listGet(blocks, 1) catch panic("second block"); second.first = 2; second.last = 2;
    assert(invalid(blocks, ints([0]), 10000), "noncontiguous block PCs");
    const empty = scalarLoops(listNew(), listNew(), 0) catch panic("empty graph"); assert(!empty.limited && listLen(empty.regions) == 0, "empty function graph");
}
test "scalar loops: all three-block graphs against path oracle" {
    let mask = 0;
    while (mask < 512) {
        const rows: List<List<int>> = listNew(); let owner = 0;
        while (owner < 3) {
            const row: List<int> = listNew(); let next = 0;
            while (next < 3) { if ((mask & (1 << (owner * 3 + next))) != 0) { listPush(row, next); } next = next + 1; }
            listPush(rows, row); owner = owner + 1;
        }
        verifyPaths(rows, ints([0])); verifyPaths(rows, ints([0, 2])); mask = mask + 1;
    }
}
