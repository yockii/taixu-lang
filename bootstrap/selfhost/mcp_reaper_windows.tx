// Windows owns the descendant lifetime through the existing private Job.
declare function GetCurrentProcessId(): u32 from "kernel32";
export function reaperStart(): bool { return true; }
export function reaperSelfPid(): int { return GetCurrentProcessId() as int; }
export function reaperError(): string { return ""; }
export function reaperSweep(owners: List<int>): bool { owners; return false; }
