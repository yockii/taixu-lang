// D3 v0.53：直接写在 threadSpawn 实参位置的箭头是线程入口，同 main 可直接 await
// （在本线程的执行器上就地跑泵）；它返回时取消本线程未完成的任务（挂起中的先执行已登记的 defer）。具名函数要这样
// 用，声明成 async 再包一层箭头。
async function step(tag: string, n: int): int {
    (await sleepMs(0))?;
    print(tag + " step " + toStr(n));
    return n + 1;
}

async function stuck(tag: string): void {
    defer {
        print(tag + " stuck defer");
    }
    (await sleepMs(600000))?;
}

async function work(): int {
    const a = (await step("named", 1))?;
    return (await step("named", a))?;
}

function main(args: []string): int {
    const t = threadSpawn((): int | Error => {
            detach stuck("arrow");
            const a = (await step("arrow", 10))?;
            const b = (await step("arrow", a))?;
            return b;
        });
    print("arrow result " + toStr(threadJoin(t) catch -1));
    const u = threadSpawn((): int | Error => await work());
    print("named result " + toStr(threadJoin(u) catch -1));
    return 0;
}
