// ============================================================================
// engine/mac/m_win —— objc_msgSend：-[NSWindow initWithContentRect:styleMask:backing:defer:]（NSRect 按值，K2）。
// ============================================================================

import { NSRECT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, r: NSRECT, style: usize, backing: usize, deferred: u8): usize from "/usr/lib/libobjc.A.dylib";

export function msgInitWindow(o: usize, r: NSRECT, style: int): usize {
    return objc_msgSend(o, sel_registerName("initWithContentRect:styleMask:backing:defer:"), r, style as usize, 2, 0); // NSBackingStoreBuffered
}
