// macOS 适配 M2（设计稿 v052-macos-m2-runtime E3、§四；伴文件 .toolchain、.macos）：x86_64 上 stat 与目录族须用
// 64 位 inode 版（fstatat$INODE64、opendir$INODE64、readdir$INODE64）。不带后缀的同名函数仍然导出、装载照常成功，
// 但返回旧结构（st_mode、d_namlen 的位置都不同），类型与名字会读错——本用例逐项核对：普通文件、目录、符号链接、
// 悬空符号链接、不存在的路径，以及 255 字节的长名与非 ASCII 名；另核对 removeFile 对目录报 access denied（EPERM）。
function kind(base: string, name: string): void {
    print(name + ": " + toStr(entryKind(base + "/" + name)));
}

function link(target: string, path: string): void {
    const argv: List< string> = listNew();
    listPush(argv, "-s");
    listPush(argv, target);
    listPush(argv, path);
    const code = runProcess("/bin/ln", argv, "") catch -1;
    if (code != 0) { print("ln failed: " + toStr(code)); }
}

function main(args: []string): int {
    const base = tempDir() + "/taixu-fs-macos-layout-" + toStr(monoNs());
    makeDir(base) catch (e) {
        print("makeDir failed: " + e.message);
        return 1;
    };
    let long = "";
    while (len(long) < 251) { long = long + "x"; }
    long = long + ".txt";
    writeFile(base + "/file.txt", "x") catch (e) { print("write failed"); };
    writeFile(base + "/" + long, "") catch (e) { print("write long failed"); };
    writeFile(base + "/中文名-ü.txt", "") catch (e) { print("write non-ascii failed"); };
    makeDir(base + "/dir") catch (e) { print("makeDir dir failed"); };
    link("file.txt", base + "/link");
    link("missing", base + "/dangling");

    kind(base, "file.txt");
    kind(base, "dir");
    kind(base, "link");
    kind(base, "dangling");
    kind(base, "missing");
    const names = listDir(base) catch (e) {
        print("listDir failed: " + e.message);
        return 1;
    };
    print("names: " + toStr(listLen(names)));
    let i = 0;
    while (i < listLen(names)) {
        const n = listGet(names, i) catch "";
        if (len(n) > 100) { print("  long " + toStr(len(n)) + " " + toStr(n == long)); } else { print("  " + n); }
        i = i + 1;
    }
    removeFile(base + "/dir") catch (e) { print("remove dir: " + strSub(e.message, 0, strIndexOf(e.message, ":"))); };

    const rm: List< string> = listNew();
    listPush(rm, "-rf");
    listPush(rm, base);
    const code = runProcess("/bin/rm", rm, "") catch -1;
    print("cleaned: " + toStr(code == 0 && entryKind(base) == 0));
    return 0;
}
