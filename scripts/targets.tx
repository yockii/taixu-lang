// 门与测试脚本共用的产物目标表：每个目标一行，记三元组、架构、系统、产物格式、内核对象的机器号、内嵌内核的文件名、验证分级，
// ELF 目标另记 e_flags、页长与 qemu 的环境变量。
// 门步按字段筛选目标（例如“全部 ELF 目标”），不各写一份清单；新增目标在这里加一行，按字段筛选的门步随之覆盖它。
// 分级：一级在本机宿主上跑完整门与不动点（x86_64-windows、x86_64-linux、aarch64-macos），二级每次门交叉编出产物、做结构核对，
// 实际运行只在里程碑抽样。
// 判定器不导入 bootstrap/：本表与编译器的目标表各自独立，名单不一致时按目标筛选的门步会在缺的那个目标上失败。

export struct Target {
    triple: string,
    arch: string,
    os: string,
    // 产物格式：pe、elf、macho。
    format: string,
    // 内核对象的机器号：COFF 的 Machine（x86_64 为 0x8664），其余内核都是 ELF 可重定位对象，为 e_machine。
    machine: int,
    kernel: string,
    heapKernel: string,
    // 内核里的手写例程已全部登记进函数目录（没有空洞）：链接映射不再把 runtime-manual 列为未覆盖。逐目标登记完时改这一栏（目标分层 X5）。
    manualRegistered: bool,
    tier: int,
    // ELF 产物（Linux）：e_flags 与 PT_LOAD 的对齐（页长）；非 ELF 目标为 0。
    elfFlags: int,
    elfPage: int,
    // 不在同架构宿主上时经 qemu-user 运行产物，qemu 的路径取这个环境变量；用不上 qemu 的目标为空串。
    qemuEnv: string,
}

// 内嵌内核的文件名（bootstrap/nrt-kernel/ 下）：kernel-<三元组>[-heapcheck].<扩展名>，COFF 对象为 .obj，ELF 可重定位对象为 .o。
export function kernelFile(triple: string, coff: bool, heap: bool): string {
    let name = "kernel-" + triple;
    if (heap) {
        name = name + "-heapcheck";
    }
    if (coff) {
        return name + ".obj";
    }
    return name + ".o";
}

// 三元组按“-”拆成架构与系统（用 strSplit：种子 0.3.0-beta.1 跑的脚本也能导入本表，它不认字节面的 strByteSub）。机器号为 34404
// （COFF 的 x86_64）的目标，内核是 COFF 对象；其余目标的内核是 ELF 可重定位对象。
function row(triple: string, format: string, machine: int, manualRegistered: bool, tier: int): Target {
    const parts = strSplit(triple, "-");
    const coff = machine == 34404;
    return Target { triple: triple, arch: listGet(parts, 0) catch "", os: listGet(parts, 1) catch "", format: format,
        machine: machine, kernel: kernelFile(triple, coff, false), heapKernel: kernelFile(triple, coff, true),
        manualRegistered: manualRegistered, tier: tier, elfFlags: 0, elfPage: 0, qemuEnv: "" };
}

// ELF（Linux）目标的一行：另记 e_flags、页长与 qemu 的环境变量。
function elfRow(triple: string, machine: int, manualRegistered: bool, tier: int, elfFlags: int, elfPage: int, qemuEnv: string): Target {
    const t = row(triple, "elf", machine, manualRegistered, tier);
    return Target { triple: t.triple, arch: t.arch, os: t.os, format: t.format, machine: t.machine, kernel: t.kernel, heapKernel: t.heapKernel,
        manualRegistered: t.manualRegistered, tier: t.tier, elfFlags: elfFlags, elfPage: elfPage, qemuEnv: qemuEnv };
}

// 次序同内核生成与嵌入的次序（先 x86_64 的三个，再按接入的先后）。
export function allTargets(): List<Target> {
    const out: List<Target> = listNew();
    listPush(out, row("x86_64-windows", "pe", 34404, true, 1));
    listPush(out, elfRow("x86_64-linux", 62, true, 1, 0, 4096, ""));
    listPush(out, row("x86_64-macos", "macho", 62, true, 2));
    listPush(out, row("aarch64-macos", "macho", 183, true, 1));
    listPush(out, elfRow("aarch64-linux", 183, true, 2, 0, 65536, "TAIXU_QEMU_AARCH64"));
    listPush(out, elfRow("loongarch64-linux", 258, true, 2, 67, 65536, "TAIXU_QEMU_LOONGARCH64"));
    listPush(out, elfRow("riscv64-linux", 243, true, 2, 4, 4096, "TAIXU_QEMU_RISCV64"));
    listPush(out, row("aarch64-windows", "pe", 183, true, 2));
    return out;
}

// 按格式筛选（format 为空串即全部），次序不变。
export function targetsOf(format: string): List<Target> {
    const out: List<Target> = listNew();
    for (t in allTargets()) {
        if (len(format) == 0 || t.format == format) {
            listPush(out, t);
        }
    }
    return out;
}

// 三元组 → 目标；不认识得 None。
export function targetNamed(triple: string): Target? {
    for (t in allTargets()) {
        if (t.triple == triple) {
            return t;
        }
    }
    return None;
}

// 查不到目标时的占位：三元组为空串。
export function noTarget(): Target {
    return Target { triple: "", arch: "", os: "", format: "", machine: 0, kernel: "", heapKernel: "", manualRegistered: false, tier: 0, elfFlags: 0,
        elfPage: 0, qemuEnv: "" };
}

// （系统，架构）→ 目标，例如宿主的 hostTarget()、hostArch()；没有这个组合得 noTarget()。
export function targetOn(os: string, arch: string): Target {
    for (t in allTargets()) {
        if (t.os == os && t.arch == arch) {
            return t;
        }
    }
    return noTarget();
}

// 命令行写法 → 目标：三元组，或只写系统名（x86_64 的简写，同编译器的 --target）；不认识得 noTarget()。
export function targetSpelled(s: string): Target {
    const t = targetNamed(s);
    if (t != None) {
        return t ?? noTarget();
    }
    return targetOn(s, "x86_64");
}

// 传给编译器的 --target 写法：x86_64 只写系统名，其余写三元组（与各门步原先的写法相同）。
export function targetSpelling(t: Target): string {
    if (t.arch == "x86_64") {
        return t.os;
    }
    return t.triple;
}

// 产物的可执行文件名：PE 目标加 .exe。
export function productName(t: Target, stem: string): string {
    if (t.format == "pe") {
        return stem + ".exe";
    }
    return stem;
}
