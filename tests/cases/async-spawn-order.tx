// V0.9-A1 e2e：spawn＝惰性入队 FIFO——启动序＝可观测执行序；await 挂起/恢复
//（恢复后重执行 await_fut）与嵌套 spawn 的队尾入列。
function main(args: []string): int {
    const f = job(10);
    const g = job(20);
    const w = worker(5);
    print("spawned");
    return 0;
}

async function job(n: int): int {
    print("job");
    print(toStr(n));
    return n * 2;
}

async function worker(n: int): int {
    const inner = job(n);
    const v = (await inner)?;
    print("got");
    print(toStr(v + 1));
    return v + 1;
}
