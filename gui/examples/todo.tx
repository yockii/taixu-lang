// todo —— 待办清单（实战件①——"控件 golden 通过≠开发顺畅"的
// 正面回答样本）：input 表单录入（回车/按钮双路）＋checkbox 完成态逐行勾选＋
// scrollContainer 列表滚动＋popup 行操作菜单（toggle/delete）＋stdlib fs 持久化
// （args[0] 数据文件：启动加载、保存落盘、重启回读——行格式 "D|标题"）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/todo-list.txt TAIXU_FRAME=14 TAIXU_OUT_DIR=tests/.rv-out taixu run examples/todo.tx
// 磁盘/剪贴板＝I/O 边界不进 golden 断言面（板面纪律同源）——持久化两跑
// 保存后重启应用可以读回数据。
import { Canvas, Checkbox, Button, Input, ScrollView, Popup, checkbox, drawCheckbox, button, drawButtonC, input, drawInputC, popupNew, drawPopupC, scrollDrawSimple, scrollView, inputValue, paintText, paintFillRect } from "gui/components";
import { App, appNew, appClose, pump, hitZone, onClick, onCheck, onEvent, onResize, inputOnKeys, scrollOnEvents, popupOpen, popupActive, popupResult, syncFocus, textCursor, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { fsReadLines, fsWriteAll } from "std/fs";
import { join, split } from "std/string";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvas } from "gui/text";

const ID_IN: int = 4;
const ID_ADD: int = 5;
const ID_SAVE: int = 6;
const ID_SV: int = 7;
const ID_ROW0: int = 20; // 勾选框池起点（视口槽复用——池深＝可视行数上限）
const ID_DOT0: int = 60; // 行操作菜单钮池
const MAX_ROWS: int = 16;
const ROW_H: int = 22;
const LIST_TOP: int = 48;

struct TodoModel {
    inp: Ref<Input>,
    add_btn: Ref<Button>,
    save_btn: Ref<Button>,
    titles: List<string>,
    dones: List<int>, // 0/1——与 titles 等长平行表（值语义规避结构体列表拷贝歧义）
    cbs: List<Ref<Checkbox>>,
    dots: List<Ref<Button>>,
    scroll: Ref<ScrollView>,
    popup: Ref<Popup>,
    action_row: int, // 菜单目标行（-1＝未定）
    saves: int, // 落盘计数（golden 回显动作面，不依赖磁盘内容）
    path: string,
    loaded: int, // 启动回读条数（fs 面可达性回显——空文件/缺文件＝0）
    surface: int, // 经 Ref 持有——onResize 闭包按值捕获，须过引用改写
}

function rowY(m: Ref<TodoModel>, i: int): int {
    return LIST_TOP + i * ROW_H - m.scroll.scroll_y;
}

function viewFrom(m: Ref<TodoModel>): int {
    return m.scroll.scroll_y / ROW_H;
}

// 行区自行绘制（rowY 含 scroll_y 偏移——视口槽复用模型）；滚动条 chrome
// 走 scrollDrawSimple（DX #6③——空回调样板免除）。

function doneCount(m: Ref<TodoModel>): int {
    let n: int = 0;
    let i: int = 0;
    while (i < listLen(m.dones)) {
        if ((listTryGet(m.dones, i) catch 0) == 1) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

function setDone(m: Ref<TodoModel>, i: int, on: bool): void {
    if (i < 0 || i >= listLen(m.dones)) {
        return;
    }
    let v: int = 0;
    if (on) {
        v = 1;
    }
    listSet(m.dones, i, v);
}

function addTask(m: Ref<TodoModel>, title: string): void {
    if (len(title) == 0) {
        return;
    }
    listPush(m.titles, title);
    listPush(m.dones, 0);
    m.inp.chars = listNew();
    m.inp.cursor = 0;
    m.inp.anchor = -1;
}

function saveTasks(m: Ref<TodoModel>): void {
    if (len(m.path) == 0) {
        return;
    }
    let body: string = "";
    let i: int = 0;
    while (i < listLen(m.titles)) {
        let head: string = "0";
        if ((listTryGet(m.dones, i) catch 0) == 1) {
            head = "1";
        }
        body = body + head + "|" + (listTryGet(m.titles, i) catch "") + "\n";
        i = i + 1;
    }
    fsWriteAll(m.path, body) catch (e) {
        return;
    };
    m.saves = m.saves + 1;
}

function loadTasks(m: Ref<TodoModel>): void {
    if (len(m.path) == 0) {
        return;
    }
    const emptyLines: List<string> = listNew();
    const lines: List<string> = fsReadLines(m.path) catch emptyLines;
    let i: int = 0;
    while (i < listLen(lines)) {
        const line: string = listTryGet(lines, i) catch "";
        const parts: List<string> = split(line, "|");
        if (listLen(parts) >= 2) {
            const head: string = listTryGet(parts, 0) catch "";
            let done: int = 0;
            if (len(head) > 0 && (byteTryAt(head, 0) catch 48) == 49) {
                done = 1;
            }
            const tail: List<string> = listNew();
            let k: int = 1;
            while (k < listLen(parts)) {
                listPush(tail, listTryGet(parts, k) catch "");
                k = k + 1;
            }
            listPush(m.titles, join(tail, "|"));
            listPush(m.dones, done);
        }
        i = i + 1;
    }
    m.loaded = listLen(m.titles);
}

function applyPopup(m: Ref<TodoModel>, r: int): void {
    const row: int = m.action_row;
    m.action_row = -1;
    if (r < 0 || row < 0 || row >= listLen(m.titles)) {
        return;
    }
    if (r == 0) {
        const cur: int = listTryGet(m.dones, row) catch 0;
        let on: bool = false;
        if (cur != 1) {
            on = true;
        }
        setDone(m, row, on);
        return;
    }
    // delete：平行表整表重建（受限子集无删除语义——重建＝单一事实路径）。
    const ft: List<string> = listNew();
    const fd: List<int> = listNew();
    let i: int = 0;
    while (i < listLen(m.titles)) {
        if (i != row) {
            listPush(ft, listTryGet(m.titles, i) catch "");
            listPush(fd, listTryGet(m.dones, i) catch 0);
        }
        i = i + 1;
    }
    m.titles = ft;
    m.dones = fd;
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<TodoModel>): void {
    surfaceClear(cv.h, 0x182028);
    const w: int = app.w;
    const h: int = app.h;
    paintText(cv, 8, 4, 0xC8D8E8, "taixu todo");
    m.inp.x = 8;
    m.inp.y = 20;
    m.inp.w = w - 96;
    syncFocus(app, m.inp);
    drawInputC(cv, m.inp);
    m.add_btn.x = w - 84;
    m.add_btn.y = 20;
    drawButtonC(cv, m.add_btn);
    // 行区（滚动视口内——勾选框池逐视口槽复用）。
    const view: int = viewFrom(m);
    let slot: int = 0;
    while (slot < MAX_ROWS && view + slot < listLen(m.titles)) {
        const i: int = view + slot;
        const title: string = listTryGet(m.titles, i) catch "";
        const done: int = listTryGet(m.dones, i) catch 0;
        const cb = listTryGet(m.cbs, slot) catch checkbox(ID_ROW0, 8, 0, "", false);
        cb.x = 8;
        cb.y = rowY(m, i);
        cb.checked = done == 1;
        cb.label = title;
        drawCheckbox(cv, cb);
        const dot = listTryGet(m.dots, slot) catch button(ID_DOT0, 0, 0, 14, 14, "...");
        dot.x = w - 22;
        dot.y = rowY(m, i);
        drawButtonC(cv, dot);
        hitZone(app, ID_ROW0 + slot, 8, rowY(m, i), w - 40, ROW_H);
        hitZone(app, ID_DOT0 + slot, w - 22, rowY(m, i), 14, ROW_H);
        slot = slot + 1;
    }
    paintFillRect(cv, 8, LIST_TOP + slot * ROW_H - m.scroll.scroll_y, w - 16, 1, 0x2A3642);
    // 滚动容器。
    m.scroll.x = w - 14;
    m.scroll.y = LIST_TOP;
    m.scroll.w = 12;
    m.scroll.h = h - LIST_TOP - 34;
    m.scroll.content_h = listLen(m.titles) * ROW_H;
    scrollDrawSimple(cv, m.scroll);
    // 状态行＋保存钮。
    m.save_btn.x = 8;
    m.save_btn.y = h - 26;
    drawButtonC(cv, m.save_btn);
    paintText(cv, 84, h - 22, 0x88A0B0, "tasks=" + toStr(listLen(m.titles)) + " done=" + toStr(doneCount(m)) + " loaded=" + toStr(m.loaded));
    if (popupActive(app)) {
        drawPopupC(cv, m.popup);
    }
}

export function main(args: []string): int {
    const spec = defaultSpec("taixu todo", 340, 260);
    const app = appNew(spec);
    let path: string = "";
    if (len(args) > 0) {
        path = args[0];
    }
    const m: Ref<TodoModel> = new TodoModel {
        inp: input(ID_IN, 8, 20, 200, ""),
        add_btn: button(ID_ADD, 0, 0, 76, 20, "add"),
        save_btn: button(ID_SAVE, 0, 0, 56, 18, "save"),
        titles: listNew(),
        dones: listNew(),
        cbs: listNew(),
        dots: listNew(),
        scroll: scrollView(ID_SV, 0, LIST_TOP, 12, 180, 0),
        popup: popupNew(90, 0, 0, listNew()),
        action_row: -1,
        saves: 0,
        path: path,
        loaded: 0,
        surface: surfaceOpen(spec.w, spec.h) catch 0,
    };
    const pop_items: List<string> = listNew();
    listPush(pop_items, "toggle");
    listPush(pop_items, "delete");
    m.popup.items = pop_items;
    loadTasks(m);
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };

    textCursor(app, ID_IN);
    inputOnKeys(app, m.inp, (v: string): void => {
            addTask(m, v);
        });
    onClick(app, ID_ADD, (rec: EventRecord): void => {
            addTask(m, inputValue(m.inp));
        });
    onClick(app, ID_SAVE, (rec: EventRecord): void => {
            saveTasks(m);
        });
    scrollOnEvents(app, m.scroll, (y: int): void => {
            m.scroll.scroll_y = y;
        });
    // 勾选框池＋菜单钮池（视口槽复用——handler 按槽换算视图行号）。
    let s: int = 0;
    while (s < MAX_ROWS) {
        const slot: int = s;
        const cb = checkbox(ID_ROW0 + s, 8, 0, "", false);
        listPush(m.cbs, cb);
        onCheck(app, cb, (on: bool): void => {
                setDone(m, viewFrom(m) + slot, on);
            });
        const dot = button(ID_DOT0 + s, 0, 0, 14, 14, "...");
        listPush(m.dots, dot);
        onClick(app, ID_DOT0 + s, (rec: EventRecord): void => {
                m.action_row = viewFrom(m) + slot;
                m.popup.x = rec.x - 60;
                m.popup.y = rec.y + 14;
                popupOpen(app, m.popup);
            });
        s = s + 1;
    }

    // resize 即失效：surface 随新客户区重建（counter 先例——v0.1.4 反馈 #5）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpen(w, h) catch 0;
        });

    let frame: int = 0;
    let presents: int = 0;
    let was_popup: bool = false;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvas(m.surface, app.w, app.h, fb.handle, 14);
            render(cv, app, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        const open_now: bool = popupActive(app);
        if (was_popup && !open_now) {
            applyPopup(m, popupResult(app));
        }
        was_popup = open_now;
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("tasks=" + toStr(listLen(m.titles)) + " done=" + toStr(doneCount(m)) + " saves=" + toStr(m.saves) + " loaded=" + toStr(m.loaded) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
