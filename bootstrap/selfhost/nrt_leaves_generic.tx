// 内核热叶的可移植版（rtfn 写，macOS 适配 M4 设计 A8）：语义与导出名同 nrt.tx 的 emitHotLeaves 与 __tx_strb_stat。
// - __tx_rc_base() → 计数表基址（线程块里槽表状态的第 0 项）；
// - __tx_rc_scalar_flag() → __tx_nrt_rc_flags 的低 32 位或上 1（NRT 恒报标量臂）；
// - __tx_rc_probe_counts() → 探针计数区 __tx_nrt_probe_counts 的地址；
// - __tx_native_object_address_v1(idx) → 槽表状态的对象区（第 48 字节处）＋ idx × 72，idx 取低 32 位；
// - __tx_site_of(fn, pc) → 未开泄漏检查时 0，开启时 __tx_leak_site_of(fn, pc) 的结果（手写版尾跳，这里调用后返回，实参原样转交）；
// - __tx_native_construct_stat_v1(kind)、__tx_strb_stat(mask)：开发期计数，NRT 不记，什么也不做。手写版只有一条 ret，结果寄存器
//   原样带回；这里同样不写结果（x86 上 rax 不变；A64 上 x0 不变，即实参本身）。调用方都不用结果。
// 调用约定：只保证私有约定。手写版只写 rax（对象地址另写 r10、r11，泄漏检查开启时 __tx_site_of 经 rtfn 写的 __tx_leak_site_of
// 已破坏全部易失寄存器）；可移植版在 x86 上还会写 rcx（rtOp 的第二操作数）。核查（2026-10-24）：手写的调用点都不依赖调用后
// 易失寄存器的值——runtime_memory_gen.tx 的 rcHead、rcRetain／rcRelease 通用路、listPushEmit、zeroContainer 在 __tx_rc_base／
// __tx_rc_scalar_flag／__tx_rc_probe_counts 之后只用 rax，其余从栈上重取；strConcat、strConcatAppendNrt、strbFinishGen、
// fileReadBi 在 __tx_site_of／__tx_native_object_address_v1 之后同样；strbAlloc、strbAppendPrepend、strbFinishGen 在
// __tx_strb_stat 之后从栈重取或直接返回（返回的 rax 两版相同）；object_construct.tx、object_handlers.tx（NRT 形）在
// __tx_native_construct_stat_v1、__tx_site_of、__tx_native_object_address_v1 之后只用 rax，r10 重取。其余调用方（nrt_*、
// tool_*、ffi_*、各 *_generic.tx）都是 rtfn 写的，不跨调用保值。生成代码不直接调这些例程。
import { StructuredBuffer } from "./assemble";
import { RtFn, L, I, A, G } from "./rtfn_base";
import { rtBegin, rtEnd, rtFailed, rtOp, rtLoad, rtLabel, rtIf, rtCall2, rtRet, rtRetVoid } from "./rtfn";

const MODULE: string = "bootstrap/selfhost/nrt_leaves_generic.tx";
const U32: int = 4294967295;
// 对象记录的字节数（Obj72）与槽表状态里对象区指针的偏移。
const OBJ_SIZE: int = 72;
const SLOTS_OBJECTS: int = 48;

function done(f: Ref<RtFn>, failures: List<string>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

// 什么也不做的计数入口（实参不用、结果寄存器不写）。
function noop(b: Ref<StructuredBuffer>, failures: List<string>, name: string): void {
    const f = rtBegin(b, name, "", "", 0, MODULE);
    rtRetVoid(f);
    done(f, failures);
}

/// 发出内核热叶与 __tx_strb_stat；rtfn 的失败记进 failures。t 为目标编号（这些例程不随目标变化）。
export function leavesGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, t: int): void {
    // __tx_rc_base：槽表状态是线程块字段（TB = rbx／x19 & TB_MASK），基址可能随扩容移动，每次重取。
    let f = rtBegin(b, "__tx_rc_base", "", "s", 0, MODULE);
    rtLoad(f, "s", G("__tx_nrt_slots"), 0, 8);
    rtRet(f, L("s"));
    done(f, failures);
    // __tx_rc_scalar_flag：bit0 标量臂、bit1 探针计数。NRT 恒报标量臂（线程第 4a 步：对象属一个线程）。
    f = rtBegin(b, "__tx_rc_scalar_flag", "", "v", 0, MODULE);
    rtLoad(f, "v", A("__tx_nrt_rc_flags"), 0, 4);
    rtOp(f, "v", L("v"), "or", I(1));
    rtRet(f, L("v"));
    done(f, failures);
    f = rtBegin(b, "__tx_rc_probe_counts", "", "", 0, MODULE);
    rtRet(f, A("__tx_nrt_probe_counts"));
    done(f, failures);
    // __tx_native_object_address_v1(idx) = 对象区 + idx × 72（idx 是 u32）。
    f = rtBegin(b, "__tx_native_object_address_v1", "idx", "o s", 0, MODULE);
    rtOp(f, "idx", L("idx"), "and", I(U32));
    rtOp(f, "o", L("idx"), "imul", I(OBJ_SIZE));
    rtLoad(f, "s", G("__tx_nrt_slots"), SLOTS_OBJECTS, 8);
    rtOp(f, "o", L("o"), "add", L("s"));
    rtRet(f, L("o"));
    done(f, failures);
    // __tx_site_of(fn, pc)：开关是 __tx_leak_on 的低 32 位（手写版读 dword）。
    f = rtBegin(b, "__tx_site_of", "fn pc", "on s", 2, MODULE);
    rtLoad(f, "on", A("__tx_leak_on"), 0, 4);
    rtIf(f, L("on"), "ne", I(0), "leak");
    rtRet(f, I(0));
    rtLabel(f, "leak");
    rtCall2(f, "s", "__tx_leak_site_of", L("fn"), L("pc"));
    rtRet(f, L("s"));
    done(f, failures);
    noop(b, failures, "__tx_native_construct_stat_v1");
    noop(b, failures, "__tx_strb_stat");
}
