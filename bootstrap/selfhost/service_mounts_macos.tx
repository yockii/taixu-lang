// 宿主服务的挂载表（macOS，M3 设计 G8）：getfsstat 取全部挂载，每项写成与 Linux /proc/self/mountinfo 同形的一行，
// 判定由 service_files.tx 共用（同一套本地类型、主机共享类型与最长挂载点规则）。没有 MNT_LOCAL 的挂载（smbfs、nfs、
// afpfs、webdav 等）类型前加 "nonlocal."，按未识别的类型拒绝；字段里的空白与反斜杠按 mountinfo 的八进制转义写。
declare function getfsstat(buf: Bytes, size: i32, mode: i32): i32 from "libSystem";

// struct statfs（64 位 inode 布局，x86_64 链接 getfsstat$INODE64）：2168 字节；f_flags@64、f_fstypename@72（16 字节）、
// f_mntonname@88（1024 字节）、f_mntfromname@1112（1024 字节）。
const STATFS_BYTES: int = 2168;
const MNT_LOCAL: int = 4096;
const MNT_NOWAIT: int = 2;

function u32at(b: Bytes, at: int): int {
    let n = 0; let i = 0; while (i < 4) { n = n | ((bytesGet(b, at + i) catch 0) << (i * 8)); i = i + 1; } return n;
}
// 定长字段里 NUL 结尾的串，按 mountinfo 的写法转义空白与反斜杠；不合法的 UTF-8 得空串（整张表随之作废）。
function field(b: Bytes, at: int, max: int): string {
    const out = bytesNew(0); let i = 0;
    while (i < max) {
        const c = bytesGet(b, at + i) catch 0;
        if (c == 0) { break; }
        if (c == 32 || c == 9 || c == 10 || c == 92) {
            bytesPush(out, 92); bytesPush(out, 48 + (c >> 6)); bytesPush(out, 48 + ((c >> 3) & 7)); bytesPush(out, 48 + (c & 7));
        } else { bytesPush(out, c); }
        i = i + 1;
    }
    return bytesToStr(out) catch "";
}
/// 挂载表文本；取不到或有字段不合法时为空串（服务按“无法核验本地挂载表”拒绝启动）。
export function serviceMountTable(): string {
    let cap = 64;
    while (cap <= 16384) {
        const buf = bytesNew(cap * STATFS_BYTES);
        const n = getfsstat(buf, (cap * STATFS_BYTES) as i32, MNT_NOWAIT as i32) as int;
        if (n < 0) { return ""; }
        if (n < cap) {
            let text = ""; let k = 0;
            while (k < n) {
                const at = k * STATFS_BYTES;
                let kind = field(buf, at + 72, 16);
                const point = field(buf, at + 88, 1024);
                const source = field(buf, at + 1112, 1024);
                if (len(kind) == 0 || len(point) == 0) { return ""; }
                if ((u32at(buf, at + 64) & MNT_LOCAL) == 0) { kind = "nonlocal." + kind; }
                let from = source; if (len(from) == 0) { from = "none"; }
                text = text + toStr(k) + " 0 0:0 / " + point + " rw - " + kind + " " + from + " rw\n";
                k = k + 1;
            }
            return text;
        }
        cap = cap * 4;
    }
    return "";
}
