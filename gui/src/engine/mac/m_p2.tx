// ============================================================================
// engine/mac/m_p2 —— objc_msgSend：id(id, SEL, id, id)。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: usize, b: usize): usize from "/usr/lib/libobjc.A.dylib";

export function msgPP(o: usize, s: string, a: usize, b: usize): usize {
    return objc_msgSend(o, sel_registerName(s), a, b);
}
