// Bytes 字段（D3 v0.46，Linux）：外部结构体的 Bytes 字段是数据区指针（同 Bytes 参数：调用期间有效、C 端可写，长度由调用方另放
// 字段）。writev 从两个 iovec 的 Bytes 字段写出，readv 把管道里的字节分散读进另两个 Bytes 字段（C 写的是 Bytes 自己的数据区，
// 拷回时跳过该字段）；同一个 Bytes 放进两个字段各借一次、调用后借用解除，之后照常改长度。
declare struct IOVEC { base: Bytes, len: usize }
declare struct IOV2 { a: IOVEC, b: IOVEC }
declare function pipe(fds: Bytes): i32 from "libc.so.6";
declare function writev(fd: i32, iov: Ref<IOV2>, n: i32): isize from "libc.so.6";
declare function readv(fd: i32, iov: Ref<IOV2>, n: i32): isize from "libc.so.6";
declare function close(fd: i32): i32 from "libc.so.6";

function fdAt(b: Bytes, at: int): i32 {
    const v = (bytesGet(b, at) catch 0) + (bytesGet(b, at + 1) catch 0) * 256;
    return v as i32;
}

function main(args: []string): int {
    const fds = bytesNew(8);
    if (pipe(fds) != 0) {
        print("pipe failed");
        return 1;
    }
    const head = bytesFromStr("hello");
    const tail = bytesFromStr(" world");
    const w = new IOV2 { a: IOVEC { base: head, len: bytesLen(head) as usize }, b: IOVEC { base: tail, len: bytesLen(tail) as usize } };
    const n = writev(fdAt(fds, 4), w, 2);
    close(fdAt(fds, 4));
    const first = bytesNew(4);
    const rest = bytesNew(16);
    const r = new IOV2 { a: IOVEC { base: first, len: 4 }, b: IOVEC { base: rest, len: 16 } };
    const m = readv(fdAt(fds, 0), r, 2);
    close(fdAt(fds, 0));
    print("wrote " + toStr(n) + " read " + toStr(m));
    print("first [" + (bytesToStr(first) catch "?") + "] rest [" + (bytesToStr(bytesSlice(rest, 0, (m as int) - 4)) catch "?") + "]");
    print("len kept " + toStr(r.a.len) + " " + toStr(r.b.len));
    // 同一个 Bytes 放进两个字段：两次借用按后进先出恢复，调用后能照常改长度。
    const fds2 = bytesNew(8);
    pipe(fds2);
    const twice = bytesFromStr("ab");
    const t = new IOV2 { a: IOVEC { base: twice, len: 2 }, b: IOVEC { base: twice, len: 2 } };
    print("twice " + toStr(writev(fdAt(fds2, 4), t, 2)));
    close(fdAt(fds2, 4));
    close(fdAt(fds2, 0));
    bytesPush(twice, 99);
    print("after " + toStr(bytesLen(twice)));
    return 0;
}
