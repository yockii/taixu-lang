// dbg_info.tx —— 调试构建的变量表记录器（第 6 轮 6c-4a，调试实施设计 §四-3）。
//
// codegen 只在调试构建时调用这里：函数开始时 dvFnBegin，块与 for 语句开合作用域，绑定落槽后登记，
// 函数写回时 dvFnFinish 把本函数的表交给 DbgInfo。正常构建不调用，DbgInfo 保持全空。
// 一个变量四项（槽, 类型, 起 pc, 止 pc），名字另成平行表；止 pc 不含。
// - let/const：起点是落槽的 move 之后，止点是所在作用域（块、for 语句）的结尾；
// - 参数与闭包捕获：整个函数；catch 绑定：处理块；switch 臂绑定：该臂。
// - 名字以 # 开头的是改写出的隐藏绑定（for-in 的 #itN、#nvN 等），不记。
import { DbgInfo } from "./program_context";

let dvInfo: Ref<DbgInfo> = new DbgInfo { vars: listNew(), varNames: listNew(), tysK: listNew(), tysA: listNew(), tysB: listNew(), tyNames: listNew(), declFSeb: listNew(), declVSeb: listNew(), declVCnt: listNew(), sebStructs: listNew(), sebEnums: listNew() };
// 本函数已登记的变量（四项一组）与名字；止 pc 为 −1 表示待定（作用域结尾或函数结尾）。
let dvVars: List<int> = listNew();
let dvNames: List<string> = listNew();
// 待定止点的变量在本函数表里的序号，按作用域入栈；dvMarks 记每层作用域打开时 dvOpen 的长度。
let dvOpen: List<int> = listNew();
let dvMarks: List<int> = listNew();

function dvInts(): List<int> { return listNew(); }
function dvStrs(): List<string> { return listNew(); }

export function dbgInfoEmpty(): Ref<DbgInfo> {
    return new DbgInfo { vars: listNew(), varNames: listNew(), tysK: listNew(), tysA: listNew(), tysB: listNew(), tyNames: listNew(), declFSeb: listNew(), declVSeb: listNew(), declVCnt: listNew(), sebStructs: listNew(), sebEnums: listNew() };
}

// 一次 generate 开始时调用（正常构建也调用，只是清空）。
export function dvReset(): void {
    dvInfo = dbgInfoEmpty();
    dvFnBegin();
}

export function dvFnBegin(): void {
    dvVars = dvInts();
    dvNames = dvStrs();
    dvOpen = dvInts();
    dvMarks = dvInts();
}

export function dvScopeOpen(): void {
    listPush(dvMarks, listLen(dvOpen));
}

// 关闭最内层作用域：其中登记的 let/const 止于 pc。
export function dvScopeClose(pc: int): void {
    const n = listLen(dvMarks);
    if (n == 0) { return; }
    const mark = listGet(dvMarks, n - 1) catch 0;
    listRemoveAt(dvMarks, n - 1);
    while (listLen(dvOpen) > mark) {
        const top = listLen(dvOpen) - 1;
        const at = listGet(dvOpen, top) catch 0;
        listRemoveAt(dvOpen, top);
        listSet(dvVars, at * 4 + 3, pc);
    }
}

function dvHidden(name: string): bool {
    if (len(name) == 0) { return true; }
    return (byteAt(name, 0) catch 35) == 35;
}

function dvPush(slot: int, name: string, ty: int, start: int, end: int): int {
    listPush(dvVars, slot);
    listPush(dvVars, ty);
    listPush(dvVars, start);
    listPush(dvVars, end);
    listPush(dvNames, name);
    return listLen(dvNames) - 1;
}

// let/const：从 start 起，到当前作用域结尾止。
export function dvLocal(slot: int, name: string, ty: int, start: int): void {
    if (dvHidden(name)) { return; }
    const at = dvPush(slot, name, ty, start, -1);
    if (listLen(dvMarks) > 0) { listPush(dvOpen, at); }
}

export function dvRange(slot: int, name: string, ty: int, start: int, end: int): void {
    if (dvHidden(name)) { return; }
    dvPush(slot, name, ty, start, end);
}

// 参数与闭包捕获：整个函数。
export function dvWhole(slot: int, name: string, ty: int): void {
    dvRange(slot, name, ty, 0, -1);
}

// 函数写回（emFinishAt）：未关的作用域与待定的止点都止于函数末尾，本函数的表放到 fn 表序 idx。
export function dvFnFinish(idx: int, codeLen: int): void {
    while (listLen(dvMarks) > 0) { dvScopeClose(codeLen); }
    let i = 3;
    while (i < listLen(dvVars)) {
        if ((listGet(dvVars, i) catch 0) < 0) { listSet(dvVars, i, codeLen); }
        i = i + 4;
    }
    while (listLen(dvInfo.vars) <= idx) {
        listPush(dvInfo.vars, dvInts());
        listPush(dvInfo.varNames, dvStrs());
    }
    listSet(dvInfo.vars, idx, dvVars);
    listSet(dvInfo.varNames, idx, dvNames);
    dvFnBegin();
}

// 一个 decl 建好时调用（与 codegen 的 decl 表同序）：各字段的 SEB1 类型、变体字段的 SEB1 类型（摊平）、每个变体的字段数。
export function dvDecl(fields: List<int>, varFields: List<int>, varCounts: List<int>): void {
    listPush(dvInfo.declFSeb, fields);
    listPush(dvInfo.declVSeb, varFields);
    listPush(dvInfo.declVCnt, varCounts);
}

// SEB1 的结构号或枚举号 sebIdx 登记为 decl。
export function dvSebDecl(isEnum: bool, sebIdx: int, decl: int): void {
    let xs = dvInfo.sebStructs;
    if (isEnum) { xs = dvInfo.sebEnums; }
    while (listLen(xs) <= sebIdx) { listPush(xs, -1); }
    listSet(xs, sebIdx, decl);
}

export function dvSetTypes(k: List<int>, a: List<int>, b: List<int>, names: List<string>): void {
    dvInfo.tysK = k;
    dvInfo.tysA = a;
    dvInfo.tysB = b;
    dvInfo.tyNames = names;
}

export function dvTake(): Ref<DbgInfo> {
    return dvInfo;
}
