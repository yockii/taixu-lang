// 第 5 轮 FFI（D3 v0.23，Windows）：回调——顶层函数作 C 函数指针传给外部函数，经蹦床回到太虚。
// qsort 的比较函数里再调外部函数读内存（嵌套登记回调窗口），首次比较时再调一个带回调的外部函数
// （回调里的回调）；CallWindowProcW 的 4 个实参（句柄、u32、usize、isize）；EnumResourceLanguagesW
// 的 5 个实参（第 5 个在栈上，含 u16）。
declare type HWND;
declare type HMODULE;
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "ucrtbase";
declare function RtlMoveMemory(dst: Bytes, src: usize, n: usize): void from "kernel32";
declare function CallWindowProcW(proc: (HWND, u32, usize, isize) => isize, h: HWND, msg: u32, wp: usize, lp: isize): isize from "user32";
declare function GetModuleHandleW(name: wstr): HMODULE? from "kernel32";
declare function EnumResourceLanguagesW(m: HMODULE, typ: usize, name: usize, cb: (HMODULE, usize, usize, u16, isize) => i32, lp: isize): i32 from "kernel32";

let compares = 0;
let nested = 0;
let langs = 0;
let langArgsOk = true;

function u32At(addr: usize): int {
    const tmp = bytesNew(4);
    RtlMoveMemory(tmp, addr, 4);
    return (bytesGet(tmp, 0) catch 0) + (bytesGet(tmp, 1) catch 0) * 256 + (bytesGet(tmp, 2) catch 0) * 65536 + (bytesGet(tmp, 3) catch 0) * 16777216;
}

function byValue(a: usize, b: usize): i32 {
    compares = compares + 1;
    if (compares == 1) { nested = CallWindowProcW(proc, handleFromBits < HWND > (1), 1, 1, 1) as int; }
    const x = u32At(a);
    const y = u32At(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

function proc(h: HWND, msg: u32, wp: usize, lp: isize): isize {
    return (lp as int * 2 + wp as int + msg as int + handleBits(h)) as isize;
}

function onLang(m: HMODULE, typ: usize, name: usize, lang: u16, lp: isize): i32 {
    langs = langs + 1;
    if (typ != 16 || name != 1 || lp != 42 || lang == 0) { langArgsOk = false; }
    return 1;
}

function main(args: []string): int {
    const vals = [5, 3, 9, 1, 7, 2];
    const buf = bytesNew(24);
    let i = 0;
    while (i < 6) {
        bytesSet(buf, i * 4, vals[i]);
        i = i + 1;
    }
    qsort(buf, 6, 4, byValue);
    let out = "";
    i = 0;
    while (i < 6) {
        out = out + toStr(bytesGet(buf, i * 4) catch -1) + " ";
        i = i + 1;
    }
    print("sorted " + out + toStr(compares > 0) + " nested " + toStr(nested));
    print("wndproc " + toStr(CallWindowProcW(proc, handleFromBits < HWND > (77), 4660, 99, -5)));
    const k32 = GetModuleHandleW("kernel32.dll");
    if (k32 != None) {
        const r = EnumResourceLanguagesW(k32 catch handleFromBits < HMODULE > (0), 16, 1, onLang, 42);
        print("langs " + toStr(r != 0) + " " + toStr(langs >= 1) + " " + toStr(langArgsOk));
    }
    return 0;
}
