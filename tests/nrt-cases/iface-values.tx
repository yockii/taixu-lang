// D3 v0.20 接口值：结构化实现、装箱位置、动态分派、Ref 接收者、泛型接口。
interface Shape {
    area(): float;
    name(): string;
}

interface Counter {
    bump(by: int): int;
}

interface Comparable<T> {
    compare(other: T): int;
}

struct Circle { r: float }
struct Square { side: float }
struct Tally { n: int }

function circleArea(c: Circle): float { return 3.0 * c.r * c.r; }
function circleName(c: Circle): string { return "circle"; }
function squareArea(q: Square): float { return q.side * q.side; }
function squareName(q: Square): string { return "square"; }
function tallyBump(t: Ref< Tally>, by: int): int {
    t.n = t.n + by;
    return t.n;
}
function intCompare(a: int, b: int): int { return a - b; }

struct Scene { main: Shape, extra: Shape? }

function describe(s: Shape): string {
    return s.name() + "=" + toStr(s.area());
}

function pick(big: bool): Shape {
    if (big) { return Square { side: 10.0 }; }
    return Circle { r: 1.0 };
}

function firstOf<T>(xs: List< T>): T {
    return listGet(xs, 0) catch panic("空");
}

function main(args: []string): int {
    const c = Circle { r: 1.0 };
    const s1: Shape = c;
    print(describe(s1));
    print(describe(Square { side: 2.0 }));
    print(describe(pick(true)));

    const shapes: List< Shape> = listNew();
    listPush(shapes, Circle { r: 2.0 });
    listPush(shapes, Square { side: 3.0 });
    listPush(shapes, s1);
    listSet(shapes, 2, Square { side: 1.0 });
    let total: float = 0.0;
    for (sh in shapes) {
        total = total + sh.area();
    }
    print(toStr(total));
    print(firstOf(shapes).name());

    const sc = Scene { main: c, extra: None };
    print(sc.main.name());
    const sc2 = Scene { main: s1, extra: Square { side: 4.0 } };
    const ex = sc2.extra catch s1;
    print(describe(ex));

    const t = new Tally { n: 0 };
    const k: Counter = t;
    k.bump(2);
    k.bump(3);
    print(toStr(t.n));

    const cmp: Comparable< int> = 7;
    print(toStr(cmp.compare(3)));

    const mk = (big: bool): Shape => pick(big);
    print(mk(false).name());
    return 0;
}
