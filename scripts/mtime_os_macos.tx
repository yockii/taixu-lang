// 协议端到端测试取文件与目录的修改时间（导出面同 mtime_os_windows.tx）：macOS 经 libSystem 的 stat（x86_64 上编译器按 Apple 头文件
// 链接 stat$INODE64，64 位 inode 的结构布局），跟随符号链接（同 Python 的 Path.stat）；得纳秒。
declare function stat(path: string, buf: Bytes): i32 from "libSystem";

// struct stat（64 位 inode）：st_mtimespec（i64 秒、i64 纳秒）在 48；整个结构 144 字节。
const MTIME_AT: int = 48;

// path 的修改时间；取不到得 −1。
export function mtimeOf(path: string): int {
    const buf = bytesNew(144);
    if (stat(path, buf) != 0) {
        return -1;
    }
    const sec = bytesGetLE<int>(buf, MTIME_AT) ?? -1;
    const nsec = bytesGetLE<int>(buf, MTIME_AT + 8) ?? 0;
    return sec * 1000000000 + nsec;
}
