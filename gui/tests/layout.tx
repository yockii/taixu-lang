// layout —— flex 布局恒等探针（臂②；#16）：
// gui/layout.tx 的确定性布局以固定的预期几何表检查，
// 包含 W3C flexbox 子集的 22 例布局；
// 逐例比较几何四元组 (x,y,w,h)，
// 预期值独立于被测函数。
//
// 确定性校验（纯函数——无窗口无事件循环，主程序对形态）：
//   taixu run tests/layout.tx
import { nodeNew, styleDefault, resolve, JUSTIFY_FLEX_END, JUSTIFY_CENTER, JUSTIFY_SPACE_BETWEEN, ALIGN_CENTER, ALIGN_FLEX_END, LayoutBox, Style, Edges } from "gui/layout";

let g_fail: int = 0;
let g_case: int = 0;

/// 跨例共享样式取数面（每例函数各自取新值——S1 值语义下无隐式耦合）。
function styleGrow1(): Style {
    let s: Style = styleDefault();
    s.grow = 1;
    return s;
}

function wantBox(x: int, y: int, w: int, h: int): Ref<LayoutBox> {
    return new LayoutBox { x: x, y: y, w: w, h: h };
}

function w1(x: int, y: int, w: int, h: int): List<Ref<LayoutBox>> {
    const l: List<Ref<LayoutBox>> = listNew();
    listPush(l, wantBox(x, y, w, h));
    return l;
}

function w2(x0: int, y0: int, w0: int, h0: int, x1: int, y1: int, w1v: int, h1v: int): List<Ref<LayoutBox>> {
    const l: List<Ref<LayoutBox>> = listNew();
    listPush(l, wantBox(x0, y0, w0, h0));
    listPush(l, wantBox(x1, y1, w1v, h1v));
    return l;
}

function w3(x0: int, y0: int, w0: int, h0: int, x1: int, y1: int, w1v: int, h1v: int, x2: int, y2: int, w2v: int, h2v: int): List<Ref<LayoutBox>> {
    const l: List<Ref<LayoutBox>> = listNew();
    listPush(l, wantBox(x0, y0, w0, h0));
    listPush(l, wantBox(x1, y1, w1v, h1v));
    listPush(l, wantBox(x2, y2, w2v, h2v));
    return l;
}

/// 逐盒断言（want 不含根盒）。
function check(name: string, got: List<Ref<LayoutBox>>, want: List<Ref<LayoutBox>>): void {
    g_case = g_case + 1;
    const gn: int = listLen(got) - 1;
    const wn: int = listLen(want);
    if (gn != wn) {
        print("case " + toStr(g_case) + " FAIL " + name + ": count got=" + toStr(gn) + " want=" + toStr(wn));
        g_fail = g_fail + 1;
        return;
    }
    let i: int = 0;
    while (i < wn) {
        const g2 = listTryGet(got, i + 1) catch wantBox(-1, -1, -1, -1);
        const w2 = listTryGet(want, i) catch wantBox(-1, -1, -1, -1);
        if (g2.x != w2.x || g2.y != w2.y || g2.w != w2.w || g2.h != w2.h) {
            print("case " + toStr(g_case) + " FAIL " + name + ": box " + toStr(i) + " got=(" + toStr(g2.x) + "," + toStr(g2.y) + "," + toStr(g2.w) + "," + toStr(g2.h) + ") want=(" + toStr(w2.x) + "," + toStr(w2.y) + "," + toStr(w2.w) + "," + toStr(w2.h) + ")");
            g_fail = g_fail + 1;
            return;
        }
        i = i + 1;
    }
    print("case " + toStr(g_case) + " ok " + name);
}

// —— 逐例函数（每例一函数，减少 main 帧占用）——

function case1(): void {
    // 1. grow 均分（跨 100 偶分）。
    let s1: Style = styleDefault();
    s1.grow = 1;
    const root1 = nodeNew(styleDefault());
    listPush(root1.children, nodeNew(s1));
    listPush(root1.children, nodeNew(s1));
    check("grow even", resolve(root1, 100, 50), w2(0, 0, 50, 50, 50, 0, 50, 50));
}

function case2(): void {
    // 2. grow 1:3＋奇数余量左→右 +1（101 = 26 : 75）。
    let s2a: Style = styleDefault();
    s2a.grow = 1;
    let s2b: Style = styleDefault();
    s2b.grow = 3;
    const root2 = nodeNew(styleDefault());
    listPush(root2.children, nodeNew(s2a));
    listPush(root2.children, nodeNew(s2b));
    check("grow 1:3 odd", resolve(root2, 101, 50), w2(0, 0, 26, 50, 26, 0, 75, 50));
}

function case3(): void {
    // 3. shrink 权重＝shrink×basis＋余量 +1（deficit 40 → 23/17）。
    let s3a: Style = styleDefault();
    s3a.width = 80;
    let s3b: Style = styleDefault();
    s3b.width = 60;
    const root3 = nodeNew(styleDefault());
    listPush(root3.children, nodeNew(s3a));
    listPush(root3.children, nodeNew(s3b));
    check("shrink weights", resolve(root3, 100, 50), w2(0, 0, 57, 50, 57, 0, 43, 50));
}

function case4(): void {
    // 4. min-width 钳制→冻结→重分配循环（§9.7 违例冻结）。
    let s4a: Style = styleDefault();
    s4a.width = 90;
    s4a.min_w = 80;
    let s4b: Style = styleDefault();
    s4b.width = 30;
    const root4 = nodeNew(styleDefault());
    listPush(root4.children, nodeNew(s4a));
    listPush(root4.children, nodeNew(s4b));
    check("min-width freeze", resolve(root4, 100, 50), w2(0, 0, 80, 50, 80, 0, 20, 50));
}

function case5(): void {
    // 5. max-width 钳制→grow 重分配（40/60）。
    let s5a: Style = styleDefault();
    s5a.grow = 1;
    s5a.max_w = 40;
    let s5b: Style = styleDefault();
    s5b.grow = 1;
    const root5 = nodeNew(styleDefault());
    listPush(root5.children, nodeNew(s5a));
    listPush(root5.children, nodeNew(s5b));
    check("max-width clamp", resolve(root5, 100, 50), w2(0, 0, 40, 50, 40, 0, 60, 50));
}

function case6(): void {
    // 6. flex-basis 优先于 width（§9.4 假想主尺寸）。
    let s6: Style = styleDefault();
    s6.basis = 40;
    s6.width = 20;
    const root6 = nodeNew(styleDefault());
    listPush(root6.children, nodeNew(s6));
    check("basis over width", resolve(root6, 100, 50), w1(0, 0, 40, 50));
}

function case7(): void {
    // 7. flex_end。
    let s7: Style = styleDefault();
    s7.width = 30;
    let js7: Style = styleDefault();
    js7.justify = JUSTIFY_FLEX_END;
    const root7 = nodeNew(js7);
    listPush(root7.children, nodeNew(s7));
    check("justify flex-end", resolve(root7, 100, 50), w1(70, 0, 30, 50));
}

function case8(): void {
    // 8. center（floor 取整）。
    let s8: Style = styleDefault();
    s8.width = 31;
    let js8: Style = styleDefault();
    js8.justify = JUSTIFY_CENTER;
    const root8 = nodeNew(js8);
    listPush(root8.children, nodeNew(s8));
    check("justify center", resolve(root8, 100, 50), w1(34, 0, 31, 50));
}

function case9(): void {
    // 9. space_between＋余量左→右（101 宽三子 → 间隙 36/35）。
    let s9: Style = styleDefault();
    s9.width = 10;
    let js9: Style = styleDefault();
    js9.justify = JUSTIFY_SPACE_BETWEEN;
    const root9 = nodeNew(js9);
    listPush(root9.children, nodeNew(s9));
    listPush(root9.children, nodeNew(s9));
    listPush(root9.children, nodeNew(s9));
    check("justify space-between", resolve(root9, 101, 50), w3(0, 0, 10, 50, 46, 0, 10, 50, 91, 0, 10, 50));
}

function case10(): void {
    // 10. gap（主轴固定间隙）。
    let s10: Style = styleDefault();
    s10.width = 20;
    let js10: Style = styleDefault();
    js10.gap = 10;
    const root10 = nodeNew(js10);
    listPush(root10.children, nodeNew(s10));
    listPush(root10.children, nodeNew(s10));
    listPush(root10.children, nodeNew(s10));
    check("gap", resolve(root10, 100, 50), w3(0, 0, 20, 50, 30, 0, 20, 50, 60, 0, 20, 50));
}

function case11(): void {
    // 11. padding 内缩内容盒（§7 盒模型）。
    let js11: Style = styleDefault();
    js11.padding = Edges { top: 5, right: 10, bottom: 5, left: 10 };
    const root11 = nodeNew(js11);
    listPush(root11.children, nodeNew(styleGrow1()));
    check("padding", resolve(root11, 100, 50), w1(10, 5, 80, 40));
}

function case12(): void {
    // 12. 子 margin 参与主轴账目（§7）。
    let s12: Style = styleDefault();
    s12.width = 30;
    s12.margin = Edges { top: 0, right: 10, bottom: 0, left: 10 };
    const root12 = nodeNew(styleDefault());
    listPush(root12.children, nodeNew(s12));
    check("child margin", resolve(root12, 100, 50), w1(10, 0, 30, 50));
}

function case13(): void {
    // 13. grow＋margin：自由空间扣除 margin 后分配。
    let s13: Style = styleDefault();
    s13.grow = 1;
    s13.margin = Edges { top: 0, right: 10, bottom: 0, left: 10 };
    const root13 = nodeNew(styleDefault());
    listPush(root13.children, nodeNew(s13));
    check("grow with margin", resolve(root13, 100, 50), w1(10, 0, 80, 50));
}

function case14(): void {
    // 14. align center。
    let s14: Style = styleDefault();
    s14.width = 30;
    s14.height = 20;
    let js14: Style = styleDefault();
    js14.align_items = ALIGN_CENTER;
    const root14 = nodeNew(js14);
    listPush(root14.children, nodeNew(s14));
    check("align center", resolve(root14, 100, 50), w1(0, 15, 30, 20));
}

function case15(): void {
    // 15. align flex_end。
    let js15: Style = styleDefault();
    js15.align_items = ALIGN_FLEX_END;
    const root15 = nodeNew(js15);
    let s15: Style = styleDefault();
    s15.width = 30;
    s15.height = 20;
    listPush(root15.children, nodeNew(s15));
    check("align flex-end", resolve(root15, 100, 50), w1(0, 30, 30, 20));
}

function case16(): void {
    // 16. stretch＋max 钳制。
    let s16: Style = styleDefault();
    s16.grow = 1;
    s16.max_h = 30;
    const root16 = nodeNew(styleDefault());
    listPush(root16.children, nodeNew(s16));
    check("stretch max-h", resolve(root16, 100, 50), w1(0, 0, 100, 30));
}

function case17(): void {
    // 17. align-self 覆盖 align-items。
    let s17a: Style = styleDefault();
    s17a.width = 20;
    s17a.height = 20;
    s17a.align_self = ALIGN_FLEX_END;
    let s17b: Style = styleDefault();
    s17b.width = 20;
    s17b.height = 20;
    let js17: Style = styleDefault();
    js17.align_items = ALIGN_CENTER;
    const root17 = nodeNew(js17);
    listPush(root17.children, nodeNew(s17a));
    listPush(root17.children, nodeNew(s17b));
    check("align-self override", resolve(root17, 100, 50), w2(0, 30, 20, 20, 20, 15, 20, 20));
}

function case18(): void {
    // 18. column：主轴纵向 grow＋交叉 stretch。
    let s18a: Style = styleDefault();
    s18a.grow = 1;
    let s18b: Style = styleDefault();
    s18b.height = 30;
    let js18: Style = styleDefault();
    js18.direction = 1;
    const root18 = nodeNew(js18);
    listPush(root18.children, nodeNew(s18a));
    listPush(root18.children, nodeNew(s18b));
    check("column", resolve(root18, 100, 80), w2(0, 0, 100, 50, 0, 50, 100, 30));
}

function case19(): void {
    // 19. 嵌套容器：A 定宽含 padding，其子 grow 填充 A 的内容盒。
    let js19a: Style = styleDefault();
    js19a.width = 50;
    js19a.padding = Edges { top: 2, right: 10, bottom: 2, left: 10 };
    let nodeA = nodeNew(js19a);
    listPush(nodeA.children, nodeNew(styleGrow1()));
    let js19b: Style = styleDefault();
    js19b.grow = 1;
    const root19 = nodeNew(styleDefault());
    listPush(root19.children, nodeA);
    listPush(root19.children, nodeNew(js19b));
    check("nested", resolve(root19, 100, 50), w3(0, 0, 50, 50, 10, 2, 30, 46, 50, 0, 50, 50));
}

function case20(): void {
    // 20. 零尺寸 auto 子（无 grow 无定值 → 0 宽，flex_start 起点堆叠）。
    const root20 = nodeNew(styleDefault());
    listPush(root20.children, nodeNew(styleDefault()));
    listPush(root20.children, nodeNew(styleDefault()));
    check("auto zero", resolve(root20, 100, 50), w2(0, 0, 0, 50, 0, 0, 0, 50));
}

function case21(): void {
    // 21. 确定性：同树两次布局逐盒恒等（纯函数性）。
    let js21: Style = styleDefault();
    js21.gap = 5;
    let s21a: Style = styleDefault();
    s21a.grow = 1;
    let s21b: Style = styleDefault();
    s21b.width = 25;
    const root21 = nodeNew(js21);
    listPush(root21.children, nodeNew(s21a));
    listPush(root21.children, nodeNew(s21b));
    const a21: List<Ref<LayoutBox>> = resolve(root21, 100, 40);
    const b21: List<Ref<LayoutBox>> = resolve(root21, 100, 40);
    let same: bool = listLen(a21) == listLen(b21);
    let i21: int = 0;
    while (same && i21 < listLen(a21)) {
        const ba = listTryGet(a21, i21) catch wantBox(-1, -1, -1, -1);
        const bb = listTryGet(b21, i21) catch wantBox(-2, -2, -2, -2);
        if (ba.x != bb.x || ba.y != bb.y || ba.w != bb.w || ba.h != bb.h) {
            same = false;
        }
        i21 = i21 + 1;
    }
    g_case = g_case + 1;
    if (same) {
        print("case " + toStr(g_case) + " ok determinism");
    } else {
        print("case " + toStr(g_case) + " FAIL determinism");
        g_fail = g_fail + 1;
    }
}

function case22(): void {
    // 22. 固定＋grow 混合（A 定宽 30，B 填余量）。
    let s22a: Style = styleDefault();
    s22a.width = 30;
    const root22 = nodeNew(styleDefault());
    listPush(root22.children, nodeNew(s22a));
    listPush(root22.children, nodeNew(styleGrow1()));
    check("fixed+grow", resolve(root22, 100, 50), w2(0, 0, 30, 50, 30, 0, 70, 50));
}

export function main(args: []string): int {
    args;
    case1();
    case2();
    case3();
    case4();
    case5();
    case6();
    case7();
    case8();
    case9();
    case10();
    case11();
    case12();
    case13();
    case14();
    case15();
    case16();
    case17();
    case18();
    case19();
    case20();
    case21();
    case22();
    // 汇总：22 例几何均须与预期表一致。
    print("layout probe: " + toStr(g_case - g_fail) + "/" + toStr(g_case) + " ok");
    if (g_fail > 0) {
        return 1;
    }
    return 0;
}
