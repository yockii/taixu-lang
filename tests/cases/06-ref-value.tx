struct Point { x: int, y: int }
export function main(args: []string): int {
    const r: Ref<Point> = new Point { x: 1, y: 2 };
    r.x = 10;
    const r2: Ref<Point> = r;
    r2.y = 20;
    const same: bool = r == r2;
    let copy: Point = unref(r);
    copy.x = 99;
    print("ref=" + toStr(r.x) + "," + toStr(r.y) + "," + toStr(same));
    print("copy=" + toStr(copy.x) + "," + toStr(copy.y));
    let p: Point = Point { x: 3, y: 4 };
    const q: Point = p;
    p.y = 100;
    print("val=" + toStr(q.y) + "," + toStr(p.y));
    print("noteq=" + toStr(p == q));
    return 0;
}
