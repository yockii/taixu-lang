// lsp-zh.tx —— LSP 基准夹具（第 6 轮 6d-0）：同一行里中文串之后的标识符，测 utf-16 与 utf-8 两种列。
export struct Point {
    x: int,
    y: int,
}

export function dist(p: Ref< Point>): int {
    return p.x + p.y;
}

export function main(args: []string): int {
    const p: Ref< Point> = new Point { x: 1, y: 2 };
    print("距离：" + toStr(dist(p)));
    let total: int = dist(p);
    total = total + 1;
    return total;
}
