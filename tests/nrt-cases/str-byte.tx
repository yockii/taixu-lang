// D3 v0.44 字符串的字节面：strByteSub 取字节区间、strByteIndexOf 取字节下标，与 len、byteAt 同一单位。
// 向量覆盖 ASCII、中文（3 字节）、emoji（4 字节）、空串、整串、首尾边界，以及与码点面 strSub／strIndexOf 的对照。
export function main(args: []string): int {
    const s = "ab太虚😀c";
    print("len=" + toStr(len(s)));
    print("[" + strByteSub(s, 0, 2) + "] [" + strByteSub(s, 2, 3) + "] [" + strByteSub(s, 5, 3) + "] [" + strByteSub(s, 8, 4) + "] [" + strByteSub(s, 12, 1) + "]");
    print("empty=[" + strByteSub(s, 0, 0) + "] end=[" + strByteSub(s, len(s), 0) + "] all=" + toStr(strByteSub(s, 0, len(s)) == s));
    print("idx 虚=" + toStr(strByteIndexOf(s, "虚")) + " 😀=" + toStr(strByteIndexOf(s, "😀")) + " c=" + toStr(strByteIndexOf(s, "c")) + " none=" + toStr(strByteIndexOf(s, "x")) + " empty=" + toStr(strByteIndexOf(s, "")));
    print("码点面 虚=" + toStr(strIndexOf(s, "虚")) + " 😀=" + toStr(strIndexOf(s, "😀")) + " strSub(s,2,2)=" + strSub(s, 2, 2));
    // 查到的下标直接交给 strByteSub：取扩展名、去扩展名。
    const name = "测试文件.tx";
    const dot = strByteIndexOf(name, ".");
    print("stem=" + strByteSub(name, 0, dot) + " ext=" + strByteSub(name, dot, len(name) - dot));
    print("empty-haystack=" + toStr(strByteIndexOf("", "a")) + " " + toStr(strByteIndexOf("", "")) + " [" + strByteSub("", 0, 0) + "]");
    return 0;
}
