// std/file、std/fs 在 Linux 上随架构而变的部分（各架构版导出面相同）：取文件信息、改名、打开目录的标志。
// x86_64 版：newfstatat／fstat，struct stat 为 x86_64 布局（144 字节：st_mode 为偏移 24 的 u32，st_size 在 48，st_mtime 在
// 88、纳秒在 96）；改名用 renameat；O_DIRECTORY 为 0x10000。
declare function lxNewfstatat(dir: int, path: string, st: Bytes, flags: int): int from syscall "newfstatat";
declare function lxFstat(fd: int, st: Bytes): int from syscall "fstat";
declare function lxRenameat(odir: int, src: string, ndir: int, dst: string): int from syscall "renameat";

const AT_FDCWD: int = -100;
export const STAT_BUF: int = 144;
// O_RDONLY｜O_DIRECTORY｜O_CLOEXEC
export const OPEN_DIR: int = 589824;

// statPath、statFd、renamePath 返回 0 或 -errno；st 至少 STAT_BUF 字节。路径跟随符号链接。
export function statPath(path: string, st: Bytes): int {
    return lxNewfstatat(AT_FDCWD, path, st, 0);
}

export function statFd(fd: int, st: Bytes): int {
    return lxFstat(fd, st);
}

export function stMode(st: Bytes): int {
    return (bytesGetLE<u32>(st, 24) ?? 0) as int;
}

export function stSize(st: Bytes): int {
    return bytesGetLE<int>(st, 48) ?? -1;
}

export function stMtimeSec(st: Bytes): int {
    return bytesGetLE<int>(st, 88) ?? 0;
}

export function stMtimeNsec(st: Bytes): int {
    return bytesGetLE<int>(st, 96) ?? 0;
}

export function renamePath(src: string, dst: string): int {
    return lxRenameat(AT_FDCWD, src, AT_FDCWD, dst);
}
