// D3 v0.51 §6.9-2：listGet／listPop／byteAt 返回 T、越界即 trap；对结果写 ?? 默认值、catch、后缀 ? 的旧写法
// 报 3002 并给出改写（可能越界改用 listTryGet／listTryPop／byteTryAt，确定在界内就去掉默认值）。兼容变更 lang.list-index-trap。
function firstOr(xs: List<int>): int {
    return listGet(xs, 0) ?? 0;
}

function lastOr(xs: List<int>): int {
    return listPop(xs) catch -1;
}

function head(s: string): int? {
    const c = byteAt(s, 0)?;
    return c;
}

export function main(args: []string): int {
    return 0;
}
