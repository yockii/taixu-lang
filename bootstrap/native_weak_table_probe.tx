// Test-only export of the unchanged weak-table kernel for allocator fault injection (security review v0.2, roadmap 1).
// arm64 只有可移植版（A64 内核全为 rtfn），同一个驱动核对。
import { weakTableEmit } from "./selfhost/weak_table";
import { weakTableGenericEmit } from "./selfhost/weak_table_generic";
import { probeBuffer, probeWrite } from "./native_probe_object";
import { targetParseAnalysis, tA64 } from "./selfhost/target";
function main(args: []string): int {
    if (len(args) != 3 || args[0] != "--target") { return 64; }
    const t = targetParseAnalysis(args[1]);
    if (t < 0) { return 64; }
    const buf = probeBuffer(t);
    if (tA64(t)) {
        const failures: List<string> = listNew(); weakTableGenericEmit(buf, failures);
        if (listLen(failures) > 0) { eprint(listGet(failures, 0) catch ""); return 66; }
    } else { weakTableEmit(buf); }
    const exports: List<string> = listNew();
    listPush(exports, "__tx_native_weak_link_v1"); listPush(exports, "__tx_native_weak_unlink_v1");
    listPush(exports, "__tx_native_weak_notify_v1"); listPush(exports, "__tx_native_weak_destroy_v1");
    return probeWrite(buf, t, args[2], exports);
}
