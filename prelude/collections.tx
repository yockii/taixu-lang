// 太虚编译器自带 prelude：集合（D3 v0.20 §6.19）。
// 程序用到这里导出的名字（Map、Set、mapNew、Hashable、intHash……）时，编译器把本模块隐式导入；
// 同名的用户声明或显式导入优先。编译器在构建时把本文件嵌入自身（同 NRT 内核）。
//
// 实现：插入序条目表（键、值、哈希、是否存活）＋开放寻址索引表（存条目序号＋1，0＝空）。
// 删除只把条目标为不存活，不存活过半时整表重建；迭代按条目表顺序＝插入序。
// Map/Set 本身只含一个 Ref，赋值与传参共享同一张表（句柄语义，同 List）。

export interface Hashable {
    hash(): int;
}

// —— 内建类型的 hash（方法语法：x.hash() 即 intHash(x) 等）——

export function intHash(x: int): int {
    return x;
}

// 定宽整数（O4 第二步）：转 int 后同 intHash；u64/usize 按位环绕成 int。f32 不提供（同 float）。
export function i8Hash(x: i8): int {
    return x as int;
}

export function i16Hash(x: i16): int {
    return x as int;
}

export function i32Hash(x: i32): int {
    return x as int;
}

export function u8Hash(x: u8): int {
    return x as int;
}

export function u16Hash(x: u16): int {
    return x as int;
}

export function u32Hash(x: u32): int {
    return x as int;
}

export function u64Hash(x: u64): int {
    return wrapTo < int > (x);
}

export function isizeHash(x: isize): int {
    return x as int;
}

export function usizeHash(x: usize): int {
    return wrapTo < int > (x);
}

export function boolHash(b: bool): int {
    if (b) { return 1; }
    return 0;
}

// FNV-1a（64 位，乘法用 imul 环绕）。
export function stringHash(s: string): int {
    let h: int = -3750763034362895579;
    let i: int = 0;
    const n = len(s);
    while (i < n) {
        h = h ^ (byteAt(s, i) catch 0);
        h = imul(h, 1099511628211);
        i = i + 1;
    }
    return h;
}

export function bytesHash(b: Bytes): int {
    let h: int = -3750763034362895579;
    let i: int = 0;
    const n = bytesLen(b);
    while (i < n) {
        h = h ^ (bytesGet(b, i) catch 0);
        h = imul(h, 1099511628211);
        i = i + 1;
    }
    return h;
}

// 把用户给的哈希再打散一次（弱哈希如 intHash 也能均匀落到索引表）。
function mixHash(x: int): int {
    let h = x ^ (x >>> 33);
    h = imul(h, -49064778989728563);
    h = h ^ (h >>> 33);
    h = imul(h, -4265267296055464877);
    return h ^ (h >>> 33);
}

struct HashTable < K, V > {
    keys: List< K>,
    vals: List< V>,
    hashes: List< int>,
    live: List< bool>,
    slots: List< int>,
    count: int,
    dead: int,
}

export struct Map < K, V > { t: Ref< HashTable< K, V>> }

export struct Set < T > { t: Ref< HashTable< T, bool>> }

function tableNew < K, V > (): Ref< HashTable< K, V>> {
    return new HashTable < K, V > { keys: listNew(), vals: listNew(), hashes: listNew(), live: listNew(), slots: listNew(), count: 0, dead: 0 };
}

// 找键所在条目；没有返回 -1。
function tableFind < K, V > (t: Ref< HashTable< K, V>>, k: K, h: int): int {
    const cap = listLen(t.slots);
    if (cap == 0) { return -1; }
    let i = h & (cap - 1);
    while (true) {
        const e = listGet(t.slots, i) catch 0;
        if (e == 0) { return -1; }
        const ei = e - 1;
        if ((listGet(t.live, ei) catch false) && (listGet(t.hashes, ei) catch 0) == h) {
            const kk = listGet(t.keys, ei) catch panic("prelude: 条目越界");
            if (kk == k) { return ei; }
        }
        i = (i + 1) & (cap - 1);
    }
    return -1;
}

function slotsInsert(slots: List< int>, h: int, entry: int): void {
    const cap = listLen(slots);
    let i = h & (cap - 1);
    while ((listGet(slots, i) catch 0) != 0) {
        i = (i + 1) & (cap - 1);
    }
    listSet(slots, i, entry + 1);
}

// 去掉不存活条目并按新容量重建索引表（容量为 2 的幂，装载率不超过 3/4）。
function tableRebuild < K, V > (t: Ref< HashTable< K, V>>): void {
    const nk: List< K> = listNew();
    const nv: List< V> = listNew();
    const nh: List< int> = listNew();
    const nl: List< bool> = listNew();
    let i: int = 0;
    while (i < listLen(t.keys)) {
        if (listGet(t.live, i) catch false) {
            listPush(nk, listGet(t.keys, i) catch panic("prelude: 条目越界"));
            listPush(nv, listGet(t.vals, i) catch panic("prelude: 条目越界"));
            listPush(nh, listGet(t.hashes, i) catch 0);
            listPush(nl, true);
        }
        i = i + 1;
    }
    let cap: int = 8;
    while ((listLen(nk) + 1) * 4 > cap * 3) { cap = cap * 2; }
    const slots: List< int> = listNew();
    let j: int = 0;
    while (j < cap) {
        listPush(slots, 0);
        j = j + 1;
    }
    let e: int = 0;
    while (e < listLen(nk)) {
        slotsInsert(slots, listGet(nh, e) catch 0, e);
        e = e + 1;
    }
    t.keys = nk;
    t.vals = nv;
    t.hashes = nh;
    t.live = nl;
    t.slots = slots;
    t.dead = 0;
}

// 放入或覆盖；返回是否新加入。
function tablePut < K, V > (t: Ref< HashTable< K, V>>, k: K, v: V, h: int): bool {
    const ei = tableFind(t, k, h);
    if (ei >= 0) {
        listSet(t.vals, ei, v);
        return false;
    }
    if ((listLen(t.keys) + 1) * 4 > listLen(t.slots) * 3) { tableRebuild(t); }
    const idx = listLen(t.keys);
    listPush(t.keys, k);
    listPush(t.vals, v);
    listPush(t.hashes, h);
    listPush(t.live, true);
    slotsInsert(t.slots, h, idx);
    t.count = t.count + 1;
    return true;
}

function tableRemove < K, V > (t: Ref< HashTable< K, V>>, k: K, h: int): bool {
    const ei = tableFind(t, k, h);
    if (ei < 0) { return false; }
    listSet(t.live, ei, false);
    t.count = t.count - 1;
    t.dead = t.dead + 1;
    if (t.dead * 2 > listLen(t.keys)) { tableRebuild(t); }
    return true;
}

function tableKeys < K, V > (t: Ref< HashTable< K, V>>): List< K> {
    const out: List< K> = listNew();
    let i: int = 0;
    while (i < listLen(t.keys)) {
        if (listGet(t.live, i) catch false) { listPush(out, listGet(t.keys, i) catch panic("prelude: 条目越界")); }
        i = i + 1;
    }
    return out;
}

function tableClear < K, V > (t: Ref< HashTable< K, V>>): void {
    t.keys = listNew();
    t.vals = listNew();
    t.hashes = listNew();
    t.live = listNew();
    t.slots = listNew();
    t.count = 0;
    t.dead = 0;
}

// —— Map<K, V> ——

export function mapNew < K extends Hashable, V > (): Map < K, V > {
    return Map < K, V > { t: tableNew() };
}

export function mapSet < K extends Hashable, V > (m: Map < K, V >, k: K, v: V): void {
    tablePut(m.t, k, v, mixHash(k.hash()));
}

export function mapGet < K extends Hashable, V > (m: Map < K, V >, k: K): V? {
    const ei = tableFind(m.t, k, mixHash(k.hash()));
    if (ei < 0) { return None; }
    return listGet(m.t.vals, ei);
}

export function mapHas < K extends Hashable, V > (m: Map < K, V >, k: K): bool {
    return tableFind(m.t, k, mixHash(k.hash())) >= 0;
}

export function mapRemove < K extends Hashable, V > (m: Map < K, V >, k: K): bool {
    return tableRemove(m.t, k, mixHash(k.hash()));
}

export function mapLen < K, V > (m: Map < K, V >): int {
    return m.t.count;
}

export function mapKeys < K, V > (m: Map < K, V >): List< K> {
    return tableKeys(m.t);
}

export function mapValues < K, V > (m: Map < K, V >): List< V> {
    const t = m.t;
    const out: List< V> = listNew();
    let i: int = 0;
    while (i < listLen(t.vals)) {
        if (listGet(t.live, i) catch false) { listPush(out, listGet(t.vals, i) catch panic("prelude: 条目越界")); }
        i = i + 1;
    }
    return out;
}

export function mapClear < K, V > (m: Map < K, V >): void {
    tableClear(m.t);
}

// —— Set<T> ——

export function setNew < T extends Hashable > (): Set < T > {
    return Set < T > { t: tableNew() };
}

export function setAdd < T extends Hashable > (s: Set < T >, x: T): bool {
    return tablePut(s.t, x, true, mixHash(x.hash()));
}

export function setHas < T extends Hashable > (s: Set < T >, x: T): bool {
    return tableFind(s.t, x, mixHash(x.hash())) >= 0;
}

export function setRemove < T extends Hashable > (s: Set < T >, x: T): bool {
    return tableRemove(s.t, x, mixHash(x.hash()));
}

export function setLen < T > (s: Set < T >): int {
    return s.t.count;
}

export function setToList < T > (s: Set < T >): List< T> {
    return tableKeys(s.t);
}

export function setClear < T > (s: Set < T >): void {
    tableClear(s.t);
}
