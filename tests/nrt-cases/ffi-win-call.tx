// 第 5 轮 FFI 调用（D3 v0.23，Windows）：from "库" 的外部函数经调用桩与 PE 导入表调用——定宽整数
// 实参与返回（i32 负值符号扩展、u32、usize、u64）、int/float、f32 往返、5～6 个实参（栈传参）、
// 整数与浮点混排、string/wstr 实参与返回（NULL 返回得空串、非法 UTF-8 替换为 U+FFFD）、Bytes 输出
// 缓冲、可空句柄（返回 None、传 None）、ffiLastError 取 GetLastError。
declare type HANDLE;
declare type HMODULE;
declare type OVERLAPPED;
declare function lstrlenA(s: string): i32 from "kernel32";
declare function lstrlenW(s: wstr): i32 from "kernel32";
declare function MulDiv(a: i32, b: i32, c: i32): i32 from "kernel32";
declare function SetLastError(code: u32): void from "kernel32";
declare function GetCurrentProcessId(): u32 from "kernel32";
declare function GetTickCount64(): u64 from "kernel32";
declare function GetModuleHandleA(name: string): HMODULE? from "kernel32";
declare function GetStdHandle(n: i32): HANDLE? from "kernel32";
declare function WriteFile(h: HANDLE, buf: Bytes, n: u32, written: Bytes, ov: OVERLAPPED?): i32 from "kernel32";
declare function GetEnvironmentVariableA(name: string, buf: Bytes, size: u32): u32 from "kernel32";
declare function SetEnvironmentVariableA(name: string, value: string): i32 from "kernel32";
declare function MultiByteToWideChar(cp: u32, flags: u32, src: string, n: i32, dst: Bytes, cap: i32): i32 from "kernel32";
declare function lstrcatA(dst: Bytes, src: string): string from "kernel32";
declare function lstrcpyW(dst: Bytes, src: wstr): wstr from "kernel32";
declare function GetCommandLineW(): wstr from "kernel32";
declare function sqrt(x: f64): f64 from "ucrtbase";
declare function sqrtf(x: f32): f32 from "ucrtbase";
declare function ldexp(x: float, e: i32): float from "ucrtbase";
declare function fma(a: f64, b: f64, c: f64): f64 from "ucrtbase";
declare function llabs(x: int): int from "ucrtbase";
declare function strlen(s: string): usize from "ucrtbase";
declare function getenv(name: string): string from "ucrtbase";
declare function _putenv(kv: string): i32 from "ucrtbase";

function main(args: []string): int {
    print("lenA " + toStr(lstrlenA("hello")) + " lenW " + toStr(lstrlenW("héllo太虚")));
    print("muldiv " + toStr(MulDiv(10, 20, 3)) + " " + toStr(MulDiv(-10, 20, 3)));
    SetLastError(1234);
    print("err " + toStr(ffiLastError()));
    print("pid " + toStr(GetCurrentProcessId() > 0) + " tick " + toStr(GetTickCount64() > 0));
    const none = GetModuleHandleA("taixu_no_such_module.dll");
    print("module none " + toStr(none == None) + " err " + toStr(ffiLastError()));
    const k32 = GetModuleHandleA("kernel32.dll");
    print("module k32 " + toStr(k32 != None));
    const h = GetStdHandle(-11);
    if (h != None) {
        const msg = bytesFromStr("via WriteFile\n");
        const w = bytesNew(4);
        const ok = WriteFile(h catch handleFromBits < HANDLE > (0), msg, bytesLen(msg) as u32, w, None);
        print("wrote " + toStr(ok != 0) + " " + toStr(bytesGet(w, 0) catch -1));
    }
    print("setenv " + toStr(SetEnvironmentVariableA("TAIXU_FFI_T", "v1-ok") != 0));
    const buf = bytesNew(64);
    const n = GetEnvironmentVariableA("TAIXU_FFI_T", buf, 64);
    print("getenv " + toStr(n) + " " + (bytesToStr(bytesSlice(buf, 0, n as int)) catch "?"));
    const wide = bytesNew(64);
    print("mb2wc " + toStr(MultiByteToWideChar(65001, 0, "héllo太虚", -1, wide, 32)));
    print("wcopy " + lstrcpyW(bytesNew(64), "héllo太虚"));
    const bad = bytesNew(16);
    bytesSet(bad, 0, 255);
    bytesSet(bad, 1, 97);
    print("cat " + lstrcatA(bad, "b"));
    print("sqrt " + toStr(sqrt(2.0)) + " " + toStr(sqrtf(2.0) as float));
    print("ldexp " + toStr(ldexp(1.5, 4)) + " fma " + toStr(fma(2.0, 3.0, 1.0)));
    print("llabs " + toStr(llabs(-5000000000)));
    print("strlen " + toStr(strlen("abcdef") as int));
    print("crt " + toStr(_putenv("TAIXU_FFI_U=abc")) + " " + getenv("TAIXU_FFI_U") + " [" + getenv("TAIXU_FFI_NOPE") + "]");
    print("cmd " + toStr(len(GetCommandLineW()) > 0));
    return 0;
}
