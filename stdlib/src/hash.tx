// ============================================================================
// std/hash —— SHA-256（FIPS 180-4；V0.38-S3；STD-08）。纯 .tx。
//
// **V0.39-G0 位运算原生重写（弧 G1-c 清单——"设计起点即位运算原生"的兑现）**：
// V0.38 落地时 S1 无位运算，AND/XOR 经算术位分解承载（32 位逐位提取，每
// 位一循环——能用但慢，"快速计算/加密"诉求未兑现）；D3 v0.14 位运算落地
// 后退役分解层，六原语改原生算子直译（& ^ ~ >>> << |——32 位域内 O(1)）。
// **FIPS 180-4 语义零变更**：官方三向量复锚（tests/hash-fx.tx）逐位不变
//（纯实现替换——摘要函数的输出即契约）。i64 承载 u32 语义（& MASK32 收
// 口）。md5 维持排除（FIPS 降位——完整性校验场景以 sha256 承载）。
// ============================================================================

const MOD: int = 4294967296;
const MASK32: int = 4294967295;

function addm(a: int, b: int): int {
    return (a + b) & MASK32; // 原生：加法 + 32 位掩码（a+b ≤ 2^33 零 i64 溢出）
}

function shr32(x: int, n: int): int {
    return x >>> n; // 原生逻辑右移（值域恒 u32 域内——签名即契约）
}

// rotr：32 位循环右移（shl 丢位即自然环绕；| 并两半位域）。
function rotr(x: int, n: int): int {
    return ((x >>> n) | (x << (32 - n))) & MASK32;
}

// bitXor：原生异或（u32 域内值 xor 恒 u32 域内——正性保持）。
function bitXor(a: int, b: int): int {
    return a ^ b;
}

// bitAnd：原生与。
function bitAnd(a: int, b: int): int {
    return a & b;
}

// bitNot：32 位取反（~ 全宽取反后 32 位收口）。
function bitNot(a: int): int {
    return (~a) & MASK32;
}

// kTable：64 轮常量（FIPS 180-4 §4.2.3 官方字面表，逐值十六进制）。
function kTable(): List<int> {
    const ks: List<int> = listNew();
    listPush(ks, 1116352408);
    listPush(ks, 1899447441);
    listPush(ks, 3049323471);
    listPush(ks, 3921009573);
    listPush(ks, 961987163);
    listPush(ks, 1508970993);
    listPush(ks, 2453635748);
    listPush(ks, 2870763221);
    listPush(ks, 3624381080);
    listPush(ks, 310598401);
    listPush(ks, 607225278);
    listPush(ks, 1426881987);
    listPush(ks, 1925078388);
    listPush(ks, 2162078206);
    listPush(ks, 2614888103);
    listPush(ks, 3248222580);
    listPush(ks, 3835390401);
    listPush(ks, 4022224774);
    listPush(ks, 264347078);
    listPush(ks, 604807628);
    listPush(ks, 770255983);
    listPush(ks, 1249150122);
    listPush(ks, 1555081692);
    listPush(ks, 1996064986);
    listPush(ks, 2554220882);
    listPush(ks, 2821834349);
    listPush(ks, 2952996808);
    listPush(ks, 3210313671);
    listPush(ks, 3336571891);
    listPush(ks, 3584528711);
    listPush(ks, 113926993);
    listPush(ks, 338241895);
    listPush(ks, 666307205);
    listPush(ks, 773529912);
    listPush(ks, 1294757372);
    listPush(ks, 1396182291);
    listPush(ks, 1695183700);
    listPush(ks, 1986661051);
    listPush(ks, 2177026350);
    listPush(ks, 2456956037);
    listPush(ks, 2730485921);
    listPush(ks, 2820302411);
    listPush(ks, 3259730800);
    listPush(ks, 3345764771);
    listPush(ks, 3516065817);
    listPush(ks, 3600352804);
    listPush(ks, 4094571909);
    listPush(ks, 275423344);
    listPush(ks, 430227734);
    listPush(ks, 506948616);
    listPush(ks, 659060556);
    listPush(ks, 883997877);
    listPush(ks, 958139571);
    listPush(ks, 1322822218);
    listPush(ks, 1537002063);
    listPush(ks, 1747873779);
    listPush(ks, 1955562222);
    listPush(ks, 2024104815);
    listPush(ks, 2227730452);
    listPush(ks, 2361852424);
    listPush(ks, 2428436474);
    listPush(ks, 2756734187);
    listPush(ks, 3204031479);
    listPush(ks, 3329325298);
    return ks;
}

// hInit：初始哈希值（FIPS 180-4 §5.3.3——官方字面）。
function hInit(): List<int> {
    const hs: List<int> = listNew();
    listPush(hs, 1779033703);
    listPush(hs, 3144134277);
    listPush(hs, 1013904242);
    listPush(hs, 2773480762);
    listPush(hs, 1359893119);
    listPush(hs, 2600822924);
    listPush(hs, 528734635);
    listPush(hs, 1541459225);
    return hs;
}

// sha256Bytes：消息（byteAt 字节面）→ 32 字节摘要（0..255 值列表）。
export function sha256Bytes(msg: string): List<int> {
    const K = kTable();
    const h = hInit();
    // 1) 填充：msg + 0x80 + zeros + 64 位大端长度（FIPS §5.1）。
    const ml = len(msg) * 8;
    const padded: List<int> = listNew();
    let i: int = 0;
    while (i < len(msg)) {
        listPush(padded, byteAt(msg, i) catch 0);
        i = i + 1;
    }
    listPush(padded, 128);
    while (listLen(padded) % 64 != 56) {
        listPush(padded, 0);
    }
    let shift = 56;
    while (shift >= 0) {
        listPush(padded, (ml >>> shift) & 0xFF);
        shift = shift - 8;
    }
    // 2) 压缩（FIPS §6.2）。
    const w: List<int> = listNew();
    let block: int = 0;
    const nblocks = listLen(padded) / 64;
    while (block < nblocks) {
        listClear(w);
        let t: int = 0;
        while (t < 16) {
            const base = block * 64 + t * 4;
            listPush(w, (listGet(padded, base) catch 0) * 16777216
                + (listGet(padded, base + 1) catch 0) * 65536
                + (listGet(padded, base + 2) catch 0) * 256
                + (listGet(padded, base + 3) catch 0));
            t = t + 1;
        }
        while (t < 64) {
            const w15 = listGet(w, t - 15) catch 0;
            const s0 = bitXor(bitXor(rotr(w15, 7), rotr(w15, 18)), shr32(w15, 3));
            const w2 = listGet(w, t - 2) catch 0;
            const s1 = bitXor(bitXor(rotr(w2, 17), rotr(w2, 19)), shr32(w2, 10));
            listPush(w, addm(addm(listGet(w, t - 16) catch 0, s0), addm(listGet(w, t - 7) catch 0, s1)));
            t = t + 1;
        }
        let a = listGet(h, 0) catch 0;
        let b = listGet(h, 1) catch 0;
        let c = listGet(h, 2) catch 0;
        let d = listGet(h, 3) catch 0;
        let e = listGet(h, 4) catch 0;
        let f = listGet(h, 5) catch 0;
        let g = listGet(h, 6) catch 0;
        let hh = listGet(h, 7) catch 0;
        t = 0;
        while (t < 64) {
            const S1 = bitXor(bitXor(rotr(e, 6), rotr(e, 11)), rotr(e, 25));
            const ch = bitXor(bitAnd(e, f), bitAnd(bitNot(e), g));
            const temp1 = addm(addm(addm(addm(hh, S1), ch), listGet(K, t) catch 0), listGet(w, t) catch 0);
            const S0 = bitXor(bitXor(rotr(a, 2), rotr(a, 13)), rotr(a, 22));
            const maj = bitXor(bitXor(bitAnd(a, b), bitAnd(a, c)), bitAnd(b, c));
            const temp2 = addm(S0, maj);
            hh = g;
            g = f;
            f = e;
            e = addm(d, temp1);
            d = c;
            c = b;
            b = a;
            a = addm(temp1, temp2);
            t = t + 1;
        }
        setAt(h, 0, addm(listGet(h, 0) catch 0, a));
        setAt(h, 1, addm(listGet(h, 1) catch 0, b));
        setAt(h, 2, addm(listGet(h, 2) catch 0, c));
        setAt(h, 3, addm(listGet(h, 3) catch 0, d));
        setAt(h, 4, addm(listGet(h, 4) catch 0, e));
        setAt(h, 5, addm(listGet(h, 5) catch 0, f));
        setAt(h, 6, addm(listGet(h, 6) catch 0, g));
        setAt(h, 7, addm(listGet(h, 7) catch 0, hh));
        block = block + 1;
    }
    // 3) 摘要字节（8 字大端）。
    const out: List<int> = listNew();
    i = 0;
    while (i < 8) {
        const v = listGet(h, i) catch 0;
        let sh = 24;
        while (sh >= 0) {
            listPush(out, (v >>> sh) & 0xFF);
            sh = sh - 8;
        }
        i = i + 1;
    }
    return out;
}

function listClear(xs: List<int>): void {
    while (listLen(xs) > 0) {
        listPop(xs) catch 0;
    }
}

function setAt(xs: List<int>, i: int, v: int): void {
    listSet(xs, i, v);
}

// sha256Hex：小写十六进制摘要（64 字符）。
export function sha256Hex(msg: string): string {
    const digest = sha256Bytes(msg);
    const digits = "0123456789abcdef";
    let out: string = "";
    let i: int = 0;
    while (i < listLen(digest)) {
        const b = listGet(digest, i) catch 0;
        out = out + (utf8Encode(byteAt(digits, b / 16) catch 48) catch "");
        out = out + (utf8Encode(byteAt(digits, b % 16) catch 48) catch "");
        i = i + 1;
    }
    return out;
}
