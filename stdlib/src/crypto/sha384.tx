// SHA-384, FIPS 180-4 §§4.1.3, 4.2.3, 5.3.4, 6.4, 6.5. Pure Taixu.
// All additions deliberately wrap in the 64-bit word domain.
function rotate(x: u64, n: int): u64 { return (x >>> n) | (x << (64 - n)); }

function constants(): List<u64> {
    const out: List<u64> = listNew();
    listPush(out, 0x428a2f98d728ae22); listPush(out, 0x7137449123ef65cd); listPush(out, 0xb5c0fbcfec4d3b2f); listPush(out, 0xe9b5dba58189dbbc);
    listPush(out, 0x3956c25bf348b538); listPush(out, 0x59f111f1b605d019); listPush(out, 0x923f82a4af194f9b); listPush(out, 0xab1c5ed5da6d8118);
    listPush(out, 0xd807aa98a3030242); listPush(out, 0x12835b0145706fbe); listPush(out, 0x243185be4ee4b28c); listPush(out, 0x550c7dc3d5ffb4e2);
    listPush(out, 0x72be5d74f27b896f); listPush(out, 0x80deb1fe3b1696b1); listPush(out, 0x9bdc06a725c71235); listPush(out, 0xc19bf174cf692694);
    listPush(out, 0xe49b69c19ef14ad2); listPush(out, 0xefbe4786384f25e3); listPush(out, 0x0fc19dc68b8cd5b5); listPush(out, 0x240ca1cc77ac9c65);
    listPush(out, 0x2de92c6f592b0275); listPush(out, 0x4a7484aa6ea6e483); listPush(out, 0x5cb0a9dcbd41fbd4); listPush(out, 0x76f988da831153b5);
    listPush(out, 0x983e5152ee66dfab); listPush(out, 0xa831c66d2db43210); listPush(out, 0xb00327c898fb213f); listPush(out, 0xbf597fc7beef0ee4);
    listPush(out, 0xc6e00bf33da88fc2); listPush(out, 0xd5a79147930aa725); listPush(out, 0x06ca6351e003826f); listPush(out, 0x142929670a0e6e70);
    listPush(out, 0x27b70a8546d22ffc); listPush(out, 0x2e1b21385c26c926); listPush(out, 0x4d2c6dfc5ac42aed); listPush(out, 0x53380d139d95b3df);
    listPush(out, 0x650a73548baf63de); listPush(out, 0x766a0abb3c77b2a8); listPush(out, 0x81c2c92e47edaee6); listPush(out, 0x92722c851482353b);
    listPush(out, 0xa2bfe8a14cf10364); listPush(out, 0xa81a664bbc423001); listPush(out, 0xc24b8b70d0f89791); listPush(out, 0xc76c51a30654be30);
    listPush(out, 0xd192e819d6ef5218); listPush(out, 0xd69906245565a910); listPush(out, 0xf40e35855771202a); listPush(out, 0x106aa07032bbd1b8);
    listPush(out, 0x19a4c116b8d2d0c8); listPush(out, 0x1e376c085141ab53); listPush(out, 0x2748774cdf8eeb99); listPush(out, 0x34b0bcb5e19b48a8);
    listPush(out, 0x391c0cb3c5c95a63); listPush(out, 0x4ed8aa4ae3418acb); listPush(out, 0x5b9cca4f7763e373); listPush(out, 0x682e6ff3d6b2b8a3);
    listPush(out, 0x748f82ee5defb2fc); listPush(out, 0x78a5636f43172f60); listPush(out, 0x84c87814a1f0ab72); listPush(out, 0x8cc702081a6439ec);
    listPush(out, 0x90befffa23631e28); listPush(out, 0xa4506cebde82bde9); listPush(out, 0xbef9a3f7b2c67915); listPush(out, 0xc67178f2e372532b);
    listPush(out, 0xca273eceea26619c); listPush(out, 0xd186b8c721c0c207); listPush(out, 0xeada7dd6cde0eb1e); listPush(out, 0xf57d4f7fee6ed178);
    listPush(out, 0x06f067aa72176fba); listPush(out, 0x0a637dc5a2c898a6); listPush(out, 0x113f9804bef90dae); listPush(out, 0x1b710b35131c471b);
    listPush(out, 0x28db77f523047d84); listPush(out, 0x32caab7b40c72493); listPush(out, 0x3c9ebe0a15c9bebc); listPush(out, 0x431d67c49c100d4c);
    listPush(out, 0x4cc5d4becb3e42b6); listPush(out, 0x597f299cfc657e2a); listPush(out, 0x5fcb6fab3ad6faec); listPush(out, 0x6c44198c4a475817);
    return out;
}

function compress(h: List<u64>, k: List<u64>, w: List<u64>, data: Bytes, offset: int): void {
    let t = 0;
    while (t < 16) { listSet(w, t, bytesGetBE<u64>(data, offset + t * 8) catch panic("sha384: block bounds")); t = t + 1; }
    while (t < 80) {
        const x = listGet(w, t - 15); const y = listGet(w, t - 2);
        const s0 = rotate(x, 1) ^ rotate(x, 8) ^ (x >>> 7);
        const s1 = rotate(y, 19) ^ rotate(y, 61) ^ (y >>> 6);
        listSet(w, t, wrapAdd(wrapAdd(listGet(w, t - 16), s0), wrapAdd(listGet(w, t - 7), s1))); t = t + 1;
    }
    let a = listGet(h, 0); let b = listGet(h, 1); let c = listGet(h, 2); let d = listGet(h, 3);
    let e = listGet(h, 4); let f = listGet(h, 5); let g = listGet(h, 6); let hh = listGet(h, 7); t = 0;
    while (t < 80) {
        const s1 = rotate(e, 14) ^ rotate(e, 18) ^ rotate(e, 41); const ch = (e & f) ^ ((~e) & g);
        const t1 = wrapAdd(wrapAdd(wrapAdd(hh, s1), ch), wrapAdd(listGet(k, t), listGet(w, t)));
        const s0 = rotate(a, 28) ^ rotate(a, 34) ^ rotate(a, 39); const maj = (a & b) ^ (a & c) ^ (b & c);
        const t2 = wrapAdd(s0, maj);
        hh = g; g = f; f = e; e = wrapAdd(d, t1); d = c; c = b; b = a; a = wrapAdd(t1, t2); t = t + 1;
    }
    listSet(h, 0, wrapAdd(listGet(h, 0), a)); listSet(h, 1, wrapAdd(listGet(h, 1), b));
    listSet(h, 2, wrapAdd(listGet(h, 2), c)); listSet(h, 3, wrapAdd(listGet(h, 3), d));
    listSet(h, 4, wrapAdd(listGet(h, 4), e)); listSet(h, 5, wrapAdd(listGet(h, 5), f));
    listSet(h, 6, wrapAdd(listGet(h, 6), g)); listSet(h, 7, wrapAdd(listGet(h, 7), hh));
}

// O(input) time; the padding, schedule and state use constant auxiliary space.
// Bytes length is a non-negative int; its bit length fits in the 128-bit suffix.
export function sha384Sum(data: Bytes): Bytes {
    const h: List<u64> = listNew();
    listPush(h, 0xcbbb9d5dc1059ed8); listPush(h, 0x629a292a367cd507); listPush(h, 0x9159015a3070dd17); listPush(h, 0x152fecd8f70e5939);
    listPush(h, 0x67332667ffc00b31); listPush(h, 0x8eb44a8768581511); listPush(h, 0xdb0c2e0d64f98fa7); listPush(h, 0x47b5481dbefa4fa4);
    const k = constants(); const w: List<u64> = listNew(); let i = 0;
    while (i < 80) { listPush(w, 0); i = i + 1; }
    const size = bytesLen(data); let offset = 0;
    while (size - offset >= 128) { compress(h, k, w, data, offset); offset = offset + 128; }
    const remaining = size - offset; let tailSize = 128;
    if (remaining >= 112) { tailSize = 256; }
    const tail = bytesNew(tailSize); bytesCopy(tail, 0, data, offset, remaining); bytesSet(tail, remaining, 128);
    const unsignedSize = size as u64;
    bytesSetBE<u64>(tail, tailSize - 16, unsignedSize >>> 61); bytesSetBE<u64>(tail, tailSize - 8, unsignedSize << 3);
    compress(h, k, w, tail, 0);
    if (tailSize == 256) { compress(h, k, w, tail, 128); }
    const out = bytesNew(48); i = 0;
    while (i < 6) { bytesSetBE<u64>(out, i * 8, listGet(h, i)); i = i + 1; }
    return out;
}
