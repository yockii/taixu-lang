// D3 v0.48 外部内存区：同一线程同时存活的区超过 64 个（都没结束），trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function main(args: []string): int {
    const p = pageAlloc();
    let total = 0;
    let i = 0;
    while (i < 65) {
        const m = ffiMem(p, 1, false) catch (e) { print(e.message); return 1; };
        total = total + bytesLen(ffiMemRead(m, 0, 1));
        if (i == 63) { print("live " + toStr(total)); }
        i = i + 1;
    }
    print("never");
    return 0;
}
