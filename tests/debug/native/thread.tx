// 调试薄桩（第 6 轮 6c-2）：只停主线程——线程里执行到断点不停，主线程执行到同一断点照停。
function work(): int {
    let t = 0;
    let i = 0;
    while (i < 1000) {
        t = t + i;
        i = i + 1;
    }
    return t;
}

export function main(args: []string): int {
    const h = threadSpawn(work);
    const v = threadJoin(h) catch -1;
    const w = work();
    print(toStr(v) + " " + toStr(w));
    return 0;
}
