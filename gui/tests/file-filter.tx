// file-filter —— 文件对话框过滤器的规整与 Windows 形态（G5 第二部分；纯函数，三端都跑，不弹对话框）：扩展名合规判定、
// 不合规的扩展名与整组不合规的过滤器跳过、名称截到 NUL、名称为空时显示模式、"*" 记作 "*.*"、保存的缺省扩展名；macOS 形态
// （扩展名合成一组、不分大小写去重、含 "*" 时不限）。
import { FdFilter, fdAdd, fdExtOk, fdWin32Parts, fdDefExt, fdMacExts } from "gui/engine/filedialog";

function show(label: string, fs: List<FdFilter>): void {
    let s: string = "";
    for (p in fdWin32Parts(fs)) {
        s = s + "[" + p + "]";
    }
    let mac: string = "";
    for (e in fdMacExts(fs)) {
        mac = mac + "<" + e + ">";
    }
    print(label + " n=" + toStr(listLen(fs)) + " " + s + " def=" + fdDefExt(fs) + " mac=" + mac);
}

export function main(args: []string): int {
    args;
    let oks: string = "";
    for (e in ["png", "tar.gz", "*", "图", "", ".png", "*.png", "p?g", "[ab]", "a b", "a\tb", "a/b", "a\\b", "a;b", "a\0b", "**"]) {
        if (fdExtOk(e)) {
            oks = oks + "1";
        } else {
            oks = oks + "0";
        }
    }
    print("ext-ok " + oks);

    const a: List<FdFilter> = listNew();
    fdAdd(a, "Taixu 源码", ["tx"]);
    fdAdd(a, "图片", ["png", "jpg"]);
    fdAdd(a, "所有文件", ["*"]);
    show("basic", a);

    const b: List<FdFilter> = listNew();
    fdAdd(b, "", ["png", ".bad", "jpg"]);
    show("noname", b);

    const c: List<FdFilter> = listNew();
    fdAdd(c, "坏", [".x", "*.y", ""]);
    fdAdd(c, "好", ["md"]);
    show("skip", c);

    const d: List<FdFilter> = listNew();
    fdAdd(d, "空", []);
    show("empty", d);

    const e: List<FdFilter> = listNew();
    fdAdd(e, "前\0后", ["txt"]);
    fdAdd(e, "\0", ["log"]);
    show("nul", e);

    const f: List<FdFilter> = listNew();
    fdAdd(f, "所有文件", ["*"]);
    fdAdd(f, "文本", ["*", "txt", "md"]);
    show("defext", f);

    const g: List<FdFilter> = listNew();
    fdAdd(g, "图片", ["png", "JPG", "jpeg"]);
    fdAdd(g, "也是图片", ["PNG", "jpg", "gif"]);
    show("mac-union", g);
    return 0;
}
