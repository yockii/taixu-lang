// 协议端到端测试取文件与目录的修改时间（MCP 的 disasm 不写文件的核对；导出面同 mtime_os_linux.tx、
// mtime_os_macos.tx）：Windows 经 kernel32 的 GetFileAttributesExW 取 WIN32_FILE_ATTRIBUTE_DATA 的 ftLastWriteTime（100 ns 为单位）。
// 只用来比较前后是否相同，单位按平台。
declare function GetFileAttributesExW(name: wstr, level: i32, info: Bytes): i32 from "kernel32";

// WIN32_FILE_ATTRIBUTE_DATA：dwFileAttributes、ftCreationTime、ftLastAccessTime 之后是 ftLastWriteTime；整个结构 36 字节。
const WRITE_TIME_AT: int = 20;

// path 的修改时间；取不到得 −1。
export function mtimeOf(path: string): int {
    const info = bytesNew(36);
    if (GetFileAttributesExW(path, 0 as i32, info) == 0) {
        return -1;
    }
    return bytesGetLE<int>(info, WRITE_TIME_AT) ?? -1;
}
