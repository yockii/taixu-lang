// ============================================================================
// engine/mac/m_rs —— objc_msgSend：const char *(id, SEL)（如 -[NSString UTF8String]，拷成 string；空指针得空串）。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize): string from "/usr/lib/libobjc.A.dylib";

export function msgRetS(o: usize, s: string): string {
    return objc_msgSend(o, sel_registerName(s));
}
