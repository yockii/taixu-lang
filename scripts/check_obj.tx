// 链接映射、函数范围与对象 fuzz 三类门步共用的独立结构（夹具构造与映像解析）：
// 不经编译器的对象写出端独立构造的 ELF64／COFF 可重定位对象（两份，第二份补全第一份的未定义符号）、两种对象的可变异字段表、
// 按产物头（PE 节表、ELF 程序头、Mach-O 的生产者四节与 LC_MAIN）读出的实际布局，以及按虚拟地址求文件偏移。
// 判定器要与被测编译器相互独立：本文件不导入 bootstrap/ 的任何模块。
// 64 位无符号值按 int 的位模式存放（最高位为 1 时为负数）；比较地址区间时用差值，不做可能溢出的加法。
import { b8, imgOf, Img, u16, u32, u64 } from "./check_lib";

export const UNICODE: string = "太虚符号";
export const ESCAPED: string = "quote\"\\\nname";

// 往 d 尾部追加 v 的低 w 字节（小端）。
export function putLE(d: Bytes, v: int, w: int): void {
    let k = 0;
    while (k < w) {
        bytesPush(d, (v >>> (8 * k)) & 255);
        k = k + 1;
    }
}

// 把 d[at, at+w) 改写成 v 的低 w 字节（小端）；越出 d 时整段不写。
export function setLE(d: Bytes, at: int, w: int, v: int): void {
    if (at < 0 || at + w > bytesLen(d)) {
        return;
    }
    let k = 0;
    while (k < w) {
        bytesSet(d, at + k, (v >>> (8 * k)) & 255);
        k = k + 1;
    }
}

// d[at, at+w) 的小端无符号值（w 至多 8；8 字节时按位模式）。越界得 0。
export function getLE(d: Bytes, at: int, w: int): int {
    let v = 0;
    let k = w - 1;
    while (k >= 0) {
        v = (v << 8) | (bytesGet(d, at + k) ?? 0);
        k = k - 1;
    }
    return v;
}

function zeros(n: int): Bytes {
    return bytesNew(n);
}

// 名字的字节：UNICODE 与 ESCAPED 之外，\x80、\x81 两个不是合法 UTF-8 的名字用 rawName 构造。
export function rawName(v: int): Bytes {
    const b = bytesNew(1);
    bytesSet(b, 0, v);
    return b;
}

// 一个独立构造的对象：字节，以及判据用到的位置——ELF 的节头表偏移与各节内容的偏移，COFF 的符号表偏移与各节内容的偏移。
export struct Fixture {
    data: Bytes,
    shoff: int,
    symptr: int,
    offsets: List<int>,
}

struct Sym {
    name: Bytes,
    info: int,
    section: int,
    value: int,
    size: int,
}

function sym(name: Bytes, info: int, section: int, value: int, size: int): Sym {
    return Sym { name: name, info: info, section: section, value: value, size: size };
}

function indexOfName(syms: List<Sym>, name: Bytes): int {
    let i = 0;
    while (i < listLen(syms)) {
        const s = listGet(syms, i) catch sym(bytesNew(0), 0, 0, 0, 0);
        if (bytesEqual(s.name, name)) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// ELF64 可重定位对象（x86_64），不经编译器的对象写出端：.text .rodata .data .bss .meta .strtab .symtab .shstrtab .rela.data。
export function elfObject(second: bool): Fixture {
    const syms: List<Sym> = listNew();
    listPush(syms, sym(bytesFromStr("dup"), 0, 1, 0, 0));
    listPush(syms, sym(bytesFromStr("meta"), 0, 5, 1, 0));
    const relAt: List<int> = listNew();
    const relName: List<Bytes> = listNew();
    if (second) {
        listPush(syms, sym(bytesFromStr("edge"), 16, 0, 0, 0));
        listPush(relAt, 0);
        listPush(relName, bytesFromStr("edge"));
    } else {
        listPush(syms, sym(bytesFromStr("_start"), 18, 1, 0, 1));
        listPush(syms, sym(rawName(128), 18, 1, 0, 1));
        listPush(syms, sym(rawName(129), 18, 1, 1, 1));
        listPush(syms, sym(bytesFromStr(UNICODE), 17, 2, 2, 1));
        listPush(syms, sym(bytesFromStr(ESCAPED), 17, 2, 3, 1));
        listPush(syms, sym(bytesFromStr("zero"), 16, 65521, 0, 0));
        listPush(syms, sym(bytesFromStr("edge"), 16, 65521, -1, -1));
        listPush(syms, sym(bytesFromStr("slots"), 17, 3, 0, 24));
        listPush(syms, sym(bytesFromStr("zeros"), 17, 4, 0, 37));
        listPush(syms, sym(bytesFromStr("unused_undefined"), 16, 0, 0, 0));
        listPush(relAt, 0);
        listPush(relName, rawName(128));
        listPush(relAt, 8);
        listPush(relName, bytesFromStr("edge"));
        listPush(relAt, 16);
        listPush(relName, bytesFromStr(UNICODE));
    }
    const strings = zeros(1);
    const table = zeros(24);
    for (s in syms) {
        const at = bytesLen(strings);
        bytesAppend(strings, s.name);
        bytesPush(strings, 0);
        putLE(table, at, 4);
        putLE(table, s.info, 1);
        putLE(table, 0, 1);
        putLE(table, s.section, 2);
        putLE(table, s.value, 8);
        putLE(table, s.size, 8);
    }
    const names: []string = ["", ".text", ".rodata", ".data", ".bss", ".meta", ".strtab", ".symtab", ".shstrtab", ".rela.data"];
    const shstrings = zeros(0);
    const no: List<int> = listNew();
    for (n in names) {
        listPush(no, bytesLen(shstrings));
        bytesAppend(shstrings, bytesFromStr(n));
        bytesPush(shstrings, 0);
    }
    const rela = zeros(0);
    let r = 0;
    while (r < listLen(relAt)) {
        putLE(rela, listGet(relAt, r) catch 0, 8);
        putLE(rela, ((indexOfName(syms, listGet(relName, r) catch bytesNew(0)) + 1) << 32) | 1, 8);
        putLE(rela, 0, 8);
        r = r + 1;
    }
    const payloads: List<Bytes> = listNew();
    listPush(payloads, zeros(0));
    const code = rawName(195);
    bytesPush(code, 144);
    listPush(payloads, code);
    const seq = zeros(0);
    let i = 0;
    while (i < 16) {
        bytesPush(seq, i);
        i = i + 1;
    }
    listPush(payloads, seq);
    listPush(payloads, zeros(24));
    listPush(payloads, zeros(0));
    listPush(payloads, bytesFromStr("ab"));
    listPush(payloads, strings);
    listPush(payloads, table);
    listPush(payloads, shstrings);
    listPush(payloads, rela);
    const data = zeros(64);
    const offsets: List<int> = listNew();
    const headers = zeros(0);
    i = 0;
    while (i < listLen(payloads)) {
        const payload = listGet(payloads, i) catch zeros(0);
        while (bytesLen(data) % 8 != 0) {
            bytesPush(data, 0);
        }
        const at = bytesLen(data);
        bytesAppend(data, payload);
        listPush(offsets, at);
        let kind = 1;
        if (i == 0) {
            kind = 0;
        } else if (i == 4) {
            kind = 8;
        } else if (i == 6 || i == 8) {
            kind = 3;
        } else if (i == 7) {
            kind = 2;
        } else if (i == 9) {
            kind = 4;
        }
        let flags = 0;
        if (i == 1) {
            flags = 6;
        } else if (i == 2) {
            flags = 2;
        } else if (i == 3 || i == 4) {
            flags = 3;
        }
        let size = bytesLen(payload);
        if (i == 4) {
            size = 37;
        }
        let link = 0;
        let info = 0;
        let entsize = 0;
        if (i == 7) {
            link = 6;
            info = 3;
            entsize = 24;
        } else if (i == 9) {
            link = 7;
            info = 3;
            entsize = 24;
        }
        putLE(headers, listGet(no, i) catch 0, 4);
        putLE(headers, kind, 4);
        putLE(headers, flags, 8);
        putLE(headers, 0, 8);
        putLE(headers, at, 8);
        putLE(headers, size, 8);
        putLE(headers, link, 4);
        putLE(headers, info, 4);
        putLE(headers, 8, 8);
        putLE(headers, entsize, 8);
        i = i + 1;
    }
    const shoff = bytesLen(data);
    bytesAppend(data, headers);
    const head = zeros(0);
    putLE(head, 1179403647, 4);
    bytesPush(head, 2);
    bytesPush(head, 1);
    bytesPush(head, 1);
    bytesAppend(head, zeros(9));
    putLE(head, 1, 2);
    putLE(head, 62, 2);
    putLE(head, 1, 4);
    putLE(head, 0, 8);
    putLE(head, 0, 8);
    putLE(head, shoff, 8);
    putLE(head, 0, 4);
    putLE(head, 64, 2);
    putLE(head, 0, 2);
    putLE(head, 0, 2);
    putLE(head, 64, 2);
    putLE(head, listLen(payloads), 2);
    putLE(head, 8, 2);
    bytesCopy(data, 0, head, 0, 64);
    return Fixture { data: data, shoff: shoff, symptr: 0, offsets: offsets };
}

struct CSym {
    name: Bytes,
    value: int,
    section: int,
    storage: int,
    aux: int,
}

function csym(name: Bytes, value: int, section: int, storage: int, aux: int): CSym {
    return CSym { name: name, value: value, section: section, storage: storage, aux: aux };
}

struct CSec {
    name: string,
    payload: Bytes,
    bss: int,
}

// COFF 可重定位对象（AMD64），不经编译器的对象写出端；第一份 .data 带四个 ADDR64 重定位。
export function coffObject(second: bool): Fixture {
    const secs: List<CSec> = listNew();
    const syms: List<CSym> = listNew();
    listPush(syms, csym(bytesFromStr(".file"), 0, -2, 103, 1));
    listPush(syms, csym(bytesFromStr("dup"), 0, 1, 3, 0));
    const text = rawName(195);
    bytesPush(text, 144);
    const relAt: List<int> = listNew();
    const relName: List<Bytes> = listNew();
    if (second) {
        listPush(secs, CSec { name: ".text$x", payload: text, bss: 0 });
        listPush(secs, CSec { name: ".data$x", payload: zeros(8), bss: 0 });
        listPush(syms, csym(bytesFromStr("co_tail"), 1, 1, 2, 0));
        listPush(syms, csym(bytesFromStr("dead"), 0, 2, 3, 0));
    } else {
        const seq = zeros(0);
        let i = 0;
        while (i < 16) {
            bytesPush(seq, i);
            i = i + 1;
        }
        listPush(secs, CSec { name: ".text", payload: text, bss: 0 });
        listPush(secs, CSec { name: ".rdata", payload: seq, bss: 0 });
        listPush(secs, CSec { name: ".data", payload: zeros(32), bss: 0 });
        listPush(secs, CSec { name: ".bss", payload: zeros(0), bss: 37 });
        listPush(syms, csym(bytesFromStr("co_root"), 0, 1, 2, 0));
        listPush(syms, csym(rawName(128), 0, 1, 2, 0));
        listPush(syms, csym(rawName(129), 1, 1, 2, 0));
        listPush(syms, csym(bytesFromStr(UNICODE), 2, 2, 2, 0));
        listPush(syms, csym(bytesFromStr(ESCAPED), 3, 2, 2, 0));
        listPush(syms, csym(bytesFromStr("absolute"), 4294967295, -1, 2, 0));
        listPush(syms, csym(bytesFromStr("slots"), 0, 3, 2, 0));
        listPush(syms, csym(bytesFromStr("zeros"), 0, 4, 2, 0));
        listPush(syms, csym(bytesFromStr("co_tail"), 0, 0, 2, 0));
        listPush(syms, csym(bytesFromStr("unused_undefined"), 0, 0, 2, 0));
        listPush(relAt, 0);
        listPush(relName, rawName(128));
        listPush(relAt, 8);
        listPush(relName, bytesFromStr(UNICODE));
        listPush(relAt, 16);
        listPush(relName, bytesFromStr("dup"));
        listPush(relAt, 24);
        listPush(relName, bytesFromStr("co_tail"));
    }
    const strings = zeros(4);
    const table = zeros(0);
    const index: List<int> = listNew();
    for (s in syms) {
        listPush(index, bytesLen(table) / 18);
        if (bytesLen(s.name) > 8) {
            putLE(table, 0, 4);
            putLE(table, bytesLen(strings), 4);
            bytesAppend(strings, s.name);
            bytesPush(strings, 0);
        } else {
            bytesAppend(table, s.name);
            bytesAppend(table, zeros(8 - bytesLen(s.name)));
        }
        putLE(table, s.value, 4);
        putLE(table, s.section, 2);
        putLE(table, 0, 2);
        putLE(table, s.storage, 1);
        putLE(table, s.aux, 1);
        bytesAppend(table, zeros(18 * s.aux));
    }
    setLE(strings, 0, 4, bytesLen(strings));
    const data = zeros(20 + 40 * listLen(secs));
    const offsets: List<int> = listNew();
    const headers = zeros(0);
    let i = 0;
    while (i < listLen(secs)) {
        const s = listGet(secs, i) catch CSec { name: "", payload: zeros(0), bss: 0 };
        const at = bytesLen(data);
        bytesAppend(data, s.payload);
        listPush(offsets, at);
        const relocAt = bytesLen(data);
        let nrel = 0;
        if (i == 2) {
            let r = 0;
            while (r < listLen(relAt)) {
                let k = 0;
                const want = listGet(relName, r) catch zeros(0);
                let symIndex = 0;
                while (k < listLen(syms)) {
                    if (bytesEqual((listGet(syms, k) catch csym(zeros(0), 0, 0, 0, 0)).name, want)) {
                        symIndex = listGet(index, k) catch 0;
                    }
                    k = k + 1;
                }
                putLE(data, listGet(relAt, r) catch 0, 4);
                putLE(data, symIndex, 4);
                putLE(data, 1, 2);
                r = r + 1;
            }
            nrel = listLen(relAt);
        }
        const nameBytes = bytesFromStr(s.name);
        bytesAppend(headers, nameBytes);
        bytesAppend(headers, zeros(8 - bytesLen(nameBytes)));
        putLE(headers, s.bss, 4);
        putLE(headers, 0, 4);
        putLE(headers, bytesLen(s.payload), 4);
        putLE(headers, at, 4);
        putLE(headers, relocAt, 4);
        putLE(headers, 0, 4);
        putLE(headers, nrel, 2);
        putLE(headers, 0, 2);
        putLE(headers, 5242880, 4);
        i = i + 1;
    }
    const symptr = bytesLen(data);
    bytesAppend(data, table);
    bytesAppend(data, strings);
    setLE(data, 0, 2, 34404);
    setLE(data, 2, 2, listLen(secs));
    setLE(data, 4, 4, 0);
    setLE(data, 8, 4, symptr);
    setLE(data, 12, 4, bytesLen(table) / 18);
    setLE(data, 16, 2, 0);
    setLE(data, 18, 2, 0);
    bytesCopy(data, 20, headers, 0, bytesLen(headers));
    return Fixture { data: data, shoff: 0, symptr: symptr, offsets: offsets };
}

// 一个可变异字段：偏移与字节宽。
export struct Field {
    at: int,
    w: int,
}

function addFields(out: List<Field>, base: int, spec: []int): void {
    let k = 0;
    while (k + 1 < len(spec)) {
        listPush(out, Field { at: base + spec[k], w: spec[k + 1] });
        k = k + 2;
    }
}

// 独立解码出的可变异字段，按此次序：ELF64 节头／符号／重定位，COFF 文件头／节头／符号／重定位；越出 data 的字段不要。
export function objectFields(mode: string, data: Bytes): List<Field> {
    const all: List<Field> = listNew();
    if (mode == "elf") {
        addFields(all, 0, [40, 8, 58, 2, 60, 2, 62, 2]);
        const shoff = getLE(data, 40, 8);
        const shnum = getLE(data, 60, 2);
        let i = 0;
        while (i < shnum) {
            const sh = shoff + 64 * i;
            addFields(all, sh, [0, 4, 4, 4, 8, 8, 24, 8, 32, 8, 40, 4, 44, 4, 48, 8, 56, 8]);
            const kind = getLE(data, sh + 4, 4);
            const off = getLE(data, sh + 24, 8);
            const size = getLE(data, sh + 32, 8);
            const entsize = getLE(data, sh + 56, 8);
            if (kind == 2 && entsize == 24) {
                let s = off;
                while (s < off + size) {
                    addFields(all, s, [0, 4, 4, 1, 6, 2, 8, 8, 16, 8]);
                    s = s + 24;
                }
            }
            if (kind == 4 && entsize == 24) {
                let r = off;
                while (r < off + size) {
                    addFields(all, r, [0, 8, 8, 8, 16, 8]);
                    r = r + 24;
                }
            }
            i = i + 1;
        }
    } else {
        addFields(all, 0, [2, 2, 8, 4, 12, 4, 16, 2]);
        const count = getLE(data, 2, 2);
        const symptr = getLE(data, 8, 4);
        const nsyms = getLE(data, 12, 4);
        let i = 0;
        while (i < count) {
            const sec = 20 + 40 * i;
            addFields(all, sec, [8, 4, 12, 4, 16, 4, 20, 4, 24, 4, 32, 2, 36, 4]);
            const relptr = getLE(data, sec + 24, 4);
            const nrel = getLE(data, sec + 32, 2);
            let r = relptr;
            while (r < relptr + 10 * nrel) {
                addFields(all, r, [0, 4, 4, 4, 8, 2]);
                r = r + 10;
            }
            i = i + 1;
        }
        let s = symptr;
        while (s < symptr + 18 * nsyms) {
            addFields(all, s, [0, 8, 8, 4, 12, 2, 14, 2, 16, 1, 17, 1]);
            s = s + 18;
        }
    }
    const out: List<Field> = listNew();
    for (f in all) {
        if (f.at + f.w <= bytesLen(data)) {
            listPush(out, f);
        }
    }
    return out;
}

// 产物的一段装载内容：虚拟地址、文件偏移（hasOff 为假即零填充、没有文件字节）、文件字节数、内存字节数。
export struct Seg {
    va: int,
    off: int,
    hasOff: bool,
    file: int,
    mem: int,
}

// 按产物头读出的实际布局（不看映射自己对节的描述）：首选基址、入口地址与各段。读越界或缺生产者节时 ok 为假、why 写明。
export struct Layout {
    base: int,
    entry: int,
    segs: List<Seg>,
    ok: bool,
    why: string,
}

function cname(m: Ref<Img>, at: int, n: int): string {
    const out = bytesNew(0);
    let k = 0;
    while (k < n) {
        const c = b8(m, at + k);
        bytesPush(out, c);
        k = k + 1;
    }
    let end = bytesLen(out);
    while (end > 0 && (bytesGet(out, end - 1) ?? 1) == 0) {
        end = end - 1;
    }
    return bytesToStr(bytesSlice(out, 0, end)) catch "";
}

export function isMachO(image: Bytes): bool {
    return getLE(image, 0, 4) == 4277009103 && bytesLen(image) >= 4;
}

export function isElf(image: Bytes): bool {
    return bytesLen(image) >= 4 && getLE(image, 0, 4) == 1179403647;
}

// 产物的装载布局：Mach-O 64 取 __TEXT 段的 vmaddr 与 LC_MAIN，段为 __text、__const、__data、__bss（零填充节没有文件
// 字节）；ELF 取 PT_LOAD（基址按 0x400000）；其余按 PE 的节表。
export function imageLayout(image: Bytes): Layout {
    const m = imgOf(image);
    const segs: List<Seg> = listNew();
    if (isMachO(image)) {
        const ncmds = u32(m, 16);
        let at = 32;
        let base = 0;
        let entry = 0;
        const names: List<string> = listNew();
        const found: List<Seg> = listNew();
        let k = 0;
        while (k < ncmds && !m.oob) {
            const cmd = u32(m, at);
            const size = u32(m, at + 4);
            if (cmd == 25) {
                if (cname(m, at + 8, 16) == "__TEXT") {
                    base = u64(m, at + 24);
                }
                const nsects = u32(m, at + 64);
                let j = 0;
                while (j < nsects && !m.oob) {
                    const h = at + 72 + 80 * j;
                    const addr = u64(m, h + 32);
                    const length = u64(m, h + 40);
                    const off = u32(m, h + 48);
                    const kind = u32(m, h + 64) & 255;
                    const zero = kind == 1 || kind == 18;
                    const name = cname(m, h, 16);
                    let s = Seg { va: addr, off: off, hasOff: true, file: length, mem: length };
                    if (zero) {
                        s = Seg { va: addr, off: 0, hasOff: false, file: 0, mem: length };
                    }
                    let slot = -1;
                    let q = 0;
                    while (q < listLen(names)) {
                        if ((listGet(names, q) catch "") == name) {
                            slot = q;
                        }
                        q = q + 1;
                    }
                    if (slot < 0) {
                        listPush(names, name);
                        listPush(found, s);
                    } else {
                        listSet(found, slot, s);
                    }
                    j = j + 1;
                }
            }
            if (cmd == 2147483688) {
                entry = u64(m, at + 8);
            }
            at = at + size;
            k = k + 1;
        }
        if (m.oob) {
            return Layout { base: 0, entry: 0, segs: segs, ok: false, why: "Mach-O header read past end" };
        }
        for (want in ["__text", "__const", "__data", "__bss"]) {
            let got = false;
            let q = 0;
            while (q < listLen(names)) {
                if ((listGet(names, q) catch "") == want) {
                    listPush(segs, listGet(found, q) catch Seg { va: 0, off: 0, hasOff: false, file: 0, mem: 0 });
                    got = true;
                }
                q = q + 1;
            }
            if (!got) {
                return Layout { base: base, entry: wrapAdd(base, entry), segs: segs, ok: false, why: "Mach-O section " + want + " missing" };
            }
        }
        return Layout { base: base, entry: wrapAdd(base, entry), segs: segs, ok: true, why: "" };
    }
    if (isElf(image)) {
        const entry = u64(m, 24);
        const phoff = u64(m, 32);
        const count = u16(m, 56);
        let i = 0;
        while (i < count && !m.oob) {
            const p = phoff + 56 * i;
            if (u32(m, p) == 1) {
                listPush(segs, Seg { va: u64(m, p + 16), off: u64(m, p + 8), hasOff: true, file: u64(m, p + 32), mem: u64(m, p + 40) });
            }
            i = i + 1;
        }
        if (m.oob) {
            return Layout { base: 0, entry: 0, segs: segs, ok: false, why: "ELF program headers read past end" };
        }
        return Layout { base: 4194304, entry: entry, segs: segs, ok: true, why: "" };
    }
    const pe = u32(m, 60);
    const opt = pe + 24;
    const base = u64(m, opt + 24);
    const entry = wrapAdd(base, u32(m, opt + 16));
    const count = u16(m, pe + 6);
    const at = opt + u16(m, pe + 20);
    let i = 0;
    while (i < count && !m.oob) {
        const h = at + 40 * i + 8;
        listPush(segs, Seg { va: wrapAdd(base, u32(m, h + 4)), off: u32(m, h + 12), hasOff: true, file: u32(m, h + 8), mem: u32(m, h) });
        i = i + 1;
    }
    if (m.oob) {
        return Layout { base: 0, entry: 0, segs: segs, ok: false, why: "PE headers read past end" };
    }
    return Layout { base: base, entry: entry, segs: segs, ok: true, why: "" };
}

// 无符号比较（64 位位模式）。
export function ult(a: int, b: int): bool {
    return (a ^ MIN64) < (b ^ MIN64);
}

const MIN64: int = -9223372036854775807 - 1;

// va 落在哪一段的文件字节里，就得 off + (va − 段首)；都不在得 −1。
export function fileAt(segs: List<Seg>, va: int): int {
    for (s in segs) {
        if (s.hasOff && !ult(va, s.va) && ult(wrapSub(va, s.va), s.file)) {
            return s.off + wrapSub(va, s.va);
        }
    }
    return -1;
}

// 两份布局的段是否逐项相同（虚拟地址、文件偏移或零填充、文件字节、内存字节）。
export function sameSegs(a: List<Seg>, b: List<Seg>): bool {
    if (listLen(a) != listLen(b)) {
        return false;
    }
    let i = 0;
    while (i < listLen(a)) {
        const x = listGet(a, i) catch Seg { va: 0, off: 0, hasOff: false, file: 0, mem: 0 };
        const y = listGet(b, i) catch Seg { va: 1, off: 0, hasOff: false, file: 0, mem: 0 };
        if (x.va != y.va || x.hasOff != y.hasOff || x.file != y.file || x.mem != y.mem || (x.hasOff && x.off != y.off)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 段表的显示（FAIL 行用；同 Python 的元组列表）。
export function segsText(segs: List<Seg>): string {
    let s = "[";
    let i = 0;
    for (g in segs) {
        if (i > 0) {
            s = s + ", ";
        }
        let off = "None";
        if (g.hasOff) {
            off = toStr(g.off);
        }
        s = s + "(" + toStr(g.va) + ", " + off + ", " + toStr(g.file) + ", " + toStr(g.mem) + ")";
        i = i + 1;
    }
    return s + "]";
}

// 十六进制串（可带 0x）按 64 位位模式取值；含非十六进制字符得 None。
export function hexVal(t: string): int? {
    let i = 0;
    if (len(t) >= 2 && (byteAt(t, 0) ?? 0) == 48 && ((byteAt(t, 1) ?? 0) == 120 || (byteAt(t, 1) ?? 0) == 88)) {
        i = 2;
    }
    if (i >= len(t)) {
        return None;
    }
    let v = 0;
    while (i < len(t)) {
        const c = byteAt(t, i) ?? 0;
        let d = -1;
        if (c >= 48 && c <= 57) {
            d = c - 48;
        } else if (c >= 97 && c <= 102) {
            d = c - 87;
        } else if (c >= 65 && c <= 70) {
            d = c - 55;
        }
        if (d < 0) {
            return None;
        }
        v = (v << 4) | d;
        i = i + 1;
    }
    return v;
}
