// runProcess 的子进程只拿到标准三件（D3 v0.40）：经 ws2_32 直接建的套接字缺省可继承，监听后起一个把孙进程放到后台就退出的
// cmd（孙进程活约 2 秒），关掉监听再在同一端口监听——孙进程若继承了它，端口仍被占。D3 v0.39 及以前 CreateProcessW 继承本进程
// 全部可继承句柄，这里重新监听失败。
declare function WSAStartup(version: u16, data: Bytes): i32 from "ws2_32";
declare function socket(af: i32, kind: i32, proto: i32): isize from "ws2_32";
declare function bind(s: isize, addr: Bytes, alen: i32): i32 from "ws2_32";
declare function listen(s: isize, backlog: i32): i32 from "ws2_32";
declare function getsockname(s: isize, addr: Bytes, alen: Bytes): i32 from "ws2_32";
declare function closesocket(s: isize): i32 from "ws2_32";

// 127.0.0.1:port 的 sockaddr_in。
function loopback(port: int): Bytes {
    const sa = bytesNew(16);
    bytesSet(sa, 0, 2);
    bytesSet(sa, 2, (port >> 8) & 255);
    bytesSet(sa, 3, port & 255);
    bytesSet(sa, 4, 127);
    bytesSet(sa, 7, 1);
    return sa;
}

function listenOn(port: int): isize {
    const s: isize = socket(2, 1, 6);
    if (s < 0) { return -1; }
    if (bind(s, loopback(port), 16) != 0 || listen(s, 4) != 0) {
        closesocket(s);
        return -1;
    }
    return s;
}

export function main(args: []string): int {
    if (WSAStartup(514, bytesNew(512)) != 0) { print("wsastartup failed"); return 1; }
    const s: isize = listenOn(0);
    if (s < 0) { print("listen failed"); return 1; }
    const sa = bytesNew(16);
    const alen = bytesNew(4);
    bytesSet(alen, 0, 16);
    getsockname(s, sa, alen);
    const port = (bytesGet(sa, 2) catch 0) * 256 + (bytesGet(sa, 3) catch 0);
    const argv: List< string> = listNew();
    listPush(argv, "/d");
    listPush(argv, "/c");
    listPush(argv, "start /b ping -n 3 127.0.0.1 >nul 2>nul");
    const shell = getEnv("ComSpec")?? "C:\\Windows\\System32\\cmd.exe";
    const rc = runProcess(shell, argv, "") catch -1;
    print("runProcess " + toStr(rc));
    closesocket(s);
    const again: isize = listenOn(port);
    if (again >= 0) {
        print("relisten ok");
        closesocket(again);
    } else {
        print("relisten failed: inherited");
    }
    return 0;
}
