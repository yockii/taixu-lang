// Bytes 字段（Linux）：外部结构体的 Bytes 字段是可写缓冲——字段里放的是 Shared 的冻结 Bytes 时，即使结构体本身不冻结，以 Ref 传入也在
// 调用前 trap 4022（同 Bytes 参数）。
declare struct IOVEC { base: Bytes, len: usize }
declare struct IOV1 { a: IOVEC }
declare function writev(fd: i32, iov: Ref<IOV1>, n: i32): isize from "libc.so.6";

function main(args: []string): void {
    const frozen = sharedGet(sharedNew(bytesFromStr("abc")));
    const v = new IOV1 { a: IOVEC { base: frozen, len: 3 } };
    writev(1, v, 1);
    print("unreachable");
}
