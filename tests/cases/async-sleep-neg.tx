// 定时器 e2e：sleepMs 负值＝即 err future（"sleep ms < 0"确定性错误通道，
// 立即失败）——await 侧 catch 捕获，无定时器登记。
function main(args: []string): int {
    const t = neg();
    print("spawned");
    const tDone = await t;
    return 0;
}

async function neg(): int {
    const bad = sleepMs(-1);
    await bad catch (e) {
        print("err: " + e.message);
        return 0;
    };
    print("unreachable");
    return 1;
}
