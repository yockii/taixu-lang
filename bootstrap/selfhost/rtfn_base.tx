// rtfn 的公共底座（docs/design/v052-native-runtime-nrt-v0.1-20261013.md；macOS 适配 M4 设计 A4）：函数构造器的状态 RtFn、
// 操作数 RtOp 与它们的簿记。rtfn.tx（对外接口与 x86 底层）与 rtfn_a64.tx（A64 底层）都建在它上面，两个底层互不依赖。
import { StructuredBuffer } from "./assemble";

export struct RtOp {
    kind: int,
    num: int,
    name: string,
}

// 一次接口调用的记录（寄存器分配设计 §七-1）：构造期间各接口只记录，rtEnd 时统一发射。字段按接口取用，k 是接口号。
export struct RtCall {
    k: int,
    s1: string, s2: string, s3: string,
    o1: Ref<RtOp>, o2: Ref<RtOp>, o3: Ref<RtOp>,
    n1: int, n2: int,
    args: List<Ref<RtOp>>,
    cls: List<int>,
    flag: bool,
    // 分配后：在本条两侧存取自己槽的寄存器局部（跨调用仍活、家会被本条改写；设计 §八-4）。
    saves: List<int>,
    // 分配后：本条发射期间不得被固定寄存器写入踩到的寄存器（前后仍活、非本条定义、未存槽的寄存器局部的家；位掩码）。
    keep: int,
}

export struct RtFn {
    b: Ref<StructuredBuffer>,
    name: string,
    locals: List<string>,
    frame: int,
    base: int,
    failed: string,
    closed: bool,
    // rax holds the value of the local slot at offset raxSlot, valid only while
    // the buffer still has raxAt entries (any other emission invalidates it).
    raxSlot: int,
    raxAt: int,
    // A64 底层（缓冲为 A64 时）；seq 给函数内自动生成的标号编号。
    a64: bool,
    seq: int,
    // 记录（寄存器分配设计 §七）：rec 为真时接口只追加到 calls，序言（要参数个数与最大实参数）与函数体在 rtEnd 发出；
    // mark 是 rtBegin 写完函数开头后缓冲的条目数，记录期间缓冲不得另被写入。
    rec: bool,
    calls: List<Ref<RtCall>>,
    nparams: int,
    maxArgs: int,
    mark: int,
    // rtTag 的计数（调用方生成函数内唯一的标号后缀）。
    tags: int,
    // 寄存器分配（设计 §八）：alloc 为真时 rtEnd 先分配；homes 每个局部一项，寄存器号或 −1（栈槽），空表即全在栈槽。
    homes: List<int>,
    alloc: bool,
    // 正在重放的记录的 keep（设计 §八-7 的发射期自查）。
    keep: int,
}

export const OP_LOCAL: int = 0;
export const OP_IMM: int = 1;
export const OP_ADDR: int = 2;
export const OP_GLOBAL: int = 3;
export const OP_GLOBAL_ACQ: int = 4;

export function L(name: string): Ref<RtOp> { return new RtOp { kind: OP_LOCAL, num: 0, name: name }; }
export function I(value: int): Ref<RtOp> { return new RtOp { kind: OP_IMM, num: value, name: "" }; }
export function A(symbol: string): Ref<RtOp> { return new RtOp { kind: OP_ADDR, num: 0, name: symbol }; }
export function G(symbol: string): Ref<RtOp> { return new RtOp { kind: OP_GLOBAL, num: 0, name: symbol }; }
/// 带获取语义读全局（别的线程以释放语义或原子读改写写入的单元，读到后还要读它所发布的数据）：x86 同 G，A64 为 LDAR。
export function GAcq(symbol: string): Ref<RtOp> { return new RtOp { kind: OP_GLOBAL_ACQ, num: 0, name: symbol }; }

const RT_NO_OP: Ref<RtOp> = new RtOp { kind: OP_IMM, num: 0, name: "" };
/// 新的调用记录（接口号 k，其余字段取缺省，由调用方填）。
export function rtfnCall(k: int): Ref<RtCall> {
    return new RtCall { k: k, s1: "", s2: "", s3: "", o1: RT_NO_OP, o2: RT_NO_OP, o3: RT_NO_OP, n1: 0, n2: 0,
        args: listNew(), cls: listNew(), flag: false, saves: listNew(), keep: 0 };
}

// 记录的接口号（RtCall.k）。
export const K_LOAD_REG: int = 1;
export const K_STORE_REG: int = 2;
export const K_SET: int = 3;
export const K_SET_GLOBAL: int = 4;
export const K_SET_RBX: int = 5;
export const K_OP: int = 6;
export const K_SHIFT: int = 7;
export const K_DIVMOD: int = 8;
export const K_LOAD: int = 9;
export const K_STORE: int = 10;
export const K_ADDR_OF: int = 11;
export const K_LABEL: int = 12;
export const K_JUMP: int = 13;
export const K_IF: int = 14;
export const K_IF32: int = 15;
export const K_CALL: int = 16;
export const K_CALL_C: int = 17;
export const K_F64_TO_F32: int = 18;
export const K_F32_TO_F64: int = 19;
export const K_SYSCALL: int = 20;
export const K_FOP: int = 21;
export const K_FIF: int = 22;
export const K_INT_TO_F64: int = 23;
export const K_LOAD_ACQ: int = 24;
export const K_STORE_REL: int = 25;
export const K_ATOMIC_ADD: int = 26;
export const K_ATOMIC_CAS: int = 27;
export const K_ATOMIC_XCHG: int = 28;
export const K_RET: int = 29;
export const K_RET2: int = 30;
export const K_RET_VOID: int = 31;
export const K_TRAP: int = 32;
export const K_RDATA: int = 33;

/// 局部 name 的寄存器（分配到的），在栈槽为 −1。
export function rtfnHome(f: Ref<RtFn>, name: string): int {
    if (listLen(f.homes) == 0) { return -1; }
    let k = 0;
    while (k < listLen(f.locals)) {
        if ((listGet(f.locals, k) catch "") == name) { return listGet(f.homes, k) catch -1; }
        k = k + 1;
    }
    return -1;
}

/// 底层往固定寄存器 r 写入之前核对：r 是本条仍活的寄存器局部的家即报错（写入表漏项时生成失败，不出错误代码）。
export function rtfnGuardWrite(f: Ref<RtFn>, r: int): void {
    if (r >= 0 && r < 63 && ((f.keep >>> r) & 1) == 1) { rtfnFail(f, "RegAllocClobber " + toStr(r)); }
}

/// 记下第一个失败（之后的不覆盖）。
export function rtfnFail(f: Ref<RtFn>, what: string): void { if (len(f.failed) == 0) { f.failed = f.name + ": " + what; } }
/// 函数尚未结束才能继续发射；结束后再发射记为失败。
export function rtfnOpen(f: Ref<RtFn>): bool {
    if (!f.closed) { return true; } rtfnFail(f, "emission after function end"); return false;
}
/// 局部的栈槽偏移；不认识的名字记为失败。
export function rtfnSlot(f: Ref<RtFn>, name: string): int {
    let k = 0;
    while (k < listLen(f.locals)) {
        if ((listGet(f.locals, k) catch "") == name) { return f.base + k * 8; }
        k = k + 1;
    }
    rtfnFail(f, "unknown local " + name);
    return f.base;
}
/// 记下缓存寄存器（x86 rax、A64 x9）此刻持有槽 slot 的值。
export function rtfnCache(f: Ref<RtFn>, slot: int): void { f.raxSlot = slot; f.raxAt = listLen(f.b.entries); }
/// 缓存寄存器是否仍持有槽 slot（其后有任何发射即失效）。
export function rtfnCached(f: Ref<RtFn>, slot: int): bool { return f.raxSlot == slot && f.raxAt == listLen(f.b.entries); }
/// 函数内标号的全名。
export function rtfnLabel(f: Ref<RtFn>, label: string): string { return f.name + "__" + label; }
/// C 实参类别（rtCallC）：0 整数／指针、1 浮点（双精度位）、2 变参位置上的整数、3／4／5 宽 32／16／8 位的整数、6 f32（低 32 位）、
/// 7 变参位置上的浮点（双精度位，D3 v0.36）。值是浮点的是 1、6、7；变参位置上的是 2、7（只能排在定参之后）。
export function rtfnCFloat(c: int): bool { return c == 1 || c == 6 || c == 7; }
export function rtfnCVar(c: int): bool { return c == 2 || c == 7; }
