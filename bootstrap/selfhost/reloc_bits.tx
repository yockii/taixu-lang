// 重定位施加的公共小件（目标分层 X3a 从 link_objects.tx 拆出）：按小端写入值、读出 32 位指令字。各架构的重定位语义在
// reloc_<架构>.tx，由 link_objects.tx 按目标的机器号派发。

/// 在 out 的 at 处按小端写入 value 的低 width 字节。
export function relocPatch(out: Bytes, at: int, value: int, width: int): void {
    let i = 0;
    while (i < width) { bytesSet(out, at + i, (value >>> (i * 8)) & 255); i = i + 1; }
}

/// out 的 at 处的 32 位小端字（指令字）。
export function relocWord32(out: Bytes, at: int): int {
    return (bytesGet(out, at) catch 0) | ((bytesGet(out, at + 1) catch 0) << 8) | ((bytesGet(out, at + 2) catch 0) << 16) | ((bytesGet(out, at + 3) catch 0) << 24);
}
