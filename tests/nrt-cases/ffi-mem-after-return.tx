// D3 v0.48 外部内存区：创建区的函数返回后，闭包里的副本再读，trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function reader(p: int): () => int {
    const m = ffiMem(p, 8, false) catch (e) { return (): int => { return -1; }; };
    print("inside " + toStr(bytesLen(ffiMemRead(m, 0, 8))));
    return (): int => { return bytesLen(ffiMemRead(m, 0, 8)); };
}

function main(args: []string): int {
    const f = reader(pageAlloc());
    print("returned");
    return f();
}
