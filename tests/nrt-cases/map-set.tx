// D3 v0.20：编译器自带 prelude 中的泛型 Map<K, V> 与 Set<T>——K extends Hashable，插入序迭代，
// 句柄语义，struct 作键与值，方法语法，泛型函数里用 Map。
struct Point { x: int, y: int }
function pointHash(p: Point): int { return p.x * 31 + p.y; }

struct Index { byName: Map< string, List< int>> }

function countWords<K extends Hashable>(xs: List< K>): Map< K, int> {
    const m: Map< K, int> = mapNew();
    for (x in xs) {
        m.set(x, (m.get(x) catch 0) + 1);
    }
    return m;
}

function main(args: []string): int {
    const ages: Map< string, int> = mapNew();
    ages.set("li", 30);
    ages.set("wang", 25);
    ages.set("zhao", 41);
    ages.set("li", 31);
    print(toStr(ages.get("li") catch 0) + " " + toStr(ages.has("wang")) + " " + toStr(ages.remove("wang")) + " " + toStr(ages.has("wang")) + " " + toStr(ages.len()));
    for (k, v in ages) { print(k + "=" + toStr(v)); }
    for (k in ages) { print(k); }
    print(toStr(ages.get("nobody") catch -1));

    const alias = ages;
    alias.set("qian", 7);
    print(toStr(ages.len()));

    const seen: Set< int> = setNew();
    print(toStr(seen.add(3)) + " " + toStr(seen.add(3)));
    seen.add(7);
    seen.add(5);
    seen.remove(7);
    for (x in seen) { print(toStr(x)); }

    const pts: Map< Point, string> = mapNew();
    pts.set(Point { x: 1, y: 2 }, "a");
    pts.set(Point { x: 1, y: 2 }, "b");
    pts.set(Point { x: 2, y: 1 }, "c");
    print(toStr(pts.len()) + " " + (pts.get(Point { x: 1, y: 2 }) catch "?"));

    const idx = Index { byName: mapNew() };
    const empty: List< int> = listNew();
    idx.byName.set("a", empty);
    const la = idx.byName.get("a") catch empty;
    listPush(la, 1);
    listPush(la, 2);
    print(toStr(listLen(idx.byName.get("a") catch empty)));

    const words: List< string> = listNew();
    listPush(words, "x");
    listPush(words, "y");
    listPush(words, "x");
    const wc = countWords(words);
    for (k, v in wc) { print(k + ":" + toStr(v)); }

    const big: Map< int, int> = mapNew();
    let i: int = 0;
    while (i < 1000) {
        big.set(i, i * i);
        i = i + 1;
    }
    i = 0;
    while (i < 1000) {
        if (i % 3 == 0) { big.remove(i); }
        i = i + 1;
    }
    let sum: int = 0;
    for (k, v in big) { sum = sum + v; }
    big.set(0, 1);
    print(toStr(big.len()) + " " + toStr(sum) + " " + toStr(listGet(big.keys(), 665) catch -1) + " " + toStr(listLen(big.values())));
    big.clear();
    print(toStr(big.len()));

    const tags: Set< string> = setNew();
    tags.add("b");
    tags.add("a");
    tags.add("b");
    const tl = tags.toList();
    print(toStr(listLen(tl)) + " " + (listGet(tl, 0) catch "") + (listGet(tl, 1) catch ""));
    return 0;
}
