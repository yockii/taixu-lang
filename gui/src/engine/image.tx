// ============================================================================
// engine/image —— 图像句柄（GUI 原生引擎 G0）：读 BMP、按像素构造、整块贴到面上。
//
// 自旧宿主移植：句柄 1..16，失败得 0；BMP 经 std/image 解码（24/32 位非压缩，文件上限 64 MiB）；
// 逐像素写时 alpha 被忽略；贴图为不透明块拷贝，越出面的部分丢弃，投影记作
// blit src_rect=(0,0 WxH) -> (x,y)。图像本身不记录绘制。
// ============================================================================

import { Surf, surfMake, surfOk, surfAt, rSetPixel, rLoadRgb, rBlit } from "./raster";
import { BmpImage, decodeBmp } from "std/image";
import { statSize } from "std/fs";

const MAX_IMAGES: int = 16;
const MAX_FILE: int = 67108864;
const MAX_SIDE: int = 65535;

let images: List<Surf> = listNew();
let live: List<bool> = listNew();

function put(s: Surf): int {
    if (s.w == 0) {
        return 0;
    }
    let i: int = 0;
    while (i < listLen(live)) {
        if (!(listTryGet(live, i) catch true)) {
            listSet(images, i, s);
            listSet(live, i, true);
            return i + 1;
        }
        i = i + 1;
    }
    if (listLen(images) >= MAX_IMAGES) {
        return 0;
    }
    listPush(images, s);
    listPush(live, true);
    return listLen(images);
}

function ok(h: int): bool {
    return h >= 1 && (listTryGet(live, h - 1) catch false);
}

function at(h: int): Surf {
    return listTryGet(images, h - 1) catch surfMake(0, 0);
}

/// 读 BMP 文件；失败（读不到、超过 64 MiB、格式不支持、句柄用尽）得 0。
export function imgLoad(path: string): int {
    const size: int = statSize(path) catch -1;
    if (size < 0 || size > MAX_FILE) {
        return 0;
    }
    const data = readFileBytes(path) catch (e) {
        return 0;
    };
    const img: BmpImage = decodeBmp(data) catch (e) {
        return 0;
    };
    const s: Surf = surfMake(img.width, img.height);
    if (s.w == 0) {
        return 0;
    }
    rLoadRgb(s, img.rgb);
    return put(s);
}

/// 新建全黑图像，宽高 1..65535；失败得 0。
export function imgCreate(w: int, h: int): int {
    if (w < 1 || h < 1 || w > MAX_SIDE || h > MAX_SIDE) {
        return 0;
    }
    return put(surfMake(w, h));
}

/// 写一个像素（0xAARRGGBB，alpha 忽略）；句柄无效或越界得 -1。
export function imgSetPixel(h: int, x: int, y: int, argb: int): int {
    if (!ok(h)) {
        return -1;
    }
    const s: Surf = at(h);
    if (x < 0 || y < 0 || x >= s.w || y >= s.h) {
        return -1;
    }
    rSetPixel(s, x, y, argb);
    return 0;
}

export function imgW(h: int): int {
    if (!ok(h)) {
        return 0;
    }
    return at(h).w;
}

export function imgH(h: int): int {
    if (!ok(h)) {
        return 0;
    }
    return at(h).h;
}

/// 释放（幂等）。
export function imgFree(h: int): void {
    if (ok(h)) {
        listSet(images, h - 1, surfMake(0, 0));
        listSet(live, h - 1, false);
    }
}

/// 把图像整块贴到面的 (x, y)；面或图像无效得 -1。
export function imgDraw(surface: int, h: int, x: int, y: int): int {
    if (!surfOk(surface) || !ok(h)) {
        return -1;
    }
    rBlit(surfAt(surface), at(h), x, y);
    return 0;
}
