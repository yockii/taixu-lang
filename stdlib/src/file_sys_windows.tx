// std/file 系统面的 Windows 目标文件（导出面同 file_sys.tx）：kernel32 的 CreateFileW、ReadFile、WriteFile、
// SetFilePointerEx、CloseHandle。共享模式为读、写、删除；路径经 wstr 转 UTF-16，含 NUL 的路径按失败处理。
// 追加按 Rust 的做法只要 FILE_APPEND_DATA、不要 FILE_WRITE_DATA，每次写都落在末尾。目录不能打开（CreateFileW
// 不带 FILE_FLAG_BACKUP_SEMANTICS）。
import { u16At, nulFree } from "./sys_text";

declare type SECURITY_ATTRIBUTES;
declare type OVERLAPPED;
declare function CreateFileW(name: wstr, access: u32, share: u32, sa: SECURITY_ATTRIBUTES?, disposition: u32, flags: u32, template: isize): isize from "kernel32";
declare function ReadFile(h: isize, buf: Bytes, n: u32, got: Bytes, ov: OVERLAPPED?): i32 from "kernel32";
declare function WriteFile(h: isize, buf: Bytes, n: u32, put: Bytes, ov: OVERLAPPED?): i32 from "kernel32";
declare function SetFilePointerEx(h: isize, dist: i64, pos: Bytes, method: u32): i32 from "kernel32";
declare function CloseHandle(h: isize): i32 from "kernel32";

// GENERIC_READ；GENERIC_WRITE；FILE_GENERIC_WRITE 去掉 FILE_WRITE_DATA（0x120114）。
const ACCESS_READ: int = 2147483648;
const ACCESS_WRITE: int = 1073741824;
const ACCESS_APPEND: int = 1179924;
// FILE_SHARE_READ｜FILE_SHARE_WRITE｜FILE_SHARE_DELETE。
const SHARE_ALL: int = 7;
const OPEN_EXISTING: int = 3;
const CREATE_ALWAYS: int = 2;
const OPEN_ALWAYS: int = 4;
const FILE_ATTRIBUTE_NORMAL: int = 128;

export function sysFileOpen(path: string, mode: int): int {
    if (!nulFree(path) || len(path) == 0) {
        return -1;
    }
    let access: int = ACCESS_READ;
    let disp: int = OPEN_EXISTING;
    if (mode == 1) {
        access = ACCESS_WRITE;
        disp = CREATE_ALWAYS;
    } else if (mode == 2) {
        access = ACCESS_APPEND;
        disp = OPEN_ALWAYS;
    }
    const raw = CreateFileW(path, access as u32, SHARE_ALL as u32, None, disp as u32, FILE_ATTRIBUTE_NORMAL as u32, 0 as isize);
    if (raw == -1) {
        return -1;
    }
    const h = __rtHandleAdd(raw as int);
    if (h < 0) {
        CloseHandle(raw);
        return -1;
    }
    return h;
}

export function sysFileRead(h: int, buf: Bytes, n: int): int {
    const raw = __rtHandlePeek(h);
    if (raw < 0) {
        return -2;
    }
    const got = bytesNew(4);
    if (ReadFile(raw as isize, buf, n as u32, got, None) == 0) {
        return -1;
    }
    return u32At(got, 0);
}

// 从 data 的 off 处写至多 n 字节（n 不超过 1 GiB），返回实际写出的字节数（off > 0 时先切出这一段）。
export function sysFileWrite(h: int, data: Bytes, off: int, n: int): int {
    const raw = __rtHandlePeek(h);
    if (raw < 0) {
        return -2;
    }
    if (n == 0) {
        return 0;
    }
    let src: Bytes = data;
    if (off > 0) {
        src = bytesSlice(data, off, n);
    }
    const put = bytesNew(4);
    if (WriteFile(raw as isize, src, n as u32, put, None) == 0) {
        return -1;
    }
    return u32At(put, 0);
}

export function sysFileSeek(h: int, offset: int, whence: int): int {
    const raw = __rtHandlePeek(h);
    if (raw < 0) {
        return -2;
    }
    const pos = bytesNew(8);
    if (SetFilePointerEx(raw as isize, offset, pos, whence as u32) == 0) {
        return -1;
    }
    return u32At(pos, 0) + u32At(pos, 4) * 4294967296;
}

export function sysFileClose(h: int): void {
    const raw = __rtHandleTake(h);
    if (raw >= 0) {
        CloseHandle(raw as isize);
    }
}

function u32At(b: Bytes, off: int): int {
    return u16At(b, off) + u16At(b, off + 2) * 65536;
}
