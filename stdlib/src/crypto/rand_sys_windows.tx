// ProcessPrng 的长度为 SIZE_T，返回 BOOL。系统文档保证成功，仍检查返回值。
declare function ProcessPrng(data: Bytes, length: usize): i32 from "bcryptprimitives";

export function sysRandomRead(data: Bytes, length: int): int {
    if (length < 0 || length > bytesLen(data)) { return -1; }
    if (length == 0) { return 0; }
    if (ProcessPrng(data, length as usize) == 0) { return -1; }
    return length;
}
