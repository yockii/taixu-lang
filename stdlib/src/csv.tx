// ============================================================================
// std/csv —— RFC 4180 子集解析与序列化（V0.38-S3；STD-08）。纯 .tx。
//
// parse：行×列 List<List<string>>（`,` 分隔／`"` 引号域／`""` 转义引号／
// 引号域内逗号与换行——RFC 4180 主干；\r\n 与 \n 行尾同容忍）。serialize：
// 需要转义（逗号/引号/换行）自动引号化。确定性：逐字符状态机，零平台面。
// ============================================================================

// parseRows：CSV 文本 → 行列表（每行＝域列表）。
export function parseRows(text: string): List<List<string>> {
    const rows: List<List<string>> = listNew();
    let row: List<string> = listNew();
    let field: string = "";
    let i: int = 0;
    const n = len(text);
    let in_quotes = false;
    while (i < n) {
        const b = byteAt(text, i) catch 0;
        if (in_quotes) {
            if (b == '"') {
                // `""`＝字面引号。
                if (i + 1 < n && (byteAt(text, i + 1) catch 0) == '"') {
                    field = field + "\"";
                    i = i + 2;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                continue;
            }
            field = field + (utf8Encode(b) catch "");
            i = i + 1;
            continue;
        }
        if (b == '"' && len(field) == 0) {
            in_quotes = true;
            i = i + 1;
            continue;
        }
        if (b == ',') {
            listPush(row, field);
            field = "";
            i = i + 1;
            continue;
        }
        if (b == '\r') {
            // \r\n 行尾（容忍裸 \r）。
            listPush(row, field);
            field = "";
            listPush(rows, row);
            row = listNew();
            i = i + 1;
            if (i < n && (byteAt(text, i) catch 0) == '\n') {
                i = i + 1;
            }
            continue;
        }
        if (b == '\n') {
            listPush(row, field);
            field = "";
            listPush(rows, row);
            row = listNew();
            i = i + 1;
            continue;
        }
        field = field + (utf8Encode(b) catch "");
        i = i + 1;
    }
    // 尾行（无行尾符）：有域内容或已有域即成行（全空尾行不产空行——RFC 惯例）。
    if (len(field) > 0 || listLen(row) > 0) {
        listPush(row, field);
        listPush(rows, row);
    }
    return rows;
}

// serializeRows：行列表 → CSV 文本（需要时引号化——RFC 4180 §2）。
export function serializeRows(rows: List<List<string>>): string {
    let out: string = "";
    let r: int = 0;
    while (r < listLen(rows)) {
        const row = listGet(rows, r) catch panic("csv.serializeRows: 行越界（不可达）");
        let c: int = 0;
        while (c < listLen(row)) {
            if (c > 0) {
                out = out + ",";
            }
            out = out + quoteField(listGet(row, c) catch "");
            c = c + 1;
        }
        out = out + "\r\n";
        r = r + 1;
    }
    return out;
}

function quoteField(field: string): string {
    // 需要引号：含逗号/引号/CR/LF（RFC 4180 §2.5-7）。
    let need = false;
    let i: int = 0;
    while (i < len(field)) {
        const b = byteAt(field, i) catch 0;
        if (b == ',' || b == '"' || b == '\r' || b == '\n') {
            need = true;
            break;
        }
        i = i + 1;
    }
    if (!need) {
        return field;
    }
    let out: string = "\"";
    let k: int = 0;
    while (k < len(field)) {
        const b = byteAt(field, k) catch 0;
        if (b == '"') {
            out = out + "\"\"";
        } else {
            out = out + (utf8Encode(b) catch "");
        }
        k = k + 1;
    }
    return out + "\"";
}
