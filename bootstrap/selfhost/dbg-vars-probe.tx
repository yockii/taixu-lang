// dbg-vars-probe.tx —— 调试构建变量表的探针（第 6 轮 6c-4a，调试实施设计 §四-3、§六）。
// 用法：dbg-vars-probe <入口.tx> [linux]（须以 --toolchain 构建）。
// 按调试构建编译到 ProgramContext 为止，对每个有变量的函数，逐个语句检查点（callbi 3073）列出该处可见的变量：
//   fn <函数名>
//     <行>:<列> <名字>@<槽>:<类型> …
//     all <名字>@<槽>:<类型> …（登记序的全部变量；switch 臂只含表达式时没有语句检查点，靠这一行核对）
// 这正是调试器停在该语句时能看到的变量；scripts/test-native-debug-vars.py 拿它与金输出逐字节比对。
import { drvDebugContext, drvLastContext, drvDiagOut, drvSetPrelude } from "./driver";
import { DBG_STMT } from "./builtin_names";
import { T_X64_WINDOWS, T_X64_LINUX } from "./target";

function noInts(): List<int> { return listNew(); }
function noStrs(): List<string> { return listNew(); }

function tyText(names: List<string>, ty: int): string {
    if (ty < 0) { return "?"; }
    return listGet(names, ty) catch "?";
}

function main(args: []string): int {
    if (len(args) < 1) {
        eprint("用法: dbg-vars-probe <入口.tx> [linux]");
        return 64;
    }
    let t = T_X64_WINDOWS;
    if (len(args) >= 2 && args[1] == "linux") { t = T_X64_LINUX; }
    drvSetPrelude(bytesToStr(embedBytes("../../prelude/collections.tx")) catch "");
    if (drvDebugContext(args[0], t) != 0) {
        eprint(drvDiagOut());
        return 1;
    }
    const ctx = drvLastContext() catch (e) {
        eprint(e.message);
        return 1;
    };
    const info = ctx.dbg;
    let fi = 0;
    while (fi < listLen(info.vars)) {
        const vars = listGet(info.vars, fi) catch noInts();
        const names = listGet(info.varNames, fi) catch noStrs();
        if (listLen(vars) > 0) {
            print("fn " + (listGet(ctx.cgStrings, listGet(ctx.fnNameIdx, fi) catch 0) catch "?"));
            const code = listGet(ctx.fnCode, fi) catch noInts();
            const ll = listGet(ctx.fnLinesL, fi) catch noInts();
            const lc = listGet(ctx.fnLinesC, fi) catch noInts();
            let pc = 0;
            while (pc < listLen(code)) {
                const ins = listGet(code, pc) catch 0;
                if ((ins & 65535) == 31 && ((ins >> 32) & 65535) == DBG_STMT) {
                    let line = "  " + toStr(listGet(ll, pc) catch 0) + ":" + toStr(listGet(lc, pc) catch 0);
                    let vi = 0;
                    while (vi * 4 < listLen(vars)) {
                        const start = listGet(vars, vi * 4 + 2) catch 0;
                        const end = listGet(vars, vi * 4 + 3) catch 0;
                        if (start <= pc && pc < end) {
                            line = line + " " + (listGet(names, vi) catch "?") + "@" + toStr(listGet(vars, vi * 4) catch 0) + ":" + tyText(info.tyNames, listGet(vars, vi * 4 + 1) catch -1);
                        }
                        vi = vi + 1;
                    }
                    print(line);
                }
                pc = pc + 1;
            }
            let all = "  all";
            let vi = 0;
            while (vi * 4 < listLen(vars)) {
                all = all + " " + (listGet(names, vi) catch "?") + "@" + toStr(listGet(vars, vi * 4) catch 0) + ":" + tyText(info.tyNames, listGet(vars, vi * 4 + 1) catch -1);
                vi = vi + 1;
            }
            print(all);
        }
        fi = fi + 1;
    }
    return 0;
}
