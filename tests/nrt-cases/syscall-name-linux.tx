// D3 v0.47：from syscall "名字" 按目标架构查内核号表，与数字形态得同一个系统调用；数字形态写在按架构选的
// 文件里（data/sysnum_linux_<架构>.tx：x86_64 的 39、aarch64、loongarch64 与 riscv64 的 172 都是 getpid）。产物仍静态、无 libc，返回值本身就是 -errno。
import { pidByNumber } from "./data/sysnum";
declare function pidByName(): i32 from syscall "getpid";
declare function write(fd: i32, buf: Bytes, n: usize): isize from syscall "write";
declare function close(fd: i32): i32 from syscall "close";
declare function openat(dir: i32, path: string, flags: i32, mode: u32): i32 from syscall "openat";

function main(args: []string): int {
    print("same pid " + toStr(pidByName() == pidByNumber()));
    const msg = bytesFromStr("via name\n");
    print("wrote " + toStr(write(1, msg, bytesLen(msg) as usize) as int));
    print("close bad " + toStr(close(-1)));
    const fd = openat(-100, "syscall-name-linux.tx", 0, 0);
    print("open " + toStr(fd >= 0) + " close " + toStr(close(fd)));
    return 0;
}
