// 内部 worker 入口先核验实际 Job 限额；仅有命令行标记不能绕过守卫。
declare type JOB;
declare function QueryInformationJobObject(job: JOB?, kind: i32, info: Bytes, size: u32, written: Bytes): i32 from "kernel32";
function u32at(b: Bytes, at: int): int {
    let n = 0; let i = 0; while (i < 4) { n = n | ((bytesGet(b, at + i) catch 0) << (i * 8)); i = i + 1; } return n;
}
function u64at(b: Bytes, at: int): int {
    return u32at(b, at) | (u32at(b, at + 4) << 32);
}
export function workerLimitsValid(memory: int, cpu: int): bool {
    const b = bytesNew(144); const written = bytesNew(4);
    if (QueryInformationJobObject(None, 9, b, 144, written) == 0 || u32at(written, 0) != 144) { return false; }
    const flags = u32at(b, 16);
    if ((flags & 9998) != 9998 || (flags & 6144) != 0 || u32at(b, 40) < 1 || u32at(b, 40) > 32) { return false; }
    const pm = u64at(b, 112); const jm = u64at(b, 120); const pt = u64at(b, 0); const jt = u64at(b, 8);
    return pm > 0 && pm <= memory && jm > 0 && jm <= memory && pt > 0 && pt <= cpu * 10000000 && jt > 0 && jt <= cpu * 10000000;
}
