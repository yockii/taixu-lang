// 按值结构体（D3 v0.45，Linux）：外部结构体按值传与返回，SysV x86_64 的分类——不大于 16 字节的按八字节分类：INTEGER 依次用整数
// 寄存器（div 的两个 i32 合在一个八字节、lldiv 在 RAX 与 RDX、inet_ntoa 的 4 字节 in_addr），SSE 依次用 XMM（conj 的两个
// double 在 XMM0、XMM1，conjf 的两个 f32 合在 XMM0 的低 8 字节）。按值参数调用后太虚侧不变；返回的是新值。
import { CARR, divNested, conjArr } from "./data/ffi_byvalue_alt";

declare struct DIV { quot: i32, rem: i32 }
declare struct LLDIV { quot: int, rem: int }
declare struct DCOMPLEX { re: float, im: float }
declare struct FCOMPLEX { re: f32, im: f32 }
declare struct INADDR { s: u32 }
declare function div(a: i32, b: i32): DIV from "libc.so.6";
declare function lldiv(a: int, b: int): LLDIV from "libc.so.6";
declare function inet_ntoa(a: INADDR): string from "libc.so.6";
declare function inet_makeaddr(net: u32, host: u32): INADDR from "libc.so.6";
declare function cabs(z: DCOMPLEX): float from "libm.so.6";
declare function cabsf(z: FCOMPLEX): f32 from "libm.so.6";
declare function conj(z: DCOMPLEX): DCOMPLEX from "libm.so.6";
declare function conjf(z: FCOMPLEX): FCOMPLEX from "libm.so.6";

function showC(z: DCOMPLEX): string { return toStr(z.re) + "," + toStr(z.im); }
function showF(z: FCOMPLEX): string { return toStr(z.re) + "," + toStr(z.im); }

function main(args: []string): int {
    const d = div(17, 5);
    const n = div(-17, 5);
    print("div " + toStr(d.quot) + " " + toStr(d.rem) + " " + toStr(n.quot) + " " + toStr(n.rem));
    const l = lldiv(10000000000000, 7);
    print("lldiv " + toStr(l.quot) + " " + toStr(l.rem));
    const qr = divNested(-9, 4);
    print("nested " + toStr(qr.q[0]) + " " + toStr(qr.r.v));
    let z = DCOMPLEX { re: 3.0, im: 4.0 };
    print("abs " + toStr(cabs(z)));
    const c = conj(z);
    print("conj " + showC(c) + " arg-kept " + showC(z));
    z.re = 9.0;
    print("result-kept " + showC(c) + " arg " + showC(z));
    const fz = FCOMPLEX { re: 3.0, im: 4.0 };
    print("fabs " + toStr(cabsf(fz)) + " conjf " + showF(conjf(fz)));
    const arr = conjArr(CARR { v: [1.5, -2.5] });
    print("arr " + toStr(arr.v[0]) + "," + toStr(arr.v[1]));
    print("ntoa " + inet_ntoa(INADDR { s: 67305985 }) + " " + inet_ntoa(inet_makeaddr(127, 1)));
    return 0;
}
