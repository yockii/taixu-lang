// 调试构建的符号信息（第 6 轮 6c-4a，调试实施设计 §四-3）：只在调试构建时由 codegen 填写，正常构建全空；
// 不进 .txc，也不进原生镜像，只留给同进程的调试会话。
// - vars 每函数（fn 表序）一行，每个变量四项（槽, 类型, 起 pc, 止 pc）：在 [起, 止) 内的检查点上该槽是这个变量；
//   varNames 与它平行，每个变量一个名字。类型是 SEB1 类型池号，−1 为未知。
// - tysK、tysA、tysB 是 SEB1 类型池（codegen 解析后的形：定宽数值为种类 0 或 1、b 为种类码，FFI 句柄为 int），
//   tyNames 是 sema 给的各项源码拼写（池序）。
// - declFSeb、declVSeb、declVCnt 与 codegen 的 decl 表平行（6c-4c）：每个 decl 各字段的 SEB1 类型（−1 为未知）、
//   变体字段按 decl 摊平的 SEB1 类型、每个变体的字段数。decl 表本身是压平后的 TXC 类型，定宽种类已丢。
// - sebStructs、sebEnums：SEB1 的结构号、枚举号 → decl（−1 为未登记）。没有 TXC 类型指向的 decl（如只在局部变量
//   里用到的枚举），对象头的类型号给不出 decl，会话按静态类型或富错误里的枚举号经这两张表找回。
export struct DbgInfo {
    vars: List<List<int>>,
    varNames: List<List<string>>,
    tysK: List<int>,
    tysA: List<int>,
    tysB: List<int>,
    tyNames: List<string>,
    declFSeb: List<List<int>>,
    declVSeb: List<List<int>>,
    declVCnt: List<List<int>>,
    sebStructs: List<int>,
    sebEnums: List<int>,
}

export struct ProgramContext {
    version: int,
    ok: int,
    error: string,
    entry: int,
    cgStrings: List<string>,
    cgRawStrings: List<Bytes>, // 稀疏旁表：非空项是对应编号的二进制载荷；不作为语言字符串暴露。
    cgTysK: List<int>,
    cgTysA: List<int>,
    cgTysB: List<int>,
    declMods: List<int>,
    declNameIdx: List<int>,
    declIsEnum: List<int>,
    declFieldNames: List<List<int>>,
    declFieldTys: List<List<int>>,
    declVariantNames: List<List<int>>,
    declVarFNames: List<List<int>>,
    declVarFTys: List<List<int>>,
    declVarFCnt: List<int>,
    fnNameIdx: List<int>,
    fnModule: List<int>,
    fnReg: List<int>,
    fnNparams: List<int>,
    fnCode: List<List<int>>,
    fnConstsK: List<List<int>>,
    fnConstsI: List<List<int>>,
    fnConstsTbl: List<List<int>>,
    fnConstsTblLen: List<List<int>>,
    fnLinesL: List<List<int>>,
    fnLinesC: List<List<int>>,
    fnPtys: List<List<int>>,
    fnRet: List<int>,
    modOutPath: List<int>,
    modOutState: List<int>,
    modOutInit: List<int>,
    testOutName: List<int>,
    testOutFunc: List<int>,
    extNames: List<string>,
    extTags: List<List<int>>,
    extRets: List<int>,
    fnSigDescs: List<List<int>>,
    // 每函数取消落点（扁平对：挂起点 pc、落点 pc；原生异步，仅本地上下文，不进 .txc）。
    fnLandings: List<List<int>>,
    // D3 v0.23 FFI（SEB1 FFI1 → .txc TXFFI 尾节；不含带 from 的外部函数时全空）：
    // ffiExt 每个 extern 一行 [方式, 库名序＋1, syscall 号, 返回种类, 返回附加, 模块, 行, 列, 参数数, (种类, 附加)×参数数, 定参个数]
    // （D3 v0.36：定参个数之后的参数按 C 变参约定传；没有变参参数时等于参数数）；
    // ffiLay 每个外部结构体一行 [struct 池序＋1, 大小, 对齐, 字段数, (偏移, 种类, 元素数, 附加)×字段数]；
    // ffiCb 每个回调签名一行 [返回种类, 参数数, 种类×参数数]；ffiCbFn 回调实参（fn 表序, 回调签名序）成对。
    ffiLibs: List<string>,
    ffiExt: List<List<int>>,
    ffiLay: List<List<int>>,
    ffiCb: List<List<int>>,
    ffiCbFn: List<int>,
    // 线程第 3b 步：不可发送的运行期类型号（TXC 类型表序；程序不用 threadSpawn 时为空），原生镜像据此发可发送表。
    sendBad: List<int>,
    // 线程第 4c 步：其中连共享也不可的类型号（不含 Atomic 的那些；是 sendBad 的子集）。
    shareBad: List<int>,
    dbg: Ref<DbgInfo>,
}

export function programStringBytes(p: Ref<ProgramContext>, i: int): Bytes {
    if (i < listLen(p.cgRawStrings)) {
        const raw = listGet(p.cgRawStrings, i) catch bytesNew(0);
        if (bytesLen(raw) > 0) { return raw; }
    }
    return bytesFromStr(listGet(p.cgStrings, i) catch "");
}
export function programStringLength(p: Ref<ProgramContext>, i: int): int {
    if (i < listLen(p.cgRawStrings)) {
        const raw = listGet(p.cgRawStrings, i) catch bytesNew(0);
        if (bytesLen(raw) > 0) { return bytesLen(raw); }
    }
    return len(listGet(p.cgStrings, i) catch "");
}
export function programStringsEqual(p: Ref<ProgramContext>, i: int, j: int): bool {
    if (listLen(p.cgRawStrings) == 0) { return (listGet(p.cgStrings, i) catch "") == (listGet(p.cgStrings, j) catch ""); }
    return bytesEqual(programStringBytes(p, i), programStringBytes(p, j));
}
