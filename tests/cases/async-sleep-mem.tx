// V0.10-A1 e2e：定时器/取消账目零滞留（原生 --leak-check；D29 §一-3/§二）——
// 0ms 到期收割＋不到期（任务先完成）排水空操作＋失败者取消，三类路径
// 的 future/定时器引用全部释放。
function main(args: []string): int {
    const a = expireNow();
    const b = abandonTimer();
    const c = stalled(7);
    const w = watch(c);
    taskCancel(c); // 失败者取消（取消即清理——watch 经取消通道收割）
    print("spawned");
    return 0;
}

async function expireNow(): int {
    await sleepMs(0) catch (e) {
        return err(e.message);
    };
    print("expired");
    return 1;
}

// 定时器弃用面：spawn 定时器但不 await、任务先完成——收割空操作路径。
async function abandonTimer(): int {
    const unused = sleepMs(60000);
    return 2;
}

async function stalled(n: int): int {
    const s = sleepMs(60000);
    await s catch (e) {
        return err(e.message);
    };
    return n;
}

async function watch(f: Future<int>): int {
    const v = await f catch (e) {
        return 0;
    };
    return v;
}
