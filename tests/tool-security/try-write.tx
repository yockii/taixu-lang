function require(ok: bool): void { assert(ok, "bounded process write"); }
function childArgs(exe: string, mode: string): List<string> {
    const a: List<string> = listNew(); listPush(a, exe); listPush(a, mode); return a;
}
function main(args: []string): int {
    if (len(args) == 2) {
        if (args[1] == "invalid") { procTryWrite(999999, 0, bytesNew(0)); return 99; }
        if (args[1] == "stall") { const until = monoNs() + 2000000000; while (monoNs() < until) {} return 7; }
        if (args[1] == "closed") { return 0; }
        if (args[1] == "drain") {
            const until = monoNs() + 300000000; while (monoNs() < until) {}
            const b = bytesNew(65536); let received = 0;
            const begin = monoNs();
            while (received < 200000 && monoNs() - begin < 5000000000) {
                const got = stdinRead(b, 1000); if (got < 0) { return 2; } received = received + got;
            }
            print(toStr(received)); if (received == 200000) { return 17; } return 3;
        }
        return 64;
    }
    if (len(args) != 1) { return 64; }
    const payload = bytesNew(200000);
    let h = procSpawn(args[0], childArgs(args[0], "stall"), "", 1) catch -1;
    require(h > 0); let sent = 0; let blocked = false; const begin = monoNs();
    while (sent < 1000000 && !blocked) {
        const n = procTryWrite(h, 0, payload); require(n >= 0 && n < bytesLen(payload));
        sent = sent + n; if (n == 0) { blocked = true; }
    }
    require(sent > 0 && blocked && monoNs() - begin < 1000000000 && procWait(h, 0) == None);
    let i = 0; while (i < 3) { require(procTryWrite(h, 0, payload) == 0); i = i + 1; }
    procKill(h); require(procWait(h, 1000) != None); procClose(h);
    h = procSpawn(args[0], childArgs(args[0], "drain"), "", 1) catch -1; require(h > 0);
    const n = procTryWrite(h, 0, payload); require(n > 0 && n < bytesLen(payload));
    const tail = bytesSlice(payload, n, bytesLen(payload) - n);
    require(procWrite(h, 0, tail) == bytesLen(tail));
    require((procWait(h, 5000) catch -1) == 17);
    const out = bytesNew(4096); const got = procRead(h, 1, out);
    require(got > 0 && (bytesToStr(bytesSlice(out, 0, got)) catch "") == "200000\n"); procClose(h);
    h = procSpawn(args[0], childArgs(args[0], "closed"), "", 1) catch -1; require(h > 0);
    require((procWait(h, 5000) catch -1) == 0);
    require(procTryWrite(h, 0, payload) == -1 && procTryWrite(h, 0, payload) == -1); procClose(h);
    print("PASS_TRY_WRITE_STOPPED_READER_FULL_RECOVERY_BLOCKING_WRITE_CLOSED_PEER"); return 0;
}
