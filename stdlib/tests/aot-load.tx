// AOT 双路代表负载（V0.7-S5，D20 §五④）：stdlib 消费面——JSON 解析→Map 互转→
// 字符串工具→规范形输出，走 scripts/aot-e2e.sh 双路（AOT 产物 vs taixu run
// stdout＋exit 逐字节＋重复运行恒等）。

import { jsonParse, jsonStringify, Json } from "std/json";
import { mapNew, mapSet, mapKeys, objToMap, mapToObj } from "std/map_set";
import { toUpper, join } from "std/string";

export function main(args: []string): int {
    const src = "{\"name\":\"太虚\",\"tags\":[\"ai\",\"native\"],\"v\":7}";
    const j = jsonParse(src) catch new Json.Null();

    // Json → Map（键序保持）→ 改写 → Map → Json 规范形。
    const m = objToMap(j) catch mapNew();
    mapSet(m, "v", new Json.Str("v0.7"));
    print(join(mapKeys(m), ","));
    print(jsonStringify(mapToObj(m)));
    print(toUpper("stdlib-ok"));
    return 0;
}
