// V0.38-S2 AOT 双路锚：os/fs extern 面（txp_os_*/txp_fs_*——platform.fsops
// 同表分发＝math_host 先例；shim used_externs 过滤装配活体）。
// 恒定性：输出不含时间/路径外部态（env 自设自读＋临时文件自清理）。
import { setenv, getenv } from "std/os";
import { fsWriteAll, fsReadAll, statSize, fsRemove, fsExists } from "std/fs";

export function main(args: []string): int {
    setenv("TX_AOT_OSFS", "v38") catch panic("setenv");
    print(getenv("TX_AOT_OSFS"));
    fsWriteAll("tx-aot-osfs.tmp", "abcd") catch panic("write");
    print(toStr(statSize("tx-aot-osfs.tmp") catch -1));
    print(fsReadAll("tx-aot-osfs.tmp") catch "err");
    fsRemove("tx-aot-osfs.tmp") catch panic("remove");
    print("removed");
    print(toStr(fsExists("tx-aot-osfs.tmp")));
    return 0;
}
