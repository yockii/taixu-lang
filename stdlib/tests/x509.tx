import { x509ParseCertificate, x509ParseCertificateLimit } from "std/x509";
import { x509Time } from "std/x509_der";
import { derRead } from "std/crypto/der";
import { p256Hex } from "std/crypto/p256_field";
import { sha256SumHex } from "std/hash";
import { constantTimeEqual } from "std/crypto/subtle";
import { parseInt } from "std/strconv";

function hex(text: string): Bytes { if (text == "-") { return bytesNew(0); } return p256Hex(text); }
function number(text: string): int { return parseInt(text) catch panic("fixture number"); }
function rejected(data: Bytes): bool { x509ParseCertificate(data) catch (e) { return true; }; return false; }
function badTime(data: Bytes): bool {
    const v = derRead(data, 0, bytesLen(data)) catch panic("time DER"); x509Time(data, v) catch (e) { return true; }; return false;
}

test "X.509：独立实现的证书字段与时间" {
    const fixture = readFile("tests/vectors/x509.txt") catch panic("cert fixtures"); let count = 0; let times = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const kind = listGet(p, 0);
        if (kind == "time") {
            const raw = hex(listGet(p, 1));
            assert((x509Time(raw, derRead(raw, 0, bytesLen(raw)) catch panic("time node")) catch panic("time")) == number(listGet(p, 2)), "time " + toStr(times));
            times = times + 1;
        } else if (kind == "good") {
            const raw = hex(listGet(p, 1)); const original = bytesSlice(raw, 0, bytesLen(raw));
            const cert = x509ParseCertificate(raw) catch (e) { panic("certificate " + toStr(count) + ": " + e.message); };
            assert(cert.version == number(listGet(p, 2)) && constantTimeEqual(cert.serial, hex(listGet(p, 3))), "version and serial");
            assert(cert.notBeforeSecs == number(listGet(p, 4)) && cert.notAfterSecs == number(listGet(p, 5)), "validity");
            assert(sha256SumHex(cert.issuer) == listGet(p, 6) && sha256SumHex(cert.subject) == listGet(p, 7), "names");
            assert(cert.publicKeyAlgorithm.oidHex == listGet(p, 8) && sha256SumHex(cert.publicKey) == listGet(p, 9), "key fields");
            assert(cert.signatureAlgorithm.oidHex == listGet(p, 10) && sha256SumHex(cert.signature) == listGet(p, 11), "signature fields");
            assert(sha256SumHex(cert.tbs) == listGet(p, 12) && listLen(cert.extensions) == number(listGet(p, 13)) && sha256SumHex(cert.spki) == listGet(p, 14), "TBS extensions SPKI");
            assert(constantTimeEqual(raw, original), "parse preserves input"); bytesSet(raw, 0, 0);
            assert(constantTimeEqual(cert.der, original), "certificate owns DER copy"); count = count + 1;
        }
    }
    assert(count == 5 && times == 5, "all certificate and time fixtures");
}

test "X.509：结构、算法、重复扩展与非法日期拒绝" {
    const fixture = readFile("tests/vectors/x509.txt") catch panic("cert fixtures"); let certificates = 0; let times = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const kind = listGet(p, 0);
        if (kind == "bad") { assert(rejected(hex(listGet(p, 2))), "certificate rejection " + listGet(p, 1)); certificates = certificates + 1; }
        else if (kind == "badtime") { assert(badTime(hex(listGet(p, 1))), "time rejection " + toStr(times)); times = times + 1; }
    }
    assert(certificates == 14 && times == 10, "all rejection fixtures");
}

function limitFails(raw: Bytes, bytes: int, extensions: int): bool { x509ParseCertificateLimit(raw, bytes, extensions) catch (e) { return true; }; return false; }

test "X.509：输入与扩展个数的精确上限" {
    const fixture = readFile("tests/vectors/x509.txt") catch panic("cert fixtures"); let checked = false;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " ");
        if (listGet(p, 0) == "good") {
            const raw = hex(listGet(p, 1)); const extensions = number(listGet(p, 13));
            const cert = x509ParseCertificateLimit(raw, bytesLen(raw), extensions) catch panic("exact limits");
            assert(bytesLen(cert.der) == bytesLen(raw), "exact byte count");
            assert(limitFails(raw, bytesLen(raw) - 1, extensions) && limitFails(raw, bytesLen(raw), extensions - 1), "limit exceeded");
            assert(limitFails(raw, 0, extensions) && limitFails(raw, bytesLen(raw), -1), "invalid limits"); checked = true; break;
        }
    }
    assert(checked, "fixture selected");
}
