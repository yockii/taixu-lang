// flex —— flex 布局暴露示范（臂②；#16）：
// gui/layout.tx 实现确定性整数 flex 子集，包含 22 例布局
// 用例表恒等对拍见 tests/layout.tx）＋pump resize 自适应：布局树声明 →
// 每脏帧按当前 app.w/h 重解算 → 盒几何写回组件（列 header/body(grow)/
// footer(gap) 三段；footer 双钮 flex 分配）。resize 后下一帧自动重排——
// 命中区同步重登记（真窗 target=-1 哨兵通道同路径）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/flex-replay.txt TAIXU_FRAME=2 taixu run examples/flex.tx
import { Canvas, Button, button, paintFillRect, paintText, drawButtonC } from "gui/components";
import { App, appNew, appClose, pump, onResize, hitZone, onClick, isHover, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvasK } from "gui/text";
import { styleDefault, nodeNew, resolve, boxAt, DIR_COLUMN, ALIGN_STRETCH, LayoutBox, Node } from "gui/layout";

const BTN_SAVE: int = 1;
const BTN_QUIT: int = 2;

struct Model {
    surface: int,
    save: Ref<Button>,
    quit: Ref<Button>,
    saves: int,
    body_geo: string, // 末帧 body 盒（stdout 观测面——重排前/后对比）
}

/// 布局树构建（每帧重建——UI 即数据：树为值声明，RC 面旧树即弃）。
/// 根列：header 24 定高 ＋ body grow ＋ footer 32 定高（gap 8）；
/// footer 行：save 定宽 72 ＋ quit grow（gap 8）。
function buildTree(): Ref<Node> {
    const root = nodeNew(styleDefault());
    root.style.direction = DIR_COLUMN;
    root.style.gap = 8;
    const header = nodeNew(styleDefault());
    header.style.height = 24;
    const body = nodeNew(styleDefault());
    body.style.grow = 1;
    const footer = nodeNew(styleDefault());
    footer.style.height = 32;
    footer.style.gap = 8;
    footer.style.align_items = ALIGN_STRETCH; // 行内满高
    const bsave = nodeNew(styleDefault());
    bsave.style.width = 72;
    const bquit = nodeNew(styleDefault());
    bquit.style.grow = 1;
    listPush(footer.children, bsave);
    listPush(footer.children, bquit);
    listPush(root.children, header);
    listPush(root.children, body);
    listPush(root.children, footer);
    return root;
}

function render(cv: Ref<Canvas>, app: Ref<App>, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x202040);
    // 布局解算（DIP 空间——帧级 DPI 由 canvas k 因子出物理像素，臂①面）。
    const boxes: List<Ref<LayoutBox>> = resolve(buildTree(), app.w, app.h);
    const header = boxAt(boxes, 1);
    const body = boxAt(boxes, 2);
    const footer = boxAt(boxes, 3);
    const bsave = boxAt(boxes, 4);
    const bquit = boxAt(boxes, 5);
    // 盒几何写回组件（resize 自动重排的落点——pump 已更新根尺寸）。
    m.save.x = bsave.x;
    m.save.y = bsave.y;
    m.save.w = bsave.w;
    m.save.h = bsave.h;
    m.quit.x = bquit.x;
    m.quit.y = bquit.y;
    m.quit.w = bquit.w;
    m.quit.h = bquit.h;
    // 绘制（header/body 直接面；footer 走组件钮）。
    paintFillRect(cv, header.x, header.y, header.w, header.h, 0x30305A);
    paintText(cv, header.x + 8, header.y + 7, 0xFFFFFF, "flex layout demo");
    paintFillRect(cv, body.x, body.y, body.w, body.h, 0x182032);
    paintText(cv, body.x + 8, body.y + 8, 0xC0C8E0, "body(flex-grow=1)");
    m.save.hovered = isHover(app, BTN_SAVE);
    m.quit.hovered = isHover(app, BTN_QUIT);
    drawButtonC(cv, m.save);
    drawButtonC(cv, m.quit);
    // 命中区随布局同步（真窗通道——坐标恒 DIP 空间）。
    hitZone(app, BTN_SAVE, m.save.x, m.save.y, m.save.w, m.save.h);
    hitZone(app, BTN_QUIT, m.quit.x, m.quit.y, m.quit.w, m.quit.h);
    // 观测面：body/footer 几何入 stdout（重排前/后对比锚）。
    m.body_geo = "body=(" + toStr(body.x) + "," + toStr(body.y) + "," + toStr(body.w) + "," + toStr(body.h) + ") quit=(" + toStr(m.quit.x) + "," + toStr(m.quit.y) + "," + toStr(m.quit.w) + "," + toStr(m.quit.h) + ")";
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, save: button(BTN_SAVE, 0, 0, 72, 32, "save"), quit: button(BTN_QUIT, 0, 0, 60, 32, "quit"), saves: 0, body_geo: "" };
    const spec = defaultSpec("taixu flex", 260, 180);
    const app = appNew(spec);
    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 真实文本轨：系统的中文界面字体，没装则用嵌入字体（重放与定格态恒为嵌入字体）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    // resize 即失效（pump 默认零手写自适应）——surface 物理面随重建（臂①面）。
    onResize(app, (w: int, h: int): void => {
            surfaceClose(m.surface);
            m.surface = surfaceOpenDip(w, h, app.k) catch 0;
        });
    onClick(app, BTN_SAVE, (rec: EventRecord): void => {
            if (rec.kind != 3) {
                return;
            }
            m.saves = m.saves + 1;
        });
    let presents: int = 0;
    let frame: int = 0;
    let last_geo: string = "";
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvasK(m.surface, app.w, app.h, fb.handle, 14, app.k);
            render(cv, app, m);
            last_geo = m.body_geo;
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("saves=" + toStr(m.saves) + " resize_count=" + toStr(app.resize_count) + " k=" + toStr(app.k) + " presents=" + toStr(presents));
    print(last_geo);
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
