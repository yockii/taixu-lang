// P5 边界用例（临时）：优先级链/深嵌套/一元负号链/catch 双形态相邻/new 双形态/switch 模式字段/联合两写法/控制流形态。
struct Point {
    x: int,
    y: int,
}
enum Expr {
    Num(value: int),
    Add(l: Expr, r: Expr),
}
function f3(a: int, b: int, c: int): int {
    return a + b * c - a / b % c;
}
function g(): int | Error {
    return 1;
}
function h1(): int | Error {
    return 1;
}
function h2(): Error | int {
    return 1;
}
function main(args: []string): int {
    const a: int = 1;
    const b: bool = true;
    const p = new Point { x: 1, y: 2 };
    const e = new Expr.Num(3);
    const r1 = a + b * 2 == 5 || a < 3 && !(a == 1);
    const r2 = ((a + 1) * (a + 2)) % f3(a, f3(a, b, 3), 3);
    const r3 = --a + -a * !b;
    const r4 = g() catch 0;
    const r5 = g() catch (err) {
        return 0;
    };
    const r6 = switch (e) {
        case Num(n) => n,
        case Add(x, y) => 1,
        else => 0,
    };
    if (a < 1) {
        return 1;
    } else if (a < 2) {
        return 2;
    } else {
        return 3;
    }
    let i: int = 0;
    while (i < 10) {
        if (i == 3) {
            i = i + 1;
            continue;
        }
        if (i == 8) {
            break;
        }
        i = i + 1;
    }
    for (let j: int = 0; j < 3; j = j + 1) {
        i = j;
    }
    for (; i < 5;) {
        i = i + 1;
    }
    const w = p.x + args[0].len;
    return r1 as int;
}
