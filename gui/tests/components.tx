// components 框架用例（守护面）：静态三件＋input/list
// 扩面组件的确定性绘制——同组件序列 → 同像素（sha256 锚）＋投影行。
// 纯无头面（surface 原语软件光栅，四目标可用）。
import { box, text, button, input, listWidget, drawBox, drawText, drawButton, drawInput, drawList, hitButton, EV_MOUSE_DOWN, EV_RESIZE, EV_CLOSE } from "gui/components";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256, surfaceProject } from "gui/surface";

export function main(args: []string): int {
    args;
    const s = surfaceOpen(120, 110) catch (e) {
        print("surface open failed: " + e.message);
        return 1;
    };
    surfaceClear(s, 0x202040);
    const panel = box(1, 4, 4, 112, 40, 0x30305A);
    drawBox(s, panel);
    const title = text(0, 8, 8, "taixu-gui");
    drawText(s, title);
    const btn = button(2, 8, 52, 48, 20, "ok");
    drawButton(s, btn);
    const inp = input(3, 62, 54, 50, "hi");
    drawInput(s, inp);
    const items: List<string> = listNew();
    listPush(items, "alpha");
    listPush(items, "beta");
    const lw = listWidget(4, 8, 78, 60, items);
    drawList(s, lw, 10);
    // 命中测试纯函数面（不依赖通道）。
    print("hit_inside=" + toStr(hitButton(btn, 10, 60)));
    print("hit_outside=" + toStr(hitButton(btn, 100, 60)));
    // 事件 kind 常量面（与核心仓 platform 枚举同码）。
    print("kinds=" + toStr(EV_MOUSE_DOWN) + "," + toStr(EV_RESIZE) + "," + toStr(EV_CLOSE));
    print("sha256=" + surfaceSha256(s));
    print(surfaceProject(s));
    surfaceClose(s);
    return 0;
}
