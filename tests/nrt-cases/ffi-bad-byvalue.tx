// 按值结构体前端负例（D3 v0.45）：按值的外部结构体不能作变参参数、不能出现在回调签名里、from syscall 不收；按值返回的结构体（含
// 嵌套的）不能有 string、wstr、Bytes 或回调字段（太虚读不回 C 指针）。
declare struct PT { x: i32, y: i32 }
declare struct NAMED { name: string, n: i32 }
declare struct OUTER { inner: NAMED, k: i32 }
declare function v1(fmt: string, ...p: PT): i32 from "libc.so.6";
declare function c1(cb: (PT) => i32): void from "k";
declare function c2(cb: () => PT): void from "k";
declare function r1(): NAMED from "k";
declare function r2(): OUTER from "k";
declare function s1(p: PT): i32 from syscall 7;
declare function s2(): PT from syscall 8;
declare function ok1(p: NAMED): PT from "k";

function main(args: []string): int {
    return 0;
}
