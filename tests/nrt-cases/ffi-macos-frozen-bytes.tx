// macOS 适配 M2（设计稿 F3，伴文件 .macos；同 ffi-linux-frozen-bytes）。FFI 的 Bytes 是可写缓冲：Shared 的冻结叶子必须在调用前被拒绝。
declare function memset(buf: Bytes, value: i32, size: usize): usize from "libSystem";

function main(args: []string): void {
    const frozen = sharedGet(sharedNew(bytesFromStr("abc")));
    memset(frozen, 65, 1);
    print("unreachable");
}
