// ============================================================================
// std/csv —— RFC 4180 子集解析与序列化。纯 .tx。
//
// parse：行×列 List<List<string>>（`,` 分隔／`"` 引号域／`""` 转义引号／
// 引号域内逗号与换行——RFC 4180 主干；\r\n 与 \n 行尾同容忍）。serialize：
// 需要转义（逗号/引号/换行）自动引号化。确定性：逐字节状态机，零平台面。
//
// 2026-10-27：域内容按字节区间整段取（分隔符 `,` `"` CR LF 都是 ASCII，UTF-8 多字节序列里没有 ASCII 字节，切点恒在
// 字符边界上）。此前逐字节当码点重编（utf8Encode(字节)），含中文等非 ASCII 的域即成乱码。
// ============================================================================

import { split, join } from "./string";

// parseRows：CSV 文本 → 行列表（每行＝域列表）。
export function parseRows(text: string): List<List<string>> {
    const rows: List<List<string>> = listNew();
    let row: List<string> = listNew();
    let field: string = "";
    const data = bytesFromStr(text);
    let i: int = 0;
    // [run, i)：当前域里尚未并入 field 的字面字节。
    let run: int = 0;
    const n = len(text);
    let in_quotes = false;
    while (i < n) {
        const b = byteTryAt(text, i) catch 0;
        if (in_quotes) {
            if (b == '"') {
                field = field + byteRange(data, run, i);
                // `""`＝字面引号。
                if (i + 1 < n && (byteTryAt(text, i + 1) catch 0) == '"') {
                    field = field + "\"";
                    i = i + 2;
                    run = i;
                    continue;
                }
                in_quotes = false;
                i = i + 1;
                run = i;
                continue;
            }
            i = i + 1;
            continue;
        }
        if (b == '"' && len(field) == 0 && run == i) {
            in_quotes = true;
            i = i + 1;
            run = i;
            continue;
        }
        if (b == ',') {
            listPush(row, field + byteRange(data, run, i));
            field = "";
            i = i + 1;
            run = i;
            continue;
        }
        if (b == '\r') {
            // \r\n 行尾（容忍裸 \r）。
            listPush(row, field + byteRange(data, run, i));
            field = "";
            listPush(rows, row);
            row = listNew();
            i = i + 1;
            if (i < n && (byteTryAt(text, i) catch 0) == '\n') {
                i = i + 1;
            }
            run = i;
            continue;
        }
        if (b == '\n') {
            listPush(row, field + byteRange(data, run, i));
            field = "";
            listPush(rows, row);
            row = listNew();
            i = i + 1;
            run = i;
            continue;
        }
        i = i + 1;
    }
    field = field + byteRange(data, run, n);
    // 尾行（无行尾符）：有域内容或已有域即成行（全空尾行不产空行——RFC 惯例）。
    if (len(field) > 0 || listLen(row) > 0) {
        listPush(row, field);
        listPush(rows, row);
    }
    return rows;
}

// serializeRows：行列表 → CSV 文本（需要时引号化——RFC 4180 §2）。
export function serializeRows(rows: List<List<string>>): string {
    let out: string = "";
    let r: int = 0;
    while (r < listLen(rows)) {
        const row = listGet(rows, r);
        let c: int = 0;
        while (c < listLen(row)) {
            if (c > 0) {
                out = out + ",";
            }
            out = out + quoteField(listTryGet(row, c) catch "");
            c = c + 1;
        }
        out = out + "\r\n";
        r = r + 1;
    }
    return out;
}

function quoteField(field: string): string {
    // 需要引号：含逗号/引号/CR/LF（RFC 4180 §2.5-7）。
    let need = false;
    let i: int = 0;
    while (i < len(field)) {
        const b = byteTryAt(field, i) catch 0;
        if (b == ',' || b == '"' || b == '\r' || b == '\n') {
            need = true;
            break;
        }
        i = i + 1;
    }
    if (!need) {
        return field;
    }
    return "\"" + join(split(field, "\""), "\"\"") + "\"";
}

// data 的字节区间 [from, to) 转回字符串（两端须在字符边界上；本文件只在 ASCII 分隔符处切）。
function byteRange(data: Bytes, from: int, to: int): string {
    if (to <= from) {
        return "";
    }
    return bytesToStr(bytesSlice(data, from, to - from)) catch "";
}
