// ============================================================================
// stdlib 验证：std/fs 读写往返＋按行读取（V0.9-S1；verify ⑤ 段——依赖宿主
// 文件系统，e2e 用临时文件面；产物 taixu-fs.tmp 由 verify 收尾清理）。
// ============================================================================

import { fsWriteAll, fsReadAll, fsReadLines } from "std/fs";

function main(args: []string): int {
    // 往返：UTF-8 多字节内容写→读恒等
    fsWriteAll("taixu-fs.tmp", "第一行\nsecond line\n\n尾行无换行") catch (e) {
        print("write-failed:" + e.message);
        return 1;
    };
    const back = fsReadAll("taixu-fs.tmp") catch "read-failed";
    print("back:" + back);

    // 按行读取：行序、空行、尾行无换行
    const lines: List<string> = fsReadLines("taixu-fs.tmp") catch (e) {
        print("lines-failed:" + e.message);
        return 1;
    };
    print("count:" + toStr(listLen(lines)));
    let i: int = 0;
    while (i < listLen(lines)) {
        const line = listGet(lines, i) catch "?";
        print(toStr(i) + ":" + line);
        i = i + 1;
    }

    // 读不存在文件 → Error 通道
    const missing = fsReadAll("taixu-fs-missing.tmp") catch "missing-ok";
    print("missing:" + missing);
    return 0;
}
