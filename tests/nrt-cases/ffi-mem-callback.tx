// D3 v0.48 外部内存区：在外部函数回调里建区——qsort 排序外部内存里的 40 个 i32，比较函数从 C 交来的
// 地址建区读取（data/ffimem_cmp.tx）；主函数的区在 qsort 期间一直存活，回调里的区随回调返回弹出（比较约 200 次，远超 64）。
import { pageAlloc } from "./data/ffimem_page";
import { sortInts } from "./data/ffimem_sort";
import { compareCalls } from "./data/ffimem_cmp";

// 外部内存区只许在声明了 from 外部函数的模块里创建；只声明不调用的外部函数充当平台层（见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

declare struct I32 { v: i32 }

function main(args: []string): int {
    const p = pageAlloc();
    if (p == 0) { print("pageAlloc failed"); return 1; }
    const m = ffiMem(p, 160, true) catch (e) { print("create: " + e.message); return 1; };
    let i = 0;
    while (i < 40) {
        ffiMemSet<I32>(m, i * 4, I32 { v: ((i * 17) % 41 - 20) as i32 });
        i = i + 1;
    }
    sortInts(p, 40);
    let sorted = true;
    let prev = -1000;
    let text = "";
    i = 0;
    while (i < 40) {
        const v = ffiMemGet<I32>(m, i * 4).v as int;
        if (v < prev) { sorted = false; }
        prev = v;
        if (i < 3 || i >= 37) { text = text + " " + toStr(v); }
        i = i + 1;
    }
    print("sorted " + toStr(sorted) + " ends" + text + " many compares " + toStr(compareCalls() > 64));
    return 0;
}
