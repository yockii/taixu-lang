// Byte identity and diagnostic text are separate. The source is object-file bytes
// (or the UTF-8 bytes of a text name); the prefix is always text.
export struct BinaryName {
    source: Bytes,
    at: int,
    byteCount: int,
    prefix: string,
    hash: int,
    ok: bool,
}

export function rawNameSize(n: Ref<BinaryName>): int {
    if (!n.ok) { return 0; }
    return len(n.prefix) + n.byteCount;
}

export function rawNameByte(n: Ref<BinaryName>, i: int): int {
    if (!n.ok || i < 0 || i >= rawNameSize(n)) { return -1; }
    if (i < len(n.prefix)) { return byteAt(n.prefix, i) catch -1; }
    return bytesGet(n.source, n.at + i - len(n.prefix)) catch -1;
}

export function rawNameComputeHash(n: Ref<BinaryName>): int {
    let h = 2166136261;
    if (!n.ok) { return h; }
    const prefix = n.prefix; const source = n.source; const at = n.at;
    const count = n.byteCount; let i = 0;
    while (i < len(prefix)) { h = imul(h, 16777619) ^ (byteAt(prefix, i) catch -1); i = i + 1; }
    i = 0;
    while (i < count) { h = imul(h, 16777619) ^ (bytesGet(source, at + i) catch -1); i = i + 1; }
    return h;
}

export function rawNameTextHash(text: string): int {
    let h = 2166136261; let i = 0;
    while (i < len(text)) { h = imul(h, 16777619) ^ (byteAt(text, i) catch -1); i = i + 1; }
    return h;
}

export function rawNameEqualText(name: Ref<BinaryName>, text: string, hash: int): bool {
    if (!name.ok || name.hash != hash) { return false; }
    const prefix = name.prefix; const source = name.source; const at = name.at;
    const pl = len(prefix); const count = pl + name.byteCount;
    if (count != len(text)) { return false; }
    let i = 0;
    while (i < count) {
        let b = -1;
        if (i < pl) { b = byteAt(prefix, i) catch -1; } else { b = bytesGet(source, at + i - pl) catch -1; }
        if (b != (byteAt(text, i) catch -1)) { return false; } i = i + 1;
    }
    return true;
}

export function rawName(source: Bytes, at: int, count: int): Ref<BinaryName> {
    const n = new BinaryName { source: source, at: at, byteCount: count, prefix: "", hash: 0, ok: false };
    if (at < 0 || count < 0 || at > bytesLen(source) || count > bytesLen(source) - at) { return n; }
    n.ok = true; n.hash = rawNameComputeHash(n); return n;
}

// A name spelled as text (its UTF-8 bytes).
export function rawNameOf(text: string): Ref<BinaryName> {
    return rawName(bytesFromStr(text), 0, len(text));
}

// The empty (valid) name and the invalid name.
export function rawNameEmpty(): Ref<BinaryName> { return rawName(bytesNew(0), 0, 0); }
export function rawNameNone(): Ref<BinaryName> { return rawName(bytesNew(0), -1, 0); }

export function rawNamePrefix(n: Ref<BinaryName>, prefix: string): Ref<BinaryName> {
    const result = new BinaryName { source: n.source, at: n.at, byteCount: n.byteCount, prefix: prefix + n.prefix, hash: 0, ok: n.ok };
    if (!result.ok || result.at < 0 || result.byteCount < 0 || result.at > bytesLen(result.source) || result.byteCount > bytesLen(result.source) - result.at) { result.ok = false; return result; }
    result.hash = rawNameComputeHash(result); return result;
}

export function rawNameEqual(a: Ref<BinaryName>, b: Ref<BinaryName>): bool {
    if (!a.ok || !b.ok || a.hash != b.hash) { return false; }
    const ap = a.prefix; const bp = b.prefix; const al = len(ap); const bl = len(bp);
    const count = al + a.byteCount;
    if (count != bl + b.byteCount) { return false; }
    const ass = a.source; const bs = b.source; const ao = a.at; const bo = b.at;
    let i = 0;
    while (i < count) {
        let x = -1; let y = -1;
        if (i < al) { x = byteAt(ap, i) catch -1; } else { x = bytesGet(ass, ao + i - al) catch -1; }
        if (i < bl) { y = byteAt(bp, i) catch -1; } else { y = bytesGet(bs, bo + i - bl) catch -1; }
        if (x != y) { return false; } i = i + 1;
    }
    return true;
}

export function rawNameLess(a: Ref<BinaryName>, b: Ref<BinaryName>): bool {
    if (!a.ok || !b.ok) { return rawNameSize(a) < rawNameSize(b); }
    const ap = a.prefix; const bp = b.prefix; const al = len(ap); const bl = len(bp);
    const ac = al + a.byteCount; const bc = bl + b.byteCount;
    const ass = a.source; const bs = b.source; const ao = a.at; const bo = b.at;
    let i = 0;
    while (i < ac && i < bc) {
        let x = -1; let y = -1;
        if (i < al) { x = byteAt(ap, i) catch -1; } else { x = bytesGet(ass, ao + i - al) catch -1; }
        if (i < bl) { y = byteAt(bp, i) catch -1; } else { y = bytesGet(bs, bo + i - bl) catch -1; }
        if (x != y) { return x < y; } i = i + 1;
    }
    return ac < bc;
}

export function rawNameJoin(parts: List<string>, lo: int, hi: int): string {
    if (hi <= lo) { return ""; }
    if (hi - lo == 1) { return listGet(parts, lo) catch ""; }
    const mid = lo + (hi - lo) / 2;
    return rawNameJoin(parts, lo, mid) + rawNameJoin(parts, mid, hi);
}

export function rawNameHex(n: Ref<BinaryName>): string {
    const digits = "0123456789abcdef"; const parts: List<string> = listNew(); let i = 0;
    while (i < rawNameSize(n)) {
        const b = rawNameByte(n, i);
        listPush(parts, strSub(digits, b >>> 4, 1) + strSub(digits, b & 15, 1)); i = i + 1;
    }
    return "0x" + rawNameJoin(parts, 0, listLen(parts));
}

export function rawNameText(n: Ref<BinaryName>): string {
    if (!n.ok) { return "<invalid-name-span>"; }
    const parts: List<string> = listNew(); let i = 0;
    while (i < rawNameSize(n)) {
        const first = rawNameByte(n, i); let width = 1; let cp = first;
        if (first >= 194 && first <= 223) { width = 2; cp = first & 31; }
        else if (first >= 224 && first <= 239) { width = 3; cp = first & 15; }
        else if (first >= 240 && first <= 244) { width = 4; cp = first & 7; }
        else if (first >= 128) { return rawNameHex(n); }
        if (width > rawNameSize(n) - i) { return rawNameHex(n); }
        let j = 1;
        while (j < width) {
            const b = rawNameByte(n, i + j);
            if (b < 128 || b > 191) { return rawNameHex(n); }
            cp = (cp << 6) | (b & 63); j = j + 1;
        }
        if ((width == 2 && cp < 128) || (width == 3 && cp < 2048) || (width == 4 && cp < 65536) || cp > 1114111 || (cp >= 55296 && cp <= 57343)) { return rawNameHex(n); }
        const text = utf8Encode(cp) catch (e) { return rawNameHex(n); }; listPush(parts, text); i = i + width;
    }
    return rawNameJoin(parts, 0, listLen(parts));
}
