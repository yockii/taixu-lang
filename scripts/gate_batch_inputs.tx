// 固定 Git 快照及实际内核的身份。绝对目录不进入身份，三平台可在不同位置检出同一源码。
import { dirOf, findInPath, join, list1, plus, readBytes, runIn, shaOf, trimLine } from "./build_lib";
import { osRealPath } from "./build_os";
import { jDump, jObject, jSet, jString, Jv } from "./test_json";
import { allTargets } from "./targets";
import { hex } from "./gate_batch_model";
import { sha256Hex } from "../bootstrap/selfhost/sha256";

function git(repo: string, args: List<string>): string | Error {
    const exe = findInPath("git");
    if (len(exe) == 0) { return err("批次快照需要 git"); }
    const a: List<string> = listNew(); listPush(a, "-C"); listPush(a, repo);
    for (x in args) { listPush(a, x); }
    const r = runIn(exe, a, repo, true, false)?;
    if (r.code != 0) { return err("Git 快照检查失败：" + repo + " " + (bytesToStr(r.tail) catch "?")); }
    return bytesToStr(r.out)?;
}

function args(xs: []string): List<string> { const a: List<string> = listNew(); for (x in xs) { listPush(a, x); } return a; }

export function cleanTree(repo: string): string | Error {
    const top = osRealPath(trimLine(git(repo, args(["rev-parse", "--show-toplevel"]))?));
    git(top, args(["diff", "--exit-code", "--quiet"]))?;
    const other = git(top, args(["ls-files", "--others", "--exclude-standard"]))?;
    if (len(trimLine(other)) != 0) { return err("快照含未跟踪源码：" + top); }
    const tree = trimLine(git(top, args(["write-tree"]))?);
    if (!hex(tree, 40)) { return err("不是 Git 树身份：" + top); }
    return tree;
}

export function sourceIdentity(root: string, stdlib: string, gui: string): Ref<Jv> | Error {
    const out = jObject();
    jSet(out, "core_tree", jString(cleanTree(root)?));
    jSet(out, "stdlib_tree", jString(cleanTree(stdlib)?));
    jSet(out, "gui_tree", jString(cleanTree(gui)?));
    return out;
}

export function inputIdentity(root: string, source: Ref<Jv>): Ref<Jv> | Error {
    let kernels = "";
    for (t in allTargets()) {
        for (file in [t.kernel, t.heapKernel]) {
            const hash = shaOf(join(root, "bootstrap/nrt-kernel/" + file));
            if (!hex(hash, 64)) { return err("缺少已准备的内核：" + file); }
            kernels = kernels + file + " " + hash + "\n";
        }
    }
    jSet(source, "kernels_sha256", jString(sha256Hex(bytesFromStr(kernels))));
    const id = sha256Hex(bytesFromStr(jDump(source)));
    const out = jObject(); jSet(out, "sources", source); jSet(out, "id", jString(id)); return out;
}
