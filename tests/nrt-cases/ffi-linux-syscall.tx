// FFI 调用（D3 v0.23，Linux）：from syscall 的外部函数直接发系统调用，产物保持静态、无 libc。
// 返回值本身就是 -errno（ffiLastError 只记库函数调用）；实参覆盖整数、bool、句柄、string 与 Bytes。按名字声明（D3 v0.47），
// 各架构通用；access 不在通用号表里，改用 faccessat（x86_64 同样有）。
declare type FD;
declare function getpid(): i32 from syscall "getpid";
declare function write(fd: i32, buf: Bytes, n: usize): isize from syscall "write";
declare function read(fd: i32, buf: Bytes, n: usize): isize from syscall "read";
declare function openat(dir: i32, path: string, flags: i32, mode: u32): i32 from syscall "openat";
declare function close(fd: i32): i32 from syscall "close";
declare function fsync(fd: FD): i32 from syscall "fsync";
declare function accessAt(dir: i32, path: string, mode: i32): int from syscall "faccessat";
declare function sched_yield(): void from syscall "sched_yield";
declare function getcpu(cpu: Bytes, node: Bytes, cache: bool): i32 from syscall "getcpu";

function main(args: []string): int {
    print("pid " + toStr(getpid() > 0));
    const msg = bytesFromStr("via syscall\n");
    print("wrote " + toStr(write(1, msg, bytesLen(msg) as usize) as int));
    print("close bad " + toStr(close(-1)));
    print("fsync bad " + toStr(fsync(handleFromBits < FD > (-1))));
    const fd = openat(-100, "ffi-linux-syscall.tx", 0, 0);
    print("open " + toStr(fd >= 0));
    const buf = bytesNew(16);
    const n = read(fd, buf, 16);
    print("read " + toStr(n as int) + " " + (bytesToStr(bytesSlice(buf, 0, 6)) catch "?"));
    print("close " + toStr(close(fd)));
    print("missing " + toStr(openat(-100, "taixu-no-such-file", 0, 0)) + " " + toStr(accessAt(-100, "taixu-no-such-file", 0)));
    sched_yield();
    print("getcpu " + toStr(getcpu(bytesNew(4), bytesNew(4), false)));
    print("last " + toStr(ffiLastError()));
    return 0;
}
