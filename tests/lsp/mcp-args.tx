// mcp-args.tx —— MCP run 工具的基准语料（第 6 轮 6d-0）：打印实参个数与首个实参；首个实参为 boom 时越界陷入（写标准错误）。
export function main(args: []string): int {
    print(toStr(len(args)));
    if (len(args) > 0) {
        print("first=" + args[0]);
        if (args[0] == "boom") {
            const xs: []int = [1];
            print(toStr(xs[3]));
        }
    }
    return len(args);
}
