import { x509VerifyServerPath } from "std/x509_path";
import { p256Hex } from "std/crypto/p256_field";

function failure(chain: List<Bytes>, roots: List<Bytes>, time: int): string {
    x509VerifyServerPath(chain, "example.test", time, roots) catch (e) { return e.message; }; return "";
}

test "纯太虚路径：验签预算与输入上限不能绕过" {
    const fixture = readFile("tests/vectors/x509-budget.txt") catch panic("budget fixture"); const rows: List<string> = listNew();
    for (line in strSplit(fixture, "\n")) { if (len(line) > 0 && byteAt(line, 0) != 35) { listPush(rows, line); } }
    const roots: List<Bytes> = listNew(); const chain: List<Bytes> = listNew(); listPush(chain, p256Hex(listGet(rows, 1)));
    const encoded = strSplit(listGet(rows, 0), ","); let i = 0;
    while (i < 100) { listPush(roots, p256Hex(listGet(encoded, i))); i = i + 1; }
    const exact = failure(chain, roots, 1794456000);
    assert(len(exact) > 0 && listLen(strSplit(exact, "attempt limit")) == 1, "100 candidate checks execute without a budget error");
    listPush(roots, p256Hex(listGet(encoded, 100)));
    const exceeded = failure(chain, roots, 1794456000);
    assert(listLen(strSplit(exceeded, "attempt limit")) == 2, "101st signature attempt rejected");
    assert(len(failure(chain, listNew(), 1794456000)) > 0, "no roots is not trust");
    assert(len(failure(chain, roots, -62135596801)) > 0, "calendar lower bound");
    const tooMany: List<Bytes> = listNew(); i = 0;
    while (i < 17) { listPush(tooMany, listGet(chain, 0)); i = i + 1; }
    assert(len(failure(tooMany, roots, 1794456000)) > 0, "input chain count limit");
    const huge: List<Bytes> = listNew(); listPush(huge, bytesNew(1048577));
    assert(len(failure(huge, roots, 1794456000)) > 0, "single certificate byte limit");
}
