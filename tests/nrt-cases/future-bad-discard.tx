// D3 v0.53：把 Future 当语句丢掉是编译错误——直接的 async 调用、返回 Future 的普通函数、sleepMs、
// for 更新段都算；要等结果写 await，发后即忘写 detach。
async function job(): int {
    return 1;
}

function starter(): Future<int> {
    return job();
}

async function inner(): void {
    job();
}

function main(args: []string): int {
    job();
    starter();
    sleepMs(5);
    for (let i = 0; i < 1; job()) {
        i = i + 1;
    }
    return 0;
}
