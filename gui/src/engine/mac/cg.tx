// ============================================================================
// engine/mac/cg —— CoreGraphics 与 CoreFoundation：把呈现的像素做成 CGImage（CFDataCreate 当场拷一份像素，C 端不保留太虚的
// 缓冲指针），窗口服务器会话的有无，单调时钟。
// ============================================================================

declare function CGEventCreateScrollWheelEvent2(source: usize, units: u32, count: u32, wheel1: i32, wheel2: i32, wheel3: i32): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGEventSetFlags(event: usize, flags: u64): void from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CFDataCreate(allocator: usize, bytes: Bytes, length: isize): usize from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFRelease(cf: usize): void from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CGSessionCopyCurrentDictionary(): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGColorSpaceCreateDeviceRGB(): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGDataProviderCreateWithCFData(data: usize): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGDataProviderRelease(provider: usize): void from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGImageCreate(w: usize, h: usize, bitsPerComponent: usize, bitsPerPixel: usize, bytesPerRow: usize, space: usize, info: u32, provider: usize, decode: usize, interpolate: u8, intent: i32): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGImageRelease(img: usize): void from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGColorCreateGenericGray(gray: float, alpha: float): usize from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGColorRelease(c: usize): void from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function clock_gettime_nsec_np(clock: u32): u64 from "libSystem";

let rgb: usize = 0;

/// Test event object; not posted globally. The caller converts it to NSEvent and posts to NSApp.
export function cgWheelEvent(delta: int, lines: bool, flags: int): usize {
    let units: u32 = 0; if (lines) { units = 1; }
    const event = CGEventCreateScrollWheelEvent2(0, units, 1, delta as i32, 0, 0);
    if (event != 0) {
        CGEventSetFlags(event, flags as u64);
    }
    return event;
}
export function cgEventFree(event: usize): void { CFRelease(event); }

/// 当前登录用户的窗口服务器会话（ssh 会话里用户没有在本机登录时没有，开窗会让进程中止，须先查）。
export function cgSessionAlive(): bool {
    const d: usize = CGSessionCopyCurrentDictionary();
    if (d == 0) {
        return false;
    }
    CFRelease(d);
    return true;
}

/// BGRX（小端 32 位、无 alpha）像素 → CGImage（拷贝像素）；失败得 0。用完 cgImageFree。
export function cgImageOf(px: Bytes, pw: int, ph: int): usize {
    if (rgb == 0) {
        rgb = CGColorSpaceCreateDeviceRGB();
    }
    const data: usize = CFDataCreate(0, px, (pw * ph * 4) as isize);
    if (data == 0) {
        return 0;
    }
    const provider: usize = CGDataProviderCreateWithCFData(data);
    CFRelease(data);
    if (provider == 0) {
        return 0;
    }
    // kCGBitmapByteOrder32Little（2 << 12）| kCGImageAlphaNoneSkipFirst（6）：内存里依次是 B、G、R、X。
    const img: usize = CGImageCreate(pw as usize, ph as usize, 8, 32, (pw * 4) as usize, rgb, 0x2006, provider, 0, 0, 0);
    CGDataProviderRelease(provider);
    return img;
}

export function cgImageFree(img: usize): void {
    CGImageRelease(img);
}

/// 不透明黑（层的底色：面没盖住的部分）；用完 cgColorFree。
export function cgBlack(): usize {
    return CGColorCreateGenericGray(0.0, 1.0);
}

export function cgColorFree(c: usize): void {
    CGColorRelease(c);
}

/// 单调时钟（毫秒，CLOCK_UPTIME_RAW）。
export function nowMs(): int {
    return (clock_gettime_nsec_np(8) / 1000000) as int;
}
