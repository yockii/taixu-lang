// ============================================================================
// std/fmt —— 格式化增强（V0.38-S1；STD-06——printf 子集，Go/printf 心智）。
//
// format(fmt, args): 占位符 `{}`（自动）＋ `{:d} {:s} {:f} {:x}`（显式型）
// ＋对齐/宽度/精度 `{:>8} {:<6} {:.3}`。与模板串（语言面）互补：模板串管
// 拼接、本模块管对齐/精度/进制。
//
// 确定性红线：浮点精度走 std/strconv.formatFloatF 精确 scale（同源）；宽度
// 超出按 Go 语义不截断；占位实参经 toStr 预转换（S1 无变参——List 承载）。
// ============================================================================

import { formatFloatF, parseInt, parseFloat, formatInt } from "std/strconv";

// format：主入口。args＝预转换实参串（数组字面量直传——[d(1), s("a")]；
// d()/s()/f()/x() 便捷包装构造）。
export function format(fmt: string, args: []string): string {
    let out: string = "";
    let ai: int = 0;
    let i: int = 0;
    const n = len(fmt);
    while (i < n) {
        const c = byteAt(fmt, i) catch 0;
        if (c != 123) {
            // `}}` 转义字面 `}`（Rust 语义；孤 `}` 恒字面——防御面）。
            if (c == '}' && i + 1 < n && (byteAt(fmt, i + 1) catch 0) == '}') {
                out = out + "}";
                i = i + 2;
                continue;
            }
            out = out + sliceCp(fmt, i);
            i = i + 1;
            continue;
        }
        // `{{` 转义字面 `{`。
        if (i + 1 < n && (byteAt(fmt, i + 1) catch 0) == '{') {
            out = out + "{";
            i = i + 2;
            continue;
        }
        // 找配对 `}`（未闭合即字面 `{`——防御面）。
        let j = i + 1;
        while (j < n && (byteAt(fmt, j) catch 0) != '}') {
            j = j + 1;
        }
        if (j >= n) {
            out = out + "{";
            i = i + 1;
            continue;
        }
        const spec = midStr(fmt, i + 1, j);
        let arg: string = "";
        if (ai < len(args)) {
            arg = args[ai];
        }
        ai = ai + 1;
        out = out + applySpec(spec, arg);
        i = j + 1;
    }
    return out;
}

// applySpec：`[<|>][width][.prec][d|s|f|x]` 子集——`>8`（右对齐缺省）、
// `<6`（左对齐）、`.3`（浮点精度 3）、`d/s/f/x`（十进制/串/浮点/十六进制）。
function applySpec(spec: string, arg: string): string {
    if (len(spec) == 0) {
        return arg;
    }
    let body = spec;
    // 前导 `:` 剥离（`{:>4}` 形——spec 含冒号）。
    if ((byteAt(body, 0) catch 0) == ':') {
        body = midStr(body, 1, len(body));
    }
    let ty: int = 0; // 0=auto 100=d 115=s 102=f 120=x
    const last = byteAt(spec, len(spec) - 1) catch 0;
    if (last == 100 || last == 115 || last == 102 || last == 120) {
        ty = last;
        body = midStr(spec, 0, len(spec) - 1);
    }
    // 对齐旗标。
    let align_left = false;
    if (len(body) > 0 && (byteAt(body, 0) catch 0) == '<') {
        align_left = true;
        body = midStr(body, 1, len(body));
    } else if (len(body) > 0 && (byteAt(body, 0) catch 0) == '>') {
        body = midStr(body, 1, len(body));
    }
    // 精度 `.N`（浮点小数位）。
    let prec = -1;
    const dot = strIndexOfByte(body, 46);
    if (dot >= 0) {
        prec = parseInt(midStr(body, dot + 1, len(body))) catch -1;
        body = midStr(body, 0, dot);
    }
    // 宽度。
    let width: int = 0;
    if (len(body) > 0) {
        width = parseInt(body) catch 0;
    }
    // 数值化（按型别；auto 带精度＝浮点面）。
    let val = arg;
    if (ty == 120) {
        // 透传——实参经 x() 构造（已十六进制；双重转换面消除）。
        val = arg;
    } else if (ty == 102 || prec >= 0) {
        let digits = 6;
        if (prec >= 0) {
            digits = prec;
        }
        val = formatFloatF(parseFloat(arg) catch 0.0, digits);
    }
    if (width > 0 && len(val) < width) {
        const pad = spaces(width - len(val));
        if (align_left) {
            return val + pad;
        }
        return pad + val;
    }
    return val;
}

// —— 便捷包装（占位实参构造；S1 无变参——调用方收集 List 后传 format）——

// d：整数 → 实参串。
export function d(v: int): string {
    return toStr(v);
}

// s：串透传（语义显式位）。
export function s(v: string): string {
    return v;
}

// f：浮点 → 定点串（prec 位小数）。
export function f(v: float, prec: int): string {
    return formatFloatF(v, prec);
}

// x：整数 → 十六进制实参串（小写；负号前缀）。
export function x(v: int): string {
    return formatInt(v, 16) catch "0";
}

// spaces：n 个空格（n<0 空串）。
export function spaces(n: int): string {
    let out: string = "";
    let i: int = 0;
    while (i < n) {
        out = out + " ";
        i = i + 1;
    }
    return out;
}

// —— 内部：码点定位（本地副本——跨模块私有面不可见先例）——

function cpLenAt(s: string, i: int): int {
    const b = byteAt(s, i) catch 0;
    if (b < 128) {
        return 1;
    }
    if (b >= 192 && b < 224) {
        return 2;
    }
    if (b >= 224 && b < 240) {
        return 3;
    }
    if (b >= 240 && b < 248) {
        return 4;
    }
    return 1;
}

function sliceCp(s: string, i: int): string {
    let out: string = "";
    out = out + (utf8Encode(cpAt(s, i)) catch "");
    return out;
}

function cpAt(s: string, i: int): int {
    const b = byteAt(s, i) catch 0;
    if (b < 128) {
        return b;
    }
    let n: int = 2;
    let cp: int = b - 192;
    if (b >= 240) {
        n = 4;
        cp = b - 240;
    } else if (b >= 224) {
        n = 3;
        cp = b - 224;
    }
    let k: int = 1;
    while (k < n) {
        const bx = byteAt(s, i + k) catch 128;
        cp = cp * 64 + (bx % 64);
        k = k + 1;
    }
    return cp;
}

function midStr(s: string, from: int, to: int): string {
    let out: string = "";
    let i = from;
    while (i < to && i < len(s)) {
        out = out + (utf8Encode(cpAt(s, i)) catch "");
        i = i + cpLenAt(s, i);
    }
    return out;
}

function strIndexOfByte(s: string, b: int): int {
    let i: int = 0;
    while (i < len(s)) {
        if ((byteAt(s, i) catch -1) == b) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}
