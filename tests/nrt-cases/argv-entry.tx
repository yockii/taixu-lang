// 命令行参数（D3 v0.41）：main(args) 逐项得到命令行原文（空参数、空格、引号、反斜杠、多字节都原样），参数不是合法
// UTF-8（Windows 为不成对的代理）的进程在入口拒绝启动：stderr 含 "argv acquisition failed: InvalidUnicode"，退出码 64。
// 本程序带 --child 起自己检验前者；后者经 /bin/sh 的 printf（类 Unix）或 PowerShell 的 [char]（Windows）造出非法参数。

function quoted(s: string, q: string): bool {
    return strIndexOf(s, q) >= 0;
}

function shellCheck(self: string): int {
    // 0xFF、截断的三字节序列、过长编码、UTF-16 代理的 UTF-8 形（CESU）：都不是合法 UTF-8。
    const script = "p=$1; for b in '\\377' '\\342\\202' '\\300\\200' '\\355\\240\\200'; do "
    + "out=$(\"$p\" \"$(printf \"$b\")\" 2>&1); code=$?; "
    + "case \"$out\" in *\"argv acquisition failed: InvalidUnicode\"*) ;; *) echo \"message $b: $out\"; exit 1;; esac; "
    + "[ \"$code\" -eq 64 ] || { echo \"exit $b: $code\"; exit 1; }; done; exit 0";
    const xs: List<string> = listNew();
    listPush(xs, "-c");
    listPush(xs, script);
    listPush(xs, "sh");
    listPush(xs, self);
    return runProcess("/bin/sh", xs, "") catch -1;
}

function powershellCheck(self: string): int {
    if (quoted(self, "'")) {
        print("程序路径含单引号，PowerShell 脚本无法原样嵌入");
        return -1;
    }
    const root = getEnv("SystemRoot") ?? "C:\\Windows";
    const script = "$p = '" + self + "'; foreach ($c in @(0xD800, 0xDC00)) { "
    + "$o = & $p ([string][char]$c) 2>&1 | Out-String; "
    + "if ($LASTEXITCODE -ne 64 -or $o -notlike '*argv acquisition failed: InvalidUnicode*') { exit 1 } }; exit 0";
    const xs: List<string> = listNew();
    listPush(xs, "-NoProfile");
    listPush(xs, "-NonInteractive");
    listPush(xs, "-Command");
    listPush(xs, script);
    return runProcess(root + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", xs, "") catch -1;
}

export function main(args: []string): int {
    // 只有不带参数时才起子进程：入口若没有拒绝非法参数，带它起的进程在这里返回 2，不会再起自己。
    if (len(args) > 0) {
        if (args[0] != "--child") {
            return 2;
        }
        let i: int = 1;
        while (i < len(args)) {
            print("[" + args[i] + "]");
            i = i + 1;
        }
        return 0;
    }
    const self = selfExePath();
    const xs: List<string> = listNew();
    listPush(xs, "--child");
    listPush(xs, "");
    listPush(xs, "a b");
    listPush(xs, "太虚 🙂");
    listPush(xs, "x\"y");
    listPush(xs, "back\\");
    listPush(xs, "\\\"q");
    listPush(xs, "tab\there");
    listPush(xs, "");
    print("child " + toStr(runProcess(self, xs, "") catch -1));
    let code: int = 0;
    if (hostTarget() == "windows") {
        code = powershellCheck(self);
    } else {
        code = shellCheck(self);
    }
    print("invalid rejected " + toStr(code));
    return 0;
}
