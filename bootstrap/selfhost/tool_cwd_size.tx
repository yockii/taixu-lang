// 工具链的 currentDir 与 fileSize 内建例程（从 tool_rt.tx 拆出，行为不变；调用约定同 tool_rt）。
import { StructuredBuffer } from "./assemble";
import { L, I } from "./rtfn_base";
import { rtBegin, rtSet, rtOp, rtShift, rtLoad, rtStore, rtAddrOf, rtLabel, rtJump, rtIf, rtCall0, rtCall1, rtCall2, rtCall3, rtCall4, rtSyscall, rtRetVoid } from "./rtfn";
import { callWinImport } from "./ffi_callbacks";
import { TAG_INT, TAG_ERR, TAG_STR, toolCheck, xs0, xs1, xs2, xs4, xs7, toolTrap, toolArity, toolArgSpan } from "./tool_base";
import { tUnix, tMacos } from "./target";
import { uxSys, uxMac, uxErrno, uxConst, uxAtFdcwd, uxStatMode } from "./unix_sys";

const ARITY: string = "内建函数实参数目错误";

// currentDir(): string | Error（6c-4a）：本进程当前工作目录的绝对路径。
// - Windows：GetCurrentDirectoryW 先问长度（含终结符）再取；两次调用之间目录变长就按新长度重来，至多三次。
//   UTF-16 经 __tx_nrt_wide_to_str 转成 UTF-8（孤立代理换成 U+FFFD）。
// - Linux：getcwd（系统调用 79），4096 字节即内核的上限，返回值含终结符；经 __tx_ffi_cstr_to_str 成串，不合法的
//   UTF-8 字节换成 U+FFFD（string 恒为合法 UTF-8）。当前目录已不在根之下时内核写成 "(unreachable)…"，同 glibc
//   当作 ENOENT。
// 失败得 Error "{状态}: ."，文案同 runProcess（__tx_store_file_err）：ENOENT／找不到为 no such file，EACCES／拒绝访问为
// access denied，ENOMEM／内存不足为 out of memory，其余 io error。
export function emitCurrentDir(b: Ref<StructuredBuffer>, t: int): void {
    const f = rtBegin(b, "__tx_tool_current_dir", "win fn pc a bi nargs", "s n r buf q st k gp ef", 5, "bootstrap/selfhost/tool_rt.tx");
    toolArity(f, 0);
    if (tUnix(t)) {
        rtCall2(f, "buf", "__tx_native_mem_alloc", I(4096), I(1));
        rtIf(f, L("buf"), "eq", I(0), "oom");
        // macOS 的 getcwd 是 libc 函数，成功返回 buf（RET_PTR：失败为 −errno），PATH_MAX 1024 之内。
        if (tMacos(t)) { uxMac(f, "r", "getcwd", xs2(L("buf"), I(4096))); } else { rtSyscall(f, "r", 79, xs2(L("buf"), I(4096))); }
        rtIf(f, L("r"), "le", I(0), "errno");
        rtLoad(f, "s", L("buf"), 0, 1);
        rtIf(f, L("s"), "eq", I(47), "found");
        rtSet(f, "r", I(-2));
        rtLabel(f, "errno");
        rtCall1(f, "", "__tx_native_mem_free", L("buf"));
        rtSet(f, "st", I(5));
        rtIf(f, L("r"), "ne", I(-2), "e13");
        rtSet(f, "st", I(3));
        rtLabel(f, "e13");
        rtIf(f, L("r"), "ne", I(-13), "e12");
        rtSet(f, "st", I(4));
        rtLabel(f, "e12");
        rtIf(f, L("r"), "ne", I(-12), "error");
        rtSet(f, "st", I(2));
        rtJump(f, "error");
        rtLabel(f, "found");
        rtCall1(f, "q", "__tx_ffi_cstr_to_str", L("buf"));
        rtCall1(f, "", "__tx_native_mem_free", L("buf"));
    } else {
        rtSet(f, "k", I(0));
        callWinImport(f, "n", "GetCurrentDirectoryW", xs2(I(0), I(0)));
        rtOp(f, "n", L("n"), "and", I(4294967295));
        rtIf(f, L("n"), "eq", I(0), "winerr");
        rtLabel(f, "again");
        rtOp(f, "s", L("n"), "add", L("n"));
        rtCall2(f, "buf", "__tx_native_mem_alloc", L("s"), I(2));
        rtIf(f, L("buf"), "eq", I(0), "oom");
        callWinImport(f, "r", "GetCurrentDirectoryW", xs2(L("n"), L("buf")));
        rtOp(f, "r", L("r"), "and", I(4294967295));
        rtIf(f, L("r"), "eq", I(0), "winerrfree");
        rtIf(f, L("r"), "lt", L("n"), "wide");
        rtCall1(f, "", "__tx_native_mem_free", L("buf"));
        rtSet(f, "n", L("r"));
        rtOp(f, "k", L("k"), "add", I(1));
        rtIf(f, L("k"), "lt", I(3), "again");
        rtSet(f, "st", I(5));
        rtJump(f, "error");
        rtLabel(f, "winerrfree");
        callWinImport(f, "r", "GetLastError", xs0());
        rtCall1(f, "", "__tx_native_mem_free", L("buf"));
        rtJump(f, "winmap");
        rtLabel(f, "winerr");
        callWinImport(f, "r", "GetLastError", xs0());
        rtLabel(f, "winmap");
        rtOp(f, "r", L("r"), "and", I(4294967295));
        rtSet(f, "st", I(3));
        rtIf(f, L("r"), "eq", I(2), "error");
        rtIf(f, L("r"), "eq", I(3), "error");
        rtSet(f, "st", I(4));
        rtIf(f, L("r"), "eq", I(5), "error");
        rtSet(f, "st", I(2));
        rtIf(f, L("r"), "eq", I(8), "error");
        rtIf(f, L("r"), "eq", I(14), "error");
        rtSet(f, "st", I(5));
        rtJump(f, "error");
        rtLabel(f, "wide");
        rtCall2(f, "q", "__tx_nrt_wide_to_str", L("buf"), L("r"));
        rtCall1(f, "", "__tx_native_mem_free", L("buf"));
    }
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_STR), L("q"));
    rtRetVoid(f);
    // 失败：串 "." 先放进结果槽，造好 Error 后再写结果槽，旧值（这个串）随之释放。
    rtLabel(f, "error");
    rtCall2(f, "s", "__tx_native_mem_alloc", I(1), I(1));
    rtIf(f, L("s"), "eq", I(0), "oom");
    rtStore(f, L("s"), 0, I(46), 1);
    rtCall3(f, "s", "__tx_store_new_str_take", L("s"), I(1), I(0));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_STR), L("s"));
    rtCall4(f, "q", "__tx_store_file_err", L("st"), L("s"), L("fn"), L("pc"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_ERR), L("q"));
    rtRetVoid(f);
    rtLabel(f, "oom");
    rtCall0(f, "", "__tx_native_object_oom_v1");
    rtRetVoid(f);
    toolTrap(b, f, "arity", 4010, ARITY);
    rtRetVoid(f);
    toolCheck(f);
}

// fileSize(path): int | Error（第 6 轮 6d-1a，LSP 与 MCP 实施设计 §三-4）：普通文件（跟随符号链接）的字节数，只取元数据、
// 不读内容。对照 Go os.Stat、Rust fs::metadata 的取法：
// - Linux：newfstatat(AT_FDCWD, path, &st, 0)，st_mode 在偏移 24、st_size 在 48；
// - Windows：CreateFileW（访问权限 0，不需要读权限；FILE_FLAG_BACKUP_SEMANTICS 以便目录也能打开），GetFileType 不是
//   磁盘文件（NUL 等设备、管道）即止，再 GetFileInformationByHandle：dwFileAttributes 在偏移 0、nFileSizeHigh 在 32、
//   nFileSizeLow 在 36。
// 不是普通文件（目录、设备等）或路径含 NUL 得 Error "invalid argument: 路径"；其余失败的文案同 readFile
// （__tx_store_file_err：找不到为 no such file，拒绝访问为 access denied，内存不足为 out of memory，其余 io error）。
// 局部槽 st0..st17 相邻，放 Linux 的 struct stat（x86_64，144 字节）。
export function emitFileSize(b: Ref<StructuredBuffer>, t: int): void {
    const slots = " st0 st1 st2 st3 st4 st5 st6 st7 st8 st9 st10 st11 st12 st13 st14 st15 st16 st17";
    const f = rtBegin(b, "__tx_tool_file_size", "win fn pc a bi nargs", "s t o p n x k c w r st q h at hi lo gp ef ip i0 i1 i2 i3 i4 i5 i6" + slots, 7, "bootstrap/selfhost/tool_rt.tx");
    toolArity(f, 1);
    toolArgSpan(f, 0, TAG_STR, "o", "p", "n", "type");
    rtSet(f, "x", L("t"));
    // 含 NUL 的路径不交给系统调用（会被截断成别的文件）。
    rtSet(f, "k", I(0));
    rtLabel(f, "nul");
    rtIf(f, L("k"), "ge", L("n"), "clean");
    rtOp(f, "c", L("p"), "add", L("k"));
    rtLoad(f, "c", L("c"), 0, 1);
    rtSet(f, "st", I(1));
    rtIf(f, L("c"), "eq", I(0), "error");
    rtOp(f, "k", L("k"), "add", I(1));
    rtJump(f, "nul");
    rtLabel(f, "clean");
    if (tUnix(t)) {
        rtCall2(f, "w", "__tx_tool_cstr", L("p"), L("n"));
        rtIf(f, L("w"), "eq", I(0), "oom");
        rtAddrOf(f, "at", "st0");
        uxSys(f, t, "r", 262, xs4(I(uxAtFdcwd(t)), L("w"), L("at"), I(0)));
        rtCall1(f, "", "__tx_native_mem_free", L("w"));
        rtIf(f, L("r"), "ne", I(0), "errno");
        uxStatMode(f, t, "c", L("at"));
        rtOp(f, "c", L("c"), "and", I(61440));
        rtSet(f, "st", I(1));
        rtIf(f, L("c"), "ne", I(32768), "error");
        rtLoad(f, "q", L("at"), uxConst(t, "ST_SIZE"), 8);
        rtJump(f, "done");
        // errno → 状态（同 file_linux.tx 的映射）：ENOENT、ENOTDIR 找不到；EACCES、EPERM 拒绝访问；ENOMEM 内存不足；
        // EINVAL、ENAMETOOLONG、ELOOP 实参无效；其余 io error。
        rtLabel(f, "errno");
        rtSet(f, "st", I(3));
        rtIf(f, L("r"), "eq", I(-2), "error");
        rtIf(f, L("r"), "eq", I(-20), "error");
        rtSet(f, "st", I(4));
        rtIf(f, L("r"), "eq", I(-13), "error");
        rtIf(f, L("r"), "eq", I(-1), "error");
        rtSet(f, "st", I(2));
        rtIf(f, L("r"), "eq", I(-12), "error");
        rtSet(f, "st", I(1));
        rtIf(f, L("r"), "eq", I(-22), "error");
        rtIf(f, L("r"), "eq", I(0 - uxErrno(t, "ENAMETOOLONG")), "error");
        rtIf(f, L("r"), "eq", I(0 - uxErrno(t, "ELOOP")), "error");
        rtSet(f, "st", I(5));
        rtJump(f, "error");
    } else {
        rtCall2(f, "w", "__tx_file_wpath", L("p"), L("n"));
        rtIf(f, L("w"), "eq", I(0), "oom");
        // CreateFileW(path, 0, READ|WRITE|DELETE 共享, NULL, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL)。
        callWinImport(f, "h", "CreateFileW", xs7(L("w"), I(0), I(7), I(0), I(3), I(33554432), I(0)));
        rtCall1(f, "", "__tx_native_mem_free", L("w"));
        rtIf(f, L("h"), "eq", I(-1), "winerr");
        callWinImport(f, "r", "GetFileType", xs1(L("h")));
        rtOp(f, "r", L("r"), "and", I(4294967295));
        rtIf(f, L("r"), "eq", I(1), "disk");
        callWinImport(f, "", "CloseHandle", xs1(L("h")));
        rtSet(f, "st", I(1));
        rtJump(f, "error");
        rtLabel(f, "disk");
        rtAddrOf(f, "ip", "i0");
        callWinImport(f, "r", "GetFileInformationByHandle", xs2(L("h"), L("ip")));
        rtOp(f, "r", L("r"), "and", I(4294967295));
        rtIf(f, L("r"), "ne", I(0), "got");
        callWinImport(f, "r", "GetLastError", xs0());
        callWinImport(f, "", "CloseHandle", xs1(L("h")));
        rtJump(f, "winmap");
        rtLabel(f, "got");
        callWinImport(f, "", "CloseHandle", xs1(L("h")));
        rtLoad(f, "c", L("ip"), 0, 4);
        rtOp(f, "c", L("c"), "and", I(16));
        rtSet(f, "st", I(1));
        rtIf(f, L("c"), "ne", I(0), "error");
        rtLoad(f, "hi", L("ip"), 32, 4);
        rtLoad(f, "lo", L("ip"), 36, 4);
        rtShift(f, "q", L("hi"), "shl", 32);
        rtOp(f, "q", L("q"), "or", L("lo"));
        rtJump(f, "done");
        // GetLastError → 状态（同 currentDir）：2、3 找不到；5 拒绝访问；8、14 内存不足；其余 io error。
        rtLabel(f, "winerr");
        callWinImport(f, "r", "GetLastError", xs0());
        rtLabel(f, "winmap");
        rtOp(f, "r", L("r"), "and", I(4294967295));
        rtSet(f, "st", I(3));
        rtIf(f, L("r"), "eq", I(2), "error");
        rtIf(f, L("r"), "eq", I(3), "error");
        rtSet(f, "st", I(4));
        rtIf(f, L("r"), "eq", I(5), "error");
        rtSet(f, "st", I(2));
        rtIf(f, L("r"), "eq", I(8), "error");
        rtIf(f, L("r"), "eq", I(14), "error");
        rtSet(f, "st", I(5));
        rtJump(f, "error");
    }
    rtLabel(f, "done");
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_INT), L("q"));
    rtRetVoid(f);
    // 失败：Error 的文案为 "{状态}: 路径"（同 readFile），路径取实参串。
    rtLabel(f, "error");
    rtCall4(f, "q", "__tx_store_file_err", L("st"), L("x"), L("fn"), L("pc"));
    rtCall4(f, "", "__tx_nrt_set_new", L("win"), L("a"), I(TAG_ERR), L("q"));
    rtRetVoid(f);
    rtLabel(f, "oom");
    rtCall0(f, "", "__tx_native_object_oom_v1");
    rtRetVoid(f);
    toolTrap(b, f, "arity", 4010, ARITY);
    rtRetVoid(f);
    toolTrap(b, f, "type", 4010, "fileSize 的实参不是 string");
    rtRetVoid(f);
    toolCheck(f);
}
