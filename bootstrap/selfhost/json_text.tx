// JSON 字符串字面量（同 Zig CLI 的 writeJsonString：转义 " \ 与控制字符，其余码点原样）。
// 原生 CLI 的 `--format=json`（cli_json.tx）与 fmt（fmt.tx）共用；fmt.tx 仍经 Zig VM 运行
// （fmtmirror-probe），本件须留在 v0.17 子集内。

function cpCountJ(s: string): int {
    let pos: int = 0;
    let count: int = 0;
    while (pos < len(s)) {
        const c: int = byteAt(s, pos) catch 0;
        if (c >= 240) {
            pos = pos + 4;
        } else if (c >= 224) {
            pos = pos + 3;
        } else if (c >= 192) {
            pos = pos + 2;
        } else {
            pos = pos + 1;
        }
        count = count + 1;
    }
    return count;
}

export function jsonQuote(s: string): string {
    const hex: string = "0123456789abcdef";
    let out: string = "\"";
    const n: int = cpCountJ(s);
    let i: int = 0;
    while (i < n) {
        const ch: string = strSub(s, i, 1);
        const c: int = byteAt(ch, 0) catch 0;
        if (c == 34) {
            out = out + "\\\"";
        } else if (c == 92) {
            out = out + "\\\\";
        } else if (c == 10) {
            out = out + "\\n";
        } else if (c == 13) {
            out = out + "\\r";
        } else if (c == 9) {
            out = out + "\\t";
        } else if (c < 32) {
            out = out + "\\u00" + strSub(hex, c / 16, 1) + strSub(hex, c % 16, 1);
        } else {
            out = out + ch;
        }
        i = i + 1;
    }
    return out + "\"";
}
