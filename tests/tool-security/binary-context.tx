import { drvCompile, drvDiagOut, drvBytesOut } from "../../bootstrap/selfhost/driver";
import { serviceConfigure, serviceError } from "../../bootstrap/selfhost/service_files";
import { cgSnapshotCurrent } from "../../bootstrap/selfhost/codegen";
import { programContextValid, serializeProgramContext } from "../../bootstrap/selfhost/bytecode";
function main(args: []string): int {
    if (len(args) != 2) { return 64; }
    if (drvCompile(args[1], 0) != 0) { print(drvDiagOut()); return 1; }
    const plain = drvBytesOut();
    const context = cgSnapshotCurrent();
    assert(programContextValid(context), "current context shape");
    context.version = 1;
    assert(!programContextValid(context) && (serializeProgramContext(context)).error == "BadProgramContext", "old internal shape rejected");
    context.version = 2;
    const oldRaw = context.cgRawStrings;
    const extra: List< Bytes> = listNew(); let i = 0;
    while (i <= listLen(context.cgStrings)) { listPush(extra, bytesNew(0)); i = i + 1; }
    context.cgRawStrings = extra;
    assert(!programContextValid(context), "oversized raw sidecar rejected");
    const first = listGet(context.cgStrings, 0) catch "";
    listSet(context.cgStrings, 0, "ambiguous"); listSet(extra, 0, bytesFromStr("raw"));
    listRemoveAt(extra, listLen(extra) - 1);
    assert(!programContextValid(context), "raw payload requires empty text placeholder");
    listSet(context.cgStrings, 0, first); context.cgRawStrings = oldRaw;
    const restored = serializeProgramContext(context); const encoded = bytesNew(0);
    for (b in restored.bytes) { bytesPush(encoded, b); }
    assert(programContextValid(context) && len(restored.error) == 0 && bytesEqual(encoded, plain), "shape failure recovery");
    const roots: List< string> = listNew(); listPush(roots, args[0]); const libs: List< string> = listNew();
    if (!serviceConfigure(roots, libs, libs)) { print(serviceError()); return 2; }
    if (drvCompile(args[1], 0) != 0) { print(drvDiagOut()); return 3; }
    assert(bytesEqual(plain, drvBytesOut()), "raw constants must preserve exact internal encoding");
    if (drvCompile(args[0] + "/../outside/no.tx", 0) == 0) { return 4; }
    if (drvCompile(args[1], 0) != 0) { print(drvDiagOut()); return 5; }
    assert(bytesEqual(plain, drvBytesOut()), "failed compile recovery");
    const retained = serializeProgramContext(context); const retainedBytes = bytesNew(0);
    for (b in retained.bytes) { bytesPush(retainedBytes, b); }
    assert(programContextValid(context) && len(retained.error) == 0 && bytesEqual(retainedBytes, plain), "retained binary context survives later compilations");
    print("PASS_BINARY_CONTEXT_EXACT_BYTES_RECOVERY"); return 0;
}
