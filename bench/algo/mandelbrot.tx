// bench/algo/mandelbrot —— Mandelbrot 集迭代（300×300，上限 255 次）。
// 校验和＝全部像素迭代次数和（浮点确定性：同平台逐字节一致）。
export function main(args: []string): int {
    const size: int = 300;
    let total: int = 0;
    let py: int = 0;
    while (py < size) {
        const ci: float = (py as float) * 2.5 / (size as float) - 1.25;
        let px: int = 0;
        while (px < size) {
            const cr: float = (px as float) * 3.0 / (size as float) - 2.0;
            let zr: float = 0.0;
            let zi: float = 0.0;
            let it: int = 0;
            while (it < 255) {
                const t: float = zr * zr - zi * zi + cr;
                zi = 2.0 * zr * zi + ci;
                zr = t;
                if (zr * zr + zi * zi > 4.0) {
                    break;
                }
                it = it + 1;
            }
            total = total + it;
            px = px + 1;
        }
        py = py + 1;
    }
    print(toStr(total));
    return 0;
}
