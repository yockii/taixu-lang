// 线程的可发送判定（线程设计 §四-8、§十八）：捕获与结果里绑定在本线程上的成分（Weak、Future、Gen、Thread、
// 平台句柄）报 3035 并指出成分与路径——直接出现，或经 struct 字段、enum 变体字段、List 与数组元素、Ref、可选
// 间接含有。函数值、接口值静态算可发送，它们的捕获与具体类型在发送时核对（见 thread-send-trap-*）。
declare type Win;

struct Target {
    v: int,
}

struct Watcher {
    label: string,
    w: Weak< Target>,
}

struct Holder {
    title: string,
    win: Win,
}

enum Msg {
    Text(s: string),
    Watch(w: Weak< Target>),
}

async function later(): int {
    return 1;
}

function work(): int {
    return 1;
}

function main(args: []string): void {
    const r: Ref< Target> = new Target { v: 1 };
    const w: Weak< Target> = weak(r);
    const wa = Watcher { label: "a", w: weak(r) };
    const h = Holder { title: "x", win: handleFromBits < Win > (0) };
    const ms: List< Msg> = listNew();
    const c1 = threadSpawn((): int => 1 + len(wa.label));
    const c2 = threadSpawn((): bool => w == w);
    const c3 = threadSpawn((): int => len(h.title));
    const c4 = threadSpawn((): int => listLen(ms));
    const r1 = threadSpawn((): Future < int > => later());
    const r2 = threadSpawn((): Thread < int > => threadSpawn(work));
    const r3 = threadSpawn((): Ref< Watcher> => new Watcher { label: "b", w: weak(new Target { v: 3 }) });
}
