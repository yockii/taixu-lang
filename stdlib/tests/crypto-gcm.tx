import { aes128EncryptBlock } from "std/crypto/aes";
import { aes128GcmSeal, aes128GcmOpen } from "std/crypto/gcm";
import { constantTimeEqual } from "std/crypto/subtle";

function nibble(c: int): int {
    if (c >= 48 && c <= 57) { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 87; }
    panic("fixture hex digit"); return 0;
}

function hex(text: string): Bytes {
    if (text == "-") { return bytesNew(0); }
    assert(len(text) % 2 == 0, "fixture hex length");
    const out = bytesNew(len(text) / 2);
    let i = 0;
    while (i < bytesLen(out)) {
        bytesSet(out, i, nibble(byteAt(text, i * 2)) * 16 + nibble(byteAt(text, i * 2 + 1))); i = i + 1;
    }
    return out;
}

function check(key: Bytes, nonce: Bytes, aad: Bytes, plain: Bytes, expected: Bytes): void {
    const k = bytesSlice(key, 0, bytesLen(key)); const n = bytesSlice(nonce, 0, bytesLen(nonce));
    const a = bytesSlice(aad, 0, bytesLen(aad)); const p = bytesSlice(plain, 0, bytesLen(plain));
    const sealed = aes128GcmSeal(key, nonce, aad, plain) catch panic("seal");
    assert(constantTimeEqual(sealed, expected), "known sealed bytes");
    assert(constantTimeEqual(aes128GcmOpen(key, nonce, aad, sealed) catch panic("open"), plain), "known plaintext");
    assert(constantTimeEqual(key, k) && constantTimeEqual(nonce, n) && constantTimeEqual(aad, a) && constantTimeEqual(plain, p)
        && constantTimeEqual(sealed, expected), "caller inputs unchanged");
}

test "AES-128：FIPS 197 单块与 NIST GCM 已知答案" {
    const encrypted = aes128EncryptBlock(hex("000102030405060708090a0b0c0d0e0f"), hex("00112233445566778899aabbccddeeff")) catch panic("AES block");
    assert(constantTimeEqual(encrypted, hex("69c4e0d86a7b0430d8cdb78070b4c55a")), "FIPS 197");
    check(bytesNew(16), bytesNew(12), bytesNew(0), bytesNew(0), hex("58e2fccefa7e3061367f1d57a4e7455a"));
    check(bytesNew(16), bytesNew(12), bytesNew(0), bytesNew(16), hex("0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf"));
    const key = hex("feffe9928665731c6d6a8f9467308308"); const nonce = hex("cafebabefacedbaddecaf888");
    check(key, nonce, bytesNew(0), bytesNew(0), hex("3247184b3c4f69a44dbcd22887bbb418"));
    check(key, nonce, bytesNew(0),
        hex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b391aafd255"),
        hex("42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e091473f59854d5c2af327cd64a62cf35abd2ba6fab4"));
    check(key, nonce,
        hex("3ad77bb40d7a3660a89ecaf32466ef97f5d3d58503b9699de785895a96fdbaaf43b1cd7f598ece23881b00e3ed0306887b0c785e27e8ad3f8223207104725dd4"),
        bytesNew(0), hex("5f91d77123ef5eb9997913849b8dc1e9"));
}

function rejected(key: Bytes, nonce: Bytes, aad: Bytes, sealed: Bytes): bool {
    aes128GcmOpen(key, nonce, aad, sealed) catch (e) { return true; }; return false;
}

function badKeyFails(): bool {
    aes128GcmSeal(bytesNew(32), bytesNew(12), bytesNew(0), bytesNew(0)) catch (e) { return true; }; return false;
}

function badBlockFails(): bool {
    aes128EncryptBlock(bytesNew(16), bytesNew(15)) catch (e) { return true; }; return false;
}

test "GCM：NIST CAVP 与独立实现的 164 项固定向量" {
    const text = readFile("tests/vectors/crypto-gcm.txt") catch panic("GCM vector fixture");
    let good = 0; let bad = 0; let blocks = 0;
    for (line in strSplit(text, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const parts = strSplit(line, " ");
        const kind = listGet(parts, 0); const key = hex(listGet(parts, 1));
        if (kind == "aes") {
            const got = aes128EncryptBlock(key, hex(listGet(parts, 2))) catch panic("AES cross vector");
            assert(constantTimeEqual(got, hex(listGet(parts, 3))), "independent AES " + toStr(blocks)); blocks = blocks + 1;
        } else {
            const nonce = hex(listGet(parts, 2)); const aad = hex(listGet(parts, 3));
            if (kind == "bad") { assert(rejected(key, nonce, aad, hex(listGet(parts, 4))), "CAVP rejection " + toStr(bad)); bad = bad + 1; }
            else {
                assert(kind == "good", "vector type");
                check(key, nonce, aad, hex(listGet(parts, 4)), hex(listGet(parts, 5))); good = good + 1;
            }
        }
    }
    assert(good == 110 && bad == 22 && blocks == 32, "complete vector counts");
}

test "GCM：各位篡改、截断与参数拒绝" {
    const key = bytesNew(16); const nonce = bytesNew(12); const aad = bytesFromStr("metadata"); const plain = bytesFromStr("secret plaintext");
    const sealed = aes128GcmSeal(key, nonce, aad, plain) catch panic("seal");
    let i = 0;
    while (i < bytesLen(sealed)) {
        let bit = 0;
        while (bit < 8) {
            const changed = bytesSlice(sealed, 0, bytesLen(sealed));
            bytesSet(changed, i, (bytesGet(changed, i) catch 0) ^ (1 << bit));
            assert(rejected(key, nonce, aad, changed), "tamper " + toStr(i) + ":" + toStr(bit)); bit = bit + 1;
        }
        i = i + 1;
    }
    assert(rejected(key, nonce, bytesFromStr("different"), sealed), "AAD tamper");
    const badNonce = bytesSlice(nonce, 0, 12); bytesSet(badNonce, 0, 1);
    assert(rejected(key, badNonce, aad, sealed), "nonce tamper");
    const badKey = bytesSlice(key, 0, 16); bytesSet(badKey, 0, 1);
    assert(rejected(badKey, nonce, aad, sealed), "key tamper");
    i = 0;
    while (i < bytesLen(sealed)) { assert(rejected(key, nonce, aad, bytesSlice(sealed, 0, i)), "truncated " + toStr(i)); i = i + 1; }
    assert(rejected(bytesNew(15), nonce, aad, sealed) && rejected(key, bytesNew(13), aad, sealed), "bad parameters");
    assert(badKeyFails(), "unsupported key length");
    assert(badBlockFails(), "bad block length");
}
