// D3 v0.18：Bytes 读写的边界——覆盖原生内联快路径与通用路径的分界（扩容、越界、0/255、静态类型未知）。
struct Holder { data: Bytes }

function sum(b: Bytes): int {
    let s = 0;
    let i = 0;
    while (i < bytesLen(b)) { s = s * 31 % 1000003 + (bytesGet(b, i) catch 0); i = i + 1; }
    return s;
}

export function main(args: []string): int {
    const g = bytesNew(0);
    let i = 0;
    while (i < 1000) { bytesPush(g, i % 256); i = i + 1; }
    print(toStr(bytesLen(g)) + " " + toStr(sum(g)) + " " + toStr(bytesGet(g, 999) catch -1));
    print(toStr(bytesGet(g, -1) catch -1) + " " + toStr(bytesGet(g, 1000) catch -2) + " " + toStr(bytesGet(g, 0) catch -3));
    bytesSet(g, 0, 255);
    bytesSet(g, 999, 0);
    print(toStr(bytesGet(g, 0) catch -1) + " " + toStr(bytesGet(g, 999) catch -1));
    const s = bytesFromStr("abc");
    bytesPush(s, 0);
    bytesPush(s, 255);
    i = 0;
    while (i < 40) { bytesPush(s, 65 + i % 26); i = i + 1; }
    print(toStr(len(s)) + " " + toStr(s.len()) + " " + toStr(sum(s)));
    const h = new Holder { data: bytesSlice(s, 3, 2) };
    bytesPush(h.data, 7);
    bytesSet(h.data, 0, 9);
    print(toStr(bytesLen(h.data)) + " " + toStr(bytesGet(h.data, 0) catch -1) + " " + toStr(bytesGet(h.data, 1) catch -1) + " " + toStr(bytesGet(h.data, 2) catch -1));
    const parts: List< Bytes> = listNew();
    listPush(parts, g);
    const p0 = listGet(parts, 0) catch bytesNew(0);
    bytesPush(p0, 1);
    print(toStr(bytesLen(g)) + " " + toStr(bytesGet(p0, 1000) catch -1));
    bytesAppend(s, s);
    bytesPush(s, 3);
    print(toStr(bytesLen(s)) + " " + toStr(sum(s)));
    const e = bytesNew(0);
    print(toStr(bytesLen(e)) + " " + toStr(bytesGet(e, 0) catch -5));
    return 0;
}
