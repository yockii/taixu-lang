// H1①（2026-09-11 体检 P1#1）回归负例：泵轮内运行中任务取消同轮后位 queued
// 任务——旧实现按快照长度固定弹出，cancelTask 摘队后空队弹出即 index 越界
// panic（exit 3）。修复＝轮改开队快照＋取消跳过（interp.zig pumpTasks）。
// 形态注记：canceler 先于 victim 入队（spawn 序），经全局 slots 表间接取得
// 其 future——使取消发生在泵轮内且 victim 仍 .queued（main 同步体的取消在
// 泵外，不触发本路径——async-cancel-await-err.tx 已有）。
let slots: List<Future<int>> = listNew();

function main(args: []string): int {
    const k = canceler();
    listPush(slots, victim());
    print("spawned");
    return 0;
}

async function victim(): int {
    return 7;
}

async function canceler(): int | Error {
    const f: Future<int> | Error = listGet(slots, 0) catch err("no future");
    taskCancel(f?);
    return 0;
}
