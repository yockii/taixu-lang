// Exercise the public App text path used by native printable keys.
import { setenv } from "std/os";
import { appNew, appClose, defaultSpec, pump, focusPushId, focusTopId } from "gui/app";
import { eventWindowPushMods } from "gui/surface";
import { inputValue } from "gui/components";
import { fontEmbedded } from "gui/text";
import { controllerNew, controllerTick } from "../examples/browser/controller";
import { navigationOpen } from "../examples/browser/navigation";
import { uiNew, uiEnsureSurfaces, uiReflow, uiDestroy, ID_PAGE, ID_ADDRESS } from "../examples/browser/ui_state";
import { uiBind } from "../examples/browser/ui_events";

export function main(args: []string): int {
    setenv("TAIXU_REPLAY", "tests/wheel-routing-script.txt") catch panic("replay");
    const app = appNew(defaultSpec("page text input", 760, 540)); assert(app.scripted, "explicit headless app");
    const controller = controllerNew(true, listNew(), 1000) catch panic("controller");
    navigationOpen(controller.navigation, "https://example.test/a") catch panic("navigation");
    let tick = 0; while (tick < 5) { controllerTick(controller) catch panic("tick"); tick = tick + 1; }
    assert(controller.navigation.content.title == "DEMO A" && !controller.navigation.loading, "explicit demo page is ready");
    const font = fontEmbedded() catch panic("font"); const model = uiNew(controller, font);
    uiEnsureSurfaces(model, app) catch panic("surfaces"); uiReflow(model, app) catch panic("layout"); uiBind(model, app); focusPushId(app, ID_PAGE);
    const step = model.pageHeight * 3 / 4; assert(step > 0, "page step");
    eventWindowPushMods(app.hwnd, 8, 32, 0, 0, 0); pump(app, 0);
    assert(controller.navigation.scroll == step, "native text Space scrolls down");
    eventWindowPushMods(app.hwnd, 8, 32, 0, 0, 1); pump(app, 0);
    assert(controller.navigation.scroll == 0, "native text Shift+Space scrolls up");
    eventWindowPushMods(app.hwnd, 1, 32, 0, 0, 0); pump(app, 0);
    assert(controller.navigation.scroll == step, "explicit key replay remains supported");
    eventWindowPushMods(app.hwnd, 1, 'L', 0, 0, 2); pump(app, 0);
    assert(focusTopId(app) == ID_ADDRESS, "address shortcut");
    eventWindowPushMods(app.hwnd, 8, 32, 0, 0, 0); pump(app, 0);
    assert(inputValue(model.address) == " " && controller.navigation.scroll == step, "address Space edits without scrolling");
    uiDestroy(model, app); appClose(app); print("browser page input: native text Space, Shift, focus and address OK"); return 0;
}
