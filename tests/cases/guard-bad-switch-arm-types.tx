// D3 v0.49 §6.4-3：合不成 T | Error、T? 的臂类型组合照旧报 3018（int 与 string、None 与 Error 并存、两种错误 enum、
// 与期望类型不符）；全是 None 的臂没有 T 可依。
enum J { S(s: string), N(n: int), B }
enum E1 extends Error { A = "a" }
enum E2 extends Error { B = "b" }

function mixed(j: J): void {
    const r = switch (j) {
        case S(s) => s,
        case N(n) => n,
        else => "b",
    };
    print(r);
}

function noneAndErr(j: J): void {
    const r = switch (j) {
        case N(n) => n,
        case B => None,
        else => err("x"),
    };
}

function twoEnums(j: J): void {
    const r = switch (j) {
        case N(n) => n,
        case B => E1.A,
        else => E2.B,
    };
}

function wrongExpected(j: J): int {
    return switch (j) {
        case N(n) => n,
        else => "不是数",
    };
}

function allNone(j: J): void {
    const r = switch (j) {
        case B => None,
        else => None,
    };
}

export function main(args: []string): int {
    args;
    return 0;
}
