// Independent executable macro exercise: no source frontend or candidate plan.
// The negative control bypasses one alias synchronization and must exit 123.
import { genNew, genLabel, genMovI, genLd, genStI, genStX, genLea, genLeaSym, genBrI, genJmp, genFnBegin, genFnEpilogue,
    genWinFromArg, genCacheConfigure, genCall, genCallR, genRes, genRes2, genSetRes, genSetRes2, genSubmit,
    gaR, gaSym, GArg, G_W, G_T0, G_T1, G_T2, G_K0 } from "./selfhost/gen_ops";
import { asStructuredBegin, asStructuredSection, asStructuredLabel, asStructuredInstruction, asStructuredReg, asStructuredMem,
    asStructuredImm, asStructuredMissing, asStructuredZero, asBufferInstruction, asResolveLocalFixups, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { linkElfImage, elfBytesOut, elfLastError } from "./selfhost/link_elf";

function args(value: Ref<GArg>): List<Ref<GArg>> { const out: List<Ref<GArg>> = listNew(); listPush(out, value); return out; }
function emit(bad: bool, path: string): void {
    asStructuredBegin(); const missing = asStructuredMissing();
    asStructuredLabel("__tx_entry");
    asStructuredInstruction("sub", 2, asStructuredReg(0, 4), asStructuredImm(32), missing, 1);
    const entry = genNew(0, 0); genCall(entry, "f_0", args(gaSym("window")));
    assert(genSubmit(entry) == "", "entry macro");
    asStructuredInstruction("mov", 2, asStructuredReg(0, 7), asStructuredReg(0, 0), missing, 1);
    asStructuredInstruction("mov", 2, asStructuredReg(0, 0), asStructuredImm(60), missing, 1);
    asStructuredInstruction("syscall", 0, missing, missing, missing, 1);
    const g = genNew(0, 0); genCacheConfigure(g, 2, 3); genFnBegin(g, 0, 56); genWinFromArg(g);
    genStI(g, 8, G_W, 40, 0x1122334455667788); genStI(g, 1, G_W, 41, 0xA5);
    genLd(g, 8, G_T0, G_W, 40); genBrI(g, "ne", G_T0, 0x112233445566A588, "fail");
    genLea(g, G_T1, G_W, 40);
    if (bad) { asBufferInstruction(g.b, "mov", 2, asStructuredMem(2, 10, -1, 0, 0, 0, ""), asStructuredImm(33), missing, 1); }
    else { genStI(g, 8, G_T1, 0, 33); }
    genLd(g, 8, G_T0, G_W, 40); genBrI(g, "ne", G_T0, 33, "fail");
    genMovI(g, G_T2, 40); genMovI(g, G_T0, 44); genStX(g, 8, G_W, G_T2, G_T0, false);
    genLd(g, 8, G_T0, G_W, 40); genBrI(g, "ne", G_T0, 44, "fail");
    genCall(g, "f_1", args(gaR(G_W))); genRes(g, G_T0); genRes2(g, G_T2);
    genBrI(g, "ne", G_T0, 77, "fail"); genBrI(g, "ne", G_T2, 99, "fail");
    genLd(g, 8, G_T0, G_W, 40); genBrI(g, "ne", G_T0, 55, "fail");
    genLd(g, 8, G_T0, G_W, 56); genBrI(g, "ne", G_T0, 66, "fail");
    genStI(g, 8, G_W, 40, 11); genLeaSym(g, G_K0, "f_1"); genCallR(g, G_K0, args(gaR(G_W)));
    genRes(g, G_T0); genBrI(g, "ne", G_T0, 77, "fail");
    genLd(g, 8, G_T0, G_W, 40); genBrI(g, "ne", G_T0, 55, "fail");
    genMovI(g, G_T0, 0); genSetRes(g, G_T0); genJmp(g, "done");
    genLabel(g, "fail"); genMovI(g, G_T0, 123); genSetRes(g, G_T0);
    genLabel(g, "done"); genFnEpilogue(g); assert(genSubmit(g) == "", "caller macros");
    const callee = genNew(0, 0); genCacheConfigure(callee, 2, 3); genFnBegin(callee, 1, 56); genWinFromArg(callee);
    genStI(callee, 8, G_W, 40, 55); genStI(callee, 8, G_W, 56, 66);
    genMovI(callee, G_T0, 77); genSetRes(callee, G_T0); genMovI(callee, G_T2, 99); genSetRes2(callee, G_T2);
    genFnEpilogue(callee); assert(genSubmit(callee) == "", "callee macros");
    asStructuredSection(3); asStructuredLabel("window"); asStructuredZero(128);
    asResolveLocalFixups(); assert(asFailedAs() == 0, asLastErrAs());
    assert(linkElfImage("__tx_entry") == 0, elfLastError());
    writeFileBytes(path, elfBytesOut()) catch panic("alias image write");
}
export function main(argv: []string): int {
    if (len(argv) != 1) { return 64; }
    emit(false, argv[0] + ".elf"); emit(true, argv[0] + "-bad.elf"); return 0;
}
