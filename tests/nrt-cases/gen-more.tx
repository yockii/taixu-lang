// D3 v0.22：生成器的更多形态——多参数、体内闭包、嵌套循环与 catch 块里的 yield、递归生成器、
// 产出生成器的生成器、实现接口方法、取值方的字符串累加、async 函数里迭代生成器。

function* spread(a: int, b: int, c: int, d: int, e: string): string {
    yield e + toStr(a);
    yield e + toStr(b);
    yield e + toStr(c);
    yield e + toStr(d);
}

function* scaled(xs: List< int>, k: int): int {
    const mul = (v: int): int => v * k;
    for (x in xs) {
        yield mul(x);
    }
}

function parseNum(s: string): int | Error {
    if (s == "") { return err("empty"); }
    return len(s);
}

function* grid(n: int): string {
    let i = 0;
    while (i < n) {
        let j = 0;
        while (j < n) {
            if ((i + j) % 2 == 0) {
                yield toStr(i) + toStr(j);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    const v = parseNum("ab") catch -1;
    yield "after " + toStr(v);
    const w = parseNum("") catch (e) {
        yield "caught " + e.message;
        return;
    };
    yield "unreachable " + toStr(w);
}

// 递归生成器：深度为 n 的嵌套取值链。
function* countdown(n: int): int {
    if (n > 0) {
        for (x in countdown(n - 1)) {
            yield x;
        }
    }
    yield n;
}

function* batches(n: int): Gen< int> {
    let i = 0;
    while (i < n) {
        yield countdown(i);
        i = i + 1;
    }
}

interface Source {
    items(): Gen< int>;
}

struct Pair {
    a: int,
    b: int,
}

function* pairItems(p: Ref< Pair>): int {
    yield p.a;
    yield p.b;
}

function total(s: Source): int {
    let t = 0;
    for (x in s.items()) {
        t = t + x;
    }
    return t;
}

async function asyncSum(g: Gen< int>): int {
    let t = 0;
    for (x in g) {
        await sleepMs(0) catch (e) {
            return -1;
        };
        t = t + x;
    }
    print("async sum " + toStr(t));
    return t;
}

export function main(args: []string): int {
    let line = "";
    for (s in spread(1, 2, 3, 4, "n")) {
        line = line + s + " ";
    }
    print(line);

    const xs: List< int> = listNew();
    listPush(xs, 1);
    listPush(xs, 2);
    listPush(xs, 3);
    let acc = "";
    for (v in scaled(xs, 10)) {
        acc = acc + toStr(v) + ",";
    }
    print(acc);

    for (cell in grid(3)) {
        print("grid " + cell);
    }

    let deep = 0;
    let last = -1;
    for (x in countdown(200)) {
        deep = deep + 1;
        last = x;
    }
    print("countdown " + toStr(deep) + " last " + toStr(last));

    let sizes = "";
    for (b in batches(4)) {
        let n = 0;
        for (x in b) {
            n = n + 1;
        }
        sizes = sizes + toStr(n) + " ";
    }
    print("batches " + sizes);

    const p = new Pair { a: 20, b: 22 };
    print("iface total " + toStr(total(p)));

    asyncSum(countdown(3));
    return 0;
}
