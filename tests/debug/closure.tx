// 调试基准：闭包捕获与闭包体内断点。
function makeAdder(k: int): (int) => int {
    const base = k * 10;
    return (x: int): int => {
        const r = x + base;
        return r;
    };
}

export function main(args: []string): int {
    const f = makeAdder(3);
    const v = f(4);
    print(toStr(v));
    return 0;
}
