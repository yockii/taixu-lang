// RISC-V 的 RELA 语义（RISC-V ELF psABI，目标分层 X3a 从 link_objects.tx 拆出）：sa = S+A，site = P。指令的
// 操作码位保留，只改立即数位；范围不合即拒绝（不截断）。HI20 取 (v+0x800)>>12，LO12 取低 12 位（按符号）；CALL／CALL_PLT 同时改
// auipc 与后一条 jalr。PCREL_LO12 的 S 是所配 auipc 的地址：先记下，等本轮全部 HI20 都算过再应用（rv64ApplyLo12）。施加函数返回
// 空串为成功，否则为拒绝的原因（由 link_objects.tx 记下）。
import { relocPatch, relocWord32 } from "./reloc_bits";

// PCREL_HI20：位置（虚拟地址的十进制）→ S+A−P；PCREL_LO12 的符号指向所配的 auipc，按它取值，等本轮全部重定位之后应用。
let rvHi: Map<string, int> = mapNew();
let rvLoAt: List<int> = listNew();
let rvLoKind: List<int> = listNew();
let rvLoLabel: List<int> = listNew();

/// 每轮重定位开始前清空配对状态。
export function rv64RelocReset(): void {
    rvHi = mapNew(); rvLoAt = listNew(); rvLoKind = listNew(); rvLoLabel = listNew();
}

/// 重定位改写的字节数：R_RISCV_64（2）与 CALL／CALL_PLT（18、19，auipc＋jalr 两条）为 8，其余 4（1 号也按 8 算，同拆分之前；它在
/// 施加时被拒）。
export function rv64RelocWidth(kind: int): int {
    if (kind == 1 || kind == 2 || kind == 18 || kind == 19) { return 8; }
    return 4;
}

/// 重定位的目标恰是符号本身：加数为 0。
export function rv64RelocExact(kind: int, addend: int): bool { return addend == 0; }

export function rv64Relocate(out: Bytes, fileAt: int, site: int, kind: int, sa: int, absSites: List<int>): string {
    if (kind == 2) {
        relocPatch(out, fileAt, sa, 8);
        listPush(absSites, site);
        return "";
    }
    if (kind == 57) {
        const v = wrapSub(sa, site);
        if (v < -2147483648 || v > 2147483647) { return "RelativeRelocationOutOfRange"; }
        relocPatch(out, fileAt, v, 4);
        return "";
    }
    if (kind == 24 || kind == 25) {
        listPush(rvLoAt, fileAt); listPush(rvLoKind, kind); listPush(rvLoLabel, sa);
        return "";
    }
    const insn = relocWord32(out, fileAt);
    if (kind == 18 || kind == 19 || kind == 23) {
        const v = wrapSub(sa, site);
        if (v < -2147485696 || v > 2147481599) { return "PcrelRelocationOutOfRange"; }
        relocPatch(out, fileAt, (insn & 4095) | ((((v + 2048) >> 12) & 1048575) << 12), 4);
        if (kind == 23) {
            mapSet(rvHi, toStr(site), v);
            return "";
        }
        const next = relocWord32(out, fileAt + 4);
        relocPatch(out, fileAt + 4, (next & 1048575) | ((v & 4095) << 20), 4);
        return "";
    }
    return "UnsupportedRelocation:" + toStr(kind);
}

/// 应用本轮记下的全部 PCREL_LO12（I 型改 imm[11:0]，S 型拆成 imm[11:5]、imm[4:0]）。
export function rv64ApplyLo12(out: Bytes): string {
    let k = 0;
    while (k < listLen(rvLoAt)) {
        const fileAt = listGet(rvLoAt, k) catch 0;
        const label = listGet(rvLoLabel, k) catch 0;
        if (!mapHas(rvHi, toStr(label))) { return "UnpairedPcrelLo12"; }
        const lo = (mapGet(rvHi, toStr(label)) catch 0) & 4095;
        const insn = relocWord32(out, fileAt);
        if ((listGet(rvLoKind, k) catch 0) == 24) {
            relocPatch(out, fileAt, (insn & 1048575) | (lo << 20), 4);
        } else {
            relocPatch(out, fileAt, (insn & 33550463) | ((lo >>> 5) << 25) | ((lo & 31) << 7), 4);
        }
        k = k + 1;
    }
    return "";
}
