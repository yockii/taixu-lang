// real-window-macos —— macOS 真窗（GUI 原生引擎 G4，AppKit 经 Objective-C 运行时）：开一个不显示的真窗（引擎旗标 16），经
// [NSApp postEvent:atStart:] 投递按钮、移动、键（按 kVK 键码与字符）、尺寸与关窗事件，核对事件分派翻出的序列（移动合并、产生
// 字符的键只发字符、Shift 取大写、Ctrl 键不发字符、右键不发、功能键的私用区字符不算文字）；程序化改客户区尺寸（经窗口委托
// 当场回尺寸事件）、呈现、标题（含 NUL 不 trap）、菜单（得 -1）、光标、最小最大尺寸的返回值；剪贴板写入后读回（通用板跨进程保留，跑完放回原有文本）；文件对话框能力 cap 7（G5 第二部分；面板本身会出现在屏幕上，不进自动用例）。只在 macOS 上
// 跑（verify 按文件名的 -macos 后缀判定）；没有窗口服务器会话时 cap 为 0，用例照常输出（框架退回脚本窗）。
import { windowOpenEx, windowWaitEvent, windowPresent, windowClose, eventWindowTarget, eventWindowX, eventWindowY, eventWindowMods, windowSetTitle, windowMenuAdd, windowSetCursor, windowSetMinMax, windowClientResize, surfaceOpen, surfaceClear, surfaceClose, guiQuery, eventWindowOpen, clipboardSetText, clipboardGetText, windowScale } from "gui/surface";
import { platDebugPost } from "gui/engine/platform";

function lp(x: int, y: int): int {
    return (y << 16) | x;
}

function key(code: int, cp: int): int {
    return (cp << 16) | code;
}

export function main(args: []string): int {
    args;
    const id: int = windowOpenEx("真窗探针", 240, 160, 16);
    const k: int = windowScale(id);
    print("real " + toStr(id > 0) + " scale-ok " + toStr(k >= 100 && k <= 500) + " cap " + toStr(guiQuery(0)) + " clip-cap " + toStr(guiQuery(5)) + " dialog-cap " + toStr(guiQuery(7)));
    const sid: int = eventWindowOpen("脚本窗", 10, 10);
    print("ids distinct " + toStr(sid != id));
    const surf: int = surfaceOpen(64, 32) catch (e) {
        print("surface failed");
        return 1;
    };
    surfaceClear(surf, 0x3366CC);
    print("present " + toStr(windowPresent(id, surf)) + " title " + toStr(windowSetTitle(id, "新标题")) + " nul-title " + toStr(windowSetTitle(id, "前" + (bytesToStr(bytesNew(1)) catch "") + "后")));
    print("menu " + toStr(windowMenuAdd(id, 120, "文件")) + " cursor " + toStr(windowSetCursor(id, 1)) + " " + toStr(windowSetCursor(id, 5)) + " minmax " + toStr(windowSetMinMax(id, 100, 80, 0, 0)));
    const saved: string = clipboardGetText();
    print("clip " + toStr(clipboardSetText("剪贴板：太虚 ✓")) + " back " + toStr(clipboardGetText() == "剪贴板：太虚 ✓"));
    if (saved != "") {
        clipboardSetText(saved);
    }
    print("resize-api " + toStr(windowClientResize(id, 300, 200)));
    platDebugPost(id, 1, 0, lp(40, 30));
    platDebugPost(id, 5, 0, lp(41, 31));
    platDebugPost(id, 5, 0, lp(42, 32));
    platDebugPost(id, 2, 0, lp(43, 33));
    platDebugPost(id, 3, 0, lp(44, 34));
    platDebugPost(id, 10, key(0x7B, 0xF702), 0); // ← 键（字符是私用区的功能键码，不算文字）
    platDebugPost(id, 10, key(0x69, 0xF710), 0); // F13：不在键表里不发键事件，私用区字符不发文字
    platDebugPost(id, 10, key(0x75, 0xF728), 0); // 向前删除
    platDebugPost(id, 11, key(0x7B, 0xF702), 0);
    platDebugPost(id, 10, key(0x24, 13), 0); // 回车
    platDebugPost(id, 10, key(0x06, 0x7A), 0); // z
    platDebugPost(id, 10, key(0x06, 0x5A), 1 << 32); // Shift+Z
    platDebugPost(id, 10, key(0x06, 0x7A), 2 << 32); // Ctrl+Z：只发键
    platDebugPost(id, 10, key(0x33, 0x7F), 0); // 退格（字符是 DEL，不算文字）
    platDebugPost(id, 101, 0, lp(250, 150));
    platDebugPost(id, 100, 0, 0);
    let n: int = 0;
    while (n < 40) {
        const kind: int = windowWaitEvent(id, 500);
        if (kind == 0) {
            break;
        }
        const t: int = eventWindowTarget(id);
        const x: int = eventWindowX(id);
        const y: int = eventWindowY(id);
        if (kind == 3 || kind == 4 || kind == 5) {
            let px: int = 40;
            let py: int = 30;
            if (kind == 5) {
                px = 42;
                py = 32;
            } else if (kind == 4) {
                px = 43;
                py = 33;
            }
            print("ev " + toStr(kind) + " " + toStr(t) + " xy " + toStr(x == px && y == py));
        } else if (kind == 7) {
            if (x == 300 && y == 200) {
                print("ev 7 api true");
            } else {
                print("ev 7 posted " + toStr(x == 250 && y == 150));
            }
        } else if (kind == 1 || kind == 2 || kind == 8) {
            print("ev " + toStr(kind) + " " + toStr(t) + " mods " + toStr(eventWindowMods(id)));
        } else {
            print("ev " + toStr(kind) + " " + toStr(t));
        }
        if (kind == 6) {
            break;
        }
        n = n + 1;
    }
    windowClose(id);
    print("closed real " + toStr(windowSetTitle(id, "x")));
    windowClose(sid);
    surfaceClose(surf);
    return 0;
}
