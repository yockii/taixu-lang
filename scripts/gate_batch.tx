// 固定快照批次入口。
import { absolute, finishRunDir, freshRunDir, readBytes, parseDigits } from "./build_lib";
import { osRealPath } from "./build_os";
import { parseSpec } from "./gate_batch_model";
import { jParseUnique } from "./test_json";
import { runBatch } from "./gate_batch_run";

function run(args: []string): int | Error {
    let config = ""; let work = ""; let width = 1; let i = 0;
    while (i < len(args)) {
        if (i + 1 >= len(args)) { return err("缺少参数取值"); }
        const a = args[i]; const v = args[i + 1];
        if (a == "--manifest") { config = osRealPath(absolute(v)); }
        else if (a == "--work") { work = osRealPath(absolute(v)); }
        else if (a == "--jobs") { width = parseDigits(v); if (width < 1 || width > 32) { return err("jobs 须为 1..32"); } }
        else { return err("未知选项：" + a); }
        i = i + 2;
    }
    if (len(config) == 0 || len(work) == 0) { return err("用法：gate_batch.tx --manifest <清单> --work <目录> [--jobs 1..32]"); }
    const spec = parseSpec(jParseUnique(readBytes(config)?)?)?;
    const dir = freshRunDir(work, "batch-", 0)?;
    const runId = "batch-" + toStr(monoNs());
    const code = runBatch(spec, dir, runId, width);
    finishRunDir(dir);
    return code;
}
export function main(args: []string): int { return run(args) catch (e) { eprint("gate_batch: " + e.message); return 1; }; }
