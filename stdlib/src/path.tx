// ============================================================================
// std/path —— 路径工具（V0.9-S1；D27 §一；STD-03）。
//
// **字节面纯函数**：`/` 分隔规范化；Windows 反斜杠入参按字面处理（不做
// 分隔符转换——文档明示，D27 §一）。全部函数无 IO、无随机性——同入参
// 恒同出参（e2e/教程可断言）。
// ============================================================================

// 拼接：以 `/` 连接两段；右段以 `/` 开头时不重复分隔符；任一段为空返回另一段。
export function pathJoin(base: string, rel: string): string {
    if (len(base) == 0) { return rel; }
    if (len(rel) == 0) { return base; }
    const bEnd = byteAt(base, len(base) - 1) catch 0;
    const rStart = byteAt(rel, 0) catch 0;
    if (bEnd == 47 && rStart == 47) { // 47 = '/'
        // 双斜杠碰撞→归一：截去 base 全部尾斜杠再接（"a//"+"/b"→"a/b"）。
        let end: int = len(base);
        while (end > 0) {
            const c = byteAt(base, end - 1) catch 0;
            if (c != 47) { break; }
            end = end - 1;
        }
        return byteSlice(base, 0, end) + rel;
    }
    if (bEnd == 47 || rStart == 47) {
        return base + rel;
    }
    return base + "/" + rel;
}

// 文件名段：最后一个 `/` 之后的部分（无 `/` 时为整串；以 `/` 结尾时为空串）。
export function pathBase(path: string): string {
    let i: int = len(path) - 1;
    while (i >= 0) {
        const b = byteAt(path, i) catch 0;
        if (b == 47) {
            return byteSlice(path, i + 1, len(path));
        }
        i = i - 1;
    }
    return path;
}

// 目录段：最后一个 `/` 之前的部分（含尾 `/`；无 `/` 时为空串）。
export function pathDir(path: string): string {
    let i: int = len(path) - 1;
    while (i >= 0) {
        const b = byteAt(path, i) catch 0;
        if (b == 47) {
            return byteSlice(path, 0, i + 1);
        }
        i = i - 1;
    }
    return "";
}

// 扩展名：最后一个 `.` 之后的部分（含点）；仅当 `.` 出现在最后一个 `/`
// 之后且不在首字符——否则空串（隐藏文件/无扩展名约定）。
export function pathExt(path: string): string {
    const base = pathBase(path);
    let i: int = len(base) - 1;
    while (i >= 0) {
        const b = byteAt(base, i) catch 0;
        if (b == 46) { // 46 = '.'
            if (i == 0) { return ""; }
            return byteSlice(base, i, len(base));
        }
        i = i - 1;
    }
    return "";
}

// 规范化：合并 `//`、消解 `./`；处理 `..`（弹出上一段——仅字面层面，不校验
// 存在性）；相对路径开头的 `..` 保留字面。分隔符恒 `/`。
export function pathNormalize(path: string): string {
    const parts: List<string> = listNew();
    let i: int = 0;
    let segStart: int = 0;
    while (i <= len(path)) {
        let b: int = 47; // 串尾视同分隔符（收最后一段）
        if (i < len(path)) {
            b = byteAt(path, i) catch 47;
        }
        if (b == 47) {
            if (i > segStart) {
                const seg = byteSlice(path, segStart, i);
                if (seg == ".") {
                    // 消解当前段
                } else if (seg == "..") {
                    const n = listLen(parts);
                    let popped: bool = false;
                    if (n > 0) {
                        const last = listGet(parts, n - 1) catch "";
                        if (last != "..") {
                            const dropped = listPop(parts);
                            popped = true;
                        }
                    }
                    if (!popped) {
                        listPush(parts, seg); // 相对路径开头的 .. 保留
                    }
                } else {
                    listPush(parts, seg);
                }
            }
            i = i + 1;
            segStart = i;
            continue;
        }
        i = i + 1;
    }
    let out: string = "";
    let k: int = 0;
    while (k < listLen(parts)) {
        const seg = listGet(parts, k) catch "";
        out = pathJoin(out, seg);
        k = k + 1;
    }
    return out;
}

// —— 内部：字节面切片（多字节 UTF-8 序列重组码点后原样还原——字节恒等，
//    与 bootstrap/lexer.tx sliceText 同手法；非 UTF-8 字节序列按字面降级）——
function byteSlice(s: string, from: int, to: int): string {
    let out: string = "";
    let i: int = from;
    while (i < to && i < len(s)) {
        const b = byteAt(s, i) catch 0;
        if (b < 128) {
            out = out + (utf8Encode(b) catch "");
            i = i + 1;
            continue;
        }
        if (b < 194) {
            // 孤立 continuation（128–193）——非法 UTF-8 首（内）字节，替换还原。
            out = out + (utf8Encode(0xFFFD) catch "?");
            i = i + 1;
            continue;
        }
        // 多字节头：按序列长度重组码点（0xC2..0xDF=2 / 0xE0..0xEF=3 / 0xF0..0xF4=4）。
        let n: int = 2;
        let cp: int = b - 192;
        if (b >= 240) {
            n = 4;
            cp = b - 240;
        } else if (b >= 224) {
            n = 3;
            cp = b - 224;
        }
        let ok: bool = true;
        let k: int = 1;
        while (k < n) {
            const cb = byteAt(s, i + k) catch -1;
            if (cb < 128 || cb >= 192) {
                ok = false;
            } else {
                cp = cp * 64 + (cb - 128);
            }
            k = k + 1;
        }
        if (ok && i + n <= to) {
            out = out + (utf8Encode(cp) catch "");
            i = i + n;
        } else {
            out = out + (utf8Encode(0xFFFD) catch "?");
            i = i + 1;
        }
    }
    return out;
}
