// ============================================================================
// engine/mac/m_rd —— objc_msgSend：double(id, SEL)（x86_64 的 double 返回也走 objc_msgSend，_fpret 只用于 long double）。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize): float from "/usr/lib/libobjc.A.dylib";

export function msgRetD(o: usize, s: string): float {
    return objc_msgSend(o, sel_registerName(s));
}
