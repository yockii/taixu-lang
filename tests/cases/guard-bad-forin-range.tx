// D3 v0.51 §6.10-2：range(…) 只作 for-in 的迭代对象，产出一个整数（for-in 写一个变量），实参须为 int、
// 一或两个；实参出错时不再连带报循环条件的错误。
export function main(args: []string): int {
    const r = range(3);
    for (i, j in range(3)) { print("x"); }
    for (i in range(1.5)) { print("x"); }
    for (i in range(1, 2, 3)) { print("x"); }
    return 0;
}
