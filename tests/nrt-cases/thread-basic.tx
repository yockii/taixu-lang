// 线程第 2 步（线程设计 §十 第 2 步、§十三）：threadSpawn／threadJoin 往返——int、float、bool、定宽数值与
// void 结果；模块级 let 每线程一份（线程里的修改不影响 main 与别的线程，各线程从初值开始），模块初始化在
// 每个线程里各跑一次（每个线程各打印一行 init）；句柄存进 List 逐个 join；句柄复制后共享同一线程，第二次
// join 得到错误值；线程里再建线程并 join；句柄未 join 就释放的线程照常跑完，main 返回后进程等它结束
// （它打印的两行排在最后）。
function note(): int {
    print("init");
    return 5;
}

let base: int = note();
let counter: int = 0;

function bump(): int {
    let i = 0;
    while (i < 1000) {
        counter = counter + 1;
        i = i + 1;
    }
    return counter + base;
}

function sum(): int {
    let t = 0;
    let i = 1;
    while (i <= 100000) {
        t = t + i;
        i = i + 1;
    }
    return t;
}

function half(): float {
    return 0.5;
}

function yes(): bool {
    return counter == 0;
}

function narrow(): i32 {
    return -7;
}

function quiet(): void {
    counter = 99;
}

function nested(): int {
    const inner = threadSpawn(sum);
    return joinInt(inner) + 1;
}

function late(): void {
    let i = 0;
    let t = 0;
    while (i < 2000000) {
        t = t + i % 7;
        i = i + 1;
    }
    print("late done " + toStr(t));
}

function joinInt(t: Thread < int >): int {
    const v = threadJoin(t) catch (e) {
        print("join error: " + e.message);
        return -1;
    };
    return v;
}

function joinAgain(t: Thread < float >): float {
    const v = threadJoin(t) catch (e) {
        print("second join: " + e.message);
        return -1.0;
    };
    return v;
}

function main(args: []string): void {
    print("main");
    const a = threadSpawn(sum);
    print("sum " + toStr(joinInt(a)));
    const ts: List< Thread< int>> = listNew();
    let k = 0;
    while (k < 4) {
        listPush(ts, threadSpawn(bump));
        k = k + 1;
    }
    let total = 0;
    for (t in ts) {
        total = total + joinInt(t);
    }
    print("bump total " + toStr(total) + " main counter " + toStr(counter));
    const h = threadSpawn(half);
    const h2 = h;
    print("half " + toStr(threadJoin(h) catch -1.0));
    joinAgain(h2);
    print("yes " + toStr(threadJoin(threadSpawn(yes)) catch false));
    print("narrow " + toStr((threadJoin(threadSpawn(narrow)) catch 0) as int));
    threadJoin(threadSpawn(quiet)) catch (e) {
        print("quiet failed");
        return;
    };
    print("quiet joined, main counter " + toStr(counter));
    print("nested " + toStr(joinInt(threadSpawn(nested))));
    print("main end");
    threadSpawn(late);
}
