// 按目标选文件（D3 v0.35，macOS 适配 M0b）：x_<os>_<arch>、x_<os>、x_unix（类 Unix）、x 四档，三个目标上编出并运行；
// 输出相同，但只有每个目标都选对文件时才为 true。
import { which } from "./data/tpick";
import { which2 } from "./data/tpick2";

function main(args: []string): int {
    const a = which();
    const b = which2();
    print("picked: " + toStr((a == "windows" && b == "base") || (a == "linux_x86_64" && b == "unix") || (a == "unix" && b == "unix")));
    return 0;
}
