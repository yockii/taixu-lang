// Scratch output uses Win32 creation APIs; reject names whose Win32 spelling
// can differ from the exact NT spelling checked by the read-only primitives.
export function scratchPathSafe(path: string, windows: bool): bool {
    if (!windows) { return len(path) > 0 && (byteAt(path, 0) catch 0) == 47; }
    if (len(path) < 3 || (byteAt(path, 1) catch 0) != 58 || (byteAt(path, 2) catch 0) != 47) { return false; }
    const drive = byteAt(path, 0) catch 0;
    if (!((drive >= 65 && drive <= 90) || (drive >= 97 && drive <= 122))) { return false; }
    let ordinal = 0;
    for (part in strSplit(path, "/")) {
        ordinal = ordinal + 1; if (ordinal == 1 || len(part) == 0) { continue; }
        const last = byteAt(part, len(part) - 1) catch 0;
        if (last == 32 || last == 46 || (byteAt(part, 0) catch 0) == 32) { return false; }
        const b = bytesFromStr(part); let i = 0; let dot = bytesLen(b);
        while (i < bytesLen(b)) {
            const c = bytesGet(b, i) catch 0;
            if (c < 32 || c == 34 || c == 42 || c == 58 || c == 60 || c == 62 || c == 63 || c == 92 || c == 124) { return false; }
            if (c == 46 && dot == bytesLen(b)) { dot = i; }
            if (c >= 65 && c <= 90) { bytesSet(b, i, c + 32); } i = i + 1;
        }
        const stem = bytesToStr(bytesSlice(b, 0, dot)) catch (e) { return false; };
        for (reserved in strSplit("con prn aux nul conin$ conout$ clock$ com1 com2 com3 com4 com5 com6 com7 com8 com9 com¹ com² com³ lpt1 lpt2 lpt3 lpt4 lpt5 lpt6 lpt7 lpt8 lpt9 lpt¹ lpt² lpt³", " ")) {
            if (stem == reserved) { return false; }
        }
    }
    return true;
}
