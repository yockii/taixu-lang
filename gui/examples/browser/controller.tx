// Main-thread coordinator. Demonstration loading is an explicit constructor mode.
import { BrowserContent, contentHtml, contentError, contentEscape } from "./content";
import { BrowserNavigation, BrowserRequest, navigationNew, navigationLocal, navigationCommit, navigationFail, navigationStop } from "./navigation";
import { BrowserJob, browserJobStart, browserJobReady, browserJobCancel, browserJobJoin } from "./worker";
import { parseUri } from "std/url";

export struct BrowserController { navigation: Ref<BrowserNavigation>, roots: List<Bytes>, timeoutMs: int, demo: bool, job: Ref<BrowserJob>?, jobCancelled: bool, demoActive: BrowserRequest?, demoReadyAt: int, ticks: int, version: int, started: int, completed: int, cancelled: int }
export function controllerNew(demo: bool, roots: List<Bytes>, timeoutMs: int): Ref<BrowserController> | Error {
    if (timeoutMs < 1 || timeoutMs > 120000) { return err("browser controller: invalid timeout"); }
    return new BrowserController { navigation: navigationNew()?, roots: roots, timeoutMs: timeoutMs, demo: demo, job: None, jobCancelled: false, demoActive: None, demoReadyAt: 0, ticks: 0, version: 1, started: 0, completed: 0, cancelled: 0 };
}
function accepted(controller: Ref<BrowserController>, changed: bool): bool {
    if (changed) { controller.version = controller.version + 1; } return changed;
}
function publish(controller: Ref<BrowserController>, generation: int, content: BrowserContent): bool | Error {
    const changed = navigationCommit(controller.navigation, generation, content) catch (e) { return accepted(controller, navigationFail(controller.navigation, generation, e.message)?); };
    return accepted(controller, changed);
}
function demoPage(url: string): BrowserContent | Error {
    const parsed = parseUri(url)?; const path = parsed.path;
    if (path == "/error") { return contentError(url, "DEMO: requested navigation failure"); }
    let label = "A"; if (path == "/b") { label = "B"; } else if (path == "/c") { label = "C"; } else if (path == "/slow") { label = "Slow"; }
    let html = "<title>DEMO " + label + "</title><style>body{margin:0;padding:16px}h1{color:#263db4}p{margin:8px 0}</style><body><h1>DEMO " + label + "</h1><p>" + contentEscape(url) + "</p><p><a href='/a'>Page A</a> | <a href='/b'>Page B</a> | <a href='/c'>Page C</a></p><p><a href='#section'>Jump to section</a> | <a href='/slow'>Slow page</a> | <a href='/error'>Error page</a></p>";
    let i = 1; while (i <= 18) { html = html + "<p>Paragraph " + toStr(i) + " - Taixu browser text and scrolling.</p>"; i = i + 1; }
    html = html + "<h2 id='section'>Section</h2><p><b>Bold</b> and <i>italic</i> text.</p><p><a href='/a'>Return to A</a></p></body>";
    return contentHtml(url, html, 200);
}
function startPending(controller: Ref<BrowserController>): bool | Error {
    const state = controller.navigation; const pending = state.pending; if (pending == None) { return false; }
    if (navigationLocal(state)?) { return accepted(controller, true); }
    if (controller.job != None || controller.demoActive != None) { return false; }
    if (controller.demo) {
        controller.demoActive = pending; let delay = 2; const uri = parseUri(pending.url)?; if (uri.path == "/slow") { delay = 8; }
        controller.demoReadyAt = controller.ticks + delay;
    } else {
        const job = browserJobStart(pending.url, controller.roots, controller.timeoutMs, pending.generation) catch (e) {
            return accepted(controller, navigationFail(state, pending.generation, e.message)?);
        };
        controller.job = job; controller.jobCancelled = false;
    }
    controller.started = controller.started + 1; return true;
}
export function controllerTick(controller: Ref<BrowserController>): bool | Error {
    controller.ticks = controller.ticks + 1; const state = controller.navigation; let changed = false; const job = controller.job;
    if (job != None) {
        if ((!state.loading || job.generation != state.generation) && !controller.jobCancelled) {
            browserJobCancel(job); controller.jobCancelled = true; controller.cancelled = controller.cancelled + 1;
        }
        if (browserJobReady(job)) {
            controller.job = None; controller.completed = controller.completed + 1;
            const content = browserJobJoin(job) catch (e) {
                const failed = accepted(controller, navigationFail(state, job.generation, e.message)?);
                const started = startPending(controller)?; return failed || started;
            };
            changed = publish(controller, job.generation, content)?;
        }
    }
    const active = controller.demoActive;
    if (active != None) {
        if (!state.loading || active.generation != state.generation) { controller.demoActive = None; controller.cancelled = controller.cancelled + 1; }
        else if (controller.ticks >= controller.demoReadyAt) {
            controller.demoActive = None; controller.completed = controller.completed + 1;
            const content = demoPage(active.url)?; changed = publish(controller, active.generation, content)? || changed;
        }
    }
    const started = startPending(controller)?; return changed || started;
}
export function controllerClose(controller: Ref<BrowserController>): void {
    navigationStop(controller.navigation); if (controller.demoActive != None) { controller.cancelled = controller.cancelled + 1; } controller.demoActive = None; const job = controller.job; controller.job = None;
    if (job != None) { if (!controller.jobCancelled) { controller.cancelled = controller.cancelled + 1; } browserJobCancel(job); controller.completed = controller.completed + 1; browserJobJoin(job) catch (e) { return; }; }
}
