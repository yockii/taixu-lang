// 线程第 2 步（Linux 动态产物，线程设计 §五-5、§四-7）：进程里有 libc 时线程经 pthread_create 创建；工作线程里
// 调外部函数、经回调回到本线程（qsort 的比较函数，回调窗口每线程一份）、ffiLastError 每线程一份（errno
// 也是 libc 的线程局部量：工作线程里 open 失败得 ENOENT 2，main 自己没调过外部函数仍为 0）。
declare function getpid(): i32 from "libc.so.6";
declare function open(path: string, flags: i32): i32 from "libc.so.6";
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "libc.so.6";
declare function memcpy(dst: Bytes, src: usize, n: usize): usize from "libc.so.6";

let compares = 0;

function u32At(addr: usize): int {
    const tmp = bytesNew(4);
    memcpy(tmp, addr, 4);
    return (bytesGet(tmp, 0) catch 0) + (bytesGet(tmp, 1) catch 0) * 256;
}

function byValue(a: usize, b: usize): i32 {
    compares = compares + 1;
    const x = u32At(a);
    const y = u32At(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

function sortInThread(): int {
    const vals = [5, 3, 9, 1, 7, 2];
    const buf = bytesNew(24);
    let i = 0;
    while (i < 6) {
        bytesSet(buf, i * 4, vals[i]);
        i = i + 1;
    }
    qsort(buf, 6, 4, byValue);
    const first = bytesGet(buf, 0) catch -1;
    const last = bytesGet(buf, 20) catch -1;
    if (compares == 0) { return -1; }
    return first * 100 + last;
}

function errnoInThread(): int {
    open("/taixu-no-such/file", 0);
    return ffiLastError();
}

function pidInThread(): bool {
    return getpid() > 0;
}

function main(args: []string): void {
    print("sorted " + toStr(threadJoin(threadSpawn(sortInThread)) catch -1) + " main compares " + toStr(compares));
    print("errno " + toStr(threadJoin(threadSpawn(errnoInThread)) catch -1) + " main " + toStr(ffiLastError()));
    print("pid " + toStr(threadJoin(threadSpawn(pidInThread)) catch false));
}
