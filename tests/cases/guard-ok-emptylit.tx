// V0.42 验收发现 A 锚件：空列表字面量＋同被调多元素字面量交替（slice 期望
// 流入——semamirror checkArrayLit 曾误读 inner 载荷位致空字面量默认 []int）。
function pick(args: []string, k: int): string {
    if (k < len(args)) { return args[k]; }
    return "-";
}

function d2(v: int): string { return "x"; }

function main(args: []string): int {
    assert(pick([], 0) == "-", "空字面量经 slice 形参");
    assert(pick(["a"], 0) == "a", "空后单元素");
    assert(pick(["a", "b"], 1) == "b", "空后双元素");
    assert(pick([d2(1)], 0) == "x", "空调用元素");
    assert(pick([d2(1), d2(2)], 1) == "x", "双调用元素");
    assert(pick([], 3) == "-", "尾空");
    print("emptylit-ok");
    return 0;
}

test "emptylit：空/单/双/调用元素 slice 流入" {
    assert(pick([], 0) == "-", "t 空");
    assert(pick(["中", "文"], 1) == "文", "CJK 元素");
}
