// gui-surface —— Surface 2D 与窗口绑定。
// 本文件为 taixu-gui 框架的绑定面（自核心仓 examples 迁入——M1）。
//
// 2026-10-26 起（GUI 原生引擎 G0）：底层由本库的 engine/ 模块实现（纯太虚），旧宿主的
// txp_* 外部函数整体退场，本模块导出的函数名与语义不变。句柄为不透明 int（0/-1 为
// 非法/错误约定）；color 为 0xRRGGBB int。全部绘制走确定性软件光栅（golden 恒走 CPU）。

import { surfNew, surfOk, surfAt, surfFree, rClear, rFillRect, rStrokeRect, rLine, rFillRectA, rSha256, rProject, rWriteBmp } from "./engine/raster";
import { winCreate, winCreateScripted, winDestroy, winWaitEvent, winPresent, winPush, winEventTarget, winEventX, winEventY, winEventMods, winSetTitle, winMove, winMinimize, winMaximizeToggle, winClientResize, winSetMinMax, winSetTopmost, winMenuAdd, winSetCursor, winSetOpacity, winSetEffect, winScale, guiCap, clipSet, clipGet, dialogOpen, dialogSave } from "./engine/window";
import { FdFilter, fdAdd } from "./engine/filedialog";
import { imgLoad, imgW, imgH, imgFree, imgDraw } from "./engine/image";

/// 句柄守卫薄包装（引擎已校验——此处把错误约定转为显式通道）。
export function surfaceOpen(w: int, h: int): int | Error {
    if (w <= 0 || h <= 0) {
        return err("surfaceOpen: 尺寸须为正");
    }
    const handle = surfNew(w, h);
    if (handle <= 0) {
        return err("surfaceOpen: 句柄池耗尽");
    }
    return handle;
}

export function surfaceClose(handle: int): void {
    surfFree(handle);
}

export function surfaceClear(handle: int, color: int): void {
    if (surfOk(handle)) {
        rClear(surfAt(handle), color);
    }
}

export function surfaceFillRect(handle: int, x: int, y: int, w: int, h: int, color: int): void {
    if (surfOk(handle)) {
        rFillRect(surfAt(handle), x, y, w, h, color);
    }
}

export function surfaceStrokeRect(handle: int, x: int, y: int, w: int, h: int, color: int): void {
    if (surfOk(handle)) {
        rStrokeRect(surfAt(handle), x, y, w, h, color);
    }
}

export function surfaceLine(handle: int, x0: int, y0: int, x1: int, y1: int, color: int): void {
    if (surfOk(handle)) {
        rLine(surfAt(handle), x0, y0, x1, y1, color);
    }
}

export function surfaceSha256(handle: int): string {
    if (!surfOk(handle)) {
        return "";
    }
    return rSha256(surfAt(handle));
}

/// BMP 落盘（测试资产/定格生成面；0＝OK）。
export function surfaceWriteBmp(handle: int, path: string): int {
    if (!surfOk(handle)) {
        return -1;
    }
    return rWriteBmp(surfAt(handle), path);
}

export function surfaceProject(handle: int): string {
    if (!surfOk(handle)) {
        return "";
    }
    return rProject(surfAt(handle));
}

// ============================================================================
// 窗口族（真窗/脚本化事件双通道同 ABI，实现在
// engine/window）。句柄为不透明 int；0＝创建失败（无窗口系统
// 目标的规范探测形态）。事件记录统一 16B 编码（kind/target/x/y）——真窗与
// 脚本注入经同一取数面（单分发管线）进 std/events。
// ============================================================================

/// 真窗创建；无窗口系统目标返回 0。
export function windowOpen(title: string, w: int, h: int): int {
    return winCreate(title, w, h, 0);
}

/// 脚本化事件窗口创建（无头确定性通道——e2e 恒走此通道）。
export function eventWindowOpen(title: string, w: int, h: int): int {
    title;
    w;
    h;
    return winCreateScripted();
}

/// 统一取事件：返回 kind（0=无）。真窗至多等 timeout_ms
/// （节拍泵）；无头通道空队列立即返回（timeout 不消费，2026-09-10 评审定档）。
export function windowWaitEvent(hwnd: int, timeout_ms: int): int {
    return winWaitEvent(hwnd, timeout_ms);
}

/// 呈现（Surface 像素整帧→窗口客户区；脚本通道为帧界面）。
export function windowPresent(hwnd: int, surface: int): int {
    return winPresent(hwnd, surface);
}

/// 注入一条事件（脚本通道；注入序＝可观测分发序）。mods 缺省 0——
/// 旧调用方零变化（修饰位走 eventWindowPushMods）。
export function eventWindowPush(hwnd: int, kind: int, target: int, x: int, y: int): int {
    return winPush(hwnd, kind, target, x, y, 0);
}

/// 注入一条带修饰位的事件（内审修正 B：S1 无缺省参数，
/// 扩参＝新增绑定；旧 eventWindowPush 五参签名零变化）。mods 位集：
/// shift=1/ctrl=2/alt=4。
export function eventWindowPushMods(hwnd: int, kind: int, target: int, x: int, y: int, mods: int): int {
    let m: int = mods;
    if (m < 0) {
        m = 0;
    }
    return winPush(hwnd, kind, target, x, y, m);
}

/// 动态标题（增补③运行时面；返回 0＝OK）。
export function windowSetTitle(hwnd: int, title: string): int {
    return winSetTitle(hwnd, title);
}

/// 读取当前记录字段（与 windowWaitEvent/eventRecord 取数配套）。
export function eventWindowTarget(hwnd: int): int {
    return winEventTarget(hwnd);
}

export function eventWindowX(hwnd: int): int {
    return winEventX(hwnd);
}

export function eventWindowY(hwnd: int): int {
    return winEventY(hwnd);
}

/// 修饰位读取（与 target/x/y getter 同一记录存储）。
export function eventWindowMods(hwnd: int): int {
    return winEventMods(hwnd);
}

export function windowClose(hwnd: int): void {
    winDestroy(hwnd);
}

// ============================================================================
// 引擎深度绑定包装（增补②③兑现；真窗行为面，
// 无头/脚本通道恒安全 no-op 或恒定值——golden 不涉）。
// ============================================================================

/// 引擎能力查询（cap：0=window_system 1=effects 2=menus 3=frameless
/// 4=dpi_scale_x100 5=clipboard〔CAP_* 单一事实源＝
/// engine/window——原注"5=effect_applied"系平台层从未定义的文档漂移，
/// 随剪贴板 cap 入册一并修正〕；无头恒 0／dpi 恒 100）。
export function guiQuery(cap: int): int {
    return guiCap(cap);
}

/// 剪贴板能力 id（engine/window CAP_CLIPBOARD 镜像）。
export const CAP_CLIPBOARD: int = 5;

/// 动画毫秒（v0.1.4 反馈 #8；engine/window CAP_* 镜像——原 #7 帧钟计数语义
/// 升版）：**真窗＝单调真实毫秒（deltaTime 语义——鼠标事件风暴不改变相位
/// 速率）；脚本/重放＝虚拟毫秒 32/帧（帧号事件锁定，相位＝帧号纯函数，
/// golden 可锚）**。渲染路径直接读墙钟禁止（剪贴板 I/O 边界同款语义）。
export const CAP_ANIM_MS: int = 6;

/// 文件对话框能力 id（engine/window CAP_* 镜像；G5 第二部分）：真窗会话里能弹原生文件对话框为 1，否则 0。
export const CAP_FILE_DIALOG: int = 7;

/// frameless/几何/效果扩展创建（flags 位集——gui/app appNew 装配；
/// 旧 windowOpen 五参调用方零变化）。0＝创建失败（含无窗口系统目标）。
export const WFLAG_FRAMELESS: int = 1;
export const WFLAG_MAXIMIZED: int = 2;
export const WFLAG_TOPMOST: int = 4;
export const WFLAG_CENTERED: int = 8;

export function windowOpenEx(title: string, w: int, h: int, flags: int): int {
    return winCreate(title, w, h, flags);
}

/// 相对移动（frameless 标题拖拽的引擎面；dx/dy 为像素增量——真窗语义，
/// 脚本通道 no-op）。
export function windowMove(hwnd: int, dx: int, dy: int): int {
    return winMove(hwnd, dx, dy);
}

export function windowMinimize(hwnd: int): int {
    return winMinimize(hwnd);
}

/// 最大化/还原切换。
export function windowMaximizeToggle(hwnd: int): int {
    return winMaximizeToggle(hwnd);
}

/// 客户区尺寸调整（frameless 边缘 resize 的引擎面；DIP 入参）。
export function windowClientResize(hwnd: int, w: int, h: int): int {
    return winClientResize(hwnd, w, h);
}

/// min/max 客户区约束（拖拽与程序化同守——WM_GETMINMAXINFO 先于重排）。
export function windowSetMinMax(hwnd: int, min_w: int, min_h: int, max_w: int, max_h: int): int {
    return winSetMinMax(hwnd, min_w, min_h, max_w, max_h);
}

export function windowSetTopmost(hwnd: int, on: bool): int {
    return winSetTopmost(hwnd, on);
}

/// 效果三档挂载（返回实际生效档——DWM 能力探测降级链的引擎裁决面）。
export function windowSetEffect(hwnd: int, effect: int): int {
    return winSetEffect(hwnd, effect);
}

/// DPI 缩放查询（x100；headless 恒 100——确定性锚）。
export function windowScale(hwnd: int): int {
    return winScale(hwnd);
}

/// 菜单挂载（逐项追加；id＝菜单项事件 target——真窗 WM_COMMAND→事件；
/// 脚本通道注入 kind 3 target=id 同构可达）。
export function windowMenuAdd(hwnd: int, id: int, label: string): int {
    return winMenuAdd(hwnd, id, label);
}

/// 客户区光标设置（v0.1.4 反馈 #10——输入框 I-beam 等；kind∈CURSOR_*；
/// 脚本通道 no-op）。pump 鼠标移动按 textCursor 声明驱动。
export function windowSetCursor(hwnd: int, kind: int): int {
    return winSetCursor(hwnd, kind);
}

/// 光标种类（真窗后端的 CURSOR_* 约定）。
export const CURSOR_ARROW: int = 0;
export const CURSOR_TEXT: int = 1;

/// 剪贴板文本写入（扩面位——引擎绑定；全局 OS 状态＝I/O
/// 边界）。给了重放脚本时走进程内模拟板（text-edit 的 ctrl+C/V 往返靠它）。
/// 返回 0＝成功；-1＝不支持（无窗口系统目标）/失败。
export function clipboardSetText(text: string): int {
    return clipSet(text);
}

/// 剪贴板文本读取（非文本/无窗口系统＝空串）。
export function clipboardGetText(): string {
    return clipGet();
}

// —— image-BMP（内审修正：引擎侧绑定——引擎读二进制并绘制；
//     S1 string 为 UTF-8 文本域，二进制不经 string 通道）——

/// 加载 BMP（24/32bpp 非压缩；失败 0）。PNG 登记后续（解码库评估）。
export function imageLoad(path: string): int {
    return imgLoad(path);
}

export function imageW(h: int): int {
    return imgW(h);
}

export function imageH(h: int): int {
    return imgH(h);
}

export function imageFree(h: int): void {
    imgFree(h);
}

/// 位块绘制（引擎侧边界裁剪；越界部分不绘——确定性）。
export function surfaceDrawImage(surface: int, img: int, x: int, y: int): int {
    return imgDraw(surface, img, x, y);
}

// —— RGBA surface（透明窗 alpha=0 清底——RGB 三输出面不变）——
// G0 起 alpha 伴随面暂不保留（无头下不可观测，示例与测试也未使用）：与普通面相同；
// 真窗逐像素透明合成随对应平台后端再接。

export function surfaceNewRgba(w: int, h: int): int {
    return surfNew(w, h);
}

/// alpha 清底（effect=transparent 形态：alpha=0 清底＋真窗逐像素合成；RGB 面与
/// 普通 clear 恒等）。
export function surfaceClearRgba(handle: int, color: int, alpha: int): void {
    alpha;
    surfaceClear(handle, color);
}

// —— 帧级 DPI（臂①）——

/// DIP→物理像素（x100 比例 k；四舍五入，与旧引擎 platform.gui.dipToPx 同式
/// ——单一换算式的框架镜像；k=100 恒等）。DIP 布局模型下 surface 物理尺寸
/// 与 Canvas k 因子的共用换算点。
export function dipToPxK(v: int, k: int): int {
    if (k == 100) {
        return v;
    }
    return (v * k + 50) / 100;
}

/// 按比例开面（surfaceOpen 的 DIP 形态）：物理尺寸＝DIP×k——帧级 DPI 的
/// surface 装配点（app.k 由 windowScale 装配；回放态恒脚本 scale 声明值，
/// golden 确定性锚）。k=100 时与 surfaceOpen 逐字节等价。
export function surfaceOpenDip(w: int, h: int, k: int): int | Error {
    if (w <= 0 || h <= 0) {
        return err("surfaceOpenDip: 尺寸须为正");
    }
    return surfaceOpen(dipToPxK(w, k), dipToPxK(h, k));
}

// —— 文件对话框（臂③ G5 第二部分改结构化过滤器、增保存）——

/// 文件对话框的过滤器：名称与扩展名表。扩展名不带点、不带通配（"png"），单独的 "*" 表示所有文件；不合规的扩展名
///（空、以点开头、含 * ? [ ] / \ ; 、空白或 NUL）跳过，扩展名全被跳过的过滤器整个跳过，不 trap。匹配不分大小写；名称为空时
/// 显示扩展名模式。macOS 的面板不显示名称，所有扩展名合成一组。
export struct FileFilter {
    name: string,
    exts: []string,
}

/// 打开文件对话框（hwnd＝属主窗口，0＝无属主；title 空＝系统缺省标题；filters 空＝不过滤）。真窗会话里弹原生模态选择器
///（Windows comdlg32；macOS、Linux 见 G5 第二部分后续步），能不能弹看 guiQuery(CAP_FILE_DIALOG)；重放/无头态取脚本指令行
/// `dialog <路径>` 的结果队列（**回放禁真 OS 弹窗**——结构性不触）。选中得路径，取消/失败/不能弹得空串（调用方以空串分诊取消）。
/// 例：`dialogOpenFile(app.hwnd, "打开", [{ name: "图片", exts: ["png", "jpg"] }, { name: "所有文件", exts: ["*"] }])`。
export function dialogOpenFile(hwnd: int, title: string, filters: []FileFilter): string {
    return dialogOpen(hwnd, title, fdFrom(filters));
}

/// 保存文件对话框：参数同 dialogOpenFile，defaultName 是预填的建议文件名（空＝不预填）。文件已存在时的覆盖确认交给系统；
/// 用户没写扩展名时 Windows、macOS 由系统按过滤器补上，Linux 门户原样返回（同 GTK、Chromium、Firefox：事后补会绕过覆盖确认）；
/// 重放态与打开共用 `dialog` 队列。选中得路径，取消/失败/不能弹得空串。
export function dialogSaveFile(hwnd: int, title: string, filters: []FileFilter, defaultName: string): string {
    return dialogSave(hwnd, title, fdFrom(filters), defaultName);
}

function fdFrom(filters: []FileFilter): List<FdFilter> {
    const out: List<FdFilter> = listNew();
    for (f in filters) {
        fdAdd(out, f.name, f.exts);
    }
    return out;
}

/// alpha 混合填充（臂⑤）：src-over 整数混合
///（a=255 与 surfaceFillRect 逐字节恒等；纯函数——golden 三伴可锚）。
export function surfaceFillRectA(handle: int, x: int, y: int, w: int, h: int, color: int, alpha: int): void {
    if (surfOk(handle)) {
        rFillRectA(surfAt(handle), x, y, w, h, color, alpha);
    }
}

/// 窗口级均匀透明（0=全透明..255=不透明）：真窗＝WS_EX_LAYERED＋
/// LWA_ALPHA；脚本/无头通道 no-op（真窗 I/O 面——特效不入 golden 纪律
/// 同款）。per-pixel UpdateLayeredWindow 合成登记后续（边界）。
export function windowSetOpacity(hwnd: int, opacity: int): int {
    return winSetOpacity(hwnd, opacity);
}
