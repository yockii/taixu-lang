// 文件读写内建的语义（readFile／writeFile／readFileBytes／writeFileBytes，伴文件 .toolchain 只为 tempDir；
// Windows 的可移植内核换用 rtfn 写的原语，这里各目标同一份期望）：写后读回、空文件、多字节内容、覆盖写截断旧内容、全部 256 个
// 字节值往返、跨多个读块的大文件；读不存在的文件、写到不存在的目录得 no such file。
// Error 文案为 "{状态}: 路径"，只打印状态，免得临时目录的路径进入期望输出。临时文件建在 tempDir 下，结束时删掉。

function sep(): string {
    if (hostTarget() == "windows") { return "\\"; }
    return "/";
}

function status(msg: string): string {
    const at = strIndexOf(msg, ": ");
    if (at < 0) { return msg; }
    return strSub(msg, 0, at);
}

function put(label: string, path: string, text: string): bool {
    writeFile(path, text) catch (e) {
        print(label + " write -> " + status(e.message));
        return false;
    };
    return true;
}

function check(label: string, path: string, want: string): void {
    const got = readFile(path) catch (e) {
        print(label + " -> " + status(e.message));
        return;
    };
    if (got != want) {
        print(label + " -> mismatch " + toStr(len(got)));
        return;
    }
    print(label + " -> ok " + toStr(len(got)));
}

export function main(args: []string): int {
    const dir = tempDir();
    const a = dir + sep() + "taixu-file-io-a.tmp";
    const empty = dir + sep() + "taixu-file-io-空.tmp";
    const zh = dir + sep() + "taixu-file-io-中文.tmp";
    const raw = dir + sep() + "taixu-file-io-bytes.tmp";
    const big = dir + sep() + "taixu-file-io-big.tmp";
    if (put("roundtrip", a, "abc")) { check("roundtrip", a, "abc"); }
    if (put("empty", empty, "")) { check("empty", empty, ""); }
    if (put("chinese", zh, "中文内容\n")) { check("chinese", zh, "中文内容\n"); }
    if (put("truncate", a, "a longer first content") && put("truncate", a, "x")) { check("truncate", a, "x"); }
    const b = bytesNew(256);
    let i = 0;
    while (i < 256) {
        bytesSet(b, i, i);
        i = i + 1;
    }
    writeFileBytes(raw, b) catch (e) { print("bytes write -> " + status(e.message)); };
    const back = readFileBytes(raw) catch (e) {
        print("bytes -> " + status(e.message));
        return 0;
    };
    let same = bytesLen(back) == 256;
    i = 0;
    while (same && i < 256) {
        if ((bytesGet(back, i) catch -1) != i) { same = false; }
        i = i + 1;
    }
    if (same) { print("bytes -> ok 256"); } else { print("bytes -> mismatch " + toStr(bytesLen(back))); }
    let text = "";
    i = 0;
    while (i < 4096) {
        text = text + "0123456789abcdef0123456789abcdef0123456789abcdef\n";
        i = i + 1;
    }
    if (put("big", big, text)) { check("big", big, text); }
    check("missing", dir + sep() + "taixu-file-io-none.tmp", "");
    const nodir = dir + sep() + "taixu-file-io-no-such-dir" + sep() + "x.tmp";
    writeFile(nodir, "x") catch (e) { print("missing dir write -> " + status(e.message)); };
    removeFile(a) catch (e) { print("remove failed: " + e.message); };
    removeFile(empty) catch (e) { print("remove failed: " + e.message); };
    removeFile(zh) catch (e) { print("remove failed: " + e.message); };
    removeFile(raw) catch (e) { print("remove failed: " + e.message); };
    removeFile(big) catch (e) { print("remove failed: " + e.message); };
    return 0;
}
