export function socketAddress(ip: Bytes, port: int, family6: int, darwin: bool): Bytes | Error {
    return socketAddressScoped(ip, port, family6, darwin, 0);
}
export function socketAddressScoped(ip: Bytes, port: int, family6: int, darwin: bool, scope: int): Bytes | Error {
    const n = bytesLen(ip);
    if ((n != 4 && n != 16) || port < 0 || port > 65535 || scope < 0 || scope > 4294967295 || (n == 4 && scope != 0)) { return err("socket: invalid address, scope or port"); }
    let length = 16; let family = 2; let offset = 4;
    if (n == 16) { length = 28; family = family6; offset = 8; }
    const address = bytesNew(length);
    if (darwin) { bytesSet(address, 0, length); bytesSet(address, 1, family); }
    else { bytesSetLE<u16>(address, 0, family as u16); }
    bytesSet(address, 2, port / 256); bytesSet(address, 3, port % 256); bytesCopy(address, offset, ip, 0, n);
    if (n == 16) { bytesSetLE<u32>(address, 24, scope as u32); } return address;
}
