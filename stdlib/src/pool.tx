// ============================================================================
// std/pool —— Pool：分道执行池（库层）。D3 v0.53 起对结果类型泛型（同 std/task）。
//
// **纯 .tx 库对象**；**优先级＝道（lane）**——池构造时定道数，提交时指道；
// **无任务级抢占**（确定性/可测试性/AI 可静态推理的定档兑现）。
// 隐式合理默认＝单道（poolDefault）；显式逃生舱＝构造面 laneCount 显式指道数。
//
// **着色面注意（S1 函数类型无 async 位——D3 v0.8 §8）**：spawn 发生在用户侧
// 的 async 调用表达式（`mul(1)`／async 箭头调用——调用即 spawn 惰性入队），
// 本模块收其 Future 入指定道。经普通 fn 类型形参转发调用会擦除着色（同步
// 执行、内含 await 即结构化 trap），故 API 以 Future 直收。
//
// 执行纪律：drain 按**道序 0..laneCount-1 轮转**逐道收割，道内 FIFO（同道
// 严格串行——道＝串行化域；跨道经 await 解耦，轮转序确定）。道内任务体级
// err / 取消槽位跳过并入 failed 计数（poolFailed 查询）。
//
// 表示：jobs（Future 平铺）＋laneOf（槽位→道）＋done（收割旗标）三平行
// List——嵌套 List 的 catch 默认值无元素类型推断上下文，平铺面让收割路
// 全部走 in-bounds listGet ＋ int/bool 可推断默认值。
// ============================================================================

export struct Pool<T> {
    laneCount: int, // 道数（构造面下限归一 1）
    jobs: List<Future<T>>, // 槽位→任务 Future（提交序）
    laneOf: List<int>, // 槽位→道号
    done: List<bool>, // 槽位→收割旗标
    failed: int,
}

// 建池：lanes 道数（下限归一 1——显式逃生舱面；默认用 poolDefault 单道）。结果类型须写出：poolNew<int>(2)。
export function poolNew<T>(lanes: int): Ref<Pool<T>> {
    let n: int = lanes;
    if (n < 1) { n = 1; }
    return new Pool<T> {
        laneCount: n,
        jobs: listNew(),
        laneOf: listNew(),
        done: listNew(),
        failed: 0,
    };
}

// 默认池（隐式合理默认＝单道）。
export function poolDefault<T>(): Ref<Pool<T>> {
    return poolNew<T>(1);
}

// 入道：future 入指定道队尾（任务已在用户侧 spawn）；lane 越界归入道 0
//（结构化纪律：指道错误不静默丢失任务）。返回池内全局槽位下标。
export function poolSubmit<T>(p: Ref<Pool<T>>, lane: int, fut: Future<T>): int {
    let l: int = lane;
    if (l < 0 || l >= p.laneCount) { l = 0; }
    listPush(p.jobs, fut);
    listPush(p.laneOf, l);
    listPush(p.done, false);
    return listLen(p.jobs) - 1;
}

// 轮转收割（async——调用处得 Future<List<T>>）：按道序 0..laneCount-1 逐
// 道收割，道内按提交序 FIFO 严格串行；返回成功槽结果按（道序×道内序）确
// 定性排列。
export async function poolDrain<T>(p: Ref<Pool<T>>): List<T> {
    const results: List<T> = listNew();
    let lane: int = 0;
    while (lane < p.laneCount) {
        let scan: int = 0;
        while (scan < listLen(p.laneOf)) {
            const owner: int = listTryGet(p.laneOf, scan) catch -1;
            const isDone: bool = listTryGet(p.done, scan) catch true;
            if (owner == lane && !isDone) {
                const fut = (listTryGet(p.jobs, scan) catch err("pool: 槽位索引越界（不可达）"))?;
                listSet(p.done, scan, true);
                const v = await fut catch (e) {
                    p.failed = p.failed + 1; // 体级 err/取消 → 计数跳过
                    scan = scan + 1;
                    continue;
                };
                listPush(results, v);
            }
            scan = scan + 1;
        }
        lane = lane + 1;
    }
    return results;
}

// 失败/取消槽位计数（drain 后查询）。
export function poolFailed<T>(p: Ref<Pool<T>>): int {
    return p.failed;
}

// 道数查询（构造面回读）。
export function poolLanes<T>(p: Ref<Pool<T>>): int {
    return p.laneCount;
}
