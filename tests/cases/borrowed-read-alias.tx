// Returned-container field/list reads must retain and snapshot before release.
struct BorrowLeaf { value: int, }
struct BorrowBox { text: string, leaf: Ref<BorrowLeaf>, }
function borrowBox(): Ref<BorrowBox> {
    return new BorrowBox { text: "字段😀", leaf: new BorrowLeaf { value: 42 } };
}
function borrowList(): List<string> {
    const values: List<string> = listNew();
    listPush(values, "元素😀");
    return values;
}
function main(args: []string): int {
    const text = borrowBox().text;
    if (text != "字段😀") { return 1; }
    if (borrowBox().leaf.value != 42) { return 2; }
    const item = listGet(borrowList(), 0) catch "";
    if (item != "元素😀") { return 3; }
    const values = borrowList(); let i = 0;
    while (i < 17) {
        if ((listGet(values, 0) catch "") != "元素😀") { return 4; }
        i = i + 1;
    }
    const missing: List<string> = listNew();
    if ((listGet(missing, 0) catch "missing") != "missing") { return 5; }
    print("PASS borrowed-read");
    return 0;
}
