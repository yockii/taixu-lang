// Test-only Value span kernel with allocator/RC controls.
import { asBufferNew, asBufferSubmit, asStructuredBegin, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { payloadCloneEmit } from "./selfhost/payload_clone";
import { payloadSpanEmit } from "./selfhost/payload_span";
import { listBackingEmit } from "./selfhost/list_backing";
import { listCompactEmit } from "./selfhost/list_compact";
import { elfWriteObject, elfObjectOk, elfObjectBytes, elfObjectError } from "./selfhost/emit_elf_object";
import { coffCaptureAssembler, coffWrite, coffResultOk, coffResultBytes, coffResultError } from "./selfhost/emit_coff_storage";
import { targetParseName, tElf } from "./selfhost/target";
function main(args: []string): int {
    if (len(args) != 3 || args[0] != "--target") { return 64; }
    const t = targetParseName(args[1]);
    if (t < 0) { return 64; }
    const buf = asBufferNew(); listBackingEmit(buf, t); listCompactEmit(buf, t); payloadSpanEmit(buf); payloadCloneEmit(buf);
    asStructuredBegin(); asBufferSubmit(buf);
    if (asFailedAs() != 0) { eprint(asLastErrAs()); return 66; }
    const exports: List<string> = listNew();
    listPush(exports, "__tx_native_values_alloc_v1");
    listPush(exports, "__tx_native_values_init_v1");
    listPush(exports, "__tx_native_values_read_v1");
    listPush(exports, "__tx_native_values_free_v1");
    listPush(exports, "__tx_native_value_replace_v1");
    listPush(exports, "__tx_native_payload_dispose_v1");
    listPush(exports, "__tx_native_clone_v1");
    if (tElf(t)) {
        const result = elfWriteObject(exports);
        if (elfObjectOk(result) != 1) { eprint(elfObjectError(result)); return 67; }
        writeFileBytes(args[2], elfObjectBytes(result)) catch (e) { eprint(e.message); return 68; };
    } else {
        const result = coffWrite(coffCaptureAssembler(), exports);
        if (coffResultOk(result) != 1) { eprint(coffResultError(result)); return 67; }
        writeFileBytes(args[2], coffResultBytes(result)) catch (e) { eprint(e.message); return 68; };
    }
    return 0;
}
