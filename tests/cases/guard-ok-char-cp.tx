// D3 v0.52 §6.14：字符字面量可为任一单个字符，值为其码点（与字符串 for-in 产出同一单位）；转义集不变；
// 取定宽类型时按码点的真值查范围。
export function main(args: []string): int {
    print(toStr('太') + " " + toStr('😀') + " " + toStr('é') + " " + toStr('a') + " " + toStr('\n'));
    let hits = 0;
    for (c in "太虚") {
        if (c == '太' || c == '虚') { hits = hits + 1; }
    }
    const big: int = '😀';
    const small: u8 = 'é';
    const mid: u16 = '太';
    print(toStr(hits) + " " + toStr(big - 128512) + " " + toStr(small as int) + " " + toStr(mid as int));
    print(utf8Encode('虚') catch "?");
    return 0;
}
