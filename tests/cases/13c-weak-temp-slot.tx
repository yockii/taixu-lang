// M6 借用回归：内建调用的实参临时槽在调用后仍持有对象，直到该槽被覆写或
// 函数退出（D6 帧窗口拥有制）。NRT 借用优化曾在调用后立即清空该槽，使
// 第一段输出 DEAD；期望与 VM 一致为 A。其余几段覆盖用户函数调用借用、
// 返回参数本身、字段读取作内建实参的死亡时点。
struct Node { name: string }
struct Holder { child: Ref<Node> }
function touch(n: Ref<Node>): int { return len(n.name); }
function keep(n: Ref<Node>): Ref<Node> { return n; }
export function main(args: []string): int {
    let t = new Node { name: "A" };
    const b = new Node { name: "B" };
    const w0 = weak(t);
    t = b;
    print((deref(w0) catch Node { name: "DEAD" }).name);
    let a = new Node { name: "A" };
    const w = weak(a);
    const k = touch(a);
    a = b;
    print((deref(w) catch Node { name: "DEAD" }).name);
    let c = new Node { name: "C" };
    const w2 = weak(c);
    const kept = keep(c);
    c = b;
    print((deref(w2) catch Node { name: "DEAD" }).name);
    print(kept.name);
    const h = new Holder { child: new Node { name: "H" } };
    const w3 = weak(h.child);
    h.child = b;
    print((deref(w3) catch Node { name: "DEAD" }).name);
    let d = new Node { name: "D" };
    const w4 = weak(d);
    print(toStr(len(d.name)));
    d = b;
    print((deref(w4) catch Node { name: "DEAD" }).name);
    print(toStr(k));
    return 0;
}
