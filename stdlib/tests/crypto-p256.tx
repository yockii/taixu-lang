import { p256PublicKey, p256Ecdh } from "std/crypto/p256";
import { p256Hex, p256Prime, p256Zero } from "std/crypto/p256_field";
import { p256Base, p256Multiply } from "std/crypto/p256_point";
import { constantTimeEqual } from "std/crypto/subtle";
import { ecdsaP256Sha256Verify } from "std/crypto/ecdsa_p256";

test "P-256：RFC 5903 公钥与共享坐标" {
    const initiator = p256Hex("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433");
    const responder = p256Hex("c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53");
    const ip = p256Hex("04dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c37725811805271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3");
    const rp = p256Hex("04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf6356fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab");
    const shared = p256Hex("d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de");
    assert(constantTimeEqual(p256PublicKey(initiator) catch panic("initiator public"), ip), "initiator public");
    assert(constantTimeEqual(p256PublicKey(responder) catch panic("responder public"), rp), "responder public");
    assert(constantTimeEqual(p256Ecdh(initiator, rp) catch panic("initiator shared"), shared), "initiator shared");
    assert(constantTimeEqual(p256Ecdh(responder, ip) catch panic("responder shared"), shared), "responder shared");
    assert(constantTimeEqual(initiator, p256Hex("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433")), "secret unchanged");
}

function privateFails(secret: Bytes): bool { p256PublicKey(secret) catch (e) { return true; }; return false; }
function peerFails(secret: Bytes, peer: Bytes): bool { p256Ecdh(secret, peer) catch (e) { return true; }; return false; }

test "P-256：标量边界、无穷点与非法公钥" {
    const one = bytesNew(32); bytesSet(one, 31, 1);
    const base = p256PublicKey(one) catch panic("base public");
    assert(constantTimeEqual(base, p256Hex("046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5")), "scalar one");
    const order = p256Hex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551");
    assert(privateFails(bytesNew(0)) && privateFails(bytesNew(31)) && privateFails(bytesNew(32)) && privateFails(order), "invalid secret");
    const f = p256Prime(); assert(p256Zero(p256Multiply(f, p256Base(f), order).z) == 1, "n * G is infinity");
    assert(peerFails(one, bytesNew(0)) && peerFails(one, bytesNew(33)) && peerFails(one, bytesNew(65)), "invalid encodings");
    const offCurve = bytesSlice(base, 0, 65); bytesSet(offCurve, 64, (bytesGet(offCurve, 64) catch 0) ^ 1);
    assert(peerFails(one, offCurve), "off curve");
    const noncanonical = bytesSlice(base, 0, 65);
    bytesCopy(noncanonical, 1, p256Hex("ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"), 0, 32);
    assert(peerFails(one, noncanonical), "coordinate equals p");
}

test "ECDSA-P256：RFC 6979 SHA-256 与严格 DER" {
    const publicKey = p256Hex("0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb67903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299");
    const signature = p256Hex("3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8");
    assert(ecdsaP256Sha256Verify(publicKey, bytesFromStr("sample"), signature) catch panic("RFC ECDSA"), "RFC signature");
    assert(!(ecdsaP256Sha256Verify(publicKey, bytesFromStr("Sample"), signature) catch panic("bad message")), "message changed");
    for (text in ["", "3006020100020101", "30060201ff020101", "300702020001020101", "3006020101020100", "30060201010201ff", "300602010102010100",
            "308106020101020101", "30050201010200", "3006020101030101", "3006020101020201"]) {
        assert(!(ecdsaP256Sha256Verify(publicKey, bytesFromStr("sample"), p256Hex(text)) catch panic("invalid signature encoding")), "DER " + text);
    }
    const changed = bytesSlice(signature, 0, bytesLen(signature)); bytesSet(changed, 71, (bytesGet(changed, 71) catch 0) ^ 1);
    assert(!(ecdsaP256Sha256Verify(publicKey, bytesFromStr("sample"), changed) catch panic("changed signature")), "signature bit changed");
}

test "P-256：OpenSSL ECDH 与 ECDSA 固定交叉向量" {
    const fixture = readFile("tests/vectors/crypto-p256.txt") catch panic("curve fixtures"); let dh = 0; let signatures = 0;
    for (line in strSplit(fixture, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const p = strSplit(line, " "); const kind = listGet(p, 0);
        if (kind == "ecdh") {
            const secret = p256Hex(listGet(p, 1)); const publicKey = p256Hex(listGet(p, 2)); const peer = p256Hex(listGet(p, 3));
            const original = bytesSlice(peer, 0, bytesLen(peer)); const privateCopy = bytesSlice(secret, 0, 32);
            assert(constantTimeEqual(p256PublicKey(secret) catch panic("public key"), publicKey), "public " + toStr(dh));
            assert(constantTimeEqual(p256Ecdh(secret, peer) catch panic("exchange"), p256Hex(listGet(p, 4))), "exchange " + toStr(dh));
            assert(constantTimeEqual(peer, original) && constantTimeEqual(secret, privateCopy), "inputs unchanged"); dh = dh + 1;
        } else {
            assert(kind == "ecdsa", "fixture kind"); const publicKey = p256Hex(listGet(p, 2));
            let message = bytesNew(0); if (listGet(p, 3) != "-") { message = p256Hex(listGet(p, 3)); }
            const signature = p256Hex(listGet(p, 4)); const original = bytesSlice(signature, 0, bytesLen(signature));
            assert((ecdsaP256Sha256Verify(publicKey, message, signature) catch panic("verify")) == (listGet(p, 1) == "1"), "signature " + toStr(signatures));
            assert(constantTimeEqual(signature, original), "signature unchanged"); signatures = signatures + 1;
        }
    }
    assert(dh == 8 && signatures == 12, "all differential vectors");
}
