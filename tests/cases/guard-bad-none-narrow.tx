// D3 v0.50 §6.3-8：只收窄 const 局部与参数——let 绑定、字段不收窄；收窄只在区域内（if 之外、所在块结束之后不再是 T）。
struct Box {
    v: int?,
}

function letNo(): int {
    let y: int? = 5;
    if (y != None) {
        const z: int = y;
        return z;
    }
    return 0;
}

function fieldNo(b: Box): int {
    if (b.v != None) {
        return b.v + 1;
    }
    return 0;
}

function outside(x: int?): string {
    if (x != None) {
        print("有");
    }
    return x;
}

function blockEnds(x: int?, c: bool): bool {
    if (c) {
        if (x == None) { return false; }
        print(toStr(x + 1));
    }
    return x;
}

function main(args: []string): void {
    print(toStr(letNo()));
}
