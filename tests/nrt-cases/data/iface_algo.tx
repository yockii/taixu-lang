// iface-modules 用例：带约束的泛型算法（不导入任何具体类型）。
export interface Hashable {
    hash(): int;
}

export interface Named {
    name(): string;
}

export function hashAll<T extends Hashable>(xs: List< T>): int {
    let h: int = 0;
    for (x in xs) {
        h = h + x.hash();
    }
    return h;
}

export function names(xs: List< Named>): string {
    let acc: string = "";
    for (x in xs) {
        acc = acc + x.name() + ";";
    }
    return acc;
}
