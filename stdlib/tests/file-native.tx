// ============================================================================
// stdlib 用例：std/file 流式文件读写（核心仓容量批 C4e）。只由原生编译器运行（verify ⑧；Bytes 与
// threadSpawn 仅原生）：写、追加、分块读到文件尾、定位、坏句柄与错误路径、跨线程使用句柄、多块往返。
// 运行：taixu test tests/file-native.tx（原生编译器）
// ============================================================================

import { fileOpen, fileRead, fileWrite, fileSeek, fileClose, FILE_READ, FILE_WRITE, FILE_APPEND, SEEK_START, SEEK_CURRENT, SEEK_END } from "std/file";
import { fsRemove, fsMkdirs } from "std/fs";
import { getenv, setenv } from "std/os";
import { parseInt } from "std/strconv";

const TMP: string = "taixu-file.tmp";

function text(b: Bytes): string {
    return bytesToStr(b) catch "<非法 UTF-8>";
}

function writeAll(path: string, mode: int, s: string): void {
    const f = fileOpen(path, mode) catch panic("打开失败：" + path);
    fileWrite(f, bytesFromStr(s)) catch panic("写失败");
    fileClose(f);
}

// 以下几个函数返回操作的错误文本，成功得 ""。
function openErr(path: string, mode: int): string {
    const f = fileOpen(path, mode) catch (e) {
        return e.message;
    };
    fileClose(f);
    return "";
}

function readErr(f: int, n: int): string {
    const b = fileRead(f, n) catch (e) {
        return e.message;
    };
    return "";
}

function seekErr(f: int, offset: int, whence: int): string {
    const p = fileSeek(f, offset, whence) catch (e) {
        return e.message;
    };
    return "";
}

function writeErr(f: int, data: Bytes): string {
    fileWrite(f, data) catch (e) {
        return e.message;
    };
    return "";
}

test "file：写、追加、分块读到文件尾" {
    writeAll(TMP, FILE_WRITE, "hello ");
    writeAll(TMP, FILE_APPEND, "world");
    const f = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert(text(fileRead(f, 4) catch bytesNew(0)) == "hell", "先读 4 字节");
    assert(text(fileRead(f, 100) catch bytesNew(0)) == "o world", "再读得剩余部分");
    const tail = fileRead(f, 100) catch bytesFromStr("x");
    assert(bytesLen(tail) == 0, "文件尾得空 Bytes");
    fileClose(f);
    writeAll(TMP, FILE_WRITE, "new");
    const g = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert(text(fileRead(g, 100) catch bytesNew(0)) == "new", "FILE_WRITE 截断原内容");
    fileClose(g);
    fsRemove(TMP) catch panic("删除失败");
}

test "file：定位" {
    writeAll(TMP, FILE_WRITE, "0123456789");
    const f = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert((fileSeek(f, -3, SEEK_END) catch -1) == 7, "末尾回退 3 得 7");
    assert(text(fileRead(f, 100) catch bytesNew(0)) == "789", "从 7 读到尾");
    assert((fileSeek(f, 2, SEEK_START) catch -1) == 2, "起点加 2");
    assert((fileSeek(f, 3, SEEK_CURRENT) catch -1) == 5, "当前加 3");
    assert(text(fileRead(f, 2) catch bytesNew(0)) == "56", "从 5 读 2 字节");
    assert(seekErr(f, -1, SEEK_START) == "file: seek failed", "定位到负位置为 Error");
    assert(seekErr(f, 0, 3) == "file: bad seek whence: 3", "基准不是 0–2 为 Error");
    fileClose(f);
    const w = fileOpen(TMP, FILE_WRITE) catch panic("只写打开失败");
    fileSeek(w, 4, SEEK_START) catch panic("越过文件尾定位失败");
    fileWrite(w, bytesFromStr("x")) catch panic("写失败");
    fileClose(w);
    const r = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    const b = fileRead(r, 100) catch bytesNew(0);
    assert(bytesLen(b) == 5 && (bytesGet(b, 0) catch -1) == 0 && (bytesGet(b, 4) catch -1) == 120, "越过文件尾写入，中间补零");
    fileClose(r);
    fsRemove(TMP) catch panic("删除失败");
}

test "file：坏句柄与错误路径" {
    assert(openErr("taixu-file-missing.tmp", FILE_READ) == "file: open failed: taixu-file-missing.tmp", "不存在的文件只读打开为 Error");
    fsMkdirs("taixu-file-dir.tmp") catch panic("建目录失败");
    assert(openErr("taixu-file-dir.tmp", FILE_READ) == "file: open failed: taixu-file-dir.tmp", "目录不能打开");
    fsRemove("taixu-file-dir.tmp") catch panic("删除目录失败");
    assert(openErr(TMP, 3) == "file: bad open mode: 3", "打开方式不是 0–2 为 Error");
    writeAll(TMP, FILE_WRITE, "abc");
    const f = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert(readErr(f, 0) == "file: read size must be positive", "读 0 字节为 Error");
    assert(writeErr(f, bytesFromStr("x")) == "file: write failed", "只读句柄写为 Error");
    fileClose(f);
    assert(readErr(f, 10) == "file: bad handle", "关闭后的句柄读为 Error");
    assert(writeErr(f, bytesNew(0)) == "file: bad handle", "关闭后的句柄写空数据也为 Error");
    assert(seekErr(f, 0, SEEK_START) == "file: bad handle", "关闭后的句柄定位为 Error");
    fileClose(f);
    const g = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert(g != f, "槽位复用时新句柄与旧句柄不同");
    assert(readErr(f, 10) == "file: bad handle", "旧句柄不会碰到新打开的文件");
    fileClose(g);
    const w = fileOpen(TMP, FILE_WRITE) catch panic("只写打开失败");
    assert(readErr(w, 10) == "file: read failed", "只写句柄读为 Error");
    fileClose(w);
    fsRemove(TMP) catch panic("删除失败");
}

// 模块全局变量每线程一份：句柄经进程级的环境变量交给线程。
function readInThread(): int {
    const f = parseInt(getenv("TX_FILE_NATIVE_H")) catch -1;
    const b = fileRead(f, 100) catch bytesNew(0);
    if (text(b) != "from main") {
        return 1;
    }
    return 0;
}

test "file：句柄是进程级的（跨线程可用）" {
    writeAll(TMP, FILE_WRITE, "from main");
    const f = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    setenv("TX_FILE_NATIVE_H", toStr(f)) catch panic("setenv 失败");
    const t = threadSpawn(readInThread);
    assert((threadJoin(t) catch -1) == 0, "线程用 main 打开的句柄读到内容");
    fileClose(f);
    fsRemove(TMP) catch panic("删除失败");
}

test "file：多块往返（3 MiB 写出，按 100000 字节读回）" {
    const block = bytesNew(65536);
    let i: int = 0;
    while (i < 65536) {
        bytesSet(block, i, (i * 7 + 3) % 256);
        i = i + 1;
    }
    const w = fileOpen(TMP, FILE_WRITE) catch panic("只写打开失败");
    let k: int = 0;
    while (k < 48) {
        fileWrite(w, block) catch panic("写失败");
        k = k + 1;
    }
    fileClose(w);
    const r = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    let total: int = 0;
    let ok: bool = true;
    while (true) {
        const b = fileRead(r, 100000) catch bytesNew(0);
        const n = bytesLen(b);
        if (n == 0) {
            break;
        }
        let j: int = 0;
        while (j < n) {
            const want = ((total + j) % 65536 * 7 + 3) % 256;
            if ((bytesGet(b, j) catch -1) != want) {
                ok = false;
            }
            j = j + 1;
        }
        total = total + n;
    }
    fileClose(r);
    assert(total == 48 * 65536, "读回总字节数");
    assert(ok, "逐字节一致");
    const a = fileOpen(TMP, FILE_APPEND) catch panic("追加打开失败");
    fileSeek(a, 0, SEEK_START) catch panic("定位失败");
    fileWrite(a, bytesFromStr("end")) catch panic("追加写失败");
    fileClose(a);
    const r2 = fileOpen(TMP, FILE_READ) catch panic("只读打开失败");
    assert((fileSeek(r2, -3, SEEK_END) catch -1) == 48 * 65536, "追加写落在末尾（即使先定位到起点）");
    assert(text(fileRead(r2, 10) catch bytesNew(0)) == "end", "末尾是追加的内容");
    fileClose(r2);
    fsRemove(TMP) catch panic("删除失败");
}
