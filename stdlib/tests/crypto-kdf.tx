// 已知答案：RFC 4231 §4（HMAC-SHA-256）与 RFC 5869 附录 A.1–A.3（HKDF-SHA-256）。
import { hmacSha256 } from "std/crypto/hmac";
import { hkdfExtractSha256, hkdfExpandSha256, hkdfSha256 } from "std/crypto/hkdf";
import { constantTimeEqual } from "std/crypto/subtle";
import { sha256SumHex } from "std/hash";
import { parseInt } from "std/strconv";

function hex(s: string): Bytes {
    if (s == "-") { return bytesNew(0); }
    const out = bytesNew(len(s) / 2);
    let i = 0;
    while (i < bytesLen(out)) {
        const a = strFind("0123456789abcdef", strSlice(s, i * 2, i * 2 + 1));
        const b = strFind("0123456789abcdef", strSlice(s, i * 2 + 1, i * 2 + 2));
        assert(a >= 0 && b >= 0, "hex fixture");
        bytesSet(out, i, a * 16 + b);
        i = i + 1;
    }
    return out;
}

test "crypto：独立实现交叉向量含 HKDF 最大计数器" {
    const text = readFile("tests/vectors/crypto-kdf.txt") catch panic("read crypto vectors");
    let count = 0;
    for (line in strSplit(text, "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const parts = strSplit(line, " ");
        const kind = listGet(parts, 0);
        const key = hex(listGet(parts, 1));
        const data = hex(listGet(parts, 2));
        if (kind == "hmac") {
            assert(constantTimeEqual(hmacSha256(key, data), hex(listGet(parts, 3))), "HMAC cross-check " + toStr(count));
        } else {
            assert(kind == "hkdf", "known vector type");
            const n = parseInt(listGet(parts, 3)) catch panic("vector length");
            const got = hkdfExpandSha256(key, data, n) catch panic("vector expand");
            assert(bytesLen(got) == n && sha256SumHex(got) == listGet(parts, 4), "HKDF cross-check " + toStr(count));
        }
        count = count + 1;
    }
    assert(count == 56, "all independent vectors executed");
}

function filled(n: int, value: int): Bytes {
    const out = bytesNew(n);
    let i = 0;
    while (i < n) { bytesSet(out, i, value); i = i + 1; }
    return out;
}

function sequence(n: int, first: int): Bytes {
    const out = bytesNew(n);
    let i = 0;
    while (i < n) { bytesSet(out, i, first + i); i = i + 1; }
    return out;
}

function hmacCase(key: Bytes, data: Bytes, want: string): void {
    const got = hmacSha256(key, data);
    assert(constantTimeEqual(bytesSlice(got, 0, len(want) / 2), hex(want)), "HMAC known answer");
}

test "crypto：RFC 4231 HMAC SHA-256 七项" {
    hmacCase(filled(20, 11), bytesFromStr("Hi There"), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7");
    hmacCase(bytesFromStr("Jefe"), bytesFromStr("what do ya want for nothing?"), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
    hmacCase(filled(20, 170), filled(50, 221), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe");
    hmacCase(sequence(25, 1), filled(50, 205), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b");
    hmacCase(filled(20, 12), bytesFromStr("Test With Truncation"), "a3b6167473100ee06e0c796c2955552b");
    hmacCase(filled(131, 170), bytesFromStr("Test Using Larger Than Block-Size Key - Hash Key First"), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54");
    hmacCase(filled(131, 170), bytesFromStr("This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm."),
        "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2");
}

function hkdfCase(salt: Bytes, ikm: Bytes, info: Bytes, length: int, prk: string, okm: string): void {
    const extracted = hkdfExtractSha256(salt, ikm);
    assert(constantTimeEqual(extracted, hex(prk)), "HKDF extract known answer");
    const expanded = hkdfExpandSha256(extracted, info, length) catch panic("expand");
    assert(constantTimeEqual(expanded, hex(okm)), "HKDF expand known answer");
    const both = hkdfSha256(salt, ikm, info, length) catch panic("combined");
    assert(constantTimeEqual(expanded, both), "combined interface");
}

test "crypto：RFC 5869 SHA-256 三项" {
    hkdfCase(sequence(13, 0), filled(22, 11), sequence(10, 240), 42,
        "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5",
        "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865");
    hkdfCase(sequence(80, 96), sequence(80, 0), sequence(80, 176), 82,
        "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244",
        "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87");
    hkdfCase(bytesNew(0), filled(22, 11), bytesNew(0), 42,
        "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
        "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8");
}

function rejected(key: Bytes, length: int): bool {
    hkdfExpandSha256(key, bytesNew(0), length) catch (e) { return true; };
    return false;
}

test "crypto：HKDF 上限和比较的差异位置" {
    assert(rejected(bytesNew(31), 16), "short PRK");
    assert(rejected(bytesNew(32), -1), "negative length");
    assert(rejected(bytesNew(32), 8161), "counter overflow rejected");
    const empty = hkdfExpandSha256(bytesNew(32), bytesNew(0), 0) catch panic("empty");
    assert(bytesLen(empty) == 0, "zero length");
    const a = sequence(32, 0);
    assert(constantTimeEqual(a, a), "equal");
    assert(!constantTimeEqual(a, bytesNew(31)), "unequal lengths");
    assert(constantTimeEqual(bytesNew(0), bytesNew(0)), "empty equal");
    for (i in [0, 16, 31]) {
        const b = bytesSlice(a, 0, 32);
        bytesSet(b, i, 255);
        assert(!constantTimeEqual(a, b), "difference position " + toStr(i));
    }
    assert((bytesGet(a, 0) catch -1) == 0 && (bytesGet(a, 31) catch -1) == 31, "inputs unchanged");
}
