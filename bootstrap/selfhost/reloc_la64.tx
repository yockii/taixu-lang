// 龙芯的 RELA 语义（LoongArch ELF psABI，目标分层 X3a 从 link_objects.tx 拆出）：sa = S+A，site = P。指令的
// 操作码位保留，只改立即数位；范围与对齐不合即拒绝（不截断）。PCALA_HI20 的“页”固定 4 KiB（与系统页长无关），加 0x800 抵消 LO12
// 在 addi.d／读写里的符号扩展。施加函数返回空串为成功，否则为拒绝的原因（由 link_objects.tx 记下）。
import { relocPatch, relocWord32 } from "./reloc_bits";

/// 重定位改写的字节数：R_LARCH_64（2）为 8，其余 4（1 号也按 8 算，同拆分之前；它在施加时被拒）。
export function la64RelocWidth(kind: int): int {
    if (kind == 1 || kind == 2) { return 8; }
    return 4;
}

/// 重定位的目标恰是符号本身：加数为 0。
export function la64RelocExact(kind: int, addend: int): bool { return addend == 0; }

export function la64Relocate(out: Bytes, fileAt: int, site: int, kind: int, sa: int, absSites: List<int>): string {
    if (kind == 2) {
        relocPatch(out, fileAt, sa, 8);
        listPush(absSites, site);
        return "";
    }
    if (kind == 99) {
        const v = wrapSub(sa, site);
        if (v < -2147483648 || v > 2147483647) { return "RelativeRelocationOutOfRange"; }
        relocPatch(out, fileAt, v, 4);
        return "";
    }
    const insn = relocWord32(out, fileAt);
    if (kind == 66) {
        const v = wrapSub(sa, site);
        if (v % 4 != 0 || v < -134217728 || v > 134217724) { return "BranchRelocationOutOfRange"; }
        const w = (v / 4) & 67108863;
        relocPatch(out, fileAt, (insn & 4227858432) | ((w & 65535) << 10) | (w >>> 16), 4);
        return "";
    }
    if (kind == 71) {
        const pages = wrapSub(wrapAdd(sa, 2048) & -4096, site & -4096) / 4096;
        if (pages < -524288 || pages > 524287) { return "PageRelocationOutOfRange"; }
        relocPatch(out, fileAt, (insn & ~(1048575 << 5)) | ((pages & 1048575) << 5), 4);
        return "";
    }
    if (kind == 72) {
        relocPatch(out, fileAt, (insn & ~(4095 << 10)) | ((sa & 4095) << 10), 4);
        return "";
    }
    return "UnsupportedRelocation:" + toStr(kind);
}
