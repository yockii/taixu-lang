// O4 第二步 2c：紧凑列表——List<i8..u32/f32> 按元素宽度 1/2/4 字节存放（设计 §三-4），读出扩成 int/float。
// 期望值由 scripts/fixtures/fw2-oracle.py 用 Python 列表模拟、numpy.float32 格式化，不由被测实现生成。

struct Pix {
    w: int,
    data: List< u16>,
}

function rev<T>(xs: List< T>): List< T> {
    const out: List< T> = listNew();
    for (x in xs) {
        listInsert(out, 0, x);
    }
    return out;
}

function sumU32(xs: List< u32>): int {
    let s = 0;
    for (x in xs) {
        s = s + x;
    }
    return s;
}

function list_i8(): void {
    const xs: List< i8> = listNew();
    const p0: i8 = -128;
    listPush(xs, p0);
    const p1: i8 = 127;
    listPush(xs, p1);
    const p2: i8 = -69;
    listPush(xs, p2);
    const p3: i8 = -100;
    listPush(xs, p3);
    const p4: i8 = 3;
    listPush(xs, p4);
    const p5: i8 = -33;
    listPush(xs, p5);
    const p6: i8 = -103;
    listPush(xs, p6);
    const p7: i8 = 127;
    listPush(xs, p7);
    const p8: i8 = -72;
    listPush(xs, p8);
    const p9: i8 = -128;
    listPush(xs, p9);
    const p10: i8 = -15;
    listPush(xs, p10);
    const p11: i8 = -20;
    listPush(xs, p11);
    const p12: i8 = -96;
    listPush(xs, p12);
    const p13: i8 = -79;
    listPush(xs, p13);
    const p14: i8 = 120;
    listPush(xs, p14);
    const p15: i8 = -128;
    listPush(xs, p15);
    const p16: i8 = -128;
    listPush(xs, p16);
    const p17: i8 = -128;
    listPush(xs, p17);
    const p18: i8 = 127;
    listPush(xs, p18);
    const p19: i8 = -128;
    listPush(xs, p19);
    let linepush = "i8 push " + toStr(listLen(xs));
    for (x in xs) {
        linepush = linepush + " " + toStr(x);
    }
    print(linepush);
    const s0: i8 = -107;
    const s1: i8 = -112;
    listSet(xs, 3, s0);
    listSet(xs, 19, s1);
    const zero: i8 = 0;
    print("i8 get " + toStr(listGet(xs, 3) catch zero) + " " + toStr(listGet(xs, 19) catch zero) + " " + toStr(listGet(xs, 20) catch zero) + " " + toStr(listGet(xs, -1) catch zero));
    print("i8 pop " + toStr(listPop(xs) catch zero));
    const n0: i8 = -79;
    const n1: i8 = -88;
    const n2: i8 = 107;
    listInsert(xs, 0, n0);
    listInsert(xs, 5, n1);
    listInsert(xs, listLen(xs), n2);
    let lineins = "i8 ins " + toStr(listLen(xs));
    for (x in xs) {
        lineins = lineins + " " + toStr(x);
    }
    print(lineins);
    listRemoveAt(xs, 0);
    listRemoveAt(xs, 7);
    listRemoveAt(xs, listLen(xs) - 1);
    let linerm = "i8 rm " + toStr(listLen(xs));
    for (x in xs) {
        linerm = linerm + " " + toStr(x);
    }
    print(linerm);
}

