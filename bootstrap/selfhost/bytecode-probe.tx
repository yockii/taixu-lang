// bytecode-probe.tx —— bytecode.tx 批 B 探针（V0.50-S5-①；roundtrip 锚驱动）。
// 用法：taixu run bootstrap/selfhost/bytecode-probe.tx <file.txc> [...]
// 对每个 .txc：decode→encode 逐字节比对——0＝恒等（打印 OK <字节数>）；
// 非 0＝首差异偏移/拒绝（打印 FAIL <码> <lastError>）。任一 FAIL 即退出 1。
import { roundtripCheck, lastError } from "./bytecode";

function main(args: []string): int {
    if (len(args) < 1) {
        eprint("用法: bytecode-probe <file.txc> ...");
        return 64;
    }
    let bad = 0;
    let i = 0;
    while (i < len(args)) {
        const path = args[i];
        const data: string = readFile(path) catch "";
        if (len(data) == 0) {
            print("FAIL " + path + " 读入为空");
            bad = bad + 1;
            i = i + 1;
            continue;
        }
        const r = roundtripCheck(data);
        if (r == 0) {
            print("OK " + path + " " + toStr(len(data)) + "B");
        } else {
            print("FAIL " + path + " code=" + toStr(r) + " err=" + lastError());
            bad = bad + 1;
        }
        i = i + 1;
    }
    if (bad > 0) {
        return 1;
    }
    return 0;
}
