// mcp_scratch_os_linux.tx 用的系统调用（x86_64 的号）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux 与 _linux_aarch64
// 两个文件（导出面相同）；种子换代后改成 from syscall "名字" 合成一份。
declare function sysMkdirat(fd: i32, path: string, mode: u32): i32 from syscall 258;
declare function sysUnlinkat(fd: i32, path: string, flags: i32): i32 from syscall 263;
declare function sysOpenat(fd: i32, path: string, flags: i32, mode: u32): i32 from syscall 257;
declare function sysClose(fd: i32): i32 from syscall 3;
// WRONLY|CREAT|EXCL|NOFOLLOW|CLOEXEC（O_NOFOLLOW 0x20000）。
export const CLAIM_FLAGS: i32 = 655553;

export function mkdirat(fd: i32, path: string, mode: u32): i32 { return sysMkdirat(fd, path, mode); }
export function unlinkat(fd: i32, path: string, flags: i32): i32 { return sysUnlinkat(fd, path, flags); }
export function openat(fd: i32, path: string, flags: i32, mode: u32): i32 { return sysOpenat(fd, path, flags, mode); }
export function close(fd: i32): i32 { return sysClose(fd); }
