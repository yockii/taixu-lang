// 第 5 轮 FFI 前端（D3 v0.23）：按目标选择文件、declare type 句柄、declare struct 外部结构体
// （嵌套、定长数组、句柄字段）、带 from 的外部函数声明（库与 syscall、string/wstr、Bytes、
// Ref<外部结构体>、回调）。本文件的外部函数只声明不调用（不检查目标、不生成调用桩与导入）；
// 按目标的调用在 data/ffi_sys_<目标>.tx 的不执行分支里，实际调用见 ffi-win-call、ffi-linux-syscall。
import { which, selfId } from "./data/ffi_sys";
import { HWND, POINT, window } from "./data/ffi_types";

declare type FILE;
declare struct RECT { left: i32, top: i32, right: i32, bottom: i32 }
declare struct FRAME { r: RECT, tag: u8, owner: HWND, pad: [3]u16, scale: f32 }
declare function GetWindowRect(h: HWND, r: Ref< RECT>): i32 from "user32";
declare function lstrlenW(s: wstr): i32 from "kernel32";
declare function fopen(path: string, mode: string): FILE? from "msvcrt";
declare function fread(buf: Bytes, size: usize, n: usize, f: FILE): usize from "msvcrt";
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "msvcrt";
declare function write(fd: i32, buf: Bytes, n: usize): isize from syscall 1;

function byFirst(a: usize, b: usize): i32 {
    return 0;
}

function area(r: RECT): int {
    return (r.right as int - r.left as int) * (r.bottom as int - r.top as int);
}

function main(args: []string): int {
    print(which() + " " + toStr(selfId(false)));
    const w = window(42);
    const w2: HWND = handleFromBits < HWND > (42);
    const w3 = window(43);
    print(toStr(handleBits(w)) + " " + toStr(w == w2) + " " + toStr(w == w3) + " " + toStr(w != w3));
    const ws: List< HWND> = listNew();
    listPush(ws, w);
    listPush(ws, w3);
    print(toStr(listLen(ws)) + " " + toStr(handleBits(listGet(ws, 1) catch w)));
    let maybe: HWND? = None;
    print(toStr(maybe == None));
    maybe = w2;
    print(toStr(handleBits(maybe catch w3)));
    const r = RECT { left: 10, top: 20, right: 40, bottom: 60 };
    print(toStr(area(r)));
    const f = FRAME { r: r, tag: 255, owner: w, pad: [1, 2, 3], scale: 0.5 };
    print(toStr(f.r.bottom) + " " + toStr(f.tag) + " " + toStr(handleBits(f.owner)) + " " + toStr(f.pad[2]) + " " + toStr(f.scale as float));
    const p = POINT { x: -3, y: 4 };
    print(toStr(p.x) + "," + toStr(p.y));
    if (len(args) > 100) {
        const rr = new RECT { left: 0, top: 0, right: 0, bottom: 0 };
        print(toStr(rr.left) + toStr(selfId(true)));
    }
    return 0;
}
