// 批次规划与真实子进程协议回归。伪 worker 只验证编排，不作为任何宿主门或产品的通过证据。
import { absolute, join, mkdirs, readBytes } from "./build_lib";
import { RECEIPT, BatchSpec, bit, choose, checkReceipt, crossTargets, field, nativeSteps, parseSpec, shareKey, stringArray, txt } from "./gate_batch_model";
import { runBatch } from "./gate_batch_run";
import { STEP_NAMES } from "./gate_steps";
import { Jv, jArray, jDump, jGet, jInt, jLen, jNull, jNumber, jObject, jParseUnique, jPush, jSet, jString } from "./test_json";
import { capture, check, summary, tallyNew } from "./test_lib";
import { sha256Hex } from "../bootstrap/selfhost/sha256";

function strings(xs: []string): List<string> { const out: List<string> = listNew(); for (x in xs) { listPush(out, x); } return out; }
function repeat(s: string, n: int): string { let out = ""; let i = 0; while (i < n) { out = out + s; i = i + 1; } return out; }
function source(which: string): Ref<Jv> {
    const v = jObject(); jSet(v, "core_tree", jString(repeat(which, 40))); jSet(v, "stdlib_tree", jString(repeat("a", 40)));
    jSet(v, "gui_tree", jString(repeat("b", 40))); jSet(v, "kernels_sha256", jString(repeat("c", 64))); return v;
}
function host(id: string, target: string, mode: string, work: string, after: string): Ref<Jv> {
    const v = jObject(); jSet(v, "id", jString(id)); jSet(v, "target", jString(target));
    jSet(v, "resource", jString(choose(id == "mac", "mac", "local"))); jSet(v, "exe", jString(selfExePath()));
    jSet(v, "cwd", jString(work)); jSet(v, "work", jString(join(work, "host-" + id)));
    jSet(v, "args", stringArray(strings(["--fake", id, mode, work, after]))); return v;
}
function config(work: string, mode: string): Ref<Jv> {
    const v = jObject(); jSet(v, "schema", jString("gate-batch/1")); jSet(v, "mode", jString("development"));
    jSet(v, "deduplicate_cross_products", jParseUnique(bytesFromStr("true")) catch jNull());
    jSet(v, "steps", stringArray(strings(["json", "cross-products"])));
    const hosts = jArray(); jPush(hosts, host("win", "x86_64-windows", mode, work, ""));
    jPush(hosts, host("linux", "x86_64-linux", mode, work, "win")); jPush(hosts, host("mac", "aarch64-macos", mode, work, ""));
    jSet(v, "hosts", hosts); return v;
}
function valid(v: Ref<Jv>): bool { parseSpec(v) catch (e) { return false; }; return true; }
function jsonValid(s: string): bool { jParseUnique(bytesFromStr(s)) catch (e) { return false; }; return true; }
test "独立 JSON 判据保留嵌套和重名拒绝" {
    assert(jsonValid(repeat("[", 512) + "0" + repeat("]", 512)), "depth 512 accepted");
    assert(!jsonValid(repeat("[", 513) + "0" + repeat("]", 513)), "depth 513 rejected");
    assert(!jsonValid("{\"a\":1,\"a\":2}"), "duplicate keys rejected");
}
function receiptValid(v: Ref<Jv>, phase: string, proof: bool): bool {
    const spec = parseSpec(config("test", "normal")) catch panic("fixture");
    const h = listGet(spec.hosts, 0) catch panic("host");
    checkReceipt(v, h, phase, "unit-run", strings(["json"]), 0, proof) catch (e) { return false; };
    return true;
}
function nativeFixture(): Ref<Jv> {
    const v = jObject(); jSet(v, "schema", jString("gate-batch-receipt/1")); jSet(v, "status", jString("PASS"));
    jSet(v, "host", jString("x86_64-windows")); jSet(v, "phase", jString("native")); jSet(v, "run_id", jString("unit-run"));
    jSet(v, "requested", stringArray(strings(["json"]))); const input = source("a"); jSet(v, "input", input);
    jSet(v, "input_id", jString(sha256Hex(bytesFromStr(jDump(input))))); jSet(v, "compiler_sha256", jString(repeat("1", 64)));
    jSet(v, "witness_sha256", jString(repeat("e", 64)));
    const gate = jObject(); jSet(gate, "status", jString("PASS")); jSet(gate, "compiler_sha256", field(v, "compiler_sha256"));
    const checks = jArray(); const row = jObject(); jSet(row, "name", jString("json")); jSet(row, "exit", jNumber(0));
    jPush(checks, row); jSet(gate, "checks", checks); jSet(v, "gate_report", gate); return v;
}

test "收据绑定实际运行和完整步骤证据" {
    const v = nativeFixture(); assert(receiptValid(v, "native", true), "valid fixture");
    jSet(v, "run_id", jString("old")); assert(!receiptValid(v, "native", true), "stale rejected"); jSet(v, "run_id", jString("unit-run"));
    jSet(v, "host", jString("x86_64-linux")); assert(!receiptValid(v, "native", true), "wrong host rejected"); jSet(v, "host", jString("x86_64-windows"));
    jSet(v, "input_id", jString(repeat("f", 64))); assert(!receiptValid(v, "native", true), "forged input digest rejected");
    jSet(v, "input_id", jString(sha256Hex(bytesFromStr(jDump(field(v, "input"))))));
    jSet(v, "witness_sha256", jString("")); assert(!receiptValid(v, "native", true), "missing witness rejected");
    assert(receiptValid(v, "native", false), "unshared native does not require witness");
    jSet(field(v, "gate_report"), "checks", jArray()); assert(!receiptValid(v, "native", false), "no executed checks rejected");
}

test "里程碑必须三端完整且不能去重" {
    const v = config("test", "normal");
    jSet(v, "mode", jString("milestone")); assert(!valid(v), "selected milestone rejected");
    jSet(v, "steps", jArray()); assert(!valid(v), "dedup milestone rejected");
    jSet(v, "deduplicate_cross_products", jParseUnique(bytesFromStr("false")) catch jNull()); assert(valid(v), "three full hosts accepted");
    const hosts = jArray(); jPush(hosts, host("win", "x86_64-windows", "normal", "test", "")); jSet(v, "hosts", hosts);
    assert(!valid(v), "one host is not a milestone");
}
test "开发步骤和宿主元数据严格检查" {
    const v = config("test", "normal"); assert(valid(v), "valid development");
    jSet(v, "steps", stringArray(strings(["json"]))); assert(!valid(v), "dedup without cross rejected");
    jSet(v, "steps", stringArray(strings(["json", "json", "cross-products"]))); assert(!valid(v), "duplicate steps rejected");
    jSet(v, "steps", stringArray(strings(["typo", "cross-products"]))); assert(!valid(v), "unknown step rejected");
    jSet(v, "steps", stringArray(strings(["cross-products"])));
    const h = host("../bad", "x86_64-windows", "normal", "test", ""); const hs = jArray(); jPush(hs, h); jSet(v, "hosts", hs);
    assert(!valid(v), "unsafe id rejected");
}
test "共享八目标覆盖每个消费者的七个目标" {
    const shared = crossTargets("x86_64-windows", true); assert(listLen(shared) == 8, "includes owner host");
    for (host in ["x86_64-windows", "x86_64-linux", "aarch64-macos"]) {
        const needed = crossTargets(host, false); assert(listLen(needed) == 7, "seven cross targets");
        for (target in needed) { let present = false; for (x in shared) { if (target == x) { present = true; } } assert(present, "coverage hole"); }
    }
}

function fake(args: []string): int {
    const id = args[1]; const mode = args[2]; const dir = args[3]; const after = args[4];
    if (mode == "binary-log") { const junk = bytesNew(3); bytesSet(junk, 0, 255); bytesSet(junk, 2, 10); stdoutWrite(junk); }
    const opts: Map<string, string> = mapNew(); let i = 5;
    while (i + 1 < len(args)) { mapSet(opts, args[i], args[i + 1]); i = i + 2; }
    const phase = mapGet(opts, "--phase") ?? ""; const target = mapGet(opts, "--host") ?? ""; const run = mapGet(opts, "--run-id") ?? "";
    if (phase == "native" && len(after) > 0 && entryKind(join(dir, after + ".done")) != 1) { return 94; }
    if (mode == "missing" && id == "win") { return 0; }
    const v = jObject(); jSet(v, "schema", jString("gate-batch-receipt/1")); jSet(v, "status", jString("PASS"));
    jSet(v, "host", jString(target)); jSet(v, "phase", jString(phase)); jSet(v, "run_id", jString(run));
    if (mode == "stale" && id == "win") { jSet(v, "run_id", jString("old-run")); }
    const req = mapGet(opts, "--steps") ?? "none"; const requested: List<string> = listNew();
    if (req != "none") { for (x in strSplit(req, ",")) { listPush(requested, x); } }
    jSet(v, "requested", stringArray(requested));
    const input = source(choose((mode == "different-input" || mode == "milestone-different-input") && id == "linux", "d", "a")); jSet(v, "input", input);
    jSet(v, "input_id", jString(sha256Hex(bytesFromStr(jDump(input)))));
    const compiler = repeat(choose(id == "win", "1", choose(id == "linux", "2", "3")), 64);
    jSet(v, "compiler_sha256", jString(compiler));
    jSet(v, "witness_sha256", jString(repeat(choose(mode == "different-witness" && id == "mac", "f", "e"), 64)));
    if (mode == "missing-witness") { jSet(v, "witness_sha256", jString("")); }
    if (phase == "native" || phase == "full") {
        const gate = jObject(); jSet(gate, "status", jString("PASS")); jSet(gate, "scope", jString(choose(phase == "full", "full-host", "selected-host")));
        jSet(gate, "compiler_sha256", jString(compiler)); const checks = jArray();
        let names = requested;
        if (phase == "full") { names = strSplit(STEP_NAMES, " "); }
        for (name in names) { const c = jObject(); jSet(c, "name", jString(name)); jSet(c, "exit", jNumber(0)); jPush(checks, c); }
        jSet(gate, "checks", checks); jSet(v, "gate_report", gate);
        writeFile(join(dir, id + ".done"), "done") catch panic("marker");
    } else {
        if (mode == "fallback" && id == "win") { jSet(v, "status", jString("FAIL")); print(RECEIPT + jDump(v)); return 17; }
        const report = jObject(); jSet(report, "schema", jString("cross-products/1")); jSet(report, "status", jString("PASS"));
        jSet(report, "host_target", jString(target)); jSet(report, "include_host", jNumber(bit(phase == "shared-cross")));
        jSet(report, "compiler_sha256", jString(compiler)); const targets = jArray();
        for (tg in crossTargets(target, phase == "shared-cross" && mode != "partial")) {
            const row = jObject(); jSet(row, "target", jString(tg)); jSet(row, "exit", jNumber(0));
            jSet(row, "case_count", jNumber(440)); jSet(row, "report_sha256", jString(repeat("c", 64))); jPush(targets, row);
            const counts = jObject(); jSet(counts, "BUILT", jNumber(440)); jSet(row, "counts", counts);
        }
        jSet(report, "targets", targets); jSet(v, "cross_report", report);
        if (mode == "compiler-changed") { const changed = jString(repeat("4", 64)); jSet(v, "compiler_sha256", changed); jSet(report, "compiler_sha256", changed); }
    }
    print(RECEIPT + jDump(v)); return 0;
}

function readJson(path: string): Ref<Jv> { return jParseUnique(readBytes(path) catch bytesNew(0)) catch jNull(); }
function phases(report: Ref<Jv>, phase: string): int { let n = 0; for (a in field(report, "attempts").items) { if (txt(a, "phase") == phase) { n = n + 1; } } return n; }
function integration(args: []string): int | Error {
    let work = ""; let compiler = ""; let i = 0;
    while (i < len(args)) {
        if (i + 1 >= len(args)) { return err("missing value"); }
        if (args[i] == "--work") { work = absolute(args[i + 1]); }
        else if (args[i] == "--compiler") { compiler = absolute(args[i + 1]); }
        else { return err("unknown option"); }
        i = i + 2;
    }
    if (len(work) == 0 || len(compiler) == 0 || !mkdirs(work)) { return err("需要 --compiler 和新的 --work 目录"); }
    const tally = tallyNew();
    const root = currentDir() catch ".";
    const units = capture(compiler, strings(["test", "--toolchain", join(root, "scripts/test_gate_batch.tx")]), root, 120000000000, 1048576)?;
    if (!check(tally, "model units", units.code == 0, units.out + units.err)) { return summary(tally, "gate-batch-simulated-workers"); }
    for (mode in ["normal", "fallback", "different-input", "different-witness", "missing", "stale", "milestone", "milestone-different-input", "partial", "compiler-changed", "missing-witness", "binary-log"]) {
        const dir = join(work, mode); if (entryKind(dir) != 0 || !mkdirs(dir)) { return err("test directory exists"); }
        const cfg = config(dir, mode);
        if (mode == "milestone" || mode == "milestone-different-input") { jSet(cfg, "mode", jString("milestone")); jSet(cfg, "steps", jArray()); jSet(cfg, "deduplicate_cross_products", jParseUnique(bytesFromStr("false")) catch jNull()); }
        const spec = parseSpec(cfg)?;
        const code = runBatch(spec, dir, "simulation-" + mode, 3);
        const report = readJson(join(dir, "report.json"));
        if (mode == "normal") { check(tally, "shared owner covers all hosts", code == 0 && phases(report, "native") == 3 && phases(report, "shared-cross") == 1, jDump(report)); }
        if (mode == "fallback") { check(tally, "fallback retains original failure", code == 1 && phases(report, "shared-cross") == 2 && txt(field(field(report, "cross_coverage"), "mac"), "provider") == "linux", jDump(report)); }
        if (mode == "different-input" || mode == "different-witness") { check(tally, mode + " partitions", code == 0 && phases(report, "shared-cross") == 1 && phases(report, "cross") == 1, jDump(report)); }
        if (mode == "missing" || mode == "stale") { check(tally, mode + " fails closed", code == 1 && txt(report, "status") == "FAIL", jDump(report)); }
        if (mode == "milestone") { check(tally, "milestone executes full on three hosts", code == 0 && phases(report, "full") == 3 && phases(report, "shared-cross") == 0 && phases(report, "native") == 0, jDump(report)); }
        if (mode == "milestone-different-input") { check(tally, "milestone rejects hosts on different inputs", code == 1 && phases(report, "full") == 3 && txt(report, "status") == "FAIL", jDump(report)); }
        if (mode == "partial" || mode == "compiler-changed") { check(tally, mode + " cannot claim coverage", code == 1 && phases(report, "shared-cross") == 3
                && jLen(field(field(field(report, "cross_coverage"), "mac"), "targets")) == 0, jDump(report)); }
        if (mode == "missing-witness") { check(tally, "missing witness never shared", code == 1 && phases(report, "shared-cross") == 0, jDump(report)); }
        if (mode == "binary-log") { check(tally, "binary transport diagnostics preserve receipt", code == 0 && phases(report, "shared-cross") == 1, jDump(report)); }
    }
    return summary(tally, "gate-batch-simulated-workers");
}
export function main(args: []string): int {
    if (len(args) > 0 && args[0] == "--fake") { return fake(args); }
    return integration(args) catch (e) { eprint(e.message); return 1; };
}
