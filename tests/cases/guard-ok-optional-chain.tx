// D3 v0.50 §6.3-9：可选链 a?.b——a 为 None 时整条链得 None、链体不求值（TS 式短路：a?.b.c 的 .c 也不求值）；结果为 U?
// （字段本身是 U? 的不再套一层）；链式 a?.b?.c；方法糖 a?.m()；结果为 void 的 a?.m(); 是条件调用；可与 ?? 连用。
struct Addr {
    city: string,
    zip: int?,
}

struct User {
    name: string,
    addr: Ref<Addr>?,
    tags: List<string>,
}

function userTitle(u: Ref<User>): string {
    print("求值 title");
    return "【" + u.name + "】";
}

function maybeName(u: Ref<User>?): string {
    return u?.name ?? "<无名>";
}

function cityOf(u: Ref<User>?): string? {
    return u?.addr?.city;
}

function zipOf(u: Ref<User>?): int {
    return u?.addr?.zip ?? -1;
}

function tagCount(u: Ref<User>?): int {
    return u?.tags.len() ?? 0;
}

function titleOf(u: Ref<User>?): string? {
    return u?.title();
}

function counter(u: Ref<User>?): int {
    let calls = 0;
    const t = u?.tags;
    if (t == None) { calls += 1; }
    return calls;
}

function main(args: []string): void {
    const tags: List<string> = listNew();
    listPush(tags, "x");
    listPush(tags, "y");
    const u = new User { name: "李四", addr: new Addr { city: "杭州", zip: 310000 }, tags: tags };
    const v = new User { name: "王五", addr: None, tags: listNew() };
    print(maybeName(u) + " " + maybeName(None));
    print((cityOf(u) ?? "-") + " " + (cityOf(v) ?? "-") + " " + (cityOf(None) ?? "-"));
    print(toStr(zipOf(u)) + " " + toStr(zipOf(v)) + " " + toStr(zipOf(None)));
    print(toStr(tagCount(u)) + " " + toStr(tagCount(None)));
    print((titleOf(u) ?? "-") + " " + (titleOf(None) ?? "-"));
    print(toStr(counter(u)) + " " + toStr(counter(None)));
    const w: Ref<User>? = u;
    w?.tags.push("z");
    const nobody: Ref<User>? = None;
    nobody?.tags.push("不会执行");
    print(toStr(listLen(tags)));
}
