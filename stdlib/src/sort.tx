// ============================================================================
// std/sort —— 三族稳定排序（V0.37-M1；STD-05——单态先行；v0.38 泛型化时
// 单态族保留别名或按关口决策，不静默破坏调用面）。纯 .tx 归并排序：
// 稳定 O(n·log n)；确定性（比较仅用 <，等值保序）。string 字典序＝逐字节
// （string 关系运算不在 S1——byteAt 手写比较面）。
// ============================================================================

// —— 归并骨架（int 族）——

function mergeInt(a: List<int>, lo: int, mid: int, hi: int, buf: List<int>): void {
    let i: int = lo;
    let j: int = mid;
    let k: int = lo;
    while (i < mid && j < hi) {
        const x: int = listGet(a, i) catch 0;
        const y: int = listGet(a, j) catch 0;
        // 稳定性：<= 取左（等值保序）
        if (x <= y) {
            listSet(buf, k, x);
            i = i + 1;
        } else {
            listSet(buf, k, y);
            j = j + 1;
        }
        k = k + 1;
    }
    while (i < mid) {
        listSet(buf, k, listGet(a, i) catch 0);
        i = i + 1;
        k = k + 1;
    }
    while (j < hi) {
        listSet(buf, k, listGet(a, j) catch 0);
        j = j + 1;
        k = k + 1;
    }
    let t: int = lo;
    while (t < hi) {
        listSet(a, t, listGet(buf, t) catch 0);
        t = t + 1;
    }
}

function sortIntRange(a: List<int>, lo: int, hi: int, buf: List<int>): void {
    if (hi - lo < 2) {
        return;
    }
    const mid: int = lo + (hi - lo) / 2;
    sortIntRange(a, lo, mid, buf);
    sortIntRange(a, mid, hi, buf);
    mergeInt(a, lo, mid, hi, buf);
}

export function sortInt(xs: List<int>): List<int> {
    const n: int = listLen(xs);
    const buf: List<int> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(buf, 0);
        i = i + 1;
    }
    sortIntRange(xs, 0, n, buf);
    return xs;
}

// —— float 族 ——

function mergeFloat(a: List<float>, lo: int, mid: int, hi: int, buf: List<float>): void {
    let i: int = lo;
    let j: int = mid;
    let k: int = lo;
    while (i < mid && j < hi) {
        const x: float = listGet(a, i) catch 0.0;
        const y: float = listGet(a, j) catch 0.0;
        if (x <= y) {
            listSet(buf, k, x);
            i = i + 1;
        } else {
            listSet(buf, k, y);
            j = j + 1;
        }
        k = k + 1;
    }
    while (i < mid) {
        listSet(buf, k, listGet(a, i) catch 0.0);
        i = i + 1;
        k = k + 1;
    }
    while (j < hi) {
        listSet(buf, k, listGet(a, j) catch 0.0);
        j = j + 1;
        k = k + 1;
    }
    let t: int = lo;
    while (t < hi) {
        listSet(a, t, listGet(buf, t) catch 0.0);
        t = t + 1;
    }
}

function sortFloatRange(a: List<float>, lo: int, hi: int, buf: List<float>): void {
    if (hi - lo < 2) {
        return;
    }
    const mid: int = lo + (hi - lo) / 2;
    sortFloatRange(a, lo, mid, buf);
    sortFloatRange(a, mid, hi, buf);
    mergeFloat(a, lo, mid, hi, buf);
}

export function sortFloat(xs: List<float>): List<float> {
    const n: int = listLen(xs);
    const buf: List<float> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(buf, 0.0);
        i = i + 1;
    }
    sortFloatRange(xs, 0, n, buf);
    return xs;
}

// —— string 族（字典序＝逐字节；string 关系运算不在 S1——手写比较面）——

function strLt(a: string, b: string): bool {
    const n: int = len(a);
    const m: int = len(b);
    let lim: int = n;
    if (m < lim) {
        lim = m;
    }
    let i: int = 0;
    while (i < lim) {
        const ca: int = byteAt(a, i) catch -1;
        const cb: int = byteAt(b, i) catch -2;
        if (ca != cb) {
            return ca < cb;
        }
        i = i + 1;
    }
    return n < m;
}

function mergeStr(a: List<string>, lo: int, mid: int, hi: int, buf: List<string>): void {
    let i: int = lo;
    let j: int = mid;
    let k: int = lo;
    while (i < mid && j < hi) {
        const x: string = listGet(a, i) catch "";
        const y: string = listGet(a, j) catch "";
        if (!strLt(y, x)) {
            listSet(buf, k, x);
            i = i + 1;
        } else {
            listSet(buf, k, y);
            j = j + 1;
        }
        k = k + 1;
    }
    while (i < mid) {
        listSet(buf, k, listGet(a, i) catch "");
        i = i + 1;
        k = k + 1;
    }
    while (j < hi) {
        listSet(buf, k, listGet(a, j) catch "");
        j = j + 1;
        k = k + 1;
    }
    let t: int = lo;
    while (t < hi) {
        listSet(a, t, listGet(buf, t) catch "");
        t = t + 1;
    }
}

function sortStrRange(a: List<string>, lo: int, hi: int, buf: List<string>): void {
    if (hi - lo < 2) {
        return;
    }
    const mid: int = lo + (hi - lo) / 2;
    sortStrRange(a, lo, mid, buf);
    sortStrRange(a, mid, hi, buf);
    mergeStr(a, lo, mid, hi, buf);
}

export function sortString(xs: List<string>): List<string> {
    const n: int = listLen(xs);
    const buf: List<string> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(buf, "");
        i = i + 1;
    }
    sortStrRange(xs, 0, n, buf);
    return xs;
}
