// Public ECDSA P-384 verification; strict DER, no signing or key exchange.
import { derRead, derChildren, derPositiveInteger } from "./der";
import { p384Prime, p384Order, p384OrderBytes, p384Less, p384Decode, p384Encode, p384Mul, p384Inverse } from "./p384_field";
import { p384DecodePoint, p384Base, p384Joint, p384Affine } from "./p384_point";
import { sha384Sum } from "./sha384";
import { sha256Sum } from "../hash";

struct Signature { r: Bytes, s: Bytes }
function integer(data: Bytes): Bytes | Error {
    const out = bytesNew(48); bytesCopy(out, 48 - bytesLen(data), data, 0, bytesLen(data)); let any = 0; let i = 0;
    while (i < 48) { any = any | (bytesGet(out, i) catch 0); i = i + 1; }
    if (any == 0 || !p384Less(out, p384OrderBytes())) { return err("ecdsa: integer outside 1..n-1"); } return out;
}
function pair(data: Bytes): Signature | Error {
    if (bytesLen(data) < 8 || bytesLen(data) > 104) { return err("ecdsa: invalid DER signature length"); }
    const root = derRead(data, 0, bytesLen(data))?;
    if (root.tag != 48 || root.end != bytesLen(data)) { return err("ecdsa: invalid DER signature sequence"); }
    const parts = derChildren(data, root, 2)?;
    if (listLen(parts) != 2) { return err("ecdsa: requires two integers"); }
    return Signature { r: integer(derPositiveInteger(data, listGet(parts, 0), 48)?)?, s: integer(derPositiveInteger(data, listGet(parts, 1), 48)?)? };
}
// digest is already hashed. ECDSA takes the leftmost 384 bits of longer hashes.
export function ecdsaP384VerifyDigest(peer: Bytes, digest: Bytes, signature: Bytes): bool | Error {
    if (bytesLen(digest) < 1 || bytesLen(digest) > 64) { return err("ecdsa: unsupported digest length"); }
    const prime = p384Prime(); const point = p384DecodePoint(prime, peer)?;
    const sig = pair(signature) catch (e) { return false; }; const order = p384Order();
    const inverse = p384Inverse(order, p384Decode(order, sig.s))?;
    let hash = digest; if (bytesLen(hash) > 48) { hash = bytesSlice(hash, 0, 48); }
    const u1 = p384Encode(order, p384Mul(order, p384Decode(order, hash), inverse));
    const u2 = p384Encode(order, p384Mul(order, p384Decode(order, sig.r), inverse));
    const sum = p384Joint(prime, p384Base(prime), u1, point, u2); const result = p384Affine(prime, sum) catch (e) { return false; };
    return bytesEqual(p384Encode(order, p384Decode(order, result.x)), sig.r);
}
export function ecdsaP384Sha384Verify(peer: Bytes, message: Bytes, signature: Bytes): bool | Error { return ecdsaP384VerifyDigest(peer, sha384Sum(message), signature); }
export function ecdsaP384Sha256Verify(peer: Bytes, message: Bytes, signature: Bytes): bool | Error { return ecdsaP384VerifyDigest(peer, sha256Sum(message), signature); }
