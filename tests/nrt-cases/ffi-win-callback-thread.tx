// 第 5 轮 FFI（D3 v0.23，Windows）：回调只能在太虚运行时所在的线程上被调用——CreateThread 让新线程
// 调用回调，蹦床 trap 4020（ffi_callback），位置报在回调函数开头；主线程此时停在 WaitForSingleObject。
declare type HANDLE;
declare function CreateThread(sec: usize, stack: usize, start: (usize) => u32, param: usize, flags: u32, tid: Bytes): HANDLE? from "kernel32";
declare function WaitForSingleObject(h: HANDLE, ms: u32): u32 from "kernel32";

function worker(p: usize): u32 {
    print("worker should not run");
    return 0;
}

function main(args: []string): int {
    print("start");
    const h = CreateThread(0, 0, worker, 0, 0, bytesNew(4));
    if (h != None) { WaitForSingleObject(h catch handleFromBits < HANDLE > (0), 4294967295); }
    print("unreachable");
    return 0;
}
