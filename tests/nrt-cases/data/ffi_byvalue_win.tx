// ffi-win-struct-byvalue 的另一组声明（同一个 C 函数在一个模块里只能声明一次）：lldiv 的返回布局写成定长数组与按值嵌套、
// conj 的复数写成 [2]float——与 C 原型的 ABI 等价（Win64 只看大小），用来核对按值返回填外壳时的嵌套对象与数组元素。
export declare struct BOX { v: int }
export declare struct QR { q: [1]int, r: BOX }
export declare struct CARR { v: [2]float }
declare function lldiv(a: int, b: int): QR from "ucrtbase";
declare function conj(z: CARR): CARR from "ucrtbase";

export function divNested(a: int, b: int): QR { return lldiv(a, b); }
export function conjArr(z: CARR): CARR { return conj(z); }
