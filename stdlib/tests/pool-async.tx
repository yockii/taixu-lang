// ============================================================================
// stdlib 异步验证：std/pool 分道轮转（V0.9-A2；verify ⑤ 段）。
// 红线：道序 0..laneCount-1 轮转、道内 FIFO 串行；结果序＝（道序×道内序）。
// spawn 发生在用户侧 async 调用表达式（mul(k) 直调——着色面），Future 入道。
// ============================================================================

import { Pool, poolNew, poolSubmit, poolDrain, poolFailed } from "std/pool";

async function mul(k: int): int {
    return k * 10;
}

// 收割观察者：await drain 的 Future 并逐项打印（泵中执行）。
async function reporter(rs: Future<List<int>>, p: Ref<Pool>): void {
    const xs = (await rs catch err("drain failed"))?;
    let i: int = 0;
    while (i < listLen(xs)) {
        const v = listGet(xs, i) catch -1;
        print("lane-result:" + toStr(v));
        i = i + 1;
    }
    print("failed:" + toStr(poolFailed(p)));
}

function main(args: []string): int {
    const p = poolNew(2);
    poolSubmit(p, 1, mul(1)); // 道 1：10
    poolSubmit(p, 0, mul(2)); // 道 0：20
    poolSubmit(p, 1, mul(3)); // 道 1：30
    const rs = poolDrain(p);
    reporter(rs, p);
    print("main-done");
    return 0;
}
