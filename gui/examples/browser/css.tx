// 浏览器 CSS 子集：标签／id／class、后代与子选择器、基础盒与字体。未知语法忽略。
import { HtmlDocument, HtmlNode } from "./html";
import { toLower, trim } from "std/string";
import { parseInt, parseFloat } from "std/strconv";

export struct CssDeclaration { name: string, value: string, important: bool }
export struct CssRule { selector: string, declarations: List<CssDeclaration>, specificity: int }
struct Budget { remaining: int }
export struct CssStyle { display: string, color: int, background: int, fontSize: int, bold: bool, italic: bool, pre: bool, underline: bool, marginTop: int, marginBottom: int, marginLeft: int, marginRight: int, padding: int, width: int, align: string }

function space(c: int): bool { return c == 32 || c == 9 || c == 10 || c == 13 || c == 12; }
function ident(c: int): bool { return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 95 || c >= 128; }
function asciiAt(source: string, at: int, word: string): bool {
    if (at < 0 || at > len(source) - len(word)) { return false; } let i = 0;
    while (i < len(word)) { if (byteAt(source, at + i) != byteAt(word, i)) { return false; } i = i + 1; } return true;
}
function words(source: string): List<string> {
    const out: List<string> = listNew(); let i = 0;
    while (i < len(source)) { while (i < len(source) && space(byteAt(source, i))) { i = i + 1; } const start = i; while (i < len(source) && !space(byteAt(source, i))) { i = i + 1; } if (i > start) { listPush(out, strSlice(source, start, i)); } } return out;
}
function comments(source: string): string {
    const out = bytesNew(0); const input = bytesFromStr(source); let i = 0; let quote = 0;
    while (i < bytesLen(input)) {
        const b = bytesGet(input, i) catch 0;
        if (quote != 0) { listPush(bytesAsList(out), b as u8); if (b == 92 && i + 1 < bytesLen(input)) { i = i + 1; listPush(bytesAsList(out), (bytesGet(input, i) catch 0) as u8); } else if (b == quote) { quote = 0; } }
        else if (b == 34 || b == 39) { quote = b; listPush(bytesAsList(out), b as u8); }
        else if (b == 47 && i + 1 < bytesLen(input) && (bytesGet(input, i + 1) catch 0) == 42) {
            i = i + 2; while (i + 1 < bytesLen(input) && !((bytesGet(input, i) catch 0) == 42 && (bytesGet(input, i + 1) catch 0) == 47)) { i = i + 1; }
            if (i + 1 >= bytesLen(input)) { break; } i = i + 1; listPush(bytesAsList(out), 32 as u8);
        } else { listPush(bytesAsList(out), b as u8); } i = i + 1;
    } return bytesToStr(out) catch "";
}
function delimiter(source: string, start: int, wanted: int): int {
    let quote = 0; let parentheses = 0; let i = start;
    while (i < len(source)) {
        const c = byteAt(source, i);
        if (quote != 0) { if (c == 92 && i + 1 < len(source)) { i = i + 1; } else if (c == quote) { quote = 0; } }
        else if (c == 34 || c == 39) { quote = c; } else if (c == 40) { parentheses = parentheses + 1; } else if (c == 41 && parentheses > 0) { parentheses = parentheses - 1; }
        else if (c == wanted && parentheses == 0) { return i; } i = i + 1;
    } return len(source);
}
export function cssDeclarations(source: string): List<CssDeclaration> | Error {
    if (len(source) > 1048576) { return err("browser css: declaration source limit"); }
    const clean = comments(source); const out: List<CssDeclaration> = listNew(); let start = 0;
    while (start < len(clean)) {
        const end = delimiter(clean, start, 59); const declaration = strSlice(clean, start, end); const colon = delimiter(declaration, 0, 58);
        if (colon < len(declaration)) {
            const name = toLower(trim(strSlice(declaration, 0, colon))); let value = trim(strSlice(declaration, colon + 1, len(declaration))); let important = false;
            let marker = len(value) - 1; while (marker >= 0 && byteAt(value, marker) != 33) { marker = marker - 1; }
            if (marker >= 0 && toLower(trim(strSlice(value, marker + 1, len(value)))) == "important") { important = true; value = trim(strSlice(value, 0, marker)); }
            if (len(name) > 0 && len(value) > 0) { if (listLen(out) >= 128) { return err("browser css: declaration count limit"); } listPush(out, CssDeclaration { name: name, value: value, important: important }); }
        } start = end + 1;
    } return out;
}
function specificity(selector: string): int {
    if (len(selector) > 1024) { return -1; } let score = 0; let i = 0;
    while (i < len(selector)) {
        const c = byteAt(selector, i); if (space(c) || c == 62 || c == 42) { i = i + 1; continue; }
        if (c == 35 || c == 46) { if (c == 35) { score = score + 100; } else { score = score + 10; } i = i + 1; } else { score = score + 1; }
        const start = i; while (i < len(selector) && ident(byteAt(selector, i))) { i = i + 1; } if (i == start) { return -1; }
    } return score;
}
// 与 open 处的 { 配对的 } 之后的位置：一次扫描，引号与圆括号内的花括号不算（同 delimiter）；不配对得 len(source) + 1。
function blockEnd(source: string, open: int): int {
    let quote = 0; let parentheses = 0; let depth = 1; let i = open + 1;
    while (i < len(source)) {
        const c = byteAt(source, i);
        if (quote != 0) { if (c == 92 && i + 1 < len(source)) { i = i + 1; } else if (c == quote) { quote = 0; } }
        else if (c == 34 || c == 39) { quote = c; } else if (c == 40) { parentheses = parentheses + 1; } else if (c == 41 && parentheses > 0) { parentheses = parentheses - 1; }
        else if (parentheses == 0 && c == 123) { depth = depth + 1; }
        else if (parentheses == 0 && c == 125) { depth = depth - 1; if (depth == 0) { return i + 1; } }
        i = i + 1;
    } return len(source) + 1;
}
// 超出规则数上限的规则丢弃（不使整页失败）。
export function cssParse(source: string): List<CssRule> | Error {
    if (len(source) > 1048576) { return err("browser css: stylesheet source limit"); }
    const clean = comments(source); const rules: List<CssRule> = listNew(); let start = 0;
    while (start < len(clean)) {
        const open = delimiter(clean, start, 123); if (open == len(clean)) { break; }
        const close = blockEnd(clean, open); if (close > len(clean)) { break; } const selector = trim(strSlice(clean, start, open));
        if (len(selector) > 0 && byteAt(selector, 0) != 64) {
            const noDeclarations: List<CssDeclaration> = listNew(); const declarations = cssDeclarations(strSlice(clean, open + 1, close - 1)) catch noDeclarations;
            for (piece in strSplit(selector, ",")) { const item = trim(piece); const score = specificity(item); if (len(item) > 0 && score >= 0 && listLen(rules) < 2048) { listPush(rules, CssRule { selector: item, declarations: declarations, specificity: score }); } }
        } start = close;
    } return rules;
}
function compound(node: Ref<HtmlNode>, selector: string, budget: Ref<Budget>): bool {
    budget.remaining = budget.remaining - len(selector); if (budget.remaining < 0) { return false; }
    if (node.tag == "#text" || len(selector) == 0) { return false; } let i = 0;
    if (byteAt(selector, i) == 42) { i = i + 1; }
    else if (byteAt(selector, i) != 35 && byteAt(selector, i) != 46) { const start = i; while (i < len(selector) && ident(byteAt(selector, i))) { i = i + 1; } if (toLower(strSlice(selector, start, i)) != node.tag) { return false; } }
    while (i < len(selector)) {
        const kind = byteAt(selector, i); if (kind != 35 && kind != 46) { return false; } i = i + 1; const start = i;
        while (i < len(selector) && ident(byteAt(selector, i))) { i = i + 1; } if (i == start) { return false; } const value = strSlice(selector, start, i);
        if (kind == 35) { const id = mapGet(node.attributes, "id") catch ""; budget.remaining = budget.remaining - len(id); if (budget.remaining < 0 || id != value) { return false; } }
        else { const classes = mapGet(node.attributes, "class") catch ""; budget.remaining = budget.remaining - len(classes); if (budget.remaining < 0) { return false; } let found = false; for (name in words(classes)) { if (name == value) { found = true; } } if (!found) { return false; } }
    } return true;
}
function matches(document: Ref<HtmlDocument>, index: int, selector: string, budget: Ref<Budget>): bool {
    budget.remaining = budget.remaining - len(selector); if (budget.remaining < 0) { return false; }
    // 子选择器先分词；后代关系只在祖先索引上搜索。
    const spaced = bytesNew(0); for (b in bytesAsList(bytesFromStr(selector))) { if (b == 62 as u8) { bytesAppend(spaced, bytesFromStr(" > ")); } else { listPush(bytesAsList(spaced), b); } }
    const parts = words(bytesToStr(spaced) catch ""); if (listLen(parts) == 0 || index < 0 || index >= listLen(document.nodes)) { return false; }
    let at = listLen(parts) - 1; let current = index; if (!compound(listGet(document.nodes, current), listGet(parts, at), budget)) { return false; } at = at - 1;
    while (at >= 0) {
        let direct = false; if (listGet(parts, at) == ">") { direct = true; at = at - 1; if (at < 0) { return false; } }
        current = listGet(document.nodes, current).parent; let found = false;
        while (current >= 0) { if (compound(listGet(document.nodes, current), listGet(parts, at), budget)) { found = true; break; } if (direct || budget.remaining < 0) { break; } current = listGet(document.nodes, current).parent; }
        if (!found) { return false; } at = at - 1;
    } return true;
}
export function cssMatches(document: Ref<HtmlDocument>, index: int, selector: string): bool { return matches(document, index, selector, new Budget { remaining: 2000000 }); }
export function cssDefault(parent: CssStyle?, node: Ref<HtmlNode>): CssStyle {
    let style = CssStyle { display: "inline", color: 0x172033, background: -1, fontSize: 16, bold: false, italic: false, pre: false, underline: false, marginTop: 0, marginBottom: 0, marginLeft: 0, marginRight: 0, padding: 0, width: -1, align: "left" };
    if (parent != None) { style.color = parent.color; style.fontSize = parent.fontSize; style.bold = parent.bold; style.italic = parent.italic; style.pre = parent.pre; style.underline = parent.underline; style.align = parent.align; }
    if (strFind(" #document html body div p hr h1 h2 h3 h4 h5 h6 ul ol li pre blockquote section article header footer nav main form table tr dl dt dd ", " " + node.tag + " ") >= 0) { style.display = "block"; }
    if (strFind(" head title style script meta link base template ", " " + node.tag + " ") >= 0 || mapHas(node.attributes, "hidden")) { style.display = "none"; }
    if (node.tag == "body") { style.marginTop = 12; style.marginBottom = 12; style.marginLeft = 16; style.marginRight = 16; }
    if (node.tag == "p" || node.tag == "pre" || node.tag == "blockquote" || node.tag == "ul" || node.tag == "ol") { style.marginTop = 8; style.marginBottom = 12; }
    if (node.tag == "ul" || node.tag == "ol" || node.tag == "blockquote") { style.marginLeft = 24; }
    if (node.tag == "pre") { style.pre = true; }
    if (strFind(" h1 h2 h3 h4 h5 h6 b strong th ", " " + node.tag + " ") >= 0) { style.bold = true; }
    if (node.tag == "h1") { style.fontSize = 32; } else if (node.tag == "h2") { style.fontSize = 24; } else if (node.tag == "h3") { style.fontSize = 20; }
    if (node.tag == "h1" || node.tag == "h2" || node.tag == "h3") { style.marginTop = 16; style.marginBottom = 10; }
    if (node.tag == "i" || node.tag == "em") { style.italic = true; }
    if (node.tag == "a" && mapHas(node.attributes, "href")) { style.color = 0x2563eb; style.underline = true; } return style;
}
function length(value: string, base: int): int? {
    let text = toLower(trim(value)); let scale = 1.0;
    if (asciiAt(text, len(text) - 2, "px")) { text = strSlice(text, 0, len(text) - 2); }
    else if (asciiAt(text, len(text) - 2, "em")) { text = strSlice(text, 0, len(text) - 2); scale = base as float; }
    else if (len(text) >= 1 && byteAt(text, len(text) - 1) == 37) { text = strSlice(text, 0, len(text) - 1); scale = (base as float) / 100.0; }
    const number = parseFloat(text) catch (e) { return None; }; const pixels = number * scale;
    if (pixels != pixels || pixels < -10000.0 || pixels > 10000.0) { return None; } return pixels as int;
}
export function cssColor(value: string): int? {
    const text = toLower(trim(value));
    if (text == "black") { return 0; } if (text == "white") { return 0xffffff; } if (text == "red") { return 0xff0000; }
    if (text == "green") { return 0x008000; } if (text == "blue") { return 0x0000ff; } if (text == "gray" || text == "grey") { return 0x808080; }
    if (text == "transparent") { return -1; }
    if ((len(text) == 4 || len(text) == 7) && byteAt(text, 0) == 35) {
        let color = 0; let i = 1; while (i < len(text)) { const c = byteAt(text, i); let digit = -1; if (c >= 48 && c <= 57) { digit = c - 48; } else if (c >= 97 && c <= 102) { digit = c - 87; } if (digit < 0) { return None; } if (len(text) == 4) { color = color * 256 + digit * 17; } else { color = color * 16 + digit; } i = i + 1; } return color;
    }
    if (len(text) > 5 && asciiAt(text, 0, "rgb(") && byteAt(text, len(text) - 1) == 41) {
        const parts = strSplit(strSlice(text, 4, len(text) - 1), ","); if (listLen(parts) != 3) { return None; } let color = 0;
        for (part in parts) { const value = parseInt(trim(part)) catch (e) { return None; }; if (value < 0 || value > 255) { return None; } color = color * 256 + value; } return color;
    } return None;
}
function apply(style: CssStyle, declaration: CssDeclaration): CssStyle {
    let out = style; const name = declaration.name; const value = toLower(trim(declaration.value));
    if (name == "display" && (value == "none" || value == "block" || value == "inline")) { out.display = value; }
    else if (name == "color") { const color = cssColor(value); if (color != None && color >= 0) { out.color = color; } }
    else if (name == "background-color") { const color = cssColor(value); if (color != None) { out.background = color; } }
    else if (name == "font-size") { const pixels = length(value, style.fontSize); if (pixels != None && pixels >= 0) { out.fontSize = pixels; if (out.fontSize < 4) { out.fontSize = 4; } if (out.fontSize > 128) { out.fontSize = 128; } } }
    else if (name == "font-weight") { if (value == "bold" || value == "bolder" || value == "600" || value == "700" || value == "800" || value == "900") { out.bold = true; } else if (value == "normal" || value == "400") { out.bold = false; } }
    else if (name == "font-style" && (value == "normal" || value == "italic" || value == "oblique")) { out.italic = value != "normal"; }
    else if (name == "white-space" && (value == "pre" || value == "pre-wrap" || value == "normal")) { out.pre = value != "normal"; }
    else if (name == "text-decoration") { if (value == "none") { out.underline = false; } else if (strFind(value, "underline") >= 0) { out.underline = true; } }
    else if (name == "text-align" && (value == "left" || value == "center" || value == "right")) { out.align = value; }
    else if (name == "width") { const pixels = length(value, 0); if (value == "auto") { out.width = -1; } else if (pixels != None && pixels > 0) { out.width = pixels; } }
    else if (name == "padding") { const pixels = length(value, style.fontSize); if (pixels != None && pixels >= 0) { out.padding = pixels; } }
    else if (name == "margin-top" || name == "margin-right" || name == "margin-bottom" || name == "margin-left") {
        const pixels = length(value, style.fontSize); if (pixels != None) { if (name == "margin-top") { out.marginTop = pixels; } else if (name == "margin-right") { out.marginRight = pixels; } else if (name == "margin-bottom") { out.marginBottom = pixels; } else { out.marginLeft = pixels; } }
    } return out;
}
function valid(declaration: CssDeclaration): bool {
    const name = declaration.name; const value = toLower(trim(declaration.value));
    if (name == "display") { return value == "none" || value == "block" || value == "inline"; }
    if (name == "color" || name == "background-color") { const color = cssColor(value); return color != None && (name != "color" || color >= 0); }
    if (name == "font-size" || name == "padding") { if (name == "padding" && strFind(value, "%") >= 0) { return false; } const pixels = length(value, 16); return pixels != None && pixels >= 0; }
    if (name == "margin-top" || name == "margin-right" || name == "margin-bottom" || name == "margin-left") { return strFind(value, "%") < 0 && length(value, 16) != None; }
    if (name == "width") { return value == "auto" || ((length(value, 0) catch 0) > 0); }
    if (name == "font-weight") { return strFind(" normal bold bolder 400 600 700 800 900 ", " " + value + " ") >= 0; }
    if (name == "font-style") { return value == "normal" || value == "italic" || value == "oblique"; }
    if (name == "white-space") { return value == "normal" || value == "pre" || value == "pre-wrap"; }
    if (name == "text-decoration") { return value == "none" || strFind(value, "underline") >= 0; }
    if (name == "text-align") { return value == "left" || value == "right" || value == "center"; } return false;
}
function select(winners: Map<string, CssDeclaration>, weights: Map<string, int>, declaration: CssDeclaration, priority: int): void {
    if (!valid(declaration)) { return; } let weight = priority; if (declaration.important) { weight = weight + 1000000; }
    if (weight >= (mapGet(weights, declaration.name) catch -1)) { mapSet(winners, declaration.name, declaration); mapSet(weights, declaration.name, weight); }
}
function cascade(winners: Map<string, CssDeclaration>, weights: Map<string, int>, declarations: List<CssDeclaration>, priority: int): void {
    for (declaration in declarations) {
        if (declaration.name == "margin") {
            const parts = words(declaration.value); if (listLen(parts) < 1 || listLen(parts) > 4) { continue; } let okay = true;
            for (part in parts) { if (strFind(part, "%") >= 0 || length(part, 16) == None) { okay = false; } } if (!okay) { continue; }
            const indexes: List<int> = [0, 0, 0, 0]; if (listLen(parts) >= 2) { listSet(indexes, 1, 1); listSet(indexes, 3, 1); } if (listLen(parts) >= 3) { listSet(indexes, 2, 2); } if (listLen(parts) == 4) { listSet(indexes, 3, 3); }
            const names: List<string> = ["margin-top", "margin-right", "margin-bottom", "margin-left"]; let i = 0;
            while (i < 4) { select(winners, weights, CssDeclaration { name: listGet(names, i), value: listGet(parts, listGet(indexes, i)), important: declaration.important }, priority); i = i + 1; }
        } else if (declaration.name == "background") { select(winners, weights, CssDeclaration { name: "background-color", value: declaration.value, important: declaration.important }, priority); }
        else { select(winners, weights, declaration, priority); }
    }
}
export function cssCompute(document: Ref<HtmlDocument>): List<CssStyle> | Error {
    const rules: List<CssRule> = listNew(); let size = 0;
    // 超限的样式表与规则丢弃，选择器工作量用尽后其余节点只用缺省与内联样式：页面照常呈现，不报导航失败。
    const noRules: List<CssRule> = listNew(); const noDeclarations: List<CssDeclaration> = listNew();
    for (source in document.styles) { size = size + len(source); if (size > 2097152) { break; } for (rule in cssParse(source) catch noRules) { if (listLen(rules) < 2048) { listPush(rules, rule); } } }
    const out: List<CssStyle> = listNew(); let index = 0; const budget = new Budget { remaining: 2000000 };
    for (node in document.nodes) {
        let parent: CssStyle? = None; if (node.parent >= 0) { parent = listGet(out, node.parent); }
        let style = cssDefault(parent, node); const weights: Map<string, int> = mapNew(); const winners: Map<string, CssDeclaration> = mapNew();
        if (node.tag != "#text") {
            for (rule in rules) { if (budget.remaining < 0) { break; } const matched = matches(document, index, rule.selector, budget); if (matched && budget.remaining >= 0) { cascade(winners, weights, rule.declarations, rule.specificity); } }
            cascade(winners, weights, cssDeclarations(mapGet(node.attributes, "style") catch "") catch noDeclarations, 100000);
            const fontSize = mapGet(winners, "font-size");
            if (fontSize != None) { let base = style; base.fontSize = 16; const inherited = parent; if (inherited != None) { base.fontSize = inherited.fontSize; } style.fontSize = apply(base, fontSize).fontSize; }
            for (name, declaration in winners) { if (name != "font-size") { style = apply(style, declaration); } }
        } listPush(out, style); index = index + 1;
    } return out;
}
