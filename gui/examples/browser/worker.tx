import { BrowserContent, contentPage } from "./content";
import { browserFetch } from "./fetch";
import { deadlineAfterMs } from "std/deadline";

export struct BrowserJobFlags { done: Atomic<int>, cancelled: Atomic<int> }
export struct BrowserJob { thread: Thread<BrowserContent>, flags: Shared<Ref<BrowserJobFlags>>, generation: int }

export function browserJobStart(url: string, roots: List<Bytes>, timeoutMs: int, generation: int): Ref<BrowserJob> | Error {
    if (timeoutMs < 1 || timeoutMs > 120000) { return err("browser job: invalid timeout"); }
    const deadline = deadlineAfterMs(timeoutMs)?;
    const flags = sharedNew(new BrowserJobFlags { done: atomicNew(0), cancelled: atomicNew(0) });
    const thread = threadSpawn((): BrowserContent | Error => {
            const state = sharedGet(flags); defer atomicStore(state.done, 1);
            const cancelled = (): bool => { return atomicLoad(state.cancelled) != 0; };
            const page = browserFetch(url, deadline, roots, cancelled)?;
            if (cancelled()) { return err("browser job: cancelled"); }
            const content = contentPage(page)?;
            if (cancelled()) { return err("browser job: cancelled"); }
            return content;
        });
    return new BrowserJob { thread: thread, flags: flags, generation: generation };
}
export function browserJobReady(job: Ref<BrowserJob>): bool { return atomicLoad(sharedGet(job.flags).done) != 0; }
export function browserJobCancel(job: Ref<BrowserJob>): void { atomicStore(sharedGet(job.flags).cancelled, 1); }
// Caller joins exactly once, after ready, or while closing after cancellation.
export function browserJobJoin(job: Ref<BrowserJob>): BrowserContent | Error { return threadJoin(job.thread); }
