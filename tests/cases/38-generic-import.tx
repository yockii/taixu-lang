// 多个模块各自显式导入同一泛型 struct（import { Box }）不再报“导入名与本模块声明冲突”；
// 同一类型实参在不同模块实例化得到同一类型（Box< Q> 跨模块传递）。
import { Box, Q } from "./38-generic-import-g";
import { fa, mkQ } from "./38-generic-import-a";
import { fb, getN } from "./38-generic-import-b";

export function main(args: []string): int {
    print(fa());
    print(fb());
    const m: Box<Q> = mkQ();
    print(toStr(getN(m)) + "," + toStr(getN(Box<Q> { v: Q { n: 42 } })));
    return 0;
}
