// 有界 Bytes gzip 解码，RFC 1952；支持连续成员，验证头 CRC 与每个成员的 CRC32／ISIZE。
import { inflatePart, crc32 } from "./compress";

function at(data: Bytes, position: int): int { return bytesGet(data, position) catch panic("gzip: internal bounds"); }
function word(data: Bytes, position: int, width: int): int | Error {
    if (position < 0 || position > bytesLen(data) - width) { return err("gzip: truncated integer"); }
    let result = 0; let i = 0; while (i < width) { result = result | (at(data, position + i) << (8 * i)); i = i + 1; } return result;
}
function zeroTerminated(data: Bytes, start: int): int | Error {
    let i = start; while (i < bytesLen(data)) { if (at(data, i) == 0) { return i + 1; } i = i + 1; } return err("gzip: unterminated header string");
}
function header(data: Bytes, start: int): int | Error {
    if (start < 0 || start > bytesLen(data) - 10 || at(data, start) != 31 || at(data, start + 1) != 139 || at(data, start + 2) != 8) { return err("gzip: invalid member header"); }
    const flags = at(data, start + 3); if ((flags & 224) != 0) { return err("gzip: reserved flags"); }
    let position = start + 10;
    if ((flags & 4) != 0) { const size = word(data, position, 2)?; position = position + 2; if (size > bytesLen(data) - position) { return err("gzip: truncated extra header"); } position = position + size; }
    if ((flags & 8) != 0) { position = zeroTerminated(data, position)?; } if ((flags & 16) != 0) { position = zeroTerminated(data, position)?; }
    if ((flags & 2) != 0) {
        const expected = word(data, position, 2)?; const values: List<int> = listNew(); let i = start;
        while (i < position) { listPush(values, at(data, i)); i = i + 1; }
        if ((crc32(values) & 65535) != expected) { return err("gzip: header CRC mismatch"); } position = position + 2;
    } return position;
}
export function gzipDecode(data: Bytes, maximum: int): Bytes | Error {
    if (maximum < 0 || maximum > 67108864 || bytesLen(data) < 18 || bytesLen(data) > 67108864) { return err("gzip: invalid limit or input size"); }
    const values: List<int> = listNew(); for (b in bytesAsList(data)) { listPush(values, b as int); }
    const out = bytesNew(0); let position = 0; let members = 0;
    while (position < bytesLen(data)) {
        members = members + 1; if (members > 256) { return err("gzip: member count limit"); }
        const start = header(data, position)?; const part = inflatePart(values, start, maximum - bytesLen(out))?;
        const expectedCrc = word(data, part.next, 4)?; const expectedSize = word(data, part.next + 4, 4)?;
        if (crc32(part.data) != expectedCrc || listLen(part.data) != expectedSize) { return err("gzip: member CRC or size mismatch"); }
        for (b in part.data) { listPush(bytesAsList(out), b as u8); } position = part.next + 8;
    } return out;
}
