// 操作系统密码学随机源。与可复现的 std/random 分开，无种子与伪随机回退。
import { fillRandomFrom } from "./rand_impl";
import { sysRandomRead } from "./rand_sys";

// 失败后目标可能已有一部分被修改；发生 Error 时不可把目标用于密码学。
export function randomFill(data: Bytes): void | Error { return fillRandomFrom(data, sysRandomRead); }

export function randomBytes(length: int): Bytes | Error {
    if (length < 0) { return err("crypto/rand: negative length"); }
    const data = bytesNew(length);
    randomFill(data)?;
    return data;
}
