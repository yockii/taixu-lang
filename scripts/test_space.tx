// 语料的运行目录与系统临时目录属于本次运行。编译仍读取原源码，运行期相对路径在夹具副本中解析。
import { absolute, copyFile, join, mkdirs, nat } from "./build_lib";
import { osRealPath } from "./build_os";

export struct TestSpace {
    root: string,
    trees: Map<string, string>,
}

// 不使用调用者的系统临时目录中的固定文件名。子进程继承这些环境变量。
export function testSpace(dir: string): Ref<TestSpace> | Error {
    if (!mkdirs(absolute(dir))) { return err("建不了运行目录：" + dir); }
    const root = join(osRealPath(absolute(dir)), "space-" + toStr(monoNs()));
    if (!mkdirs(root)) { return err("建不了本次运行目录：" + root); }
    const tmp = join(root, "tmp");
    if (!mkdirs(tmp)) { return err("建不了临时目录：" + tmp); }
    setEnv("TMPDIR", nat(tmp))?;
    setEnv("TMP", nat(tmp))?;
    setEnv("TEMP", nat(tmp))?;
    return new TestSpace { root: root, trees: mapNew() };
}

function fixtureTree(from: string, to: string): void | Error {
    if (!mkdirs(to)) { return err("建不了夹具目录：" + to); }
    const names = localListDir(nat(from), "")?;
    for (name in names) {
        // 编译缓存与用例运行产生的临时目录从空开始，不从源码树复制。
        if (name == ".tmp") { continue; }
        const src = join(from, name);
        const dst = join(to, name);
        const kind = localEntryKind(nat(from), name);
        if (kind == 2) {
            fixtureTree(src, dst)?;
        } else if (kind == 1) {
            if (!copyFile(src, dst, false)) { return err("复制不了夹具：" + src); }
        } else {
            return err("夹具不是普通文件或目录：" + src);
        }
    }
    return;
}

// 一个运行器里同一来源目录只复制一次；不同运行器的 root 不同，互不读写对方的夹具与输出。
export function caseSpace(s: Ref<TestSpace>, sourceDir: string): string | Error {
    const key = osRealPath(absolute(sourceDir));
    if (mapHas(s.trees, key)) { return mapGet(s.trees, key) ?? ""; }
    const dir = join(s.root, "fixtures-" + toStr(listLen(mapKeys(s.trees))));
    fixtureTree(key, dir)?;
    if (!mkdirs(join(dir, ".tmp"))) { return err("建不了夹具临时目录：" + dir); }
    mapSet(s.trees, key, dir);
    return dir;
}
