import { BrowserJob, browserJobStart, browserJobReady, browserJobCancel, browserJobJoin } from "../examples/browser/worker";
import { deadlineAfterMs, deadlineRemainingMs } from "std/deadline";

function invalidTimeout(): bool { browserJobStart("http://127.0.0.1/", listNew(), 0, 1) catch (e) { return true; }; return false; }
function failure(job: Ref<BrowserJob>): string { browserJobJoin(job) catch (e) { return e.message; }; return ""; }
function failedJob(): void {
    const job = browserJobStart("ftp://example.test/", listNew(), 1000, 17) catch panic("start");
    const deadline = deadlineAfterMs(5000) catch panic("deadline"); let turns = 0;
    while (!browserJobReady(job)) { assert((deadlineRemainingMs(deadline) catch 0) > 0, "worker completion is bounded"); turns = turns + 1; }
    const message = failure(job); assert(strFind(message, "http client:") >= 0 || strFind(message, "http:") >= 0, "worker preserves the protocol error");
    assert(len(message) > 0 && job.generation == 17, "error transferred and generation retained");
}
function cancelJob(): void {
    const job = browserJobStart("ftp://example.test/", listNew(), 1000, 18) catch panic("start"); browserJobCancel(job);
    const deadline = deadlineAfterMs(5000) catch panic("deadline");
    while (!browserJobReady(job)) { assert((deadlineRemainingMs(deadline) catch 0) > 0, "cancelled completion bounded"); }
    assert(len(failure(job)) > 0, "cancelled or already failed worker is joined"); assert(invalidTimeout(), "invalid budget rejected before spawning");
}
test "Browser worker: failed result signals completion and joins" { failedJob(); }
test "Browser worker: cancellation and budget guards" { cancelJob(); }
export function main(args: []string): int { failedJob(); cancelJob(); print("browser worker: completion, error and cancellation OK"); return 0; }
