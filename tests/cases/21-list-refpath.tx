// LANG-07 RC 全路径（V0.7-S2）：Ref 元素移交＋listSet 覆写释放＋句柄共享可变。
struct Counter {
    v: int,
}

function bump(c: Ref<Counter>): int {
    c.v = c.v + 1; // 句柄共享：同一堆对象
    return c.v;
}

export function main(args: []string): int {
    const cs: List<Ref<Counter>> = listNew();
    const spare: Ref<Counter> = new Counter { v: 0 };
    listPush(cs, new Counter { v: 41 });
    listPush(cs, new Counter { v: 42 });

    const top = listPop(cs) catch spare; // 42 出表（表失权，调用方持唯一）
    print(toStr(top.v)); // 42
    print(toStr(bump(top))); // 43

    listSet(cs, 0, new Counter { v: 7 }); // 旧 41 释放
    const head = listGet(cs, 0) catch spare;
    print(toStr(head.v)); // 7
    print(toStr(listLen(cs))); // 1
    return 0;
}
