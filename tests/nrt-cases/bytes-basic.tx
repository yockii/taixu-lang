// D3 v0.18 Bytes：构造、读写、增长、切片、相等、字符串互转、嵌入、文件读写。
struct Packet { tag: string, body: Bytes }

function hex(b: Bytes): string {
    const digits = "0123456789abcdef";
    let out = "";
    let i = 0;
    while (i < bytesLen(b)) {
        const v = bytesGet(b, i) catch -1;
        out = out + strSub(digits, v / 16, 1) + strSub(digits, v % 16, 1);
        i = i + 1;
    }
    return out;
}

export function main(args: []string): int {
    const z = bytesNew(3);
    print(toStr(len(z)) + " " + hex(z));
    bytesSet(z, 1, 255);
    print(hex(z) + " " + toStr(bytesGet(z, 1) catch -1) + " " + toStr(bytesGet(z, 3) catch -1));
    const g = bytesNew(0);
    let i = 0;
    while (i < 40) { bytesPush(g, i * 6); i = i + 1; }
    print(toStr(bytesLen(g)) + " " + toStr(bytesGet(g, 39) catch -1));
    const s = bytesSlice(g, 2, 3);
    print(hex(s));
    bytesAppend(s, s);
    print(hex(s));
    const alias = s;
    bytesPush(alias, 7);
    print(hex(s) + " " + toStr(alias == s) + " " + toStr(bytesEqual(s, bytesSlice(alias, 0, bytesLen(alias)))));
    print(toStr(bytesEqual(z, g)) + " " + toStr(s == bytesSlice(s, 0, bytesLen(s))));
    const u = bytesFromStr("太虚 ok");
    print(toStr(bytesLen(u)) + " " + hex(u));
    const back = bytesToStr(u) catch "bad";
    print(back);
    const broken = bytesNew(2);
    bytesSet(broken, 0, 237);
    bytesSet(broken, 1, 160);
    const msg = bytesToStr(broken) catch (e) { return report(e.message); };
    print(msg);
    return 0;
}

function report(m: string): int {
    print(m);
    const m2 = bytesFromStr("method");
    m2.push(33);
    print(toStr(m2.len()) + " " + (bytesToStr(m2) catch "?"));
    const e = embedBytes("data/embed.bin");
    print("embed " + toStr(bytesLen(e)) + " " + hex(e));
    bytesSet(e, 0, 97);
    const e2 = embedBytes("data/embed.bin");
    print("fresh " + hex(e2));
    const parts: List< Bytes> = listNew();
    listPush(parts, e);
    listPush(parts, bytesFromStr("x"));
    const p = new Packet { tag: "t", body: bytesSlice(e, 0, 2) };
    print(toStr(listLen(parts)) + " " + hex(listGet(parts, 1) catch bytesNew(0)) + " " + hex(p.body));
    return 0;
}
