// 浮点循环的段内规划：融合比较段（带 break 的逃逸判定）、同一临时槽先后装 float 与 int、循环入口未写的临时槽，
// 以及同一循环里临时槽先后装字符串与 float（不得当作非堆而跳过释放）。输出与关闭寄存器分配时逐字节相同。
function escape(cr: float, ci: float): int {
    let zr = 0.0;
    let zi = 0.0;
    let it = 0;
    while (it < 255) {
        const t = zr * zr - zi * zi + cr;
        zi = 2.0 * zr * zi + ci;
        zr = t;
        if (zr * zr + zi * zi > 4.0) {
            break;
        }
        it = it + 1;
    }
    return it;
}

function newton(v: float): float {
    let g = v;
    let it = 0;
    while (it < 8) {
        g = 0.5 * (g + v / g);
        it = it + 1;
    }
    return g;
}

function stepping(limit: float): int {
    let x = 0.0;
    let n = 0;
    while (x < limit) {
        x = x + 0.25;
        n = n + 1;
    }
    return n;
}

function mixed(n: int): string {
    let out = "";
    let acc = 1.0;
    let i = 0;
    while (i < n) {
        out = out + toStr(i % 10);
        acc = acc * 1.5 - 0.25;
        i = i + 1;
    }
    return out + " " + toStr(acc);
}

export function main(args: []string): int {
    let total = 0;
    let py = 0;
    while (py < 40) {
        let px = 0;
        while (px < 60) {
            total = total + escape((px as float) * 0.05 - 2.0, (py as float) * 0.0625 - 1.25);
            px = px + 1;
        }
        py = py + 1;
    }
    print(toStr(total));
    print(toStr(newton(2.0)));
    print(toStr(newton(1000000.0)));
    print(toStr(stepping(100.0)));
    print(mixed(23));
    return 0;
}
