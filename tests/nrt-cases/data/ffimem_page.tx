// ffi-mem 一组用例的页分配（D3 v0.48 外部内存区）：基础文件，原生编译器按目标改用 _windows／_linux／_macos，导出面须一致。
// pageAlloc 分配一页可读写的内存（至少 4096 字节，按页对齐），pageProtect 改保护（0 不可访问、1 只读、2 可读写），pageFree 归还；
// writableChecked 说明本系统的 ffiMem 是否核验可写（Linux 只核验可读，D3 §6.8-22）。
export function pageAlloc(): int {
    return 0;
}

export function pageProtect(p: int, prot: int): bool {
    return false;
}

export function pageFree(p: int): void {
}

export function writableChecked(): bool {
    return false;
}
