// O4 第二步 2c3：定宽整数实现 Hashable（prelude 的 i8Hash … usizeHash：转 int 后同 intHash，u64/usize 按位环绕成 int），
// 可作 Map/Set 的键；x.hash() 方法语法；泛型函数里以定宽整数为键。
function countAll<K extends Hashable>(xs: List< K>): Map< K, int> {
    const m: Map< K, int> = mapNew();
    for (x in xs) {
        m.set(x, (m.get(x) catch 0) + 1);
    }
    return m;
}

function main(args: []string): int {
    const ages: Map< u8, string> = mapNew();
    const a: u8 = 30;
    const b: u8 = 255;
    ages.set(a, "thirty");
    ages.set(b, "max");
    print("u8 " + toStr(mapLen(ages)) + " " + (ages.get(b) catch "?") + " " + toStr(ages.has(a)));
    const big: Map< u64, int> = mapNew();
    const k1: u64 = 18446744073709551615;
    const k2: u64 = 9223372036854775808;
    big.set(k1, 1);
    big.set(k2, 2);
    big.set(k1, 3);
    print("u64 " + toStr(mapLen(big)) + " " + toStr(big.get(k1) catch -1) + " " + toStr(big.get(k2) catch -1) + " " + toStr(k1.hash()) + " " + toStr(k2.hash()));
    const s: Set< i16> = setNew();
    const n1: i16 = -32768;
    const n2: i16 = 7;
    s.add(n1);
    s.add(n2);
    s.add(n1);
    print("i16 " + toStr(setLen(s)) + " " + toStr(s.has(n1)) + " " + toStr(s.has(n2)) + " " + toStr(n1.hash()));
    const us: Set< usize> = setNew();
    const z: usize = 0;
    us.add(z);
    print("usize " + toStr(setLen(us)) + " " + toStr(us.has(z)));
    const xs: List< i32> = listNew();
    const v1: i32 = -5;
    const v2: i32 = 2147483647;
    listPush(xs, v1);
    listPush(xs, v2);
    listPush(xs, v1);
    const counts = countAll(xs);
    print("count " + toStr(counts.get(v1) catch 0) + " " + toStr(counts.get(v2) catch 0));
    const w: u32 = 4000000000;
    const iz: isize = -1;
    const i8v: i8 = -128;
    const u16v: u16 = 65535;
    print("hash " + toStr(w.hash()) + " " + toStr(iz.hash()) + " " + toStr(i8v.hash()) + " " + toStr(u16v.hash()) + " " + toStr(u8Hash(b)));
    return 0;
}
