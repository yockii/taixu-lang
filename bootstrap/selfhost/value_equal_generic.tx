// 值相等的可移植版（rtfn 写，macOS 适配 M4 设计 A8）：语义与导出名同 value_equal.tx。
// equal(a, b, depth u32) → 1 相等、0 不等、2 深度超过 1024。标签（字节@0）不同即不等；4 None 恒等；1 int 比 8 字节；2 float 按 IEEE
// （NaN 不等、±0 相等）；3 bool 比真假；9、11..17 比 u32 句柄号（同一性；17 为 Bytes，D3 v0.18）；5、6、7、8、10 是容器：两边各拍
// 快照经 __tx_store_equal_view_v1 取 32 字节视图 {种类 u32@0, 类型 u32@4, 元 u64@8, 指针@16, 长度@24}，种类为 0 或视图头不同即不等，
// 种类 1 逐字节比，其余逐个元素递归（结果不为 1 时原样返回）。
import { StructuredBuffer } from "./assemble";
import { RtFn, L, I } from "./rtfn_base";
import { rtBegin, rtEnd, rtFailed, rtSet, rtOp, rtShift, rtLoad, rtAddrOf, rtLabel, rtJump, rtIf, rtIf32, rtFIf, rtCall2, rtCall3, rtRet } from "./rtfn";

const MODULE: string = "bootstrap/selfhost/value_equal_generic.tx";
const M32: int = 4294967295;
const MAX_DEPTH: int = 1024;

function done(f: Ref<RtFn>, failures: List<string>): void {
    rtEnd(f);
    if (len(rtFailed(f)) > 0) { listPush(failures, rtFailed(f)); }
}

// sa0 sa1／sb0 sb1 是两边的快照，va0..va3／vb0..vb3 是两边的视图（各自连续的局部槽）。
function equalFn(b: Ref<StructuredBuffer>, failures: List<string>): void {
    const f = rtBegin(b, "__tx_native_equal_v1", "a b depth", "sa0 sa1 sb0 sb1 va0 va1 va2 va3 vb0 vb1 vb2 vb3 pa pb x y i n r", 3, MODULE);
    rtOp(f, "depth", L("depth"), "and", I(M32));
    rtIf(f, L("depth"), "ugt", I(MAX_DEPTH), "deep");
    rtLoad(f, "x", L("a"), 0, 1);
    rtLoad(f, "y", L("b"), 0, 1);
    rtIf(f, L("x"), "ne", L("y"), "false");
    rtIf(f, L("x"), "eq", I(4), "true");
    rtIf(f, L("x"), "eq", I(1), "int");
    rtIf(f, L("x"), "eq", I(2), "float");
    rtIf(f, L("x"), "eq", I(3), "bool");
    rtIf(f, L("x"), "eq", I(9), "identity");
    rtIf(f, L("x"), "eq", I(11), "identity");
    rtIf(f, L("x"), "eq", I(12), "identity");
    rtIf(f, L("x"), "eq", I(13), "identity");
    rtIf(f, L("x"), "eq", I(14), "identity");
    rtIf(f, L("x"), "eq", I(15), "identity");
    rtIf(f, L("x"), "eq", I(16), "identity");
    rtIf(f, L("x"), "eq", I(17), "identity");
    rtIf(f, L("x"), "eq", I(5), "container");
    rtIf(f, L("x"), "eq", I(6), "container");
    rtIf(f, L("x"), "eq", I(7), "container");
    rtIf(f, L("x"), "eq", I(8), "container");
    rtIf(f, L("x"), "eq", I(10), "container");
    rtJump(f, "false");
    rtLabel(f, "int");
    rtLoad(f, "x", L("a"), 8, 8);
    rtLoad(f, "y", L("b"), 8, 8);
    rtIf(f, L("x"), "eq", L("y"), "true");
    rtJump(f, "false");
    rtLabel(f, "identity");
    rtLoad(f, "x", L("a"), 8, 4);
    rtLoad(f, "y", L("b"), 8, 4);
    rtIf(f, L("x"), "eq", L("y"), "true");
    rtJump(f, "false");
    rtLabel(f, "float");
    rtLoad(f, "x", L("a"), 8, 8);
    rtLoad(f, "y", L("b"), 8, 8);
    rtFIf(f, L("x"), "eq", L("y"), "true");
    rtJump(f, "false");
    rtLabel(f, "bool");
    rtLoad(f, "x", L("a"), 8, 8);
    rtLoad(f, "y", L("b"), 8, 8);
    rtIf(f, L("x"), "eq", I(0), "boolzero");
    rtIf(f, L("y"), "ne", I(0), "true");
    rtJump(f, "false");
    rtLabel(f, "boolzero");
    rtIf(f, L("y"), "eq", I(0), "true");
    rtJump(f, "false");

    rtLabel(f, "container");
    rtLoad(f, "sa0", L("a"), 0, 8);
    rtLoad(f, "sa1", L("a"), 8, 8);
    rtLoad(f, "sb0", L("b"), 0, 8);
    rtLoad(f, "sb1", L("b"), 8, 8);
    rtAddrOf(f, "pa", "sa0");
    rtAddrOf(f, "pb", "va0");
    rtCall2(f, "", "__tx_store_equal_view_v1", L("pa"), L("pb"));
    rtAddrOf(f, "pa", "sb0");
    rtAddrOf(f, "pb", "vb0");
    rtCall2(f, "", "__tx_store_equal_view_v1", L("pa"), L("pb"));
    rtAddrOf(f, "pa", "va0");
    rtLoad(f, "x", L("pa"), 0, 4);
    rtIf(f, L("x"), "eq", I(0), "ne");
    rtLoad(f, "y", L("pb"), 0, 4);
    rtIf(f, L("x"), "ne", L("y"), "ne");
    rtLoad(f, "x", L("pa"), 8, 8);
    rtLoad(f, "y", L("pb"), 8, 8);
    rtIf(f, L("x"), "ne", L("y"), "ne");
    rtLoad(f, "x", L("pa"), 4, 4);
    rtLoad(f, "y", L("pb"), 4, 4);
    rtIf(f, L("x"), "ne", L("y"), "ne");
    rtLoad(f, "n", L("pa"), 24, 8);
    rtLoad(f, "y", L("pb"), 24, 8);
    rtIf(f, L("n"), "ne", L("y"), "ne");
    rtLoad(f, "x", L("pa"), 0, 4);
    rtIf(f, L("x"), "eq", I(1), "bytes");
    rtSet(f, "i", I(0));
    rtLabel(f, "loop");
    rtIf(f, L("i"), "uge", L("n"), "eq");
    rtShift(f, "y", L("i"), "shl", 4);
    rtAddrOf(f, "pa", "va0");
    rtLoad(f, "x", L("pa"), 16, 8);
    rtOp(f, "x", L("x"), "add", L("y"));
    rtAddrOf(f, "pb", "vb0");
    rtLoad(f, "r", L("pb"), 16, 8);
    rtOp(f, "y", L("r"), "add", L("y"));
    rtOp(f, "r", L("depth"), "add", I(1));
    rtOp(f, "r", L("r"), "and", I(M32));
    rtCall3(f, "r", "__tx_native_equal_v1", L("x"), L("y"), L("r"));
    rtIf32(f, L("r"), "ne", I(1), "result");
    rtOp(f, "i", L("i"), "add", I(1));
    rtJump(f, "loop");
    rtLabel(f, "bytes");
    rtLoad(f, "pa", L("pa"), 16, 8);
    rtLoad(f, "pb", L("pb"), 16, 8);
    rtLabel(f, "byteloop");
    rtIf(f, L("n"), "eq", I(0), "eq");
    rtLoad(f, "x", L("pa"), 0, 1);
    rtLoad(f, "y", L("pb"), 0, 1);
    rtIf(f, L("x"), "ne", L("y"), "ne");
    rtOp(f, "pa", L("pa"), "add", I(1));
    rtOp(f, "pb", L("pb"), "add", I(1));
    rtOp(f, "n", L("n"), "sub", I(1));
    rtJump(f, "byteloop");
    rtLabel(f, "result");
    rtRet(f, L("r"));
    rtLabel(f, "ne");
    rtRet(f, I(0));
    rtLabel(f, "eq");
    rtRet(f, I(1));

    rtLabel(f, "false");
    rtRet(f, I(0));
    rtLabel(f, "true");
    rtRet(f, I(1));
    rtLabel(f, "deep");
    rtRet(f, I(2));
    done(f, failures);
}

/// 发出值相等函数；rtfn 的失败记进 failures。t 为目标编号（只在语义随目标不同时用；这里不用）。
export function valueEqualGenericEmit(b: Ref<StructuredBuffer>, failures: List<string>, t: int): void {
    equalFn(b, failures);
}
