// D3 v0.20：调用点类型实参不满足约束（3030）。
interface Hashable {
    hash(): int;
}
function intHash(x: int): int { return x * 7; }
function hashAll<T extends Hashable>(xs: List< T>): int {
    let h: int = 0;
    for (x in xs) { h = h + x.hash(); }
    return h;
}
function main(args: []string): int {
    const fs: List< float> = listNew();
    print(toStr(hashAll(fs)));
    return 0;
}
