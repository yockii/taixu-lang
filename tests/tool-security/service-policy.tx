import { serviceConfigure, serviceCanonical, serviceReadBytes, serviceKind, serviceWorkspace, serviceAllows, serviceError } from "../../bootstrap/selfhost/service_files";
import { drvVariantSiblings } from "../../bootstrap/selfhost/driver";
function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    const roots: List< string> = listNew(); listPush(roots, args[0]); const libs: List< string> = listNew();
    if (!serviceConfigure(roots, libs, libs)) { print(serviceError()); return 1; }
    assert(serviceWorkspace(args[0] + "/ok.bin"), "workspace");
    assert(serviceKind(args[0] + "/ok.bin") == 1, "local file");
    assert(bytesLen(serviceReadBytes(args[0] + "/ok.bin", 3) catch bytesNew(0)) == 3, "binary");
    assert(serviceKind(args[0] + "/../outside/secret.bin") == 0, "outside");
    assert(serviceKind(args[0] + "/junction/secret.bin") == 0, "link");
    assert(!serviceAllows("//security-test.invalid/share/file.tx"), "network");
    assert(drvVariantSiblings(args[0] + "/../outside/variant.tx", "controlled", 1, 1) == "", "auxiliary export reads honor roots");
    assert(serviceCanonical(args[0] + "/a/../ok.bin") == serviceCanonical(args[0] + "/ok.bin"), "normalization");
    print("PASS_POLICY_ROOT_BINARY_OUTSIDE_LINK_NETWORK"); return 0;
}
