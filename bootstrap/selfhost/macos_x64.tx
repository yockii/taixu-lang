// x86_64-macos 的手写原语（目标分层 X3b）：线程局部取址。进程入口是 LC_MAIN
// 指向的 main（dyld 按 C 约定调用，由共用的入口例程发出，不需要手写的 _start），系统接口例程是两种架构共用的 libSystem 蹦床
// （unix_sys.tx 的 macSysEmit），线程入口是 x86_64 SysV 的外壳（thread_entry.tx）。
// - 线程局部：Mach-O 的 TLV——__tx_tls_tlv 是描述符，首字是 dyld 的取址函数，以 rdi＝描述符调用，rax＝本线程槽的地址。
import { Operand, StructuredBuffer, asBufferInstruction, asBufferFrame, asBufferFunctionEnd, asBufferFunctionPrologueEnd, asBufferFunctionEpilogueStart, asManualBegin,
    asStructuredMissing, asStructuredReg, asStructuredMem } from "./assemble";

const MODULE: string = "bootstrap/selfhost/macos_x64.tx";

function ins(b: Ref<StructuredBuffer>, mn: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void {
    asBufferInstruction(b, mn, n, a, c, asStructuredMissing(), 1);
}

/// __tx_tls_tb_get() → 本线程的线程块（外来线程为 0）；__tx_tls_tb_set(tb)。调描述符首字（快路径只写 rax，本线程首次访问的
/// 慢路径由 dyld 保存寄存器，见 M1），rax＝槽地址。rdi 自行保存；调用点：入口 rsp ≡ 8，push 后 ≡ 0。
/// 两个都压栈调 dyld，登记进函数目录（来源 runtime-manual，目标分层 X5c）：序言压 rdi，读写槽之后才是尾声（弹 rdi、ret）。
export function macosX64TlsLeaves(b: Ref<StructuredBuffer>): void {
    const r = asStructuredReg(0, 0);
    tlvSlot(b, "__tx_tls_tb_get");
    ins(b, "mov", 2, r, asStructuredMem(2, 0, -1, 0, 0, 0, ""));
    tlvReturn(b);
    tlvSlot(b, "__tx_tls_tb_set");
    ins(b, "mov", 2, asStructuredMem(2, 0, -1, 0, 0, 0, ""), asStructuredReg(0, 1));
    tlvReturn(b);
}

// 起函数 entry，rax ＝ 本线程 TLV 槽的地址（rdi 压栈保存；TLV 取址函数不改其他寄存器）。
function tlvSlot(b: Ref<StructuredBuffer>, entry: string): void {
    const rdi = asStructuredReg(0, 7);
    asManualBegin(b, MODULE, entry);
    asBufferFrame(b, "push-nonvolatile", 7, 8);
    asBufferFunctionPrologueEnd(b);
    ins(b, "lea", 2, rdi, asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_tls_tlv"));
    ins(b, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 7, -1, 0, 0, 0, ""));
    asBufferInstruction(b, "call", 1, asStructuredReg(0, 0), asStructuredMissing(), asStructuredMissing(), 1);
}

// 唯一出口：弹回 rdi、ret，结束函数。
function tlvReturn(b: Ref<StructuredBuffer>): void {
    asBufferFunctionEpilogueStart(b);
    asBufferFrame(b, "pop-nonvolatile", 7, 8);
    asBufferFrame(b, "return", -1, 8);
    asBufferFunctionEnd(b);
}
