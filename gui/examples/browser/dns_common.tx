import { deadlineRemainingMs } from "std/deadline";
import { fileOpen, fileRead, fileClose, FILE_READ } from "std/file";
import { parseIp } from "std/ip";
import { tls13Hostname } from "std/tls13_wire";

export struct BrowserAddress { ip: Bytes, scope: int }
export function dnsCheckpoint(deadline: int, cancelled: () => bool): void | Error {
    if (cancelled()) { return err("browser dns: cancelled"); }
    if (deadlineRemainingMs(deadline)? == 0) { return err("browser dns: deadline exceeded"); } return done();
}
export function dnsLiteral(host: string): List<BrowserAddress> | Error {
    const name = tls13Hostname(host)?; const ip = parseIp(name) catch bytesNew(0); const out: List<BrowserAddress> = listNew();
    if (bytesLen(ip) > 0) { listPush(out, BrowserAddress { ip: ip, scope: 0 }); } return out;
}
export function dnsAdd(out: List<BrowserAddress>, ip: Bytes, scope: int): void | Error {
    if ((bytesLen(ip) != 4 && bytesLen(ip) != 16) || scope < 0 || scope > 4294967295 || (bytesLen(ip) == 4 && scope != 0)) { return err("browser dns: invalid system address"); }
    for (existing in out) { if (existing.scope == scope && bytesEqual(existing.ip, ip)) { return done(); } }
    if (listLen(out) >= 256) { return err("browser dns: address count limit"); }
    listPush(out, BrowserAddress { ip: ip, scope: scope }); return done();
}
export function dnsReadFile(path: string): string | Error {
    const file = fileOpen(path, FILE_READ)?; defer { fileClose(file); } const data = bytesNew(0);
    while (true) {
        const part = fileRead(file, 4096)?; if (bytesLen(part) == 0) { break; }
        if (bytesLen(data) > 1048576 - bytesLen(part)) { return err("browser dns: system file limit"); }
        bytesAppend(data, part);
    } return bytesToStr(data);
}
function done(): void {}
