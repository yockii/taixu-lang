// Test-only export of the unchanged slot kernel for allocator fault injection.
// arm64 只有可移植版（A64 内核全为 rtfn），同一个驱动核对。
import { storeSlotsEmit } from "./selfhost/store_slots";
import { storeSlotsGenericEmit } from "./selfhost/store_slots_generic";
import { probeBuffer, probeWrite } from "./native_probe_object";
import { targetParseAnalysis, tA64 } from "./selfhost/target";
// 用法：--target <目标> <输出> [quarantine]；quarantine 发检测形态（对象号隔离，x86 也用可移植版；隔离环 64 项——页堆内核为
// 65536，测试分配器单次至多 1 MiB，小容量才能在其中测满环与出环）。
function main(args: []string): int {
    if ((len(args) != 3 && len(args) != 4) || args[0] != "--target") { return 64; }
    const quarantine = len(args) == 4;
    if (quarantine && args[3] != "quarantine") { return 64; }
    const t = targetParseAnalysis(args[1]);
    if (t < 0) { return 64; }
    const buf = probeBuffer(t);
    if (tA64(t) || quarantine) {
        let ring = 0;
        if (quarantine) { ring = 64; }
        const failures: List<string> = listNew(); storeSlotsGenericEmit(buf, failures, t, ring);
        if (listLen(failures) > 0) { eprint(listGet(failures, 0) catch ""); return 66; }
    } else { storeSlotsEmit(buf, t); }
    const exports: List<string> = listNew();
    listPush(exports, "__tx_native_slots_create_v2"); listPush(exports, "__tx_native_slots_acquire_v2");
    listPush(exports, "__tx_native_slots_free_v2"); listPush(exports, "__tx_native_slots_destroy_v2");
    return probeWrite(buf, t, args[2], exports);
}
