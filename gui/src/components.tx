// ============================================================================
// gui/components —— 声明式组件 API（控件库
// 丰富）。
//
// 纯 .tx 框架层（零引擎改动）：组件＝数据（几何＋样式＋文本），绘制＝对
// surface 原语的确定性展开；布局由调用方以坐标/伸缩参数表达（flex 冻结子
// 集实现在 gui/layout）。
// 静态三件 box/text/button（在案的 .tx 投影）＋最小扩面 input/list
//（引擎面按用例最小实现，平台面无新依赖）。
//
// 事件订阅：on_click 经 std/events ListenerTable（target 键分发
// 冻结契约；捕获值快照语义天然适配闭包直连）。
//
// **新增面**：
// - T0 双轨文本：TextPainter＋Canvas——paintText/paintTextWidth 为组件级
//   文本/度量单点；默认占位块轨（blockPainter），真实轨画笔经 gui/text
//   的 realPainter/textCanvas 接入（引用才拉栈——本模块零引用文本 extern）；
// - T1 纯框架五件：checkbox/radioGroup（线绘八边形近似——surface 无圆弧
//   原语，engine arc 登记可选优化位）/progress/dropdown/separator+groupBox；
// - T2 配套数据面：slider/scrollView/tooltip 数据与绘制＋命中（事件会话
//   装配在 gui/app——拖拽会话/焦点栈/hover 单点在 pump）；
// - T3 结构件：scrollContainer 裁剪纪律（一切新控件绘制经 Canvas 判界——
//   engine setClip 为可选优化位不预扩）＋multiline 折行＋app-drawn 模态
//   messageBox（不走 OS 弹窗——确定性可 golden）。
// ============================================================================

// ============================================================================
// 分节导航：组件的定义、绘制与命中位于同一模块，
// 拆分必改全部消费面（app/示例/tests 的 "gui/components" import）契约＝
// 非逐字节搬家；与 parser 双出口同判据。本标头为 AI/维护导航面。）
//   §1 输入帮手（modHas/keyChar/keyCharMods）
//   §2 画布核（TextPainter/Canvas/HitZone/canvas* 族/clip）
//   §3 绘制原语（paintFillRect/Alpha/Stroke/Line/paintText/blockPainter）
//   §4 控件族（Box/Button/Slider/Input/Checkbox/Table/Tree/Menu 等 struct
//      ＋draw* 命中/绘制函数，文件中段至尾）
// ============================================================================

import { surfaceFillRect, surfaceStrokeRect, surfaceLine, surfaceFillRectA, guiQuery, CAP_ANIM_MS, dipToPxK } from "gui/surface";

// —— 事件 kind（与核心仓 platform.gui 枚举同码；resize 为新增；
//    key/mouse-up/mouse-move 消费为扩面——kind 值域零新增）——
export const EV_KEY_DOWN: int = 1;
export const EV_KEY_UP: int = 2;
export const EV_MOUSE_DOWN: int = 3;
export const EV_MOUSE_UP: int = 4;
export const EV_MOUSE_MOVE: int = 5;
export const EV_CLOSE: int = 6;
export const EV_RESIZE: int = 7; // x＝新宽 y＝新高（16B 事件记录零变更）

/// 文本字符（v0.1.4 反馈 #7——kind 值域内新增零格式变更）：x＝Unicode 码位。
/// 真窗 WM_CHAR 事件化（IME 合成结果——中文输入法下 WM_KEYDOWN 携
/// VK_PROCESSKEY，VK 文本路径收不到字符）；重放/脚本通道经 push 面同码
/// 注入（inputOnKeys 的 insertChar 臂消费）。
export const EV_TEXT: int = 8;

/// 竖向滚动：组件事件 x 为向下为正的 DIP 位移，y 为 0；不改变键盘焦点。
export const EV_SCROLL: int = 9;

// —— 键码常量（win32 VK 子集直映——与核心仓 platform.gui KEY_* 同码；
//    事件记录携带 mods 修饰位集——大小写/组合键可用；
//    无修饰位构造（mods=0）时本面仍为基础字符集〔VK 直映〕）——
export const KEY_BACK: int = 8;
export const KEY_TAB: int = 9;
export const KEY_RETURN: int = 13;
export const KEY_ESC: int = 27;
export const KEY_SPACE: int = 32;
export const KEY_LEFT: int = 37;
export const KEY_UP: int = 38;
export const KEY_RIGHT: int = 39;
export const KEY_DOWN: int = 40;

// —— 修饰位集（与核心仓 platform.gui MOD_* 同码；
//    重放行第六字段与 eventWindowPushMods 同编码）——
export const EV_MOD_SHIFT: int = 1;
export const EV_MOD_CTRL: int = 2;
export const EV_MOD_ALT: int = 4;

/// 位测试单点（重写：位与直译 `(mods & bit) != 0`——在册
/// "S1 语言边界"的算术位测试清偿，清单；**行为恒等**：bit 恒为
/// 2 的幂（1/2/4）且 mods 非负约定下 `mods/bit%2==1` ≡ `mods&bit!=0`
/// 逐点等价；负值/非幂位防御面不变）。
export function modHas(mods: int, bit: int): bool {
    if (bit <= 0 || mods < 0) {
        return false;
    }
    return (mods & bit) != 0;
}

/// 基础字符集映射（VK→单字符；不可打印得 ""——无修饰位〔mods=0〕约定）。
export function keyChar(vk: int): string {
    if (vk >= 48 && vk <= 57) {
        return utf8Encode(vk) catch "";
    }
    if (vk >= 65 && vk <= 90) {
        return utf8Encode(vk + 32) catch ""; // VK 直映小写（无修饰位）
    }
    if (vk == 32) {
        return " ";
    }
    // OEM 直映符号（; = , - . / ` [ \ ] '）
    if (vk == 186) {
        return ";";
    }
    if (vk == 187) {
        return "=";
    }
    if (vk == 188) {
        return ",";
    }
    if (vk == 189) {
        return "-";
    }
    if (vk == 190) {
        return ".";
    }
    if (vk == 191) {
        return "/";
    }
    if (vk == 192) {
        return "`";
    }
    if (vk == 219) {
        return "[";
    }
    if (vk == 220) {
        return "\\";
    }
    if (vk == 221) {
        return "]";
    }
    if (vk == 222) {
        return "'";
    }
    return "";
}

/// 修饰位感知字符映射（大小写/符号最小集）：
/// shift＋字母→大写、shift＋数字/符号→上位符号（美式键盘布局）；ctrl/alt
/// 不产字符（组合键语义归订阅面 onHotkey）。无修饰位＝keyChar 同款。
export function keyCharMods(vk: int, mods: int): string {
    if (vk == 32) {
        return " ";
    }
    if (vk >= 65 && vk <= 90) {
        if (modHas(mods, EV_MOD_SHIFT)) {
            return utf8Encode(vk) catch ""; // 大写
        }
        return utf8Encode(vk + 32) catch "";
    }
    if (vk >= 48 && vk <= 57) {
        if (!modHas(mods, EV_MOD_SHIFT)) {
            return utf8Encode(vk) catch "";
        }
        // shift＋数字→上位符号：) ! @ # $ % ^ & * (
        const shifted: List<string> = listNew();
        listPush(shifted, ")");
        listPush(shifted, "!");
        listPush(shifted, "@");
        listPush(shifted, "#");
        listPush(shifted, "$");
        listPush(shifted, "%");
        listPush(shifted, "^");
        listPush(shifted, "&");
        listPush(shifted, "*");
        listPush(shifted, "(");
        return listTryGet(shifted, vk - 48) catch "";
    }
    if (!modHas(mods, EV_MOD_SHIFT)) {
        return keyChar(vk);
    }
    // shift＋OEM 符号→上位符号（美式布局最小集）。
    if (vk == 186) {
        return ":";
    }
    if (vk == 187) {
        return "+";
    }
    if (vk == 188) {
        return "<";
    }
    if (vk == 189) {
        return "_";
    }
    if (vk == 190) {
        return ">";
    }
    if (vk == 191) {
        return "?";
    }
    if (vk == 192) {
        return "~";
    }
    if (vk == 219) {
        return "{";
    }
    if (vk == 220) {
        return "|";
    }
    if (vk == 221) {
        return "}";
    }
    if (vk == 222) {
        return "\"";
    }
    return "";
}

// ============================================================================
// T0 —— Canvas 与双轨文本（组件级文本/度量单点）
// ============================================================================

/// 文本画笔（双轨接缝）：draw/width 回调形状冻结——占位块轨由本模块
/// blockPainter 提供；真实轨由 gui/text 的 realPainter 提供（引用才拉栈）。
export struct TextPainter {
    draw: (Ref<Canvas>, int, int, int, string) => void, // (canvas, x, y, color, body)——内容坐标
    width: (string) => int, // 推进度量（px）
}

/// 绘制上下文（框架级裁剪纪律的载体——T3 scrollContainer 一切实质）：
/// 内容坐标经 off 平移到屏幕坐标，clip 为屏幕坐标裁剪矩形；一切 paint*
/// 先判界后出像素（逐 fillRect/glyph 判界——engine setClip 可选优化位）。
/// **帧级 DPI（臂①）**：k＝DPI 比例 x100（缺省 100）——
/// 内容坐标（DIP）×k 出物理像素，clip/off 语义：off 为 DIP 内容偏移、clip
/// 为 surface 物理像素矩形；k=100 时与旧像素单单位模型逐字节等价。
export struct Canvas {
    h: int,
    off_x: int,
    off_y: int,
    clip_x: int,
    clip_y: int,
    clip_w: int,
    clip_h: int,
    painter: Ref<TextPainter>,
    k: int,
}

/// 命中区（真窗点击→组件 id 的判定数据面：id 0 恒保留＝未命中；亦作
/// 模态按钮区等布局命中的一般载体——自 gui/app 上移至组件层）。
export struct HitZone {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
}

/// 裁剪求交结果（值语义私有件）。
struct ClipRect {
    x: int,
    y: int,
    w: int,
    h: int,
    empty: bool,
}

function clipIntersect(c: Ref<Canvas>, x: int, y: int, w: int, h: int): ClipRect {
    // 内容坐标（DIP）→屏幕物理像素后与 clip 求交（k 因子缩放单点）。
    const sx: int = dipToPxK(x - c.off_x, c.k);
    const sy: int = dipToPxK(y - c.off_y, c.k);
    const sw: int = dipToPxK(w, c.k);
    const sh: int = dipToPxK(h, c.k);
    const x0: int = maxInt(sx, c.clip_x);
    const y0: int = maxInt(sy, c.clip_y);
    const x1: int = minInt(sx + sw, c.clip_x + c.clip_w);
    const y1: int = minInt(sy + sh, c.clip_y + c.clip_h);
    if (x1 <= x0 || y1 <= y0) {
        return ClipRect { x: 0, y: 0, w: 0, h: 0, empty: true };
    }
    return ClipRect { x: x0, y: y0, w: x1 - x0, h: y1 - y0, empty: false };
}

function minInt(a: int, b: int): int {
    if (a < b) {
        return a;
    }
    return b;
}

function maxInt(a: int, b: int): int {
    if (a > b) {
        return a;
    }
    return b;
}

/// 画布构造（默认占位块轨；clip＝全表面，off＝零；k=100）。
export function canvasNew(h: int, w: int, ht: int): Ref<Canvas> {
    return canvasWithPainter(h, w, ht, blockPainter());
}

/// 画布构造（指定画笔——真实轨经 gui/text.textCanvas 一步到达；k=100）。
export function canvasWithPainter(h: int, w: int, ht: int, p: Ref<TextPainter>): Ref<Canvas> {
    return new Canvas { h: h, off_x: 0, off_y: 0, clip_x: 0, clip_y: 0, clip_w: w, clip_h: ht, painter: p, k: 100 };
}

/// 帧级 DPI 画布构造（臂①）：w/ht 为 surface 物理像素
///（clip＝全物理面），k＝DPI 比例 x100——内容坐标恒 DIP，paint* 出物理
/// 像素。k=100 时与 canvasWithPainter 等价。
export function canvasDpi(h: int, w: int, ht: int, p: Ref<TextPainter>, k: int): Ref<Canvas> {
    return new Canvas { h: h, off_x: 0, off_y: 0, clip_x: 0, clip_y: 0, clip_w: w, clip_h: ht, painter: p, k: k };
}

/// 子画布：clip 收窄为与矩形（内容坐标——DIP）的交集；off/painter/k 继承。
export function canvasClip(c: Ref<Canvas>, x: int, y: int, w: int, h: int): Ref<Canvas> {
    const r = clipIntersect(c, x, y, w, h);
    if (r.empty) {
        return new Canvas { h: c.h, off_x: c.off_x, off_y: c.off_y, clip_x: 0, clip_y: 0, clip_w: 0, clip_h: 0, painter: c.painter, k: c.k };
    }
    return new Canvas { h: c.h, off_x: c.off_x, off_y: c.off_y, clip_x: r.x, clip_y: r.y, clip_w: r.w, clip_h: r.h, painter: c.painter, k: c.k };
}

/// 子画布：内容坐标平移（scrollContainer 滚动的载体；DIP 偏移）。
export function canvasOffset(c: Ref<Canvas>, dx: int, dy: int): Ref<Canvas> {
    return new Canvas { h: c.h, off_x: c.off_x + dx, off_y: c.off_y + dy, clip_x: c.clip_x, clip_y: c.clip_y, clip_w: c.clip_w, clip_h: c.clip_h, painter: c.painter, k: c.k };
}

// —— paint 原语（一切新控件的绘制出口；逐调用判界）——

export function paintFillRect(c: Ref<Canvas>, x: int, y: int, w: int, h: int, color: int): void {
    const r = clipIntersect(c, x, y, w, h);
    if (r.empty) {
        return;
    }
    surfaceFillRect(c.h, r.x, r.y, r.w, r.h, color);
}

/// alpha 混合填充（臂⑤）：判界后逐片混合出
/// 像素（k 因子缩放与 paintFillRect 同路径——clipIntersect 单点）。
export function paintFillRectA(c: Ref<Canvas>, x: int, y: int, w: int, h: int, color: int, alpha: int): void {
    const r = clipIntersect(c, x, y, w, h);
    if (r.empty) {
        return;
    }
    surfaceFillRectA(c.h, r.x, r.y, r.w, r.h, color, alpha);
}

/// alpha 描边＝四条 1px 判界展开同 alpha（与 paintStrokeRect 同构）。
export function paintStrokeRectA(c: Ref<Canvas>, x: int, y: int, w: int, h: int, color: int, alpha: int): void {
    paintFillRectA(c, x, y, w, 1, color, alpha);
    paintFillRectA(c, x, y + h - 1, w, 1, color, alpha);
    paintFillRectA(c, x, y, 1, h, color, alpha);
    paintFillRectA(c, x + w - 1, y, 1, h, color, alpha);
}

/// 边框＝四条 1px 边的判界展开（与 surface.strokeRect 等视、可裁剪）。
export function paintStrokeRect(c: Ref<Canvas>, x: int, y: int, w: int, h: int, color: int): void {
    paintFillRect(c, x, y, w, 1, color);
    paintFillRect(c, x, y + h - 1, w, 1, color);
    paintFillRect(c, x, y, 1, h, color);
    paintFillRect(c, x + w - 1, y, 1, h, color);
}

/// 线段判界：两端点均在 clip 内才绘制（部分可见线段不画——确定性约定，
/// 折行/布局保证正常用例不触此边界；engine setClip 立项前保守形态）。
/// 坐标 DIP→物理按 k 缩放（帧级 DPI 单点——与 fillRect 同式）。
export function paintLine(c: Ref<Canvas>, x0: int, y0: int, x1: int, y1: int, color: int): void {
    const ax: int = dipToPxK(x0 - c.off_x, c.k);
    const ay: int = dipToPxK(y0 - c.off_y, c.k);
    const bx: int = dipToPxK(x1 - c.off_x, c.k);
    const by: int = dipToPxK(y1 - c.off_y, c.k);
    if (!pointInClip(c, ax, ay) || !pointInClip(c, bx, by)) {
        return;
    }
    surfaceLine(c.h, ax, ay, bx, by, color);
}

function pointInClip(c: Ref<Canvas>, px: int, py: int): bool {
    return px >= c.clip_x && px < c.clip_x + c.clip_w && py >= c.clip_y && py < c.clip_y + c.clip_h;
}

/// 组件文本单点（双轨分派：painter.draw——占位块轨逐 glyph 判界，真实轨
/// 可见性判界后整行出字）。
export function paintText(c: Ref<Canvas>, x: int, y: int, color: int, body: string): void {
    c.painter.draw(c, x, y, color, body);
}

/// 组件文本宽度单点（双轨分派：painter.width）。
export function paintTextWidth(c: Ref<Canvas>, body: string): int {
    return c.painter.width(body);
}

function paintGlyphBlock(c: Ref<Canvas>, x: int, y: int, cp: int, color: int): void {
    // 字形块（占位轨）：可打印 ASCII 实心＋底部基线；逐 glyph 判界裁剪。
    if (cp == 32) {
        return;
    }
    paintFillRect(c, x, y, 6, 8, color);
    paintFillRect(c, x, y + 9, 7, 1, color);
}

/// 占位块轨画笔（默认轨——零文本栈拉入；8px 步进 × 10px 行高投影）。
export function blockPainter(): Ref<TextPainter> {
    const draw = (c: Ref<Canvas>, x: int, y: int, color: int, body: string): void => {
        let i: int = 0;
        while (i < len(body)) {
            const cp = byteTryAt(body, i) catch 63;
            paintGlyphBlock(c, x + i * 8, y, cp, color);
            i = i + 1;
        }
    };
    const width = (body: string): int => {
        return len(body) * 8;
    };
    return new TextPainter { draw: draw, width: width };
}

// —— 组件数据面 ——

export struct Box {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    fill: int,
    stroke: int,
}

export struct Text {
    id: int,
    x: int,
    y: int,
    body: string,
    color: int,
}

export struct Button {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    label: string,
    hovered: bool, // hover 高亮（drawButtonC 消费；旧 drawButton 不变）
}

/// 单行输入（扩面：chars＝文本缓冲真源〔string 不可变——退格用
/// listPop〕＋focused 焦点态；value 保留＝构造种子〔旧面兼容〕）。
/// select＝全选替换位（ctrl+A 置位——下个可打印替换全缓冲，
/// 最小集）。
///真选区模型——cursor＝光标字符位；anchor＝选区锚
///〔-1＝无选区；否则选区＝min/max(anchor,cursor) 区间——shift 方向键/
/// Home/End 与 ctrl+A 消费〕；select 保留＝旧替换位（ctrl+A 经新模型置
/// anchor=0/cursor=len——行为超集）。
export struct Input {
    id: int,
    x: int,
    y: int,
    w: int,
    value: string,
    chars: List<string>,
    focused: bool,
    select: bool,
    cursor: int,
    anchor: int,
}

/// 静态列表（最小面：条目串表＋行高；选中态随反馈驱动）。
export struct ListWidget {
    id: int,
    x: int,
    y: int,
    w: int,
    items: List<string>,
}

// —— 组件构造（声明面：链式属性经具名构造变体表达）——

export function box(id: int, x: int, y: int, w: int, h: int, fill: int): Ref<Box> {
    return new Box { id: id, x: x, y: y, w: w, h: h, fill: fill, stroke: 0x000000 };
}

export function text(id: int, x: int, y: int, body: string): Ref<Text> {
    return new Text { id: id, x: x, y: y, body: body, color: 0x000000 };
}

export function button(id: int, x: int, y: int, w: int, h: int, label: string): Ref<Button> {
    return new Button { id: id, x: x, y: y, w: w, h: h, label: label, hovered: false };
}

export function input(id: int, x: int, y: int, w: int, value: string): Ref<Input> {
    const inp: Ref<Input> = new Input { id: id, x: x, y: y, w: w, value: value, chars: listNew(), focused: false, select: false, cursor: 0, anchor: -1 };
    let i: int = 0;
    while (i < len(value)) {
        const cp = byteTryAt(value, i) catch 32;
        listPush(inp.chars, utf8Encode(cp) catch "");
        i = i + 1;
    }
    inp.cursor = listLen(inp.chars);
    return inp;
}

/// 选区下界（anchor<0 或无选区 → -1；调用方以 <0 判"无选区"）。
export function inputSelLo(inp: Ref<Input>): int {
    if (inp.anchor < 0) {
        return -1;
    }
    if (inp.anchor < inp.cursor) {
        return inp.anchor;
    }
    return inp.cursor;
}

/// 选区上界（与 lo 配对；无选区 → -1）。
export function inputSelHi(inp: Ref<Input>): int {
    if (inp.anchor < 0) {
        return -1;
    }
    if (inp.anchor < inp.cursor) {
        return inp.cursor;
    }
    return inp.anchor;
}

/// 前缀宽（chars[0..upto] 连接后的像素宽——光标/选区带的 x 定位点）。
export function inputPrefixWidth(c: Ref<Canvas>, inp: Ref<Input>, upto: int): int {
    let s: string = "";
    let i: int = 0;
    while (i < upto) {
        s = s + (listTryGet(inp.chars, i) catch "");
        i = i + 1;
    }
    return paintTextWidth(c, s);
}

/// 选区删除（有选区时删 min..max 区间，光标落区间起点、anchor 清——无选区
/// 为 no-op；返回是否发生了删除）。
export function inputDeleteSelection(inp: Ref<Input>): bool {
    const lo: int = inputSelLo(inp);
    if (lo < 0) {
        return false;
    }
    const hi: int = inputSelHi(inp);
    const fresh: List<string> = listNew();
    let i: int = 0;
    while (i < listLen(inp.chars)) {
        if (i < lo || i >= hi) {
            listPush(fresh, listTryGet(inp.chars, i) catch "");
        }
        i = i + 1;
    }
    inp.chars = fresh;
    inp.cursor = lo;
    inp.anchor = -1;
    return true;
}

/// 光标处插入字符（选区先删——替换语义单点；光标右移一位）。
export function inputInsertChar(inp: Ref<Input>, ch: string): void {
    const del = inputDeleteSelection(inp);
    const fresh: List<string> = listNew();
    let i: int = 0;
    while (i < inp.cursor) {
        listPush(fresh, listTryGet(inp.chars, i) catch "");
        i = i + 1;
    }
    listPush(fresh, ch);
    while (i < listLen(inp.chars)) {
        listPush(fresh, listTryGet(inp.chars, i) catch "");
        i = i + 1;
    }
    inp.chars = fresh;
    inp.cursor = inp.cursor + 1;
    inp.anchor = -1;
}

/// 光标处退格（有选区＝删选区；否则删光标前一字符——光标左移一位）。
export function inputBackspace(inp: Ref<Input>): void {
    const del = inputDeleteSelection(inp);
    if (del) {
        return;
    }
    if (inp.cursor <= 0) {
        return;
    }
    const fresh: List<string> = listNew();
    let i: int = 0;
    while (i < listLen(inp.chars)) {
        if (i != inp.cursor - 1) {
            listPush(fresh, listTryGet(inp.chars, i) catch "");
        }
        i = i + 1;
    }
    inp.chars = fresh;
    inp.cursor = inp.cursor - 1;
    inp.anchor = -1;
}

export function listWidget(id: int, x: int, y: int, w: int, items: List<string>): Ref<ListWidget> {
    return new ListWidget { id: id, x: x, y: y, w: w, items: items };
}

/// 输入缓冲现值（chars 连接——键入面的读口）。
export function inputValue(inp: Ref<Input>): string {
    let s: string = "";
    for (ch in inp.chars) {
        s = s + ch;
    }
    return s;
}

// —— 绘制（确定性展开：同组件序列 → 同像素；原有三件保持不变）——

export function drawBox(h: int, b: Ref<Box>): void {
    surfaceFillRect(h, b.x, b.y, b.w, b.h, b.fill);
    if (b.stroke != b.fill) {
        surfaceStrokeRect(h, b.x, b.y, b.w, b.h, b.stroke);
    }
}

export function drawText(h: int, t: Ref<Text>): void {
    // 文本绘制＝逐字符 8×10 块状投影（框架最小面；组件级真实文本
    // 经 Canvas/paintText 双轨——gui/text 选用才拉栈）。
    let i: int = 0;
    while (i < len(t.body)) {
        const cp = byteTryAt(t.body, i) catch 63;
        drawGlyphBlock(h, t.x + i * 8, t.y, cp, t.color);
        i = i + 1;
    }
}

function drawGlyphBlock(h: int, x: int, y: int, cp: int, color: int): void {
    // 字形块：可打印 ASCII 实心＋底部基线；空白留白——仅占位投影。
    if (cp == 32) {
        return;
    }
    surfaceFillRect(h, x, y, 6, 8, color);
    surfaceLine(h, x, y + 9, x + 6, y + 9, color);
}

export function drawButton(h: int, b: Ref<Button>): void {
    const frame = box(b.id, b.x, b.y, b.w, b.h, 0x2A2A4A);
    drawBox(h, frame);
    const label = text(b.id, b.x + 4, b.y + 4, b.label);
    drawText(h, label);
}

/// Canvas 版按钮（hover 高亮＋白字对比＋判界裁剪）。v0.1.4 反馈 #6：
/// 标签水平垂直居中（此前左上角对齐——通用按钮的默认语义是居中；垂直
/// 以 14px 文本行盒对半，行盒契约同 RADIO_ROW_H 系常量的字号约定）。
export function drawButtonC(c: Ref<Canvas>, b: Ref<Button>): void {
    let bg: int = 0x2A2A4A;
    if (b.hovered) {
        bg = 0x3A3A6A;
    }
    paintFillRect(c, b.x, b.y, b.w, b.h, bg);
    paintStrokeRect(c, b.x, b.y, b.w, b.h, 0x000000);
    const tw: int = paintTextWidth(c, b.label);
    let lx: int = b.x + (b.w - tw) / 2;
    if (lx < b.x + 2) {
        lx = b.x + 2;
    }
    paintText(c, lx, b.y + (b.h - 14) / 2, 0xFFFFFF, b.label);
}

export function drawInput(h: int, inp: Ref<Input>): void {
    const frame = box(inp.id, inp.x, inp.y, inp.w, 18, 0xFFFFFF);
    drawBox(h, frame);
    const v = text(inp.id, inp.x + 3, inp.y + 4, inp.value);
    drawText(h, v);
}

/// Canvas 版输入框（chars 真源＋焦点光标＋判界裁剪）。
/// 光标位随 cursor（前缀宽定位）；选区带＝anchor..cursor 区间
/// 反色底（先带后文——绘制序确定性）。
export function drawInputC(c: Ref<Canvas>, inp: Ref<Input>): void {
    paintFillRect(c, inp.x, inp.y, inp.w, 18, 0xFFFFFF);
    paintStrokeRect(c, inp.x, inp.y, inp.w, 18, 0x000000);
    const lo: int = inputSelLo(inp);
    if (inp.focused && lo >= 0) {
        const hi: int = inputSelHi(inp);
        const bx: int = inp.x + 3 + inputPrefixWidth(c, inp, lo);
        const bw: int = inputPrefixWidth(c, inp, hi) - inputPrefixWidth(c, inp, lo);
        paintFillRect(c, bx, inp.y + 2, bw, 14, 0x3A3A6A);
    }
    paintText(c, inp.x + 3, inp.y + 4, 0x000000, inputValue(inp));
    if (inp.focused) {
        // 光标闪烁（v0.1.4 反馈 #7/#8）：相位＝(动画毫秒/530)%2——真窗真实
        // 时间（鼠标事件风暴不改变闪烁速率——deltaTime 语义）；脚本/重放
        // 虚拟毫秒 32/帧（≈17 帧半周期），相位＝帧号纯函数（golden 可锚）。
        const anim: int = guiQuery(CAP_ANIM_MS);
        if ((anim / 530) % 2 == 0) {
            const cw: int = inputPrefixWidth(c, inp, inp.cursor);
            paintFillRect(c, inp.x + 4 + cw, inp.y + 3, 2, 12, 0x2A2A4A);
        }
    }
}

export function drawList(h: int, l: Ref<ListWidget>, rowH: int): void {
    const frame = box(l.id, l.x, l.y, l.w, rowH * listLen(l.items), 0xFAFAFA);
    drawBox(h, frame);
    let i: int = 0;
    while (i < listLen(l.items)) {
        const row = text(l.id, l.x + 3, l.y + 4 + i * rowH, listTryGet(l.items, i) catch "");
        drawText(h, row);
        i = i + 1;
    }
}

// —— 命中测试（组件 id 判定——std/events target 键分发的数据面）——

export function hitButton(b: Ref<Button>, px: int, py: int): bool {
    return px >= b.x && px < b.x + b.w && py >= b.y && py < b.y + b.h;
}

// ============================================================================
// T1 —— 纯框架五件（checkbox/radioGroup/progress/dropdown/separator+
// groupBox；全部零引擎依赖——绘制走 Canvas，事件走既有 MOUSE_DOWN 面）
// ============================================================================

const CHECK_SIZE: int = 12;

/// 复选框（方框＋勾选态；点击翻转由 app 层 onChange 装配——gui/app.onCheck）。
export struct Checkbox {
    id: int,
    x: int,
    y: int,
    label: string,
    checked: bool,
    hovered: bool,
}

export function checkbox(id: int, x: int, y: int, label: string, checked: bool): Ref<Checkbox> {
    return new Checkbox { id: id, x: x, y: y, label: label, checked: checked, hovered: false };
}

export function drawCheckbox(c: Ref<Canvas>, cb: Ref<Checkbox>): void {
    let bg: int = 0xFFFFFF;
    if (cb.hovered && !cb.checked) {
        bg = 0xE8E8F4;
    }
    paintFillRect(c, cb.x, cb.y, CHECK_SIZE, CHECK_SIZE, bg);
    paintStrokeRect(c, cb.x, cb.y, CHECK_SIZE, CHECK_SIZE, 0x000000);
    if (cb.checked) {
        paintFillRect(c, cb.x + 2, cb.y + 2, CHECK_SIZE - 4, CHECK_SIZE - 4, 0x106020);
        paintLine(c, cb.x + 3, cb.y + 6, cb.x + 5, cb.y + 8, 0xFFFFFF);
        paintLine(c, cb.x + 5, cb.y + 8, cb.x + 9, cb.y + 3, 0xFFFFFF);
    }
    paintText(c, cb.x + CHECK_SIZE + 4, cb.y + 2, 0xD8DCE8, cb.label);
}

/// 命中＝方框＋标签整行（标签宽按块轨度量——hit 面与绘制轨解耦的确定性
/// 约定，双轨一致）。
export function hitCheckbox(cb: Ref<Checkbox>, px: int, py: int): bool {
    const w: int = CHECK_SIZE + 4 + len(cb.label) * 8;
    return px >= cb.x && px < cb.x + w && py >= cb.y && py < cb.y + CHECK_SIZE;
}

const RADIO_BOX: int = 11;
const RADIO_ROW_H: int = 16; // 反馈 #3：真实文本轨 14px 字形行距升档（原按 8×10 占位字模定 14）

/// 单选组（互斥单选；**圆以线绘八边形近似**——surface 无圆弧原语，确定性
/// 无碍；engine arc 登记可选优化位与 setClip 同款纪律不预扩）。
export struct RadioGroup {
    id: int,
    x: int,
    y: int,
    items: List<string>,
    selected: int, // -1＝无选中
    hovered: int, // hover 行（-1＝无）
}

export function radioGroup(id: int, x: int, y: int, items: List<string>, selected: int): Ref<RadioGroup> {
    return new RadioGroup { id: id, x: x, y: y, items: items, selected: selected, hovered: -1 };
}

function radioOctagon(c: Ref<Canvas>, ox: int, oy: int, color: int): void {
    // 11×11 盒内八边形（顶点序闭合——线绘近似圆）。
    const x0: int = ox + 3;
    const x1: int = ox + 7;
    const x2: int = ox + 10;
    const xm: int = ox;
    const y0: int = oy + 3;
    const y1: int = oy + 7;
    const y2: int = oy + 10;
    const ym: int = oy;
    paintLine(c, x0, ym, x1, ym, color);
    paintLine(c, x1, ym, x2, y0, color);
    paintLine(c, x2, y0, x2, y1, color);
    paintLine(c, x2, y1, x1, y2, color);
    paintLine(c, x1, y2, x0, y2, color);
    paintLine(c, x0, y2, xm, y1, color);
    paintLine(c, xm, y1, xm, y0, color);
    paintLine(c, xm, y0, x0, ym, color);
}

export function drawRadioGroup(c: Ref<Canvas>, rg: Ref<RadioGroup>): void {
    let i: int = 0;
    while (i < listLen(rg.items)) {
        const oy: int = rg.y + i * RADIO_ROW_H + (RADIO_ROW_H - RADIO_BOX) / 2;
        if (i == rg.hovered) {
            paintFillRect(c, rg.x, rg.y + i * RADIO_ROW_H, 240, RADIO_ROW_H, 0xE8E8F4);
        }
        radioOctagon(c, rg.x, oy, 0x000000);
        if (i == rg.selected) {
            paintFillRect(c, rg.x + 3, oy + 3, 5, 5, 0x106020);
        }
        paintText(c, rg.x + RADIO_BOX + 5, oy + 2, 0xD8DCE8, listTryGet(rg.items, i) catch "");
        i = i + 1;
    }
}

/// 命中＝行下标（越界/行外得 -1）。
export function hitRadioGroup(rg: Ref<RadioGroup>, px: int, py: int): int {
    if (px < rg.x) {
        return -1;
    }
    const rel: int = py - rg.y;
    if (rel < 0) {
        return -1;
    }
    const idx: int = rel / RADIO_ROW_H;
    if (idx >= listLen(rg.items)) {
        return -1;
    }
    return idx;
}

/// 互斥选择（越界忽略——结构化面）。
export function radioSelect(rg: Ref<RadioGroup>, idx: int): void {
    if (idx < 0 || idx >= listLen(rg.items)) {
        return;
    }
    rg.selected = idx;
}

const PROGRESS_H: int = 12;

/// 进度条（value∈[0,max] 确定态；value<0 不确定态＝静态条纹——确定性优先，
/// 无动画相位输入不入 golden）。
export struct ProgressBar {
    id: int,
    x: int,
    y: int,
    w: int,
    value: int,
    max: int,
}

export function progress(id: int, x: int, y: int, w: int, value: int, max: int): Ref<ProgressBar> {
    return new ProgressBar { id: id, x: x, y: y, w: w, value: value, max: max };
}

export function drawProgress(c: Ref<Canvas>, pb: Ref<ProgressBar>): void {
    paintFillRect(c, pb.x, pb.y, pb.w, PROGRESS_H, 0xFFFFFF);
    paintStrokeRect(c, pb.x, pb.y, pb.w, PROGRESS_H, 0x000000);
    if (pb.value < 0 || pb.max <= 0) {
        // 不确定态：条纹行进（动画毫秒相位——64ms 行进 1px，控件内裁剪
        // 手描；确定性同光标闪烁注记）。
        const off: int = (guiQuery(CAP_ANIM_MS) / 64) % 12;
        let sx: int = pb.x + 2 - off;
        const end: int = pb.x + pb.w - 2;
        while (sx < end) {
            let x0: int = sx;
            if (x0 < pb.x + 2) {
                x0 = pb.x + 2;
            }
            let x1: int = sx + 6;
            if (x1 > end) {
                x1 = end;
            }
            if (x1 > x0) {
                paintFillRect(c, x0, pb.y + 2, x1 - x0, PROGRESS_H - 4, 0x2A6AC0);
            }
            sx = sx + 12;
        }
        return;
    }
    let v: int = pb.value;
    if (v > pb.max) {
        v = pb.max;
    }
    const fw: int = (pb.w - 4) * v / pb.max;
    paintFillRect(c, pb.x + 2, pb.y + 2, fw, PROGRESS_H - 4, 0x2A6AC0);
}

const DROPDOWN_ROW_H: int = 16; // 反馈 #3：同上（原 12）
const DROPDOWN_FIELD_H: int = 18;

/// 下拉选择（收起＝字段＋箭头；展开＝复用行列表＋选中回填——既有 list
/// 形态的组合兑现）。
export struct Dropdown {
    id: int,
    x: int,
    y: int,
    w: int,
    items: List<string>,
    selected: int,
    open: bool,
}

export function dropdown(id: int, x: int, y: int, w: int, items: List<string>, selected: int): Ref<Dropdown> {
    return new Dropdown { id: id, x: x, y: y, w: w, items: items, selected: selected, open: false };
}

export function drawDropdown(c: Ref<Canvas>, dd: Ref<Dropdown>): void {
    paintFillRect(c, dd.x, dd.y, dd.w, DROPDOWN_FIELD_H, 0xFFFFFF);
    paintStrokeRect(c, dd.x, dd.y, dd.w, DROPDOWN_FIELD_H, 0x000000);
    const cur: string = listTryGet(dd.items, dd.selected) catch "";
    paintText(c, dd.x + 3, dd.y + 4, 0x000000, cur);
    // 箭头（v 形两线）。
    const ax: int = dd.x + dd.w - 12;
    const ay: int = dd.y + 7;
    paintLine(c, ax, ay, ax + 4, ay + 4, 0x000000);
    paintLine(c, ax + 4, ay + 4, ax + 8, ay, 0x000000);
}

/// 下拉展开列表（**浮层位**——v0.1.4 反馈 #5：合并绘制使列表被渲染序在后
/// 的组件覆盖，"下拉选项显示在输入框下面"。展开列表＝浮层：调用方须在
/// 一切同级组件之后绘（drawDropdownList → tooltip → 模态的浮层序）；
/// 收起态 no-op。命中面 hitDropdown 不变）。
export function drawDropdownList(c: Ref<Canvas>, dd: Ref<Dropdown>): void {
    if (!dd.open) {
        return;
    }
    const rows: int = listLen(dd.items);
    paintFillRect(c, dd.x, dd.y + DROPDOWN_FIELD_H, dd.w, rows * DROPDOWN_ROW_H, 0xFFFFFF);
    paintStrokeRect(c, dd.x, dd.y + DROPDOWN_FIELD_H, dd.w, rows * DROPDOWN_ROW_H, 0x000000);
    let i: int = 0;
    while (i < rows) {
        const ry: int = dd.y + DROPDOWN_FIELD_H + i * DROPDOWN_ROW_H;
        if (i == dd.selected) {
            paintFillRect(c, dd.x + 1, ry + 1, dd.w - 2, DROPDOWN_ROW_H - 1, 0x30305A);
            paintText(c, dd.x + 3, ry + 2, 0xFFFFFF, listTryGet(dd.items, i) catch "");
        } else {
            paintText(c, dd.x + 3, ry + 2, 0x000000, listTryGet(dd.items, i) catch "");
        }
        i = i + 1;
    }
}

/// 命中码：-2＝域外；-1＝字段（展开/收起切换区）；≥0＝展开态条目行。
export function hitDropdown(dd: Ref<Dropdown>, px: int, py: int): int {
    if (px < dd.x || px >= dd.x + dd.w) {
        return -2;
    }
    if (py >= dd.y && py < dd.y + DROPDOWN_FIELD_H) {
        return -1;
    }
    if (!dd.open) {
        return -2;
    }
    const rel: int = py - (dd.y + DROPDOWN_FIELD_H);
    if (rel < 0) {
        return -2;
    }
    const idx: int = rel / DROPDOWN_ROW_H;
    if (idx >= listLen(dd.items)) {
        return -2;
    }
    return idx;
}

export function dropdownToggle(dd: Ref<Dropdown>): void {
    dd.open = !dd.open;
}

/// 选中回填（收起面板；越界忽略）。
export function dropdownSelect(dd: Ref<Dropdown>, idx: int): void {
    if (idx < 0 || idx >= listLen(dd.items)) {
        return;
    }
    dd.selected = idx;
    dd.open = false;
}

/// 分隔线（双色调线——亮上暗下；无状态结构件，函数形态）。
export function drawSeparator(c: Ref<Canvas>, x: int, y: int, w: int): void {
    paintFillRect(c, x, y, w, 1, 0x9090A8);
    paintFillRect(c, x, y + 1, w, 1, 0x40404A);
}

/// 分组框（边框＋标题——顶边在标题处留隙：8px＋标题宽＋8px）。
export struct GroupBox {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    title: string,
}

export function groupBox(id: int, x: int, y: int, w: int, h: int, title: string): Ref<GroupBox> {
    return new GroupBox { id: id, x: x, y: y, w: w, h: h, title: title };
}

export function drawGroupBox(c: Ref<Canvas>, gb: Ref<GroupBox>): void {
    const tw: int = paintTextWidth(c, gb.title);
    const gap0: int = gb.x + 8;
    const gap1: int = gap0 + tw + 8;
    // 顶边两段（标题留隙）。
    paintFillRect(c, gb.x, gb.y, 8, 1, 0x606078);
    paintFillRect(c, gap1, gb.y, gb.x + gb.w - gap1, 1, 0x606078);
    // 其余三边。
    paintFillRect(c, gb.x, gb.y + gb.h - 1, gb.w, 1, 0x606078);
    paintFillRect(c, gb.x, gb.y, 1, gb.h, 0x606078);
    paintFillRect(c, gb.x + gb.w - 1, gb.y, 1, gb.h, 0x606078);
    paintText(c, gap0, gb.y - 5, 0xD8DCE8, gb.title);
}

// ============================================================================
// T2 配套数据面 —— slider/tooltip（事件会话装配在 gui/app——pump 单点）
// ============================================================================

const SLIDER_KNOB_W: int = 8;

/// 滑杆（min..max 线性映射；拖拽会话＝pump 三通道分诊的 down 锚定→move
/// 跟踪→up 提交；onChange 由 gui/app.sliderOnEvents 装配）。
export struct Slider {
    id: int,
    x: int,
    y: int,
    w: int,
    min: int,
    max: int,
    value: int,
    dragging: bool,
}

export function slider(id: int, x: int, y: int, w: int, min: int, max: int, value: int): Ref<Slider> {
    return new Slider { id: id, x: x, y: y, w: w, min: min, max: max, value: value, dragging: false };
}

export function drawSlider(c: Ref<Canvas>, s: Ref<Slider>): void {
    const cy: int = s.y + 7;
    paintFillRect(c, s.x, cy, s.w, 4, 0x9090A8);
    const knobX: int = sliderKnobX(s);
    paintFillRect(c, s.x, cy, knobX - s.x, 4, 0x2A6AC0);
    paintFillRect(c, knobX, s.y, SLIDER_KNOB_W, 18, 0x2A2A4A);
    paintStrokeRect(c, knobX, s.y, SLIDER_KNOB_W, 18, 0x000000);
}

function sliderKnobX(s: Ref<Slider>): int {
    const span: int = s.max - s.min;
    let v: int = s.value;
    if (v < s.min) {
        v = s.min;
    }
    if (v > s.max) {
        v = s.max;
    }
    if (span <= 0) {
        return s.x;
    }
    return s.x + (s.w - SLIDER_KNOB_W) * (v - s.min) / span;
}

/// 命中＝整杆带（y±10 热区——拖拽体验面；边界含 w 两端）。
export function hitSlider(s: Ref<Slider>, px: int, py: int): bool {
    return px >= s.x && px < s.x + s.w && py >= s.y - 4 && py < s.y + 22;
}

/// 由指针 x 换算值（拖拽会话的 move/up 提交换算；结果夹取 [min,max]）。
export function sliderValueAt(s: Ref<Slider>, px: int): int {
    const span: int = s.max - s.min;
    if (span <= 0 || s.w <= SLIDER_KNOB_W) {
        return s.min;
    }
    let rel: int = px - s.x - SLIDER_KNOB_W / 2;
    const track: int = s.w - SLIDER_KNOB_W;
    if (rel < 0) {
        rel = 0;
    }
    if (rel > track) {
        rel = track;
    }
    return s.min + rel * span / track;
}

/// 提示框（hover 延时显示——延时按 pump 拍计数（帧钟），墙钟不入面：
/// 重放/虚拟时钟确定性；纯框架层叠绘）。
export struct Tooltip {
    text: string,
    threshold: int, // 连续 hover 达此拍数即显示
    target: int, // 绑定组件 id（v0.1.4 反馈 #9——tooltipTick 只对绑定目标计数；0＝未绑定恒不显示。提示与控件一一对应——任意 hover 弹提示会让提示文本答非所问）
    cur: int, // 当前 hover 目标 id
    count: int, // 连续拍数
    x: int,
    y: int, // 显示位（=hover 指针位）
}

export function tooltip(text: string, threshold: int): Ref<Tooltip> {
    return new Tooltip { text: text, threshold: threshold, target: 0, cur: 0, count: 0, x: 0, y: 0 };
}

export function drawTooltip(c: Ref<Canvas>, t: Ref<Tooltip>): void {
    const tw: int = paintTextWidth(c, t.text);
    paintFillRect(c, t.x + 8, t.y + 8, tw + 10, 14, 0x30305A);
    paintStrokeRect(c, t.x + 8, t.y + 8, tw + 10, 14, 0x000000);
    paintText(c, t.x + 13, t.y + 10, 0xFFFFFF, t.text);
}

// ============================================================================
// T3 —— 结构件（scrollContainer 裁剪／multiline 折行／app-drawn 模态）
// ============================================================================

const SCROLLBAR_W: int = 6;

/// 滚动视图（scrollContainer 数据面：children 以绘制回调表达——异构控件
/// 列表经闭包捕获装配；裁剪纪律在 scrollDraw 的子画布上兑现）。
export struct ScrollView {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    content_h: int,
    scroll_y: int,
    dragging: bool,
    last_y: int,
}

export function scrollView(id: int, x: int, y: int, w: int, h: int, content_h: int): Ref<ScrollView> {
    return new ScrollView { id: id, x: x, y: y, w: w, h: h, content_h: content_h, scroll_y: 0, dragging: false, last_y: 0 };
}

/// 滚动夹取（content 不足一屏时恒 0）。
export function scrollClamp(v: Ref<ScrollView>): void {
    const limit: int = v.content_h - v.h;
    if (limit <= 0) {
        v.scroll_y = 0;
        return;
    }
    if (v.scroll_y < 0) {
        v.scroll_y = 0;
    }
    if (v.scroll_y > limit) {
        v.scroll_y = limit;
    }
}

/// 滚动容器绘制：子画布（clip＝视图矩形−滚动条带，off＝−scroll_y）上执行
/// children 绘制回调——容器内一切绘制调用经 Canvas 判界（框架级裁剪，
/// engine setClip 为可选优化位）；右侧比例滚动条随绘。
export function scrollDraw(c: Ref<Canvas>, v: Ref<ScrollView>, drawChildren: (Ref<Canvas>) => void): void {
    const viewC: Ref<Canvas> = canvasClip(c, v.x, v.y, v.w - SCROLLBAR_W, v.h);
    const contentC: Ref<Canvas> = canvasOffset(viewC, 0, -v.scroll_y);
    drawChildren(contentC);
    // 滚动条（比例拇指）。
    paintFillRect(c, v.x + v.w - SCROLLBAR_W, v.y, SCROLLBAR_W, v.h, 0xE0E0E8);
    const t = scrollThumb(v);
    if (t.h > 0) {
        paintFillRect(c, v.x + v.w - SCROLLBAR_W + 1, v.y + t.y, SCROLLBAR_W - 2, t.h, 0x9090A8);
    }
}

/// 空 children 回调（scrollDrawSimple 内部消费——调用方零样板）。
function scrollNoChildren(c: Ref<Canvas>): void {
    c;
}

/// 两参滚动绘制（DX 清偿 #6③——实战登记"无 children 场景
/// 仍需空回调样板"的根治）：内容恒静态仅滚动条的场景免传回调。绘制行为
/// 与 scrollDraw(c, v, 空回调) 逐位一致。
export function scrollDrawSimple(c: Ref<Canvas>, v: Ref<ScrollView>): void {
    scrollDraw(c, v, scrollNoChildren);
}

struct ScrollThumb {
    y: int,
    h: int,
}

function scrollThumb(v: Ref<ScrollView>): ScrollThumb {
    if (v.content_h <= v.h || v.h <= 0) {
        return ScrollThumb { y: 0, h: 0 };
    }
    const th: int = v.h * v.h / v.content_h;
    const limit: int = v.content_h - v.h;
    let sy: int = v.scroll_y;
    if (sy > limit) {
        sy = limit;
    }
    if (sy < 0) {
        sy = 0;
    }
    const ty: int = (v.h - th) * sy / limit;
    return ScrollThumb { y: ty, h: th };
}

/// 滚动条拇指命中（拖拽会话的 down 锚定区）。
export function hitScrollbar(v: Ref<ScrollView>, px: int, py: int): bool {
    if (px < v.x + v.w - SCROLLBAR_W || px >= v.x + v.w) {
        return false;
    }
    if (py < v.y || py >= v.y + v.h) {
        return false;
    }
    const t = scrollThumb(v);
    if (t.h <= 0) {
        return false;
    }
    return py >= v.y + t.y && py < v.y + t.y + t.h;
}

/// 逐字符折行（贪心：超宽即断行；**基础字符集逐字节语义**——多字节码点
/// 折行登记门控后续项随修饰键面同批）。
export function wrapText(c: Ref<Canvas>, body: string, max_w: int): List<string> {
    const lines: List<string> = listNew();
    let line: string = "";
    let i: int = 0;
    while (i < len(body)) {
        const j: int = cpNext(body, i);
        const ch: string = byteSlice(body, i, j);
        if (paintTextWidth(c, line + ch) > max_w && len(line) > 0) {
            listPush(lines, line);
            line = ch;
        } else {
            line = line + ch;
        }
        i = j;
    }
    listPush(lines, line);
    return lines;
}

/// 多行文本绘制（按 paintTextWidth 折行；返回占用高度）。
export function drawMultiline(c: Ref<Canvas>, x: int, y: int, max_w: int, line_h: int, body: string, color: int): int {
    const lines: List<string> = wrapText(c, body, max_w);
    let i: int = 0;
    while (i < listLen(lines)) {
        paintText(c, x, y + i * line_h, color, listTryGet(lines, i) catch "");
        i = i + 1;
    }
    return listLen(lines) * line_h;
}

/// 应用内模态对话框（**app-drawn——不走 OS 原生弹窗**：确定性可 golden、
/// 跨平台零分叉；模态事件环在 gui/app.pump——模态激活期吞掉一切事件）。
export struct MessageBox {
    title: string,
    body: string,
    buttons: List<string>,
    result: int, // -1＝未决/取消；≥0＝按钮下标
    active: bool,
    x: int,
    y: int,
    w: int,
    h: int,
    zones: List<Ref<HitZone>>, // 按钮命中区（drawModal 布局时重建）
}

/// App 域位哑值（inactive——appNew 的模态缺省）。
export function messageBoxDefault(): Ref<MessageBox> {
    return new MessageBox { title: "", body: "", buttons: listNew(), result: -1, active: false, x: 0, y: 0, w: 0, h: 0, zones: listNew() };
}

/// 模态构造（即构造即激活；result 待决 -1）。
export function messageBox(title: string, body: string, buttons: List<string>): Ref<MessageBox> {
    return new MessageBox { title: title, body: body, buttons: buttons, result: -1, active: true, x: 0, y: 0, w: 0, h: 0, zones: listNew() };
}

// —— table×scrollContainer 滚动整合：行视窗渲染
// 〔content_h＝表头＋row_h×行数；可见行切片＝scroll_y/row_h 起、视窗高内
// 止——首行截断对齐〕＋表头固定（不随 scroll_y 平移）＋滚动条复用
// ScrollView（拖拽/点击经既有 scrollOnEvents——零新事件 kind）。——
export const TSC_HEADER_H: int = 16;

/// 整合绘制：500 行级表在视窗内只画可见行切片；表头恒绘于视窗顶。
/// cols 为列宽数组；rowText 由调用方按（行,列）供给单元格文本。
export function drawTableScroll(c: Ref<Canvas>, v: Ref<ScrollView>, cols: List<int>, n_rows: int, row_h: int, rowText: (int, int) => string): void {
    const view_w: int = v.w - SCROLLBAR_W;
    const grid_c: Ref<Canvas> = canvasClip(c, v.x, v.y, view_w, v.h);
    // 表头（固定——不随滚动平移）。
    paintFillRect(grid_c, 0, 0, view_w, TSC_HEADER_H, 0xE8E8F0);
    let cx: int = 0;
    let ci: int = 0;
    while (ci < listLen(cols)) {
        const cw: int = listTryGet(cols, ci) catch 0;
        const cellC: Ref<Canvas> = canvasClip(grid_c, cx, 0, cw, TSC_HEADER_H);
        paintText(cellC, 4, 3, 0x000000, "col" + toStr(ci));
        cx = cx + cw;
        ci = ci + 1;
    }
    paintFillRect(grid_c, 0, TSC_HEADER_H - 1, view_w, 1, 0x000000);
    // 可见行切片：first＝scroll_y/row_h；首行截断对齐＝负向偏移取模。
    const first: int = v.scroll_y / row_h;
    const off_y: int = TSC_HEADER_H - (v.scroll_y % row_h);
    const n_vis: int = (v.h - TSC_HEADER_H) / row_h + 2;
    let r: int = 0;
    while (r <= n_vis) {
        const row: int = first + r;
        if (row >= n_rows) {
            break;
        }
        const ry: int = off_y + r * row_h;
        if (ry + row_h <= TSC_HEADER_H) {
            r = r + 1;
            continue;
        }
        const rowC: Ref<Canvas> = canvasClip(grid_c, 0, ry, view_w, row_h);
        cx = 0;
        ci = 0;
        while (ci < listLen(cols)) {
            const cw: int = listTryGet(cols, ci) catch 0;
            const cellC: Ref<Canvas> = canvasClip(rowC, cx, 0, cw, row_h);
            paintText(cellC, 4, 2, 0x000000, rowText(row, ci));
            cx = cx + cw;
            ci = ci + 1;
        }
        paintFillRect(grid_c, 0, ry + row_h - 1, view_w, 1, 0xD0D0D8);
        r = r + 1;
    }
    // 滚动条（复用 ScrollView 比例拇指面——绘制与拖拽/点击同源）。
    paintFillRect(c, v.x + v.w - SCROLLBAR_W, v.y, SCROLLBAR_W, v.h, 0xE0E0E8);
}

// —— tree 树形控件：扁平先序节点模型〔label＋depth
// ＋branch〕＋展开态表〔分支节点逐位〕；可见行推导＝折叠子树剔除（depth
// 扫描——折叠节点 i 后所有 depth＞node.depth 的后继剔至首个 ≤ 者为止）；
// 行选中＋缩进层级渲染＋分支符号 +/-；滚动复用＝ScrollView 视窗内绘制
//（调用方以 canvasClip/scrollDraw 装配——本控件只画可见带）。——
export struct TreeNode {
    label: string,
    depth: int,
    branch: bool, // 有子节点（可展开/折叠）
}

export struct Tree {
    id: int,
    x: int,
    y: int,
    w: int,
    row_h: int,
    nodes: List<Ref<TreeNode>>, // 全量扁平节点（先序）
    expanded: List<bool>, // 分支展开态（branch 节点序——与 nodes 同序号）
    selected: int, // 可见行下标（-1 无）
}

export function treeNew(id: int, x: int, y: int, w: int, nodes: List<Ref<TreeNode>>): Ref<Tree> {
    const t: Ref<Tree> = new Tree { id: id, x: x, y: y, w: w, row_h: 16, nodes: nodes, expanded: listNew(), selected: -1 };
    let i: int = 0;
    while (i < listLen(nodes)) {
        const n = listTryGet(nodes, i) catch new TreeNode { label: "", depth: 0, branch: false };
        listPush(t.expanded, n.branch);
        i = i + 1;
    }
    return t;
}

/// 可见行推导：返回可见节点下标 List（int）——折叠子树剔除。
export function treeVisible(t: Ref<Tree>): List<int> {
    const vis: List<int> = listNew();
    let hide_depth: int = -1; // -1＝无折叠压制
    let i: int = 0;
    while (i < listLen(t.nodes)) {
        const n = listTryGet(t.nodes, i) catch new TreeNode { label: "", depth: 0, branch: false };
        if (hide_depth >= 0 && n.depth > hide_depth) {
            i = i + 1;
            continue;
        }
        hide_depth = -1;
        listPush(vis, i);
        if (n.branch) {
            const ex = listTryGet(t.expanded, i) catch false;
            if (!ex) {
                hide_depth = n.depth; // 折叠：压制更深后继
            }
        }
        i = i + 1;
    }
    return vis;
}

/// 分支展开态翻转（可见行下标 → 节点下标）。
export function treeToggle(t: Ref<Tree>, vis: List<int>, row: int): void {
    const ni = listTryGet(vis, row) catch -1;
    if (ni < 0) {
        return;
    }
    const n = listTryGet(t.nodes, ni) catch new TreeNode { label: "", depth: 0, branch: false };
    if (!n.branch) {
        return;
    }
    const ex = listTryGet(t.expanded, ni) catch false;
    listSet(t.expanded, ni, !ex);
}

/// 树绘制（可见行：缩进 depth×14＋分支符号＋标签；选中行反色带）。
export function drawTreeC(c: Ref<Canvas>, t: Ref<Tree>): void {
    const vis: List<int> = treeVisible(t);
    let r: int = 0;
    while (r < listLen(vis)) {
        const ni = listTryGet(vis, r) catch 0;
        const n = listTryGet(t.nodes, ni) catch new TreeNode { label: "", depth: 0, branch: false };
        const ry: int = t.y + r * t.row_h;
        if (r == t.selected) {
            paintFillRect(c, t.x, ry, t.w, t.row_h, 0x3A3A6A);
        }
        const indent: int = t.x + 2 + n.depth * 14;
        let glyph: string = "  ";
        if (n.branch) {
            const ex = listTryGet(t.expanded, ni) catch false;
            if (ex) {
                glyph = "- ";
            } else {
                glyph = "+ ";
            }
        }
        paintText(c, indent, ry + 2, 0x000000, glyph + n.label);
        r = r + 1;
    }
}

/// 树命中（px,py → 可见行下标；区外 -1）。
export function treeHit(t: Ref<Tree>, px: int, py: int): int {
    if (px < t.x || px >= t.x + t.w || py < t.y) {
        return -1;
    }
    const row: int = (py - t.y) / t.row_h;
    const vis: List<int> = treeVisible(t);
    if (row < 0 || row >= listLen(vis)) {
        return -1;
    }
    return row;
}

// —— popup 弹出菜单：自绘浮层〔menu 条目行列表——
// 点击选中即关；浮层外点击取消〕＋pump 拦截消费面在 gui/app（modal 先例）；
// 右键上下文/下拉两形态均以 popupOpen(x,y) 表达（触发点由调用方决定）——
// 零新事件 kind：点击/关闭皆既有 kind 值域，重放确定性可 golden。——
export struct Popup {
    id: int,
    x: int,
    y: int,
    w: int,
    row_h: int,
    items: List<string>,
    active: bool,
    result: int, // -1＝未决/取消；≥0＝条目下标
}

/// 浮层构造（即构造即激活；result 待决 -1）。行高 16、宽取最长条目＋24
///（绘制面 drawPopupC 同式——布局单点）。
export function popupNew(id: int, x: int, y: int, items: List<string>): Ref<Popup> {
    // active=false 构造（popupOpen 置位——打开点击本身须先达触发组件，
    // 浮层自下一事件起拦截；缺省激活会吞掉打开点击）。
    const p: Ref<Popup> = new Popup { id: id, x: x, y: y, w: 120, row_h: 16, items: items, active: false, result: -1 };
    return p;
}

/// 浮层命中（行下标；浮层外 -1）。
export function popupHit(p: Ref<Popup>, px: int, py: int): int {
    if (px < p.x || px >= p.x + p.w || py < p.y || py >= p.y + p.row_h * listLen(p.items)) {
        return -1;
    }
    return (py - p.y) / p.row_h;
}

/// 浮层绘制（边框＋逐行文本＋两像素行隙；确定性展开）。
export function drawPopupC(c: Ref<Canvas>, p: Ref<Popup>): void {
    const h: int = p.row_h * listLen(p.items) + 4;
    paintFillRect(c, p.x, p.y, p.w, h, 0xFAFAFA);
    paintStrokeRect(c, p.x, p.y, p.w, h, 0x000000);
    let i: int = 0;
    while (i < listLen(p.items)) {
        paintText(c, p.x + 6, p.y + 3 + i * p.row_h, 0x000000, listTryGet(p.items, i) catch "");
        i = i + 1;
    }
}

const MB_TITLE_H: int = 16;
const MB_LINE_H: int = 12;
const MB_BTN_H: int = 18;

/// 模态绘制：压暗全画布＋居中对话框（标题条/正文折行/按钮行）＋按钮命中
/// 区重建（draw→hit 的布局单点）。
export function drawModal(c: Ref<Canvas>, m: Ref<MessageBox>): void {
    paintFillRect(c, c.clip_x, c.clip_y, c.clip_w, c.clip_h, 0x000000);
    // 正文折行宽（画布约束内）。
    let body_w: int = c.clip_w - 60;
    if (body_w > 200) {
        body_w = 200;
    }
    const probe: Ref<Canvas> = canvasClip(c, 0, 0, c.clip_w, c.clip_h);
    const lines: List<string> = wrapText(probe, m.body, body_w - 16);
    let text_w: int = paintTextWidth(probe, m.title);
    let i: int = 0;
    while (i < listLen(lines)) {
        const lw: int = paintTextWidth(probe, listTryGet(lines, i) catch "");
        if (lw > text_w) {
            text_w = lw;
        }
        i = i + 1;
    }
    // 按钮行宽（右对齐布局）。
    let btns_w: int = 0;
    i = 0;
    while (i < listLen(m.buttons)) {
        btns_w = btns_w + paintTextWidth(probe, listTryGet(m.buttons, i) catch "") + 24;
        i = i + 1;
    }
    let w: int = text_w + 28;
    if (btns_w + 16 > w) {
        w = btns_w + 16;
    }
    if (w < 160) {
        w = 160;
    }
    if (w > c.clip_w - 20) {
        w = c.clip_w - 20;
    }
    const h: int = MB_TITLE_H + 10 + listLen(lines) * MB_LINE_H + 10 + MB_BTN_H + 10;
    const dx: int = c.clip_x + (c.clip_w - w) / 2;
    const dy: int = c.clip_y + (c.clip_h - h) / 2;
    m.x = dx;
    m.y = dy;
    m.w = w;
    m.h = h;
    paintFillRect(c, dx, dy, w, h, 0xFFFFFF);
    paintStrokeRect(c, dx, dy, w, h, 0x000000);
    paintFillRect(c, dx + 1, dy + 1, w - 2, MB_TITLE_H - 2, 0x30305A);
    paintText(c, dx + 6, dy + 3, 0xFFFFFF, m.title);
    i = 0;
    while (i < listLen(lines)) {
        paintText(c, dx + 8, dy + MB_TITLE_H + 8 + i * MB_LINE_H, 0x000000, listTryGet(lines, i) catch "");
        i = i + 1;
    }
    // 按钮行（右对齐；drawButtonC 复用）＋命中区重建。
    m.zones = listNew();
    let bx: int = dx + w - 8;
    const by: int = dy + h - MB_BTN_H - 8;
    let k: int = listLen(m.buttons) - 1;
    while (k >= 0) {
        const label: string = listTryGet(m.buttons, k) catch "";
        const bw: int = paintTextWidth(probe, label) + 16;
        bx = bx - bw;
        const bb: Ref<Button> = button(k + 1, bx, by, bw, MB_BTN_H, label);
        drawButtonC(c, bb);
        listPush(m.zones, new HitZone { id: k, x: bx, y: by, w: bw, h: MB_BTN_H });
        k = k - 1;
    }
}

/// 模态按钮命中（扫描 drawModal 布局区；未命中 -1）。
export function modalHit(m: Ref<MessageBox>, px: int, py: int): int {
    let i: int = 0;
    while (i < listLen(m.zones)) {
        const z = listTryGet(m.zones, i) catch new HitZone { id: -1, x: 0, y: 0, w: 0, h: 0 };
        if (px >= z.x && px < z.x + z.w && py >= z.y && py < z.y + z.h) {
            return z.id;
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================================
//第二批控件（table/tab）＋frameless 自绘标题栏（TitleBar）
// ============================================================================

const TABLE_HEADER_H: int = 14;
const TABLE_ROW_H: int = 14;
const TABLE_EDGE_GRAB: int = 3; // 列边拖拽热区（指针距分界线 ±px）

/// 表格行（单元格串表——列数由表定义决定，越界列不绘）。
export struct TableRow {
    cells: List<string>,
}

export function tableRow(cells: List<string>): Ref<TableRow> {
    return new TableRow { cells: cells };
}

/// 表格（列头/行/表头带/选中/列宽拖拽；滚动＝scrollContainer 组合）。
/// drag_col≥0 为拖拽会话锚（第 i 条列分界线右侧列），由 app 层 tableOnEvents
/// 经 pump 拖拽会话驱动。
export struct Table {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    cols: List<string>,
    col_ws: List<int>,
    rows: List<Ref<TableRow>>,
    selected: int, // -1＝无选中
    drag_col: int, // -1＝无拖拽
    drag_base_x: int,
    drag_base_w: int,
    hovered: int, // hover 行（-1＝无）
}

export function table(id: int, x: int, y: int, w: int, h: int, cols: List<string>, col_ws: List<int>): Ref<Table> {
    return new Table { id: id, x: x, y: y, w: w, h: h, cols: cols, col_ws: col_ws, rows: listNew(), selected: -1, drag_col: -1, drag_base_x: 0, drag_base_w: 0, hovered: -1 };
}

/// 列 x 起点（第 i 列左缘；越界得表右缘）。
export function tableColX(t: Ref<Table>, idx: int): int {
    let cx: int = t.x;
    let i: int = 0;
    while (i < idx && i < listLen(t.col_ws)) {
        cx = cx + (listTryGet(t.col_ws, i) catch 0);
        i = i + 1;
    }
    return cx;
}

/// 表格绘制：表头带＋网格线＋逐格文本（canvasClip 逐格判界——列宽即裁剪）
/// ＋选中行高亮＋hover 行浅高亮。行高 TABLE_ROW_H、表头 TABLE_HEADER_H。
export function drawTable(c: Ref<Canvas>, t: Ref<Table>): void {
    // 面底＋外框。
    paintFillRect(c, t.x, t.y, t.w, t.h, 0xFFFFFF);
    paintStrokeRect(c, t.x, t.y, t.w, t.h, 0x606078);
    // 表头带。
    paintFillRect(c, t.x + 1, t.y + 1, t.w - 2, TABLE_HEADER_H - 1, 0xE0E0E8);
    // 列：起点、分隔线、表头文本。
    const nrows: int = listLen(t.rows);
    const body_h: int = t.h - TABLE_HEADER_H;
    let cx: int = t.x;
    let i: int = 0;
    while (i < listLen(t.cols)) {
        const cw: int = listTryGet(t.col_ws, i) catch 0;
        const headC: Ref<Canvas> = canvasClip(c, cx, t.y, cw, TABLE_HEADER_H);
        paintText(headC, cx + 3, t.y + 3, 0x000000, listTryGet(t.cols, i) catch "");
        if (i > 0) {
            paintFillRect(c, cx, t.y, 1, t.h, 0xC8C8D4);
        }
        // 行文本（逐格裁剪）。
        let r: int = 0;
        while (r < nrows) {
            const ry: int = t.y + TABLE_HEADER_H + r * TABLE_ROW_H;
            if (r == t.selected) {
                paintFillRect(c, cx + 1, ry, cw - 1, TABLE_ROW_H, 0x30305A);
            } else if (r == t.hovered) {
                paintFillRect(c, cx + 1, ry, cw - 1, TABLE_ROW_H, 0xE8E8F4);
            }
            const row: Ref<TableRow> = listTryGet(t.rows, r) catch tableRow(listNew());
            const cellC: Ref<Canvas> = canvasClip(c, cx, ry, cw, TABLE_ROW_H);
            let color: int = 0x000000;
            if (r == t.selected) {
                color = 0xFFFFFF;
            }
            paintText(cellC, cx + 3, ry + 3, color, listTryGet(row.cells, i) catch "");
            r = r + 1;
        }
        cx = cx + cw;
        i = i + 1;
    }
    // 行分隔线（横线；表头底线加重）。
    paintFillRect(c, t.x + 1, t.y + TABLE_HEADER_H, t.w - 2, 1, 0x9090A8);
    let r: int = 1;
    while (r < nrows) {
        paintFillRect(c, t.x + 1, t.y + TABLE_HEADER_H + r * TABLE_ROW_H, t.w - 2, 1, 0xE8E8EE);
        r = r + 1;
    }
}

/// 行命中（表体区行下标；表头/界外 -1）。
export function hitTableRow(t: Ref<Table>, px: int, py: int): int {
    if (px < t.x || px >= t.x + t.w || py < t.y + TABLE_HEADER_H || py >= t.y + t.h) {
        return -1;
    }
    const idx: int = (py - t.y - TABLE_HEADER_H) / TABLE_ROW_H;
    if (idx >= listLen(t.rows)) {
        return -1;
    }
    return idx;
}

/// 列分界线命中（返回分界线下标 i＝第 i 列右缘；-1 无——拖拽热区 ±TABLE_EDGE_GRAB）。
export function hitTableColEdge(t: Ref<Table>, px: int, py: int): int {
    if (py < t.y || py >= t.y + t.h) {
        return -1;
    }
    let cx: int = t.x;
    let i: int = 0;
    while (i < listLen(t.col_ws) - 1) {
        cx = cx + (listTryGet(t.col_ws, i) catch 0);
        if (px >= cx - TABLE_EDGE_GRAB && px <= cx + TABLE_EDGE_GRAB) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// —— tab 页签（页签带＋内容页切换；内容由调用方按 active 绘制——框架层
//     状态机）——

const TAB_H: int = 18;

/// 页签带（active 高亮；hitTabBar 切换——事件消费在 app 层装配）。
export struct TabBar {
    id: int,
    x: int,
    y: int,
    w: int,
    tabs: List<string>,
    active: int,
}

export function tabBar(id: int, x: int, y: int, w: int, tabs: List<string>, active: int): Ref<TabBar> {
    return new TabBar { id: id, x: x, y: y, w: w, tabs: tabs, active: active };
}

/// 页签宽（均分；页签数为 0 时 0）。
export function tabWidth(tb: Ref<TabBar>): int {
    const n: int = listLen(tb.tabs);
    if (n == 0) {
        return 0;
    }
    return tb.w / n;
}

/// 页签带绘制：均分页签；active＝白底黑字＋底部加重线，inactive＝灰底。
export function drawTabBar(c: Ref<Canvas>, tb: Ref<TabBar>): void {
    const tw: int = tabWidth(tb);
    if (tw <= 0) {
        return;
    }
    paintFillRect(c, tb.x, tb.y, tb.w, TAB_H, 0xC8C8D4);
    let i: int = 0;
    while (i < listLen(tb.tabs)) {
        const tx: int = tb.x + i * tw;
        if (i == tb.active) {
            paintFillRect(c, tx, tb.y, tw, TAB_H, 0xFFFFFF);
            paintFillRect(c, tx, tb.y + TAB_H - 2, tw, 2, 0x30305A);
        }
        const labelC: Ref<Canvas> = canvasClip(c, tx, tb.y, tw, TAB_H);
        const label: string = listTryGet(tb.tabs, i) catch "";
        let color: int = 0x40404A;
        if (i == tb.active) {
            color = 0x000000;
        }
        const lw: int = paintTextWidth(c, label);
        paintText(labelC, tx + (tw - lw) / 2, tb.y + 4, color, label);
        i = i + 1;
    }
    paintStrokeRect(c, tb.x, tb.y, tb.w, TAB_H, 0x606078);
}

/// 页签命中（页签下标；带外 -1）。
export function hitTabBar(tb: Ref<TabBar>, px: int, py: int): int {
    if (px < tb.x || px >= tb.x + tb.w || py < tb.y || py >= tb.y + TAB_H) {
        return -1;
    }
    const tw: int = tabWidth(tb);
    if (tw <= 0) {
        return -1;
    }
    const idx: int = (px - tb.x) / tw;
    if (idx >= listLen(tb.tabs)) {
        return -1;
    }
    return idx;
}

// —— TitleBar（frameless 自绘标题栏——：自绘面即内容面，golden
//     逐字节守护；按钮/拖拽区命中＝hitTitleBar 单点；拖拽移动与按钮行为
//     的引擎面在 gui/app——App.titlebar 装配后 pump 拦截）——

const TITLEBAR_H: int = 26;
const TITLEBTN_SIZE: int = 16;

/// 命中码（hitTitleBar 返回；-1＝无）。
export const TITLE_HIT_NONE: int = -1;
export const TITLE_HIT_DRAG: int = 0;
export const TITLE_HIT_CLOSE: int = 1;
export const TITLE_HIT_MAX: int = 2;
export const TITLE_HIT_MIN: int = 3;

export struct TitleBar {
    title: string,
    w: int, // 随帧更新（app.w——drawTitleBar 由 render 每帧调用）
    show_min: bool,
    show_max: bool,
    show_close: bool,
}

export function titleBar(title: string, show_min: bool, show_max: bool, show_close: bool): Ref<TitleBar> {
    return new TitleBar { title: title, w: 0, show_min: show_min, show_max: show_max, show_close: show_close };
}

/// 标题栏按钮几何（自右向左：close/max/min；不可见按钮不占位——返回 x<0）。
function titleBtnX(tb: Ref<TitleBar>, code: int): int {
    let bx: int = tb.w - TITLEBTN_SIZE - 2;
    if (tb.show_close) {
        if (code == TITLE_HIT_CLOSE) {
            return bx;
        }
        bx = bx - TITLEBTN_SIZE - 2;
    }
    if (tb.show_max) {
        if (code == TITLE_HIT_MAX) {
            return bx;
        }
        bx = bx - TITLEBTN_SIZE - 2;
    }
    if (tb.show_min) {
        if (code == TITLE_HIT_MIN) {
            return bx;
        }
    }
    return -1;
}

/// 标题栏绘制（内容面：背景带＋标题文本＋右侧三钮——线绘 ─ □ ×）。
export function drawTitleBar(c: Ref<Canvas>, tb: Ref<TitleBar>): void {
    paintFillRect(c, 0, 0, tb.w, TITLEBAR_H, 0x30305A);
    paintFillRect(c, 0, TITLEBAR_H - 1, tb.w, 1, 0x000000);
    paintText(c, 8, 7, 0xFFFFFF, tb.title);
    // close＝×（两线）；max＝□（空心方）；min＝─（底线）。
    const bx1: int = titleBtnX(tb, TITLE_HIT_CLOSE);
    if (bx1 >= 0) {
        paintStrokeRect(c, bx1, 5, TITLEBTN_SIZE, TITLEBTN_SIZE, 0x50507A);
        paintLine(c, bx1 + 5, 10, bx1 + 10, 15, 0xFFFFFF);
        paintLine(c, bx1 + 10, 10, bx1 + 5, 15, 0xFFFFFF);
    }
    const bx2: int = titleBtnX(tb, TITLE_HIT_MAX);
    if (bx2 >= 0) {
        paintStrokeRect(c, bx2, 5, TITLEBTN_SIZE, TITLEBTN_SIZE, 0x50507A);
        paintStrokeRect(c, bx2 + 5, 9, 7, 7, 0xFFFFFF);
    }
    const bx3: int = titleBtnX(tb, TITLE_HIT_MIN);
    if (bx3 >= 0) {
        paintStrokeRect(c, bx3, 5, TITLEBTN_SIZE, TITLEBTN_SIZE, 0x50507A);
        paintFillRect(c, bx3 + 4, 12, 7, 1, 0xFFFFFF);
    }
}

/// 标题栏命中（按钮区→命中码；标题带其余＝拖拽区 TITLE_HIT_DRAG；带外 NONE）。
export function hitTitleBar(tb: Ref<TitleBar>, px: int, py: int): int {
    if (py < 0 || py >= TITLEBAR_H || px < 0 || px >= tb.w) {
        return TITLE_HIT_NONE;
    }
    if (tb.show_close) {
        const bx: int = titleBtnX(tb, TITLE_HIT_CLOSE);
        if (px >= bx && px < bx + TITLEBTN_SIZE && py >= 5 && py < 5 + TITLEBTN_SIZE) {
            return TITLE_HIT_CLOSE;
        }
    }
    if (tb.show_max) {
        const bx: int = titleBtnX(tb, TITLE_HIT_MAX);
        if (px >= bx && px < bx + TITLEBTN_SIZE && py >= 5 && py < 5 + TITLEBTN_SIZE) {
            return TITLE_HIT_MAX;
        }
    }
    if (tb.show_min) {
        const bx: int = titleBtnX(tb, TITLE_HIT_MIN);
        if (px >= bx && px < bx + TITLEBTN_SIZE && py >= 5 && py < 5 + TITLEBTN_SIZE) {
            return TITLE_HIT_MIN;
        }
    }
    return TITLE_HIT_DRAG;
}

// —— TitleBar（frameless 自绘标题栏——：自绘面即内容面，golden
//     逐字节守护；按钮/拖拽区命中＝hitTitleBar 单点；拖拽移动与按钮行为
//     的引擎面在 gui/app——App.titlebar 装配后 pump 拦截）——
//
// （注：本段注释位置随修复落尾——TITLE_* 常量与 TitleBar/titleBar/
// titleBtnX 定义在上方完好段内。）

// —— 图像（BMP——：引擎侧绑定通道——引擎读二进制并
//     绘制，S1 string 为 UTF-8 文本域不承载二进制；PNG 登记后续）——

import { imageLoad, imageW, imageH, imageFree, surfaceDrawImage } from "gui/surface";

/// 图像控件（handle 由 gui/surface.imageLoad 产生；0＝加载失败的显式错误
/// 面走 tryImage 构造）。
export struct Image {
    id: int,
    handle: int,
    x: int,
    y: int,
    w: int,
    h: int,
}

/// 图像构造（加载失败得 Error——显式通道，红线 5 精神）。
export function tryImage(path: string, x: int, y: int): Ref<Image> | Error {
    const h: int = imageLoad(path);
    if (h <= 0) {
        return err("tryImage: BMP 加载失败（24/32bpp 非压缩限定，路径以测试 cwd 起算）");
    }
    return new Image { id: 0, handle: h, x: x, y: y, w: imageW(h), h: imageH(h) };
}

/// 图像绘制（Canvas 判界：完全出界跳过；部分可见整块交引擎边界裁剪——
/// 位块语义，逐像素裁剪为 engine setClip 同款可选优化位）。
export function drawImage(c: Ref<Canvas>, img: Ref<Image>): void {
    const sx: int = img.x - c.off_x;
    const sy: int = img.y - c.off_y;
    if (sx >= c.clip_x + c.clip_w || sy >= c.clip_y + c.clip_h) {
        return;
    }
    if (sx + img.w <= c.clip_x || sy + img.h <= c.clip_y) {
        return;
    }
    surfaceDrawImage(c.h, img.handle, sx, sy);
}

/// 图像释放（句柄池归还；重复释放安全——宿主面幂等）。
export function imageDispose(img: Ref<Image>): void {
    imageFree(img.handle);
}

import { join } from "std/string";
import { byteSlice } from "./engine/bin";

// ============================================================================
// TextArea —— 多行文本编辑区（§六判据承接）：
// 行结构新控件（非 Input 扩展——Input 单行模型被五示例依赖，不动）：
//   行模型＝List<string>（换行符分割）；光标/选区锚＝(行,列) 二元组，列为行内字节偏移，
//   恒落在 UTF-8 字符边界上（左右移动、退格按整个码位走，上下移动吸附到边界）；
//   滚动跟随＝scroll 顶行随光标行滚出视口即跟随（taScrollFollow）；
//   折行（word wrap）＝评估位在册（按字符列绘制，超宽横滚不在
//   本件；评估触发＝实战反馈）。
// 确定性：绘制为 (lines, cursor, scroll, sel) 纯函数；guiQuery(CAP_ANIM_MS)
// 仅光标闪烁相位（drawInputC 同款 golden 可锚纪律）。
// ============================================================================

export struct TextArea {
    id: int,
    x: int,
    y: int,
    w: int,
    h: int,
    lines: List<string>,
    focused: bool,
    cl: int, // 光标行
    cc: int, // 光标列
    al: int, // 选区锚行（-1＝无选区）
    ac: int, // 选区锚列
    scroll: int, // 视口顶行
    line_h: int,
}

/// 选区归一结果（lo→hi 行列；active＝有非空选区）。
export struct TaSel {
    active: bool,
    ll: int,
    lc: int,
    hl: int,
    hc: int,
}

/// 构造（初始文本按换行符分割入行模型）。
export function textArea(id: int, x: int, y: int, w: int, h: int, text: string): Ref<TextArea> {
    const ta: Ref<TextArea> = new TextArea {
        id: id, x: x, y: y, w: w, h: h,
        lines: listNew(),
        focused: false,
        cl: 0, cc: 0, al: -1, ac: -1,
        scroll: 0,
        line_h: 14,
    };
    taSetText(ta, text);
    return ta;
}

/// 行内按字节偏移取 [a, b)（偏移在字符边界上，与 len、strFind 同一单位）。
export function taSlice(s: string, a: int, b: int): string {
    return byteSlice(s, a, b);
}

function cpCont(s: string, i: int): bool {
    const c: int = byteTryAt(s, i) catch 0;
    return c >= 0x80 && c < 0xC0;
}

/// 字节偏移 c 之前一个码位的起点（c 为 0 时得 0）。
export function cpPrev(s: string, c: int): int {
    let i: int = c - 1;
    while (i > 0 && cpCont(s, i)) {
        i = i - 1;
    }
    if (i < 0) {
        return 0;
    }
    return i;
}

/// 字节偏移 c 之后一个码位的起点（已在串尾得串长）。
export function cpNext(s: string, c: int): int {
    let i: int = c + 1;
    while (i < len(s) && cpCont(s, i)) {
        i = i + 1;
    }
    if (i > len(s)) {
        return len(s);
    }
    return i;
}

/// 列钳到行长并吸附到不大于它的字符边界（上下移动换行后用）。
function taSnapCol(s: string, c: int): int {
    let i: int = c;
    if (i > len(s)) {
        i = len(s);
    }
    while (i > 0 && i < len(s) && cpCont(s, i)) {
        i = i - 1;
    }
    return i;
}

export function taSetText(ta: Ref<TextArea>, text: string): void {
    ta.lines = listNew();
    let start: int = 0;
    let i: int = 0;
    while (i < len(text)) {
        if ((byteTryAt(text, i) catch 10) == 10) {
            listPush(ta.lines, taSlice(text, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    listPush(ta.lines, taSlice(text, start, len(text)));
    ta.cl = 0;
    ta.cc = 0;
    ta.al = -1;
    ta.ac = -1;
    ta.scroll = 0;
}

export function taText(ta: Ref<TextArea>): string {
    return join(ta.lines, "\n");
}

export function taLineLen(ta: Ref<TextArea>, li: int): int {
    const l = listTryGet(ta.lines, li) catch "";
    return len(l);
}

/// 选区归一（无选区/同点位＝active false 且 lo=hi=光标位）。
export function taSel(ta: Ref<TextArea>): TaSel {
    if (ta.al < 0) {
        return TaSel { active: false, ll: ta.cl, lc: ta.cc, hl: ta.cl, hc: ta.cc };
    }
    if (ta.al == ta.cl && ta.ac == ta.cc) {
        return TaSel { active: false, ll: ta.cl, lc: ta.cc, hl: ta.cl, hc: ta.cc };
    }
    if (ta.al < ta.cl || (ta.al == ta.cl && ta.ac < ta.cc)) {
        return TaSel { active: true, ll: ta.al, lc: ta.ac, hl: ta.cl, hc: ta.cc };
    }
    return TaSel { active: true, ll: ta.cl, lc: ta.cc, hl: ta.al, hc: ta.ac };
}

/// 选区删除（active 时删 lo→hi 并合并行；返回是否发生删除）。
export function taDeleteSelection(ta: Ref<TextArea>): bool {
    const sel = taSel(ta);
    if (!sel.active) {
        return false;
    }
    const lo_line = listTryGet(ta.lines, sel.ll) catch "";
    const hi_line = listTryGet(ta.lines, sel.hl) catch "";
    const merged: string = taSlice(lo_line, 0, sel.lc) + taSlice(hi_line, sel.hc, len(hi_line));
    let k: int = sel.hl;
    while (k > sel.ll) {
        listRemoveAt(ta.lines, k);
        k = k - 1;
    }
    listSet(ta.lines, sel.ll, merged);
    ta.cl = sel.ll;
    ta.cc = sel.lc;
    ta.al = -1;
    ta.ac = -1;
    return true;
}

/// 光标位插入文本（换行符分裂多行；选区先删——Input 同心智）。
export function taInsert(ta: Ref<TextArea>, text: string): void {
    taDeleteSelection(ta);
    const line = listTryGet(ta.lines, ta.cl) catch "";
    const head: string = taSlice(line, 0, ta.cc);
    const tail: string = taSlice(line, ta.cc, len(line));
    const segs: List<string> = listNew();
    let start: int = 0;
    let i: int = 0;
    while (i < len(text)) {
        if ((byteTryAt(text, i) catch 10) == 10) {
            listPush(segs, taSlice(text, start, i));
            start = i + 1;
        }
        i = i + 1;
    }
    listPush(segs, taSlice(text, start, len(text)));
    if (listLen(segs) == 1) {
        const seg0 = listTryGet(segs, 0) catch "";
        listSet(ta.lines, ta.cl, head + seg0 + tail);
        ta.cc = ta.cc + len(seg0);
        return;
    }
    const first = listTryGet(segs, 0) catch "";
    const last = listTryGet(segs, listLen(segs) - 1) catch "";
    listSet(ta.lines, ta.cl, head + first);
    const inserts: List<string> = listNew();
    let k: int = 1;
    while (k < listLen(segs) - 1) {
        listPush(inserts, listTryGet(segs, k) catch "");
        k = k + 1;
    }
    listPush(inserts, last + tail);
    let m: int = listLen(inserts) - 1;
    while (m >= 0) {
        listInsert(ta.lines, ta.cl + 1, listTryGet(inserts, m) catch "");
        m = m - 1;
    }
    ta.cl = ta.cl + listLen(inserts);
    ta.cc = len(last);
}

/// 退格（选区先删；行首并入前行）。
export function taBackspace(ta: Ref<TextArea>): void {
    if (taDeleteSelection(ta)) {
        return;
    }
    if (ta.cc > 0) {
        const line = listTryGet(ta.lines, ta.cl) catch "";
        const p: int = cpPrev(line, ta.cc);
        listSet(ta.lines, ta.cl, taSlice(line, 0, p) + taSlice(line, ta.cc, len(line)));
        ta.cc = p;
        return;
    }
    if (ta.cl > 0) {
        const prev_len: int = taLineLen(ta, ta.cl - 1);
        const line = listTryGet(ta.lines, ta.cl) catch "";
        const prev = listTryGet(ta.lines, ta.cl - 1) catch "";
        listSet(ta.lines, ta.cl - 1, prev + line);
        listRemoveAt(ta.lines, ta.cl);
        ta.cl = ta.cl - 1;
        ta.cc = prev_len;
    }
}

/// 光标移动（左右钳制跨行；上下钳制到目标行尾；extend＝shift 延伸选区
/// ——锚惰性建立）。
export function taMove(ta: Ref<TextArea>, key: int, extend: bool): void {
    if (!extend) {
        ta.al = -1;
        ta.ac = -1;
    } else if (ta.al < 0) {
        ta.al = ta.cl;
        ta.ac = ta.cc;
    }
    const cur = listTryGet(ta.lines, ta.cl) catch "";
    if (key == 37) { // LEFT
        if (ta.cc > 0) {
            ta.cc = cpPrev(cur, ta.cc);
        } else if (ta.cl > 0) {
            ta.cl = ta.cl - 1;
            ta.cc = taLineLen(ta, ta.cl);
        }
    } else if (key == 39) { // RIGHT
        if (ta.cc < len(cur)) {
            ta.cc = cpNext(cur, ta.cc);
        } else if (ta.cl + 1 < listLen(ta.lines)) {
            ta.cl = ta.cl + 1;
            ta.cc = 0;
        }
    } else if (key == 38) { // UP
        if (ta.cl > 0) {
            ta.cl = ta.cl - 1;
            ta.cc = taSnapCol(listTryGet(ta.lines, ta.cl) catch "", ta.cc);
        }
    } else if (key == 40) { // DOWN
        if (ta.cl + 1 < listLen(ta.lines)) {
            ta.cl = ta.cl + 1;
            ta.cc = taSnapCol(listTryGet(ta.lines, ta.cl) catch "", ta.cc);
        }
    } else if (key == 36) { // HOME
        ta.cc = 0;
    } else if (key == 35) { // END
        ta.cc = taLineLen(ta, ta.cl);
    }
}

/// 滚动跟随（视口行数＝(h-8)/line_h；光标行滚出视口即调 scroll）。
export function taScrollFollow(ta: Ref<TextArea>): void {
    const vis: int = (ta.h - 8) / ta.line_h;
    if (vis <= 0) {
        return;
    }
    if (ta.cl < ta.scroll) {
        ta.scroll = ta.cl;
    }
    if (ta.cl >= ta.scroll + vis) {
        ta.scroll = ta.cl - vis + 1;
    }
    if (ta.scroll < 0) {
        ta.scroll = 0;
    }
}

/// 绘制（可见行切片＋多行选区带＋光标；背景/边框 drawInputC 同款形态）。
export function drawTextAreaC(c: Ref<Canvas>, ta: Ref<TextArea>): void {
    paintFillRect(c, ta.x, ta.y, ta.w, ta.h, 0xFFFFFF);
    paintStrokeRect(c, ta.x, ta.y, ta.w, ta.h, 0x000000);
    const sel = taSel(ta);
    const vis: int = (ta.h - 8) / ta.line_h;
    let row: int = 0;
    while (row < vis && ta.scroll + row < listLen(ta.lines)) {
        const li: int = ta.scroll + row;
        const line = listTryGet(ta.lines, li) catch "";
        const ly: int = ta.y + 4 + row * ta.line_h;
        if (sel.active && li >= sel.ll && li <= sel.hl) {
            let c0: int = 0;
            let c1: int = len(line);
            if (li == sel.ll) {
                c0 = sel.lc;
            }
            if (li == sel.hl) {
                c1 = sel.hc;
            }
            const x0: int = ta.x + 3 + paintTextWidth(c, taSlice(line, 0, c0));
            const bw: int = paintTextWidth(c, taSlice(line, c0, c1));
            paintFillRect(c, x0, ly, bw, ta.line_h, 0x3A3A6A);
        }
        paintText(c, ta.x + 3, ly + 2, 0x000000, line);
        row = row + 1;
    }
    if (ta.focused) {
        const anim: int = guiQuery(CAP_ANIM_MS);
        if ((anim / 530) % 2 == 0 && ta.cl >= ta.scroll && ta.cl < ta.scroll + vis) {
            const line = listTryGet(ta.lines, ta.cl) catch "";
            const cx: int = ta.x + 3 + paintTextWidth(c, taSlice(line, 0, ta.cc));
            const cy: int = ta.y + 4 + (ta.cl - ta.scroll) * ta.line_h;
            paintFillRect(c, cx + 1, cy + 1, 2, ta.line_h - 2, 0x2A2A4A);
        }
    }
}
