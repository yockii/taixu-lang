// 【镜像纪律】与 src/compiler/ast/ast_bin.zig 的 K 表同源冻结（ID 分配＝
// render.zig 文法表枚举序；变更即破坏性升版——两侧同步注释互指，单测锁定）。——
const BK_FN: int = 1;
const BK_PARAM: int = 2;
const BK_RET: int = 3;
const BK_BLOCK: int = 4;
const BK_STRUCT: int = 5;
const BK_FIELD_D: int = 6;
const BK_ENUM: int = 7;
const BK_VARIANT_D: int = 8;
const BK_TEST: int = 9;
const BK_IMPORT: int = 10;
const BK_LET: int = 11;
const BK_CONST: int = 12;
