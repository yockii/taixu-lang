// 12 关键字与语法糖总览：一页程序把容易漏的语法面全部过一遍。
struct Point {
    x: int,
    y: int,
}

enum Shape {
    Circle(r: int),
    Rect(w: int, h: int),
    Dot,
}

function area(s: Shape): int {
    return switch (s) {
        case Circle(r) => r * r * 3,
        case Rect(w, h) => w * h,
        case Dot => 0,
    };
}

// 自定义"方法"：约定名 pointOffset → p.offset(100) 即此调用（首参为接收者）
function pointOffset(p: Point, dx: int): Point {
    return { x: p.x + dx, y: p.y };
}

export function describe(on: bool): string {
    if (on) { return "on"; }
    return "off";
}

// —— 进阶语法（本书不单列成章，细节见语言规范）——

// 泛型函数：类型参数由实参推断
function firstOr<T>(xs: List<T>, fallback: T): T {
    return xs.get(0) ?? fallback;
}

// interface：不写 implements——有约定名函数 squareArea(Square): int 即实现 HasArea
interface HasArea {
    area(): int;
}

struct Square {
    side: int,
}

function squareArea(s: Square): int {
    return s.side * s.side;
}

// 错误 enum：每个变体带消息，可直接作失败侧
enum ParseError extends Error {
    Empty = "输入为空",
    BadDigit(at: int) = `第 ${at} 个字节不是数字`,
}

function parseDigits(s: string): int | ParseError {
    if (len(s) == 0) {
        return ParseError.Empty;
    }
    let n = 0;
    for (let i = 0; i < len(s); i = i + 1) {
        const c = byteAt(s, i) catch 0;
        if (c < '0' || c > '9') {
            return ParseError.BadDigit(i);
        }
        n = n * 10 + (c - '0');
    }
    return n;
}

function describeParse(s: string): string {
    const n = parseDigits(s) catch (e) {
        return toStr(e);
    };
    return "ok " + toStr(n);
}

// 生成器：function* 与 yield，按需逐个产出
function* countdown(n: int): int {
    let i = n;
    while (i > 0) {
        yield i;
        i = i - 1;
    }
}

// defer：离开所在块时执行（多个时后进先出）
function withDefer(): void {
    defer print("defer: 最后执行");
    print("defer: 先执行函数体");
}

function main(args: []string): int {
    // 字面量：进制（0x/0o/0b）、_ 分隔符、浮点指数
    const million = 1_000_000;
    const mask = 0xff;
    const tiny = 6.02e23;
    print("million=" + toStr(million) + " mask=" + toStr(mask));
    print("tiny>0=" + toStr(tiny > 0.0));

    // 字符串插值与转义
    const name = "太虚";
    print(`hi=${name} mask=${mask}`);
    print("quote:\" snow:\u{2603}");

    // let 可重绑 / const 不可重绑；类型标注可省略（静态可推断时）
    let n = 41;
    n = n + 1;
    const flag = n == 42;
    print("n=" + toStr(n) + " flag=" + toStr(flag));

    // break / continue
    let sum = 0;
    for (let i = 0; i < 10; i = i + 1) {
        if (i == 3) { continue; }
        if (i == 6) { break; }
        sum = sum + i;
    }
    print("sum=" + toStr(sum));

    // while 与取模
    let v = 17;
    while (v >= 5) { v = v - 5; }
    print("v=" + toStr(v) + " mod=" + toStr(17 % 5));

    // 方法语法糖：List 内建约定（xs.push(v) ≡ listPush(xs, v)）
    const xs: List<int> = listNew();
    xs.push(10);
    xs.push(20);
    xs.push(30);
    xs.removeAt(1);
    const first = xs.get(0) catch -1;
    print("first=" + toStr(first) + " len=" + toStr(xs.len()));

    // 自定义"方法"
    const p: Point = { x: 1, y: 2 };
    const q = p.offset(100);
    print("q=" + toStr(q.x) + "," + toStr(q.y));

    // switch 表达式：变体模式 + else 兜底臂
    const kind = switch (Shape.Dot) {
        case Circle(r) => "circle",
        else => "other",
    };
    print("kind=" + kind + " area=" + toStr(area(Shape.Rect(3, 4))) + "/" + toStr(area(Shape.Dot)));
    print(describe(true) + "/" + describe(false));

    // 字符字面量（int 码点）与位运算
    print("char=" + toStr('A') + " bits=" + toStr(0b1100 & 0b1010) + "," + toStr(1 << 4));

    // 解构声明：从 List 依次取元素，每个都是 T?
    const (key, value) = strSplit("lang=tx", "=");
    print("key=" + (key ?? "?") + " value=" + (value ?? "?"));

    // 进阶语法
    const empty: List<int> = listNew();
    print("firstOr=" + toStr(firstOr(empty, 7)) + "," + firstOr(strSplit("a,b", ","), "-"));
    const sq: HasArea = Square { side: 3 };
    print("square=" + toStr(sq.area()));
    print(describeParse("42") + " / " + describeParse("4x"));
    let line = "";
    for (v in countdown(3)) {
        line = line + toStr(v);
    }
    print("countdown=" + line);
    withDefer();
    return 0;
}
