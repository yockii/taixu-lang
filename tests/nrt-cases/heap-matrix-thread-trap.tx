// 安全审查攻关第 2 项场景矩阵（docs/design/v052-heap-check-v0.1-20261024.md 四）：线程 trap × 持有物。
// 一个子线程 trap（定宽写越界 4002）时，主线程持有嵌套 Shared 并停在 join 上，另一个子线程正反复取用同一共享块、
// 分配与释放：进程以退出码 3 有界终止，只输出这一条诊断；页堆下终止路径不得读写已释放的块。
function makeList(): List< string> {
    const xs: List< string> = listNew();
    let i = 0;
    while (i < 32) {
        listPush(xs, "item" + toStr(i));
        i = i + 1;
    }
    return xs;
}

function main(args: []string): void {
    const outer = sharedNew(sharedNew(makeList()));
    const busy = threadSpawn((): int => {
            let s = 0;
            let i = 0;
            while (i < 200000) {
                const tmp: List< string> = listNew();
                listPush(tmp, "x" + toStr(i));
                s = s + listLen(sharedGet(sharedGet(outer))) + listLen(tmp);
                i = i + 1;
            }
            return s;
        });
    const boom = threadSpawn((): int => {
            const keep = sharedGet(sharedGet(outer));
            const b = bytesNew(4);
            bytesSetLE < u32 > (b, 2, listLen(keep) as u32);
            return 0;
        });
    print(toStr(threadJoin(boom) catch -1));
    print(toStr(threadJoin(busy) catch -1));
    print("unreachable");
}
