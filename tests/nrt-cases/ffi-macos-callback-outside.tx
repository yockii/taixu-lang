// macOS 适配 M2（设计稿 F3，伴文件 .macos；同 ffi-linux-callback-outside）：回调只能在外部函数调用期间被调用——libc signal 登记的处理函数在
// 纯太虚循环里（没有外部调用在进行）被定时器信号触发，蹦床 trap 4020（ffi_callback）。
declare function signal(sig: i32, handler: (i32) => void): usize from "libSystem";
declare function ualarm(usec: u32, interval: u32): u32 from "libSystem";

function onAlarm(sig: i32): void {
    print("handler should not run");
}

function main(args: []string): int {
    signal(14, onAlarm);
    print("armed");
    ualarm(20000, 0);
    let i = 0;
    while (i >= 0) { i = i + 1; }
    print("unreachable");
    return 0;
}
