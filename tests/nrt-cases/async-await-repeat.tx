// D3 v0.38 §6.12-2：同一 Future 可以多次 await，每次得同一结果（与 future 共享：引用类型得同一对象）；已取消的每次得
// err("task cancelled")；已完成后再 taskCancel 是空操作。此前结果移给第一个 await，第二次得 None（不合 T | Error，一用即
// trap bad_type）。结果只由 future 持有时，future 释放即连带释放（Weak 失效）。
struct Box {
    label: string,
    items: List< string>,
}

let watch: List< Weak< Box>> = listNew();

async function num(n: int): int {
    await sleepMs(0) catch (e) {
        return -1;
    };
    return n;
}

async function text(n: int): string {
    await sleepMs(0) catch (e) {
        return "?";
    };
    return "value " + toStr(n);
}

async function box(label: string): Ref< Box> {
    const items: List< string> = listNew();
    listPush(items, "first");
    const b = new Box { label: label, items: items };
    listPush(watch, weak(b));
    await sleepMs(0) catch (e) {
        return b;
    };
    return b;
}

async function fail(): int {
    await sleepMs(0) catch (e) {
        return -1;
    };
    return err("boom");
}

async function slow(): int {
    await sleepMs(60000) catch (e) {
        return -1;
    };
    return 1;
}

async function outcome(f: Future < int >): string {
    const v = await f catch (e) {
        return "error " + e.message;
    };
    return toStr(v);
}

async function reader(tag: string, f: Future < Ref< Box>>): int {
    const fallback: List< string> = listNew();
    const b = await f catch new Box { label: "?", items: fallback };
    listPush(b.items, tag);
    print(tag + " sees " + b.label + " with " + toStr(listLen(b.items)) + " items");
    return listLen(b.items);
}

async function run(): int {
    const a = num(1);
    const t = text(2);
    const e = fail();
    const s = slow();
    print("int " + (await outcome(a) catch "?") + " then " + (await outcome(a) catch "?"));
    print("string " + (await t catch "?") + " then " + (await t catch "?"));
    print("error " + (await outcome(e) catch "?") + " then " + (await outcome(e) catch "?"));
    taskCancel(s);
    print("cancelled " + (await outcome(s) catch "?") + " then " + (await outcome(s) catch "?"));
    taskCancel(a);
    print("cancel after completion " + (await outcome(a) catch "?"));
    // 两个任务各自 await 同一个 future，得同一对象：第二个看见第一个的修改。
    const shared = box("shared");
    const r1 = reader("r1", shared);
    const r2 = reader("r2", shared);
    print("readers " + toStr(await r1 catch -1) + " " + toStr(await r2 catch -1));
    const fallback: List< string> = listNew();
    const mine = await shared catch new Box { label: "?", items: fallback };
    print("same object " + toStr(listLen(mine.items)) + " " + (listGet(mine.items, 2) catch "?"));
    await dropped() catch -1;
    const gone: List< string> = listNew();
    const w = listGet(watch, 1) catch weak(new Box { label: "?", items: gone });
    print("temp released " + toStr((deref(w) catch Box { label: "gone", items: gone }).label == "gone"));
    return 0;
}

async function dropped(): int {
    // 结果只由 future 持有：await 拿到的引用与 future 一起放掉后，对象释放。
    const f = box("temp");
    const fallback: List< string> = listNew();
    const b = await f catch new Box { label: "?", items: fallback };
    print("temp " + b.label);
    return 0;
}

function main(args: []string): int {
    const r = run();
    return 0;
}
