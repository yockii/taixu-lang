// D3 v0.50 §6.3-8：None 收窄——const 局部与参数在 if 为真的分支、&& 右侧、为假的分支、|| 右侧、三元两支与“某一支必离开
// 的 if 之后”取 T；闭包捕获的副本同样收窄；catch、??、后缀 ?、与 None 比较照旧按声明类型取；else-if 链；模板串插值。
struct P {
    name: string,
    age: int,
}

function describe(p: Ref<P>?): string {
    if (p == None) { return "无"; }
    return p.name + "/" + toStr(p.age);
}

function firstPos(xs: List<int>): int {
    const v = listTryGet(xs, 0);
    if (v != None && v > 0) { return v; }
    return -1;
}

function sumOpt(a: int?, b: int?): int {
    if (a == None || b == None) { return 0; }
    return a + b;
}

function pick(x: int?): int {
    if (x == None) {
        return 0;
    } else {
        return x * 2;
    }
}

function notForm(x: int?): int {
    if (!(x == None)) { return x + 1; }
    return 0;
}

function orRhs(x: int?): bool {
    return x == None || x > 10;
}

function countNonEmpty(xs: List<string>): int {
    let n = 0;
    let i = 0;
    while (i < listLen(xs)) {
        const s = listTryGet(xs, i);
        i += 1;
        if (s == None) { continue; }
        if (len(s) > 0) { n += 1; }
    }
    return n;
}

function capt(x: int?): int {
    if (x != None) {
        const f = (k: int): int => x + k;
        return f(1);
    }
    return 0;
}

function inner(x: int?): int {
    const g = (): int => {
        if (x == None) { return -1; }
        return x;
    };
    return g();
}

function legacy(x: int?): int {
    if (x != None) {
        const a = x ?? 0;
        const b = x catch 0;
        if (x != None) { return a + b; }
    }
    return 0;
}

function prop(x: int?): int? {
    if (x != None) { return x? + 1; }
    return None;
}

function elseIf(a: int?, b: int?): int {
    if (a == None) {
        return 1;
    } else if (b == None) {
        return 2;
    }
    return a + b;
}

function elseLeaves(x: int?): int {
    if (x != None) {
        print("有值");
    } else {
        return -1;
    }
    return x;
}

function templ(x: string?): string {
    if (x != None) { return `名字=${x}`; }
    return "空";
}

function main(args: []string): void {
    print(describe(new P { name: "张三", age: 30 }));
    print(describe(None));
    const xs: List<int> = listNew();
    print(toStr(firstPos(xs)));
    listPush(xs, 7);
    print(toStr(firstPos(xs)));
    print(toStr(sumOpt(2, 3)) + " " + toStr(sumOpt(None, 3)));
    print(toStr(pick(4)) + " " + toStr(pick(None)));
    print(toStr(notForm(9)));
    print(toStr(orRhs(None)) + " " + toStr(orRhs(11)) + " " + toStr(orRhs(3)));
    const ss: List<string> = listNew();
    listPush(ss, "a");
    listPush(ss, "");
    listPush(ss, "bc");
    print(toStr(countNonEmpty(ss)));
    print(toStr(capt(5)) + " " + toStr(capt(None)));
    print(toStr(inner(8)) + " " + toStr(inner(None)));
    print(toStr(legacy(6)));
    print(toStr(prop(1) ?? -9) + " " + toStr(prop(None) ?? -9));
    print(toStr(elseIf(1, 2)) + " " + toStr(elseIf(None, 2)) + " " + toStr(elseIf(1, None)));
    print(toStr(elseLeaves(3)) + " " + toStr(elseLeaves(None)));
    print(templ("太虚") + " " + templ(None));
}
