// D3 v0.22：泛型函数接收 Gen<T>（经 Gen 推断类型实参）、Gen 存进 struct 字段与方法语法 h.g.next()；
// Gen 是句柄，赋值后两处共享同一个生成器。
function* evens(n: int): int {
    let i = 0;
    while (i < n) { yield i * 2; i = i + 1; }
}

function* names(): string {
    yield "x";
    yield "y";
}

function count<T>(g: Gen< T>): int {
    let k = 0;
    for (x in g) { k = k + 1; }
    return k;
}

function firstOr<T>(g: Gen< T>, d: T): T {
    return genNext(g) catch d;
}

struct Holder {
    g: Gen< int>,
    label: string,
}

export function main(args: []string): int {
    print(toStr(count(evens(4))) + " " + toStr(count(names())));
    print(firstOr(names(), "none") + " " + toStr(firstOr(evens(0), -7)));
    const h = new Holder { g: evens(3), label: "h" };
    print(h.label + toStr(h.g.next() catch -1) + toStr(h.g.next() catch -1));
    const copy = h.g;
    print(toStr(genNext(copy) catch -1) + " " + toStr(h.g.next() catch -1));
    return 0;
}
