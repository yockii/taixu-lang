// 线程第 4c 步：Shared 里的对象图深度不可变（线程设计 §四-4）：经 sharedGet 取出的对象写字段即 trap 4022。
struct Conf {
    name: string,
    limit: int,
}

function main(args: []string): void {
    const s = sharedNew(new Conf { name: "a", limit: 1 });
    const c = sharedGet(s);
    print(c.name);
    c.limit = 2;
    print("unreachable");
}
