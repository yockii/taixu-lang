// mcp_worker_limits_linux.tx 用的系统调用（riscv64 的号，Linux v7.3 号表；只许写在 _linux_riscv64 文件里）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux、_linux_aarch64、
// _linux_loongarch64 与 _linux_riscv64 四个文件（B16 B17 导出面相同；号与打开标志同龙芯那份）；
// 种子换代后改成 from syscall "名字" 合成一份。
// 通用号表没有 getpgrp，取 getpgid(0)；getrlimit 同龙芯那份取 prlimit64(0, 种类, 空, 结果)（RISC-V 两者都有，运行时的改写也取后者）。
declare function sysPrlimit(pid: i32, kind: i32, next: usize, info: Bytes): i32 from syscall 261;
declare function sysGetpid(): i32 from syscall 172;
declare function sysGetpgid(pid: i32): i32 from syscall 155;

export function getrlimit(kind: i32, info: Bytes): i32 { return sysPrlimit(0, kind, 0, info); }
export function getpid(): i32 { return sysGetpid(); }
export function getpgrp(): i32 { return sysGetpgid(0); }
