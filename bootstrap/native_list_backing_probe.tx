import { coffCaptureAssembler, coffWrite, coffResultOk, coffResultBytes, coffResultError } from "./selfhost/emit_coff_storage";
import { targetParseName, tElf } from "./selfhost/target";
function main(args: []string): int {
    if (len(args) != 3 || args[0] != "--target") { return 64; }
    const t = targetParseName(args[1]);
    if (t < 0) { return 64; }
    const buf = asBufferNew(); listBackingEmit(buf, t); listCompactEmit(buf, t); listElementsEmit(buf);
    asStructuredBegin(); asBufferSubmit(buf);
    if (asFailedAs() != 0) { eprint(asLastErrAs()); return 66; }
    const exports: List<string> = listNew();
    listPush(exports, "__tx_native_list_append_v1"); listPush(exports, "__tx_native_list_generic_v1"); listPush(exports, "__tx_native_list_destroy_v1"); listPush(exports, "__tx_native_list_get_v2"); listPush(exports, "__tx_native_list_remove_v2"); listPush(exports, "__tx_native_list_prepare_set_v2"); listPush(exports, "__tx_native_list_insert_v2");
    if (tElf(t)) {
