// table-scroll —— table×scrollContainer 滚动整合守护：
// 500 行×3 列表在 ScrollView 视窗内只画可见行切片＋表头固定；重放拖滚动条至
// 中位/底部两滚动位（top＝初始态）——三滚动位 golden 可 capture。
import { Canvas, ScrollView, scrollView, scrollClamp, scrollDraw, drawTableScroll, canvasNew } from "gui/components";
import { TSC_HEADER_H } from "gui/components";
import { appNew, appClose, pump, scrollOnEvents, defaultSpec } from "gui/app";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";

const N_ROWS: int = 500;
const ROW_H: int = 16;

struct Model {
    surface: int,
    sv: Ref<ScrollView>,
}

function cellText(row: int, col: int): string {
    if (col == 0) {
        return "row" + toStr(row);
    }
    if (col == 1) {
        return "c1-" + toStr(row % 97);
    }
    return "c2-" + toStr(row % 13);
}

function render(surface: int, w: int, h: int, m: Ref<Model>): void {
    surfaceClear(surface, 0x202040);
    const cv: Ref<Canvas> = canvasNew(surface, w, h);
    const cols: List<int> = listNew();
    listPush(cols, 90);
    listPush(cols, 80);
    listPush(cols, 80);
    scrollDraw(cv, m.sv, (child: Ref<Canvas>): void => {
            drawTableScroll(child, m.sv, cols, N_ROWS, ROW_H, cellText);
        });
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, sv: scrollView(3, 8, 8, 280, 120, TSC_HEADER_H + N_ROWS * ROW_H) };
    const spec = defaultSpec("taixu table scroll", 300, 140);
    const app = appNew(spec);
    m.surface = surfaceOpen(spec.w, spec.h) catch 0;
    scrollOnEvents(app, m.sv, (delta: int): void => {
            delta;
        });
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            render(m.surface, app.w, app.h, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("scroll_y=" + toStr(m.sv.scroll_y) + " rows=" + toStr(N_ROWS) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
