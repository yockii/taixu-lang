enum Wide {
    V0,
    V1,
    V2,
    V3,
    V4,
    V5,
    V6,
    V7,
    V8,
    V9,
    V10,
    V11,
    V12,
    V13,
    V14,
    V15,
    V16,
    V17,
    V18,
    V19,
}

function selectWide(e: Ref<Wide>, n: int): int {
    const answer = n + 1;
    return switch (e) {
        case V0 => 0,
        case V1 => 0,
        case V2 => 0,
        case V3 => 0,
        case V4 => 0,
        case V5 => 0,
        case V6 => 0,
        case V7 => 0,
        case V8 => 0,
        case V9 => 0,
        case V10 => 0,
        case V11 => 0,
        case V12 => 0,
        case V13 => 0,
        case V14 => 0,
        case V15 => 0,
        case V16 => 0,
        case V17 => 0,
        case V18 => 0,
        case V19 => answer + 19,
    };
}

export function main(args: []string): int {
    print("v0=" + toStr(selectWide(new Wide.V0(), 100)));
    print("v1=" + toStr(selectWide(new Wide.V1(), 100)));
    print("v2=" + toStr(selectWide(new Wide.V2(), 100)));
    print("v3=" + toStr(selectWide(new Wide.V3(), 100)));
    print("v4=" + toStr(selectWide(new Wide.V4(), 100)));
    print("v5=" + toStr(selectWide(new Wide.V5(), 100)));
    print("v6=" + toStr(selectWide(new Wide.V6(), 100)));
    print("v7=" + toStr(selectWide(new Wide.V7(), 100)));
    print("v8=" + toStr(selectWide(new Wide.V8(), 100)));
    print("v9=" + toStr(selectWide(new Wide.V9(), 100)));
    print("v10=" + toStr(selectWide(new Wide.V10(), 100)));
    print("v11=" + toStr(selectWide(new Wide.V11(), 100)));
    print("v12=" + toStr(selectWide(new Wide.V12(), 100)));
    print("v13=" + toStr(selectWide(new Wide.V13(), 100)));
    print("v14=" + toStr(selectWide(new Wide.V14(), 100)));
    print("v15=" + toStr(selectWide(new Wide.V15(), 100)));
    print("v16=" + toStr(selectWide(new Wide.V16(), 100)));
    print("v17=" + toStr(selectWide(new Wide.V17(), 100)));
    print("v18=" + toStr(selectWide(new Wide.V18(), 100)));
    print("v19=" + toStr(selectWide(new Wide.V19(), 100)));
    return 0;
}
