import { imported } from "./data/global-binding-source";
interface Readable { read(): int; }
struct Thing { value: int }
function thingRead(value: Thing): int { return value.value; }
function addOne(value: int): int { return value + 1; }

const literal: int = 42;
const decimal: float = 42;
let text: string = "literal";
const truth: bool = true;
const small: u8 = 255;
const wider: u16 = small;
const optional: int? = None;
const filled: int? = 7;
const result: int | Error = 9;
const values: List<int> = [1, 2, 3];
const fixed: [2]int = [4, 5];
const object: Thing = Thing { value: 11 };
const readable: Readable = Thing { value: 12 };
const optionalReadable: Readable? = Thing { value: 13 };
const resultReadable: Readable | Error = Thing { value: 14 };
const callback: (int) => int = addOne;
const closure: () => int = (): int => { return literal; };
const across: int = imported + 2;

export function main(args: []string): int {
    assert(literal == 42 && decimal == 42.0 && text == "literal" && truth, "scalar initializers");
    assert(small == 255 && wider == 255 && optional == None && (filled ?? 0) == 7, "fixed width and optional");
    assert((result catch 0) == 9 && listLen(values) == 3 && fixed[1] == 5 && object.value == 11, "unions and aggregates");
    assert(readable.read() == 12, "global interface boxing");
    const unwrapped = optionalReadable ?? panic("optional interface"); assert(unwrapped.read() == 13, "optional interface boxing");
    const success = resultReadable catch panic("result interface"); assert(success.read() == 14, "result interface boxing");
    assert(callback(4) == 5 && closure() == 42, "function values");
    assert(across == 42, "cross module initializer");
    print("global binding types OK"); return 0;
}
