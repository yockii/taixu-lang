// 按目标选择文件（D3 v0.23 起，v0.35 增 _unix 与 _<os>_<arch>；docs/design/v052-macos-m0b-language-rules-v0.1-20261023.md
// §二）。从 driver.tx 拆出：x_<后缀>.tx 的路径与显示名，以及同组兄弟文件导出面的比对。后缀由 target.tx 的表生成；
// 兄弟文件的存在性与内容由驱动经覆盖层取得后传进来（编辑器里未保存的兄弟文件也参与比对）。

import { parseSourceBin } from "../parser";
import { txExports } from "../semamirror";
import { targetFileSuffixesAll } from "./target";
import { pathIsSep } from "./path_sep";

function cpCountD(p: string): int {
    let n = 0;
    let i = 0;
    while (i < len(p)) {
        const c = byteAt(p, i) catch 0;
        n = n + 1;
        if (c >= 240) { i = i + 4; }
        else if (c >= 224) { i = i + 3; }
        else if (c >= 192) { i = i + 2; }
        else { i = i + 1; }
    }
    return n;
}

function cpCharAtD(p: string, i: int): int {
    const c = strSub(p, i, 1);
    return byteAt(c, 0) catch 0;
}

function strEndsWithCheck(h: string, p: string): bool {
    const hn = len(h);
    const pn = len(p);
    if (hn < pn) { return false; }
    let i = 0;
    while (i < pn) {
        if ((byteAt(h, hn - pn + i) catch 0) != (byteAt(p, i) catch 0)) { return false; }
        i = i + 1;
    }
    return true;
}

function txb1Ok(bin: string): int {
    if (len(bin) < 5) { return 0; }
    if ((byteAt(bin, 0) catch 0) != 84 || (byteAt(bin, 1) catch 0) != 88 || (byteAt(bin, 2) catch 0) != 66) { return 0; }
    if ((byteAt(bin, 3) catch 0) != 49 || (byteAt(bin, 4) catch 0) != 32) { return 0; }
    return 1;
}

const variantChecked: List<string> = listNew();

export function variantPath(base: string, suffix: string): string {
    return strSub(base, 0, cpCountD(base) - 3) + "_" + suffix + ".tx";
}

export function variantDisplay(spec: string, suffix: string): string {
    if (strEndsWithCheck(spec, ".tx")) { return strSub(spec, 0, cpCountD(spec) - 3) + "_" + suffix + ".tx"; }
    return spec + "_" + suffix;
}

/// 同组兄弟文件的候选路径：基础文件在前，其后按 targetFileSuffixesAll 的次序。
export function variantCandidates(base: string): List<string> {
    const out: List<string> = listNew();
    listPush(out, base);
    for (sfx in targetFileSuffixesAll()) { listPush(out, variantPath(base, sfx)); }
    return out;
}

/// 本次驱动运行里第一次比对这个基础路径（3033 只在第一处导入它的位置报）。
export function variantFirstVisit(base: string): bool {
    for (seen in variantChecked) { if (seen == base) { return false; } }
    listPush(variantChecked, base);
    return true;
}

function fileBaseName(path: string): string {
    const n = cpCountD(path);
    let cut = -1;
    let k = 0;
    while (k < n) {
        const c = cpCharAtD(path, k);
        if (pathIsSep(c)) { cut = k; }
        k = k + 1;
    }
    return strSub(path, cut + 1, n - cut - 1);
}

// 只为比对导出面而解析（不入模块表）：有语法错误时返回空串，交给真正编译它的那次构建报告。
function quietExports(src: string): string {
    const raw = parseSourceBin(src);
    if (cpCountD(raw) > 0 && cpCharAtD(raw, 0) == 33) { return ""; }
    if (txb1Ok(raw) == 0) { return ""; }
    return "#" + txExports(raw);
}

let variantOut: string = "";

export function variantReset(): void {
    while (listLen(variantChecked) > 0) { listRemoveAt(variantChecked, listLen(variantChecked) - 1); }
}

function variantDiag(display: string, line: int, col: int, msg: string): void {
    variantOut = variantOut + display + ":" + toStr(line) + ":" + toStr(col) + ": error 3033: " + msg + "\n  └─ 处置详见: taixu explain 3033\n";
}

function surfaceSig(names: List<string>, sigs: List<string>, name: string): string {
    let i = 0;
    while (i < listLen(names)) {
        if ((listGet(names, i) catch "") == name) { return listGet(sigs, i) catch ""; }
        i = i + 1;
    }
    return "#";
}

function surfaceSplit(surface: string, names: List<string>, sigs: List<string>): void {
    const lines = strSplit(strSub(surface, 1, cpCountD(surface) - 1), "\n");
    let i = 0;
    while (i < listLen(lines)) {
        const ln = listGet(lines, i) catch "";
        const lnN = cpCountD(ln);
        let tab = 0;
        while (tab < lnN && cpCharAtD(ln, tab) != 9) { tab = tab + 1; }
        if (tab > 0 && tab < lnN) {
            listPush(names, strSub(ln, 0, tab));
            listPush(sigs, strSub(ln, tab + 1, cpCountD(ln) - tab - 1));
        }
        i = i + 1;
    }
}

/// 比对同组兄弟文件的导出面：present 与 sources 一一对应（按候选次序、只含存在的，读不到的源为空串）；
/// 返回渲染好的 3033 诊断（空串＝一致或可比的不足两份）。
export function variantCompare(present: List<string>, sources: List<string>, display: string, line: int, col: int): string {
    variantOut = "";
    const paths: List<string> = listNew();
    const surfaces: List<string> = listNew();
    let ci = 0;
    while (ci < listLen(present)) {
        const src = listGet(sources, ci) catch "";
        const sf = quietExports(src);
        if (len(src) > 0 && len(sf) > 0) {
            listPush(paths, listGet(present, ci) catch "");
            listPush(surfaces, sf);
        }
        ci = ci + 1;
    }
    if (listLen(paths) < 2) { return ""; }
    const refName = fileBaseName(listGet(paths, 0) catch "");
    const refNames: List<string> = listNew();
    const refSigs: List<string> = listNew();
    surfaceSplit(listGet(surfaces, 0) catch "#", refNames, refSigs);
    let oi = 1;
    while (oi < listLen(paths)) {
        const oName = fileBaseName(listGet(paths, oi) catch "");
        const oNames: List<string> = listNew();
        const oSigs: List<string> = listNew();
        surfaceSplit(listGet(surfaces, oi) catch "#", oNames, oSigs);
        let k = 0;
        while (k < listLen(refNames)) {
            const nm = listGet(refNames, k) catch "";
            const want = listGet(refSigs, k) catch "";
            const got = surfaceSig(oNames, oSigs, nm);
            if (got == "#") {
                variantDiag(display, line, col, "按目标选择的模块导出面不一致：" + refName + " 导出 '" + nm + "'，" + oName + " 没有");
            } else if (got != want) {
                variantDiag(display, line, col, "按目标选择的模块导出面不一致：'" + nm + "' 在 " + refName + " 中为 " + want + "，在 " + oName + " 中为 " + got);
            }
            k = k + 1;
        }
        k = 0;
        while (k < listLen(oNames)) {
            const nm = listGet(oNames, k) catch "";
            if (surfaceSig(refNames, refSigs, nm) == "#") {
                variantDiag(display, line, col, "按目标选择的模块导出面不一致：" + oName + " 导出 '" + nm + "'，" + refName + " 没有");
            }
            k = k + 1;
        }
        oi = oi + 1;
    }
    return variantOut;
}
