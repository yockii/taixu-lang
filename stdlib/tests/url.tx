// 相对引用向量：RFC 3986 §5.4 https://www.rfc-editor.org/rfc/rfc3986.html#section-5.4
import { parseUri, parseUriLimit, uriString, resolveUri, escapeComponent, decodePercent, unescapeComponent, parseQuery, encodeQuery } from "std/url";

function vector(ref: string, want: string): void {
    const got = resolveUri("http://a/b/c/d;p?q", ref) catch (e) { panic(ref + ": " + e.message); };
    assert(uriString(got) == want, ref + " => " + uriString(got) + " want " + want);
}

test "url：RFC 3986 普通引用" {
    vector("g:h", "g:h");
    vector("g", "http://a/b/c/g");
    vector("./g", "http://a/b/c/g");
    vector("g/", "http://a/b/c/g/");
    vector("/g", "http://a/g");
    vector("//g", "http://g");
    vector("?y", "http://a/b/c/d;p?y");
    vector("g?y", "http://a/b/c/g?y");
    vector("#s", "http://a/b/c/d;p?q#s");
    vector("g#s", "http://a/b/c/g#s");
    vector("g?y#s", "http://a/b/c/g?y#s");
    vector(";x", "http://a/b/c/;x");
    vector("g;x", "http://a/b/c/g;x");
    vector("g;x?y#s", "http://a/b/c/g;x?y#s");
    vector("", "http://a/b/c/d;p?q");
    vector(".", "http://a/b/c/");
    vector("./", "http://a/b/c/");
    vector("..", "http://a/b/");
    vector("../", "http://a/b/");
    vector("../g", "http://a/b/g");
    vector("../..", "http://a/");
    vector("../../", "http://a/");
    vector("../../g", "http://a/g");
}

test "url：RFC 3986 异常引用与严格模式" {
    vector("../../../g", "http://a/g");
    vector("../../../../g", "http://a/g");
    vector("/./g", "http://a/g");
    vector("/../g", "http://a/g");
    vector("g.", "http://a/b/c/g.");
    vector(".g", "http://a/b/c/.g");
    vector("g..", "http://a/b/c/g..");
    vector("..g", "http://a/b/c/..g");
    vector("./../g", "http://a/b/g");
    vector("./g/.", "http://a/b/c/g/");
    vector("g/./h", "http://a/b/c/g/h");
    vector("g/../h", "http://a/b/c/h");
    vector("g;x=1/./y", "http://a/b/c/g;x=1/y");
    vector("g;x=1/../y", "http://a/b/c/y");
    vector("g?y/./x", "http://a/b/c/g?y/./x");
    vector("g?y/../x", "http://a/b/c/g?y/../x");
    vector("g#s/./x", "http://a/b/c/g#s/./x");
    vector("g#s/../x", "http://a/b/c/g#s/../x");
    vector("http:g", "http:g");
}

function rejected(raw: string): bool {
    parseUri(raw) catch (e) { return true; };
    return false;
}

function limited(raw: string, limit: int): bool {
    parseUriLimit(raw, limit) catch (e) { return true; };
    return false;
}

function invalidText(raw: string): bool {
    unescapeComponent(raw, false) catch (e) { return true; };
    return false;
}

test "url：空组件、authority 与百分号点段" {
    for (raw in ["", "?", "#", "?#", "//", "file:///tmp/a", "http://user:pw@example.test:80/a?x#f", "urn:example:x"]) {
        const u = parseUri(raw) catch panic(raw);
        assert(uriString(u) == raw, "round trip " + raw);
    }
    const empty = parseUri("?#") catch panic("empty");
    assert(empty.query != None && empty.fragment != None, "empty present components");
    const absent = parseUri("") catch panic("absent");
    assert(absent.query == None && absent.fragment == None && absent.authority == None, "absent components");
    vector("%2E/%2e%2e/x", "http://a/b/c/%2E/%2e%2e/x");
    const a = resolveUri("http://host", "a") catch panic("root merge");
    assert(uriString(a) == "http://host/a", "empty base path");
    vector("?", "http://a/b/c/d;p?");
}

test "url：IP 字面量与错误语法" {
    for (raw in ["http://[::1]/", "//[2001:db8::1]:443", "//[1:2:3:4:5:6:7:8]", "//[::ffff:192.0.2.1]", "//[v1.name:part]:9"]) {
        assert(!rejected(raw), "accept " + raw);
    }
    for (raw in ["http://[::1", "//[::1]x", "//[1:2:3]", "//[1::2::3]", "//[1:2:3:4:5:6:7:8::]", "//[::ffff:256.0.0.1]",
            "//[::ffff:01.0.0.1]", "//[::1%25eth0]", "//[v.name]", "//host:x", "//a@b@c", "1abc:x", "a/%", "a/%0g", "a/%0",
            "a b", "a\rb", "a\nb", "a\\b", "a#b#c", "x[y]", "中文"]) {
        assert(rejected(raw), "reject " + raw);
    }
    assert(limited("http://a", 7), "limit returns Error");
}

test "url：二进制百分号与 Unicode 组件" {
    const text = "中文 a+b&/?#";
    const enc = escapeComponent(text, false);
    assert(enc == "%E4%B8%AD%E6%96%87%20a%2Bb%26%2F%3F%23", "UTF-8 encoding");
    assert((unescapeComponent(enc, false) catch "") == text, "UTF-8 round trip");
    assert(escapeComponent("a b+c", true) == "a+b%2Bc", "form encoding");
    assert((unescapeComponent("a+b", false) catch "") == "a+b", "generic + is literal");
    assert((unescapeComponent("a+b", true) catch "") == "a b", "form + is space");
    const raw = decodePercent("%00%FF", false) catch panic("binary");
    assert(bytesLen(raw) == 2 && (bytesGet(raw, 0) catch -1) == 0 && (bytesGet(raw, 1) catch -1) == 255, "arbitrary bytes");
    assert(invalidText("%FF"), "text decoding checks UTF-8");
}

test "url：查询重复项与等号保留" {
    const params = parseQuery("a=1&a=2&empty=&flag&=v&x=a%26b", false) catch panic("query");
    assert(listLen(params) == 6, "duplicate keys remain");
    assert(encodeQuery(params, false) == "a=1&a=2&empty=&flag&=v&x=a%26b", "ordered round trip");
    const p = parseQuery("q=%E4%B8%AD%E6%96%87+ok", true) catch panic("form query");
    assert(listGet(p, 0).value == "中文 ok", "form Unicode");
    assert(listLen(parseQuery("", false) catch panic("empty query")) == 0, "empty query");
}
