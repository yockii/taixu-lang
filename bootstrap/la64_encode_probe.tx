// 龙芯 LA64 编码表核对：tests/la64/encodings.txt 的正例逐条按助记符在指令表里找到指令，以表中字段
// 调编码函数，须与两家独立汇编器给出的编码相同；再把编码交反汇编器，须得到表中的汇编文本。负例（! 开头）须得 -1。
// 另有随机往返：每条指令固定操作码、字段位随机取 64 个字，凡反汇编器认得的，重编须逐位相同、文本不得是 .inst；全表
// 每条指令至少要认得一个（字段全可取的格式全部认得）。固定反例（全 0、全 1、保留区）须得 .inst。
// 全部相符打印 PASS_LA64_ENCODINGS 正例数 负例数 随机认得数；用法 la64_encode_probe <encodings.txt>。
import { la64InstCount, la64Inst, la64InstFind, la64EncodeFields, la64Decode, la64Disasm, la64FixedMask } from "./selfhost/la64_disasm";

struct Num { v: int, ok: bool }

// 十进制（可带负号）。
function parseDec(s: string): Ref<Num> {
    const bad = new Num { v: 0, ok: false };
    if (len(s) == 0) { return bad; }
    let neg = false;
    let i = 0;
    if ((byteAt(s, 0) catch 0) == 45) { neg = true; i = 1; }
    if (i >= len(s) || len(s) - i > 18) { return bad; }
    let v = 0;
    while (i < len(s)) {
        const c = byteAt(s, i) catch 0;
        if (c < 48 || c > 57) { return bad; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    if (neg) { v = -v; }
    return new Num { v: v, ok: true };
}
// 8 位十六进制（小写）。
function parseHex(s: string): Ref<Num> {
    if (len(s) != 8) { return new Num { v: 0, ok: false }; }
    let v = 0;
    let i = 0;
    while (i < 8) {
        const c = byteAt(s, i) catch 0;
        let d = -1;
        if (c >= 48 && c <= 57) { d = c - 48; }
        if (c >= 97 && c <= 102) { d = c - 87; }
        if (d < 0) { return new Num { v: 0, ok: false }; }
        v = v * 16 + d;
        i = i + 1;
    }
    return new Num { v: v, ok: true };
}
const HEX: string = "0123456789abcdef";
function hex8(v: int): string {
    let s = "";
    let x = v;
    while (len(s) < 8) { s = strSub(HEX, x & 15, 1) + s; x = x >>> 4; }
    return s;
}

struct Case { idx: int, fields: List<int>, ok: bool }

// “助记符 字段…”：助记符须在指令表里，字段都是十进制。
function parseCase(s: string): Ref<Case> {
    const ws = strSplit(s, " ");
    let fs: List<int> = listNew();
    const idx = la64InstFind(listGet(ws, 0) catch "");
    let ok = idx >= 0;
    let k = 1;
    while (k < listLen(ws)) {
        const n = parseDec(listGet(ws, k) catch "");
        if (!n.ok) { ok = false; }
        listPush(fs, n.v);
        k = k + 1;
    }
    return new Case { idx: idx, fields: fs, ok: ok };
}

let seed: int = 88172645463325252;
// xorshift64：随机往返用，固定种子，结果可复现。
function next(): int {
    seed = seed ^ (seed << 13);
    seed = seed ^ (seed >>> 7);
    seed = seed ^ (seed << 17);
    return seed;
}

function main(args: []string): int {
    if (len(args) < 1) { eprint("usage: la64_encode_probe <encodings.txt>"); return 64; }
    const text = readFile(args[0]) catch (e) { eprint(e.message); return 65; };
    const lines = strSplit(text, "\n");
    let good = 0;
    let bad = 0;
    let failures = 0;
    let i = 0;
    while (i < listLen(lines)) {
        const line = listGet(lines, i) catch "";
        i = i + 1;
        if (len(line) == 0 || (byteAt(line, 0) catch 0) == 35) { continue; }
        if ((byteAt(line, 0) catch 0) == 33) {
            const c = parseCase(strSub(line, 2, len(line) - 2));
            let got = -2;
            if (c.ok) { got = la64EncodeFields(c.idx, c.fields); }
            if (!c.ok || got != -1) {
                failures = failures + 1;
                if (failures <= 20) { eprint("line " + toStr(i) + ": negative case encoded as " + toStr(got) + ": " + line); }
            }
            bad = bad + 1;
            continue;
        }
        const parts = strSplit(line, " | ");
        if (listLen(parts) != 3) { eprint("line " + toStr(i) + ": malformed"); return 66; }
        const c = parseCase(listGet(parts, 0) catch "");
        const asm = listGet(parts, 1) catch "";
        const want = parseHex(listGet(parts, 2) catch "");
        let got = -2;
        if (c.ok) { got = la64EncodeFields(c.idx, c.fields); }
        const dis = la64Disasm(want.v);
        if (!c.ok || !want.ok || got != want.v || dis != asm) {
            failures = failures + 1;
            let shown = toStr(got);
            if (got >= 0) { shown = hex8(got); }
            if (failures <= 20) { eprint("line " + toStr(i) + ": " + asm + " want " + (listGet(parts, 2) catch "") + " got " + shown + " disasm " + dis); }
        }
        good = good + 1;
    }
    // 随机往返：字段位随机。
    let known = 0;
    const n = la64InstCount();
    let k = 0;
    while (k < n) {
        const e = la64Inst(k);
        let hit = 0;
        let r = 0;
        while (r < 64) {
            const w = e.op | (next() & ~la64FixedMask(e.fmt) & 0xffffffff);
            const d = la64Decode(w);
            if (d >= 0) {
                const t = la64Disasm(w);
                if (len(t) == 0 || strSub(t, 0, 5) == ".inst") { failures = failures + 1; eprint("random " + hex8(w) + " decoded but printed " + t); }
                hit = hit + 1;
            }
            r = r + 1;
        }
        if (hit == 0) { failures = failures + 1; eprint("random: " + e.name + " never decoded"); }
        known = known + hit;
        k = k + 1;
    }
    // 固定反例：全 0、全 1、操作码保留区。
    for (w in strSplit("00000000 ffffffff 00004000 7c000000 38800000", " ")) {
        const v = parseHex(w).v;
        if (la64Disasm(v) != ".inst 0x" + w) { failures = failures + 1; eprint("fixed " + w + " printed " + la64Disasm(v)); }
    }
    if (failures > 0) { eprint("FAIL " + toStr(failures) + " of " + toStr(good + bad)); return 1; }
    print("PASS_LA64_ENCODINGS " + toStr(good) + " " + toStr(bad) + " " + toStr(known));
    return 0;
}
