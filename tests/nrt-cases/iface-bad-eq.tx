// D3 v0.20：接口值是共享句柄，不能 == / !=（3030）。
interface Shape {
    area(): float;
}
struct Circle { r: float }
function circleArea(c: Circle): float { return c.r; }
function main(args: []string): int {
    const a: Shape = Circle { r: 1.0 };
    const b: Shape = Circle { r: 1.0 };
    if (a == b) { print("same"); }
    return 0;
}
