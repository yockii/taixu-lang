// ============================================================================
// engine/mac/m_pt —— objc_msgSend：id(id, SEL, NSPoint)（如 setFrameOrigin:）。
// ============================================================================

import { NSPOINT } from "./geom";
declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: NSPOINT): usize from "/usr/lib/libobjc.A.dylib";

export function msgPoint(o: usize, s: string, x: float, y: float): usize {
    return objc_msgSend(o, sel_registerName(s), NSPOINT { x: x, y: y });
}
