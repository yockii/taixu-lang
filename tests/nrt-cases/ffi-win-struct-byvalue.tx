// 按值结构体（D3 v0.45，Windows）：外部结构体按值传与返回。Win64 只看大小：1、2、4、8 字节的按同宽整数传（占该位置的整数寄存器，
// 全浮点的 _Fcomplex 也是）、在 RAX 返回；其余按引用传（调用方的 16 字节对齐临时内存），返回经隐藏指针（RCX）、其余实参
// 右移一位（_Cmulcr 的 double 因此在 XMM2）。按值参数调用后太虚侧不变；返回的是新值，与实参互不影响。
import { CARR, divNested, conjArr } from "./data/ffi_byvalue_win";

declare struct DIV { quot: i32, rem: i32 }
declare struct LLDIV { quot: int, rem: int }
declare struct DCOMPLEX { re: float, im: float }
declare struct FCOMPLEX { re: f32, im: f32 }
declare struct POINT { x: i32, y: i32 }
declare struct RECT { left: i32, top: i32, right: i32, bottom: i32 }
declare function div(a: i32, b: i32): DIV from "ucrtbase";
declare function lldiv(a: int, b: int): LLDIV from "ucrtbase";
declare function _Cbuild(re: float, im: float): DCOMPLEX from "ucrtbase";
declare function _FCbuild(re: f32, im: f32): FCOMPLEX from "ucrtbase";
declare function cabs(z: DCOMPLEX): float from "ucrtbase";
declare function cabsf(z: FCOMPLEX): f32 from "ucrtbase";
declare function conj(z: DCOMPLEX): DCOMPLEX from "ucrtbase";
declare function conjf(z: FCOMPLEX): FCOMPLEX from "ucrtbase";
declare function _Cmulcr(z: DCOMPLEX, r: float): DCOMPLEX from "ucrtbase";
declare function _Cmulcc(a: DCOMPLEX, b: DCOMPLEX): DCOMPLEX from "ucrtbase";
declare function PtInRect(r: Ref<RECT>, pt: POINT): i32 from "user32";

function showC(z: DCOMPLEX): string { return toStr(z.re) + "," + toStr(z.im); }
function showF(z: FCOMPLEX): string { return toStr(z.re) + "," + toStr(z.im); }

function main(args: []string): int {
    const d = div(17, 5);
    const n = div(-17, 5);
    print("div " + toStr(d.quot) + " " + toStr(d.rem) + " " + toStr(n.quot) + " " + toStr(n.rem));
    const l = lldiv(10000000000000, 7);
    print("lldiv " + toStr(l.quot) + " " + toStr(l.rem));
    const qr = divNested(-9, 4);
    print("nested " + toStr(qr.q[0]) + " " + toStr(qr.r.v));
    let z = _Cbuild(3.0, 4.0);
    print("cbuild " + showC(z) + " abs " + toStr(cabs(z)));
    const c = conj(z);
    print("conj " + showC(c) + " arg-kept " + showC(z));
    z.re = 9.0;
    print("result-kept " + showC(c) + " arg " + showC(z));
    const fz = _FCbuild(3.0, 4.0);
    print("fcbuild " + showF(fz) + " abs " + toStr(cabsf(fz)) + " conjf " + showF(conjf(fz)));
    print("mulcr " + showC(_Cmulcr(_Cbuild(3.0, 4.0), 2.5)));
    print("mulcc " + showC(_Cmulcc(_Cbuild(1.0, 2.0), _Cbuild(3.0, 4.0))));
    const arr = conjArr(CARR { v: [1.5, -2.5] });
    print("arr " + toStr(arr.v[0]) + "," + toStr(arr.v[1]));
    const r = new RECT { left: 0, top: 0, right: 10, bottom: 10 };
    const inside = POINT { x: 5, y: 5 };
    print("ptin " + toStr(PtInRect(r, inside)) + " " + toStr(PtInRect(r, POINT { x: 15, y: 5 })) + " kept " + toStr(inside.x) + "," + toStr(inside.y));
    return 0;
}
