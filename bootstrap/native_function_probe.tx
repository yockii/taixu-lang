// Producer boundaries, validated frame transitions and independently owned snapshots.
import { asStructuredBegin, asStructuredInstruction, asStructuredReg, asStructuredMissing, asStructuredLabel, asFailedAs, asLastErrAs, asImgText,
    asProducerFunctionBegin, asProducerFunctionPrologueEnd, asProducerFunctionEpilogueStart, asProducerFunctionEnd, asProducerFrame } from "./selfhost/assemble";
import { NativeFunctionImage, nativeFunctionsEnable, nativeFunctionsReset, nativeFunctionSource, nativeFunctionBegin,
    nativeFunctionEvent, nativeFunctionPrologueEnd, nativeFunctionEpilogueStart, nativeFunctionEnd, nativeFunctionsSnapshot } from "./selfhost/native_function_data";
import { linkMapEnable, linkMapScope, linkMapBegin, linkMapAddSection, linkMapAddPlacement, linkMapDone, linkMapData } from "./selfhost/link_map_data";
import { linkMapAttachFunctions } from "./selfhost/link_map_functions";
import { linkMapJson, linkMapText, linkMapFinish } from "./selfhost/link_map";
import { rawNameOf } from "./selfhost/binary_name";

function padding(): void { asStructuredInstruction("mov", 2, asStructuredReg(0, 0), asStructuredReg(0, 0), asStructuredMissing(), 1); }
function produce(id: int, extra: bool, size: int): void {
    asProducerFunctionBegin(id, 1);
    asProducerFrame("push-nonvolatile", 5, 8, 1); asProducerFrame("set-frame-pointer", 5, 0, 1);
    asProducerFrame("push-nonvolatile", 3, 8, 1); asProducerFrame("push-nonvolatile", 14, 8, 1); asProducerFrame("push-nonvolatile", 15, 8, 1);
    if (extra) { asProducerFrame("push-nonvolatile", 12, 8, 1); asProducerFrame("push-nonvolatile", 13, 8, 1); }
    asProducerFrame("allocate-stack", 4, size, 1); asProducerFunctionPrologueEnd();
    asStructuredLabel("internal_" + toStr(id)); padding(); padding(); padding();
    asProducerFunctionEpilogueStart(); asProducerFrame("release-stack", 4, size, 1);
    if (extra) { asProducerFrame("pop-nonvolatile", 13, 8, 1); asProducerFrame("pop-nonvolatile", 12, 8, 1); }
    asProducerFrame("pop-nonvolatile", 15, 8, 1); asProducerFrame("pop-nonvolatile", 14, 8, 1);
    asProducerFrame("pop-nonvolatile", 3, 8, 1); asProducerFrame("pop-nonvolatile", 5, 8, 1); asProducerFrame("return", -1, 8, 1);
    asProducerFunctionEnd();
}
function program(): Ref<NativeFunctionImage> {
    asStructuredBegin(); nativeFunctionSource(0, "库/引用\"\\\n.tx", "太虚函数"); nativeFunctionSource(1, "库/另一个.tx", "second");
    padding(); padding(); produce(0, false, 40);
    asStructuredLabel("unrelated_after_function"); padding(); padding(); padding();
    produce(1, true, 4096); padding();
    assert(asFailedAs() == 0, "producer assembly failed:" + asLastErrAs()); return nativeFunctionsSnapshot();
}
function layout(size: int): void {
    linkMapBegin("fixture"); linkMapAddSection(0, rawNameOf("text"), 9223372036854775697, 512, size, size);
    linkMapAddPlacement(7, 4, 0, 9223372036854775697, size); linkMapDone();
}
function source(): void { nativeFunctionsReset(); nativeFunctionSource(0, "m", "f"); }
function bad(message: string): void { const x = nativeFunctionsSnapshot(); assert(!x.ok && len(x.error) > 0 && listLen(x.functions) == 0, message); }
function negatives(): void {
    source(); nativeFunctionSource(0, "m", "duplicate"); bad("duplicate directory");
    source(); nativeFunctionBegin(1, "f_1", 0); bad("missing source");
    source(); nativeFunctionBegin(0, "f_0", 0); bad("unfinished function");
    source(); nativeFunctionEvent(0, 1, "return", -1, 8); bad("event outside function");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionEvent(0, 0, "return", -1, 8); bad("empty instruction");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionEvent(0, 2, "push-nonvolatile", 5, 8);
    nativeFunctionEvent(1, 3, "push-nonvolatile", 3, 8); bad("overlapping instructions");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionPrologueEnd(0); nativeFunctionEpilogueStart(0);
    nativeFunctionEvent(0, 1, "unknown", -1, 0); nativeFunctionEnd(1); bad("unknown frame action");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionEvent(0, 1, "push-nonvolatile", 0, 8);
    nativeFunctionPrologueEnd(1); nativeFunctionEpilogueStart(1); nativeFunctionEvent(1, 2, "return", -1, 8); nativeFunctionEnd(2); bad("volatile saved as nonvolatile");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionEvent(0, 1, "push-nonvolatile", 5, 8);
    nativeFunctionPrologueEnd(1); nativeFunctionEpilogueStart(1); nativeFunctionEvent(1, 2, "pop-nonvolatile", 3, 8);
    nativeFunctionEvent(2, 3, "return", -1, 8); nativeFunctionEnd(3); bad("wrong restore order");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionEvent(0, 1, "allocate-stack", 4, 16);
    nativeFunctionPrologueEnd(1); nativeFunctionEpilogueStart(1); nativeFunctionEvent(1, 2, "release-stack", 4, 8);
    nativeFunctionEvent(2, 3, "return", -1, 8); nativeFunctionEnd(3); bad("unbalanced stack");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionPrologueEnd(0); nativeFunctionEpilogueStart(0);
    nativeFunctionEvent(0, 2, "return", -1, 8); nativeFunctionEnd(1); bad("event outside function end");
    source(); nativeFunctionBegin(0, "f_0", 0); nativeFunctionPrologueEnd(0); nativeFunctionEpilogueStart(0);
    nativeFunctionEvent(0, 1, "return", -1, 8); nativeFunctionEnd(1); nativeFunctionBegin(0, "f_0", 0); bad("duplicate function");
    nativeFunctionsReset(); nativeFunctionSource(0, "m", "f"); nativeFunctionSource(1, "m", "g");
    nativeFunctionBegin(0, "f_0", 0); nativeFunctionPrologueEnd(0); nativeFunctionEpilogueStart(0);
    nativeFunctionEvent(0, 2, "return", -1, 8); nativeFunctionEnd(2); nativeFunctionBegin(1, "f_1", 1); bad("overlapping functions");
    nativeFunctionsEnable(false); bad("disabled collection"); nativeFunctionsEnable(true);
}
export function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    linkMapEnable(true); linkMapScope("functions"); const image = program(); assert(image.ok, image.error);
    const code = asImgText(); const file = bytesNew(512); bytesAppend(file, code);
    layout(bytesLen(code)); assert(linkMapAttachFunctions(image, 7, 4) == "", "attach failed");
    const d = linkMapFinish(file); const json = linkMapJson(d); const text = linkMapText(d);
    // Neither caller-owned input mutation nor assembly reset may alter the attached snapshot.
    for (f in image.functions) { f.name = "changed"; for (e in f.events) { e.bytes = 123; } }
    asStructuredBegin(); assert(linkMapJson(d) == json && linkMapText(d) == text, "attached snapshot shared input");
    const valid = program(); layout(bytesLen(code));
    assert(linkMapAttachFunctions(valid, 8, 4) != "" && !linkMapData().ok && listLen(linkMapData().functions) == 0, "missing placement accepted");
    let shortSize = 0; for (f in valid.functions) { shortSize = f.end - 1; }
    layout(shortSize); assert(linkMapAttachFunctions(valid, 7, 4) != "" && !linkMapData().ok, "out of placement accepted");
    layout(bytesLen(code)); linkMapAddPlacement(7, 4, 0, 9223372036854775697, bytesLen(code));
    assert(linkMapAttachFunctions(valid, 7, 4) != "", "duplicate placement accepted");
    layout(bytesLen(code)); assert(linkMapAttachFunctions(valid, 7, 4) == "", "reentry attach failed");
    assert(linkMapJson(linkMapFinish(file)) == json && linkMapJson(d) == json, "reentry modified facts");
    negatives(); assert(linkMapJson(d) == json, "failure modified retained map");
    linkMapEnable(false); program(); assert(listLen(linkMapData().functions) == 0, "disabled map retained facts");
    assert(bytesEqual(asImgText(), code), "metadata changed machine bytes");
    writeFileBytes(args[0], file) catch (e) { eprint(e.message); return 1; };
    writeFile(args[0] + ".txt", text) catch (e) { eprint(e.message); return 1; };
    print(json); return 0;
}
