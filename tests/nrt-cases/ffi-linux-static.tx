// 第 5 轮 FFI（D3 v0.23，Linux）：--static 要求静态产物，调用了 from "库" 的外部函数报 3033 并指出声明处。
declare function strlen(s: string): usize from "libc.so.6";
declare function getpid(): i32 from syscall 39;

function main(args: []string): int {
    print(toStr(getpid() > 0) + " " + toStr(strlen("abc") as int));
    return 0;
}
