// D3 v0.22：for-in 提前离开（break、return、? 传播出循环、所在 async 任务在循环内挂起时被取消）
// 关闭生成器，之后取值得 None；关闭发生在离开循环的那一刻。关闭时释放生成器持有的值（不执行
// 生成器体里的任何代码）；正常取完的生成器同样释放。

struct Box {
    tag: string,
}

function* counter(name: string, n: int): int {
    let i = 0;
    while (i < n) {
        yield i;
        i = i + 1;
    }
    print(name + " finished");
}

// 生成器的局部持有 Ref：关闭或取完后应被释放（弱引用随之失效）。
function* holder(b: Ref< Box>): string {
    const local = b;
    yield local.tag;
    yield local.tag + "2";
}

function firstOver(g: Gen< int>, limit: int): int {
    for (x in g) {
        if (x > limit) {
            return x;
        }
    }
    return -1;
}

function check(x: int): int | Error {
    if (x == 2) { return err("two"); }
    return x;
}

function sumChecked(g: Gen< int>): int | Error {
    let total = 0;
    for (x in g) {
        total = total + check(x)?;
    }
    return total;
}

let shared: List< Gen< int>> = listNew();

async function consume(g: Gen< int>): int {
    for (x in g) {
        print("consume " + toStr(x));
        await sleepMs(1000) catch (e) {
            return -1;
        };
    }
    return 0;
}

async function canceller(f: Future< int>, g: Gen< int>): int {
    await sleepMs(0) catch (e) {
        return -1;
    };
    taskCancel(f);
    print("after cancel: " + toStr(genNext(g) catch -1));
    return 0;
}

export function main(args: []string): int {
    // break：离开循环即关闭，循环之后同一块里取值已是 None。
    const g = counter("a", 10);
    for (x in g) {
        print("a " + toStr(x));
        if (x == 1) { break; }
    }
    print("a next: " + toStr(genNext(g) catch -1));

    // continue 不关闭。
    for (x in counter("b", 4)) {
        if (x % 2 == 0) { continue; }
        print("b " + toStr(x));
    }

    // return 出循环。
    const h = counter("c", 10);
    print("firstOver " + toStr(firstOver(h, 2)));
    print("c next: " + toStr(genNext(h) catch -1));

    // ? 传播出循环。
    const k = counter("d", 10);
    const r = sumChecked(k) catch -1;
    print("d result " + toStr(r) + ", next: " + toStr(genNext(k) catch -1));

    // 嵌套：内层提前离开只关闭内层。
    const outer = counter("o", 3);
    for (x in outer) {
        for (y in counter("i", 5)) {
            if (y == 1) { break; }
            print("pair " + toStr(x) + "," + toStr(y));
        }
    }

    // 关闭与取完都释放生成器持有的 Ref。
    let b1 = new Box { tag: "one" };
    const w1 = weak(b1);
    const s1 = holder(b1);
    b1 = new Box { tag: "other" };
    for (t in s1) {
        print("holder " + t);
        break;
    }
    print("closed holder freed: " + toStr(deref(w1) == None));
    let b2 = new Box { tag: "two" };
    const w2 = weak(b2);
    const s2 = holder(b2);
    b2 = new Box { tag: "other" };
    for (t in s2) {
        print("holder " + t);
    }
    print("finished holder freed: " + toStr(deref(w2) == None));
    let b3 = new Box { tag: "three" };
    const w3 = weak(b3);
    listPush(shared, counter("e", 1));
    const s3 = holder(b3);
    b3 = new Box { tag: "other" };
    print("unstarted holder alive: " + toStr(deref(w3) != None));

    // async 任务在循环内挂起时被取消：取消落点关闭生成器。
    const cg = counter("f", 5);
    const f = consume(cg);
    canceller(f, cg);
    return 0;
}
