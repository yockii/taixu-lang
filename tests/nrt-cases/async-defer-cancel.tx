// D3 v0.21：async 函数内的 defer。正常返回、错误返回与普通函数相同；任务挂起中
// （await 或 taskAwaitAny）被取消时，从挂起点按后进先出执行该点已登记的 defer，
// 再置为已取消，观察者得 err("task cancelled")。未启动就被取消的任务没有登记任何
// defer。落点里的 defer 可以再取消别的挂起任务（嵌套落点），其间 taskCancelled()
// 为真。挂起后已被唤醒、尚在就绪队里的任务被取消，同样走落点。
let victims: List< Future< int> > = listNew();
let chainedVictims: List< Future< int> > = listNew();
let lateVictims: List< Future< int> > = listNew();

async function worker(tag: string, ms: int): int {
    const label = tag + "#" + toStr(ms);
    defer print(label + " outer defer");
    print(label + " start");
    if (ms >= 0) {
        defer print(label + " inner defer, cancelled=" + toStr(taskCancelled()));
        await sleepMs(ms) catch (e) {
            return -1;
        };
        print(label + " woke");
    }
    return ms;
}

async function failing(): int {
    defer print("failing defer");
    await sleepMs(0) catch (e) {
        return -1;
    };
    return err("boom");
}

async function picker(tag: string): int {
    defer print(tag + " picker defer");
    const l: List< Future< void> > = listNew();
    listPush(l, sleepMs(60000));
    const i = taskAwaitAny(l) catch -1;
    print(tag + " picked " + toStr(i));
    return i;
}

function cancelAll(fs: List< Future< int> >): void | Error {
    let i = 0;
    while (i < listLen(fs)) {
        const f = (listGet(fs, i) catch err("none"))?;
        taskCancel(f);
        i = i + 1;
    }
    return assert(true, "cancelAll");
}

async function chained(): int {
    defer {
        print("chained defer cancels h");
        cancelAll(chainedVictims) catch (e) {
            print(e.message);
        };
    }
    await sleepMs(60000) catch (e) {
        return -1;
    };
    return 0;
}

async function canceller(): int {
    print("canceller runs");
    cancelAll(victims) catch (e) {
        print(e.message);
    };
    return 0;
}

// 定时器先于 f 登记，下一轮先于 f 被唤醒：此时 f 已被唤醒、尚在就绪队里。
async function lateCanceller(): int {
    await sleepMs(0) catch (e) {
        return -1;
    };
    print("late canceller runs");
    cancelAll(lateVictims) catch (e) {
        print(e.message);
    };
    return 0;
}

async function watch(f: Future < int >, tag: string): int {
    const v = await f catch (e) {
        print(tag + " -> " + e.message);
        return -1;
    };
    print(tag + " -> " + toStr(v));
    return v;
}

function main(args: []string): int {
    const a = worker("a", 0);
    const b = worker("b", 60000);
    const c = picker("c");
    const d = failing();
    const h = worker("h", 60000);
    listPush(chainedVictims, h);
    const g = chained();
    listPush(victims, b);
    listPush(victims, c);
    listPush(victims, g);
    const q = worker("q", 60000);
    taskCancel(q);
    const k = canceller();
    const late = lateCanceller();
    const f = worker("f", 0);
    listPush(lateVictims, f);
    const wa = watch(a, "wa");
    const wb = watch(b, "wb");
    const wc = watch(c, "wc");
    const wd = watch(d, "wd");
    const wf = watch(f, "wf");
    const wh = watch(h, "wh");
    const wq = watch(q, "wq");
    print("spawned");
    return 0;
}
