// engine/fontdirs_linux —— Linux 的系统字体目录（fontconfig 的缺省目录）：/usr/share/fonts、
// /usr/local/share/fonts、$XDG_DATA_HOME/fonts（缺省 ~/.local/share/fonts）与 ~/.fonts，都递归（以“/”结尾）。
import { getenv } from "std/os";

export function fontDirs(): List<string> {
    const out: List<string> = listNew();
    listPush(out, "/usr/share/fonts/");
    listPush(out, "/usr/local/share/fonts/");
    const home: string = getenv("HOME");
    const data: string = getenv("XDG_DATA_HOME");
    if (len(data) > 0) {
        listPush(out, data + "/fonts/");
    } else if (len(home) > 0) {
        listPush(out, home + "/.local/share/fonts/");
    }
    if (len(home) > 0) {
        listPush(out, home + "/.fonts/");
    }
    return out;
}
