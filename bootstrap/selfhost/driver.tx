// driver.tx —— .tx 侧编译驱动编排（V0.50-S5-① 批 E；D102 §一——
// bootstrap/taixu.tx 的必需职责件：模块发现、相对路径归一、全编译阶段调度）。
//
// 编排链＝loadGraph→SEIN→semamirror→loader→codegen→serialize 的 .tx 侧：
//   1) 模块发现：入口源 DFS——import spec 逐层解析（txImports 读 TXB1 顶层
//      import_d——semamirror 库面），后序＝导入先、入口末（SEIN 拓扑序）。
//   2) SEIN1 组装：display（入口＝CWD 相对反斜杠形；导入＝spec 逻辑名——
//      V0.39-P0 BUILD-05 同构）＋node_count（TXB1 头）＋AST-BIN＋导入映射。
//   3) semamirror 库面 mirrorSein 进程内执行（SEB1+FAB1 字符串）。
//   4) codegen 库面 codegenTxc（SEB1+FAB1→PROGDUMP→serializeDump→.txc 字节）。
//
// 锚＝驱动产物 .txc 与 seed 链（dev-load-compile）逐字节恒等（hello
// 69b4e54b）。stdlib（"std/"）按导入根解析；原生 CLI 能力由 capabilities 明录。

import { parseSourceBin } from "../parser";
import { mirrorSein, mirrorCheck, mirrorCheckCached, SmCheckCache, smCheckCacheNew, smSeb1Out, smFab1Out, txImports } from "../semamirror";
import { codegenTxc, cgLastError, parseSeb1, generateProgramContext, diagRenderSv, cgSetModulePaths, cgSetDebug, cgUsesToolBuiltins, cgEmbedSites, cgEmbedSiteFromRaw, CgEmbedSite } from "./codegen";
import { DrvDiag, newDrvDiag, renderDrvDiags, parseLineDiag, textDiags, semaDiags, embedDiags, checkDiags, embedDiagsFor } from "./check_diag";
import { CheckModule, CheckResult } from "./check_model";
import { SourceCache, sourceCacheNew, sourceCacheBegin, sourceCacheFinish, sourceParse, sourceImports } from "./source_cache";
import { serializeDump } from "./bytecode";
import { ProgramContext } from "./program_context";
import { compileProfileActive, compileProfileBegin, compileProfileEnd, compileProfilePhase, compileProfileProgram, compileProfileClock, compileProfileCodegenDetail, compileProfileTextHop } from "./compile_profile_data";
import { recordProgramContext, recordMsgCount, recordMsgAt, recordSetBorrow } from "./emit_record";
import { emSetListing, emitNativeRecords, emitRecords, emSOut, emReady, emDiagOut, emSetFfiStubs } from "../emitmirror";
import { emitPortableRecords, epDiagOut } from "./emit_portable";
import { asListingStart, asListingStop, asListingClear, asBufferNew, asBufferNewA64, asBufferSubmit, assembleText, asFailedAs, asLastErrAs, asLastLineAs, asStructuredSection, asStructuredAlign, asStructuredLabel, asStructuredByte, asStructuredQuad, asStructuredAddress, asStructuredBegin, asStructuredInstruction, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMissing, asResolveLocalFixups } from "./assemble";
import { a64BufferSubmit } from "./a64_asm";
import { linkExeObjects, exeBytesList, lkIsFailed, lkGetMissing, lkSetImportDll, lkClearImportDlls } from "./link_pe";
import { ffiPrepare, ffiEmitStubs, ffiStubIndices, ffiStubError, ffiDllName, ffiLinkReport, ffiImportSymbol } from "./ffi_stubs";
import { macDylib } from "./macos_symbols";
import { T_X64_WINDOWS, targetName, targetFileSuffixes, tPe, tElf, tLinux, tMacos, tRawSyscall, tA64 } from "./target";
import { linkMachO, machoBytes, machoError, machoImportReset, machoImportFrom, machoIdentifierFor } from "./link_macho";
