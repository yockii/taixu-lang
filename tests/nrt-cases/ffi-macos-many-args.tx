// macOS 适配 M4d（伴文件 .macos）：实参多于 8 个的外部函数。CCCrypt（libSystem 的 CommonCrypto）有 11 个实参，
// 后三个经栈传：x86_64 每个占 8 字节，Apple arm64 按自然大小紧排（这里都是 8 字节宽）。以 FIPS-197 附录 C.1 的
// AES-128 向量核对：密钥 000102…0f、明文 00112233…ff，ECB 不补位，密文 69c4e0d86a7b0430d8cdb78070b4c55a。
declare function CCCrypt(op: u32, alg: u32, options: u32, key: Bytes, keyLength: usize, iv: usize, dataIn: Bytes, dataInLength: usize, dataOut: Bytes, dataOutAvailable: usize, dataOutMoved: Bytes): i32 from "libSystem";

function hex(b: Bytes, n: int): string {
    const digits = "0123456789abcdef";
    let out = "";
    let i = 0;
    while (i < n) {
        const v = bytesGet(b, i) catch 0;
        out = out + strSub(digits, v / 16, 1) + strSub(digits, v % 16, 1);
        i = i + 1;
    }
    return out;
}

function main(args: []string): int {
    const key = bytesNew(16);
    const plain = bytesNew(16);
    let i = 0;
    while (i < 16) {
        bytesSet(key, i, i);
        bytesSet(plain, i, i * 17);
        i = i + 1;
    }
    const out = bytesNew(16);
    const moved = bytesNew(8);
    // kCCEncrypt 0、kCCAlgorithmAES 0、kCCOptionECBMode 2（不补位）。
    const status = CCCrypt(0 as u32, 0 as u32, 2 as u32, key, 16 as usize, 0 as usize, plain, 16 as usize, out, 16 as usize, moved);
    print("status " + toStr(status));
    print("moved " + toStr(bytesGet(moved, 0) catch -1));
    print(hex(out, 16));
    return 0;
}
