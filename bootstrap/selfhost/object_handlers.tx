// Native field/index window handlers. Obj72 is shared; lookup/diagnostics are facts.
import { StructuredBuffer } from "./assemble";
import { nr, nd, nb, ni, nm, nmd, nmb, nt, nmov, nl, nj, nc, nret } from "./native_emit";
import { TB_MASK, TB_SLOTS } from "./thread_block_abi";
import { OBJ_FLAG_FROZEN } from "./store_abi";
function ptr(b: Ref<StructuredBuffer>, index: int, out: int): void {
    nmov(b, nd(out), nd(index)); nt(b, "shl", nr(out), ni(4)); nt(b, "add", nr(out), nm(4, 48));
}
// 冻结检查（线程第 4b 步）：对象地址在 rax，冻结即跳 target（用 r10）。
function frozenJump(b: Ref<StructuredBuffer>, target: string): void {
    nmov(b, nd(10), nmd(0, 0)); nt(b, "and", nd(10), ni(OBJ_FLAG_FROZEN)); nj(b, "jne", target);
}
function snap(b: Ref<StructuredBuffer>, source: int, off: int): void {
    nmov(b, nr(11), nm(source, 0)); nmov(b, nm(4, off), nr(11)); nmov(b, nr(11), nm(source, 8)); nmov(b, nm(4, off + 8), nr(11));
}
// 字段选择子：NRT 内核配原生链（TXC v6）——标志第 15 位、字段号 15 位；宿主内核配 Zig 链（v4）——0x80、7 位。
function handler(b: Ref<StructuredBuffer>, name: string, field: bool, write: bool, nrt: bool): void {
    let fflag = 128;
    let fmask = 127;
    if (nrt) { fflag = 32768; fmask = 32767; }
    nl(b, name); nt(b, "sub", nr(4), ni(152)); nmov(b, nm(4, 48), nr(1)); nmov(b, nmd(4, 56), nd(2)); nmov(b, nmd(4, 60), nd(8)); nmov(b, nmd(4, 64), nd(9));
    nmov(b, nd(10), nmd(4, 192)); nmov(b, nmd(4, 68), nd(10)); nmov(b, nd(10), nmd(4, 200)); nmov(b, nmd(4, 72), nd(10));
    // Both operands and the incoming value survive callbacks/register clobbering.
    nmov(b, nd(10), nmd(4, 68)); if (write) { nmov(b, nd(10), nmd(4, 64)); }
    ptr(b, 10, 10); snap(b, 10, 80);
    if (write) { nmov(b, nd(10), nmd(4, 72)); ptr(b, 10, 10); snap(b, 10, 112); }
    if (field == false) { nmov(b, nd(10), nmd(4, 72)); if (write) { nmov(b, nd(10), nmd(4, 68)); } ptr(b, 10, 10); snap(b, 10, 96); nt(b, "cmp", nmb(4, 96), ni(1)); nj(b, "jne", name + "_index_type"); }
    if (field) {
        nmov(b, nd(10), nmd(4, 72)); if (write) { nmov(b, nd(10), nmd(4, 68)); } nt(b, "and", nd(10), ni(fflag)); nj(b, "jz", name + "_autook"); nt(b, "cmp", nmb(4, 80), ni(9)); nj(b, "jne", name + "_autoderef"); nl(b, name + "_autook");
        nt(b, "cmp", nmb(4, 80), ni(5)); if (write == false) { nj(b, "je", name + "_err_message"); }
        nt(b, "cmp", nmb(4, 80), ni(7)); nj(b, "je", name + "_obj"); nt(b, "cmp", nmb(4, 80), ni(8)); nj(b, "je", name + "_obj"); nt(b, "cmp", nmb(4, 80), ni(9)); nj(b, "jne", name + "_type");
    } else {
        nt(b, "cmp", nmb(4, 80), ni(10)); nj(b, "je", name + "_obj"); nt(b, "cmp", nmb(4, 80), ni(11)); nj(b, "jne", name + "_type");
    }
    nl(b, name + "_obj"); nmov(b, nd(1), nmd(4, 88)); nc(b, "__tx_native_object_address_v1"); nmov(b, nm(4, 128), nr(0));
    if (write) { frozenJump(b, name + "_frozen"); }
    if (field) {
        nt(b, "cmp", nmd(0, 16), ni(1)); nj(b, "je", name + "_span"); nt(b, "cmp", nmd(0, 16), ni(2)); nj(b, "jne", name + "_payload");
        nl(b, name + "_span"); nmov(b, nd(10), nmd(4, 72)); if (write) { nmov(b, nd(10), nmd(4, 68)); nt(b, "and", nd(10), ni(fmask)); } else { nt(b, "and", nd(10), ni(fmask)); }
        nt(b, "cmp", nr(10), nm(0, 40)); nj(b, "jae", name + "_bounds");
    } else {
        nmov(b, nr(10), nm(4, 104)); nt(b, "test", nr(10), nr(10)); nj(b, "js", name + "_bounds");
        nt(b, "cmp", nmb(4, 80), ni(11)); nj(b, "je", name + "_slice"); nmov(b, nd(11), nmd(0, 24)); nt(b, "cmp", nr(10), nr(11)); nj(b, "jae", name + "_bounds"); nj(b, "jmp", name + "_span");
        nl(b, name + "_slice"); nmov(b, nd(11), nmd(0, 28)); nt(b, "cmp", nr(10), nr(11)); nj(b, "jae", name + "_bounds"); nmov(b, nd(1), nmd(0, 24)); nc(b, "__tx_native_object_address_v1"); if (write) { frozenJump(b, name + "_frozen"); } nmov(b, nr(10), nm(4, 104));
        nl(b, name + "_span");
    }
    nt(b, "shl", nr(10), ni(4)); nt(b, "add", nr(10), nm(0, 32));
    if (write) { nmov(b, nr(1), nr(10)); nmov(b, nr(2), nr(4)); nt(b, "add", nr(2), ni(112)); }
    else { nmov(b, nr(2), nr(10)); nmov(b, nd(10), nmd(4, 64)); ptr(b, 10, 1); }
    nc(b, "__tx_native_value_replace_v1"); nj(b, "jmp", name + "_done");
    if (field && write == false) {
        nl(b, name + "_err_message"); nmov(b, nd(10), nmd(4, 72)); nt(b, "and", nd(10), ni(fmask)); nt(b, "test", nd(10), nd(10)); nj(b, "jne", name + "_err_field");
        nmov(b, nd(1), nmd(4, 88)); nmov(b, nd(2), nmd(4, 56)); nmov(b, nd(8), nmd(4, 60)); nmov(b, nr(9), nr(4)); nt(b, "add", nr(9), ni(96)); nc(b, "__tx_native_error_message_v1");
        nmov(b, nd(10), nmd(4, 64)); ptr(b, 10, 1); nmov(b, nr(2), nr(4)); nt(b, "add", nr(2), ni(96)); nc(b, "__tx_native_value_replace_v1");
        // 暂存的 message 拷贝（rc=1）在 replace 写入目标时已 retain，这里放掉暂存那份（泄漏检查设计 §六-C）。
        if (nrt) { nmov(b, nr(1), nr(4)); nt(b, "add", nr(1), ni(96)); nc(b, "__tx_release"); }
        nj(b, "jmp", name + "_done");
    }
    const statuses: List<string> = listNew(); listPush(statuses, "type"); listPush(statuses, "payload"); listPush(statuses, "bounds"); listPush(statuses, "index_type"); listPush(statuses, "autoderef"); listPush(statuses, "err_field");
    let k = 0; while (k < listLen(statuses)) {
        nl(b, name + "_" + (listGet(statuses, k) catch "")); nmov(b, nd(2), ni(k + 1));
        if (field == false && k == 2) { nt(b, "cmp", nmb(4, 80), ni(11)); nj(b, "jne", name + "_error"); nmov(b, nd(2), ni(7)); }
        nj(b, "jmp", name + "_error"); k = k + 1;
    }
    // 状态 8：写冻结对象（7 已用于切片越界）。
    if (write) { nl(b, name + "_frozen"); nmov(b, nd(2), ni(8)); nj(b, "jmp", name + "_error"); }
    nl(b, name + "_error"); let op = 0; if (field == false) { op = 2; } if (write) { op = op + 1; }
    nmov(b, nd(1), ni(op)); nmov(b, nd(8), nmd(4, 56)); nmov(b, nd(9), nmd(4, 60)); nc(b, "__tx_native_object_handler_error_v1");
    nl(b, name + "_done"); nt(b, "add", nr(4), ni(152)); nret(b);
}
// NRT: object address inline (rax = slot state->objects + idx*72, the slot state being
// the thread-block field at TB_SLOTS with TB = rbx & TB_MASK; only rax/r10/r11 written),
// so the accessors stay leaf functions.
function objAddr(b: Ref<StructuredBuffer>, nrt: bool): void {
    if (!nrt) { nt(b, "sub", nr(4), ni(40)); nc(b, "__tx_native_object_address_v1"); nt(b, "add", nr(4), ni(40)); return; }
    nmov(b, nd(0), nd(1)); nmov(b, nr(11), nr(0)); nt(b, "shl", nr(11), ni(3)); nt(b, "shl", nr(0), ni(6)); nt(b, "add", nr(0), nr(11));
    nmov(b, nr(10), nr(3)); nt(b, "and", nr(10), ni(TB_MASK)); nmov(b, nr(10), nm(10, TB_SLOTS)); nt(b, "add", nr(0), nm(10, 48));
}
// write：写用版本（线程第 4b 步），冻结对象返回 0，调用方转慢路径由内核报 4022。
function accessor(b: Ref<StructuredBuffer>, name: string, mode: int, nrt: bool, write: bool): void {
    nl(b, name); objAddr(b, nrt);
    if (write) { frozenJump(b, name + "_none"); }
    if (mode == 0) { nt(b, "cmp", nmd(0, 16), ni(1)); nj(b, "je", name + "_span"); nt(b, "cmp", nmd(0, 16), ni(2)); nj(b, "jne", name + "_none"); }
    if (mode == 1) { nt(b, "cmp", nmd(0, 16), ni(7)); nj(b, "jne", name + "_none"); nt(b, "cmp", nmd(0, 28), ni(1)); nj(b, "jne", name + "_none"); }
    if (mode == 2) {
        nt(b, "cmp", nmd(0, 16), ni(0)); nj(b, "je", name + "_span");
        // O4 第二步 2c2：Bytes 是列表形态（pk 7、form 3、elem 4），跨度同样是 ptr@32 len@40 cap@48。
        nt(b, "cmp", nmd(0, 16), ni(7)); nj(b, "jne", name + "_none");
        nt(b, "cmp", nmd(0, 28), ni(3)); nj(b, "jne", name + "_none");
        nt(b, "cmp", nmd(0, 24), ni(4)); nj(b, "jne", name + "_none");
    }
    if (mode == 3) {
        nt(b, "cmp", nmd(0, 16), ni(3)); nj(b, "je", name + "_array"); nt(b, "cmp", nmd(0, 16), ni(4)); nj(b, "jne", name + "_none"); nt(b, "add", nr(0), ni(28)); nret(b);
        nl(b, name + "_array"); nt(b, "add", nr(0), ni(24)); nret(b);
    } else { nl(b, name + "_span"); nt(b, "add", nr(0), ni(32)); nret(b); }
    nl(b, name + "_none"); nmov(b, nd(0), ni(0)); nret(b);
}
function listView(b: Ref<StructuredBuffer>, nrt: bool, write: bool): void {
    let name = "__tx_list_view";
    if (write) { name = "__tx_list_view_w"; }
    if (nrt) {
        nl(b, name); objAddr(b, true);
        if (write) { frozenJump(b, name + "_none"); }
        nt(b, "cmp", nmd(0, 16), ni(7)); nj(b, "jne", name + "_none"); nmov(b, nr(10), nm(0, 32)); nmov(b, nm(2, 0), nr(10)); nmov(b, nr(10), nm(0, 40)); nmov(b, nm(2, 8), nr(10));
        nmov(b, nd(10), nmd(0, 24)); nmov(b, nmd(2, 16), nd(10)); nmov(b, nd(0), nmd(0, 28));
        // 紧凑列表（form 3，O4 第二步）不给内联快路径：返回 0，调用方转通用 callbi，由内建分派到紧凑例程。
        nt(b, "cmp", nd(0), ni(3)); nj(b, "je", name + "_none"); nret(b);
        nl(b, name + "_none"); nmov(b, nd(0), ni(0)); nret(b);
        return;
    }
    nl(b, name); nt(b, "sub", nr(4), ni(56)); nmov(b, nm(4, 40), nr(2)); nc(b, "__tx_native_object_address_v1");
    if (write) { frozenJump(b, name + "_none"); }
    nt(b, "cmp", nmd(0, 16), ni(7)); nj(b, "jne", name + "_none"); nmov(b, nr(2), nm(4, 40)); nmov(b, nr(10), nm(0, 32)); nmov(b, nm(2, 0), nr(10)); nmov(b, nr(10), nm(0, 40)); nmov(b, nm(2, 8), nr(10));
    nmov(b, nd(10), nmd(0, 24)); nmov(b, nmd(2, 16), nd(10)); nmov(b, nd(0), nmd(0, 28)); nt(b, "add", nr(4), ni(56)); nret(b);
    nl(b, name + "_none"); nmov(b, nd(0), ni(0)); nt(b, "add", nr(4), ni(56)); nret(b);
}
function callee(b: Ref<StructuredBuffer>): void {
    const name = "__tx_callee_fn_env"; nl(b, name); nt(b, "sub", nr(4), ni(56)); nmov(b, nmd(4, 40), nd(2)); nmov(b, nmd(4, 44), nd(8));
    nt(b, "cmp", nmb(1, 0), ni(9)); nj(b, "jne", name + "_bad"); nmov(b, nd(1), nmd(1, 8)); nc(b, "__tx_native_object_address_v1");
    nt(b, "cmp", nmd(0, 16), ni(1)); nj(b, "jne", name + "_bad"); nt(b, "cmp", nm(0, 40), ni(2)); nj(b, "jb", name + "_bad"); nmov(b, nr(10), nm(0, 32)); nt(b, "cmp", nmb(10, 0), ni(12)); nj(b, "jne", name + "_bad"); nmov(b, nd(0), nmd(10, 8)); nt(b, "add", nr(4), ni(56)); nret(b);
    nl(b, name + "_bad"); nmov(b, nd(1), ni(4)); nmov(b, nd(2), ni(1)); nmov(b, nd(8), nmd(4, 40)); nmov(b, nd(9), nmd(4, 44)); nc(b, "__tx_native_object_handler_error_v1"); nt(b, "add", nr(4), ni(56)); nret(b);
}
export function objectHandlerNames(): List<string> {
    const names: List<string> = listNew(); listPush(names, "__tx_getfld"); listPush(names, "__tx_setfld"); listPush(names, "__tx_getidx"); listPush(names, "__tx_setidx"); listPush(names, "__tx_obj_fields"); listPush(names, "__tx_list_items"); listPush(names, "__tx_str_bytes"); listPush(names, "__tx_seq_len"); listPush(names, "__tx_list_view"); listPush(names, "__tx_callee_fn_env");
    listPush(names, "__tx_obj_fields_w"); listPush(names, "__tx_str_bytes_w"); listPush(names, "__tx_list_view_w"); return names;
}
export function objectHandlersEmit(b: Ref<StructuredBuffer>, nrt: bool): void {
    handler(b, "__tx_getfld", true, false, nrt); handler(b, "__tx_setfld", true, true, nrt); handler(b, "__tx_getidx", false, false, nrt); handler(b, "__tx_setidx", false, true, nrt);
    accessor(b, "__tx_obj_fields", 0, nrt, false); accessor(b, "__tx_list_items", 1, nrt, false); accessor(b, "__tx_str_bytes", 2, nrt, false); accessor(b, "__tx_seq_len", 3, nrt, false); listView(b, nrt, false); callee(b);
    // 写用访问器（线程第 4b 步）：字段写、bytesSet/bytesPush、listSet 的内联快路径用。
    accessor(b, "__tx_obj_fields_w", 0, nrt, true); accessor(b, "__tx_str_bytes_w", 2, nrt, true); listView(b, nrt, true);
}
