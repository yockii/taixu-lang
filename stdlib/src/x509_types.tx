// X.509 的原始字段；结构读取不等于信任验证。oidHex 是 OID 内容字节的规范小写 hex。
export struct X509Algorithm { oidHex: string, parameters: Bytes, encoding: Bytes }
export struct X509Extension { oidHex: string, critical: bool, value: Bytes }
export struct X509Certificate {
    der: Bytes,
    tbs: Bytes,
    version: int,
    serial: Bytes,
    issuer: Bytes,
    subject: Bytes,
    notBeforeSecs: int,
    notAfterSecs: int,
    publicKeyAlgorithm: X509Algorithm,
    publicKey: Bytes,
    spki: Bytes,
    signatureAlgorithm: X509Algorithm,
    signature: Bytes,
    extensions: List<X509Extension>,
}
