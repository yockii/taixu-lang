// 线程的前端规则（线程设计 §十三-3、§十八）：threadSpawn 的实参是无参、非 async 的函数值（顶层函数名、箭头函数
// 字面量、变量、字段……），其余报 3035；Thread 不可 ==；threadJoin 只收 Thread。
function work(): int {
    return 1;
}

function withArg(n: int): int {
    return n;
}

async function later(): int {
    return 1;
}

function main(args: []string): void {
    const g: (int) => int = withArg;
    const t3 = threadSpawn(withArg);
    const t5 = threadSpawn(g);
    const t6 = threadSpawn(later);
    const t7 = threadSpawn((n: int): int => n);
    const a = threadSpawn(work);
    const b = threadSpawn(work);
    print(toStr(a == b));
    print(toStr(threadJoin(5) catch 0));
}
