// Test-only object producer; never a production builtin or CLI mode.
// arm64 只有可移植版（generic；A64 内核全为 rtfn）。
import { runtimeRcBoundaryEmit, runtimeRcBoundaryEmitGeneric } from "./runtime_memory_gen";
import { probeBuffer, probeWrite } from "./native_probe_object";
import { targetParseAnalysis, tA64 } from "./selfhost/target";
function main(args: []string): int {
    if (len(args) != 4 || args[0] != "--target" || (args[3] != "plain" && args[3] != "nrt" && args[3] != "generic")) { return 64; }
    const t = targetParseAnalysis(args[1]);
    if (t < 0 || (tA64(t) && args[3] != "generic")) { return 64; }
    const buf = probeBuffer(t);
    if (args[3] == "generic") {
        // 可移植版（rtfn）：语义须与手写的 NRT 形相同，同一个驱动核对。
        const failure = runtimeRcBoundaryEmitGeneric(buf, t);
        if (len(failure) > 0) { eprint(failure); return 66; }
    } else { runtimeRcBoundaryEmit(buf, args[3] == "nrt"); }
    const exports: List<string> = listNew(); listPush(exports, "__tx_retain"); listPush(exports, "__tx_release");
    return probeWrite(buf, t, args[2], exports);
}
