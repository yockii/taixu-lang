// Independent fixtures exercise both production linkers and owned map snapshots.
import { linkElfObjects, elfObjectsBytes, elfDynReset, elfDynNeeded, elfDynImport } from "./selfhost/link_elf_objects";
import { linkExeObjects, exeBytesList } from "./selfhost/link_pe";
import { asStructuredBegin, asStructuredSection, asStructuredLabel, asStructuredInstruction, asStructuredReg,
    asStructuredMem, asStructuredMissing, asStructuredByte, asStructuredAddress, asStructuredZero, asResolveLocalFixups, asFailedAs } from "./selfhost/assemble";
import { linkMapEnable, linkMapData } from "./selfhost/link_map_data";
import { linkMapFinish, linkMapJson, linkMapText } from "./selfhost/link_map";

function program(): void {
    asStructuredBegin(); asStructuredLabel("__tx_entry");
    const missing = asStructuredMissing();
    asStructuredInstruction("lea", 2, asStructuredReg(0, 0), asStructuredMem(2, -1, -1, 0, 0, 1, "payload"), missing, 1);
    asStructuredInstruction("ret", 0, missing, missing, missing, 1);
    asStructuredSection(1); asStructuredLabel("payload"); asStructuredByte(65); asStructuredByte(66);
    asStructuredLabel("未引用标签"); asStructuredByte(67);
    asStructuredSection(2); asStructuredLabel("entry_slot"); asStructuredAddress("__tx_entry");
    asStructuredSection(3); asStructuredLabel("zero_slot"); asStructuredZero(37);
    asResolveLocalFixups(); assert(asFailedAs() == 0, "fixture assembly");
}
function invoke(mode: string, objects: List<Bytes>): int {
    if (mode == "elf" || mode == "elf-dynamic") {
        elfDynReset();
        if (mode == "elf-dynamic") { elfDynNeeded("libc.so.6"); elfDynImport("getenv"); }
        return linkElfObjects(objects, "_start");
    }
    program();
    const rest: List<Bytes> = listNew(); let i = 1;
    while (i < listLen(objects)) { listPush(rest, listGet(objects, i) catch bytesNew(0)); i = i + 1; }
    return linkExeObjects(listGet(objects, 0) catch bytesNew(0), 0, rest);
}
function product(mode: string): Bytes { if (mode == "elf" || mode == "elf-dynamic") { return elfObjectsBytes(); } return exeBytesList(); }
export function main(args: []string): int {
    if (len(args) < 3) { return 64; }
    const mode = args[0]; const output = args[1]; const objects: List<Bytes> = listNew(); let i = 2;
    while (i < len(args)) { const bytes = readFileBytes(args[i]) catch (e) { eprint(e.message); return 65; }; listPush(objects, bytes); i = i + 1; }
    linkMapEnable(true);
    const rc = invoke(mode, objects);
    if (rc != 0) { assert(!linkMapData().ok && listLen(linkMapData().symbols) == 0, "failed map retained rows"); print(linkMapJson(linkMapData())); return rc; }
    const image = product(mode); const facts = linkMapFinish(image); const json = linkMapJson(facts); const text = linkMapText(facts);
    writeFileBytes(output, image) catch (e) { eprint(e.message); return 1; };
    writeFile(output + ".txt", text) catch (e) { eprint(e.message); return 1; };
    const bad: List<Bytes> = listNew(); listPush(bad, bytesNew(0));
    assert(invoke(mode, bad) != 0 && !linkMapData().ok && listLen(linkMapData().symbols) == 0, "failure cleanup");
    assert(linkMapJson(facts) == json && linkMapText(facts) == text, "previous snapshot changed after failure");
    linkMapEnable(false);
    assert(invoke(mode, objects) == 0 && !linkMapData().ok && listLen(linkMapData().symbols) == 0, "disabled mode retained map");
    assert(bytesEqual(image, product(mode)), "map changed product");
    linkMapEnable(true);
    assert(invoke(mode, objects) == 0, "successful reentry"); const next = linkMapFinish(product(mode));
    assert(linkMapJson(next) == json, "reentry changed facts or product");
    for (bytes in objects) { let j = 0; while (j < bytesLen(bytes)) { bytesSet(bytes, j, 0); j = j + 1; } }
    assert(linkMapJson(facts) == json && linkMapJson(next) == json, "input mutation changed owned names");
    assert(invoke(mode, objects) != 0 && !linkMapData().ok, "corrupt input accepted");
    assert(linkMapJson(facts) == json, "failure modified retained result");
    print(json); return 0;
}
