// 线程第 2 步（线程设计 §四-2、§十一-4）：线程里 trap 即打印诊断并终止整个进程（退出码 3），main 停在 join 上
// 也一样；四个线程几乎同时 trap 时，只有先到致命锁的一个输出诊断，其余等到进程结束（诊断不交错）。
function boom(): int {
    let i = 0;
    while (i < 1000) {
        i = i + 1;
    }
    assert(i == 0, "线程里的断言");
    return i;
}

function main(args: []string): void {
    const ts: List< Thread< int>> = listNew();
    let k = 0;
    while (k < 4) {
        listPush(ts, threadSpawn(boom));
        k = k + 1;
    }
    for (t in ts) {
        print(toStr(threadJoin(t) catch -1));
    }
    print("unreachable");
}
