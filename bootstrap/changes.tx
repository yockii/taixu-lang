    {
        id: "lang.argv-valid-utf8",
        kind: 3,
        layer: "lang",
        since: "0.2.24-dev",
        gate: "alpha",
        diagnostics: [],
        fix: "命令行参数不是合法 UTF-8（Windows 为不成对的 UTF-16 代理）时进程在入口拒绝启动：stderr 含 argv acquisition failed: InvalidUnicode，退出码 64（同 Rust 的 env::args()；Windows 自 2026-10-07 起即如此）。此前 Linux、macOS 把参数字节原样做成 string，破坏 string 恒为合法 UTF-8 的不变量。调用方须以合法 UTF-8 传参；std/os 的 args() 与 main(args) 逐项相同（保留空参数）",
        applicability: "unavailable",
        before: "./prog $'\\xff'  # Linux、macOS 上 main 拿到含坏字节的 string，strSub 对它 trap 4010",
        after: "./prog $'\\xff'  # 入口拒绝：taixu aot: Linux argv acquisition failed: InvalidUnicode，退出码 64",
        implementedIn: "D3 v0.41",
        explain: "",
        d3: "docs/design/D3-s1-language-spec-v0.42.md#7-内建函数与程序入口",
