import { DerValue, derRead, derContents, derChildren } from "./crypto/der";
import { daysInMonth } from "./datetime";
import { X509Algorithm } from "./x509_types";

export function x509Full(data: Bytes, v: DerValue): Bytes { return bytesSlice(data, v.start, v.end - v.start); }

export function x509Oid(data: Bytes, v: DerValue): string | Error {
    if (v.tag != 6) { return err("x509: expected OBJECT IDENTIFIER"); }
    const raw = derContents(data, v)?;
    if (bytesLen(raw) == 0) { return err("x509: empty OID"); }
    const alpha = "0123456789abcdef"; let out = ""; let continuing = false; let i = 0;
    while (i < bytesLen(raw)) {
        const b = bytesGet(raw, i) catch panic("x509: OID bounds");
        if (!continuing && b == 128) { return err("x509: non-minimal OID arc"); }
        continuing = (b & 128) != 0;
        out = out + strSlice(alpha, b / 16, b / 16 + 1) + strSlice(alpha, b % 16, b % 16 + 1); i = i + 1;
    }
    if (continuing) { return err("x509: truncated OID arc"); }
    return out;
}

export function x509Algorithm(data: Bytes, value: DerValue): X509Algorithm | Error {
    if (value.tag != 48) { return err("x509: expected AlgorithmIdentifier"); }
    const children = derChildren(data, value, 2)?;
    if (listLen(children) < 1) { return err("x509: missing algorithm OID"); }
    let parameters = bytesNew(0);
    if (listLen(children) == 2) { parameters = x509Full(data, listGet(children, 1)); }
    return X509Algorithm { oidHex: x509Oid(data, listGet(children, 0))?, parameters: parameters, encoding: x509Full(data, value) };
}

function digits(data: Bytes, from: int, n: int): int | Error {
    let value = 0; let i = 0;
    while (i < n) {
        const b = bytesGet(data, from + i) catch 0;
        if (b < 48 || b > 57) { return err("x509: invalid time digit"); }
        value = value * 10 + b - 48; i = i + 1;
    }
    return value;
}

export function x509Time(data: Bytes, value: DerValue): int | Error {
    const raw = derContents(data, value)?; const n = bytesLen(raw); let width = 0;
    if (value.tag == 23 && n == 13) { width = 2; } else if (value.tag == 24 && n == 15) { width = 4; }
    else { return err("x509: time requires seconds and UTC Z"); }
    if ((bytesGet(raw, n - 1) catch 0) != 90) { return err("x509: non-UTC time"); }
    let year = digits(raw, 0, width)?;
    if (width == 2) { if (year < 50) { year = year + 2000; } else { year = year + 1900; } }
    const month = digits(raw, width, 2)?; const day = digits(raw, width + 2, 2)?;
    const hour = digits(raw, width + 4, 2)?; const minute = digits(raw, width + 6, 2)?; const second = digits(raw, width + 8, 2)?;
    if (year < 1 || month < 1 || month > 12 || day < 1 || day > daysInMonth(year, month) || hour > 23 || minute > 59 || second > 59) {
        return err("x509: invalid calendar time");
    }
    let y = year; if (month <= 2) { y = y - 1; }
    const era = y / 400; const yoe = y - era * 400; let mp = month - 3; if (month <= 2) { mp = month + 9; }
    const doy = (153 * mp + 2) / 5 + day - 1; const doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return (era * 146097 + doe - 719468) * 86400 + hour * 3600 + minute * 60 + second;
}

// 核对 RDN/AttributeTypeAndValue 的形状；名字匹配与字符串规范化由路径验证层处理。
export function x509Name(data: Bytes, value: DerValue): Bytes | Error {
    if (value.tag != 48) { return err("x509: expected Name sequence"); }
    for (rdn in derChildren(data, value, 128)?) {
        if (rdn.tag != 49) { return err("x509: expected RDN set"); }
        const attributes = derChildren(data, rdn, 32)?;
        if (listLen(attributes) == 0) { return err("x509: empty RDN"); }
        let previous = bytesNew(0);
        for (attribute in attributes) {
            if (attribute.tag != 48) { return err("x509: expected AttributeTypeAndValue"); }
            const pair = derChildren(data, attribute, 2)?;
            if (listLen(pair) != 2) { return err("x509: invalid attribute pair"); }
            x509Oid(data, listGet(pair, 0))?;
            const current = x509Full(data, attribute);
            if (bytesLen(previous) > 0 && byteOrder(previous, current) > 0) { return err("x509: unsorted DER RDN set"); }
            previous = current;
        }
    }
    return x509Full(data, value);
}

function byteOrder(a: Bytes, b: Bytes): int {
    let i = 0;
    while (i < bytesLen(a) && i < bytesLen(b)) {
        const av = bytesGet(a, i) catch 0; const bv = bytesGet(b, i) catch 0;
        if (av < bv) { return -1; } if (av > bv) { return 1; } i = i + 1;
    }
    if (bytesLen(a) < bytesLen(b)) { return -1; } if (bytesLen(a) > bytesLen(b)) { return 1; } return 0;
}
