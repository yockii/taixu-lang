// codegen-probe.tx —— codegen.tx 批 B2 探针：SEB1/FAB1 解析＋发射全管线锚。
// 用法：taixu run bootstrap/selfhost/codegen-probe.tx <file.seb1> <file.fab1> <golden.txc>
// 对拍两层：①progDumpText vs decodeToDump(golden) 文本恒等（首差异行诊断）；
// ②codegenTxc 字节 vs golden 逐字节（长度/首差异偏移）。任一 FAIL 即退出 1。
import { parseSeb1, sebParseOk, sideLenPub } from "./codegen";
import { progDumpText, codegenTxc } from "./codegen";
import { decodeToDump } from "./bytecode";

function main(args: []string): int {
    if (len(args) < 3) {
        eprint("用法: codegen-probe <file.seb1> <file.fab1> <golden.txc>");
        return 64;
    }
    const seb: string = readFile(args[0]) catch "";
    if (len(seb) == 0) {
        eprint("seb1 read fail");
        return 1;
    }
    const fab: string = readFile(args[1]) catch "";
    if (len(fab) == 0) {
        eprint("fab1 read fail");
        return 1;
    }
    const golden: string = readFile(args[2]) catch "";
    if (len(golden) == 0) {
        eprint("golden read fail");
        return 1;
    }
    const sv = parseSeb1(seb);
    if (sebParseOk() == 0) {
        eprint("seb1 parse fail");
        return 2;
    }
    print("mods=" + toStr(sv.moduleCount) + " tys=" + toStr(listLen(sv.tys)) + " structs=" + toStr(listLen(sv.structs)) + " enums=" + toStr(listLen(sv.enums)) + " sigs=" + toStr(listLen(sv.sigs)) + " fns=" + toStr(listLen(sv.fnTable)) + " expr_types=" + toStr(sideLenPub(sv.stExprTypes)) + " expr_res=" + toStr(sideLenPub(sv.stExprRes)) + " binding_slots=" + toStr(sideLenPub(sv.stBindingSlots)) + " entry_main=" + toStr(sv.mainFnIdx));
    // ① PROGDUMP 文本对拍。
    const mine = progDumpText(seb, fab);
    if (len(args) >= 4) {
        const wr = writeFile(args[3], mine);
    }
    if (len(mine) == 0) {
        eprint("progdump emit fail");
        return 3;
    }
    const want = decodeToDump(golden);
    if (len(want) == 0) {
        eprint("golden decode fail");
        return 4;
    }
    if (mine != want) {
        const n = len(mine);
        const w = len(want);
        let d = 0;
        let lim = n;
        if (w < n) { lim = w; }
        while (d < lim) {
            if (byteAt(mine, d) != byteAt(want, d)) {
                break;
            }
            d = d + 1;
        }
        eprint("DUMP DIFF at byte " + toStr(d) + " (mine " + toStr(n) + "B want " + toStr(w) + "B)");
        let s0 = d - 40;
        if (s0 < 0) { s0 = 0; }
        eprint("mine: " + strSub(mine, s0, d - s0 + 60));
        eprint("want: " + strSub(want, s0, d - s0 + 60));
        return 5;
    }
    print("DUMP OK " + toStr(len(mine)) + "B");
    // ② 字节对拍。
    const bytes = codegenTxc(seb, fab);
    if (listLen(bytes) == 0) {
        eprint("txc emit fail");
        return 6;
    }
    if (listLen(bytes) != len(golden)) {
        eprint("BYTE LEN DIFF mine=" + toStr(listLen(bytes)) + " golden=" + toStr(len(golden)));
        return 7;
    }
    if (len(args) >= 5) {
        const wb = writeFileBytes(args[4], bytes);
    }
    let i = 0;
    while (i < len(golden)) {
        if ((listGet(bytes, i) catch 0) != (byteAt(golden, i) catch 0)) {
            eprint("BYTE DIFF at " + toStr(i));
            return 8;
        }
        i = i + 1;
    }
    print("BYTES OK " + toStr(len(golden)) + "B — golden 对拍恒等");
    return 0;
}
