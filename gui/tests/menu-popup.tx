// menu-popup —— popup 弹出菜单守护：触发按钮点击→
// 浮层打开→条目点击选中→关闭打印选择。零新事件 kind：浮层消费走 pump
// 拦截（modal 先例），重放确定性可 golden。
//
// 确定性校验：TAIXU_REPLAY=tests/menu-popup.txt taixu run tests/menu-popup.tx
import { Canvas, Popup, popupNew, popupHit, drawPopupC, canvasNew, Button, button, drawButton, text, drawText } from "gui/components";
import { App, appNew, appClose, pump, onClick, hitZone, popupOpen, popupActive, popupResult, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpen, surfaceClose, surfaceClear, windowPresent } from "gui/surface";

const BTN_MENU: int = 7;

struct Model {
    surface: int,
    btn: Ref<Button>,
    opened: int, // 浮层打开计数
}

function render(surface: int, w: int, h: int, app: Ref<App>, m: Ref<Model>, p: Ref<Popup>): void {
    surfaceClear(surface, 0x202040);
    const cv: Ref<Canvas> = canvasNew(surface, w, h);
    const title = text(0, 8, 4, "popup menu demo");
    drawText(surface, title);
    drawButton(surface, m.btn);
    if (popupActive(app)) {
        drawPopupC(cv, p);
    }
}

export function main(args: []string): int {
    args;
    const items: List<string> = listNew();
    listPush(items, "open");
    listPush(items, "save");
    listPush(items, "quit");
    const p: Ref<Popup> = popupNew(1, 24, 24, items);
    const m: Ref<Model> = new Model {
        surface: 0,
        btn: button(BTN_MENU, 16, 16, 72, 20, "menu"),
        opened: 0,
    };
    const spec = defaultSpec("taixu popup menu", 200, 140);
    const app = appNew(spec);
    m.surface = surfaceOpen(spec.w, spec.h) catch 0;
    onClick(app, BTN_MENU, (rec: EventRecord): void => {
            popupOpen(app, p);
            m.opened = m.opened + 1;
        });
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            render(m.surface, app.w, app.h, app, m, p);
            hitZone(app, BTN_MENU, m.btn.x, m.btn.y, m.btn.w, m.btn.h);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("opened=" + toStr(m.opened) + " popup_result=" + toStr(popupResult(app)) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
