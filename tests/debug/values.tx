// 调试基准（第 6 轮 6c-0）：各种值的 inspect（含截断：串 64 字节、宽 32、深 8）。
struct Point {
    x: int,
    y: int,
}

enum Shape {
    Circle(r: float),
    Rect(w: int, h: int),
    Empty,
}

enum Chain {
    Link(v: int, next: Ref< Chain>),
    End,
}

function nest(d: int): List< int> {
    const xs: List< int> = listNew();
    listPush(xs, d);
    return xs;
}

export function main(args: []string): int {
    const n: int = -42;
    const f: float = 2.5;
    const ok: bool = true;
    const s: string = "太虚：一个很长的字符串，用来检验六十四字节的截断是否按字节计数而不是按字符计数，再多写一些";
    const none: int? = None;
    const some: int? = 9;
    const p: Point = Point { x: 3, y: 4 };
    const c: Ref< Shape> = new Shape.Rect(5, 6);
    const e: Ref< Shape> = new Shape.Empty();
    const wide: List< int> = listNew();
    let i = 0;
    while (i < 40) {
        listPush(wide, i);
        i = i + 1;
    }
    const e2 = err("boom");
    let deep: Ref< Chain> = new Chain.End();
    let k = 0;
    while (k < 12) {
        deep = new Chain.Link(k, deep);
        k = k + 1;
    }
    const fn = (x: int): int => x + n;
    print("ready " + toStr(listLen(wide)) + " " + toStr(fn(1)));
    return 0;
}
