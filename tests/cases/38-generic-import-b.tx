// 38-generic-import 的桩模块：另一个模块显式导入同一模板，接收别的模块构造的 Box< Q>。
import { Box, Pair, Q, unbox } from "./38-generic-import-g";

export function fb(): string {
    const b = Box<string> { v: "hi" };
    const p = Pair<Q, int> { first: Q { n: 3 }, second: 4 };
    return unbox(b) + "," + toStr(p.first.n + p.second);
}

export function getN(b: Box<Q>): int { return unbox(b).n; }
