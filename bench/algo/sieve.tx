// bench/algo/sieve —— Eratosthenes 筛（<500,000 素数计数）。
// 校验和＝素数个数（确定性；与数论已知值可核对）。
export function main(args: []string): int {
    const n: int = 500000;
    const isComposite: List<bool> = listNew();
    let i: int = 0;
    while (i < n) {
        listPush(isComposite, false);
        i = i + 1;
    }
    let p: int = 2;
    while (p * p < n) {
        if (!(listGet(isComposite, p) catch true)) {
            let m: int = p * p;
            while (m < n) {
                listSet(isComposite, m, true);
                m = m + p;
            }
        }
        p = p + 1;
    }
    let count: int = 0;
    i = 2;
    while (i < n) {
        if (!(listGet(isComposite, i) catch true)) {
            count = count + 1;
        }
        i = i + 1;
    }
    print(toStr(count));
    return 0;
}
