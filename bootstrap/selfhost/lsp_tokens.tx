// lsp_tokens.tx —— 原生 LSP 的 semanticTokens/full（第 6 轮 6d-3a3，LSP 与 MCP 实施设计 §四-4）。
//
// 记号取自入口的分析节（lsp_diag 的 Root.occs，含类型位补面与没有身份的错误值字段）：按位置排序，同一位置只出一个、
// 与前一个重叠的丢弃（同 Zig 版）；起点与长度按协商的编码计；修饰位恒 0（legend 的修饰位为空，同 Zig 版）。
import { Root, lspEmptyRoot, diagRoots } from "./lsp_diag";
import { AnaOcc } from "./ana_index";
import { LspDoc, docKey, colUnits, joinComma } from "./lsp_docs";

// semanticTokensProvider 的 legend：与 Zig 版逐字相同（taixu-vscode 不贡献自定义类型，languageclient 按此解码）；
// 下标即分析节的着色类。
export const SEM_LEGEND: string = "{\"tokenTypes\":[\"function\",\"struct\",\"enum\",\"enumMember\",\"variable\",\"parameter\",\"property\"],\"tokenModifiers\":[]}";

function startsOf(text: string): List<int> {
    const s: List<int> = listNew();
    listPush(s, 0);
    let i = 0;
    const n = len(text);
    while (i < n) {
        if ((byteAt(text, i) catch 0) == 10) { listPush(s, i + 1); }
        i = i + 1;
    }
    return s;
}

function emptyRoot(): Ref<Root> {
    return lspEmptyRoot();
}

// 含该文档的第一个入口里，该文档的模块序；没有为 -1（root 写进 out）。
function rootOf(key: string, out: List<Ref<Root>>): int {
    for (r in diagRoots()) {
        let i = 0;
        while (i < listLen(r.paths)) {
            const p = listGet(r.paths, i) catch "<prelude>";
            if (p != "<prelude>" && docKey(p) == key) {
                listPush(out, r);
                return i;
            }
            i = i + 1;
        }
    }
    return -1;
}

// SemanticTokens 结果的 JSON（{"data":[…]}）；文档不属于任何入口时 data 为空。
export function semTokens(d: Ref<LspDoc>, enc: int): string {
    const rs: List<Ref<Root>> = listNew();
    const m = rootOf(d.key, rs);
    if (m < 0) { return "{\"data\":[]}"; }
    const root = listGet(rs, 0) catch emptyRoot();
    const text = listGet(root.texts, m) catch "";
    const starts = startsOf(text);
    const out: List<string> = listNew();
    let pl = 0;
    let pc = 0;
    let pend = -1;
    let first = true;
    for (o in root.occs) {
        if (o.mod != m) { continue; }
        const line = o.line - 1;
        const ls = listGet(starts, line) catch len(text);
        const sc = colUnits(text, ls, o.col - 1, enc);
        const n = colUnits(text, ls, o.col - 1 + o.len, enc) - sc;
        // 同一位置的几个身份（泛型体里随实例不同的字段）只出一个；与前一个重叠的丢弃。
        if (!first && line == pl && sc < pend) { continue; }
        let dl = line;
        let dc = sc;
        if (!first) {
            dl = line - pl;
            if (line == pl) { dc = sc - pc; }
        }
        listPush(out, toStr(dl) + "," + toStr(dc) + "," + toStr(n) + "," + toStr(o.tt) + ",0");
        pl = line;
        pc = sc;
        pend = sc + n;
        first = false;
    }
    return "{\"data\":[" + joinComma(out) + "]}";
}
