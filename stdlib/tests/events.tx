// ============================================================================
// stdlib 用例：std/events（V0.9-L2；D25 §六；GUI-11）
// 运行：taixu test tests/events.tx（依赖 TAIXU_STDLIB 或同级发现）
// 红线：注册序＝派发序（确定性）；注销后跳过；token 幂等。
// ============================================================================

import { EventRecord, ListenerTable, listenersNew, on, off, dispatch, listenersCount } from "std/events";

struct Box {
    v: int,
}

struct Probe {
    log: int,
}

function rec(target: int): EventRecord {
    return EventRecord { kind: 3, target: target, x: target * 10, y: target * 20, mods: 0 };
}

test "events：注册/派发按注册序，返回派发数" {
    const t = listenersNew();
    assert(listenersCount(t) == 0, "新表为空");
    const p = new Probe { log: 0 };
    const a = on(t, 2, (r: EventRecord): void => { p.log = p.log * 10 + 1; });
    const b = on(t, 2, (r: EventRecord): void => { p.log = p.log * 10 + 2; });
    const n = dispatch(t, rec(2));
    assert(n == 2, "target 2 应派发两条");
    assert(p.log == 12, "派发序＝注册序");
    assert(a == 1 && b == 2, "token 自 1 起顺序分配");
}

test "events：off 注销后跳过（幂等）＋target 过滤" {
    const t = listenersNew();
    const p = new Probe { log: 0 };
    const dead = on(t, 9, (r: EventRecord): void => { p.log = p.log + 100; });
    on(t, 3, (r: EventRecord): void => { p.log = p.log + 1; });
    assert(off(t, dead), "注销应成功");
    assert(!off(t, dead), "重复注销应 false（幂等）");
    const n1 = dispatch(t, rec(9));
    assert(n1 == 0, "已注销 target 不派发");
    const n2 = dispatch(t, rec(3));
    assert(n2 == 1 && p.log == 1, "存活 target 派发一次");
    assert(listenersCount(t) == 1, "存活计数 1");
}

test "events：捕获 Ref 共享可变（闭包体内只读定档的正面用法）" {
    const t = listenersNew();
    const box = new Box { v: 0 };
    on(t, 1, (r: EventRecord): void => { box.v = box.v + r.x; });
    dispatch(t, rec(1));
    dispatch(t, rec(1));
    dispatch(t, rec(2));
    assert(box.v == 20, "target1 两次：10+10（rec2 target 不符被过滤；闭包外可见共享可变）");
}
