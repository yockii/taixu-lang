// real_path_linux.tx 用的系统调用（riscv64 的号，Linux v7.3 号表；只许写在 _linux_riscv64 文件里）。
// 编译器与构建脚本要能由种子（0.3.0-beta.1，只认数字形态的 from syscall）编译，按架构的号分放在 _linux、_linux_aarch64、
// _linux_loongarch64 与 _linux_riscv64 四个文件（B16 B17 导出面相同；号与打开标志同龙芯那份）；
// 种子换代后改成 from syscall "名字" 合成一份。
declare function sysRpReadlinkat(dir: int, path: string, buf: Bytes, size: int): int from syscall 78;

export function rpReadlinkat(dir: int, path: string, buf: Bytes, size: int): int { return sysRpReadlinkat(dir, path, buf, size); }
