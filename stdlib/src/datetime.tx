// ============================================================================
// std/datetime —— 日期时间格式化（V0.23-S1 扩批；STD-04）。
//
// **纯函数段**（与 std/time 的确定性纪律一致）：输入＝Unix epoch 毫秒
// （UTC），输出＝公历（儒略扩张历）字符串/分量——同入参恒同出参，
// test 块可断言；不触 nowMs（观测面留 std/time）。负毫秒按 0 钳制
//（1970-01-01 起；更早时点属历史历法面，本模块不覆盖）。
// 算法＝civil-from-days（Hinnant 2017，公有领域形）——天→y/m/d 无循环。
// ============================================================================

// isLeap：公历闰年（4 年一闰、百年不闰、四百年再闰）。
export function isLeap(y: int): bool {
    if (y % 4 != 0) {
        return false;
    }
    if (y % 100 != 0) {
        return true;
    }
    return y % 400 == 0;
}

// daysInMonth：月天数（y 仅 2 月依赖）。
export function daysInMonth(y: int, m: int): int {
    if (m == 2) {
        if (isLeap(y)) {
            return 29;
        }
        return 28;
    }
    if (m == 4 || m == 6 || m == 9 || m == 11) {
        return 30;
    }
    return 31;
}

struct Civil {
    y: int,
    m: int,
    d: int,
}

// 天（自 epoch）→ 公历 y/m/d（civil-from-days；z >= -719468 域内精确）。
function civilFromDays(z0: int): Ref<Civil> {
    let z: int = z0 + 719468;
    const era: int = z / 146097;
    const doe: int = z - era * 146097;
    const yoe: int = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y: int = yoe + era * 400;
    const doy: int = doe - (365 * yoe + yoe / 4 - yoe / 100);
    const mp: int = (5 * doy + 2) / 153;
    const d: int = doy - (153 * mp + 2) / 5 + 1;
    const m: int = mp + 3;
    if (mp >= 10) {
        y = y + 1;
        return new Civil { y: y, m: m - 12, d: d };
    }
    return new Civil { y: y, m: m, d: d };
}

// epochMs → (天, 当日毫秒)。
function dayOfMs(ms0: int): Ref<Civil> {
    let ms: int = ms0;
    if (ms < 0) {
        ms = 0;
    }
    return new Civil { y: ms / 86400000, m: 0, d: ms % 86400000 };
}

// 两位补零（内部面）。
function pad2(v: int): string {
    if (v < 10) {
        return "0" + toStr(v);
    }
    return toStr(v);
}

// dateOf：epochMs → "YYYY-MM-DD"（UTC；负毫秒钳 0）。
export function dateOf(ms: int): string {
    const t = dayOfMs(ms);
    const c = civilFromDays(t.y);
    let ys: string = toStr(c.y);
    while (len(ys) < 4) {
        ys = "0" + ys;
    }
    return ys + "-" + pad2(c.m) + "-" + pad2(c.d);
}

// timeOf：epochMs → "HH:MM:SS"（当日 UTC 段）。
export function timeOf(ms: int): string {
    const t = dayOfMs(ms);
    const h: int = t.d / 3600000;
    const mi: int = (t.d % 3600000) / 60000;
    const se: int = (t.d % 60000) / 1000;
    return pad2(h) + ":" + pad2(mi) + ":" + pad2(se);
}

// formatEpochMs：epochMs → "YYYY-MM-DD HH:MM:SS"（UTC；dateOf＋timeOf 拼装）。
export function formatEpochMs(ms: int): string {
    return dateOf(ms) + " " + timeOf(ms);
}

// dayOfWeek：epochMs → 0=周四 .. 6=周三（epoch 日 0＝1970-01-01 周四——
// 命名按"epoch 位移"口径，避免星期名常量面）。
export function dayOfWeekEpoch(ms: int): int {
    const t = dayOfMs(ms);
    let w: int = (t.y % 7) + 7;
    return w % 7;
}
