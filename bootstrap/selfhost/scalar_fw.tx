// 定宽数值运算（O4 第二步，docs/design/v052-fixed-width-step2-v0.1-20261016.md §八）：运行期例程
// __tx_native_scalar_fw_v1。入口：ecx＝字节码操作码（编码见 fw_ops.tx），rdx/r8＝两个操作数值槽，
// r9＝出口值；返回 eax＝状态（0 成功、1 操作数类型异常、2 溢出、3 除数为零、4 移位计数越界、5 不支持）。
// 窄整数先在 64 位内算（窄值的和、差、积、商不会越出 64 位；u32 的积越出 2^63 时按位环绕，
// 检查照样能判出越界），再检查是否落在类型范围内；u64/usize 看进位或高半，isize 看溢出标志；
// f32 以 f64 计算后舍入回 f32（加减乘除的结果与原生 f32 相同）。
import { StructuredBuffer, asStructuredMissing } from "./assemble";
import { nr, nd, nb, nx, ni, nm, nmb, nt, nmov, nl, nj, nret, no } from "./native_emit";

export function fwOpsEmit(b: Ref<StructuredBuffer>): void {
    const p = "__tx_fw";
    nl(b, "__tx_native_scalar_fw_v1");
    nt(b, "movzx", nd(10), nmb(2, 0)); nt(b, "movzx", nd(11), nmb(8, 0));
    nt(b, "sub", nd(1), ni(256)); nmov(b, nd(0), nd(1)); nt(b, "shr", nd(0), ni(4)); nt(b, "and", nd(1), ni(15));
    nt(b, "cmp", nd(0), ni(10)); nj(b, "je", p + "_f32");
    nt(b, "cmp", nd(10), ni(1)); nj(b, "jne", p + "_type");
    nt(b, "cmp", nd(11), ni(1)); nj(b, "jne", p + "_type");
    nmov(b, nr(10), nm(2, 8)); nmov(b, nr(11), nm(8, 8)); nmov(b, nd(8), nd(0)); // r8d＝种类
    nt(b, "cmp", nd(1), ni(0)); nj(b, "je", p + "_add");
    nt(b, "cmp", nd(1), ni(1)); nj(b, "je", p + "_sub");
    nt(b, "cmp", nd(1), ni(2)); nj(b, "je", p + "_mul");
    nt(b, "cmp", nd(1), ni(3)); nj(b, "je", p + "_div");
    nt(b, "cmp", nd(1), ni(4)); nj(b, "je", p + "_mod");
    nt(b, "cmp", nd(1), ni(5)); nj(b, "je", p + "_neg");
    nt(b, "cmp", nd(1), ni(6)); nj(b, "je", p + "_bnot");
    nt(b, "cmp", nd(1), ni(10)); nj(b, "je", p + "_wadd");
    nt(b, "cmp", nd(1), ni(11)); nj(b, "je", p + "_wsub");
    nt(b, "cmp", nd(1), ni(12)); nj(b, "je", p + "_wmul");
    nt(b, "cmp", nd(1), ni(9)); nj(b, "ja", p + "_unsupported");
    // 移位（7 <<、8 >>、9 >>>）：计数按无符号与“宽度−1”比较，负数与过大一并越界。
    nmov(b, nd(2), nd(1)); nmov(b, nd(0), ni(63));
    cntLimit(b, p, 1, 7); cntLimit(b, p, 4, 7); cntLimit(b, p, 2, 15); cntLimit(b, p, 5, 15); cntLimit(b, p, 3, 31); cntLimit(b, p, 6, 31);
    nl(b, p + "_cnt"); nt(b, "cmp", nr(11), nr(0)); nj(b, "ja", p + "_shift");
    nmov(b, nd(1), nd(11));
    nt(b, "cmp", nd(2), ni(7)); nj(b, "je", p + "_shl");
    nt(b, "cmp", nd(2), ni(8)); nj(b, "je", p + "_shr");
    // >>>：有符号窄整数先按宽度零扩展、逻辑右移，再按原类型解释；其余直接逻辑右移。
    nt(b, "cmp", nd(8), ni(1)); nj(b, "je", p + "_ushr8");
    nt(b, "cmp", nd(8), ni(2)); nj(b, "je", p + "_ushr16");
    nt(b, "cmp", nd(8), ni(3)); nj(b, "je", p + "_ushr32");
    nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    nl(b, p + "_ushr8"); nt(b, "and", nr(10), ni(255)); nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_ushr16"); nt(b, "and", nr(10), ni(65535)); nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_ushr32"); nmov(b, nd(10), nd(10)); nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_shl"); nt(b, "shl", nr(10), nb(1)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_shr");
    nt(b, "cmp", nd(8), ni(1)); nj(b, "je", p + "_sar"); nt(b, "cmp", nd(8), ni(2)); nj(b, "je", p + "_sar");
    nt(b, "cmp", nd(8), ni(3)); nj(b, "je", p + "_sar"); nt(b, "cmp", nd(8), ni(8)); nj(b, "je", p + "_sar");
    nt(b, "shr", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    nl(b, p + "_sar"); nt(b, "sar", nr(10), nb(1)); nj(b, "jmp", p + "_int");
    // 加减乘：u64/usize 看进位（乘看高半），isize 看溢出标志，窄整数交范围检查。
    nl(b, p + "_add"); wide(b, p, "_addu", "_adds"); nt(b, "add", nr(10), nr(11)); nj(b, "jmp", p + "_chk");
    nl(b, p + "_addu"); nt(b, "add", nr(10), nr(11)); nj(b, "jb", p + "_ovf"); nj(b, "jmp", p + "_int");
    nl(b, p + "_adds"); nt(b, "add", nr(10), nr(11)); nj(b, "jo", p + "_ovf"); nj(b, "jmp", p + "_int");
    nl(b, p + "_sub"); wide(b, p, "_subu", "_subs"); nt(b, "sub", nr(10), nr(11)); nj(b, "jmp", p + "_chk");
    nl(b, p + "_subu"); nt(b, "sub", nr(10), nr(11)); nj(b, "jb", p + "_ovf"); nj(b, "jmp", p + "_int");
    nl(b, p + "_subs"); nt(b, "sub", nr(10), nr(11)); nj(b, "jo", p + "_ovf"); nj(b, "jmp", p + "_int");
    nl(b, p + "_mul"); wide(b, p, "_mulu", "_muls"); nt(b, "imul", nr(10), nr(11)); nj(b, "jmp", p + "_chk");
    nl(b, p + "_mulu"); nmov(b, nr(0), nr(10)); no(b, "mul", 1, nr(11), asStructuredMissing()); nj(b, "jo", p + "_ovf"); nmov(b, nr(10), nr(0)); nj(b, "jmp", p + "_int");
    nl(b, p + "_muls"); nt(b, "imul", nr(10), nr(11)); nj(b, "jo", p + "_ovf"); nj(b, "jmp", p + "_int");
    // 除与取余：除零状态 3；isize 的最小值 / −1 溢出、% −1 得 0（同 int）；u64/usize 用无符号除法。
    nl(b, p + "_div"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_zero");
    unsignedTo(b, p, "_divu"); minNegOne(b, p, "_div_do"); nj(b, "jmp", p + "_ovf");
    nl(b, p + "_div_do"); nmov(b, nr(0), nr(10)); no(b, "cqo", 0, asStructuredMissing(), asStructuredMissing()); no(b, "idiv", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(0)); nj(b, "jmp", p + "_chk");
    nl(b, p + "_divu"); nmov(b, nr(0), nr(10)); nt(b, "xor", nd(2), nd(2)); no(b, "div", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(0)); nj(b, "jmp", p + "_int");
    nl(b, p + "_mod"); nt(b, "test", nr(11), nr(11)); nj(b, "jz", p + "_zero");
    unsignedTo(b, p, "_modu"); minNegOne(b, p, "_mod_do"); nmov(b, nr(10), ni(0)); nj(b, "jmp", p + "_int");
    nl(b, p + "_mod_do"); nmov(b, nr(0), nr(10)); no(b, "cqo", 0, asStructuredMissing(), asStructuredMissing()); no(b, "idiv", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(2)); nj(b, "jmp", p + "_int");
    nl(b, p + "_modu"); nmov(b, nr(0), nr(10)); nt(b, "xor", nd(2), nd(2)); no(b, "div", 1, nr(11), asStructuredMissing()); nmov(b, nr(10), nr(2)); nj(b, "jmp", p + "_int");
    // 取负（只有有符号种类）：isize 看溢出标志，窄整数交范围检查。
    nl(b, p + "_neg"); no(b, "neg", 1, nr(10), asStructuredMissing()); nj(b, "jo", p + "_ovf"); nj(b, "jmp", p + "_chk");
    nl(b, p + "_bnot"); no(b, "not", 1, nr(10), asStructuredMissing()); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_wadd"); nt(b, "add", nr(10), nr(11)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_wsub"); nt(b, "sub", nr(10), nr(11)); nj(b, "jmp", p + "_wrap");
    nl(b, p + "_wmul"); nt(b, "imul", nr(10), nr(11)); nj(b, "jmp", p + "_wrap");
    // 范围检查：有符号按宽度符号扩展后须不变，无符号宽度以上的位须为零。
    nl(b, p + "_chk");
    nt(b, "cmp", nd(8), ni(1)); nj(b, "je", p + "_k8"); nt(b, "cmp", nd(8), ni(2)); nj(b, "je", p + "_k16"); nt(b, "cmp", nd(8), ni(3)); nj(b, "je", p + "_k32");
    nt(b, "cmp", nd(8), ni(4)); nj(b, "je", p + "_ku8"); nt(b, "cmp", nd(8), ni(5)); nj(b, "je", p + "_ku16"); nt(b, "cmp", nd(8), ni(6)); nj(b, "je", p + "_ku32");
    nj(b, "jmp", p + "_int");
    signedCheck(b, p, "_k8", 56); signedCheck(b, p, "_k16", 48); signedCheck(b, p, "_k32", 32);
    unsignedCheck(b, p, "_ku8", 8); unsignedCheck(b, p, "_ku16", 16); unsignedCheck(b, p, "_ku32", 32);
    // 截到宽度（环绕运算、<<、~、>>> 的结果）：有符号符号扩展，无符号零扩展，64 位不变。
    nl(b, p + "_wrap");
    nt(b, "cmp", nd(8), ni(1)); nj(b, "je", p + "_w8"); nt(b, "cmp", nd(8), ni(2)); nj(b, "je", p + "_w16"); nt(b, "cmp", nd(8), ni(3)); nj(b, "je", p + "_w32");
    nt(b, "cmp", nd(8), ni(4)); nj(b, "je", p + "_wu8"); nt(b, "cmp", nd(8), ni(5)); nj(b, "je", p + "_wu16"); nt(b, "cmp", nd(8), ni(6)); nj(b, "je", p + "_wu32");
    nj(b, "jmp", p + "_int");
    nl(b, p + "_w8"); nt(b, "shl", nr(10), ni(56)); nt(b, "sar", nr(10), ni(56)); nj(b, "jmp", p + "_int");
    nl(b, p + "_w16"); nt(b, "shl", nr(10), ni(48)); nt(b, "sar", nr(10), ni(48)); nj(b, "jmp", p + "_int");
    nl(b, p + "_w32"); nt(b, "shl", nr(10), ni(32)); nt(b, "sar", nr(10), ni(32)); nj(b, "jmp", p + "_int");
    nl(b, p + "_wu8"); nt(b, "and", nr(10), ni(255)); nj(b, "jmp", p + "_int");
    nl(b, p + "_wu16"); nt(b, "and", nr(10), ni(65535)); nj(b, "jmp", p + "_int");
    nl(b, p + "_wu32"); nmov(b, nd(10), nd(10)); nj(b, "jmp", p + "_int");
    // f32：两侧须为 float，以 f64 运算后舍入回 f32（溢出得 ±inf，同浮点不 trap）。
    nl(b, p + "_f32");
    nt(b, "cmp", nd(10), ni(2)); nj(b, "jne", p + "_type"); nt(b, "cmp", nd(11), ni(2)); nj(b, "jne", p + "_type");
    nt(b, "movsd", nx(0), nm(2, 8)); nt(b, "movsd", nx(1), nm(8, 8));
    nt(b, "cmp", nd(1), ni(0)); nj(b, "je", p + "_fadd");
    nt(b, "cmp", nd(1), ni(1)); nj(b, "je", p + "_fsub");
    nt(b, "cmp", nd(1), ni(2)); nj(b, "je", p + "_fmul");
    nt(b, "cmp", nd(1), ni(3)); nj(b, "je", p + "_fdiv");
    nj(b, "jmp", p + "_unsupported");
    nl(b, p + "_fadd"); nt(b, "addsd", nx(0), nx(1)); nj(b, "jmp", p + "_fround");
    nl(b, p + "_fsub"); nt(b, "subsd", nx(0), nx(1)); nj(b, "jmp", p + "_fround");
    nl(b, p + "_fmul"); nt(b, "mulsd", nx(0), nx(1)); nj(b, "jmp", p + "_fround");
    nl(b, p + "_fdiv"); nt(b, "divsd", nx(0), nx(1));
    nl(b, p + "_fround"); nt(b, "cvtsd2ss", nx(0), nx(0)); nt(b, "cvtss2sd", nx(0), nx(0)); nt(b, "movq", nr(10), nx(0)); nmov(b, nr(0), ni(2)); nj(b, "jmp", p + "_write");
    nl(b, p + "_int"); nmov(b, nr(0), ni(1));
    nl(b, p + "_write"); nmov(b, nm(9, 0), nr(0)); nmov(b, nm(9, 8), nr(10)); nmov(b, nr(0), ni(0)); nret(b);
    nl(b, p + "_type"); nmov(b, nr(0), ni(1)); nret(b);
    nl(b, p + "_ovf"); nmov(b, nr(0), ni(2)); nret(b);
    nl(b, p + "_zero"); nmov(b, nr(0), ni(3)); nret(b);
    nl(b, p + "_shift"); nmov(b, nr(0), ni(4)); nret(b);
    nl(b, p + "_unsupported"); nmov(b, nr(0), ni(5)); nret(b);
}

// 种类 kind 的移位计数上限为 lim（eax），其余种类保持 63。
function cntLimit(b: Ref<StructuredBuffer>, p: string, kind: int, lim: int): void {
    const skip = p + "_cl" + toStr(kind);
    nt(b, "cmp", nd(8), ni(kind)); nj(b, "jne", skip); nmov(b, nd(0), ni(lim)); nj(b, "jmp", p + "_cnt");
    nl(b, skip);
}

// u64/usize 跳 uLabel，isize 跳 sLabel，窄整数落下。
function wide(b: Ref<StructuredBuffer>, p: string, uLabel: string, sLabel: string): void {
    nt(b, "cmp", nd(8), ni(7)); nj(b, "je", p + uLabel); nt(b, "cmp", nd(8), ni(9)); nj(b, "je", p + uLabel);
    nt(b, "cmp", nd(8), ni(8)); nj(b, "je", p + sLabel);
}

function unsignedTo(b: Ref<StructuredBuffer>, p: string, label: string): void {
    nt(b, "cmp", nd(8), ni(7)); nj(b, "je", p + label); nt(b, "cmp", nd(8), ni(9)); nj(b, "je", p + label);
}

// 只有 isize 可能出现 64 位最小值 / −1：不是这种情形跳 doLabel，是则落下（调用方决定溢出或得 0）。
function minNegOne(b: Ref<StructuredBuffer>, p: string, doLabel: string): void {
    nt(b, "cmp", nd(8), ni(8)); nj(b, "jne", p + doLabel);
    nt(b, "movabs", nr(0), ni(-9223372036854775807 - 1)); nt(b, "cmp", nr(10), nr(0)); nj(b, "jne", p + doLabel);
    nt(b, "cmp", nr(11), ni(-1)); nj(b, "jne", p + doLabel);
}

function signedCheck(b: Ref<StructuredBuffer>, p: string, label: string, sh: int): void {
    nl(b, p + label); nmov(b, nr(0), nr(10)); nt(b, "shl", nr(0), ni(sh)); nt(b, "sar", nr(0), ni(sh));
    nt(b, "cmp", nr(0), nr(10)); nj(b, "jne", p + "_ovf"); nj(b, "jmp", p + "_int");
}

function unsignedCheck(b: Ref<StructuredBuffer>, p: string, label: string, bits: int): void {
    nl(b, p + label); nmov(b, nr(0), nr(10)); nt(b, "shr", nr(0), ni(bits)); nj(b, "jne", p + "_ovf"); nj(b, "jmp", p + "_int");
}
