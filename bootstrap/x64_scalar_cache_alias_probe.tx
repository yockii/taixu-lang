// Executable cache checks independent of the source frontend and run planner.
import { X64ScalarCache, x64ScalarCacheNew, x64ScalarCacheEntry, x64ScalarCacheInstruction } from "./selfhost/x64_scalar_cache";
import { Operand, asStructuredBegin, asStructuredSection, asStructuredLabel, asStructuredInstruction, asStructuredReg,
    asStructuredMem, asStructuredImm, asStructuredMissing, asStructuredTarget, asStructuredZero, asResolveLocalFixups, asFailedAs, asLastErrAs, asLastLineAs,
    asProducerBeginFunction, asProducerFunctionBegin, asProducerFunctionPrologueEnd, asProducerFunctionEpilogueStart,
    asProducerFunctionEnd, asProducerFrame, asProducerInstruction, asProducerLabel, asProducerSubmitBody } from "./selfhost/assemble";
import { linkElfImage, elfBytesOut, elfLastError } from "./selfhost/link_elf";
let instructionLines: List<string> = listNew();

function reg(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function mem(slot: int): Ref<Operand> { return asStructuredMem(2, 3, -1, 0, slot * 16 + 8, 0, ""); }
function ins(cache: Ref<X64ScalarCache>, name: string, a: Ref<Operand>, b: Ref<Operand>): void {
    let mnemonic = name;
    if (name == "mov" && a.kind == 0 && a.cls == 0 && b.kind == 1 && (b.imm < -2147483648 || b.imm > 2147483647)) { mnemonic = "movabs"; }
    const line = listLen(instructionLines) + 100;
    listPush(instructionLines, mnemonic + " " + toStr(a.kind) + "/" + toStr(a.num) + " " + toStr(b.kind) + "/" + toStr(b.num) + "/" + toStr(b.imm));
    x64ScalarCacheInstruction(cache, 1, mnemonic, 2, a, b, asStructuredMissing(), line);
}
function jump(cache: Ref<X64ScalarCache>, name: string, target: Ref<Operand>): void {
    x64ScalarCacheInstruction(cache, 1, name, 1, target, asStructuredMissing(), asStructuredMissing(), 1);
}
function check(cache: Ref<X64ScalarCache>, r: int, value: int): void {
    ins(cache, "mov", reg(1), asStructuredImm(value)); ins(cache, "cmp", reg(r), reg(1)); jump(cache, "jne", asStructuredTarget("fail"));
}
function start(id: int): Ref<X64ScalarCache> {
    const cache = x64ScalarCacheNew(); cache.first = 2; cache.second = 3;
    asProducerBeginFunction(); asProducerFunctionBegin(id, 1); asProducerFrame("push-nonvolatile", 5, 8, 1);
    asProducerFrame("set-frame-pointer", 5, 0, 1);
    for (r in [3, 14, 15, 12, 13]) { asProducerFrame("push-nonvolatile", r, 8, 1); }
    asProducerFrame("allocate-stack", 4, 56, 1); asProducerFunctionPrologueEnd();
    asProducerInstruction(0, "mov", 2, reg(3), reg(1), asStructuredMissing(), 1); x64ScalarCacheEntry(cache, 1); return cache;
}
function finish(): void {
    asProducerSubmitBody();
    if (asFailedAs() != 0) { eprint("instruction " + toStr(asLastLineAs()) + ": " + (listGet(instructionLines, asLastLineAs() - 100) catch "frame/label")); panic(asLastErrAs()); }
    asProducerFunctionEpilogueStart(); asProducerFrame("release-stack", 4, 56, 1);
    for (r in [13, 12, 15, 14, 3, 5]) { asProducerFrame("pop-nonvolatile", r, 8, 1); }
    asProducerFrame("return", -1, 8, 1); asProducerFunctionEnd();
}
function emit(bad: bool, path: string): void {
    instructionLines = listNew();
    asStructuredBegin(); const missing = asStructuredMissing(); asStructuredLabel("__tx_entry");
    asStructuredInstruction("sub", 2, reg(4), asStructuredImm(32), missing, 1);
    asStructuredInstruction("lea", 2, reg(1), asStructuredMem(2, -1, -1, 0, 0, 1, "window"), missing, 1);
    asStructuredInstruction("call", 1, asStructuredTarget("f_0"), missing, missing, 1);
    asStructuredInstruction("mov", 2, reg(7), reg(0), missing, 1); asStructuredInstruction("mov", 2, reg(0), asStructuredImm(60), missing, 1);
    asStructuredInstruction("syscall", 0, missing, missing, missing, 1);
    const cache = start(0);
    ins(cache, "mov", reg(0), asStructuredImm(0x1122334455667788)); ins(cache, "mov", mem(2), reg(0));
    ins(cache, "mov", reg(0), asStructuredImm(0xA5));
    ins(cache, "mov", asStructuredMem(0, 3, -1, 0, 41, 0, ""), asStructuredReg(2, 0));
    ins(cache, "mov", reg(0), mem(2)); check(cache, 0, 0x112233445566A588);
    ins(cache, "lea", reg(10), mem(2));
    const alias = asStructuredMem(2, 10, -1, 0, 0, 0, "");
    if (bad) { asProducerInstruction(1, "mov", 2, alias, asStructuredImm(33), missing, 1); }
    else { ins(cache, "mov", alias, asStructuredImm(33)); }
    ins(cache, "mov", reg(0), mem(2)); check(cache, 0, 33);
    ins(cache, "mov", reg(0), asStructuredImm(10)); ins(cache, "add", reg(0), mem(2)); check(cache, 0, 43);
    ins(cache, "mov", reg(0), asStructuredImm(0x3FF0000000000001)); ins(cache, "movq", asStructuredReg(3, 0), reg(0));
    ins(cache, "movsd", mem(2), asStructuredReg(3, 0)); ins(cache, "movsd", asStructuredReg(3, 1), mem(2));
    ins(cache, "movq", reg(0), asStructuredReg(3, 1)); check(cache, 0, 0x3FF0000000000001);
    ins(cache, "mov", reg(0), asStructuredImm(44)); ins(cache, "mov", reg(11), asStructuredImm(40));
    ins(cache, "mov", asStructuredMem(2, 3, 11, 0, 0, 0, ""), reg(0)); ins(cache, "mov", reg(0), mem(2)); check(cache, 0, 44);
    ins(cache, "mov", reg(1), reg(3)); jump(cache, "call", asStructuredTarget("f_1")); check(cache, 0, 77); check(cache, 8, 99);
    ins(cache, "mov", reg(0), mem(2)); check(cache, 0, 55); ins(cache, "mov", reg(0), mem(3)); check(cache, 0, 66);
    ins(cache, "mov", mem(2), asStructuredImm(11)); ins(cache, "lea", reg(14), asStructuredMem(2, -1, -1, 0, 0, 1, "f_1"));
    ins(cache, "mov", reg(1), reg(3)); jump(cache, "call", reg(14)); check(cache, 0, 77);
    ins(cache, "mov", reg(0), mem(2)); check(cache, 0, 55);
    ins(cache, "mov", reg(0), asStructuredImm(0)); jump(cache, "jmp", asStructuredTarget("done"));
    asProducerLabel(1, "fail", 1); ins(cache, "mov", reg(0), asStructuredImm(123)); asProducerLabel(1, "done", 1); finish();
    const callee = start(1); ins(callee, "mov", mem(2), asStructuredImm(55)); ins(callee, "mov", mem(3), asStructuredImm(66));
    ins(callee, "mov", reg(0), asStructuredImm(77)); ins(callee, "mov", reg(8), asStructuredImm(99)); finish();
    asStructuredSection(3); asStructuredLabel("window"); asStructuredZero(128); asResolveLocalFixups(); assert(asFailedAs() == 0, asLastErrAs());
    assert(linkElfImage("__tx_entry") == 0, elfLastError()); writeFileBytes(path, elfBytesOut()) catch panic("image write");
}
export function main(args: []string): int { if (len(args) != 1) { return 64; } emit(false, args[0] + ".elf"); emit(true, args[0] + "-bad.elf"); return 0; }
