// ============================================================================
// engine/mac/m_s1 —— objc_msgSend：id(id, SEL, const char *)（如 +[NSString stringWithUTF8String:]）。
// ============================================================================

declare function sel_registerName(name: string): usize from "/usr/lib/libobjc.A.dylib";
declare function objc_msgSend(o: usize, s: usize, a: string): usize from "/usr/lib/libobjc.A.dylib";

export function msgS(o: usize, s: string, a: string): usize {
    return objc_msgSend(o, sel_registerName(s), a);
}
