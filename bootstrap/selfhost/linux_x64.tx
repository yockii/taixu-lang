// x86_64-linux 的手写入口与原语（目标分层 X3b）：只有这几处要在栈切换、线程指针上
// 直接用机器指令，其余例程都经 rtfn 发出。另三种架构的 Linux 见 linux_a64.tx、linux_la64.tx、linux_rv64.tx。
// - 线程指针：fs 基址（arch_prctl 设）。TLS 是 Variant II：线程指针指向线程控制块（首字指向自身），可执行文件的 TLS 块在它之下，
//   槽在 fs:[-8]（PT_TLS）。动态产物由加载器设好 fs 基址；静态产物进程起始时为 0，_start 指向 __tx_tls_static（槽，再接自指的
//   线程指针）。
// - clone 的实参次序：(flags, stack, ptid, ctid, tls)，原样发出。
// 系统调用号是 x86_64 的号；syscall 改写 rcx、r11。
import { Operand, StructuredBuffer, asBufferLabel, asBufferInstruction, asBufferBoundaryBegin, asBufferFunctionEnd, asManualBegin, asManualLeaf, asStructuredMissing, asStructuredReg, asStructuredImm, asStructuredTarget, asStructuredMem, asStructuredSegMem } from "./assemble";

const MODULE: string = "bootstrap/selfhost/linux_x64.tx";

function ins(b: Ref<StructuredBuffer>, mn: string, n: int, a: Ref<Operand>, c: Ref<Operand>): void {
    asBufferInstruction(b, mn, n, a, c, asStructuredMissing(), 1);
}
function r64(n: int): Ref<Operand> { return asStructuredReg(0, n); }
function r32(n: int): Ref<Operand> { return asStructuredReg(1, n); }
function none(): Ref<Operand> { return asStructuredMissing(); }

/// Linux process entry without libc: (argc, argv) from the initial stack into
/// the kernel's C-shaped `__tx_native_entry`, which ends in exit_group.
/// ELF 的 e_entry；arch_prctl 与 exit_group 是 Linux 的原始系统调用。
export function linuxX64Start(b: Ref<StructuredBuffer>): void {
    const none = asStructuredMissing();
    asBufferBoundaryBegin(b, MODULE, "_start", "process-entry");
    asBufferLabel(b, "_start", 1);
    asBufferInstruction(b, "xor", 2, asStructuredReg(1, 5), asStructuredReg(1, 5), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 7), asStructuredMem(2, 4, -1, 0, 0, 0, ""), none, 1);
    asBufferInstruction(b, "lea", 2, asStructuredReg(0, 6), asStructuredMem(2, 4, -1, 0, 8, 0, ""), none, 1);
    // envp = argv + (argc + 1) * 8, kept for getEnv/tempDir/runProcess.
    asBufferInstruction(b, "lea", 2, asStructuredReg(0, 0), asStructuredMem(2, 6, 7, 3, 8, 0, ""), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_nrt_envp"), asStructuredReg(0, 0), none, 1);
    // Platform TLS (threads §十二): a dynamic product's loader has already set the fs base
    // (the TLS slot is fs:[-8], from PT_TLS); a static product starts with fs base 0, so
    // the main thread's TLS area is __tx_tls_static (slot, then the self-pointing thread
    // pointer). arch_prctl(ARCH_GET_FS / ARCH_SET_FS); argc/argv kept in r12/r13.
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 12), asStructuredReg(0, 7), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 13), asStructuredReg(0, 6), none, 1);
    asBufferInstruction(b, "sub", 2, asStructuredReg(0, 4), asStructuredImm(16), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredMem(2, 4, -1, 0, 0, 0, ""), asStructuredImm(0), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 7), asStructuredImm(4099), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 6), asStructuredReg(0, 4), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 0), asStructuredImm(158), none, 1);
    asBufferInstruction(b, "syscall", 0, none, none, none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 0), asStructuredMem(2, 4, -1, 0, 0, 0, ""), none, 1);
    asBufferInstruction(b, "test", 2, asStructuredReg(0, 0), asStructuredReg(0, 0), none, 1);
    asBufferInstruction(b, "jne", 1, asStructuredTarget("__tx_start_tls_ready"), none, none, 1);
    asBufferInstruction(b, "lea", 2, asStructuredReg(0, 6), asStructuredMem(2, -1, -1, 0, 0, 1, "__tx_tls_static"), none, 1);
    asBufferInstruction(b, "add", 2, asStructuredReg(0, 6), asStructuredImm(8), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredMem(2, 6, -1, 0, 0, 0, ""), asStructuredReg(0, 6), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 7), asStructuredImm(4098), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 0), asStructuredImm(158), none, 1);
    asBufferInstruction(b, "syscall", 0, none, none, none, 1);
    asBufferInstruction(b, "test", 2, asStructuredReg(0, 0), asStructuredReg(0, 0), none, 1);
    asBufferInstruction(b, "je", 1, asStructuredTarget("__tx_start_tls_ready"), none, none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 7), asStructuredImm(70), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 0), asStructuredImm(231), none, 1);
    asBufferInstruction(b, "syscall", 0, none, none, none, 1);
    asBufferLabel(b, "__tx_start_tls_ready", 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 7), asStructuredReg(0, 12), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(0, 6), asStructuredReg(0, 13), none, 1);
    asBufferInstruction(b, "and", 2, asStructuredReg(0, 4), asStructuredImm(-16), none, 1);
    asBufferInstruction(b, "call", 1, asStructuredTarget("__tx_native_entry"), none, none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 7), asStructuredReg(1, 0), none, 1);
    asBufferInstruction(b, "mov", 2, asStructuredReg(1, 0), asStructuredImm(231), none, 1);
    asBufferInstruction(b, "syscall", 0, none, none, none, 1);
    // exit_group 不返回；以 ud2 收尾（同 glibc 的 _exit 在系统调用后接 hlt）——按函数取舍的链接要求每个函数以无条件转移结束，
    // 不落入下一个函数（v052-runtime-on-demand-link 第二节）。
    asBufferInstruction(b, "ud2", 0, none, none, none, 1);
    asBufferFunctionEnd(b);
}

/// __tx_tls_tb_get() → 本线程的线程块（外来线程为 0）；__tx_tls_tb_set(tb)。只写 rax。槽在 fs:[-8]。
/// 两个都是叶函数，登记为手写函数（runtime-manual）。
export function linuxX64TlsLeaves(b: Ref<StructuredBuffer>): void {
    asManualBegin(b, MODULE, "__tx_tls_tb_get"); asManualLeaf(b);
    ins(b, "mov", 2, asStructuredReg(0, 0), asStructuredSegMem("fs", -8));
    ins(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    asBufferFunctionEnd(b);
    asManualBegin(b, MODULE, "__tx_tls_tb_set"); asManualLeaf(b);
    ins(b, "mov", 2, asStructuredSegMem("fs", -8), asStructuredReg(0, 1));
    ins(b, "ret", 0, asStructuredMissing(), asStructuredMissing());
    asBufferFunctionEnd(b);
}

/// __tx_thread_clone(flags, top, ptid, ctid, tls) → 子线程号或 −errno（父线程）。子线程在新栈上从 syscall 之后继续：[rsp]＝记录
/// （父线程预先写好），调用 __tx_thread_main，它以 exit 结束、不返回。__tx_thread_unmap_exit(base, size)：归还自己正在用的栈后
/// 立即以 exit 结束本线程——munmap 之后只用寄存器、不再碰栈。
export function linuxX64ThreadStubs(b: Ref<StructuredBuffer>): void {
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_clone", "stack-transition");
    asBufferLabel(b, "__tx_thread_clone", 1);
    ins(b, "mov", 2, r64(7), r64(1));
    ins(b, "mov", 2, r64(6), r64(2));
    ins(b, "mov", 2, r64(2), r64(8));
    ins(b, "mov", 2, r64(10), r64(9));
    ins(b, "mov", 2, r64(8), asStructuredMem(2, 4, -1, 0, 40, 0, ""));
    ins(b, "mov", 2, r32(0), asStructuredImm(56));
    asBufferInstruction(b, "syscall", 0, none(), none(), none(), 1);
    ins(b, "test", 2, r64(0), r64(0));
    ins(b, "je", 1, asStructuredTarget("__tx_thread_clone_child"), none());
    ins(b, "ret", 0, none(), none());
    asBufferLabel(b, "__tx_thread_clone_child", 1);
    ins(b, "xor", 2, r32(5), r32(5));
    ins(b, "mov", 2, r64(1), asStructuredMem(2, 4, -1, 0, 0, 0, ""));
    ins(b, "sub", 2, r64(4), asStructuredImm(32));
    ins(b, "call", 1, asStructuredTarget("__tx_thread_main"), none());
    asBufferInstruction(b, "ud2", 0, none(), none(), none(), 1);
    asBufferFunctionEnd(b);
    asBufferBoundaryBegin(b, MODULE, "__tx_thread_unmap_exit", "stack-disposal");
    asBufferLabel(b, "__tx_thread_unmap_exit", 1);
    ins(b, "mov", 2, r64(7), r64(1));
    ins(b, "mov", 2, r64(6), r64(2));
    ins(b, "mov", 2, r32(0), asStructuredImm(11));
    asBufferInstruction(b, "syscall", 0, none(), none(), none(), 1);
    ins(b, "xor", 2, r32(7), r32(7));
    ins(b, "mov", 2, r32(0), asStructuredImm(60));
    asBufferInstruction(b, "syscall", 0, none(), none(), none(), 1);
    asBufferInstruction(b, "ud2", 0, none(), none(), none(), 1);
    asBufferFunctionEnd(b);
}
