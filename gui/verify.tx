// ============================================================================
// taixu-gui 验证驱动（2026-10-26，GUI 原生引擎 G0 起取代 bash 版 verify）。
//
// 用法（在本仓根目录）：
//   taixu run --toolchain verify.tx --compiler <原生 taixu> [--stdlib <标准库 src>] [--runs N]
// 编译器也可经环境变量 TAIXU_BIN（可执行文件或其所在目录）给出；标准库缺省取环境变量
// TAIXU_STDLIB，否则取同级的 ../taixu-stdlib/src（有则用），再否则由编译器自己查找。
//
// 段：
//   ① fmt --check：src、tests、examples
//   ② 主程序对：tests/*.tx 里没有重放脚本的，run 的标准输出 == 同名 .out（文件名以 -windows 结尾的真窗用例只在 Windows 上跑，
//      以 -linux 结尾的只在设了 DISPLAY 的 Linux 上跑，以 -macos 结尾的只在 macOS 上跑）
//   ③ 重放用例：每个程序构建一次产物，每例以 TAIXU_REPLAY/TAIXU_FRAME/TAIXU_OUT_DIR 跑 N 次
//      （缺省 8），标准输出 == tests/<例>.out，定格三伴 == tests/golden/<主名>-f<帧>.*
//   ④ 行数盘点（只报告）
//   ⑤ 行尾：文本文件不含 CR
// ============================================================================

struct Opts {
    compiler: string,
    stdlib: string,
    runs: int,
}

struct Case {
    prog: string,
    stem: string,
    frame: int,
    golden: string,
}

struct Tally {
    pass: int,
    fail: int,
}

function exeSuffix(): string {
    if (hostTarget() == "windows") {
        return ".exe";
    }
    return "";
}

function sep(): string {
    if (hostTarget() == "windows") {
        return "\\";
    }
    return "/";
}

function isFile(p: string): bool {
    const n = fileSize(p) catch -1;
    return n >= 0;
}

function parseOpts(args: []string): Ref<Opts> | Error {
    const o = new Opts { compiler: "", stdlib: "", runs: 8 };
    let i: int = 0;
    while (i < len(args)) {
        const a: string = args[i];
        if ((a == "--compiler" || a == "--stdlib" || a == "--runs") && i + 1 < len(args)) {
            const v: string = args[i + 1];
            if (a == "--compiler") {
                o.compiler = v;
            } else if (a == "--stdlib") {
                o.stdlib = v;
            } else {
                o.runs = digits(v);
                if (o.runs < 1) {
                    return err("--runs 须为正整数");
                }
            }
            i = i + 2;
        } else {
            return err("不认识的参数：" + a);
        }
    }
    if (o.compiler == "") {
        const bin: string = getEnv("TAIXU_BIN") catch "";
        if (bin != "") {
            if (isFile(bin)) {
                o.compiler = bin;
            } else {
                o.compiler = bin + sep() + "taixu" + exeSuffix();
            }
        }
    }
    if (o.compiler == "" || !isFile(o.compiler)) {
        return err("找不到编译器：用 --compiler <原生 taixu> 或环境变量 TAIXU_BIN 指定");
    }
    if (o.stdlib == "") {
        o.stdlib = getEnv("TAIXU_STDLIB") catch "";
    }
    if (o.stdlib == "" && isFile(".." + sep() + "taixu-stdlib" + sep() + "src" + sep() + "os.tx")) {
        o.stdlib = ".." + sep() + "taixu-stdlib" + sep() + "src";
    }
    return o;
}

function digits(s: string): int {
    if (len(s) == 0 || len(s) > 9) {
        return -1;
    }
    let v: int = 0;
    let i: int = 0;
    while (i < len(s)) {
        const c: int = byteAt(s, i) catch 0;
        if (c < 48 || c > 57) {
            return -1;
        }
        v = v * 10 + c - 48;
        i = i + 1;
    }
    return v;
}

// —— 子进程：收齐标准输出与标准错误，超时即杀 ——

struct Outcome {
    code: int,
    out: Bytes,
    err: Bytes,
    timedOut: bool,
}

function capture(exe: string, args: List<string>, limitMs: int): Outcome {
    const h = procSpawnLimited(exe, args, "", 0, 8589934592, limitMs / 1000 + 30) catch (e) {
        const r: Outcome = { code: -1, out: bytesNew(0), err: bytesFromStr("起不了 " + exe + "：" + e.message), timedOut: false };
        return r;
    };
    const out = bytesNew(0);
    const errs = bytesNew(0);
    const buf = bytesNew(65536);
    const deadline: int = monoNs() + limitMs * 1000000;
    let code: int = 0;
    let ended: bool = false;
    let timedOut: bool = false;
    let outOpen: bool = true;
    let errOpen: bool = true;
    let drainDeadline = 0;
    while (true) {
        if (!ended) {
            const w = procWait(h, 0);
            if (w != None) {
                code = w ?? -1;
                procKill(h); // 主进程结束后收回仍持有管道的组内后代。
                ended = true;
            }
        }
        if (!timedOut && monoNs() >= deadline) {
            timedOut = true;
            procKill(h);
            drainDeadline = monoNs() + 2000000000;
        }
        if (timedOut && monoNs() >= drainDeadline) {
            procCloseStream(h, 1); procCloseStream(h, 2); break;
        }
        if (ended && !outOpen && !errOpen) {
            break;
        }
        let mask: int = 0;
        if (outOpen) {
            mask = mask | 2;
        }
        if (errOpen) {
            mask = mask | 4;
        }
        if (mask == 0) {
            const waited = procWait(h, 100);
            continue;
        }
        const ready: int = ioWait(h, mask, 100);
        if ((ready & 2) != 0) {
            const n: int = procRead(h, 1, buf);
            if (n < 0) {
                outOpen = false;
            } else if (n > 0) {
                bytesAppend(out, bytesSlice(buf, 0, n));
            }
        }
        if ((ready & 4) != 0) {
            const n: int = procRead(h, 2, buf);
            if (n < 0) {
                errOpen = false;
            } else if (n > 0) {
                bytesAppend(errs, bytesSlice(buf, 0, n));
            }
        }
    }
    procClose(h);
    if (timedOut) {
        code = -1;
    }
    const r: Outcome = { code: code, out: out, err: errs, timedOut: timedOut };
    return r;
}

// CRLF 归一为 LF（Windows 控制台路径不经 CRLF，但 .out 与输出都按 LF 比较）。
function lf(b: Bytes): Bytes {
    const o = bytesNew(0);
    let i: int = 0;
    while (i < bytesLen(b)) {
        const c: int = bytesGet(b, i) catch 0;
        if (!(c == 13 && (bytesGet(b, i + 1) catch 0) == 10)) {
            bytesPush(o, c);
        }
        i = i + 1;
    }
    return o;
}

function readOr(p: string): Bytes {
    return readFileBytes(p) catch bytesNew(0);
}

function show(b: Bytes, max: int): string {
    let n: int = bytesLen(b);
    if (n > max) {
        n = max;
    }
    return bytesToStr(bytesSlice(b, bytesLen(b) - n, n)) catch "<非 UTF-8 输出>";
}

function note(t: Ref<Tally>, ok: bool, name: string, detail: string): void {
    if (ok) {
        t.pass = t.pass + 1;
        print("  PASS " + name);
    } else {
        t.fail = t.fail + 1;
        print("  FAIL " + name + "：" + detail);
    }
}

function dirNames(d: string): List<string> {
    const empty: List<string> = listNew();
    return listDir(d) catch empty;
}

// —— 用例表 ——

function addCase(cs: List<Case>, prog: string, stem: string, frame: int, golden: string): void {
    const c: Case = { prog: prog, stem: stem, frame: frame, golden: golden };
    listPush(cs, c);
}

function replayCases(): List<Case> {
    const cs: List<Case> = listNew();
    addCase(cs, "examples/counter.tx", "counter-replay", 3, "counter");
    addCase(cs, "examples/form.tx", "form-check", 7, "form-check");
    addCase(cs, "examples/form.tx", "form-input", 11, "form-input");
    addCase(cs, "examples/form.tx", "form-scroll", 8, "form-scroll");
    addCase(cs, "examples/form.tx", "form-modal", 5, "form-modal");
    addCase(cs, "examples/form.tx", "form-mods", 7, "form-mods");
    addCase(cs, "examples/form.tx", "form-table", 5, "form-table");
    addCase(cs, "examples/form.tx", "form-ime", 5, "form-ime");
    addCase(cs, "examples/glass.tx", "glass-close", 1, "glass-close");
    addCase(cs, "examples/color-mix.tx", "color-drag", 7, "color-drag");
    addCase(cs, "tests/font-families.tx", "font-families", 1, "font-families");
    addCase(cs, "tests/menu-popup.tx", "menu-popup", 1, "menu-popup");
    addCase(cs, "tests/menu-popup.tx", "menu-popup-cancel", 2, "menu-popup-cancel");
    addCase(cs, "tests/tree.tx", "tree", 3, "tree");
    addCase(cs, "tests/tree.tx", "tree-folded", 1, "tree-folded");
    addCase(cs, "tests/table-scroll.tx", "table-scroll", 9, "table-scroll");
    addCase(cs, "tests/table-scroll.tx", "table-scroll-top", 1, "table-scroll-top");
    addCase(cs, "tests/table-scroll.tx", "table-scroll-mid", 6, "table-scroll-mid");
    addCase(cs, "examples/todo.tx", "todo-list", 17, "todo-list");
    addCase(cs, "examples/texttool.tx", "text-edit", 16, "text-edit");
    addCase(cs, "examples/textarea.tx", "textarea-replay", 16, "textarea-replay");
    addCase(cs, "examples/browser-demo.tx", "browser-nav", 31, "browser-nav");
    addCase(cs, "examples/browser-demo.tx", "browser-cancel", 11, "browser-cancel");
    addCase(cs, "examples/browser-demo.tx", "browser-error", 8, "browser-error");
    addCase(cs, "examples/browser-demo.tx", "browser-address-replay", 30, "browser-address-replay");
    addCase(cs, "examples/browser-demo.tx", "browser-dpi", 6, "browser-dpi");
    addCase(cs, "examples/browser-demo.tx", "browser-wheel", 12, "browser-wheel");
    addCase(cs, "examples/browser-demo.tx", "browser-page-keys", 12, "browser-page-keys");
    addCase(cs, "tests/hit-scan.tx", "hit-scan", 6, "hit-scan");
    addCase(cs, "tests/dpi-scale.tx", "dpi-scale", 1, "dpi-scale");
    addCase(cs, "examples/flex.tx", "flex-replay", 2, "flex-replay");
    addCase(cs, "tests/dialog.tx", "dialog", 1, "dialog");
    addCase(cs, "examples/login.tx", "login", 13, "login");
    addCase(cs, "tests/alpha.tx", "alpha", 1, "alpha");
    return cs;
}

function baseName(p: string): string {
    let start: int = 0;
    let dot: int = len(p);
    let i: int = 0;
    while (i < len(p)) {
        const c: int = byteAt(p, i) catch 0;
        if (c == 47 || c == 92) {
            start = i + 1;
        } else if (c == 46) {
            dot = i;
        }
        i = i + 1;
    }
    return strSlice(p, start, dot);
}

// s 是否以 suf 结尾（逐字节比，不会切在字符中间）。
function hasSuffix(s: string, suf: string): bool {
    const n: int = len(s);
    const m: int = len(suf);
    if (m > n) {
        return false;
    }
    let i: int = 0;
    while (i < m) {
        if ((byteAt(s, n - m + i) catch 0) != (byteAt(suf, i) catch 0)) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// —— 各段 ——

function stepFmt(o: Ref<Opts>, t: Ref<Tally>): void {
    print("== ① fmt --check（src tests examples）==");
    const a: List<string> = listNew();
    listPush(a, "fmt");
    listPush(a, "--check");
    listPush(a, "src");
    listPush(a, "tests");
    listPush(a, "examples");
    const r: Outcome = capture(o.compiler, a, 120000);
    note(t, r.code == 0, "fmt", show(r.out, 2000) + show(r.err, 1000));
}

function stepPrograms(o: Ref<Opts>, t: Ref<Tally>): void {
    print("== ② 主程序对（tests/*.tx 无重放脚本者）==");
    const names: List<string> = dirNames("tests");
    for (n in names) {
        if (!(len(n) > 3 && hasSuffix(n, ".tx"))) {
            continue;
        }
        const stem: string = strSlice(n, 0, len(n) - 3);
        if (isFile("tests/" + stem + ".txt")) {
            continue;
        }
        if (len(stem) > 8 && hasSuffix(stem, "-windows") && hostTarget() != "windows") {
            // 真窗用例（文件名以 -windows 结尾）只在 Windows 上跑。
            print("  SKIP " + stem + "（只在 Windows 上跑）");
            continue;
        }
        if (len(stem) > 6 && hasSuffix(stem, "-linux") && (hostTarget() != "linux" || (getEnv("DISPLAY") catch "") == "")) {
            // Linux 真窗用例（文件名以 -linux 结尾）只在 Linux 上、设了 DISPLAY（有 X 服务器）时跑。
            print("  SKIP " + stem + "（只在有 X 服务器的 Linux 上跑）");
            continue;
        }
        if (len(stem) > 6 && hasSuffix(stem, "-macos") && hostTarget() != "macos") {
            // macOS 真窗用例（文件名以 -macos 结尾）只在 macOS 上跑（要本用户的窗口服务器会话，即用户在本机登录着；ssh 进来也可以）。
            print("  SKIP " + stem + "（只在 macOS 上跑）");
            continue;
        }
        const a: List<string> = listNew();
        listPush(a, "run");
        listPush(a, "tests/" + n);
        const r: Outcome = capture(o.compiler, a, 300000);
        const want = lf(readOr("tests/" + stem + ".out"));
        const ok: bool = r.code == 0 && bytesEqual(lf(r.out), want);
        note(t, ok, stem, "退出码 " + toStr(r.code) + "；输出尾部：" + show(r.out, 600) + show(r.err, 600));
    }
}

function stepReplay(o: Ref<Opts>, t: Ref<Tally>, work: string): void {
    print("== ③ 重放用例（每例 " + toStr(o.runs) + " 次；stdout == .out，三伴 == golden）==");
    const built: List<string> = listNew();
    for (c in replayCases()) {
        const pstem: string = baseName(c.prog);
        const dir: string = work + "/bin-" + pstem;
        const exe: string = dir + "/" + pstem + exeSuffix();
        let have: bool = false;
        for (b in built) {
            if (b == pstem) {
                have = true;
            }
        }
        if (!have) {
            const a: List<string> = listNew();
            listPush(a, "build");
            listPush(a, c.prog);
            listPush(a, "--out");
            listPush(a, dir);
            const r: Outcome = capture(o.compiler, a, 600000);
            if (r.code != 0) {
                note(t, false, c.stem, "构建 " + c.prog + " 失败：" + show(r.out, 600) + show(r.err, 600));
                continue;
            }
            listPush(built, pstem);
        }
        const want = lf(readOr("tests/" + c.stem + ".out"));
        const out: string = work + "/out-" + c.stem;
        let bad: string = "";
        let run: int = 1;
        while (run <= o.runs && bad == "") {
            setEnv("TAIXU_REPLAY", "tests/" + c.stem + ".txt") catch panic("setEnv");
            setEnv("TAIXU_FRAME", toStr(c.frame)) catch panic("setEnv");
            setEnv("TAIXU_OUT_DIR", out) catch panic("setEnv");
            const r: Outcome = capture(exe, listNew(), 120000);
            if (r.code != 0 || !bytesEqual(lf(r.out), want)) {
                bad = "第 " + toStr(run) + " 次：退出码 " + toStr(r.code) + "，输出尾部：" + show(r.out, 600) + show(r.err, 600);
            }
            for (ext in [".bmp", ".sha256", ".txt"]) {
                const got = readFileBytes(out + "/" + c.stem + "-f" + toStr(c.frame) + ext) catch bytesNew(0);
                const gold = readOr("tests/golden/" + c.golden + "-f" + toStr(c.frame) + ext);
                if (bad == "" && (bytesLen(got) == 0 || !bytesEqual(got, gold))) {
                    bad = "第 " + toStr(run) + " 次：定格 " + ext + " 与 golden 不同";
                }
                removeFile(out + "/" + c.stem + "-f" + toStr(c.frame) + ext) catch (e) {
                    e;
                };
            }
            run = run + 1;
        }
        note(t, bad == "", c.stem, bad);
    }
    setEnv("TAIXU_REPLAY", "") catch panic("setEnv");
    setEnv("TAIXU_FRAME", "") catch panic("setEnv");
    setEnv("TAIXU_OUT_DIR", "") catch panic("setEnv");
}

function countLines(b: Bytes): int {
    let n: int = 0;
    let i: int = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) catch 0) == 10) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

function stepLines(): void {
    print("== ④ 行数盘点（只报告；软上限 1000）==");
    for (d in ["src", "src/engine", "examples/browser"]) {
        const names: List<string> = dirNames(d);
        for (n in names) {
            if (len(n) > 3 && hasSuffix(n, ".tx")) {
                const c: int = countLines(readOr(d + "/" + n));
                let mark: string = "";
                if (c > 1000) {
                    mark = "  [超限]";
                }
                print("  " + d + "/" + n + " " + toStr(c) + mark);
            }
        }
    }
}

function hasCR(b: Bytes): bool {
    let i: int = 0;
    while (i < bytesLen(b)) {
        if ((bytesGet(b, i) catch 0) == 13) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

function textFile(n: string): bool {
    for (ext in [".tx", ".md", ".txt", ".out", ".sha256"]) {
        if (len(n) > len(ext) && hasSuffix(n, ext)) {
            return true;
        }
    }
    return false;
}

function stepEol(t: Ref<Tally>): void {
    print("== ⑤ 行尾（文本文件不含 CR）==");
    const bad: List<string> = listNew();
    for (d in [".", "src", "src/engine", "tests", "tests/golden", "examples", "examples/browser", "docs"]) {
        const names: List<string> = dirNames(d);
        for (n in names) {
            if (textFile(n) && hasCR(readOr(d + "/" + n))) {
                listPush(bad, d + "/" + n);
            }
        }
    }
    let detail: string = "";
    for (b in bad) {
        detail = detail + " " + b;
    }
    note(t, listLen(bad) == 0, "LF", "含 CR：" + detail);
}

export function main(args: []string): int {
    const o: Ref<Opts> = parseOpts(args) catch (e) {
        eprint("verify：" + e.message);
        return 2;
    };
    if (!isFile("src/app.tx") || !isFile("verify.tx")) {
        eprint("verify：请在 taixu-gui 仓根目录运行");
        return 2;
    }
    const root: string = currentDir() catch panic("取不到当前目录");
    setEnv("TAIXU_GUI_ROOT", root + sep() + "src") catch panic("setEnv");
    if (o.stdlib != "") {
        setEnv("TAIXU_STDLIB", o.stdlib) catch panic("setEnv");
    }
    const work: string = ".verify";
    makeDir(work) catch (e) {
        eprint("verify：建不了 " + work + "：" + e.message);
        return 2;
    };
    print("verify：编译器 " + o.compiler + "；标准库 " + o.stdlib);
    const t = new Tally { pass: 0, fail: 0 };
    stepFmt(o, t);
    stepPrograms(o, t);
    stepReplay(o, t, work);
    stepLines();
    stepEol(t);
    print("verify：通过 " + toStr(t.pass) + "，失败 " + toStr(t.fail));
    if (t.fail > 0) {
        return 1;
    }
    return 0;
}
