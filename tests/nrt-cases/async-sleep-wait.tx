// 原生异步（去 Zig 第 4 轮第 3 步）：只剩定时器时调度器等待到期（2026-10-14 裁决，
// VM 同修）——就绪队空、唯一的任务挂在未到期的 sleepMs 上，不再报死锁。输出与睡眠
// 时长无关；观察者经 await 链拿到结果。
function main(args: []string): int {
    const t = napper(30);
    const w = watch(t);
    print("spawned");
    return 0;
}

async function napper(ms: int): int {
    const before = nowMs();
    print("sleeping");
    await sleepMs(ms) catch (e) {
        print("sleep err: " + e.message);
        return -1;
    };
    print("woke");
    print("waited: " + toStr(nowMs() - before >= ms - 5));
    return ms;
}

async function watch(f: Future < int >): int {
    const v = await f catch -1;
    print("watched: " + toStr(v));
    return v;
}
