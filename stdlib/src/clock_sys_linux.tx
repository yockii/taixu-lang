declare function lxClockGettime(clock: int, value: Bytes): int from syscall "clock_gettime";

export function sysMonotonicNs(): int {
    const time = bytesNew(16);
    if (lxClockGettime(1, time) < 0) { return -1; }
    const seconds = bytesGetLE<i64>(time, 0) catch -1; const nanos = bytesGetLE<i64>(time, 8) catch -1;
    if (seconds < 0 || seconds > 9223372036 || nanos < 0 || nanos >= 1000000000) { return -1; }
    const whole = seconds * 1000000000;
    if (whole > 9223372036854775807 - nanos) { return -1; } return whole + nanos;
}
