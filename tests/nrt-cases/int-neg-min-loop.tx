// 循环里的局部量取负：最小值取负溢出 trap 4004（D3 §620），之前的取负照常。
export function main(args: []string): int {
    const m: int = -9223372036854775807 - 1;
    let x: int = m + 1;
    let i: int = 0;
    while (i < 3) {
        x = -x;
        print(toStr(x));
        x = -x;
        x = x - 1;
        i = i + 1;
    }
    return 0;
}
