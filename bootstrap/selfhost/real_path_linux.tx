// 真实路径（Linux）：逐个组件 readlinkat 解开符号链接，同 realpath(3)；from syscall，不依赖 libc。导出面同 real_path_windows.tx、
// real_path_macos.tx。用于启动时解析启动操作者给的路径（服务信任根、MCP 暂存区的上级、构建驱动的根与编译器）：local* 内建拒绝
// 路径里的链接，操作者给的路径只在这里解析一次。
declare function rpReadlinkat(dir: int, path: string, buf: Bytes, size: int): int from syscall 267;

const AT_FDCWD: int = -100;

// 绝对路径的真实路径；链接超过 40 层（同 Linux 的 ELOOP）或不是绝对路径时原样返回，由随后的检查报错。
export function realPath(path: string): string {
    if (len(path) == 0 || (byteAt(path, 0) ?? 0) != 47) {
        return path;
    }
    const queue: List<string> = listNew();
    for (c in strSplit(path, "/")) {
        listPush(queue, c);
    }
    const buf = bytesNew(4096);
    let resolved = "";
    let links: int = 0;
    while (listLen(queue) > 0) {
        const c = listGet(queue, 0) catch "";
        listRemoveAt(queue, 0);
        if (len(c) == 0 || c == ".") {
            continue;
        }
        if (c == "..") {
            resolved = parentOf(resolved);
            continue;
        }
        const cand = resolved + "/" + c;
        const n = rpReadlinkat(AT_FDCWD, cand, buf, 4096);
        if (n <= 0 || n >= 4096) {
            resolved = cand;
            continue;
        }
        links = links + 1;
        if (links > 40) {
            return path;
        }
        const target = bytesToStr(bytesSlice(buf, 0, n)) catch "";
        if (len(target) == 0) {
            return path;
        }
        if ((byteAt(target, 0) ?? 0) == 47) {
            resolved = "";
        }
        const parts = strSplit(target, "/");
        let k: int = listLen(parts) - 1;
        while (k >= 0) {
            listInsert(queue, 0, listGet(parts, k) catch "");
            k = k - 1;
        }
    }
    if (len(resolved) == 0) {
        return "/";
    }
    return resolved;
}

function parentOf(p: string): string {
    let i: int = len(p) - 1;
    while (i > 0 && (byteAt(p, i) ?? 0) != 47) {
        i = i - 1;
    }
    if (i <= 0) {
        return "";
    }
    return bytesToStr(bytesSlice(bytesFromStr(p), 0, i)) catch "";
}
