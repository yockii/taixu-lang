// 着色擦除（D3 v0.8 §8）：async 函数经函数值同步调用，不建任务。在任务内对未决
// Future await 时只有任务基帧能挂起（单帧 stackless，D26 §三-3），嵌套帧按“await
// 执行于无任务上下文”报错并附未决任务计数（VM 原先把嵌套帧当任务帧挂起、随后以
// corrupt_code 结束——2026-10-14 随原生异步同修；原生 NRT 同义）。
function main(args: []string): int {
    const s = slow();
    const o = outer(s);
    print("spawned");
    return 0;
}

async function slow(): int {
    await sleepMs(0) catch (e) {
        return -1;
    };
    return 7;
}

async function inner(f: Future<int>): int {
    const v = await f catch -1;
    return v;
}

async function outer(f: Future<int>): int {
    const g: (Future<int>) => int = inner;
    const v = g(f);
    print("sync: " + toStr(v));
    return v;
}
