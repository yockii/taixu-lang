// D3 v0.52：strSub／strIndexOf（码点）与 strByteSub／strByteIndexOf（字节）在种子换代前的 --toolchain 构建里
// 照收、语义不变（编译器与构建脚本由种子 0.3.0-beta.1 编译，种子只认旧名）；普通构建报 3001（guard-bad-str-old-names）。
export function main(args: []string): int {
    const s = "太虚abc";
    print(strSub(s, 1, 2) + " " + toStr(strIndexOf(s, "a")) + " " + strByteSub(s, 3, 3) + " " + toStr(strByteIndexOf(s, "a")));
    return 0;
}
