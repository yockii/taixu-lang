// bootstrap/lowermirror —— AOT 指令选择层 .tx 镜像（V0.40-B2；D82 分柱一——
// 恒等探针法 D60 sema 同法；柱一切换＝过门后另行判据，本柱只镜像＋探针）。
//
// 镜像对象＝src/tools/aot/lower.zig 四纯判定函数（63 行面——形态布尔判定，
// 零发射零状态）。oracle＝zig 真值函数（`taixu dev-lower-dump` 全枚举产用例
// 文件——256×6＋256＋256×2＋256＝2560 例）；本文件对同一用例文件逐行复算
// 比对（scripts/lower-probe.sh 驱动——sema-spike-probe 同型恒等探针）。
// 常量漂移（BuiltinId/Tag/堆引用集）即探针红——ID 尾段追加纪律的守护面。
//
// 用法：taixu run bootstrap/lowermirror.tx <cases 文件>
// 输出＝全对齐 "lower-probe: N/N identical" 退出 0；否则逐例 MISMATCH 退出 1。

// —— bytecode.BuiltinId 镜像（仅判定面所需 id——漂移即探针红）——
// print=1 len=4 assertf=7 panicf=8 byte_at=11 list_push=14 list_get=16
// list_set=17 list_len=18 task_cancel=20 list_remove_at=26 list_insert=27

// —— interp.Tag 镜像：structv=7 enumv=8 ref=9；analysis 堆引用集＝
// err(5) str(6) structv(7) enumv(8) ref(9) arr(10) slice(11) weakbox(14)
// list(15) future(16) ——

// ① callbi 热内建内联候选判定（D52 §2.1 六内建）
function biInlineSelected(id: int, nargs: int): int {
    if (id == 16) { if (nargs == 2) { return 1; } return 0; }
    if (id == 17) { if (nargs == 3) { return 1; } return 0; }
    if (id == 18) { if (nargs == 1) { return 1; } return 0; }
    if (id == 11) { if (nargs == 2) { return 1; } return 0; }
    if (id == 4) { if (nargs == 1) { return 1; } return 0; }
    if (id == 14) { if (nargs == 2) { return 1; } return 0; }
    return 0;
}

// ② callbi 是否写结果槽（void 内建不写——D56 §一-1）
function biWritesDest(id: int): int {
    if (id == 1) { return 0; }
    if (id == 14) { return 0; }
    if (id == 17) { return 0; }
    if (id == 26) { return 0; }
    if (id == 27) { return 0; }
    if (id == 20) { return 0; }
    if (id == 7) { return 0; }
    if (id == 8) { return 0; }
    return 1;
}

// ③ getfld/setfld 快路径接收者 tag 兼容（D52 §2.2）
function fieldInlineTagOk(t: int, ad: int): int {
    if (ad == 1) { if (t == 9) { return 1; } return 0; }
    if (t == 7 || t == 8 || t == 9) { return 1; }
    return 0;
}

// ④ 堆引用 tag 集（analysis isHeapRefTagVal 镜像）
function isHeapTag(t: int): int {
    if (t == 5 || t == 6 || t == 7 || t == 8 || t == 9 || t == 10) { return 1; }
    if (t == 11 || t == 14 || t == 15 || t == 16) { return 1; }
    return 0;
}

// 写槽前旧值免 release 判定（Gen.destNoRelease 收口）
function destGuardElidable(t: int): int {
    if (t != 0 && isHeapTag(t) == 0) { return 1; }
    return 0;
}

// 全数字解析（头行/脏行返回 -1——"lower-cases-v1" 尾数字陷阱的守护）
function toKind(s: string): int {
    let v: int = 0;
    let i: int = 0;
    const n = len(s);
    if (n == 0) { return -1; }
    while (i < n) {
        const ch = byteAt(s, i) catch 0;
        if (ch < 48 || ch > 57) { return -1; }
        v = v * 10 + (ch - 48);
        i = i + 1;
    }
    return v;
}

function toInt(s: string): int {
    let v: int = 0;
    let i: int = 0;
    const n = len(s);
    while (i < n) {
        const ch = byteAt(s, i) catch 0;
        if (ch >= 48 && ch <= 57) { v = v * 10 + (ch - 48); }
        i = i + 1;
    }
    return v;
}

export function main(args: []string): int {
    if (len(args) < 1) {
        print("用法: taixu run bootstrap/lowermirror.tx <cases 文件>");
        return 64;
    }
    const data = readFile(args[0]) catch (e) {
        print("readfail: " + e.message);
        return 1;
    };
    const lines = strSplit(data, "\n");
    let li: int = 0;
    const ln = listLen(lines);
    let total: int = 0;
    let badc: int = 0;
    while (li < ln) {
        const line = listGet(lines, li) catch "";
        if (len(line) > 0) {
            const toks = strSplit(line, " ");
            const kind = toKind(listGet(toks, 0) catch "");
            const a1 = toInt(listGet(toks, 1) catch "");
            const a2 = toInt(listGet(toks, 2) catch "");
            const ex = toInt(listGet(toks, 3) catch "");
            // expected 列位随形态：①/③（三输入形）＝第 4 列；②/④（两输入形）
            // 的 expected 落第 3 列＝a2（a2 对②/④ 是期望值不是输入）。
            let exOk: int = ex;
            if (kind == 2 || kind == 4) { exOk = a2; }
            let r: int = -1;
            if (kind == 1) { r = biInlineSelected(a1, a2); }
            if (kind == 2) { r = biWritesDest(a1); }
            if (kind == 3) { r = fieldInlineTagOk(a1, a2); }
            if (kind == 4) { r = destGuardElidable(a1); }
            if (r >= 0) {
                total = total + 1;
                if (r != exOk) {
                    badc = badc + 1;
                    print("MISMATCH line " + toStr(li + 1) + ": got " + toStr(r) + " want " + toStr(ex) + " [" + line + "]");
                }
            }
        }
        li = li + 1;
    }
    if (badc == 0) {
        print("lower-probe: " + toStr(total) + "/" + toStr(total) + " identical");
        return 0;
    }
    print("lower-probe: " + toStr(badc) + " mismatches of " + toStr(total));
    return 1;
}
