import { p256Hex } from "std/crypto/p256_field";
import { p384Prime, p384Order, p384PrimeBytes, p384OrderBytes, p384Decode, p384Encode, p384Add, p384Sub, p384Mul, p384Inverse, p384Zero } from "std/crypto/p384_field";
import { p384Base, p384Infinity, p384Double, p384PointAdd, p384DecodePoint, p384Affine, p384Joint } from "std/crypto/p384_point";
import { ecdsaP384VerifyDigest, ecdsaP384Sha384Verify, ecdsaP384Sha256Verify } from "std/crypto/ecdsa_p384";

function lines(): List<string> { return strSplit(readFile("tests/vectors/crypto-p384.txt") catch panic("P384 fixture"), "\n"); }
function publicBytes(pointX: Bytes, pointY: Bytes): Bytes { const out = bytesNew(1); bytesSet(out, 0, 4); bytesAppend(out, pointX); bytesAppend(out, pointY); return out; }
function invalidPoint(data: Bytes): bool { p384DecodePoint(p384Prime(), data) catch (e) { return true; }; return false; }
function inverseZero(): bool { const f = p384Prime(); p384Inverse(f, p384Decode(f, bytesNew(48))) catch (e) { return true; }; return false; }

test "P-384: independent prime/order field arithmetic and inverses" {
    let count = 0;
    for (line in lines()) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; } const v = strSplit(line, " "); const tag = listGet(v, 0);
        if (tag != "field" && tag != "inverse") { continue; }
        let f = p384Prime(); if (listGet(v, 1) == "order") { f = p384Order(); }
        const a = p384Decode(f, p256Hex(listGet(v, 2)));
        if (tag == "inverse") { assert(bytesEqual(p384Encode(f, p384Inverse(f, a) catch panic("inverse")), p256Hex(listGet(v, 3))), "independent inverse"); }
        else {
            const b = p384Decode(f, p256Hex(listGet(v, 3)));
            assert(bytesEqual(p384Encode(f, p384Add(f, a, b)), p256Hex(listGet(v, 4))), "add");
            assert(bytesEqual(p384Encode(f, p384Sub(f, a, b)), p256Hex(listGet(v, 5))), "sub");
            assert(bytesEqual(p384Encode(f, p384Mul(f, a, b)), p256Hex(listGet(v, 6))), "mul");
        } count = count + 1;
    }
    assert(count == 22 && inverseZero(), "all arithmetic vectors and zero rejection");
}

test "P-384: independent points, joint multiplication and exceptional points" {
    const f = p384Prime(); const g = p384Base(f); const zero = bytesNew(48); let count = 0;
    for (line in lines()) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; } const v = strSplit(line, " "); const tag = listGet(v, 0);
        if (tag == "point") {
            const expected = p256Hex(listGet(v, 2)); const decoded = p384DecodePoint(f, expected) catch panic("valid point");
            if (listGet(v, 1) == "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52972") {
                assert(p384Zero(p384PointAdd(f, g, decoded).z), "opposite points sum to infinity");
                const one = bytesNew(48); bytesSet(one, 47, 1);
                assert(p384Zero(p384Joint(f, g, one, decoded, one).z), "joint opposite points");
            }
            const a = p384Affine(f, p384Joint(f, g, p256Hex(listGet(v, 1)), g, zero)) catch panic("multiply");
            assert(bytesEqual(publicBytes(a.x, a.y), expected), "independent scalar point"); count = count + 1;
        } else if (tag == "joint") {
            const q = p384DecodePoint(f, p256Hex(listGet(v, 3))) catch panic("q");
            const a = p384Affine(f, p384Joint(f, g, p256Hex(listGet(v, 1)), q, p256Hex(listGet(v, 2)))) catch panic("joint");
            assert(bytesEqual(publicBytes(a.x, a.y), p256Hex(listGet(v, 4))), "independent joint"); count = count + 1;
        }
    }
    assert(count == 4 && p384Zero(p384Joint(f, g, p384OrderBytes(), g, zero).z), "order times G is infinity");
    const same = p384Affine(f, p384PointAdd(f, g, g)) catch panic("add same"); const doubled = p384Affine(f, p384Double(f, g)) catch panic("double");
    assert(bytesEqual(same.x, doubled.x) && bytesEqual(same.y, doubled.y), "equal point branch");
    const identity = p384Affine(f, p384PointAdd(f, p384Infinity(f), g)) catch panic("identity"); const base = p384Affine(f, g) catch panic("base");
    assert(bytesEqual(identity.x, base.x) && bytesEqual(identity.y, base.y), "infinity identity");
    assert(invalidPoint(bytesNew(0)) && invalidPoint(bytesNew(49)) && invalidPoint(bytesNew(97)), "invalid encodings");
    const compressed = publicBytes(base.x, base.y); bytesSet(compressed, 0, 2); assert(invalidPoint(compressed), "unsupported point tag");
    const off = publicBytes(base.x, bytesNew(48)); assert(invalidPoint(off), "off curve");
    assert(invalidPoint(publicBytes(p384PrimeBytes(), base.y)) && invalidPoint(publicBytes(base.x, p384PrimeBytes())), "coordinate range");
}

test "P-384: independent SHA256/SHA384 and truncated digest signatures" {
    let count = 0;
    for (line in lines()) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; } const v = strSplit(line, " "); const tag = listGet(v, 0);
        if (tag == "signature") {
            const key = p256Hex(listGet(v, 2)); const message = p256Hex(listGet(v, 3)); const digest = p256Hex(listGet(v, 4)); const signature = p256Hex(listGet(v, 5));
            if (listGet(v, 1) == "sha384") { assert(ecdsaP384Sha384Verify(key, message, signature) catch panic("sha384"), "SHA384 signature"); }
            else if (listGet(v, 1) == "sha256") { assert(ecdsaP384Sha256Verify(key, message, signature) catch panic("sha256"), "SHA256 signature"); }
            else { assert(ecdsaP384VerifyDigest(key, digest, signature) catch panic("truncated digest"), "SHA512 high 384 bits"); }
            count = count + 1;
        } else if (tag == "digest") {
            assert(ecdsaP384VerifyDigest(p256Hex(listGet(v, 1)), p256Hex(listGet(v, 2)), p256Hex(listGet(v, 3))) catch panic("reduced digest"), "all-ones hash reduced modulo order"); count = count + 1;
        }
    } assert(count == 4, "all independent signatures");
}

test "P-384: malformed DER, scalar bounds, wrong digest and signature" {
    for (line in lines()) {
        if (strFind(line, "signature sha384 ") != 0) { continue; } const v = strSplit(line, " ");
        const key = p256Hex(listGet(v, 2)); const digest = p256Hex(listGet(v, 4)); const signature = p256Hex(listGet(v, 5));
        for (bad in ["3006020100020101", "3006020101020100", "300702020001020101", "3006020180020101", "308106020101020101", "300602010102010100", "3003020101", "3106020101020101"]) {
            assert(!(ecdsaP384VerifyDigest(key, digest, p256Hex(bad)) catch panic("bad DER result")), "strict DER " + bad);
        }
        let i = 0;
        while (i < bytesLen(signature)) { assert(!(ecdsaP384VerifyDigest(key, digest, bytesSlice(signature, 0, i)) catch panic("prefix")), "every truncated prefix"); i = i + 1; }
        const range = p256Hex("3036023100"); bytesAppend(range, p384OrderBytes()); bytesAppend(range, p256Hex("020101"));
        assert(!(ecdsaP384VerifyDigest(key, digest, range) catch panic("range")), "r=n rejected");
        const sRange = p256Hex("3036020101023100"); bytesAppend(sRange, p384OrderBytes());
        assert(!(ecdsaP384VerifyDigest(key, digest, sRange) catch panic("s range")), "s=n rejected");
        const wrong = bytesSlice(digest, 0, bytesLen(digest)); bytesSet(wrong, 0, (bytesGet(wrong, 0) catch 0) ^ 1);
        assert(!(ecdsaP384VerifyDigest(key, wrong, signature) catch panic("wrong digest")), "wrong digest rejected");
        const changed = bytesSlice(signature, 0, bytesLen(signature)); const last = bytesLen(changed) - 1; bytesSet(changed, last, (bytesGet(changed, last) catch 0) ^ 1);
        assert(!(ecdsaP384VerifyDigest(key, digest, changed) catch panic("wrong signature")), "wrong signature rejected"); return;
    } panic("missing negative fixture");
}
