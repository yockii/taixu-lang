import { contentDecode, contentPage, contentHome, contentError, contentShort } from "../examples/browser/content";
import { BrowserPage } from "../examples/browser/fetch";
import { htmlTextContent } from "../examples/browser/html";
import { httpClientReceiver, httpClientFeed, httpClientFinish } from "std/http_client";
import { httpDefaultLimits } from "std/http_wire";
import { p256Hex } from "std/crypto/p256_field";

function raw(text: string): Bytes { if (text == "-") { return bytesNew(0); } return p256Hex(text); }
function badDecode(data: Bytes, charset: string): bool { contentDecode(data, charset) catch (e) { return true; }; return false; }
function response(media: string, data: Bytes, status: int): BrowserPage {
    const receiver = httpClientReceiver("GET", httpDefaultLimits()) catch panic("receiver");
    const wire = bytesFromStr("HTTP/1.1 " + toStr(status) + " Status\r\nContent-Type: " + media + "\r\nContent-Length: " + toStr(bytesLen(data)) + "\r\n\r\n"); bytesAppend(wire, data);
    httpClientFeed(receiver, wire, false) catch panic("feed");
    return BrowserPage { url: "https://example.test/page", response: httpClientFinish(receiver) catch panic("finish"), redirects: 0 };
}
function badMedia(): bool { contentPage(response("image/png", bytesNew(1), 200)) catch (e) { return true; }; return false; }
function decodeCase(): void {
    let count = 0;
    for (line in strSplit(readFile("tests/browser-content-vectors.txt") catch panic("vectors"), "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; } const parts = strSplit(line, " "); let encoding = "utf-8";
        if (listGet(parts, 0) == "western") { encoding = "windows-1252"; }
        assert(bytesEqual(bytesFromStr(contentDecode(raw(listGet(parts, 1)), encoding) catch panic("decode")), raw(listGet(parts, 2))), "independent decoder case " + toStr(count)); count = count + 1;
    } assert(count == 472, "all independent cases");
    assert((contentDecode(p256Hex("efbbbfe4b8ad"), "gbk") catch panic("BOM")) == "中", "UTF8 BOM overrides declaration");
    assert((contentDecode(p256Hex("80"), "us-ascii") catch panic("western alias")) == "€", "western ASCII label");
    assert(badDecode(bytesNew(0), "utf-16") && badDecode(bytesNew(16777217), "utf-8"), "unsupported encoding and input bound");
}
function responseCase(): void {
    const plain = contentPage(response("text/plain; charset=\"WINDOWS-1252\"", p256Hex("3c7363726970743e2680"), 200)) catch panic("plain");
    assert(htmlTextContent(plain.document, 0) == "<script>&€", "plain text is escaped before parsing");
    for (node in plain.document.nodes) { assert(node.tag != "script", "plain text cannot inject an element"); }
    const html = contentPage(response("text/html; charset=utf-8", bytesFromStr("<title>Missing</title><h1>404</h1>"), 404)) catch panic("HTML");
    assert(html.status == 404 && html.title == "Missing" && len(html.error) == 0, "HTTP error status still has a renderable page");
    assert(badMedia(), "unsupported binary content rejected");
}
function errorCase(): void {
    const home = contentHome() catch panic("home"); assert(home.url == "about:home" && home.title == "Taixu Browser", "built in home");
    const error = contentError("https://example.test/<div>", "bad <script>run()</script>&message") catch panic("error");
    assert(error.title == "Navigation failed" && len(error.error) > 0 && error.url == "https://example.test/<div>", "independent error page identity");
    for (node in error.document.nodes) { assert(node.tag != "script" && node.tag != "div", "error details escaped"); }
    assert(contentShort("A中文🙂", 4) == "A中" && contentShort("A中文🙂", 3) == "A" && contentShort("A中文🙂", 0) == "" && contentShort("A", -1) == "", "truncation is on UTF8 boundaries");
}
test "Browser content: independent UTF8 and western decoders" { decodeCase(); }
test "Browser content: HTML, escaped text and HTTP status" { responseCase(); }
test "Browser content: home, safe error page and title bounds" { errorCase(); }
export function main(args: []string): int { decodeCase(); responseCase(); errorCase(); print("browser content: decoding, media and safe errors OK"); return 0; }
