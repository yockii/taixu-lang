// 线程第 3b 步：经接口值带入的平台句柄在发送时核对（线程设计 §十八）。接口值的静态类型看不到具体类型；装入的
// Window 含句柄，（Titled, Window）的装入类型在可发送表里标为 0，threadSpawn 时 trap 4021。
declare type Win;

interface Titled {
    title(): string;
}

struct Window {
    name: string,
    h: Win,
}

function windowTitle(w: Window): string {
    return w.name;
}

function main(args: []string): void {
    const ws: List< Titled> = listNew();
    const w: Titled = Window { name: "main", h: handleFromBits < Win > (7) };
    listPush(ws, w);
    const t = threadSpawn((): int => listLen(ws));
    print(toStr(threadJoin(t) catch -1));
}
