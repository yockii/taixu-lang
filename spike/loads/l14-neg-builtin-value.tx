// l14 负载（V0.26-B1 第四柱扩面）：内建名作值——码 3002。
// work 函数作值（let g = work）不诊断（fnv 形态，sema .func 臂同款）；
// print 内建裸读取 ⇒ 3002"内建 'print' 只能在被调位置使用"，落 ident 位
// （sema .builtin 臂同源；单诊断载荷——g 行零诊断对照内置同一文件）。
function work(n: int): int {
    return n;
}
export function main(args: []string): int {
    let g = work;
    let p = print;
    return 0;
}
