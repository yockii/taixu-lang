                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(fb), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(fb)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(fc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(fc)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(fa), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(fa)); }
                if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_setfld"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_setfld"); }
            }
            if (c.nativeMode == 1) { asProducerLabel(1, mn + "e", c.recordLine); } else { emitFn(c, mn + "e:"); }
        } else if (isGet) {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(fa), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(fa)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(fb), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(fb)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(fc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(fc)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_getfld"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_getfld"); }
        } else {
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(c.fnIdx)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(pc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(pc)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(fb), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r9d, " + toStr(fb)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(fc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 32], " + toStr(fc)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 40, 0, ""), asStructuredImm(fa), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rsp + 40], " + toStr(fa)); }
            if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_setfld"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_setfld"); }
        }
        return;
    }
    if (form == "ret") {
        const a = toInt(listGet(rec, 3) catch "0");
        const rc = toInt(listGet(rec, 4) catch "0");
        if (!retSlotsOk(a, rc, 0, c.regCount)) { addRej(c, c.fnIdx, pc, "E009", "lop_ret_slots"); return; }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 15), asStructuredMem(1, 3, -1, 0, tagOff(a), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r15d, dword ptr [rbx + " + toStr(tagOff(a)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 14), asStructuredMem(2, 3, -1, 0, payloadOff(a), 0, ""), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r14, qword ptr [rbx + " + toStr(payloadOff(a)) + "]"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov rcx, rbx"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(rc), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov edx, " + toStr(rc)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(a), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov r8d, " + toStr(a)); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_frame_release"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  call __tx_frame_release"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(1, 3, -1, 0, 0, 0, ""), asStructuredReg(1, 15), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov dword ptr [rbx], r15d"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "mov", 2, asStructuredMem(2, 3, -1, 0, 8, 0, ""), asStructuredReg(0, 14), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  mov qword ptr [rbx + 8], r14"); }
        if (c.nativeMode == 1) { asProducerInstruction(1, "jmp", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine); } else { emitFn(c, "  jmp .L" + toStr(c.fnIdx) + "_epi"); }
        return;
    }
    if (form == "async_start") {
        // 原生异步（Op 38）：__tx_task_spawn(win, a, nargs, fn, pc)——R[A] 的被调值
        // （fnv/闭包）与实参快照交给新任务（retain），R[A] 改写为 Future。
        const a = toInt(listGet(rec, 3) catch "0");
        const nargs = toInt(listGet(rec, 4) catch "0");
        if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_async_start_text"); return; }
        asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(a), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(nargs), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(pc), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_task_spawn"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        return;
    }
    if (form == "await") {
        // 原生异步（Op 39）：__tx_task_await(win, a, fn, pc) 返回 0＝结果已入 R[A]；
        // 1＝已挂起（本帧值槽已移入任务快照），直接经尾声返回调度器。
        const a = toInt(listGet(rec, 3) catch "0");
        if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_await_text"); return; }
        asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(a), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(pc), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_task_await"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "test", 2, asStructuredReg(1, 0), asStructuredReg(1, 0), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "jne", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        return;
    }
    if (form == "gen_new" || form == "gen_next") {
        // 生成器（D3 v0.22，Op 48/50）：__tx_gen_new(win, a, nargs, fn, pc)——R[A] 的被调值（体函数 fnv）
        // 与实参快照交给新生成器（retain），R[A] 改写为生成器；__tx_gen_next(win, a, b, fn, pc)——在本帧
        // （fn 的槽数）之上开窗运行生成器体，R[A] 得产出值或 None。
        const a = toInt(listGet(rec, 3) catch "0");
        const x = toInt(listGet(rec, 4) catch "0");
        if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_" + form + "_text"); return; }
        asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(a), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(x), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredMem(1, 4, -1, 0, 32, 0, ""), asStructuredImm(pc), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "call", 1, asStructuredTarget("__tx_" + form), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        return;
    }
    if (form == "yield" || form == "gen_close") {
        // __tx_gen_yield(win, a, fn, pc) 返回 0＝恢复后重执行本条、继续；1＝已挂起（本帧值槽已移入生成器
        // 快照），直接经尾声返回取值方。__tx_gen_close(win, a, fn, pc)：关闭生成器，无返回值。
        const a = toInt(listGet(rec, 3) catch "0");
        if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_" + form + "_text"); return; }
        asProducerInstruction(1, "mov", 2, asStructuredReg(0, 1), asStructuredReg(0, 3), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 2), asStructuredImm(a), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 8), asStructuredImm(c.fnIdx), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "mov", 2, asStructuredReg(1, 9), asStructuredImm(pc), asStructuredMissing(), c.recordLine);
        let sym: string = "__tx_gen_close";
        if (form == "yield") { sym = "__tx_gen_yield"; }
        asProducerInstruction(1, "call", 1, asStructuredTarget(sym), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        if (form == "yield") {
            asProducerInstruction(1, "test", 2, asStructuredReg(1, 0), asStructuredReg(1, 0), asStructuredMissing(), c.recordLine);
            asProducerInstruction(1, "jne", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        }
        return;
    }
    if (form == "susp_check") {
        // taskAwaitAny 挂起（内核置线程块的 __tx_task_susp，调度器在任务返回后清零）。
        if (c.nativeMode != 1) { addRej(c, c.fnIdx, pc, "E009", "lop_susp_check_text"); return; }
        tbInto(c, 1, 11);
        asProducerInstruction(1, "cmp", 2, asStructuredMem(2, 11, -1, 0, TB_TASK_SUSP, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine);
        asProducerInstruction(1, "jne", 1, asStructuredTarget(".L" + toStr(c.fnIdx) + "_epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        return;
    }
    addRej(c, c.fnIdx, pc, "E009", "lop_" + form);
}

function addRej(c: Ref<Ctx>, fnIdx: int, pc: int, code: string, detail: string): void {
    listPush(c.rejFn, fnIdx);
    listPush(c.rejPc, pc);
    listPush(c.rejCode, code);
    listPush(c.rejDetail, detail);
}

// run 开窗（run 记录——先吸收挂起标签）
function startRun(c: Ref<Ctx>, len: int, fused: int): void {
    c.runLen = len;
    c.runFused = fused;
    c.runPc = listNew(); c.runLbls = listNew(); c.runKind = listNew(); c.runNuses = listNew();
    c.runU0 = listNew(); c.runT0 = listNew(); c.runU1 = listNew(); c.runT1 = listNew();
    c.runDef = listNew(); c.runOt = listNew(); c.runNt = listNew(); c.runBx = listNew();
    c.runVal = listNew(); c.runFval = listNew(); c.runMsgI = listNew(); c.runMsgL = listNew(); c.runMsg2I = listNew(); c.runMsg2L = listNew(); c.runMsgN = listNew();
    c.runLoaded = listNew(); c.runDefined = listNew();
    c.pendingLiveN = -1;
    c.liveBmp = listNew();
    // 挂起标签（run 首 pc——lbl 记录先于 run 记录到达）移入 run 标签表
    let j0: int = 0;
    while (j0 < listLen(c.pendLbls)) {
        listPush(c.runLbls, iat(c.pendLbls, j0));
        j0 = j0 + 1;
    }
    c.pendLbls = listNew();
    let i: int = 0;
    while (i < c.regCount) {
        listPush(c.runLoaded, 0);
        listPush(c.runDefined, 0);
        i = i + 1;
    }
}

function intFields(rec: List<string>, lo: int, hi: int): bool {
    let i = lo;
    while (i <= hi) {
        if (!isIntText(listGet(rec, i) catch "")) { return false; }
        i = i + 1;
    }
    return true;
}

// 返回类记录（ret、reterr、ret_b、reterr_b、retx）的结果槽与帧释放范围：0 ≤ a < count ≤ 帧的槽数、0 ≤ from ≤ count。
// 帧释放按这些下标直接写值槽窗口；记录由本编译器生成，越界说明前端或记录生成有缺陷，渲染时拒绝（编译期、零运行
// 开销），不在内核的帧释放热路径上查。可移植渲染器共用。
export function retSlotsOk(a: int, count: int, from: int, regCount: int): bool {
    return a >= 0 && a < count && count <= regCount && from >= 0 && from <= count;
}

// 可移植渲染器（selfhost/emit_portable.tx）读同一记录流，形状校验共用这一处。
export function validV2Shape(rec: List<string>): bool {
    const op = listGet(rec, 0) catch "";
    const n = listLen(rec);
    if (op == "emitmirror_v2" || op == "emitmirror_v3" || op == "endf") { return n == 1; }
    if (op == "target") { return n == 2 && (listGet(rec, 1) catch "") != ""; }
    if (op == "frame_pad" || op == "entry" || op == "lbl" || op == "live" || op == "liveslot") {
        return n == 2 && intFields(rec, 1, 1);
    }
    if (op == "esc") { return n >= 9 && intFields(rec, 1, 8) && intFields(rec, 9, n - 1); }
    if (op == "etag") { return n == 2 && intFields(rec, 1, 1); }
    if (op == "sbl") { return n == 10 && intFields(rec, 1, 9); }
    if (op == "fn") { return n == 11 && intFields(rec, 1, 10); }
    if (op == "run") { return n == 4 && intFields(rec, 1, 3); }
    if (op == "op") {
        return n == 11 && (listGet(rec, 2) catch "") != "" && intFields(rec, 1, 1) && intFields(rec, 3, 10);
    }
    if (op == "val") { return n == 2 && intFields(rec, 1, 1); }
    if (op == "fval") { return n == 2 && isDigitText(listGet(rec, 1) catch ""); }
    if (op == "msg") { return n == 3 && intFields(rec, 1, 2); }
    if (op == "rej") { return n == 4 && intFields(rec, 1, 1) && (listGet(rec, 2) catch "") != "" && (listGet(rec, 3) catch "") != ""; }
    if (op == "lop") {
        const form = listGet(rec, 2) catch "";
        if (form == "switch_op") { return true; }
        if (form == "loadk_fnv") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "ldnone") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "dfree") { return n == 4 && intFields(rec, 1, 1) && intFields(rec, 3, 3); }
        if (form == "ldbool") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "band" || form == "bor" || form == "bxor" || form == "imul") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "shl" || form == "shr" || form == "sar") { return n == 8 && intFields(rec, 1, 1) && intFields(rec, 3, 7); }
        if (form == "bnot") { return n == 7 && intFields(rec, 1, 1) && intFields(rec, 3, 6); }
        if (form == "loadk_str") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "callbi") { return (n == 6 || n == 8 || n == 10) && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "clone") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "add") { return n == 15 && intFields(rec, 1, 1) && intFields(rec, 3, 14); }
        if (form == "sub" || form == "mul") { return n == 15 && intFields(rec, 1, 1) && intFields(rec, 3, 14); }
        if (form == "lt" || form == "le" || form == "eq") { return n == 9 && intFields(rec, 1, 1) && intFields(rec, 3, 8); }
        if (form == "div" || form == "mod") { return n == 13 && intFields(rec, 1, 1) && intFields(rec, 3, 12); }
        if (form == "neg" || form == "iserr" || form == "isnone") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "newstruct" || form == "newenum" || form == "newref") { return (n == 5 || n == 7) && intFields(rec, 1, 1) && intFields(rec, 3, 6); }
        if (form == "getidx") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "setidx") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "newarr") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "newslice") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "i2f" || form == "f2i") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "cvt") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "fwop") { return n == 10 && intFields(rec, 1, 1) && intFields(rec, 3, 9); }
        if (form == "reterr") { return n == 4 && intFields(rec, 1, 1) && intFields(rec, 3, 3); }
        if (form == "jcc_u") { return n == 8 && intFields(rec, 1, 1) && intFields(rec, 3, 7); }
        if (form == "not") { return n == 7 && intFields(rec, 1, 1) && intFields(rec, 3, 6); }
        if (form == "iserr" || form == "isnone") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "getfld" || form == "setfld" || form == "getfldb") { return n == 9 && intFields(rec, 1, 1) && intFields(rec, 3, 8); }
        if (form == "call_direct") { return n == 9 && intFields(rec, 1, 1) && intFields(rec, 3, 8); }
        if (form == "call_direct_b") { return n == 10 && intFields(rec, 1, 1) && intFields(rec, 3, 9); }
        if (form == "moveb" || form == "movet") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "bclear") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "ret_b") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "retx") { return n == 8 && intFields(rec, 1, 1) && intFields(rec, 3, 7); }
        if (form == "reterr_b") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "call_indirect") { return n == 12 && intFields(rec, 1, 1) && intFields(rec, 3, 11); }
        if (form == "jmp") { return n == 4 && intFields(rec, 1, 1) && intFields(rec, 3, 3); }
        if (form == "move") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "moverl") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "moverc") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "jcc") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "loadk_int") { return n == 6 && intFields(rec, 1, 1) && intFields(rec, 3, 5); }
        if (form == "loadk_float") { return n == 7 && intFields(rec, 1, 1) && intFields(rec, 3, 6); }
        if (form == "ret") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "async_start") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "await") { return n == 4 && intFields(rec, 1, 1) && intFields(rec, 3, 3); }
        if (form == "susp_check") { return n == 3 && intFields(rec, 1, 1); }
        if (form == "gen_new" || form == "gen_next") { return n == 5 && intFields(rec, 1, 1) && intFields(rec, 3, 4); }
        if (form == "yield" || form == "gen_close") { return n == 4 && intFields(rec, 1, 1) && intFields(rec, 3, 3); }
        return n >= 3 && intFields(rec, 1, 1);
    }
    if (op == "resume") { return n == 3 && intFields(rec, 1, 2); }
    return false;
}

// v2 记录分派
function dispatchV2(c: Ref<Ctx>, rec: List<string>): void {
    const op = listGet(rec, 0) catch "";
    c.acceptPayload = 0;
    if (c.pendingPayload != "") {
        if (op == c.pendingPayload) {
            c.acceptPayload = 1;
            // msg 多重性（D96 v0.3 §一 1a）：div_i 恒两条 msg——首条（处理前
            // runMsgN==0）到达后保 pending 待第二条；第二条（runMsgN==1）闭合。
            let keepPending: bool = false;
            if (op == "msg") {
                const n = listLen(c.runMsgI);
                if (n > 0 && sat(c.runKind, n - 1) == "div_i" && iat(c.runMsgN, n - 1) == 0) {
                    keepPending = true;
                }
            }
            if (!keepPending) { c.pendingPayload = ""; }
        } else {
            addRej(c, c.fnIdx, 0, "E009", "missing_" + c.pendingPayload);
            c.pendingPayload = "";
        }
    }
    if ((op == "val" || op == "msg" || op == "fval") && c.acceptPayload == 0) {
        addRej(c, c.fnIdx, 0, "E009", "unexpected_" + op);
        return;
    }
    if (!validV2Shape(rec)) {
        addRej(c, c.fnIdx, 0, "E009", "record_shape_" + op);
        return;
    }
    if (op == "esc") {
        // D59 esc 站点事实（§9.4）：esc idx kind dest units scalar bufOff
        // bufLen nTags＋etag* 变长尾——帧站点全量（buf_len>0 已记录侧过滤）。
        const si = toInt(listGet(rec, 1) catch "0");
        while (listLen(c.escSiteIdx) <= si) {
            listPush(c.escSiteIdx, -1);
            listPush(c.escKind, 0);
            listPush(c.escUnits, 0);
            listPush(c.escScalar, 0);
            listPush(c.escBuf, 0);
            listPush(c.escNTags, 0);
            listPush(c.escTagFirst, 0);
        }
        listSet(c.escSiteIdx, si, si);
        listSet(c.escKind, si, toInt(listGet(rec, 2) catch "0"));
        listSet(c.escUnits, si, toInt(listGet(rec, 4) catch "0"));
        listSet(c.escScalar, si, toInt(listGet(rec, 5) catch "0"));
        listSet(c.escBuf, si, 56 + toInt(listGet(rec, 6) catch "0"));
        listSet(c.escNTags, si, toInt(listGet(rec, 8) catch "0"));
        listSet(c.escTagFirst, si, listLen(c.escTagFlat));
        return;
    }
    if (op == "sbl") {
        const sbi = toInt(listGet(rec, 1) catch "0");
        while (listLen(c.sblIdx) <= sbi) {
            listPush(c.sblIdx, -1);
            listPush(c.sblHeader, 0);
            listPush(c.sblCond, 0);
            listPush(c.sblExit, 0);
            listPush(c.sblAdd, 0);
            listPush(c.sblRoot, 0);
            listPush(c.sblBSlot, 0);
            listPush(c.sblPrepend, 0);
            listPush(c.sblBase, 0);
        }
        listSet(c.sblIdx, sbi, sbi);
        listSet(c.sblHeader, sbi, toInt(listGet(rec, 2) catch "0"));
        listSet(c.sblCond, sbi, toInt(listGet(rec, 3) catch "0"));
        listSet(c.sblExit, sbi, toInt(listGet(rec, 4) catch "0"));
        listSet(c.sblAdd, sbi, toInt(listGet(rec, 5) catch "0"));
        listSet(c.sblRoot, sbi, toInt(listGet(rec, 6) catch "0"));
        listSet(c.sblBSlot, sbi, toInt(listGet(rec, 7) catch "0"));
        listSet(c.sblPrepend, sbi, toInt(listGet(rec, 8) catch "0"));
        listSet(c.sblBase, sbi, toInt(listGet(rec, 9) catch "0"));
        return;
    }
    if (op == "etag") {
        listPush(c.escTagFlat, toInt(listGet(rec, 1) catch "0"));
        return;
    }
    if (op == "emitmirror_v2") { c.ver = 2; emRecV3 = 0; return; }
    if (op == "emitmirror_v3") { c.ver = 2; emRecV3 = 1; return; }
    if (op == "target") {
        c.target = listGet(rec, 1) catch "";
        if (c.target != "win64" && c.target != "x64_window") { addRej(c, 0, 0, "E011", "target_" + c.target); }
        return;
    }
    if (op == "frame_pad") { c.framePad = toInt(listGet(rec, 1) catch "0"); return; }
    if (op == "entry") { c.entry = toInt(listGet(rec, 1) catch "0"); return; }
    if (op == "fn") {
        if (c.hasFn == 1) { addRej(c, c.fnIdx, 0, "E009", "nested_fn"); return; }
        c.hasFn = 1;
        c.sawFn = 1;
        c.fnIdx = toInt(listGet(rec, 1) catch "0");
        c.regCount = toInt(listGet(rec, 2) catch "0");
        // 第 3 域原为 need_pin（钉驻与 E007 已删除），恒 0，不读。
        c.padEsc = toInt(listGet(rec, 4) catch "0");
        c.padCache = toInt(listGet(rec, 5) catch "0");
        c.padStrbld = toInt(listGet(rec, 6) catch "0");
        c.padVh = toInt(listGet(rec, 7) catch "0");
        c.isaGuard = toInt(listGet(rec, 8) catch "0");
        c.irActive = toInt(listGet(rec, 9) catch "0");
        c.escSiteIdx = listNew();
        c.escKind = listNew();
        c.escUnits = listNew();
        c.escScalar = listNew();
        c.escBuf = listNew();
        c.escNTags = listNew();
        c.escTagFirst = listNew();
        c.escTagFlat = listNew();
        c.sblIdx = listNew();
        c.sblHeader = listNew();
        c.sblCond = listNew();
        c.sblExit = listNew();
        c.sblAdd = listNew();
        c.sblRoot = listNew();
        c.sblBSlot = listNew();
        c.sblPrepend = listNew();
        c.sblBase = listNew();
        c.resumePcs = listNew();
        c.resumeLand = listNew();
        c.r12r13 = toInt(listGet(rec, 10) catch "0");
        c.frameTotal = c.framePad + c.padEsc + c.padCache + c.padStrbld + c.padVh;
        c.planHighGp = 0;
        c.fnParts = listNew();
        if (c.nativeMode == 1) { asProducerBeginFunction(); }
        if (c.listing) { asListingSelect(c.fnIdx); }
        c.runLen = 0;
        if (c.isaGuard == 1) { addRej(c, c.fnIdx, 0, "E008", "isa_guard"); }
        // E005 esc_pad 拒绝退役（D59 esc 面 §9.4——站点事实随 esc/etag 记
        // 录，帧直访/_fr 臂按面渲染）；E005 cache/strbld 与 E006 维持。
        if (c.padCache > 0) { addRej(c, c.fnIdx, 0, "E005", "cache_pad"); }
        // E005 strbld_pad 拒绝退役（§9.5 strbld 面——环事实随 sbl 记录，
        // 镜像按环渲染快路臂/出口重定向/物化垫）。
        if (c.padVh > 0) { addRej(c, c.fnIdx, 0, "E005", "vh_pad"); }
        return;
    }
    if (op == "lbl") {
        const lpc = toInt(listGet(rec, 1) catch "0");
        if (c.runLen > 0) {
            // run 缓冲中——标签随 run 渲染（交错在对应 op 前）
            listPush(c.runLbls, lpc);
        } else {
            listPush(c.pendLbls, lpc);
        }
        return;
    }
    if (op == "run") {
        const runSize = toInt(listGet(rec, 1) catch "0");
        const fused = toInt(listGet(rec, 2) catch "0");
        if (c.hasFn == 0 || c.runLen > 0 || runSize < 0 || (fused != 0 && fused != 1)) {
            addRej(c, c.fnIdx, 0, "E009", "run_state");
            return;
        }
        startRun(c, runSize, fused);
        return;
    }
    if (op == "op") {
        const kind = listGet(rec, 2) catch "";
        if (c.hasFn == 0 || c.runLen <= 0 || listLen(c.runPc) >= c.runLen) {
            addRej(c, c.fnIdx, toInt(listGet(rec, 1) catch "0"), "E009", "op_state");
            return;
        }
        // kind 白名单（D96 v0.3 §一 1a——25 kind＝批一 19＋值形批 5＋A9 增补
        // ldnone；越集 E001）
        if (kind != "move" && kind != "loadk_int" && kind != "add_i" && kind != "sub_i" && kind != "mul_i"
            && kind != "lt_i" && kind != "le_i" && kind != "eq_i" && kind != "eq_b"
            && kind != "lt_f" && kind != "le_f" && kind != "eq_f"
            && kind != "jf_b" && kind != "jt_b"
            && kind != "add_f" && kind != "sub_f" && kind != "mul_f" && kind != "i2f_f"
            && kind != "loadk_float"
            && kind != "div_i" && kind != "mod_i" && kind != "neg_i" && kind != "not_b" && kind != "ldbool"
            && kind != "ldnone" && kind != "neg_f") {
            addRej(c, c.fnIdx, toInt(listGet(rec, 1) catch "0"), "E001", kind);
            return;
        }
        let nu: int = 0;
        if (kind == "move" || kind == "i2f_f" || kind == "jf_b" || kind == "jt_b"
            || kind == "neg_i" || kind == "not_b" || kind == "neg_f") { nu = 1; }
        if (kind == "add_i" || kind == "sub_i" || kind == "mul_i"
            || kind == "lt_i" || kind == "le_i" || kind == "eq_i" || kind == "eq_b"
            || kind == "lt_f" || kind == "le_f" || kind == "eq_f"
            || kind == "add_f" || kind == "sub_f" || kind == "mul_f"
            || kind == "div_i" || kind == "mod_i") { nu = 2; }
        listPush(c.runPc, toInt(listGet(rec, 1) catch "0"));
        listPush(c.runKind, kind);
        listPush(c.runNuses, nu);
        listPush(c.runU0, toInt(listGet(rec, 3) catch "0"));
        listPush(c.runT0, toInt(listGet(rec, 4) catch "0"));
        listPush(c.runU1, toInt(listGet(rec, 5) catch "0"));
        listPush(c.runT1, toInt(listGet(rec, 6) catch "0"));
        listPush(c.runDef, toInt(listGet(rec, 7) catch "0"));
        listPush(c.runOt, toInt(listGet(rec, 8) catch "0"));
        listPush(c.runNt, toInt(listGet(rec, 9) catch "0"));
        listPush(c.runBx, toInt(listGet(rec, 10) catch "0"));
        listPush(c.runVal, 0);
        listPush(c.runFval, "");
        listPush(c.runMsgI, 0);
        listPush(c.runMsgL, 0);
        listPush(c.runMsg2I, 0);
        listPush(c.runMsg2L, 0);
        listPush(c.runMsgN, 0);
        if (kind == "loadk_int") { c.pendingPayload = "val"; }
        if (kind == "loadk_float") { c.pendingPayload = "fval"; }
        if (kind == "add_i" || kind == "sub_i" || kind == "mul_i" || kind == "neg_i") { c.pendingPayload = "msg"; }
        if (kind == "div_i" || kind == "mod_i") { c.pendingPayload = "msg"; }
        return;
    }
    if (op == "val") {
        const n = listLen(c.runVal);
        if (n > 0) { listSet(c.runVal, n - 1, toInt(listGet(rec, 1) catch "0")); }
        return;
    }
    if (op == "fval") {
        const n = listLen(c.runFval);
        if (n > 0) { listSet(c.runFval, n - 1, listGet(rec, 1) catch ""); }
        return;
    }
    if (op == "msg") {
        // msg 多重性（D96 v0.3 §一 1a）：div_i 恒两条〔序＝tdz 除零→tov 溢出〕、
        // mod_i 恰一条；其余带 msg kind 恰一条。越形＝E009 msg_mult。
        const n = listLen(c.runMsgI);
        if (n > 0) {
            const cnt = iat(c.runMsgN, n - 1);
            const kind = sat(c.runKind, n - 1);
            if (cnt == 0) {
                listSet(c.runMsgI, n - 1, toInt(listGet(rec, 1) catch "0"));
                listSet(c.runMsgL, n - 1, toInt(listGet(rec, 2) catch "0"));
                listSet(c.runMsgN, n - 1, 1);
            } else if (cnt == 1 && kind == "div_i") {
                listSet(c.runMsg2I, n - 1, toInt(listGet(rec, 1) catch "0"));
                listSet(c.runMsg2L, n - 1, toInt(listGet(rec, 2) catch "0"));
                listSet(c.runMsgN, n - 1, 2);
            } else {
                addRej(c, c.fnIdx, iat(c.runPc, n - 1), "E009", "msg_mult");
            }
        }
        return;
    }
    if (op == "live") {
        c.pendingLiveN = toInt(listGet(rec, 1) catch "0");
        if (c.hasFn == 0 || c.runLen <= 0 || listLen(c.runPc) != c.runLen || c.pendingLiveN < 0 || c.pendingLiveN > c.regCount) {
            addRej(c, c.fnIdx, 0, "E009", "live_shape");
            return;
        }
        c.liveBmp = listNew();
        let i: int = 0;
        while (i < c.regCount) { listPush(c.liveBmp, 0); i = i + 1; }
        if (c.pendingLiveN == 0) { renderRun2(c); c.runLen = 0; }
        return;
    }
    if (op == "liveslot") {
        const slot = toInt(listGet(rec, 1) catch "0");
        if (c.pendingLiveN <= 0 || slot < 0 || slot >= listLen(c.liveBmp) || iat(c.liveBmp, slot) != 0) {
            addRej(c, c.fnIdx, 0, "E009", "liveslot_shape");
            return;
        }
        listSet(c.liveBmp, slot, 1);
        // 计数面＝live 记录的 n（位图已全量预填——n 个 liveslot 收齐即收口）
        c.pendingLiveN = c.pendingLiveN - 1;
        if (c.pendingLiveN == 0) {
            renderRun2(c);
            c.runLen = 0;
        }
        return;
    }
    if (op == "lop") {
        renderLop2(c, rec);
        return;
    }
    if (op == "rej") {
        addRej(c, c.fnIdx, toInt(listGet(rec, 1) catch "0"), listGet(rec, 2) catch "E009", listGet(rec, 3) catch "recorded");
        return;
    }
    if (op == "endf") {
        if (c.hasFn == 0 || c.runLen > 0 || c.pendingPayload != "") {
            addRej(c, c.fnIdx, 0, "E009", "endf_state");
            return;
        }
        // 函数装配：prologue（r12/r13＝plan 高位 GP 占用）＋体＋epilogue
        // r12/r13 保存判据（D96 v0.4 §9.3——A6 接线后字节恒等面）：记录端
        // buildFnIr+planRun 扫描事实（6c 同源）为主判据；镜像本地 planHighGp
        // 推导退役（两套运行系分歧根除——值形批执行发现）。
        const r12r13 = c.r12r13 == 1;
        if (c.nativeMode == 1) { asProducerFunctionBegin(c.fnIdx, c.recordLine); } else { emitLn(c, "f_" + toStr(c.fnIdx) + ":"); }
        if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 5, 8, c.recordLine); } else { emitLn(c, "  push rbp"); }
        if (c.nativeMode == 1) { asProducerFrame("set-frame-pointer", 5, 0, c.recordLine); } else { emitLn(c, "  mov rbp, rsp"); }
        if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 3, 8, c.recordLine); } else { emitLn(c, "  push rbx"); }
        if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 14, 8, c.recordLine); } else { emitLn(c, "  push r14"); }
        if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 15, 8, c.recordLine); } else { emitLn(c, "  push r15"); }
        if (r12r13) {
            if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 12, 8, c.recordLine); } else { emitLn(c, "  push r12"); }
            if (c.nativeMode == 1) { asProducerFrame("push-nonvolatile", 13, 8, c.recordLine); } else { emitLn(c, "  push r13"); }
        }
        if (c.nativeMode == 1) { asProducerFrame("allocate-stack", 4, c.frameTotal, c.recordLine); } else { emitLn(c, "  sub rsp, " + toStr(c.frameTotal)); }
        if (c.nativeMode == 1) { asProducerFunctionPrologueEnd(); }
        // builder 状态惰性标志清零（emit_gen emitFunction 同款——每函数入口一次）。
        let sbz: int = 0;
        while (sbz < listLen(c.sblIdx)) {
            if (iat(c.sblIdx, sbz) == sbz) {
                // 执行发现 A11：每环槽跨步＝sbi·state_bytes(48)——emit_gen
                // prologue/垫/臂三处同源（单环 fixture 曾掩蔽）。
                if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredMem(1, 4, -1, 0, iat(c.sblBase, sbz) + sbz * 48 + 24, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov dword ptr [rsp + " + toStr(iat(c.sblBase, sbz) + sbz * 48 + 24) + "], 0"); }
            }
            sbz = sbz + 1;
        }
        // builder 状态惰性标志清零（emit_gen emitFunction 同款——每函数入口一次）。
        if (c.nativeMode == 1) { asProducerInstruction(0, "mov", 2, asStructuredReg(0, 3), asStructuredReg(0, 1), asStructuredMissing(), c.recordLine); } else { emitLn(c, "  mov rbx, rcx"); }
        const hasResume = listLen(c.resumePcs) > 0;
        let fl: string = "";
        if (hasResume) {
            fl = ".L" + toStr(c.fnIdx) + "_";
            // 原生异步恢复入口：调度器恢复挂起任务时把 __tx_task_resume 置为挂起点
            // pc+1 再调用本函数；入口取走并清零，跳回挂起点重新执行（其余调用恒为 0）。
            // 取消挂起中的任务时内核另置位 2^30：有落点跳落点（执行已登记的 defer 后
            // 正常返回），无落点直接返回（槽区由内核释放）。
            tbInto(c, 0, 0);
            asProducerInstruction(0, "mov", 2, asStructuredReg(1, 0), asStructuredMem(1, 0, -1, 0, TB_TASK_RESUME, 0, ""), asStructuredMissing(), c.recordLine);
            asProducerInstruction(0, "test", 2, asStructuredReg(1, 0), asStructuredReg(1, 0), asStructuredMissing(), c.recordLine);
            asProducerInstruction(0, "jne", 1, asStructuredTarget(fl + "resume"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        }
        if (c.nativeMode == 1) { asProducerSubmitBody(); }
        else {
            let i: int = 0;
            const n = listLen(c.fnParts);
            while (i < n) {
                // fnParts 行已带行尾换行（emitFn）——直接入 parts，禁二次加换行
                listPush(c.parts, listGet(c.fnParts, i) catch "");
                i = i + 1;
            }
        }
        if (hasResume) {
            asProducerInstruction(0, "jmp", 1, asStructuredTarget(fl + "epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
            asProducerLabel(0, fl + "resume", c.recordLine);
            tbInto(c, 0, 11);
            asProducerInstruction(0, "mov", 2, asStructuredMem(1, 11, -1, 0, TB_TASK_RESUME, 0, ""), asStructuredImm(0), asStructuredMissing(), c.recordLine);
            let ri: int = 0;
            while (ri < listLen(c.resumePcs)) {
                asProducerInstruction(0, "cmp", 2, asStructuredReg(1, 0), asStructuredImm(iat(c.resumePcs, ri) + 1), asStructuredMissing(), c.recordLine);
                asProducerInstruction(0, "je", 1, asStructuredTarget(fl + toStr(iat(c.resumePcs, ri))), asStructuredMissing(), asStructuredMissing(), c.recordLine);
                ri = ri + 1;
            }
            ri = 0;
            while (ri < listLen(c.resumeLand)) {
                if (iat(c.resumeLand, ri) >= 0) {
                    asProducerInstruction(0, "cmp", 2, asStructuredReg(1, 0), asStructuredImm(iat(c.resumePcs, ri) + 1 + 1073741824), asStructuredMissing(), c.recordLine);
                    asProducerInstruction(0, "je", 1, asStructuredTarget(fl + toStr(iat(c.resumeLand, ri))), asStructuredMissing(), asStructuredMissing(), c.recordLine);
                }
                ri = ri + 1;
            }
            asProducerInstruction(0, "cmp", 2, asStructuredReg(1, 0), asStructuredImm(1073741824), asStructuredMissing(), c.recordLine);
            asProducerInstruction(0, "jae", 1, asStructuredTarget(fl + "epi"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
            asProducerInstruction(0, "call", 1, asStructuredTarget("__tx_task_bad_resume"), asStructuredMissing(), asStructuredMissing(), c.recordLine);
        }
        if (c.nativeMode == 1) { asProducerLabel(0, ".L" + toStr(c.fnIdx) + "_epi", c.recordLine); } else { emitLn(c, ".L" + toStr(c.fnIdx) + "_epi:"); }
        if (c.nativeMode == 1) { asProducerFunctionEpilogueStart(); }
        if (c.nativeMode == 1) { asProducerFrame("release-stack", 4, c.frameTotal, c.recordLine); } else { emitLn(c, "  add rsp, " + toStr(c.frameTotal)); }
        if (r12r13) {
            if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 13, 8, c.recordLine); } else { emitLn(c, "  pop r13"); }
            if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 12, 8, c.recordLine); } else { emitLn(c, "  pop r12"); }
        }
        if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 15, 8, c.recordLine); } else { emitLn(c, "  pop r15"); }
        if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 14, 8, c.recordLine); } else { emitLn(c, "  pop r14"); }
        if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 3, 8, c.recordLine); } else { emitLn(c, "  pop rbx"); }
        if (c.nativeMode == 1) { asProducerFrame("pop-nonvolatile", 5, 8, c.recordLine); } else { emitLn(c, "  pop rbp"); }
        if (c.nativeMode == 1) { asProducerFrame("return", -1, 8, c.recordLine); } else { emitLn(c, "  ret"); }
        if (c.nativeMode == 1) { asProducerFunctionEnd(); }
        c.hasFn = 0;
        return;
    }
    if (op == "resume") {
        if (c.hasFn == 0 || c.nativeMode != 1) { addRej(c, c.fnIdx, 0, "E009", "resume_state"); return; }
        listPush(c.resumePcs, toInt(listGet(rec, 1) catch "0"));
        listPush(c.resumeLand, toInt(listGet(rec, 2) catch "-1"));
        return;
    }
    addRej(c, c.fnIdx, 0, "E009", "rec_" + op);
}

// finish 分治拼接（semamirror 同例）
function joinRange(parts: List<string>, lo: int, hi: int): string {
    if (hi - lo <= 0) { return ""; }
    if (hi - lo == 1) { return listGet(parts, lo) catch ""; }
    const mid = lo + (hi - lo) / 2;
    return joinRange(parts, lo, mid) + joinRange(parts, mid, hi);
}

// —— 库化面（V0.50-S5-③ 批 E 尾；D102 §一——emitmirror 柱三库化）：
// emitRecords 吃 EMITMIRROR v1/v2 记录流文本，渲染 .s 存模块态（emSOut）。
// 发射面零改动；main 委托本函数（文件 IO 留在 main＝执行形态不变）。
let emNativeMode: int = 0;
let emListingMode: bool = false;
export function emSetListing(on: bool): void { emListingMode = on; }
let emS: string = "";
let emOk: int = 0;
let emDiag: string = "";
export function emDiagOut(): string { return emDiag; }
function emitReject(message: string): void {
    emDiag = emDiag + message + "\n";
    if (emNativeMode == 0) { print(message); }
}

// 一次只持有当前记录的字段；dispatch把后续需要的事实存入Ctx。
// strSplit仍使用原生通用分隔原语，空字段在原列表内压紧，免第二份列表。
function recordFields(line: string): List<string> {
    const ln = len(line);
    let body = line;
    if (ln > 0 && (byteAt(line, ln - 1) catch 10) == 13) { body = strSub(line, 0, ln - 1); }
    if (len(body) == 0 || (byteAt(body, 0) catch 35) == 35) { return listNew(); }
    const rec = strSplit(body, " ");
    let read = 0;
    let write = 0;
    while (read < listLen(rec)) {
        const token = listGet(rec, read) catch "";
        if (len(token) > 0) {
            if (read != write) { listSet(rec, write, token); }
            write = write + 1;
        }
        read = read + 1;
    }
    while (listLen(rec) > write) { listRemoveAt(rec, listLen(rec) - 1); }
    return rec;
}

export function emitRecords(text: string): int {
    emOk = 0;
    emS = "";
    emDiag = "";
    if (!valueAbiCompatible()) {
        emitReject("VALUE-ABI-REJECT incompatible revision1 layout");
        return 1;
    }
    const c = begin("@lib");
    c.ver = 1;
    emRecV3 = 0;
    let first = 1;
    let sawFn = false;
    const lines = strSplit(text, "\n");
    let li = 0;
    while (li < listLen(lines)) {
        const rec = recordFields(listGet(lines, li) catch "");
        // 原始行已消费；Ctx只保留真正跨记录使用的字段。
        listSet(lines, li, "");
        li = li + 1;
        c.recordLine = li;
        if (c.listing) { c.recordLine = 1; }
        if (listLen(rec) == 0) { continue; }
        const op = listGet(rec, 0) catch "";
        if (first == 1) {
            if (op == "emitmirror_v2") { c.ver = 2; }
            if (op == "emitmirror_v3") { c.ver = 2; emRecV3 = 1; }
            first = 0;
        }
        if (c.ver == 2) { dispatchV2(c, rec); }
        else {
            if (op == "begin_fn") { sawFn = true; }
            const r = dispatch(c, rec);
            if (r == 1) {
                emitReject("emitmirror: emitData 数据段在切片面外——结构化拒绝（BOOT-31 切片阶段；禁静默回退）");
                return 1;
            }
            if (r == 3) { return 1; }
        }
    }
    if (c.ver == 2) {
        if (c.pendingPayload != "") { addRej(c, c.fnIdx, 0, "E009", "missing_" + c.pendingPayload); }
        if (c.runLen > 0) { addRej(c, c.fnIdx, 0, "E009", "missing_live"); }
        if (c.hasFn == 1) { addRej(c, c.fnIdx, 0, "E009", "missing_endf"); }
        if (listLen(c.rejCode) > 0) {
            let j = 0;
            while (j < listLen(c.rejCode)) {
                emitReject("EMITMIRROR-REJECT " + sat(c.rejCode, j) + " fn=" + toStr(iat(c.rejFn, j)) + " pc=" + toStr(iat(c.rejPc, j)) + " " + sat(c.rejDetail, j));
                j = j + 1;
            }
            return 1;
        }
        if (c.sawFn == 0) {
            emitReject("EMITMIRROR-REJECT E010 fn=0 pc=0 no_fn_records");
            return 1;
        }
    } else if (!sawFn) {
        emitReject("emitmirror: 记录流无 begin_fn（空切片）——结构化拒绝");
        return 1;
    }
    if (c.nativeMode == 0) { emS = joinRange(c.parts, 0, listLen(c.parts)); }
    emOk = 1;
    return 0;
}

export function emSOut(): string { return emS; }
export function emReady(): int { return emOk; }

export function main(args: []string): int {
    if (len(args) < 2) {
        print("emitmirror: 用法 taixu run bootstrap/emitmirror.tx <记录流> <out.s>（v1 EMITDUMP／v2 EMITMIRROR 首标记自动判别）");
        return 64;
    }
    const text = readFile(args[0]) catch (e) {
        print("emitmirror: 读入失败: " + e.message);
        return 1;
    };
    if (emitRecords(text) != 0) { return 1; }
    writeFile(args[1], emSOut()) catch (e) {
        print("emitmirror: 写出失败: " + e.message);
        return 1;
    };
    return 0;
}

export function emitNativeRecords(text: string): int {
    emNativeMode = 1;
    const result = emitRecords(text);
    emNativeMode = 0;
    return result;
}
