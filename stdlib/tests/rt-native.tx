// ============================================================================
// stdlib 用例：进程级的环境变量与套接字句柄（核心仓线程设计 §十六，2c）。只由原生编译器运行（verify ⑧；
// threadSpawn 仅原生）：线程能看到 main 的 setenv、main 能看到线程的 setenv；线程能使用 main 打开的
// 套接字；关闭后槽位复用时新句柄与旧句柄不同，旧句柄失效。
// 运行：taixu test tests/rt-native.tx（原生编译器）
// ============================================================================

import { getenv, setenv } from "std/os";
import { tcpListen, tcpAccept, tcpConnect, tcpSend, tcpRecv, tcpClose } from "std/net";
import { parseInt } from "std/strconv";

function envThread(): int {
    if (getenv("TX_RT_NATIVE_A") != "main") {
        return 1;
    }
    setenv("TX_RT_NATIVE_B", "thread") catch panic("线程里 setenv 失败");
    return 0;
}

test "os：环境变量是进程级的（跨线程可见）" {
    setenv("TX_RT_NATIVE_A", "main") catch panic("setenv 失败");
    const t = threadSpawn(envThread);
    const r = threadJoin(t) catch -1;
    assert(r == 0, "线程读到 main 设置的值");
    assert(getenv("TX_RT_NATIVE_B") == "thread", "main 读到线程设置的值");
}

test "os：环境表反复改写与扩张" {
    let i: int = 0;
    let v: string = "";
    while (i < 2000) {
        v = v + "x";
        setenv("TX_RT_NATIVE_GROW", v) catch panic("改写失败");
        i = i + 1;
    }
    assert(len(getenv("TX_RT_NATIVE_GROW")) == 2000, "改写 2000 次后取最后一次的值");
    i = 0;
    while (i < 300) {
        setenv("TX_RT_NATIVE_K" + toStr(i), toStr(i * 7)) catch panic("新增失败");
        i = i + 1;
    }
    i = 0;
    let ok: bool = true;
    while (i < 300) {
        if (getenv("TX_RT_NATIVE_K" + toStr(i)) != toStr(i * 7)) {
            ok = false;
        }
        i = i + 1;
    }
    assert(ok, "300 个变量逐个回读");
    let bad: bool = false;
    setenv("A=B", "x") catch (e) {
        bad = true;
    };
    assert(bad, "名字含 = 时 setenv 为 Error");
    assert(getenv("A=B") == "", "名字含 = 时 getenv 为空串");
    setenv("TX_RT_NATIVE_EMPTY", "") catch panic("空值失败");
    assert(getenv("TX_RT_NATIVE_EMPTY") == "", "空值回读");
}

function listenLoopback(): int {
    let port: int = 47160;
    let attempt: int = 0;
    while (attempt < 8) {
        const l = tcpListen(port) catch -1;
        if (l >= 0) {
            setenv("TX_RT_NATIVE_PORT", toStr(port)) catch panic("setenv 失败");
            return l;
        }
        port = port + 1;
        attempt = attempt + 1;
    }
    return -1;
}

function netThread(): int {
    const c = parseInt(getenv("TX_RT_NATIVE_CONN")) catch -1;
    const n = tcpSend(c, "ping") catch -1;
    if (n != 4) {
        return 1;
    }
    tcpClose(c);
    return 0;
}

test "net：套接字句柄是进程级的（线程里使用 main 打开的连接）" {
    const listener = listenLoopback();
    assert(listener >= 0, "loopback 监听建立");
    const port = parseInt(getenv("TX_RT_NATIVE_PORT")) catch -1;
    const c = tcpConnect("127.0.0.1", port) catch panic("connect 失败");
    const s = tcpAccept(listener) catch panic("accept 失败");
    setenv("TX_RT_NATIVE_CONN", toStr(c)) catch panic("setenv 失败");
    const t = threadSpawn(netThread);
    const r = threadJoin(t) catch -1;
    assert(r == 0, "线程经 main 的句柄发送并关闭");
    assert((tcpRecv(s, 64) catch "ERR") == "ping", "main 收到线程发出的数据");
    assert((tcpSend(c, "x") catch -1) == -1, "线程关闭后 main 手里的旧句柄失效");
    tcpClose(s);
    tcpClose(listener);
}

test "net：槽位复用时新句柄与旧句柄不同" {
    const listener = listenLoopback();
    assert(listener >= 0, "loopback 监听建立");
    const port = parseInt(getenv("TX_RT_NATIVE_PORT")) catch -1;
    const c1 = tcpConnect("127.0.0.1", port) catch panic("connect 1 失败");
    const s1 = tcpAccept(listener) catch panic("accept 1 失败");
    tcpClose(c1);
    const c2 = tcpConnect("127.0.0.1", port) catch panic("connect 2 失败");
    assert(c2 != c1, "关闭后再建的连接拿到新句柄");
    assert((tcpSend(c1, "x") catch -1) == -1, "旧句柄失效");
    assert((tcpSend(c2, "ok") catch -1) == 2, "新句柄可用");
    const s2 = tcpAccept(listener) catch panic("accept 2 失败");
    assert((tcpRecv(s2, 64) catch "ERR") == "ok", "新连接的数据");
    tcpClose(c2);
    tcpClose(s1);
    tcpClose(s2);
    tcpClose(listener);
}
