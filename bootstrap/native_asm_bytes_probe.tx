// Byte-buffer lifetime, decimal fallback rollback and linker-copy ownership.
import { assembleText, asStructuredBegin, asStructuredSection, asStructuredLabel,
    asStructuredInstruction, asStructuredReg, asStructuredMem, asStructuredMissing,
    asStructuredByte, asStructuredAddress, asStructuredZero, asResolveLocalFixups,
    asImgText, asImgRdata, asImgData, asImgBssSize, asFailedAs, asLastErrAs } from "./selfhost/assemble";
import { linkExe, exeBytesList, lkGetMissing } from "./selfhost/link_pe";
import { linkElfImage, elfBytesOut, elfLastError } from "./selfhost/link_elf";

function copy(src: Bytes): Bytes { const out = bytesNew(0); bytesAppend(out, src); return out; }
function equal(a: Bytes, b: Bytes): void {
    assert(bytesLen(a) == bytesLen(b), "byte buffer length changed");
    let i = 0;
    while (i < bytesLen(a)) {
        assert((bytesGet(a, i) catch -1) == (bytesGet(b, i) catch -2), "byte buffer contents changed");
        i = i + 1;
    }
}

export function main(args: []string): int {
    if (len(args) != 1) { return 64; }
    asStructuredBegin();
    asStructuredLabel("__tx_entry");
    const missing = asStructuredMissing();
    asStructuredInstruction("lea", 2, asStructuredReg(0, 0), asStructuredMem(2, -1, -1, 0, 0, 1, "message"), missing, 1);
    asStructuredInstruction("ret", 0, missing, missing, missing, 1);
    asStructuredSection(1); asStructuredLabel("message");
    let i = 0;
    while (i < 65541) { asStructuredByte(i & 255); i = i + 1; }
    asStructuredSection(2); asStructuredLabel("address_slot"); asStructuredAddress("__tx_entry");
    asStructuredSection(3); asStructuredLabel("zero_slot"); asStructuredZero(8192);
    asResolveLocalFixups();
    assert(asFailedAs() == 0, asLastErrAs());
    const text = asImgText(); const ro = asImgRdata(); const data = asImgData();
    const textCopy = copy(text); const roCopy = copy(ro); const dataCopy = copy(data);
    assert(bytesLen(text) == 8 && bytesLen(ro) == 65541 && bytesLen(data) == 8 && asImgBssSize() == 8192, "section sizes");
    // Empty AMD64 COFF object: header, no symbols/sections, four-byte string table.
    const coff = bytesNew(24);
    bytesSet(coff, 0, 100); bytesSet(coff, 1, 134); bytesSet(coff, 8, 20); bytesSet(coff, 20, 4);
    assert(linkExe(coff, 0) == 0, lkGetMissing());
    equal(text, textCopy); equal(ro, roCopy); equal(data, dataCopy);
    writeFileBytes(args[0] + ".exe", exeBytesList()) catch (e) { eprint(e.message); return 1; };
    assert(linkElfImage("__tx_entry") == 0, elfLastError());
    equal(text, textCopy); equal(ro, roCopy); equal(data, dataCopy);
    writeFileBytes(args[0] + ".elf", elfBytesOut()) catch (e) { eprint(e.message); return 1; };
    // Reset and failure must leave prior retained buffers unchanged.
    asStructuredBegin(); asStructuredSection(1); asStructuredByte(256);
    assert(asFailedAs() == 1 && asLastErrAs() == "BadOperand" && bytesLen(asImgRdata()) == 0, "invalid byte accepted");
    equal(text, textCopy); equal(ro, roCopy); equal(data, dataCopy);
    assembleText(".section .rdata\n.byte 1,0xff,2\n");
    assert(asFailedAs() == 0 && bytesLen(asImgRdata()) == 3, "fallback duplicated tentative bytes");
    const fallback = asImgRdata();
    assert((bytesGet(fallback, 0) catch -1) == 1 && (bytesGet(fallback, 1) catch -1) == 255 && (bytesGet(fallback, 2) catch -1) == 2, "fallback byte values");
    assembleText(".section .rdata\n.byte 1,256\n");
    assert(asFailedAs() == 1 && asLastErrAs() == "BadOperand" && bytesLen(asImgRdata()) == 1, "fallback rejection changed");
    assert(bytesLen(fallback) == 3 && (bytesGet(fallback, 1) catch -1) == 255, "retained fallback buffer changed");
    equal(text, textCopy); equal(ro, roCopy); equal(data, dataCopy);
    print("PASS_ASM_BYTES_OWNERSHIP_ROLLBACK_PE_ELF");
    return 0;
}
