// 按值结构体（D3 v0.45，macOS，x86_64 与 arm64 两种产物共用）：外部结构体按值传与返回。x86_64 是 SysV：CGRect（32 字节）与
// CGAffineTransform（48 字节）为内存类——参数逐字入栈、返回经隐藏指针（RDI）；CFGregorianDate（{i32, i8×4, double}）
// 是 INTEGER＋SSE 混合，进出都分在整数寄存器与 XMM。arm64：CGRect、CGPoint、复数是同构浮点聚合（每个成员一个 D 或 S 寄存器），
// CGAffineTransform 按指针传、经 X8 返回，CFGregorianDate 与 lldiv 占两个整数寄存器。按值参数调用后太虚侧不变。
import { CARR, divNested, conjArr } from "./data/ffi_byvalue_alt";

declare struct DIV { quot: i32, rem: i32 }
declare struct LLDIV { quot: int, rem: int }
declare struct DCOMPLEX { re: float, im: float }
declare struct FCOMPLEX { re: f32, im: f32 }
declare struct SINCOS { s: float, c: float }
declare struct SINCOSF { s: f32, c: f32 }
declare struct CGPOINT { x: float, y: float }
declare struct CGSIZE { w: float, h: float }
declare struct CGRECT { origin: CGPOINT, size: CGSIZE }
declare struct XFORM { a: float, b: float, c: float, d: float, tx: float, ty: float }
declare struct GDATE { year: i32, month: i8, day: i8, hour: i8, minute: i8, second: float }
declare function div(a: i32, b: i32): DIV from "libSystem";
declare function lldiv(a: int, b: int): LLDIV from "libSystem";
declare function cabs(z: DCOMPLEX): float from "libSystem";
declare function cabsf(z: FCOMPLEX): f32 from "libSystem";
declare function conjf(z: FCOMPLEX): FCOMPLEX from "libSystem";
declare function __sincos_stret(x: float): SINCOS from "libSystem";
declare function __sincosf_stret(x: f32): SINCOSF from "libSystem";
declare function CGRectInset(r: CGRECT, dx: float, dy: float): CGRECT from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGRectUnion(a: CGRECT, b: CGRECT): CGRECT from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGAffineTransformConcat(t1: XFORM, t2: XFORM): XFORM from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGPointApplyAffineTransform(p: CGPOINT, t: XFORM): CGPOINT from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CGRectApplyAffineTransform(r: CGRECT, t: XFORM): CGRECT from "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics";
declare function CFGregorianDateGetAbsoluteTime(g: GDATE, tz: usize): float from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";
declare function CFAbsoluteTimeGetGregorianDate(at: float, tz: usize): GDATE from "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation";

function rect(x: float, y: float, w: float, h: float): CGRECT {
    return CGRECT { origin: CGPOINT { x: x, y: y }, size: CGSIZE { w: w, h: h } };
}

function showR(r: CGRECT): string {
    return toStr(r.origin.x) + "," + toStr(r.origin.y) + "," + toStr(r.size.w) + "," + toStr(r.size.h);
}

function showT(t: XFORM): string {
    return toStr(t.a) + "," + toStr(t.b) + "," + toStr(t.c) + "," + toStr(t.d) + "," + toStr(t.tx) + "," + toStr(t.ty);
}

function main(args: []string): int {
    const d = div(17, 5);
    const n = div(-17, 5);
    print("div " + toStr(d.quot) + " " + toStr(d.rem) + " " + toStr(n.quot) + " " + toStr(n.rem));
    const l = lldiv(10000000000000, 7);
    print("lldiv " + toStr(l.quot) + " " + toStr(l.rem));
    const qr = divNested(-9, 4);
    print("nested " + toStr(qr.q[0]) + " " + toStr(qr.r.v));
    print("abs " + toStr(cabs(DCOMPLEX { re: 3.0, im: 4.0 })) + " fabs " + toStr(cabsf(FCOMPLEX { re: 3.0, im: 4.0 })));
    const fc = conjf(FCOMPLEX { re: 3.0, im: 4.0 });
    print("conjf " + toStr(fc.re) + "," + toStr(fc.im));
    const arr = conjArr(CARR { v: [1.5, -2.5] });
    print("arr " + toStr(arr.v[0]) + "," + toStr(arr.v[1]));
    const sc = __sincos_stret(0.0);
    const scf = __sincosf_stret(0.0);
    print("sincos " + toStr(sc.s) + "," + toStr(sc.c) + " f " + toStr(scf.s) + "," + toStr(scf.c));
    let r = rect(10.0, 20.0, 100.0, 50.0);
    const inset = CGRectInset(r, 5.0, 10.0);
    print("inset " + showR(inset) + " arg-kept " + showR(r));
    r.origin.x = 0.0;
    print("result-kept " + showR(inset) + " arg-now " + showR(r));
    print("union " + showR(CGRectUnion(rect(0.0, 0.0, 10.0, 10.0), rect(5.0, 5.0, 20.0, 20.0))));
    const scale = XFORM { a: 2.0, b: 0.0, c: 0.0, d: 3.0, tx: 0.0, ty: 0.0 };
    const move = XFORM { a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 10.0, ty: 20.0 };
    const t = CGAffineTransformConcat(scale, move);
    print("concat " + showT(t));
    const p = CGPointApplyAffineTransform(CGPOINT { x: 1.0, y: 1.0 }, t);
    print("point " + toStr(p.x) + "," + toStr(p.y) + " rect " + showR(CGRectApplyAffineTransform(rect(0.0, 0.0, 1.0, 1.0), t)));
    const at = CFGregorianDateGetAbsoluteTime(GDATE { year: 2001, month: 1, day: 2, hour: 3, minute: 4, second: 5.5 }, 0);
    const g = CFAbsoluteTimeGetGregorianDate(86400.5, 0);
    print("gdate " + toStr(at) + " " + toStr(g.year) + "-" + toStr(g.month) + "-" + toStr(g.day) + " " + toStr(g.hour) + ":" + toStr(g.minute) + ":" + toStr(g.second));
    return 0;
}
