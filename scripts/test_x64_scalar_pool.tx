import { planPayload } from "../bootstrap/regallocmirror";

function payload(): string {
    let out = "I 0 10 0 10 1111111111\n"; let i = 0;
    while (i < 10) { out = out + "K 2 0 " + toStr(i) + " 1 0\n"; i = i + 1; } return out;
}
function has(xs: List<string>, want: string): bool { for (value in xs) { if (value == want) { return true; } } return false; }
test "persistent x64 pool: reserved lanes survive every release sweep" {
    const ordinary = strSplit(planPayload("V 3\n" + payload()), " ");
    assert(has(ordinary, "g4") && has(ordinary, "g5"), "pressure control reaches both ordinary lanes");
    const reserved = strSplit(planPayload("V 3\nR 2\n" + payload()), " ");
    assert(!has(reserved, "g4") && !has(reserved, "g5"), "no first or late allocation may use persistent registers");
    let memoryDefs = 0; let i = 0;
    while (i < 10) { if ((listGet(reserved, 2 + i * 3 + 2) catch "") == "m") { memoryDefs = memoryDefs + 1; } i = i + 1; }
    assert(memoryDefs == 4, "six run registers, four normal memory spills");
}

test "persistent x64 pool: one lane leaves the other available" {
    const reserved = strSplit(planPayload("V 3\nR 1\n" + payload()), " ");
    assert(!has(reserved, "g4") && has(reserved, "g5"), "only the active persistent lane is reserved");
    let memoryDefs = 0; let i = 0;
    while (i < 10) { if ((listGet(reserved, 2 + i * 3 + 2) catch "") == "m") { memoryDefs = memoryDefs + 1; } i = i + 1; }
    assert(memoryDefs == 3, "seven run registers, three memory spills");
    assert(planPayload("V 3\nR 3\n" + payload()) == "" && planPayload("V 3\nR 0\n" + payload()) == "", "invalid reservation facts are rejected");
}

// 浮点融合比较段：loadk 0←2.0；mul 0←0*1；lt_f 0←2<0（def 不落地）；jf_b 读 0（bool）。分支只看标志位，
// 不得因 bool 与 float 类冲突把槽 0 整段降为内存。
test "fused float branch: the branch use does not demote the compare slot" {
    const run = "V 3\nI 0 3 1 4 000\nK 1 0 0 2 0\nK 22 2 0 1 0 2 2 0 2 1 2\nK 9 2 2 0 0 3 2 2 2 0 2\nK 12 1 0 65535 0 1 0 3\n";
    const e = strSplit(planPayload(run), " ");
    const d0 = listGet(e, 4) catch ""; const d1 = listGet(e, 7) catch "";
    assert(strSlice(d0, 0, 1) == "x" && d0 == d1, "float defs before the fused compare share one XMM");
    assert((listGet(e, 2) catch "") == "n" && (listGet(e, 11) catch "") == "n", "loadk has no use; fused branch use has no location");
    const b = listGet(e, 8) catch ""; const c = listGet(e, 9) catch "";
    assert(strSlice(b, 0, 1) == "x" && c == d0, "fused compare reads both operands from XMM");
}
