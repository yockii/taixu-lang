// counter —— "五分钟 GUI"用户故事样例：
// 窗口＋文本＋按钮＋点击计数器；拉伸窗口 → 布局自适应（resize kind 7——
// 默认零手写：布局根尺寸随 pump 自动更新；onResize 供自定义响应）。
// 臂⑤：画布接真实文本轨（gui/text textCanvas＋嵌入字体）。
// 臂①：帧级 DPI 示范——surface/canvas 走 scaled
// 面（surfaceOpenDip＋textCanvasK），DIP 布局×app.k 出物理帧；回放态 scale
// 恒脚本声明值（缺省 100——既有 golden 逐字节不变）。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/counter-replay.txt taixu run examples/counter.tx
// 真窗交互：taixu run examples/counter.tx（点击按钮 → count 递增；
// 拉伸窗口 → onResize 自定义响应＋布局随新尺寸重排）。
import { Button, button, Canvas, paintFillRect, paintText, paintTextWidth, drawButtonC } from "gui/components";
import { appNew, appClose, pump, onClick, onResize, hitZone, defaultSpec } from "gui/app";
import { EventRecord } from "std/events";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent } from "gui/surface";
import { fontUi, fontFree, textCanvasK } from "gui/text";

const BTN_INC: int = 1;

struct Model {
    count: int,
    clicks: int,
    surface: int,
    btn: Ref<Button>,
}

function render(cv: Ref<Canvas>, w: int, h: int, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x202040);
    // 布局根＝窗口客户区（w×h）——按钮贴底部居中、标题随宽度居中
    //（零手写自适应：坐标全部由 w/h 派生，resize 后下一帧重排；
    // 居中宽度走真实轨文本度量 paintTextWidth）。
    paintText(cv, (w - paintTextWidth(cv, "taixu counter")) / 2, h / 4, 0xFFFFFF, "taixu counter");
    paintText(cv, (w - paintTextWidth(cv, "太虚 GUI 计数器")) / 2, h / 4 + 20, 0xC0C8E0, "太虚 GUI 计数器");
    paintFillRect(cv, w / 8, h / 2, w - w / 4, h / 4, 0x30305A);
    paintText(cv, w / 8 + 8, h / 2 + 10, 0xFFFFFF, "count=" + toStr(m.count));
    m.btn.x = (w - m.btn.w) / 2;
    m.btn.y = h - m.btn.h - 10;
    drawButtonC(cv, m.btn);
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model {
        count: 0,
        clicks: 0,
        surface: 0,
        btn: button(BTN_INC, 50, 90, 60, 22, "increment"),
    };
    const spec = defaultSpec("taixu counter", 160, 120);
    const app = appNew(spec);
    // 帧级 DPI：surface 物理尺寸＝DIP×k（回放态 k 恒脚本声明值）。
    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 真实文本轨（臂⑤——嵌入字体保底；fontFamily 混合解析见 gui/text）。
    const fb = fontUi() catch (e) {
        print("font load failed: " + e.message);
        appClose(app);
        surfaceClose(m.surface);
        return 1;
    };
    onClick(app, BTN_INC, (rec: EventRecord): void => {
            m.count = m.count + 1;
            m.clicks = m.clicks + 1;
        });
    onResize(app, (w: int, h: int): void => {
            // 自定义响应示范：按钮随窗宽伸展；surface 按新尺寸重建（DIP×k）
            //（布局根坐标由 render 按 w/h 派生——默认零手写部分）。
            m.btn.w = w / 3;
            surfaceClose(m.surface);
            m.surface = surfaceOpenDip(w, h, app.k) catch 0;
        });
    // 主循环（定档形态）：取事件→分发→脏标记重渲染→present
    //（无事件不重 present；帧号＝present 计数——重放注入的帧进位源）。
    let frame: int = 0;
    let presents: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = textCanvasK(m.surface, app.w, app.h, fb.handle, 14, app.k);
            render(cv, app.w, app.h, m);
            // 真窗通道点击判定：命中区随帧更新（按钮当前几何）。
            hitZone(app, BTN_INC, m.btn.x, m.btn.y, m.btn.w, m.btn.h);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false; // 有界退出兜底（真窗正常路径由关闭事件终局）
        }
        if (!live) {
            break;
        }
    }
    print("count=" + toStr(m.count) + " clicks=" + toStr(m.clicks) + " resize_count=" + toStr(app.resize_count) + " btn_w=" + toStr(m.btn.w) + " k=" + toStr(app.k) + " presents=" + toStr(presents));
    fontFree(fb);
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
