// D3 v0.48 外部内存区：读越过区尾，诊断写出区的大小与请求的范围，trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function main(args: []string): int {
    const m = ffiMem(pageAlloc(), 64, false) catch (e) { print(e.message); return 1; };
    print("ok " + toStr(bytesLen(ffiMemRead(m, 56, 8))));
    print("never " + toStr(bytesLen(ffiMemRead(m, 60, 8))));
    return 0;
}
