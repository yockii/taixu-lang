// mcp_debug.tx —— 原生 `taixu mcp` 的会话表与八个 debug_* 工具（第 6 轮 6c-6，调试实施设计 §四-9；对照 Zig 版
// src/tools/mcp_debug.zig，有意差别见 §五）。
//
// 每个会话是一个进程内的 NDJSON 会话：工具把参数翻成一条 NDJSON 命令交给 sessionDispatch（与 run --debug 同一份校验、
// 文案与事件），事件经 dbg_out 的队列收回。一条命令的回复是它产生的最后一个期望事件或 error 事件，之前的行是 events。
// 一次只处理一条请求；会话的产物在两次调用之间停着（装填态、停止态）或已结束。
import { JsonValue, jsonGet, JSON_INT, JSON_STR, JSON_ARR, JSON_OBJ } from "./json_parse";
import { dbgStr, dbgTail, dbgTakeEvents, dbgTakeDropped, dbgTakeErrTail, dbgTakeErrTotal } from "./dbg_out";
import { Sess, ST_ENDED, SESSION_MS, coreLaunch, coreKill, coreClose, nowMsS } from "./dbg_core";
import { sessionDispatch } from "./debug_session";
import { filePath } from "./file_path";
import { scratchProduct, scratchErrorJson } from "./mcp_scratch";
import { mcpRequestLeftMs } from "./mcp_request_budget";

const IDLE_DEFAULT_S: int = 300;
const IDLE_MAX_S: int = 1800;
const EVENTS_MAX: int = 4096;
const ERR_TAIL: int = 2048;
const ERR_CAP: int = 1048576;
// 请求剩余时限里留给暂停落地、必要时结束产物与回复的毫秒数（debug_session 的暂停宽限为 300 ms）。
const BUDGET_RESERVE_MS: int = 500;
const UNKNOWN_SESSION: string = "未知会话（已退出、被 kill 或超时清扫）";

// 工具的结果：code 为 0 时 text 是结果 R（isErr 为真时报失败）；-32602 为工具参数校验失败，服务器包成不带
// structuredContent 的 isError 结果；其余非零码为 JSON-RPC 错误（6d-4a 的错误分层）。
export struct McpOut {
    code: int,
    text: string,
    isErr: bool,
}

// 一个会话：eng 为引擎会话（0 或 1 个，用 for-in 取出）；dead 为产物已结束或没起来（下次调用回失联）；pend 为未交付的
// 事件行，dropped 为本次回复之前丢过行；errTail、errTotal 为产物 stderr 的尾部与总字节数；时刻用单调毫秒钟。
struct McpSess {
    id: string,
    eng: List<Ref<Sess>>,
    dead: bool,
    pend: List<string>,
    dropped: bool,
    errTail: string,
    errTotal: int,
    start: int,
    last: int,
    idleMs: int,
}

let table: List<Ref<McpSess>> = listNew();
let nextSid: int = 1;
let sidPrefix: string = "";
export function mcpSessionGeneration(generation: string): void { sidPrefix = generation + "."; }

function mkOut(code: int, text: string, isErr: bool): Ref<McpOut> {
    return new McpOut { code: code, text: text, isErr: isErr };
}

function badParams(msg: string): Ref<McpOut> { return mkOut(-32602, msg, false); }

function noStrs(): List<string> { return listNew(); }

function noSess(): List<Ref<Sess>> { return listNew(); }

// —— 会话表 ——

// 结束并移出会话（产物仍在时先结束，删除临时产物）。
function removeSess(id: string): void {
    const keep: List<Ref<McpSess>> = listNew();
    for (e in table) {
        if (e.id == id) {
            for (s in e.eng) {
                coreKill(s);
                coreClose(s);
            }
            e.eng = noSess();
        } else {
            listPush(keep, e);
        }
    }
    table = keep;
}

function expiresAt(e: Ref<McpSess>): int {
    let t = e.last + e.idleMs;
    if (e.start + SESSION_MS < t) { t = e.start + SESSION_MS; }
    return t;
}

// 清扫：闲置超过上限（从上一次回复之后算起）或开始后超过 1800 s 的会话出表。
export function mcpSweep(): void {
    const now = nowMsS();
    const gone: List<string> = listNew();
    for (e in table) {
        if (now > expiresAt(e)) { listPush(gone, e.id); }
    }
    for (id in gone) { removeSess(id); }
}

// 到最早的到期时刻还有多少毫秒（等客户端输入用）；没有会话时为 −1。
export function mcpWaitMs(): int {
    const now = nowMsS();
    let best = -1;
    for (e in table) {
        let t = expiresAt(e) - now + 1;
        if (t < 1) { t = 1; }
        if (best < 0 || t < best) { best = t; }
    }
    return best;
}

// 服务器退出：结束全部会话。
export function mcpCloseAll(): void {
    const ids: List<string> = listNew();
    for (e in table) { listPush(ids, e.id); }
    for (id in ids) { removeSess(id); }
}

// —— 事件 ——

// 收回引擎刚发出的事件与产物 stderr。
function collect(e: Ref<McpSess>): void {
    const evs = dbgTakeEvents();
    for (x in evs) { listPush(e.pend, x); }
    if (dbgTakeDropped()) { e.dropped = true; }
    if (listLen(e.pend) > EVENTS_MAX) {
        const keep: List<string> = listNew();
        let k = listLen(e.pend) - EVENTS_MAX;
        while (k < listLen(e.pend)) {
            listPush(keep, listGet(e.pend, k) catch "");
            k = k + 1;
        }
        e.pend = keep;
        e.dropped = true;
    }
    const t = dbgTakeErrTail();
    if (len(t) > 0) { e.errTail = dbgTail(e.errTail + t, ERR_TAIL); }
    e.errTotal = e.errTotal + dbgTakeErrTotal();
}

function hasPrefix(s: string, p: string): bool {
    if (len(s) < len(p)) { return false; }
    let k = 0;
    while (k < len(p)) {
        if ((byteAt(s, k) catch 0) != (byteAt(p, k) catch 1)) { return false; }
        k = k + 1;
    }
    return true;
}

// 事件行的名字（引擎的事件都以 {"event":"名字" 开头）。
function eventName(line: string): string {
    const head = "{\"event\":\"";
    if (!hasPrefix(line, head)) { return ""; }
    const b = bytesFromStr(line);
    let k = len(head);
    while (k < bytesLen(b) && (bytesGet(b, k) catch 34) != 34) { k = k + 1; }
    return bytesToStr(bytesSlice(b, len(head), k - len(head))) catch "";
}

// 去掉外层花括号。
function inner(line: string): string {
    const b = bytesFromStr(line);
    if (bytesLen(b) < 2) { return ""; }
    return bytesToStr(bytesSlice(b, 1, bytesLen(b) - 2)) catch "";
}

function joinLines(xs: List<string>, from: int, to: int): string {
    let s = "";
    let k = from;
    while (k < to) {
        if (k > from) { s = s + ","; }
        s = s + (listGet(xs, k) catch "");
        k = k + 1;
    }
    return s;
}

function head(e: Ref<McpSess>): string { return "{\"session\":" + dbgStr(e.id) + ","; }

function truncTail(e: Ref<McpSess>): string {
    if (!e.dropped) { return ""; }
    e.dropped = false;
    return ",\"events_truncated\":true";
}

// 失联：产物已结束或没起来。回剩下的事件与 stderr 尾部，会话出表。
function died(e: Ref<McpSess>): Ref<McpOut> {
    let r = head(e) + "\"ok\":false,\"error\":\"调试子进程已退出\"";
    if (listLen(e.pend) > 0) { r = r + ",\"events\":[" + joinLines(e.pend, 0, listLen(e.pend)) + "]"; }
    r = r + ",\"stderr\":" + dbgStr(e.errTail);
    if (e.errTotal > ERR_CAP) { r = r + ",\"stderr_truncated\":true"; }
    r = r + truncTail(e) + "}";
    removeSess(e.id);
    return mkOut(0, r, true);
}

function wanted(name: string, expect: List<string>): bool {
    if (name == "error") { return true; }
    for (x in expect) {
        if (x == name) { return true; }
    }
    return false;
}

// 最后一个期望事件或 error 事件的下标；没有为 −1。
function replyIdx(e: Ref<McpSess>, expect: List<string>): int {
    let at = -1;
    let k = 0;
    while (k < listLen(e.pend)) {
        if (wanted(eventName(listGet(e.pend, k) catch ""), expect)) { at = k; }
        k = k + 1;
    }
    return at;
}

// 按回复事件回复：之前的行为 events，之后的行留给下一次。
function answer(e: Ref<McpSess>, expect: List<string>): Ref<McpOut> {
    const at = replyIdx(e, expect);
    if (at < 0) {
        // 不应发生（每条命令都以期望事件或 error 结束）；当作失联收尾，不留半截会话。
        return died(e);
    }
    const term = listGet(e.pend, at) catch "{}";
    let r = head(e) + inner(term);
    if (at > 0) { r = r + ",\"events\":[" + joinLines(e.pend, 0, at) + "]"; }
    r = r + truncTail(e) + "}";
    const rest: List<string> = listNew();
    let k = at + 1;
    while (k < listLen(e.pend)) {
        listPush(rest, listGet(e.pend, k) catch "");
        k = k + 1;
    }
    e.pend = rest;
    return mkOut(0, r, eventName(term) == "error");
}

// 在会话里执行一条 NDJSON 命令并收回事件；产物结束时关掉它、会话记为失联。
function exec(e: Ref<McpSess>, cmd: string): void {
    for (s in e.eng) {
        sessionDispatch(s, bytesFromStr(cmd));
        collect(e);
        if (s.state == ST_ENDED) {
            coreClose(s);
            e.eng = noSess();
            e.dead = true;
        }
    }
}

function runCmd(e: Ref<McpSess>, cmd: string, expect: List<string>): Ref<McpOut> {
    if (e.dead) { return died(e); }
    exec(e, cmd);
    return answer(e, expect);
}

function names1(a: string): List<string> {
    const xs: List<string> = listNew();
    listPush(xs, a);
    return xs;
}

function names2(a: string, b: string): List<string> {
    const xs: List<string> = listNew();
    listPush(xs, a);
    listPush(xs, b);
    return xs;
}

function names3(a: string, b: string, c: string): List<string> {
    const xs: List<string> = listNew();
    listPush(xs, a);
    listPush(xs, b);
    listPush(xs, c);
    return xs;
}

// —— 工具 ——

// 一次 debug_* 调用（先清扫）。
export function mcpDebugTool(name: string, args: Ref<JsonValue>): Ref<McpOut> {
    mcpSweep();
    if (name == "debug_start") { return toolStart(args); }
    const sv = jsonGet(args, "session") catch None;
    if (sv == None) { return badParams("Invalid params: 缺少 session"); }
    const sj = sv catch args;
    if (sj.kind != JSON_STR) { return badParams("Invalid params: session 须为字符串"); }
    for (e in table) {
        if (e.id == sj.s) {
            e.last = nowMsS();
            const r = onSession(e, name, args);
            e.last = nowMsS();
            return r;
        }
    }
    return mkOut(0, "{\"session\":" + dbgStr(sj.s) + ",\"ok\":false,\"error\":" + dbgStr(UNKNOWN_SESSION) + "}", true);
}

function onSession(e: Ref<McpSess>, name: string, args: Ref<JsonValue>): Ref<McpOut> {
    if (name == "debug_breakpoint") { return toolBreak(e, args); }
    if (name == "debug_step") { return toolStep(e, args); }
    if (name == "debug_continue") {
        const secs = timeoutArg(args);
        if (secs < 0) { return badParams("Invalid params: timeout_s 需要正整数（秒）"); }
        return runCmd(e, "{\"cmd\":\"continue\",\"timeout_s\":" + toStr(secs) + budgetField() + "}", names3("stopped", "exited", "trapped"));
    }
    if (name == "debug_frames") { return runCmd(e, "{\"cmd\":\"frames\"}", names1("frames")); }
    if (name == "debug_inspect") { return toolInspect(e, args); }
    if (name == "debug_stops") { return runCmd(e, "{\"cmd\":\"stops\"}", names1("stops")); }
    if (name == "debug_kill") { return toolKill(e); }
    return badParams("Unknown tool");
}

// 运行类命令的 budget_ms：请求剩余时限减余量。到点暂停，产物以 reason pause 停下、会话保留（debug_session 的 resume）；
// 不这样做时，长运行会撞上父进程的请求墙钟，worker 被杀，同一 worker 里的全部会话一起作废。
function budgetField(): string {
    let ms = mcpRequestLeftMs() - BUDGET_RESERVE_MS;
    if (ms < 1) { ms = 1; }
    return ",\"budget_ms\":" + toStr(ms);
}

// timeout_s：缺省 60，不是正整数为 −1，超过 1800 按 1800。
function timeoutArg(args: Ref<JsonValue>): int {
    const tv = jsonGet(args, "timeout_s") catch None;
    if (tv == None) { return 60; }
    const t = tv catch args;
    if (t.kind != JSON_INT || t.i < 1) { return -1; }
    if (t.i > 1800) { return 1800; }
    return t.i;
}

function toolStep(e: Ref<McpSess>, args: Ref<JsonValue>): Ref<McpOut> {
    let mode = "into";
    const mv = jsonGet(args, "mode") catch None;
    if (mv != None) {
        const m = mv catch args;
        if (m.kind != JSON_STR) { return badParams("Invalid params: mode 须为字符串"); }
        if (m.s != "into" && m.s != "over" && m.s != "out") { return badParams("Invalid params: mode 需要 into|over|out"); }
        mode = m.s;
    }
    const secs = timeoutArg(args);
    if (secs < 0) { return badParams("Invalid params: timeout_s 需要正整数（秒）"); }
    return runCmd(e, "{\"cmd\":\"step\",\"mode\":\"" + mode + "\",\"timeout_s\":" + toStr(secs) + budgetField() + "}", names3("stopped", "exited", "trapped"));
}

function toolInspect(e: Ref<McpSess>, args: Ref<JsonValue>): Ref<McpOut> {
    const fv = jsonGet(args, "frame") catch None;
    if (fv == None) { return badParams("Invalid params: 缺少 frame"); }
    const sv = jsonGet(args, "slot") catch None;
    if (sv == None) { return badParams("Invalid params: 缺少 slot"); }
    const f = fv catch args;
    const sl = sv catch args;
    if (f.kind != JSON_INT || sl.kind != JSON_INT || f.i < 0 || sl.i < 0) { return badParams("Invalid params: frame/slot 须为非负整数"); }
    return runCmd(e, "{\"cmd\":\"inspect\",\"frame\":" + toStr(f.i) + ",\"slot\":" + toStr(sl.i) + "}", names1("inspect"));
}

// 断点参数翻成 NDJSON 命令；参数不合规时为空串，why 里是原因。
let bpWhy: string = "";

function bpCommand(a: Ref<JsonValue>): string {
    const fv = jsonGet(a, "fn") catch None;
    if (fv != None) {
        const f = fv catch a;
        if (f.kind != JSON_STR) {
            bpWhy = "fn 须为字符串";
            return "";
        }
        return "{\"cmd\":\"breakpoint_fn\",\"fn\":" + dbgStr(f.s) + "}";
    }
    const mv = jsonGet(a, "module") catch None;
    const lv = jsonGet(a, "line") catch None;
    if (mv == None || lv == None) {
        bpWhy = "需要 fn 或 module+line";
        return "";
    }
    const m = mv catch a;
    const l = lv catch a;
    if (m.kind != JSON_STR || l.kind != JSON_INT) {
        bpWhy = "module 须为字符串、line 须为整数";
        return "";
    }
    return "{\"cmd\":\"breakpoint_set\",\"module\":" + dbgStr(m.s) + ",\"line\":" + toStr(l.i) + "}";
}

function bpExpect(cmd: string): List<string> {
    if (hasPrefix(cmd, "{\"cmd\":\"breakpoint_fn\"")) { return names1("breakpoint_fn"); }
    return names1("breakpoint_set");
}

function toolBreak(e: Ref<McpSess>, args: Ref<JsonValue>): Ref<McpOut> {
    const cmd = bpCommand(args);
    if (len(cmd) == 0) { return badParams("Invalid params: " + bpWhy); }
    return runCmd(e, cmd, bpExpect(cmd));
}

function toolKill(e: Ref<McpSess>): Ref<McpOut> {
    let r = head(e) + "\"killed\":true";
    if (!e.dead) {
        exec(e, "{\"cmd\":\"kill\"}");
        const at = replyIdx(e, names1("exited"));
        if (at >= 0 && eventName(listGet(e.pend, at) catch "") == "exited") { r = r + ",\"exited\":" + (listGet(e.pend, at) catch "{}"); }
    }
    removeSess(e.id);
    return mkOut(0, r + "}", false);
}

function toolStart(args: Ref<JsonValue>): Ref<McpOut> {
    const pv = jsonGet(args, "path") catch None;
    if (pv == None) { return badParams("Invalid params: 缺少 path"); }
    const pj = pv catch args;
    if (pj.kind != JSON_STR || len(pj.s) == 0) { return badParams("Invalid params: path 须为非空字符串"); }
    let idle = IDLE_DEFAULT_S;
    const iv = jsonGet(args, "idle_timeout_s") catch None;
    if (iv != None) {
        const ij = iv catch args;
        if (ij.kind != JSON_INT || ij.i < 1) { return badParams("Invalid params: idle_timeout_s 需要正整数（秒）"); }
        idle = ij.i;
        if (idle > IDLE_MAX_S) { idle = IDLE_MAX_S; }
    }
    const sid = sidPrefix + toStr(nextSid);
    nextSid = nextSid + 1;
    const cwd = currentDir() catch (x) { return mkOut(-32603, "调试子进程启动失败", false); };
    const windows = hostTarget() == "windows";
    const exe = scratchProduct() catch (scratchFailure) { return mkOut(0, scratchErrorJson("debug_start", scratchFailure.message), true); };
    let exeHost = exe;
    if (windows) {
        exeHost = exe;
    } else {
        exeHost = filePath(exe);
    }
    const now = nowMsS();
    const e = new McpSess { id: sid, eng: noSess(), dead: false, pend: noStrs(), dropped: false, errTail: "", errTotal: 0, start: now, last: now, idleMs: idle * 1000 };
    listPush(table, e);
    const progArgs: List<string> = listNew();
    const s = coreLaunch(pj.s, cwd, progArgs, exe, exeHost, "") catch (x) {
        removeFile(exe) catch (ignored) {};
        collect(e);
        e.dead = true;
        return startReply(e, args);
    };
    listPush(e.eng, s);
    collect(e);
    if (s.state == ST_ENDED) {
        coreClose(s);
        e.eng = noSess();
        e.dead = true;
    }
    return startReply(e, args);
}

// debug_start 的回复：start 为 ready 或 compile_failed；launch 只得到 error 事件（产物起不来）时回失联。
function startReply(e: Ref<McpSess>, args: Ref<JsonValue>): Ref<McpOut> {
    const at = replyIdx(e, names2("ready", "compile_failed"));
    if (at < 0 || eventName(listGet(e.pend, at) catch "") == "error") { return died(e); }
    const start = listGet(e.pend, at) catch "{}";
    let r = head(e) + "\"start\":" + start;
    if (at > 0) { r = r + ",\"events\":[" + joinLines(e.pend, 0, at) + "]"; }
    const rest: List<string> = listNew();
    let k = at + 1;
    while (k < listLen(e.pend)) {
        listPush(rest, listGet(e.pend, k) catch "");
        k = k + 1;
    }
    e.pend = rest;
    return mkOut(0, r + ",\"breakpoints\":[" + initialBreaks(e, args) + "]}", false);
}

// 初始断点：每一项一条回执，次序相同；坏的项为 error 事件。产物已结束（编译失败或起来就退出）时没有回执。
function initialBreaks(e: Ref<McpSess>, args: Ref<JsonValue>): string {
    if (e.dead) { return ""; }
    const bv = jsonGet(args, "breakpoints") catch None;
    if (bv == None) { return ""; }
    const bl = bv catch args;
    if (bl.kind != JSON_ARR) { return ""; }
    let r = "";
    let i = 0;
    while (i < listLen(bl.items)) {
        const item = listGet(bl.items, i) catch args;
        let one = "";
        let cmd = "";
        if (item.kind == JSON_OBJ) { cmd = bpCommand(item); }
        if (len(cmd) == 0) {
            one = "{\"event\":\"error\",\"message\":" + dbgStr("breakpoints[" + toStr(i) + "] 需要 fn（字符串）或 module（字符串）+line（整数）") + "}";
        } else {
            exec(e, cmd);
            const at = replyIdx(e, bpExpect(cmd));
            one = listGet(e.pend, at) catch "{\"event\":\"error\",\"message\":\"调试子进程已退出\"}";
            e.pend = noStrs();
        }
        if (i > 0) { r = r + ","; }
        r = r + one;
        i = i + 1;
    }
    return r;
}
