// 调试基准（第 6 轮 6c-0）：异步任务体内的断点与调用栈。
async function job(n: int): int {
    const m = n * 3;
    print("job " + toStr(m));
    return m;
}

async function runner(): int {
    const f = job(5);
    const v = await f catch 0;
    print("got " + toStr(v));
    return v;
}

export function main(args: []string): int {
    const t = runner();
    print("spawned");
    return 0;
}
