// alpha —— 组件级 alpha/背景透明守护（臂⑤；#19）：
// paintFillRectA/paintStrokeRectA 叠加混合（src-over 整数取整——纯函数
// golden 可锚）＋窗口级 setOpacity（脚本通道 no-op——真窗 I/O 面不入
// golden，特效纪律同款）。帧面＝底色＋三层递减 alpha 叠块＋alpha 描边框。
//
// 确定性校验（无头通道＋注入事件＋有界退出——纪律）：
//   TAIXU_REPLAY=tests/alpha.txt TAIXU_FRAME=1 taixu run tests/alpha.tx
import { Canvas, canvasDpi, blockPainter, paintFillRect, paintFillRectA, paintStrokeRectA, paintText } from "gui/components";
import { appNew, appClose, pump, defaultSpec } from "gui/app";
import { surfaceOpenDip, surfaceClose, surfaceClear, windowPresent, windowSetOpacity, dipToPxK } from "gui/surface";

struct Model {
    surface: int,
    opacity: int,
}

function render(cv: Ref<Canvas>, w: int, h: int, m: Ref<Model>): void {
    surfaceClear(cv.h, 0x202040);
    paintFillRect(cv, 0, 0, w, 20, 0x30305A);
    paintText(cv, 8, 5, 0xFFFFFF, "alpha blend probe");
    // 三层递减 alpha 叠块（同位置叠绘——混合链确定性锚）。
    paintFillRectA(cv, 16, 28, 96, 64, 0xE04040, 160);
    paintFillRectA(cv, 32, 40, 96, 64, 0x40E040, 110);
    paintFillRectA(cv, 48, 52, 96, 64, 0x4040E0, 60);
    // alpha 描边框（四边 1px 同 alpha 判界展开）。
    paintStrokeRectA(cv, 160, 28, 96, 88, 0xF0C040, 140);
    paintText(cv, 164, 100, 0xC0C8E0, "stroke a=140");
    // 半透明面罩（全幅轻罩——背景透出的合成面）。
    paintFillRectA(cv, 0, 20, w, h - 20, 0x000000, 36);
}

export function main(args: []string): int {
    args;
    const m: Ref<Model> = new Model { surface: 0, opacity: 255 };
    const spec = defaultSpec("alpha probe", 280, 140);
    const app = appNew(spec);
    m.surface = surfaceOpenDip(spec.w, spec.h, app.k) catch (e) {
        print("surface open failed: " + e.message);
        appClose(app);
        return 1;
    };
    // 窗口级透明声明（脚本通道 no-op——真窗 I/O 面；重放恒 255 不涉帧）。
    m.opacity = 220;
    const orc: int = windowSetOpacity(app.hwnd, m.opacity);
    let presents: int = 0;
    let frame: int = 0;
    while (app.running) {
        const live: bool = pump(app, 16);
        if (app.dirty) {
            const cv = canvasDpi(m.surface, dipToPxK(app.w, app.k), dipToPxK(app.h, app.k), blockPainter(), app.k);
            render(cv, app.w, app.h, m);
            const rc: int = windowPresent(app.hwnd, m.surface);
            if (rc == 0) {
                presents = presents + 1;
            }
            app.dirty = false;
        }
        frame = frame + 1;
        if (frame > 100000) {
            app.running = false;
        }
        if (!live) {
            break;
        }
    }
    print("opacity=" + toStr(m.opacity) + " set_rc=" + toStr(orc) + " presents=" + toStr(presents));
    appClose(app);
    surfaceClose(m.surface);
    return 0;
}
