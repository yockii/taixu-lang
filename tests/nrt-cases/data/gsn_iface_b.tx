// generic-same-name-iface 的桩模块：模块 B 的同名 Item（字段不同，按长度比较）。
import { Cmp, best } from "./gsn_iface_g";

export struct Item { s: string }

function itemCompare(a: Item, b: Item): int { return len(a.s) - len(b.s); }

export function fb(): string {
    const xs: List< Item> = listNew();
    listPush(xs, Item { s: "ab" });
    listPush(xs, Item { s: "abcde" });
    listPush(xs, Item { s: "abc" });
    const c: Cmp < Item > = Item { s: "abcdefg" };
    return best(xs, Item { s: "" }).s + "," + toStr(c.compare(Item { s: "x" }));
}
