import { sha384Sum } from "std/crypto/sha384";
import { p256Hex } from "std/crypto/p256_field";
import { parseInt } from "std/strconv";

test "SHA-384: known empty and abc digests" {
    assert(bytesEqual(sha384Sum(bytesNew(0)), p256Hex("38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")), "empty");
    assert(bytesEqual(sha384Sum(bytesFromStr("abc")), p256Hex("cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")), "abc");
}

test "SHA-384: independent binary padding and multi-block vectors" {
    let count = 0;
    for (line in strSplit(readFile("tests/vectors/sha384.txt") catch panic("SHA-384 fixture"), "\n")) {
        if (len(line) == 0 || byteAt(line, 0) == 35) { continue; }
        const parts = strSplit(line, " "); const size = parseInt(listGet(parts, 0)) catch panic("vector size");
        const data = bytesNew(size); let i = 0;
        while (i < size) { bytesSet(data, i, (i * 131 + 17) % 256); i = i + 1; }
        const before = bytesSlice(data, 0, size);
        assert(bytesEqual(sha384Sum(data), p256Hex(listGet(parts, 1))), "binary length " + toStr(size));
        assert(bytesEqual(data, before), "input preserved"); count = count + 1;
    }
    assert(count == 265, "all frozen independent vectors executed");
}
