// 分析节黄金用例：单模块的局部、形参、顶层、字段、变体、闭包捕获、方法糖与各类绑定（LSP 与 MCP 实施设计 §四-2）。
struct Point {
    x: int,
    y: int,
}

enum Shape {
    Circle(r: int),
    Square(side: int),
    Empty,
}

enum Fail extends Error {
    Bad = "bad",
}

let counter: int = 0;

function area(s: Shape): int {
    return switch (s) {
        case Circle(r) => r * r * 3,
        case Square(side) => side * side,
        case Empty => counter,
    };
}

function pointSum(p: Point): int {
    return p.x + p.y;
}

function risky(n: int): int | Fail {
    if (n < 0) { return Fail.Bad; }
    return n;
}

function main(args: []string): int {
    const p = Point { x: 1, y: 2 };
    let total = p.sum();
    const add = (a: int): int => a + total;
    const twice = (b: int): int => add(b) + add(total);
    total = twice(area(Shape.Circle(2)));
    const sq = new Shape.Square(3);
    const nums: List< int> = listNew();
    const (u, v) = nums;
    if (u == None || v == None) { total = total + 1; }
    for (k in args) {
        total = total + len(k);
    }
    const got = risky(total) catch (err) {
        print(err.message);
        return 1;
    };
    counter = counter + got;
    let r = Point { x: got, y: total };
    r.x = area(Shape.Empty);
    return total + r.y;
}
