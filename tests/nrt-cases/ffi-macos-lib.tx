// macOS 适配 M2（设计稿 v052-macos-m2-runtime F1–F3，伴文件 .macos）：from "libSystem" 与另一个系统库
// （/usr/lib/libz.1.dylib，各一条 LC_LOAD_DYLIB、按库序号绑定）的外部函数——定宽、浮点、string 实参与返回（空指针得空串）、
// errno 经 ffiLastError（open 失败得 ENOENT 2）、qsort 的比较函数（SysV 回调外壳，回调里再调外部函数）、x86_64 上按 Apple
// 头文件改名导入的 stat（链接 stat$INODE64，按 64 位 inode 布局声明的结构读对类型与长度）；进程经 libSystem 的 exit 退出，
// C 侧 stdio 缓冲照常刷新（管道下 puts 的输出排在最后）。
declare struct STAT { dev: i32, mode: u16, nlink: u16, ino: u64, uid: u32, gid: u32, rdev: i32, pad: i32, atimeSec: int, atimeNsec: int, mtimeSec: int, mtimeNsec: int, ctimeSec: int, ctimeNsec: int, btimeSec: int, btimeNsec: int, size: int, blocks: int, blksize: i32, flags: u32, gen: u32, lspare: i32, qspare0: int, qspare1: int }
declare function strlen(s: string): usize from "libSystem";
declare function getpid(): i32 from "libSystem";
declare function atof(s: string): float from "libSystem";
declare function open(path: string, flags: i32): i32 from "libSystem";
declare function puts(s: string): i32 from "libSystem";
declare function getenv(name: string): string from "libSystem";
declare function qsort(base: Bytes, n: usize, w: usize, cmp: (usize, usize) => i32): void from "libSystem";
declare function memcpy(dst: Bytes, src: usize, n: usize): usize from "libSystem";
declare function sqrt(x: f64): f64 from "libSystem";
declare function powf(x: f32, y: f32): f32 from "libSystem";
declare function stat(path: string, st: Ref< STAT>): i32 from "libSystem";
declare function zlibVersion(): string from "/usr/lib/libz.1.dylib";
declare function crc32(crc: usize, buf: Bytes, n: u32): usize from "/usr/lib/libz.1.dylib";

let compares = 0;

function u32At(addr: usize): int {
    const tmp = bytesNew(4);
    memcpy(tmp, addr, 4);
    return (bytesGet(tmp, 0) catch 0) + (bytesGet(tmp, 1) catch 0) * 256;
}

function byValue(a: usize, b: usize): i32 {
    compares = compares + 1;
    const x = u32At(a);
    const y = u32At(b);
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

function blank(): Ref< STAT> {
    return new STAT { dev: 0, mode: 0, nlink: 0, ino: 0, uid: 0, gid: 0, rdev: 0, pad: 0, atimeSec: 0, atimeNsec: 0, mtimeSec: 0, mtimeNsec: 0, ctimeSec: 0, ctimeNsec: 0, btimeSec: 0, btimeNsec: 0, size: -1, blocks: 0, blksize: 0, flags: 0, gen: 0, lspare: 0, qspare0: 0, qspare1: 0 };
}

function main(args: []string): int {
    print("strlen " + toStr(strlen("héllo") as int) + " pid " + toStr(getpid() > 0));
    print("atof " + toStr(atof("2.5e3")));
    print("open " + toStr(open("/taixu-no-such/file", 0)) + " errno " + toStr(ffiLastError()));
    print("getenv [" + getenv("TAIXU_FFI_NOPE") + "]");
    print("sqrt " + toStr(sqrt(2.0)) + " powf " + toStr(powf(2.0, 10.0) as float));
    const vals = [5, 3, 9, 1, 7, 2];
    const buf = bytesNew(24);
    let i = 0;
    while (i < 6) {
        bytesSet(buf, i * 4, vals[i]);
        i = i + 1;
    }
    qsort(buf, 6, 4, byValue);
    let out = "";
    i = 0;
    while (i < 6) {
        out = out + toStr(bytesGet(buf, i * 4) catch -1) + " ";
        i = i + 1;
    }
    print("sorted " + out + toStr(compares > 0));
    const dir = blank();
    const file = blank();
    const self = readFile("ffi-macos-lib.tx") catch "";
    print("stat dir " + toStr(stat(".", dir)) + " " + toStr((dir.mode as int) / 4096 == 4));
    print("stat file " + toStr(stat("ffi-macos-lib.tx", file)) + " " + toStr((file.mode as int) / 4096 == 8) + " " + toStr(file.size == len(self) && file.size > 0));
    const v = zlibVersion();
    print("zlib " + toStr(strIndexOf(v, "1.") == 0) + " crc32 " + toStr(crc32(0, bytesFromStr("hello"), 5) as int));
    puts("from libSystem puts");
    print("last taixu line");
    return 0;
}
