import { App, onClick, onEvent, onHotkey, focusPushId, clipboardGet, clipboardSet, textCursor } from "gui/app";
import { EV_KEY_DOWN, EV_TEXT, EV_MOUSE_DOWN, EV_MOUSE_MOVE, EV_MOUSE_UP, EV_SCROLL, EV_MOD_CTRL, EV_MOD_ALT, EV_MOD_SHIFT, inputValue, keyCharMods } from "gui/components";
import { BrowserUi, ID_BACK, ID_FORWARD, ID_HOME, ID_RELOAD, ID_ADDRESS, ID_GO, ID_STOP, ID_PAGE, ID_SCROLL, ADDRESS_X, TOOLBAR, uiNotice, uiSyncAddress, uiScroll, uiThumb, uiMeasure } from "./ui_state";
import { navigationOpen, navigationStep, navigationReload, navigationStop, navigationLink } from "./navigation";
import { addressInsert, addressSelectAll, addressSelection, addressMove, addressDelete, addressCaretAt } from "./address";
import { pageLinkAt } from "./layout";
import { trim } from "std/string";
import { EventRecord } from "std/events";

export function uiOpen(model: Ref<BrowserUi>, app: Ref<App>, url: string): void {
    navigationOpen(model.controller.navigation, url) catch (e) { uiNotice(model, e.message); app.dirty = true; return; };
    model.notice = ""; model.editing = false; model.submits = model.submits + 1; uiSyncAddress(model); focusPushId(app, ID_PAGE); app.dirty = true;
}
function history(model: Ref<BrowserUi>, app: Ref<App>, direction: int): void {
    const changed = navigationStep(model.controller.navigation, direction) catch (e) { uiNotice(model, e.message); app.dirty = true; return; };
    if (changed) { model.notice = ""; model.editing = false; uiSyncAddress(model); focusPushId(app, ID_PAGE); app.dirty = true; }
}
function reload(model: Ref<BrowserUi>, app: Ref<App>): void {
    navigationReload(model.controller.navigation) catch (e) { uiNotice(model, e.message); app.dirty = true; return; };
    model.notice = ""; model.editing = false; uiSyncAddress(model); focusPushId(app, ID_PAGE); app.dirty = true;
}
function stop(model: Ref<BrowserUi>, app: Ref<App>): void {
    const loading = model.controller.navigation.loading; navigationStop(model.controller.navigation); model.editing = false;
    if (loading) { model.notice = "Stopped"; } uiSyncAddress(model); focusPushId(app, ID_PAGE); app.dirty = true;
}
function focusAddress(model: Ref<BrowserUi>, app: Ref<App>): void { model.editing = true; focusPushId(app, ID_ADDRESS); addressSelectAll(model.address); app.dirty = true; }
function insert(model: Ref<BrowserUi>, text: string): void { if (len(text) > 0 && !addressInsert(model.address, text)) { uiNotice(model, "Address must fit 4096 bytes and one line"); } }
function addressEvent(model: Ref<BrowserUi>, app: Ref<App>, rec: EventRecord): void {
    const field = model.address;
    if (rec.kind == EV_MOUSE_DOWN || (rec.kind == EV_MOUSE_MOVE && model.addressDragging)) {
        const pixel = rec.x - ADDRESS_X - 4 + model.addressOffset;
        const position = addressCaretAt(field, pixel, (text: string): int => { return uiMeasure(model, text, 14); });
        if (rec.kind == EV_MOUSE_DOWN) { field.anchor = position; model.addressDragging = true; model.editing = true; }
        field.cursor = position; field.select = false; return;
    }
    if (rec.kind == EV_MOUSE_UP) { model.addressDragging = false; return; }
    if (rec.kind == EV_TEXT) { insert(model, utf8Encode(rec.x) catch ""); return; }
    if (rec.kind != EV_KEY_DOWN) { return; }
    const ctrl = (rec.mods & EV_MOD_CTRL) != 0; const shift = (rec.mods & EV_MOD_SHIFT) != 0;
    if (ctrl) {
        if (rec.x == 'A') { addressSelectAll(field); }
        else if (rec.x == 'C' || rec.x == 'X') {
            const selected = addressSelection(field);
            if (len(selected) > 0) { if (clipboardSet(selected)) { if (rec.x == 'X') { addressDelete(field, true, false); } } else { uiNotice(model, "Clipboard unavailable"); } }
        } else if (rec.x == 'V') { insert(model, trim(clipboardGet())); }
        else if (rec.x == 8) { addressDelete(field, true, true); }
        return;
    }
    if ((rec.mods & EV_MOD_ALT) != 0) { return; }
    if (rec.x == 13) { uiOpen(model, app, inputValue(field)); }
    else if (rec.x == 9) { model.editing = false; focusPushId(app, ID_PAGE); }
    else if (rec.x == 8) { addressDelete(field, true, false); }
    else if (rec.x == 46) { addressDelete(field, false, false); }
    else if (rec.x == 37 || rec.x == 39 || rec.x == 36 || rec.x == 35) { addressMove(field, rec.x, shift); }
    else { insert(model, keyCharMods(rec.x, rec.mods)); }
}
function pageEvent(model: Ref<BrowserUi>, app: Ref<App>, rec: EventRecord): void {
    const state = model.controller.navigation;
    if (rec.kind == EV_SCROLL) { uiScroll(model, state.scroll + rec.x); return; }
    if (rec.kind == EV_MOUSE_DOWN) {
        model.editing = false; const page = model.page; if (page == None) { return; }
        const hit = pageLinkAt(page, rec.x, rec.y - TOOLBAR + state.scroll);
        if (hit != None) {
            navigationLink(state, hit.href) catch (e) { uiNotice(model, e.message); return; };
            model.notice = ""; model.clicks = model.clicks + 1; uiSyncAddress(model);
        } return;
    }
    if (rec.kind != EV_KEY_DOWN && !(rec.kind == EV_TEXT && rec.x == 32)) { return; }
    if (rec.x == 9) { focusAddress(model, app); return; }
    let requested = state.scroll;
    if (rec.x == 38) { requested = requested - 40; } else if (rec.x == 40) { requested = requested + 40; }
    else if (rec.x == 33) { requested = requested - model.pageHeight * 3 / 4; } else if (rec.x == 34) { requested = requested + model.pageHeight * 3 / 4; }
    else if (rec.x == 36) { requested = 0; } else if (rec.x == 35) { requested = 10000000; }
    else if (rec.x == 32) { if ((rec.mods & EV_MOD_SHIFT) != 0) { requested = requested - model.pageHeight * 3 / 4; } else { requested = requested + model.pageHeight * 3 / 4; } }
    else { return; } uiScroll(model, requested);
}
function scrollbarEvent(model: Ref<BrowserUi>, app: Ref<App>, rec: EventRecord): void {
    if (rec.kind == EV_SCROLL) { uiScroll(model, model.controller.navigation.scroll + rec.x); return; }
    const thumb = uiThumb(model); if (thumb.maximum <= 0) { return; }
    if (rec.kind == EV_MOUSE_DOWN) {
        model.editing = false; focusPushId(app, ID_PAGE);
        if (rec.y >= TOOLBAR + thumb.top && rec.y < TOOLBAR + thumb.top + thumb.height) { model.scrollDragging = true; model.scrollGrab = rec.y - TOOLBAR - thumb.top; }
        else if (rec.y < TOOLBAR + thumb.top) { uiScroll(model, model.controller.navigation.scroll - model.pageHeight * 3 / 4); }
        else { uiScroll(model, model.controller.navigation.scroll + model.pageHeight * 3 / 4); } return;
    }
    if (rec.kind == EV_MOUSE_UP) { model.scrollDragging = false; return; }
    if (rec.kind == EV_MOUSE_MOVE && model.scrollDragging && thumb.travel > 0) {
        let position = rec.y; if (position < TOOLBAR) { position = TOOLBAR; } if (position > TOOLBAR + model.pageHeight) { position = TOOLBAR + model.pageHeight; }
        uiScroll(model, (position - TOOLBAR - model.scrollGrab) * thumb.maximum / thumb.travel);
    }
}
export function uiBind(model: Ref<BrowserUi>, app: Ref<App>): void {
    onClick(app, ID_BACK, (event: EventRecord): void => { history(model, app, -1); });
    onClick(app, ID_FORWARD, (event: EventRecord): void => { history(model, app, 1); });
    onClick(app, ID_HOME, (event: EventRecord): void => { uiOpen(model, app, "about:home"); });
    onClick(app, ID_RELOAD, (event: EventRecord): void => { reload(model, app); });
    onClick(app, ID_GO, (event: EventRecord): void => { uiOpen(model, app, inputValue(model.address)); });
    onClick(app, ID_STOP, (event: EventRecord): void => { if (model.controller.navigation.loading) { stop(model, app); } });
    onEvent(app, ID_ADDRESS, (event: EventRecord): void => { addressEvent(model, app, event); });
    onEvent(app, ID_PAGE, (event: EventRecord): void => { pageEvent(model, app, event); });
    onEvent(app, ID_SCROLL, (event: EventRecord): void => { scrollbarEvent(model, app, event); });
    onHotkey(app, EV_MOD_CTRL, 'L', (): void => { focusAddress(model, app); });
    onHotkey(app, EV_MOD_CTRL, 'R', (): void => { reload(model, app); });
    onHotkey(app, EV_MOD_ALT, 37, (): void => { history(model, app, -1); });
    onHotkey(app, EV_MOD_ALT, 39, (): void => { history(model, app, 1); });
    onHotkey(app, 0, 27, (): void => { stop(model, app); }); textCursor(app, ID_ADDRESS);
}
