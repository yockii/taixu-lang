// Same-process driver failure, listing, scope and disabled-mode isolation.
import { drvSetKernel, drvSetPrelude, drvNativeRuntime, drvBytesOut, drvDiagOut, drvDisasm, drvDisasmRelease } from "./selfhost/driver";
import { linkMapEnable, linkMapScope, linkMapData } from "./selfhost/link_map_data";
import { linkMapFinish, linkMapJson } from "./selfhost/link_map";
import { T_X64_WINDOWS, T_X64_LINUX, T_X64_MACOS, T_ARM64_MACOS } from "./selfhost/target";

function build(entry: string, t: int): int {
    const objects: List<string> = listNew();
    return drvNativeRuntime(entry, 1, objects, t);
}
export function main(args: []string): int {
    if (len(args) != 2) { return 64; }
    let t = T_X64_WINDOWS; let kernel = embedBytes("nrt-kernel/kernel.obj");
    if (args[1] == "linux") { t = T_X64_LINUX; kernel = embedBytes("nrt-kernel/kernel-linux.o"); }
    if (args[1] == "x86_64-macos") { t = T_X64_MACOS; kernel = embedBytes("nrt-kernel/kernel-macos.o"); }
    if (args[1] == "aarch64-macos") { t = T_ARM64_MACOS; kernel = embedBytes("nrt-kernel/kernel-macos-aarch64.o"); }
    drvSetKernel(kernel); drvSetPrelude(bytesToStr(embedBytes("../prelude/collections.tx")) catch "");
    linkMapEnable(true); linkMapScope("functions");
    assert(build(args[0], t) == 0, drvDiagOut());
    const image = drvBytesOut(); const facts = linkMapFinish(image); const json = linkMapJson(facts);
    assert(facts.functionsPresent && listLen(facts.functions) > 0 && listLen(facts.symbols) == 0, "driver missing functions");
    assert(build(args[0] + ".missing", t) != 0 && !linkMapData().ok && listLen(linkMapData().functions) == 0, "failed driver retained map");
    assert(linkMapJson(facts) == json, "failed driver mutated retained map");
    assert(drvDisasm(args[0], t, 0) == 0 && !linkMapData().ok && listLen(linkMapData().functions) == 0, "listing retained old map");
    drvDisasmRelease();
    linkMapEnable(false); assert(build(args[0], t) == 0 && bytesEqual(drvBytesOut(), image), "disabled build changed product");
    assert(!linkMapData().ok && listLen(linkMapData().functions) == 0 && linkMapJson(facts) == json, "disabled build retained map");
    linkMapEnable(true); linkMapScope("all"); assert(build(args[0], t) == 0, drvDiagOut());
    const all = linkMapFinish(drvBytesOut());
    assert(all.functionsPresent && listLen(all.symbols) > 0 && listLen(all.functions) == listLen(facts.functions), "all scope missing facts");
    linkMapScope("functions"); assert(build(args[0], t) == 0, drvDiagOut());
    assert(linkMapJson(linkMapFinish(drvBytesOut())) == json && linkMapJson(facts) == json, "scope or reentry changed facts");
    print("PASS_FUNCTION_DRIVER_REENTRY_FAILURE_LISTING_SCOPES"); return 0;
}
