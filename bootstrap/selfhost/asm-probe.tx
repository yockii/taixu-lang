// asm-probe.tx —— assemble.tx 批 D 探针：.s → 节字节（text/rdata hex 摘要）。
import { assembleText, asLastErrAs, asFailedAs, asLastLineAs } from "./assemble";

function main(args: []string): int {
    if (len(args) < 1) {
        eprint("用法: asm-probe <file.s> [out.prefix]");
        return 64;
    }
    const src: string = readFile(args[0]) catch "";
    if (len(src) == 0) {
        eprint("read fail");
        return 1;
    }
    const img = assembleText(src);
    if (len(asLastErrAs()) > 0 && asFailedAs() == 1) {
        eprint("assemble fail: " + asLastErrAs() + " @line " + toStr(asLastLineAs()));
        return 2;
    }
    print("text=" + toStr(listLen(img.text)) + "B rdata=" + toStr(listLen(img.rdata)) + "B syms=" + toStr(listLen(img.symNames)) + " fixups=" + toStr(listLen(img.fixSec)));
    if (len(args) >= 2) {
        writeFile(args[1] + ".text", hexOf(img.text, 0, listLen(img.text))) catch (e) {
            eprint("write fail");
            return 3;
        };
        writeFile(args[1] + ".rdata", hexOf(img.rdata, 0, listLen(img.rdata))) catch (e) {
            eprint("write fail");
            return 3;
        };
    }
    return 0;
}

function hexOf(b: List<int>, from: int, to: int): string {
    const digits = "0123456789abcdef";
    let out = "";
    let i = from;
    while (i < to) {
        const v = listGet(b, i) catch 0;
        out = out + strSub(digits, (v >>> 4) & 15, 1) + strSub(digits, v & 15, 1);
        i = i + 1;
    }
    return out;
}
