// SHA-256（FIPS 180-4），供 MCP compile 给字节码产物取摘要（第 6 轮 6d-4a）。
// int 承载无符号 32 位字，每次相加后掩码；Ch/Maj 不取反。只读输入 Bytes，填充仅复制最后不足一块的字节。
const MASK32: int = 4294967295;
const K: List<int> = roundConstants();

function roundConstants(): List<int> {
    const k: List<int> = listNew();
    listPush(k, 1116352408); listPush(k, 1899447441); listPush(k, 3049323471); listPush(k, 3921009573);
    listPush(k, 961987163); listPush(k, 1508970993); listPush(k, 2453635748); listPush(k, 2870763221);
    listPush(k, 3624381080); listPush(k, 310598401); listPush(k, 607225278); listPush(k, 1426881987);
    listPush(k, 1925078388); listPush(k, 2162078206); listPush(k, 2614888103); listPush(k, 3248222580);
    listPush(k, 3835390401); listPush(k, 4022224774); listPush(k, 264347078); listPush(k, 604807628);
    listPush(k, 770255983); listPush(k, 1249150122); listPush(k, 1555081692); listPush(k, 1996064986);
    listPush(k, 2554220882); listPush(k, 2821834349); listPush(k, 2952996808); listPush(k, 3210313671);
    listPush(k, 3336571891); listPush(k, 3584528711); listPush(k, 113926993); listPush(k, 338241895);
    listPush(k, 666307205); listPush(k, 773529912); listPush(k, 1294757372); listPush(k, 1396182291);
    listPush(k, 1695183700); listPush(k, 1986661051); listPush(k, 2177026350); listPush(k, 2456956037);
    listPush(k, 2730485921); listPush(k, 2820302411); listPush(k, 3259730800); listPush(k, 3345764771);
    listPush(k, 3516065817); listPush(k, 3600352804); listPush(k, 4094571909); listPush(k, 275423344);
    listPush(k, 430227734); listPush(k, 506948616); listPush(k, 659060556); listPush(k, 883997877);
    listPush(k, 958139571); listPush(k, 1322822218); listPush(k, 1537002063); listPush(k, 1747873779);
    listPush(k, 1955562222); listPush(k, 2024104815); listPush(k, 2227730452); listPush(k, 2361852424);
    listPush(k, 2428436474); listPush(k, 2756734187); listPush(k, 3204031479); listPush(k, 3329325298);
    return k;
}

function at(xs: List<int>, i: int): int { return listGet(xs, i) catch 0; }
function octet(b: Bytes, i: int): int { return bytesGet(b, i) catch 0; }
function rotr(x: int, n: int): int { return ((x >>> n) | (x << (32 - n))) & MASK32; }

function block(msg: Bytes, base: int, w: List<int>, h: List<int>): void {
    let t = 0;
    while (t < 16) {
        const p = base + t * 4;
        listSet(w, t, (octet(msg, p) << 24) | (octet(msg, p + 1) << 16) | (octet(msg, p + 2) << 8) | octet(msg, p + 3));
        t = t + 1;
    }
    while (t < 64) {
        const x = at(w, t - 15);
        const y = at(w, t - 2);
        const s0 = rotr(x, 7) ^ rotr(x, 18) ^ (x >>> 3);
        const s1 = rotr(y, 17) ^ rotr(y, 19) ^ (y >>> 10);
        listSet(w, t, (at(w, t - 16) + s0 + at(w, t - 7) + s1) & MASK32);
        t = t + 1;
    }
    let a = at(h, 0);
    let b = at(h, 1);
    let c = at(h, 2);
    let d = at(h, 3);
    let e = at(h, 4);
    let f = at(h, 5);
    let g = at(h, 6);
    let hh = at(h, 7);
    t = 0;
    while (t < 64) {
        const s1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        const ch = g ^ (e & (f ^ g));
        const t1 = (hh + s1 + ch + at(K, t) + at(w, t)) & MASK32;
        const s0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        const maj = (a & (b | c)) | (b & c);
        const t2 = (s0 + maj) & MASK32;
        hh = g; g = f; f = e; e = (d + t1) & MASK32;
        d = c; c = b; b = a; a = (t1 + t2) & MASK32;
        t = t + 1;
    }
    listSet(h, 0, (at(h, 0) + a) & MASK32); listSet(h, 1, (at(h, 1) + b) & MASK32);
    listSet(h, 2, (at(h, 2) + c) & MASK32); listSet(h, 3, (at(h, 3) + d) & MASK32);
    listSet(h, 4, (at(h, 4) + e) & MASK32); listSet(h, 5, (at(h, 5) + f) & MASK32);
    listSet(h, 6, (at(h, 6) + g) & MASK32); listSet(h, 7, (at(h, 7) + hh) & MASK32);
}

// msg[start, start + n) 的摘要（八个 32 位字）；调用方保证区间在 msg 之内。整块直接从 msg 读，只复制末尾不足一块的字节。
function digest(msg: Bytes, start: int, n: int): List<int> {
    const h: List<int> = listNew();
    listPush(h, 1779033703); listPush(h, 3144134277); listPush(h, 1013904242); listPush(h, 2773480762);
    listPush(h, 1359893119); listPush(h, 2600822924); listPush(h, 528734635); listPush(h, 1541459225);
    const w: List<int> = listNew();
    let i = 0;
    while (i < 64) { listPush(w, 0); i = i + 1; }
    let pos = 0;
    while (pos <= n - 64) { block(msg, start + pos, w, h); pos = pos + 64; }
    const tail = bytesSlice(msg, start + pos, n - pos);
    bytesPush(tail, 128);
    while (bytesLen(tail) % 64 != 56) { bytesPush(tail, 0); }
    let sh = 56;
    while (sh >= 0) { bytesPush(tail, ((n * 8) >>> sh) & 255); sh = sh - 8; }
    pos = 0;
    while (pos < bytesLen(tail)) { block(tail, pos, w, h); pos = pos + 64; }
    return h;
}

export function sha256Hex(msg: Bytes): string {
    const h = digest(msg, 0, bytesLen(msg));
    const hex = "0123456789abcdef";
    let out = "";
    let i = 0;
    while (i < 8) {
        let sh = 28;
        while (sh >= 0) { out = out + strSub(hex, (at(h, i) >>> sh) & 15, 1); sh = sh - 4; }
        i = i + 1;
    }
    return out;
}

/// msg[start, start + n) 的 32 字节摘要（大端，FIPS 180-4 的输出次序）；区间越界时得空 Bytes（Mach-O 代码签名按页取摘要）。
export function sha256Range(msg: Bytes, start: int, n: int): Bytes {
    const out = bytesNew(0);
    if (start < 0 || n < 0 || start > bytesLen(msg) || n > bytesLen(msg) - start) { return out; }
    const h = digest(msg, start, n);
    let i = 0;
    while (i < 8) {
        let sh = 24;
        while (sh >= 0) { bytesPush(out, (at(h, i) >>> sh) & 255); sh = sh - 8; }
        i = i + 1;
    }
    return out;
}
