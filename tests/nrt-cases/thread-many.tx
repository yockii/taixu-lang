// 线程第 2 步（线程设计 §六、§十三-2）：资源回收——依次创建并 join 300 个线程（每个线程建自己的区域与堆，
// 分配两万个字符串后整堆归还），再同时运行 32 个线程，最后 50 个线程的句柄不 join 直接释放（线程照常跑完，
// main 返回后进程等它们结束）。线程结束时若不归还堆或区域，这里会耗尽提交量或地址空间。
function churn(): int {
    const xs: List< string> = listNew();
    let i = 0;
    while (i < 20000) {
        listPush(xs, "item " + toStr(i));
        i = i + 1;
    }
    return listLen(xs);
}

function main(args: []string): void {
    let total = 0;
    let k = 0;
    while (k < 300) {
        total = total + (threadJoin(threadSpawn(churn)) catch 0);
        k = k + 1;
    }
    print("sequential " + toStr(total));
    const ts: List< Thread< int>> = listNew();
    k = 0;
    while (k < 32) {
        listPush(ts, threadSpawn(churn));
        k = k + 1;
    }
    total = 0;
    for (t in ts) {
        total = total + (threadJoin(t) catch 0);
    }
    print("concurrent " + toStr(total));
    k = 0;
    while (k < 50) {
        threadSpawn(churn);
        k = k + 1;
    }
    print("main end");
}
