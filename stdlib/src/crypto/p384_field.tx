// Public P-384 verification arithmetic only: variable-time, never for secrets.
// 26 base-2^15 limbs, reusing the public RSA Montgomery implementation.
import { rsaZeros, rsaDecode, rsaEncode, rsaNprime, rsaR2, rsaMontgomery } from "./rsa_math";
import { p256Hex } from "./p256_field";

export struct P384Field { modulus: List<int>, nprime: int, r2: List<int>, power: Bytes }

export function p384PrimeBytes(): Bytes { return p256Hex("fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff"); }
export function p384OrderBytes(): Bytes { return p256Hex("ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973"); }

function field(modulus: Bytes): Ref<P384Field> {
    const power = bytesSlice(modulus, 0, 48); let borrow = 2; let i = 47;
    while (borrow > 0) {
        let v = (bytesGet(power, i) catch panic("p384: power bounds")) - borrow; borrow = 0;
        if (v < 0) { v = v + 256; borrow = 1; } bytesSet(power, i, v); i = i - 1;
    }
    const n = rsaDecode(modulus, 26);
    return new P384Field { modulus: n, nprime: rsaNprime(n), r2: rsaR2(n), power: power };
}
export function p384Prime(): Ref<P384Field> { return field(p384PrimeBytes()); }
export function p384Order(): Ref<P384Field> { return field(p384OrderBytes()); }

// value < 2*n, 27 limbs. Output is canonical even at n and at 2*n-2.
function reduce(f: Ref<P384Field>, value: List<int>): List<int> {
    const candidate = rsaZeros(26); let borrow = 0; let i = 0;
    while (i < 26) {
        let v = listGet(value, i) - listGet(f.modulus, i) - borrow; borrow = 0;
        if (v < 0) { v = v + 32768; borrow = 1; } listSet(candidate, i, v); i = i + 1;
    }
    if (listGet(value, 26) >= borrow) { return candidate; }
    const out = rsaZeros(26); i = 0;
    while (i < 26) { listSet(out, i, listGet(value, i)); i = i + 1; } return out;
}

export function p384Mul(f: Ref<P384Field>, a: List<int>, b: List<int>): List<int> { return rsaMontgomery(a, b, f.modulus, f.nprime); }
export function p384Decode(f: Ref<P384Field>, data: Bytes): List<int> {
    if (bytesLen(data) > 48) { panic("p384: internal field input exceeds 48 bytes"); }
    const value = reduce(f, rsaDecode(data, 27));
    return p384Mul(f, value, f.r2);
}
export function p384Encode(f: Ref<P384Field>, value: List<int>): Bytes {
    const one = rsaZeros(26); listSet(one, 0, 1); return rsaEncode(p384Mul(f, value, one), 48);
}
export function p384Small(f: Ref<P384Field>, value: int): List<int> {
    if (value < 0 || value > 32767) { panic("p384: small value bounds"); }
    const out = rsaZeros(26); listSet(out, 0, value); return p384Mul(f, out, f.r2);
}
export function p384Add(f: Ref<P384Field>, a: List<int>, b: List<int>): List<int> {
    const wide = rsaZeros(27); let carry = 0; let i = 0;
    while (i < 26) { const v = listGet(a, i) + listGet(b, i) + carry; listSet(wide, i, v & 32767); carry = v >> 15; i = i + 1; }
    listSet(wide, 26, carry); return reduce(f, wide);
}
export function p384Sub(f: Ref<P384Field>, a: List<int>, b: List<int>): List<int> {
    const out = rsaZeros(26); let borrow = 0; let i = 0;
    while (i < 26) {
        let v = listGet(a, i) - listGet(b, i) - borrow; borrow = 0;
        if (v < 0) { v = v + 32768; borrow = 1; } listSet(out, i, v); i = i + 1;
    }
    if (borrow == 1) {
        let carry = 0; i = 0;
        while (i < 26) { const v = listGet(out, i) + listGet(f.modulus, i) + carry; listSet(out, i, v & 32767); carry = v >> 15; i = i + 1; }
    }
    return out;
}
export function p384Zero(a: List<int>): bool {
    let bits = 0; let i = 0;
    while (i < 26) { bits = bits | listGet(a, i); i = i + 1; } return bits == 0;
}
export function p384Inverse(f: Ref<P384Field>, a: List<int>): List<int> | Error {
    if (p384Zero(a)) { return err("p384: zero inverse"); }
    let out = p384Small(f, 1); let bit = 383;
    while (bit >= 0) {
        out = p384Mul(f, out, out);
        const b = bytesGet(f.power, 47 - bit / 8) catch panic("p384: exponent bounds");
        if (((b >> (bit % 8)) & 1) != 0) { out = p384Mul(f, out, a); } bit = bit - 1;
    }
    return out;
}
export function p384Less(a: Bytes, b: Bytes): bool {
    if (bytesLen(a) != 48 || bytesLen(b) != 48) { panic("p384: internal comparison width"); }
    let i = 0;
    while (i < 48) {
        const av = bytesGet(a, i) catch panic("p384: compare bounds"); const bv = bytesGet(b, i) catch panic("p384: compare bounds");
        if (av != bv) { return av < bv; } i = i + 1;
    }
    return false;
}
