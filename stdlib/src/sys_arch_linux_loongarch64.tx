// std/file、std/fs 在 Linux 上随架构而变的部分（各架构版导出面相同，见 sys_arch_linux_x86_64.tx）。
// 龙芯版：取文件信息只用 statx（sys_statx_linux.tx：5.19～6.10 的内核没有 fstat／newfstatat，6.11 才补回；同 glibc、musl、
// Go，不做先试再退）；改名用 renameat2（标志 0，龙芯没有 renameat）；O_DIRECTORY 为 0x10000。
import { statxPath, statxFd, stxMode, stxSize, stxMtimeSec, stxMtimeNsec } from "./sys_statx";

declare function lxRenameat2(odir: int, src: string, ndir: int, dst: string, flags: int): int from syscall "renameat2";

const AT_FDCWD: int = -100;
// 同 sys_statx 的 STATX_BUF。
export const STAT_BUF: int = 256;
// O_RDONLY｜O_DIRECTORY｜O_CLOEXEC
export const OPEN_DIR: int = 589824;

// statPath、statFd、renamePath 返回 0 或 -errno；st 至少 STAT_BUF 字节。路径跟随符号链接。
export function statPath(path: string, st: Bytes): int {
    return statxPath(path, st);
}

export function statFd(fd: int, st: Bytes): int {
    return statxFd(fd, st);
}

export function stMode(st: Bytes): int {
    return stxMode(st);
}

export function stSize(st: Bytes): int {
    return stxSize(st);
}

export function stMtimeSec(st: Bytes): int {
    return stxMtimeSec(st);
}

export function stMtimeNsec(st: Bytes): int {
    return stxMtimeNsec(st);
}

export function renamePath(src: string, dst: string): int {
    return lxRenameat2(AT_FDCWD, src, AT_FDCWD, dst, 0);
}
