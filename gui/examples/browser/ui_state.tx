import { App, hitZone, focusTopId, setTitle } from "gui/app";
import { Canvas, Input, input, inputValue, inputSelLo, inputSelHi, paintFillRect, paintStrokeRect, paintText } from "gui/components";
import { FontBundle, fontFree, textCanvasK } from "gui/text";
import { surfaceOpenDip, surfaceClose, surfaceClear, dipToPxK, guiQuery, CAP_ANIM_MS } from "gui/surface";
import { textMeasure, textDraw } from "gui/engine/text";
import { surfAt, rBlit, rFillRect } from "gui/engine/raster";
import { BrowserController, controllerClose } from "./controller";
import { PageLayout, pageLayout } from "./layout";
import { pagePaint, pageMeasureK, pageScroll } from "./paint";
import { contentError, contentShort } from "./content";
import { navigationFragment } from "./navigation";
import { addressSet, addressPrefix } from "./address";

export const ID_BACK: int = 701;
export const ID_FORWARD: int = 702;
export const ID_HOME: int = 703;
export const ID_RELOAD: int = 704;
export const ID_ADDRESS: int = 705;
export const ID_GO: int = 706;
export const ID_STOP: int = 707;
export const ID_PAGE: int = 708;
export const ID_SCROLL: int = 709;
export const TOOLBAR: int = 48;
export const STATUS: int = 24;
export const SCROLLBAR: int = 12;
export const ADDRESS_X: int = 236;

export struct BrowserUi { controller: Ref<BrowserController>, font: Ref<FontBundle>, address: Ref<Input>, window: int, viewport: int, addressView: int, page: Ref<PageLayout>?, version: int, width: int, height: int, scale: int, pageWidth: int, pageHeight: int, notice: string, editing: bool, addressOffset: int, addressDragging: bool, scrollDragging: bool, scrollGrab: int, clicks: int, submits: int, scrolls: int, reflows: int }
export struct BrowserThumb { top: int, height: int, travel: int, maximum: int }

export function uiNew(controller: Ref<BrowserController>, font: Ref<FontBundle>): Ref<BrowserUi> {
    return new BrowserUi { controller: controller, font: font, address: input(ID_ADDRESS, ADDRESS_X, 10, 20, "about:home"), window: 0, viewport: 0, addressView: 0, page: None, version: 0, width: 0, height: 0, scale: 0, pageWidth: 0, pageHeight: 0, notice: "", editing: false, addressOffset: 0, addressDragging: false, scrollDragging: false, scrollGrab: 0, clicks: 0, submits: 0, scrolls: 0, reflows: 0 };
}
export function uiNotice(model: Ref<BrowserUi>, message: string): void { model.notice = contentShort(message, 512); }
export function uiAddressWidth(width: int): int { const value = width - ADDRESS_X - 112; if (value < 20) { return 20; } return value; }
export function uiSyncAddress(model: Ref<BrowserUi>): void {
    const state = model.controller.navigation; const pending = state.pending; let url = state.content.url;
    if (pending != None) { url = pending.url; }
    if (!addressSet(model.address, url)) { uiNotice(model, "Address exceeds the editor limit"); } model.addressOffset = 0;
}
export function uiEnsureSurfaces(model: Ref<BrowserUi>, app: Ref<App>): bool | Error {
    if (model.width == app.w && model.height == app.h && model.scale == app.k) { return false; }
    if (app.w < 1 || app.w > 8192 || app.h < 1 || app.h > 8192 || app.k < 50 || app.k > 1000) { return err("browser UI: invalid window geometry"); }
    let width = app.w - SCROLLBAR; if (width < 16) { width = 16; } let height = app.h - TOOLBAR - STATUS; if (height < 1) { height = 1; }
    const window = surfaceOpenDip(app.w, app.h, app.k)?;
    const viewport = surfaceOpenDip(width, height, app.k) catch (e) { surfaceClose(window); return e; };
    const address = surfaceOpenDip(uiAddressWidth(app.w) - 2, 26, app.k) catch (e) { surfaceClose(viewport); surfaceClose(window); return e; };
    surfaceClose(model.window); surfaceClose(model.viewport); surfaceClose(model.addressView);
    model.window = window; model.viewport = viewport; model.addressView = address;
    model.width = app.w; model.height = app.h; model.scale = app.k; model.pageWidth = width; model.pageHeight = height;
    model.address.w = uiAddressWidth(app.w); model.version = 0; return true;
}
function preparePage(model: Ref<BrowserUi>): Ref<PageLayout> | Error {
    const state = model.controller.navigation;
    const layout = pageLayout(state.content.document, state.content.styles, model.pageWidth, pageMeasureK(model.font.handle, model.scale)) catch (e) {
        state.content = contentError(state.content.url, e.message)?; model.controller.version = model.controller.version + 1;
        return pageLayout(state.content.document, state.content.styles, model.pageWidth, pageMeasureK(model.font.handle, model.scale));
    }; return layout;
}
export function uiMeasure(model: Ref<BrowserUi>, text: string, size: int): int {
    const pixels = textMeasure(model.font.handle, dipToPxK(size, model.scale), text); if (pixels < 0) { return 0; }
    return (pixels * 100 + model.scale - 1) / model.scale;
}
export function uiReflow(model: Ref<BrowserUi>, app: Ref<App>): void | Error {
    const state = model.controller.navigation; const page = preparePage(model)?; model.page = page; model.reflows = model.reflows + 1;
    if (state.anchorPending) {
        const fragment = navigationFragment(state);
        if (fragment != None) { state.scroll = mapGet(page.anchors, fragment) ?? 0; } state.anchorPending = false;
    }
    state.scroll = pageScroll(page, state.scroll, model.pageHeight); model.version = model.controller.version;
    if (!model.editing) { uiSyncAddress(model); }
    let title = state.content.title + " - Taixu Browser"; if (model.controller.demo) { title = "[DEMO] " + title; } setTitle(app, title); return done();
}
export function uiScroll(model: Ref<BrowserUi>, requested: int): void {
    const page = model.page; if (page == None) { return; }
    model.controller.navigation.scroll = pageScroll(page, requested, model.pageHeight); model.scrolls = model.scrolls + 1;
}
export function uiThumb(model: Ref<BrowserUi>): BrowserThumb {
    const page = model.page; if (page == None || page.height <= model.pageHeight) { return BrowserThumb { top: 0, height: model.pageHeight, travel: 0, maximum: 0 }; }
    let height = model.pageHeight * model.pageHeight / page.height; if (height < 24) { height = 24; } if (height > model.pageHeight) { height = model.pageHeight; }
    const travel = model.pageHeight - height; const maximum = page.height - model.pageHeight;
    return BrowserThumb { top: model.controller.navigation.scroll * travel / maximum, height: height, travel: travel, maximum: maximum };
}
function drawButton(canvas: Ref<Canvas>, app: Ref<App>, id: int, x: int, width: int, label: string, enabled: bool): void {
    let fill = 0xffffff; let ink = 0x26334d; if (!enabled) { fill = 0xf0f2f7; ink = 0x929aab; }
    paintFillRect(canvas, x, 9, width, 28, fill); paintStrokeRect(canvas, x, 9, width, 28, 0xb8c1d3); paintText(canvas, x + 6, 15, ink, label);
    hitZone(app, id, x, 9, width, 28);
}
function drawAddress(model: Ref<BrowserUi>, app: Ref<App>, canvas: Ref<Canvas>): void | Error {
    const field = model.address; field.focused = focusTopId(app) == ID_ADDRESS; const prefix = uiMeasure(model, addressPrefix(field, field.cursor), 14);
    const available = field.w - 12;
    if (field.focused) {
        if (prefix < model.addressOffset) { model.addressOffset = prefix; }
        if (prefix > model.addressOffset + available) { model.addressOffset = prefix - available; }
    } else { model.addressOffset = 0; }
    surfaceClear(model.addressView, 0xffffff); const target = surfAt(model.addressView); const lo = inputSelLo(field); const hi = inputSelHi(field);
    if (field.focused && lo >= 0) {
        const left = uiMeasure(model, addressPrefix(field, lo), 14); const right = uiMeasure(model, addressPrefix(field, hi), 14);
        rFillRect(target, dipToPxK(3 + left - model.addressOffset, app.k), dipToPxK(3, app.k), dipToPxK(right - left, app.k), dipToPxK(20, app.k), 0xc9dafd);
    }
    if (textDraw(model.addressView, model.font.handle, dipToPxK(14, app.k), inputValue(field), dipToPxK(3 - model.addressOffset, app.k), dipToPxK(4, app.k), 0x172033) != 0) { return err("browser UI: address rendering failed"); }
    if (field.focused && (guiQuery(CAP_ANIM_MS) / 530) % 2 == 0) {
        rFillRect(target, dipToPxK(3 + prefix - model.addressOffset, app.k), dipToPxK(4, app.k), dipToPxK(1, app.k), dipToPxK(18, app.k), 0x172033);
    }
    paintFillRect(canvas, ADDRESS_X, 10, field.w, 28, 0xffffff); paintStrokeRect(canvas, ADDRESS_X, 10, field.w, 28, 0x9aa8c1);
    rBlit(surfAt(model.window), target, dipToPxK(ADDRESS_X + 1, app.k), dipToPxK(11, app.k)); hitZone(app, ID_ADDRESS, ADDRESS_X, 10, field.w, 28); return done();
}
export function uiRender(model: Ref<BrowserUi>, app: Ref<App>): void | Error {
    const state = model.controller.navigation; const page = model.page; if (page == None) { return err("browser UI: page is not laid out"); }
    surfaceClear(model.window, 0xf5f7fb); pagePaint(model.viewport, model.font.handle, page, state.scroll, app.k)?;
    rBlit(surfAt(model.window), surfAt(model.viewport), 0, dipToPxK(TOOLBAR, app.k));
    const canvas = textCanvasK(model.window, app.w, app.h, model.font.handle, 14, app.k);
    paintFillRect(canvas, 0, 0, app.w, TOOLBAR, 0xe6ebf4);
    drawButton(canvas, app, ID_BACK, 8, 44, "Back", state.cursor > 0 || state.loading);
    drawButton(canvas, app, ID_FORWARD, 56, 56, "Next", state.cursor + 1 < listLen(state.history));
    drawButton(canvas, app, ID_HOME, 116, 50, "Home", true); drawButton(canvas, app, ID_RELOAD, 170, 58, "Reload", true);
    drawAddress(model, app, canvas)?;
    drawButton(canvas, app, ID_GO, app.w - 104, 40, "Go", true); drawButton(canvas, app, ID_STOP, app.w - 56, 48, "Stop", state.loading);
    paintFillRect(canvas, app.w - SCROLLBAR, TOOLBAR, SCROLLBAR, model.pageHeight, 0xe8edf5); const thumb = uiThumb(model);
    if (thumb.maximum > 0) { paintFillRect(canvas, app.w - SCROLLBAR + 2, TOOLBAR + thumb.top, SCROLLBAR - 4, thumb.height, 0xa4afc3); }
    paintFillRect(canvas, 0, app.h - STATUS, app.w, STATUS, 0xe6ebf4); let status = "Ready"; let color = 0x3f4d64;
    const pending = state.pending;
    if (state.loading && pending != None) { status = "Loading: " + contentShort(pending.url, 128); }
    else if (len(state.content.error) > 0) { status = "Navigation failed"; color = 0xa52c3b; }
    else if (state.content.status > 0) { status = "HTTP " + toStr(state.content.status) + " | " + state.content.title; }
    if (len(model.notice) > 0) { status = model.notice; color = 0xa52c3b; }
    if (model.controller.demo) { status = "DEMO | " + status; }
    paintText(canvas, 8, app.h - STATUS + 4, color, status);
    hitZone(app, ID_PAGE, 0, TOOLBAR, model.pageWidth, model.pageHeight); hitZone(app, ID_SCROLL, app.w - SCROLLBAR, TOOLBAR, SCROLLBAR, model.pageHeight); return done();
}
export function uiDestroy(model: Ref<BrowserUi>, app: Ref<App>): void {
    controllerClose(model.controller);
    // Explicitly release callback graphs (some framework callbacks capture App).
    while (listLen(app.listeners.items) > 0) { listPop(app.listeners.items); }
    while (listLen(app.hotkeys) > 0) { listPop(app.hotkeys); }
    while (listLen(app.resize_listeners) > 0) { listPop(app.resize_listeners); }
    surfaceClose(model.addressView); surfaceClose(model.viewport); surfaceClose(model.window); fontFree(model.font);
}
function done(): void {}
