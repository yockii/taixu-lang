// D3 v0.21 工具链系统内建（仅 --toolchain，伴文件 sys-proc.toolchain）：hostTarget、getEnv、
// runProcess、tempDir、removeFile、selfExePath、monoNs；v0.42 的 setEnv。程序以子模式启动自身：参数原样
// 传递（空格、引号、反斜杠、中文、空串）、退出码转发、stderr 重定向到文件与删除文件、子进程带上 setEnv 设的变量。
function sep(): string {
    if (hostTarget() == "windows") { return "\\"; }
    return "/";
}

function child(args: []string): int {
    print("child argc=" + toStr(len(args)));
    print("child env: " + (getEnv("TAIXU_SYS_PROC_SET") catch "<none>"));
    let i = 1;
    while (i < len(args)) {
        print("  [" + args[i] + "]");
        i = i + 1;
    }
    eprint("child stderr line");
    return 7;
}

function main(args: []string): int {
    if (len(args) > 0 && args[0] == "child") { return child(args); }
    const t = hostTarget();
    print("target known: " + toStr(t == "windows" || t == "linux" || t == "macos"));
    print("arch known: " + toStr(hostArch() == "x86_64" || hostArch() == "aarch64"));
    const configured = getEnv("TAIXU_SYS_PROC_FIXTURE") catch "";
    print("known var: " + toStr(configured == "fixture 中文 🦊"));
    const missing = getEnv("TAIXU_SYS_PROC_NO_SUCH_VAR") catch "<none>";
    print("missing var: " + missing);
    // setEnv（v0.42）：写 getEnv 读的同一张表，此后起的子进程带上（见 child）。
    setEnv("TAIXU_SYS_PROC_SET", "first") catch (e) { print("setEnv failed: " + e.message); };
    setEnv("TAIXU_SYS_PROC_SET", "值 = 中文 🦊") catch (e) { print("setEnv failed: " + e.message); };
    print("setEnv round trip: " + toStr((getEnv("TAIXU_SYS_PROC_SET") catch "") == "值 = 中文 🦊"));
    setEnv("", "x") catch (e) { print("setEnv empty name: [" + e.message + "]"); };
    setEnv("A=B", "x") catch (e) { print("setEnv name with '=': " + e.message); };
    const nul = bytesToStr(bytesNew(1)) catch "";
    setEnv("TAIXU_SYS_PROC_SET", "a" + nul + "b") catch (e) { print("setEnv value with NUL: " + e.message); };
    print("value kept after rejection: " + toStr((getEnv("TAIXU_SYS_PROC_SET") catch "") == "值 = 中文 🦊"));
    setEnv("TAIXU_SYS_PROC_EMPTY", "") catch (e) { print("setEnv empty value failed: " + e.message); };
    print("empty value is set, not removed: [" + (getEnv("TAIXU_SYS_PROC_EMPTY") catch "<none>") + "]");
    const tmp = tempDir();
    print("tempDir non-empty: " + toStr(len(tmp) > 0));
    const me = selfExePath();
    print("selfExePath names this program: " + toStr(strIndexOf(me, "sys-proc") >= 0));
    const a = monoNs();
    const b = monoNs();
    print("monoNs monotonic: " + toStr(b >= a));

    const errPath = tmp + sep() + "taixu-sys-proc-stderr.txt";
    const argv: List< string> = listNew();
    listPush(argv, "child");
    listPush(argv, "a b");
    listPush(argv, "q\"x");
    listPush(argv, "back\\slash\\");
    listPush(argv, "中文 参数");
    listPush(argv, "");
    const code = runProcess(me, argv, errPath) catch (e) {
        print("runProcess failed: " + e.message);
        return 1;
    };
    print("child exit: " + toStr(code));
    const captured = readFile(errPath) catch "";
    print("captured stderr: " + toStr(strIndexOf(captured, "child stderr line") >= 0));
    removeFile(errPath) catch (e) { print("removeFile failed: " + e.message); };
    print("removed: " + toStr(entryKind(errPath) == 0));
    removeFile(errPath) catch (e) { print("remove again: error"); };

    const nope = tmp + sep() + "taixu-sys-proc-no-such-program";
    const r = runProcess(nope, listNew(), "") catch -1;
    print("missing program: " + toStr(r));
    return 0;
}
