// D3 v0.48 外部内存区：写只读区（创建时 writable 为 false，页本身可写也不行），trap 4025。
import { pageAlloc } from "./data/ffimem_page";

// 只声明不调用的外部函数充当平台层（外部内存区只许在声明了 from 外部函数的模块里创建；见 ffi-mem.tx）。
declare function GetTickCount64(): u64 from "kernel32";

function main(args: []string): int {
    const m = ffiMem(pageAlloc(), 16, false) catch (e) { print(e.message); return 1; };
    print("read " + toStr(bytesLen(ffiMemRead(m, 0, 16))));
    ffiMemWrite(m, 0, bytesNew(1));
    print("never");
    return 0;
}
