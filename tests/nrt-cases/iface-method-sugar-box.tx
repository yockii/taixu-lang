// 回归：方法糖写法把具体值交给接口形参时同样装箱。方法糖在检查实参前记下实参的节点号，接口装箱把实参原地包成
// 隐藏 struct 字面量并换了节点号，后端按旧号取到未装箱的原值：List<Shape> 上 shapes.push(Square { ... }) 运行时报
// bad_type（直调 listPush 不经这张表，所以正常）。
interface Shape {
    area(): int;
}

struct Square {
    side: int,
}

function squareArea(s: Square): int {
    return s.side * s.side;
}

struct Rect {
    w: int,
    h: int,
}

function rectArea(r: Rect): int {
    return r.w * r.h;
}

struct Bag {
    items: List<Shape>,
}

function bagAdd(b: Bag, s: Shape): void {
    b.items.push(s);
}

function bagTotal(b: Bag): int {
    let sum = 0;
    for (s in b.items) {
        sum = sum + s.area();
    }
    return sum;
}

export function main(args: []string): int {
    const shapes: List<Shape> = listNew();
    shapes.push(Square { side: 3 });
    shapes.insert(0, Rect { w: 2, h: 5 });
    shapes.push(Square { side: 1 });
    shapes.set(2, Rect { w: 4, h: 4 });
    for (s in shapes) {
        print("area " + toStr(s.area()));
    }
    const bag = Bag { items: listNew() };
    bag.add(Square { side: 2 });
    bag.add(Rect { w: 1, h: 7 });
    print("bag " + toStr(bag.total()));
    return 0;
}
