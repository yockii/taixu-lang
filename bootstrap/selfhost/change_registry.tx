// TOOL-98：只读注册表；查询、AI 文档和 capabilities 摘要共用同一数据。
import { CHANGES } from "../changes";
import { TOOLCHAIN_VERSION, jsonStart } from "./toolchain";
import { jsonQuote } from "./json_text";
import { sha256Hex } from "./sha256";

export function registrySummary(): string {
    return "{\"count\":" + toStr(len(CHANGES)) + ",\"sha256\":\"" + sha256Hex(embedBytes("../changes.tx")) + "\"}";
}

export function changesJson(): string {
    let out = jsonStart("changes/1") + ",\"toolchain_version\":" + jsonQuote(TOOLCHAIN_VERSION) + ",\"changes\":[";
    let i = 0;
    while (i < len(CHANGES)) {
        const c = CHANGES[i];
        if (i > 0) { out = out + ","; }
        let ds = "[";
        let j = 0;
        while (j < len(c.diagnostics)) {
            if (j > 0) { ds = ds + ","; }
            ds = ds + toStr(c.diagnostics[j]); j = j + 1;
        }
        out = out + "{\"id\":" + jsonQuote(c.id) + ",\"kind\":" + toStr(c.kind) + ",\"layer\":" + jsonQuote(c.layer)
        + ",\"since\":" + jsonQuote(c.since) + ",\"gate\":" + jsonQuote(c.gate) + ",\"diagnostics\":" + ds + "]"
        + ",\"fix\":" + jsonQuote(c.fix) + ",\"applicability\":" + jsonQuote(c.applicability)
        + ",\"before\":" + jsonQuote(c.before) + ",\"after\":" + jsonQuote(c.after) + ",\"implementedIn\":" + jsonQuote(c.implementedIn)
        + ",\"explain\":" + jsonQuote(c.explain) + ",\"d3\":" + jsonQuote(c.d3) + ",\"llmGuide\":" + jsonQuote(c.llmGuide) + "}";
        i = i + 1;
    }
    return out + "]}";
}

export function changesMarkdown(): string {
    let out = "# 太虚工具链兼容变更\n\n工具链版本：" + TOOLCHAIN_VERSION + "。自动修复尚未实现。\n";
    let i = 0;
    while (i < len(CHANGES)) {
        const c = CHANGES[i];
        out = out + "\n## " + c.id + "\n\n分类：" + toStr(c.kind) + "；层：" + c.layer + "；首次开发线：" + c.since
        + "；实际实现：" + c.implementedIn + "。\n\n原写法：\n\n~~~tx\n" + c.before + "\n~~~\n\n保留旧行为的迁移：\n\n~~~tx\n"
        + c.after + "\n~~~\n\n" + c.fix + "。自动应用等级：" + c.applicability + "。\n\n规范：[D3](../../" + c.d3 + ")；[AI 指南](../../" + c.llmGuide + ")。\n";
        i = i + 1;
    }
    return out;
}
