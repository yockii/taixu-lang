// aot-load —— taixu-gui AOT 双路代表负载（跨仓守护）：
// gui/ 前缀导入链（surface/components）在 AOT 产物中同链可用；绘制＋sha256
// 输出与解释器路逐字节一致（scripts/aot-e2e.sh 本负载承担双路判定）。
import { box, text, button, drawBox, drawText, drawButton } from "gui/components";
import { surfaceOpen, surfaceClose, surfaceClear, surfaceSha256 } from "gui/surface";

export function main(args: []string): int {
    args;
    const s = surfaceOpen(64, 48) catch (e) {
        print("surface open failed: " + e.message);
        return 1;
    };
    surfaceClear(s, 0x101018);
    const b = box(1, 2, 2, 60, 44, 0x2A2A4A);
    drawBox(s, b);
    const t = text(0, 6, 6, "aot");
    drawText(s, t);
    const btn = button(2, 6, 26, 40, 16, "go");
    drawButton(s, btn);
    print("aot-load sha256=" + surfaceSha256(s));
    surfaceClose(s);
    return 0;
}
